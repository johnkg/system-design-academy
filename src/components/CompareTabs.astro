---
// Switch between the two compare pages, and jump to a section of the current one.
import { url } from '../lib';
interface Props { current: 'patterns' | 'concepts' }
const { current } = Astro.props;
const pages = [
  { id: 'patterns', label: 'Design patterns', href: url('compare/') },
  { id: 'concepts', label: 'System design concepts', href: url('compare-concepts/') },
];
const jumps = [['find', 'By problem'], ['confused', 'Easily confused'], ['cheat', 'Cheat sheet']];
---
<div class="ct">
  <nav class="switch" aria-label="What to compare">
    {pages.map((p) => <a href={p.href} aria-current={p.id === current ? 'page' : undefined}>{p.label}</a>)}
  </nav>
  <nav class="jump" aria-label="On this page">
    <span class="jl" aria-hidden="true">Jump to</span>
    {jumps.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>
</div>
<style>
  .ct { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; margin-top: 8px; }
  .switch { display: inline-flex; padding: 3px; gap: 2px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-2); }
  .switch a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border-radius: 9px; color: var(--muted); font-weight: 500; text-decoration: none; }
  .switch a:hover { color: var(--text); }
  .switch a[aria-current='page'] { background: var(--surface); color: var(--text); font-weight: 600; box-shadow: 0 1px 2px rgb(0 0 0 / .12), 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent); }
  .jump { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .jl { font: .75rem var(--font-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--muted); margin-right: 2px; }
  .jump a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--text); text-decoration: none; font-size: .9rem; }
  .jump a:hover { background: var(--surface-2); }
  .switch a:focus-visible, .jump a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 520px) { .switch { display: flex; width: 100%; } .switch a { flex: 1; justify-content: center; text-align: center; padding: 0 8px; font-size: .9rem; } }
</style>
