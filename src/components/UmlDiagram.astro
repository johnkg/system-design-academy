---
interface UmlClass { id: string; name: string; stereotype?: string; role: string; x: number; y: number; w: number; members: string[] }
interface UmlEdge { from: string; to: string; kind: 'association' | 'implements' | 'inherits'; label?: string }
interface Diagram { width: number; height: number; classes: UmlClass[]; edges: UmlEdge[] }
interface Props { diagram: Diagram; roles: { id: string; label: string; description: string }[]; colors: Record<string, string> }
const { diagram, roles, colors } = Astro.props;

const HEAD = 30, ROW = 18, PAD = 8, STEREOTYPE = 14; // box heights in diagram units: title, one member line, bottom padding, «stereotype» line
const boxes = diagram.classes.map((c) => ({ ...c, h: HEAD + (c.stereotype ? STEREOTYPE : 0) + c.members.length * ROW + PAD }));
const byId = Object.fromEntries(boxes.map((b) => [b.id, b]));

// Point where the line from a box's centre toward (tx, ty) leaves the box.
function edgePoint(b: (typeof boxes)[number], tx: number, ty: number) {
  const cx = b.x + b.w / 2, cy = b.y + b.h / 2, dx = tx - cx, dy = ty - cy;
  const s = Math.min(dx ? b.w / 2 / Math.abs(dx) : Infinity, dy ? b.h / 2 / Math.abs(dy) : Infinity);
  return { x: cx + dx * s, y: cy + dy * s };
}
const roleLabel = Object.fromEntries(roles.map((r) => [r.id, r.label]));
const verb = { association: 'uses', implements: 'implements', inherits: 'extends' } as const;
const describe = [
  ...boxes.map((b) => `${b.name}${b.stereotype ? ` (${b.stereotype})` : ''}, ${roleLabel[b.role] ?? b.role}, with ${b.members.join('; ')}.`),
  ...diagram.edges.map((e) => `${byId[e.from].name} ${e.label ?? verb[e.kind]} ${byId[e.to].name}${e.label ? ` (${verb[e.kind]})` : ''}.`),
].join(' ');
const lines = diagram.edges.map((e) => {
  const a = byId[e.from], b = byId[e.to];
  const p1 = edgePoint(a, b.x + b.w / 2, b.y + b.h / 2);
  const p2 = edgePoint(b, a.x + a.w / 2, a.y + a.h / 2);
  return { ...e, p1, p2, roles: [a.role, b.role] };
});
---
<figure class="uml" data-uml>
  <svg viewBox={`0 0 ${diagram.width} ${diagram.height}`} role="img" aria-labelledby="uml-title uml-desc">
    <title id="uml-title">UML class diagram</title>
    <desc id="uml-desc">{describe}</desc>
    <defs>
      <marker id="tri" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="12" markerHeight="12" orient="auto"><path d="M1 1 L11 6 L1 11 Z" fill="var(--surface)" stroke="currentColor" stroke-width="1.4" /></marker>
      <marker id="arrow" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="10" markerHeight="10" orient="auto"><path d="M1 1 L11 6 L1 11" fill="none" stroke="currentColor" stroke-width="1.6" /></marker>
    </defs>
    {lines.map((l) => (
      <g class="edge" style="color: var(--muted)">
        <line x1={l.p1.x} y1={l.p1.y} x2={l.p2.x} y2={l.p2.y} stroke="currentColor" stroke-width="1.5"
          stroke-dasharray={l.kind === 'implements' ? '6 4' : undefined}
          marker-end={l.kind === 'association' ? 'url(#arrow)' : 'url(#tri)'} />
        {l.label && <text x={(l.p1.x + l.p2.x) / 2} y={(l.p1.y + l.p2.y) / 2 - 6} text-anchor="middle" class="elabel">{l.label}</text>}
      </g>
    ))}
    {boxes.map((b) => (
      <g class="cls" data-role={b.role} style={`--c: ${colors[b.role] ?? 'var(--accent)'}`}>
        <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="6" class="box" />
        <rect x={b.x} y={b.y} width={b.w} height={HEAD + (b.stereotype ? 14 : 0)} rx="6" class="head" />
        {b.stereotype && <text x={b.x + b.w / 2} y={b.y + 14} text-anchor="middle" class="stereo">«{b.stereotype}»</text>}
        <text x={b.x + b.w / 2} y={b.y + (b.stereotype ? 31 : 20)} text-anchor="middle" class="cname">{b.name}</text>
        {b.members.map((m, i) => <text x={b.x + 10} y={b.y + HEAD + (b.stereotype ? 14 : 0) + 16 + i * ROW} class="member">{m}</text>)}
      </g>
    ))}
  </svg>
  <figcaption class="legend">
    {roles.map((r) => (
      <button type="button" class="legend-item" data-role={r.id} title={r.description}>
        <span class="role-dot" style={`background: ${colors[r.id] ?? 'var(--accent)'}`}></span>{r.label}
      </button>
    ))}
    <span class="hint">Hover over or tab to a role to spot it in the diagram.</span>
  </figcaption>
</figure>
<script>
  // Dim everything except the hovered/focused role.
  document.querySelectorAll<HTMLElement>('[data-uml]').forEach((fig) => {
    const set = (role: string | null) => {
      fig.querySelectorAll<SVGGElement>('.cls').forEach((g) => g.classList.toggle('dim', !!role && g.dataset.role !== role));
    };
    fig.querySelectorAll<HTMLElement>('.legend-item').forEach((b) => {
      b.addEventListener('mouseenter', () => set(b.dataset.role!));
      b.addEventListener('focus', () => set(b.dataset.role!));
      b.addEventListener('mouseleave', () => set(null));
      b.addEventListener('blur', () => set(null));
    });
  });
</script>
<style>
  .uml { margin: 0; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; }
  svg { width: 100%; height: auto; display: block; font-family: var(--font-sans); }
  .box { fill: var(--surface); stroke: var(--c); stroke-width: 1.6; }
  .head { fill: color-mix(in srgb, var(--c) 18%, var(--surface)); stroke: var(--c); stroke-width: 1.6; }
  .cname { font-size: 14px; font-weight: 700; fill: var(--text); }
  .stereo { font-size: 11px; fill: var(--muted); }
  .member { font-size: 12px; fill: var(--text); font-family: var(--font-mono); }
  .elabel { font-size: 11px; fill: var(--muted); }
  .cls { transition: opacity .2s; }
  .cls.dim { opacity: .2; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; margin-top: 10px; font-size: .9rem; }
  .legend-item { font: inherit; background: none; border: 0; color: var(--text); cursor: pointer; padding: 2px 4px; border-radius: 6px; }
  .legend-item:focus-visible { outline: 2px solid var(--accent); }
  .hint { color: var(--muted); font-size: .8rem; }
</style>
