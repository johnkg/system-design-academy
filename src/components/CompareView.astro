---
// The body of the two compare pages (patterns and concepts): find by problem, easily confused groups, and a cheat sheet.
// The page validates its hand-written data and passes plain items, so this component only renders.
import type { Problem, Confusion } from '../data/compare';

export interface Item { id: string; name: string; group: string; difficulty: string; intent: string; use: string; skip: string; href: string }
interface Props {
  noun: string; // "pattern" or "concept"
  groups: { id: string; label: string; color: string }[]; // in display order
  groupLabel: string; // name of the filter group, e.g. "Area"
  placeholder: string;
  items: Item[];
  problems: Problem[];
  confusions: Confusion[];
}
const { noun, groups, groupLabel, placeholder, items, problems, confusions } = Astro.props;
const Noun = noun[0].toUpperCase() + noun.slice(1);
const bySlug = new Map(items.map((i) => [i.id, i]));
const it = (slug: string) => bySlug.get(slug)!;
const color = new Map(groups.map((g) => [g.id, g.color]));
const pc = (group: string) => `--pc: ${color.get(group)}`;
const order = new Map(groups.map((g, i) => [g.id, i]));
const sheet = [...items].sort((a, b) => order.get(a.group)! - order.get(b.group)! || a.name.localeCompare(b.name));
const groupName = new Map(groups.map((g) => [g.id, g.label]));
---
<section id="find" aria-labelledby="find-h">
  <h2 id="find-h">Find a {noun} by problem</h2>
  <form class="finder" data-finder onsubmit="return false" role="search">
    <label class="sr" for="fq">Search problems</label>
    <input id="fq" class="pg-in" type="search" placeholder={placeholder} autocomplete="off" data-fq />
    <div class="chips" role="group" aria-label={groupLabel}>
      <button type="button" class="chip-btn" data-fcat="all" aria-pressed="true">All</button>
      {groups.map((g) => <button type="button" class="chip-btn dot" style={pc(g.id)} data-fcat={g.id} aria-pressed="false">{g.label}</button>)}
    </div>
    <p class="status" aria-live="polite" data-fcount></p>
  </form>
  <ul class="problems">
    {problems.map((pr) => (
      <li class="prob card" data-prob
          data-text={`${pr.text} ${pr.patterns.map((x) => `${it(x.slug).name} ${x.why}`).join(' ')}`.toLowerCase()}
          data-cats={[...new Set(pr.patterns.map((x) => it(x.slug).group))].join(' ')}>
        <p class="need">{pr.text}</p>
        <ul class="answers">
          {pr.patterns.map((x) => (
            <li>
              <a class="pill" style={pc(it(x.slug).group)} href={it(x.slug).href}>{it(x.slug).name}</a>
              <span class="why">{x.why}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
  <p class="empty" data-fempty hidden>Nothing matches. Try a simpler word, or <button type="button" class="linklike" data-freset>clear the filter</button>.</p>
</section>

<section id="confused" aria-labelledby="confused-h">
  <h2 id="confused-h">Easily confused</h2>
  <p class="lede">These groups look alike. The rule of thumb under each table is the quickest way to tell them apart.</p>
  {confusions.map((c) => (
    <article class="conf card">
      <h3>{c.title}</h3>
      <p class="blurb">{c.blurb}</p>
      <div class="tablewrap" tabindex="0" role="region" aria-label={c.title}>
        <table>
          <caption class="sr">{c.title}</caption>
          <thead>
            <tr><th scope="col"><span class="sr">Aspect</span></th>{c.patterns.map((s) => <th scope="col"><a href={it(s).href} class="pill" style={pc(it(s).group)}>{it(s).name}</a></th>)}</tr>
          </thead>
          <tbody>
            {c.rows.map((r) => <tr><th scope="row">{r.aspect}</th>{r.values.map((v) => <td>{v}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      <p class="rule"><strong>Rule of thumb:</strong> {c.rule}</p>
    </article>
  ))}
</section>

<section id="cheat" aria-labelledby="cheat-h">
  <h2 id="cheat-h">Cheat sheet: all {items.length} {noun}s</h2>
  <div class="tablewrap" tabindex="0" role="region" aria-label={`Cheat sheet of all ${noun}s`}>
    <table class="sheet">
      <caption class="sr">All {noun}s with a one-line idea, when to use them and when to skip them</caption>
      <thead><tr><th scope="col">{Noun}</th><th scope="col">In one line</th><th scope="col">Reach for it when</th><th scope="col">Skip it when</th></tr></thead>
      <tbody>
        {sheet.map((p, i) => (
          <>
            {(i === 0 || sheet[i - 1].group !== p.group) && (
              <tr class="grouprow"><th colspan="4" scope="colgroup" class="cap">{groupName.get(p.group)}</th></tr>
            )}
            <tr>
              <th scope="row"><a href={p.href}>{p.name}</a><small class="lvl">{p.difficulty}</small></th>
              <td>{p.intent}</td>
              <td>{p.use}</td>
              <td>{p.skip}</td>
            </tr>
          </>
        ))}
      </tbody>
    </table>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLElement>('[data-finder]')!;
  const input = form.querySelector<HTMLInputElement>('[data-fq]')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-prob]')];
  const empty = document.querySelector<HTMLElement>('[data-fempty]')!;
  const count = form.querySelector<HTMLElement>('[data-fcount]')!;
  let cat = 'all';
  function apply() {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    items.forEach((li) => {
      const ok = (cat === 'all' || li.dataset.cats!.split(' ').includes(cat)) && words.every((w) => li.dataset.text!.includes(w));
      li.hidden = !ok; if (ok) shown++;
    });
    form.querySelectorAll<HTMLElement>('[data-fcat]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.fcat === cat)));
    count.textContent = words.length || cat !== 'all' ? `Showing ${shown} of ${items.length} problems` : `${items.length} common problems`;
    empty.hidden = shown > 0;
  }
  input.addEventListener('input', apply);
  form.addEventListener('click', (e) => { const b = (e.target as Element).closest<HTMLElement>('[data-fcat]'); if (b) { cat = b.dataset.fcat!; apply(); } });
  document.querySelector('[data-freset]')!.addEventListener('click', () => { input.value = ''; cat = 'all'; apply(); input.focus(); });
  apply();
</script>
<style>
  section { scroll-margin-top: 70px; }
  .finder { display: grid; gap: 10px; margin: 1rem 0; }
  .finder input { width: 100%; padding: 10px 14px; border-radius: 999px; font-size: 1rem; }
  .status { margin: 0; color: var(--muted); font-size: .85rem; }
  .problems { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .prob { padding: 12px 16px; min-width: 0; overflow-wrap: anywhere; }
  .need { margin: 0 0 8px; font-weight: 600; }
  .answers { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .answers li { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  .why { color: var(--muted); font-size: .92rem; }
  .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: .85rem; font-weight: 600; text-decoration: none; border: 1px solid color-mix(in srgb, var(--pc) 55%, transparent); background: color-mix(in srgb, var(--pc) 12%, var(--surface)); color: var(--text); white-space: normal; max-width: 100%; }
  .pill:hover { background: color-mix(in srgb, var(--pc) 24%, var(--surface)); }
  .dot::before { content: ''; display: inline-block; width: .6em; height: .6em; border-radius: 50%; margin-right: .45em; background: var(--pc); }
  .empty { text-align: center; color: var(--muted); margin: 2rem 0; }
  .conf { margin: 14px 0; }
  .conf h3 { margin: 0 0 4px; }
  .blurb { margin: 0 0 12px; color: var(--muted); }
  .tablewrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
  .tablewrap:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  table { width: 100%; border-collapse: collapse; font-size: .92rem; min-width: 560px; }
  th, td { text-align: left; vertical-align: top; padding: 8px 12px; border-bottom: 1px solid var(--border); }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { background: var(--surface-2); position: sticky; top: 0; }
  tbody th[scope='row'] { font-weight: 600; width: 22%; background: color-mix(in srgb, var(--surface-2) 50%, transparent); }
  .rule { margin: 12px 0 0; padding: 10px 14px; border-radius: 10px; background: var(--accent-soft); }
  .sheet th[scope='row'] { white-space: normal; max-width: 100%; }
  .lvl { display: block; font-weight: 400; color: var(--muted); text-transform: capitalize; }
  .grouprow th { background: var(--accent-soft); color: var(--accent); font-size: .85rem; letter-spacing: .04em; }
  #cheat { margin-bottom: 3rem; }
</style>
