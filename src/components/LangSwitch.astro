---
import { languages } from '../languages.config';
interface Props {
  available?: string[]; // languages that have a sample on this page; others are dimmed
  label?: boolean; // show the small "Code in" caption
}
const { available, label = false } = Astro.props;
---
<div class="seg-wrap">
  {label && <span class="seg-label">Code in</span>}
  <div class="seg" role="group" aria-label="Programming language" style={`--n:${languages.length}`}>
    <span class="seg-pill" aria-hidden="true"></span>
    {languages.map((l) => {
      const off = available && !available.includes(l.id);
      return (
        <button type="button" class="seg-btn" data-set-lang={l.id} aria-pressed="false" aria-label={l.a11y} disabled={off} title={off ? `${l.label} sample not available yet` : `Show ${l.label} code everywhere`}>
          <span class="icon" set:html={l.icon} />
        </button>
      );
    })}
  </div>
</div>
<style is:global>
  .seg-wrap { display: flex; align-items: center; gap: 8px; }
  .seg-label { color: var(--muted); font-size: .8rem; }
  .seg { --i: 0; position: relative; display: grid; grid-template-columns: repeat(var(--n), 1fr); padding: 3px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--border); isolation: isolate; }
  .seg-pill { position: absolute; z-index: -1; top: 3px; bottom: 3px; left: 3px; width: calc((100% - 6px) / var(--n)); border-radius: 999px; background: var(--surface); box-shadow: 0 1px 3px rgb(0 0 0 / .18), 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent); transform: translateX(calc(var(--i) * 100%)); transition: transform .35s cubic-bezier(.3, 1.2, .4, 1); }
  .seg-btn { display: grid; place-items: center; padding: 6px 14px; background: none; border: 0; border-radius: 999px; cursor: pointer; }
  .seg-btn:hover:not(:disabled) .icon { transform: scale(1.08); }
  .seg-btn:disabled { opacity: .4; cursor: not-allowed; }
  .seg-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .icon { display: block; width: 26px; height: 26px; opacity: .7; filter: grayscale(.5); transition: transform .25s, opacity .2s, filter .2s; }
  .icon svg { display: block; width: 100%; height: 100%; }
  .seg-btn[aria-pressed='true'] .icon { opacity: 1; filter: none; transform: scale(1.1); }
  @media (max-width: 420px) { .seg-label { display: none; } .seg-btn { padding: 4px 6px; } .icon { width: 24px; height: 24px; } }
  @media (prefers-reduced-motion: reduce) { .seg-pill { transition: none; } }
</style>
