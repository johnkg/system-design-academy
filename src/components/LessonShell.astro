---
// Page frame shared by concept, pattern and case-study pages: an "On this page" list beside the lesson, and the lesson header.
import DoneToggle from './DoneToggle.astro';
import type { Section } from '../lib';
interface Props {
  crumbs: { label: string; href?: string; cap?: boolean }[];
  level: string;
  title: string;
  intent: string;
  scenario: { label: string; text: string };
  facts: string[];
  sections: Section[];
  done: { collection: 'concepts' | 'patterns' | 'studies'; slug: string };
  hasQuiz: boolean;
}
const { crumbs, level, title, intent, scenario, facts, sections, done, hasQuiz } = Astro.props;
---
<div class="lesson">
  <div class="lesson-top">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {crumbs.map((c) => <li aria-current={c.href ? undefined : 'page'}>{c.href ? <a href={c.href} class:list={{ cap: c.cap }}>{c.label}</a> : c.label}</li>)}
      </ol>
    </nav>
    <header class="lesson-head">
      <h1>{title}</h1>
      <p class="lede">{intent}</p>
      <p class="facts"><span class="badge" data-level={level}>{level}</span>{facts.map((f) => <span class="badge">{f}</span>)}</p>
      <div class="scenario">
        <p class="eyebrow">{scenario.label}</p>
        <p>{scenario.text}</p>
      </div>
      <p class="done-row"><DoneToggle collection={done.collection} slug={done.slug} />{hasQuiz && <a class="quiz-link" href="#quiz">Test yourself</a>}</p>
    </header>
  </div>

  <aside class="lesson-side">
    <nav class="toc card folded" aria-labelledby="toc-title" data-toc>
      <p class="eyebrow toc-title" id="toc-title">On this page</p>
      <button type="button" class="toc-toggle" aria-expanded="false" aria-controls="toc-list" data-toc-toggle>On this page</button>
      <ol id="toc-list">
        {sections.map((s) => <li><a href={`#${s.id}`} data-toc-link={s.id}><span class="num" aria-hidden="true">{s.num}</span>{s.label}</a></li>)}
      </ol>
    </nav>
    <slot name="side" />
  </aside>

  <div class="lesson-main">
    <slot />
  </div>
</div>

<script>
  // Highlight the section being read. On narrow screens the list sits above the lesson, so it starts folded behind a button.
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const toggle = toc.querySelector<HTMLButtonElement>('[data-toc-toggle]')!;
    const narrow = matchMedia('(max-width: 999px)');
    const setOpen = (open: boolean) => { toggle.setAttribute('aria-expanded', String(open)); toc.classList.toggle('folded', !open); };
    const fit = () => setOpen(!narrow.matches);
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    toc.addEventListener('click', (e) => { if (narrow.matches && (e.target as Element).closest('a')) setOpen(false); });
    narrow.addEventListener('change', fit);
    fit();
    const links = new Map([...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [a.dataset.tocLink!, a]));
    const heads = [...links.keys()].map((id) => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
    const mark = () => {
      const line = window.innerHeight * 0.3;
      let current = heads[0];
      for (const h of heads) if (h.getBoundingClientRect().top <= line) current = h;
      links.forEach((a, id) => (id === current?.id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
    };
    let queued = false;
    window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; mark(); }); } }, { passive: true });
    mark();
  }
</script>

<style is:global>
  .lesson { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px 40px; padding-top: 1.25rem; }
  .lesson-top { min-width: 0; }
  @media (min-width: 1000px) {
    .lesson { grid-template-columns: 230px minmax(0, 1fr); grid-template-rows: auto 1fr; row-gap: 0; }
    .lesson-top { grid-column: 2; grid-row: 1; }
    .lesson-main { grid-column: 2; grid-row: 2; }
    .lesson-side { grid-column: 1; grid-row: 1 / span 2; }
    .lesson-side { position: sticky; top: calc(var(--header-h) + 20px); align-self: start; max-height: calc(100vh - var(--header-h) - 40px); overflow-y: auto; display: grid; gap: 14px; padding: 2px; }
  }
  .lesson-side { min-width: 0; }
  .toc { padding: 8px; }
  .toc-title { padding: 6px 10px 8px; }
  .toc-toggle { justify-content: space-between; align-items: center; width: 100%; min-height: 44px; padding: 0 10px; border: 0; border-radius: 8px; background: none; color: var(--text); font: 600 .95rem var(--font-sans); cursor: pointer; }
  .toc-toggle::after { content: ''; width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-3px); }
  .toc-toggle[aria-expanded='true']::after { transform: rotate(-135deg) translateY(-3px); }
  .toc-toggle:focus-visible { outline: 3px solid var(--accent); outline-offset: 0; }
  /* The folded state is in the HTML and in CSS, so the page does not jump when the script runs on a narrow screen. */
  .toc-toggle { display: none; }
  @media (max-width: 999px) { .toc-toggle { display: flex; } .toc.folded ol, .toc-title { display: none; } }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .toc a { display: flex; align-items: center; gap: 10px; min-height: 38px; padding: 4px 10px; border-radius: 8px; color: var(--muted); text-decoration: none; font-size: .92rem; line-height: 1.3; }
  .toc a:hover { background: var(--surface-2); color: var(--text); }
  .toc a[aria-current] { background: var(--accent-soft); color: var(--text); font-weight: 600; }
  .toc .num { font: 600 .72rem var(--font-mono); color: var(--accent); flex: none; width: 1.6em; }
  .side-box { padding: 14px; display: grid; gap: 4px; font-size: .92rem; }
  .side-box .eyebrow { margin-top: 6px; }
  .side-box .eyebrow:first-child { margin-top: 0; }
  .lesson-main { min-width: 0; }
  .lesson-main > h2:first-of-type { margin-top: 2.5rem; }
  @media (max-width: 999px) { .lesson-main > h2:first-of-type { margin-top: 1.5rem; } }
  .crumbs { font-size: .9rem; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; color: var(--muted); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--muted); }
  .crumbs [aria-current] { color: var(--text); font-weight: 600; }
  .lesson-head h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; margin: .6rem 0 .4rem; }
  .lesson-head .lede { font-size: 1.15rem; margin: 0; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; }
  .scenario { margin-top: 16px; padding: 14px 18px; border-radius: 12px; background: var(--signal-soft); border: 1px solid var(--signal-line); max-width: 72ch; }
  .scenario .eyebrow { color: var(--signal-text); }
  .scenario p:last-child { margin: 4px 0 0; }
  .lesson-main h2 { scroll-margin-top: calc(var(--header-h) + 12px); }
  .lesson-main > :last-child { margin-bottom: 1rem; }
</style>
