---
// A diagram that grows one step at a time. Everything is rendered on the server; the script only changes what is visible.
interface Node { id: string; label: string; kind: string; x: number; y: number; at: number; until?: number }
interface Edge { from: string; to: string; at: number; until?: number }
interface Panel { title: string; lines: { label: string; text: string }[]; links: { name: string; href: string; kind: string }[] }
interface Props { nodes: Node[]; edges: Edge[]; panels: Panel[]; colors: Record<string, string>; label: string }
const { nodes, edges, panels, colors, label } = Astro.props;
const pos = new Map(nodes.map((n) => [n.id, n]));
---
<div class="grow" role="group" aria-label={label} data-grow data-nodes={JSON.stringify(nodes.map((n) => ({ id: n.id, at: n.at, until: n.until ?? 999, label: n.label, x: n.x, y: n.y })))} data-edges={JSON.stringify(edges.map((e) => ({ from: e.from, to: e.to, at: e.at, until: e.until ?? 999 })))}>
  <div class="stage">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {edges.map((e) => <line data-edge x1={pos.get(e.from)!.x} y1={pos.get(e.from)!.y} x2={pos.get(e.to)!.x} y2={pos.get(e.to)!.y} />)}
    </svg>
    {nodes.map((n) => <div class="gnode" data-node={n.id} style={`left:${n.x}%;top:${n.y}%;--c:${colors[n.kind] ?? 'var(--accent)'}`}>{n.label}</div>)}
  </div>
  <p class="sr" aria-live="polite" data-live></p>
  <div class="panels">
    {panels.map((p, i) => (
      <section class="card panel" data-panel={i} tabindex="-1">
        <h3>{p.title}</h3>
        {p.lines.map((l) => <p><strong>{l.label}</strong> {l.text}</p>)}
        {p.links.length > 0 && <p class="uses"><strong>Concepts:</strong> {p.links.map((c, k) => <>{k > 0 && ', '}<a href={c.href}>{c.name}</a></>)}</p>}
      </section>
    ))}
  </div>
  <div class="controls">
    <button class="btn" type="button" data-act="prev">Prev</button>
    <button class="btn pg-primary" type="button" data-act="next">Next</button>
    <span class="count" data-count></span>
  </div>
</div>
<script>
  import { spread } from '../spread';

  const PAD = 12; // px kept clear between two boxes on screen at the same time
  const MAX_STAGE_HEIGHT = 1400; // px: the stage grows taller on a narrow screen, but never beyond this
  const PERCENT = 100;

  document.querySelectorAll<HTMLElement>('[data-grow]').forEach((root) => {
    const nodes = JSON.parse(root.dataset.nodes!) as { id: string; at: number; until: number; label: string; x: number; y: number }[];
    const edges = JSON.parse(root.dataset.edges!) as { from: string; to: string; at: number; until: number }[];
    const nodeEls = [...root.querySelectorAll<HTMLElement>('[data-node]')];
    const edgeEls = [...root.querySelectorAll<SVGLineElement>('[data-edge]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const prev = root.querySelector<HTMLElement>('[data-act="prev"]')!;
    const next = root.querySelector<HTMLElement>('[data-act="next"]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const stage = root.querySelector<HTMLElement>('.stage')!;
    let cur = 0; const last = panels.length - 1;
    // Authors place nodes as fractions of the stage; on a phone that puts boxes on top of each other.
    // Move boxes that are on screen together apart (taller stage if needed) and redraw the lines to the new spots.
    let laidFor = 0; // stage width the current layout was made for
    function layout() {
      const width = stage.clientWidth;
      if (!width || width === laidFor) return;
      laidFor = width;
      stage.style.height = '';
      const wanted = nodes.map((n, i) => ({ fx: n.x / PERCENT, fy: n.y / PERCENT, w: nodeEls[i].offsetWidth, h: nodeEls[i].offsetHeight }));
      const overlap = (i: number, j: number) => Math.max(nodes[i].at, nodes[j].at) < Math.min(nodes[i].until, nodes[j].until);
      const { pos, height } = spread(wanted, width, stage.getBoundingClientRect().height, { pad: PAD, top: 0, maxHeight: MAX_STAGE_HEIGHT, together: overlap });
      stage.style.height = `${height}px`;
      const at = new Map(nodes.map((n, i) => [n.id, pos[i]]));
      nodeEls.forEach((el, i) => { el.style.left = `${pos[i].x}px`; el.style.top = `${pos[i].y}px`; });
      edgeEls.forEach((el, i) => {
        const a = at.get(edges[i].from)!, b = at.get(edges[i].to)!;
        el.setAttribute('x1', String((a.x / width) * PERCENT)); el.setAttribute('y1', String((a.y / height) * PERCENT));
        el.setAttribute('x2', String((b.x / width) * PERCENT)); el.setAttribute('y2', String((b.y / height) * PERCENT));
      });
    }
    function show() {
      nodes.forEach((n, i) => { const on = cur >= n.at && cur < n.until; const el = nodeEls[i]; el.classList.toggle('off', !on); el.classList.toggle('fresh', on && n.at === cur && cur > 0); });
      edges.forEach((e, i) => edgeEls[i].classList.toggle('off', !(cur >= e.at && cur < e.until)));
      panels.forEach((p, i) => (p.hidden = i !== cur));
      prev.setAttribute('aria-disabled', String(cur === 0)); next.setAttribute('aria-disabled', String(cur === last));
      count.textContent = cur === 0 ? `Start, then ${last} improvements` : `Improvement ${cur} of ${last}`;
      live.textContent = `Design now contains: ${nodes.filter((n) => cur >= n.at && cur < n.until).map((n) => n.label).join(', ')}.`;
    }
    // A link to #step-N (for example from a missed quiz question) opens the diagram at that step.
    function fromHash() {
      const m = /^#step-(\d+)$/.exec(location.hash);
      if (!m || Number(m[1]) > last) return;
      cur = Number(m[1]); show();
      root.scrollIntoView({ block: 'start' });
      panels[cur].focus({ preventScroll: true });
    }
    window.addEventListener('hashchange', fromHash);
    prev.addEventListener('click', () => { if (cur > 0) { cur--; show(); } });
    next.addEventListener('click', () => { if (cur < last) { cur++; show(); } });
    layout();
    show();
    fromHash();
    new ResizeObserver(() => layout()).observe(stage);
  });
</script>
<style>
  .stage { position: relative; height: 300px; border: 1px solid var(--border); border-radius: 12px; overflow-x: clip; background: var(--surface); margin-bottom: 12px; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  line { stroke: var(--muted); stroke-width: 2; vector-effect: non-scaling-stroke; transition: opacity .3s; }
  line.off { opacity: 0; }
  .gnode { position: absolute; transform: translate(-50%, -50%); width: max-content; max-width: 24%; text-align: center; padding: 6px 8px; border: 2px solid var(--c); border-radius: 10px; background: color-mix(in srgb, var(--c) 12%, var(--surface)); font-size: .82rem; font-weight: 600; line-height: 1.2; transition: opacity .3s, box-shadow .3s; }
  .gnode.off { opacity: 0; visibility: hidden; }
  .gnode.fresh { box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 35%, transparent); }
  .panel h3 { margin-top: 0; }
  .panel:focus { outline: none; }
  .panel:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .panel p { margin: .4rem 0; }
  .uses { color: var(--muted); }
  .controls { display: flex; gap: 8px; align-items: center; margin-top: 12px; flex-wrap: wrap; }
  .count { color: var(--muted); font-size: .9rem; }
  @media (max-width: 560px) { .stage { height: 340px; } .gnode { font-size: .72rem; padding: 4px 5px; max-width: 22%; min-width: min-content; overflow-wrap: normal; } }
  @media (prefers-reduced-motion: reduce) { .gnode, line { transition: none; } }
</style>
