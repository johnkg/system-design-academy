---
// The header's choice of language for every code sample on the site. A labelled menu, so it is clear what it changes.
import { languages } from '../languages.config';
---
<div class="lang-menu">
  <span class="lm-cap" aria-hidden="true">Code in</span>
  <svg class="lm-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14" /></svg>
  <select class="lm-select" data-lang-select aria-label="Language for code samples" title="Language for every code sample on the site">
    {languages.map((l) => <option value={l.id}>{l.label}</option>)}
  </select>
  <svg class="lm-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
</div>
<style is:global>
  .lang-menu { position: relative; display: flex; align-items: center; min-height: 40px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--text); }
  .lang-menu:hover { background: var(--surface-2); }
  .lang-menu:focus-within { outline: 3px solid var(--accent); outline-offset: 1px; }
  .lm-cap { padding-left: 12px; font: .78rem var(--font-mono); color: var(--muted); white-space: nowrap; }
  .lm-icon { position: absolute; left: 12px; display: none; color: var(--muted); pointer-events: none; }
  .lm-chev { position: absolute; right: 10px; color: var(--muted); pointer-events: none; }
  .lm-select { appearance: none; -webkit-appearance: none; min-height: 38px; padding: 0 30px 0 8px; border: 0; border-radius: 10px; background: transparent; color: inherit; font: 500 .92rem var(--font-sans); cursor: pointer; outline: none; }
  .lm-select option { background: var(--surface); color: var(--text); }
  @media (max-width: 640px) {
    .lm-cap { display: none; }
    .lm-icon { display: block; }
    .lm-select { padding-left: 34px; }
  }
  @media (max-width: 360px) { .lm-select { font-size: .85rem; padding-right: 24px; } .lm-chev { right: 6px; } }
  @media (forced-colors: active) { .lang-menu { border-color: ButtonText; } }
</style>
