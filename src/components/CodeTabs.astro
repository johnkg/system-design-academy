---
import LangSwitch from './LangSwitch.astro';
import { getCode } from '../lib';
import CodeBlock from './CodeBlock.astro';
interface Props { slug: string; collection?: 'patterns' | 'concepts' | 'studies' }
const samples = getCode(Astro.props.slug, Astro.props.collection);
const available = new Set(samples.map((s) => s.lang.id));
---
<div class="code-tabs">
  <div class="tabs"><LangSwitch label available={[...available]} /></div>
  <CodeBlock samples={samples} filename={Astro.props.slug} />
</div>
<style>.tabs { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 10px; } small { color: var(--muted); }</style>
