---
// Title block shared by the list pages (case studies, practice, search, compare): a mono eyebrow, the title, a short lede and an optional slot for stats or links.
interface Props { eyebrow: string; title: string; lede?: string }
const { eyebrow, title, lede } = Astro.props;
---
<header class="page-head">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>
<style is:global>
  .page-head { position: relative; isolation: isolate; display: flex; flex-direction: column; gap: 12px; padding: 2.75rem 0 1.25rem; }
  .page-head::before { content: ''; position: absolute; inset: 0 -16px; z-index: -1; pointer-events: none;
    background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 32px 32px; background-position: center -1px; opacity: .7;
    -webkit-mask-image: radial-gradient(ellipse at 20% 30%, #000 25%, transparent 72%); mask-image: radial-gradient(ellipse at 20% 30%, #000 25%, transparent 72%); }
  .page-head > * { margin: 0; }
  .page-head h1 { font-size: clamp(2rem, 5.5vw, 3rem); line-height: 1.1; max-width: 22ch; }
  .page-head .lede { font-size: 1.12rem; max-width: 62ch; }
</style>
