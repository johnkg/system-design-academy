---
// A labelled slider with a live readout. `name` ties the markup to the simulation script:
// the slider is found with [data-<name>] and the readout with [data-<name>val].
interface Props {
  label: string;
  name: string;
  min: string | number;
  max: string | number;
  value: string | number;
  step?: string | number;
  /** Text shown in the readout before the script first updates it. */
  readout?: string;
}
const { label, name, min, max, value, step, readout = '' } = Astro.props;
const sliderHook = { [`data-${name}`]: '' };
const readoutHook = { [`data-${name}val`]: '' };
---
<label>{label} <input type="range" min={min} max={max} step={step} value={value} {...sliderHook} /> <b {...readoutHook}>{readout}</b></label>
