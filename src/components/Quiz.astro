---
// A short self-check at the end of a concept page. Every question is a small scenario with one best answer and an explanation.
// The last result is kept in this browser (localStorage), nothing is sent anywhere.
interface Q { question: string; options: string[]; answer: number; explanation: string }
interface Props { slug: string; questions: Q[] }
const { slug, questions } = Astro.props;
---
<div class="card quiz" data-quiz data-slug={slug}>
  <p class="intro">Three short scenarios. Pick the best answer for each, then check. Wrong answers are explained too, because the tempting wrong answer is usually the lesson.</p>
  {questions.map((q, i) => (
    <fieldset class="q" data-q={i} data-answer={q.answer}>
      <legend><span class="qn">Question {i + 1} of {questions.length}.</span> {q.question}</legend>
      {q.options.map((o, j) => (
        <label class="opt"><input type="radio" name={`q${i}`} value={j} /> <span>{o}</span></label>
      ))}
      <p class="fb" data-fb hidden></p>
      <template data-why>{q.explanation}</template>
    </fieldset>
  ))}
  <div class="actions">
    <button type="button" class="btn pg-primary" data-check>Check answers</button>
    <button type="button" class="btn" data-retry hidden>Try again</button>
  </div>
  <p class="score" data-score aria-live="polite"></p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((root) => {
    const key = `sda-quiz/${root.dataset.slug}`;
    const qs = [...root.querySelectorAll<HTMLElement>('[data-q]')];
    const score = root.querySelector<HTMLElement>('[data-score]')!;
    const check = root.querySelector<HTMLButtonElement>('[data-check]')!;
    const retry = root.querySelector<HTMLButtonElement>('[data-retry]')!;
    const read = () => { try { return localStorage.getItem(key); } catch { return null; } };
    const write = (v: string) => { try { localStorage.setItem(key, v); } catch { /* storage blocked: the result just is not remembered */ } };
    const last = read();
    if (last) score.textContent = `Your last result: ${last}.`;

    check.addEventListener('click', () => {
      const unanswered = qs.filter((q) => !q.querySelector('input:checked'));
      if (unanswered.length) {
        score.textContent = `Answer ${unanswered.length === 1 ? 'the remaining question' : `all ${qs.length} questions`} first (${unanswered.length} left).`;
        return;
      }
      let right = 0;
      qs.forEach((q) => {
        const answer = Number(q.dataset.answer);
        const picked = Number((q.querySelector('input:checked') as HTMLInputElement).value);
        const ok = picked === answer;
        if (ok) right++;
        const fb = q.querySelector<HTMLElement>('[data-fb]')!;
        const why = q.querySelector<HTMLTemplateElement>('[data-why]')!.content.textContent ?? q.querySelector('[data-why]')!.textContent ?? '';
        const best = q.querySelectorAll('.opt span')[answer].textContent;
        fb.textContent = ok ? `Correct. ${why}` : `Not quite. The best answer is: "${(best ?? '').trim().replace(/[.]$/, '')}". ${why}`;
        fb.hidden = false;
        fb.classList.toggle('bad', !ok);
        q.querySelectorAll<HTMLElement>('.opt').forEach((o, j) => {
          o.classList.toggle('is-right', j === answer);
          o.classList.toggle('is-wrong', j === picked && !ok);
        });
        q.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.disabled = true));
      });
      const text = `${right} of ${qs.length} correct`;
      score.textContent = right === qs.length ? `${text}. Nice: mark this concept as done at the top of the page.` : `${text}. Read the explanations, then try again.`;
      write(text);
      check.hidden = true; retry.hidden = false;
      retry.focus();
    });
    retry.addEventListener('click', () => {
      qs.forEach((q) => {
        q.querySelectorAll<HTMLInputElement>('input').forEach((i) => { i.checked = false; i.disabled = false; });
        q.querySelectorAll<HTMLElement>('.opt').forEach((o) => o.classList.remove('is-right', 'is-wrong'));
        q.querySelector<HTMLElement>('[data-fb]')!.hidden = true;
      });
      score.textContent = '';
      check.hidden = false; retry.hidden = true;
      check.focus();
    });
  });
</script>
<style>
  .quiz { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .quiz .intro { margin: 0; color: var(--muted); }
  .q { border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px 12px; margin: 0; display: grid; gap: 8px; min-width: 0; }
  .q legend { font-weight: 600; padding: 0 6px; max-width: 100%; overflow-wrap: anywhere; }
  .qn { color: var(--muted); font-weight: 500; }
  .opt { display: flex; gap: 10px; align-items: flex-start; padding: 6px 10px; border: 1px solid var(--border); border-radius: 8px; cursor: pointer; background: var(--surface); }
  .opt input { margin-top: .35em; flex: none; }
  .opt span { min-width: 0; overflow-wrap: anywhere; }
  .fb { overflow-wrap: anywhere; }
  .opt:hover { background: var(--surface-2); }
  .opt.is-right { border-color: var(--good); box-shadow: inset 4px 0 0 var(--good); }
  .opt.is-wrong { border-color: var(--bad); box-shadow: inset 4px 0 0 var(--bad); }
  .fb { margin: 0; padding: 8px 12px; border-radius: 8px; background: var(--accent-soft); }
  .fb.bad { background: color-mix(in srgb, var(--bad) 12%, var(--surface)); }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .score { margin: 0; font-weight: 600; }
</style>
