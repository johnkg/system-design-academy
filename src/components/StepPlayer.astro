---
interface Actor { id: string; label: string; role: string; x: number; y: number }
interface Frame {
  narration: string;
  messages?: { from: string; to: string; label: string }[];
  states?: Record<string, string>;
  highlight?: string[];
  // Persistent connections (e.g. "subscribed"). Cumulative across frames.
  links?: { add?: [string, string][]; remove?: [string, string][] };
}
// flow: show the Flow / Step by step switch, and stream moving dots along each message by default.
interface Props { steps: { actors: Actor[]; frames: Frame[]; linkLabel?: string }; colors: Record<string, string>; flow?: boolean }
const { steps, colors, flow = false } = Astro.props;
---
<div class="player" role="group" aria-label="Step-by-step animation" data-player data-flow={flow ? '' : undefined} data-frames={JSON.stringify(steps.frames)} tabindex="-1">
  <div class="stage" data-stage>
    <svg class="arrows" data-arrows aria-hidden="true"></svg>
    {steps.actors.map((a) => (
      <div class="actor" data-id={a.id} data-x={a.x} data-y={a.y} style={`left:${a.x}%;top:${a.y}%;--c:${colors[a.role] ?? 'var(--accent)'}`}>
        <strong>{a.label}</strong>
        <span class="state" data-state></span>
      </div>
    ))}
    <div class="labels" data-labels></div>
  </div>
  <p class="narration" data-narration aria-live="polite"></p>
  <div class="controls">
    <button class="btn" type="button" data-act="reset">Restart</button>
    <button class="btn" type="button" data-act="prev">Prev</button>
    <button class="btn" type="button" data-act="play">Play</button>
    <button class="btn primary" type="button" data-act="next">Next</button>
    <div class="progress" aria-hidden="true">{steps.frames.map(() => <i></i>)}</div>
    <span class="count" data-count></span>
  </div>
  {flow && (
    <div class="flowbar" data-flowbar>
      <div class="seg" role="group" aria-label="Animation style">
        <button class="btn" type="button" data-mode="flow" aria-pressed="true">Flow</button>
        <button class="btn" type="button" data-mode="step" aria-pressed="false">Step by step</button>
      </div>
      <div class="seg" role="group" aria-label="Flow speed" data-speed-group>
        {[0.5, 1, 2].map((v) => <button class="btn" type="button" data-speed={v} aria-pressed={v === 1}>{v}×</button>)}
      </div>
      <button class="btn" type="button" data-act="motion" aria-pressed="false">Pause motion</button>
    </div>
  )}
  {steps.linkLabel && <p class="key"><svg width="30" height="8" aria-hidden="true"><line x1="0" y1="4" x2="30" y2="4" /></svg> {steps.linkLabel}</p>}
</div>
<script>
  import { spread } from '../spread';

  interface Frame {
    narration: string;
    messages?: { from: string; to: string; label: string }[];
    states?: Record<string, string>;
    highlight?: string[];
    links?: { add?: [string, string][]; remove?: [string, string][] };
  }

  const TRAVEL = 850; // ms for a message to cross the stage
  const AUTOPLAY_MS = 3000; // time on each step when playing
  const SELF_ARROW = 26; // px: length of the arrow drawn into an actor that messages itself
  const PAD = 14; // px kept clear between two boxes
  const MAX_STAGE_HEIGHT = 1400; // px: the stage grows taller on a narrow screen, but never beyond this
  // The dot's flight as fractions of TRAVEL: it grows in, crosses, then pops on arrival; the receiver reacts just before it lands.
  const DOT = { start: 0.4, pop: 1.8, inEnd: 0.12, outStart: 0.88 }, STATE_AT = 0.9, PULSE_AT = 0.88;
  const STREAM_DOTS = 3; // dots in flight at once along each message in Flow mode
  const STREAM_GAP = 250; // ms of rest between one dot's landing and its next start
  const SPEEDS = [0.5, 1, 2];
  const SVG_NS = 'http://www.w3.org/2000/svg';

  document.querySelectorAll<HTMLElement>('[data-player]').forEach((root) => {
    const frames: Frame[] = JSON.parse(root.dataset.frames!);
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const svg = root.querySelector<SVGSVGElement>('[data-arrows]')!;
    const labels = root.querySelector<HTMLElement>('[data-labels]')!;
    const dots = [...root.querySelectorAll<HTMLElement>('.progress i')];
    const actors = new Map([...root.querySelectorAll<HTMLElement>('.actor')].map((a) => [a.dataset.id!, a]));
    const btn = (act: string) => root.querySelector<HTMLButtonElement>(`[data-act=${act}]`)!;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let timer: number | undefined;
    let token = 0; // bumps on every render so stale timeouts from an interrupted animation do nothing
    let running: Animation[] = [];

    // Flow mode (pilot lessons only): dots keep streaming along each message until the next step. "Step by step" is the original one-dot-per-step player.
    const flowCapable = root.hasAttribute('data-flow');
    const saved = (() => { try { return JSON.parse(localStorage.getItem('sda-flow') ?? '{}'); } catch { return {}; } })();
    let mode: 'flow' | 'step' = saved.mode === 'step' ? 'step' : 'flow';
    let speed: number = SPEEDS.includes(saved.speed) ? saved.speed : 1;
    let motionPaused = false;
    const flowing = () => flowCapable && mode === 'flow' && !reduceMotion.matches;

    type Box = { x: number; y: number; w: number; h: number };
    function box(el: HTMLElement): Box {
      const s = stage.getBoundingClientRect(), r = el.getBoundingClientRect();
      return { x: r.left - s.left + r.width / 2, y: r.top - s.top + r.height / 2, w: r.width, h: r.height };
    }
    // Stop a line at the edge of the box instead of its centre.
    function edge(from: Box, to: Box) {
      const dx = to.x - from.x, dy = to.y - from.y;
      const s = Math.min(dx ? from.w / 2 / Math.abs(dx) : Infinity, dy ? from.h / 2 / Math.abs(dy) : Infinity);
      return { x: from.x + dx * s, y: from.y + dy * s };
    }
    function stateAt(i: number) {
      const out: Record<string, string> = {};
      for (let k = 0; k <= i; k++) Object.assign(out, frames[k].states);
      return out;
    }
    function linksAt(i: number) {
      const out = new Set<string>();
      for (let k = 0; k <= i; k++) {
        frames[k].links?.add?.forEach(([a, b]) => out.add(`${a}>${b}`));
        frames[k].links?.remove?.forEach(([a, b]) => out.delete(`${a}>${b}`));
      }
      return out;
    }
    function line(a: string, b: string, cls: string) {
      const ca = box(actors.get(a)!), cb = box(actors.get(b)!);
      // A message from an actor to itself (a == b) has no direction: draw a short arrow coming down into the box from above.
      const self = a === b;
      const p1 = self ? { x: ca.x, y: ca.y - ca.h / 2 - SELF_ARROW } : edge(ca, cb);
      const p2 = self ? { x: ca.x, y: ca.y - ca.h / 2 } : edge(cb, ca);
      const el = document.createElementNS(SVG_NS, 'line');
      el.setAttribute('x1', String(p1.x)); el.setAttribute('y1', String(p1.y));
      el.setAttribute('x2', String(p2.x)); el.setAttribute('y2', String(p2.y));
      el.setAttribute('class', cls);
      svg.appendChild(el);
      return { p1, p2 };
    }
    function restart(el: Element, cls: string) {
      el.classList.remove(cls);
      void (el as HTMLElement).offsetWidth; // force reflow so the animation replays
      el.classList.add(cls);
    }
    function setState(el: HTMLElement, text: string, flash: boolean) {
      const changed = el.textContent !== text;
      el.textContent = text;
      if (changed && flash && text) restart(el, 'flash');
    }

    // The longest text each actor will ever show, so its box is reserved at full size and never moves into a neighbour later.
    const longest = new Map<string, string>();
    frames.forEach((f) => Object.entries(f.states ?? {}).forEach(([id, text]) => { if (text.length > (longest.get(id)?.length ?? 0)) longest.set(id, text); }));
    function reserved(id: string, el: HTMLElement) {
      const target = el.querySelector<HTMLElement>('[data-state]')!, shown = target.textContent;
      target.textContent = longest.get(id) ?? '';
      const size = { w: el.offsetWidth, h: el.offsetHeight };
      target.textContent = shown;
      return size;
    }
    // Place every box where the author wanted it, then move boxes apart (and make the stage taller) until none touch.
    let laidFor = 0; // stage width the current layout was made for
    function placeActors() {
      const width = stage.clientWidth;
      if (!width || width === laidFor) return;
      laidFor = width;
      stage.style.height = '';
      const entries = [...actors.entries()];
      const wanted = entries.map(([id, el]) => ({ fx: parseFloat(el.dataset.x!) / 100, fy: parseFloat(el.dataset.y!) / 100, ...reserved(id, el) }));
      const { pos, height } = spread(wanted, width, stage.getBoundingClientRect().height, { pad: PAD, top: SELF_ARROW + PAD, maxHeight: MAX_STAGE_HEIGHT });
      stage.style.height = `${height}px`;
      entries.forEach(([, el], i) => { el.style.left = `${pos[i].x}px`; el.style.top = `${pos[i].y}px`; });
    }

    const at = (p: { x: number; y: number }, scale: number, opacity: number, offset: number) => ({
      transform: `translate(${p.x}px, ${p.y}px) translate(-50%, -50%) scale(${scale})`, opacity, offset,
    });
    // Dots that loop along one message, evenly spaced, coloured like the sender. They fade in at the sender, cross, and pop at the receiver.
    function stream(from: string, p1: { x: number; y: number }, p2: { x: number; y: number }, travel: number) {
      const gap = STREAM_GAP / speed, period = travel + gap, f = travel / period;
      const color = actors.get(from)!.style.getPropertyValue('--c');
      for (let i = 0; i < STREAM_DOTS; i++) {
        const dot = document.createElement('i');
        dot.className = 'dot flow';
        if (color) dot.style.setProperty('--dc', color);
        labels.appendChild(dot);
        running.push(dot.animate(
          [at(p1, DOT.start, 0, 0), at(p1, 1, 1, DOT.inEnd * f), at(p2, 1, 1, DOT.outStart * f), at(p2, DOT.pop, 0, f), at(p1, DOT.start, 0, 1)],
          { duration: period, delay: (i * period) / STREAM_DOTS, iterations: Infinity, easing: 'linear' },
        ));
      }
    }

    // animate=true only when stepping forward one frame; Prev/Restart/resize jump straight to the final picture.
    function render(animate: boolean) {
      placeActors();
      const my = ++token;
      running.forEach((a) => a.cancel());
      running = [];
      const flow = flowing(), streaming = flow && !motionPaused;
      const travel = flow ? TRAVEL / speed : TRAVEL;
      const motion = animate && !reduceMotion.matches && !(flow && motionPaused);
      const frame = frames[index];
      const states = stateAt(index);
      const links = linksAt(index);
      const prevLinks = motion && index > 0 ? linksAt(index - 1) : links;
      const messages = frame.messages ?? [];
      const receivers = new Set(messages.map((m) => m.to));

      actors.forEach((el, id) => {
        const active = frame.highlight?.includes(id) || messages.some((m) => m.from === id || m.to === id);
        el.classList.toggle('active', !!active);
      });

      const rect = stage.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${rect.width} ${rect.height}`);
      svg.innerHTML = '<defs><marker id="sp-arrow" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="9" markerHeight="9" orient="auto"><path d="M1 1 L11 6 L1 11 Z" fill="currentColor"/></marker></defs>';
      labels.innerHTML = '';

      // Persistent connections: new ones fade in, removed ones fade out, the rest stay put.
      new Set([...prevLinks, ...links]).forEach((key) => {
        const [a, b] = key.split('>');
        const state = links.has(key) ? (prevLinks.has(key) ? '' : ' new') : ' gone';
        line(a, b, `link${state}`);
      });

      // Messages: faint trail with arrowhead, label chip, and a dot that travels sender -> receiver.
      messages.forEach((m) => {
        const { p1, p2 } = line(m.from, m.to, motion ? 'trail draw' : 'trail');
        svg.lastElementChild!.setAttribute('marker-end', 'url(#sp-arrow)');
        if (motion) (svg.lastElementChild as SVGElement).style.animationDuration = `${travel}ms`;
        const tag = document.createElement('span');
        tag.className = motion ? 'tag in' : 'tag';
        tag.textContent = m.label;
        tag.style.top = `${(p1.y + p2.y) / 2}px`;
        labels.appendChild(tag);
        // Keep long labels inside the stage so they never cause horizontal page scroll.
        const half = tag.offsetWidth / 2 + 2;
        tag.style.left = `${Math.min(Math.max((p1.x + p2.x) / 2, half), Math.max(half, rect.width - half))}px`;
        if (streaming) return stream(m.from, p1, p2, travel);
        if (!motion) return;
        const dot = document.createElement('i');
        dot.className = 'dot';
        labels.appendChild(dot);
        running.push(dot.animate(
          [at(p1, DOT.start, 0, 0), at(p1, 1, 1, DOT.inEnd), at(p2, 1, 1, DOT.outStart), at(p2, DOT.pop, 0, 1)],
          { duration: travel, easing: 'cubic-bezier(.45,0,.25,1)', fill: 'forwards' },
        ));
      });

      // State text. Receivers update when the dot arrives; everyone else updates immediately.
      actors.forEach((el, id) => {
        const target = el.querySelector<HTMLElement>('[data-state]')!;
        const text = states[id] ?? '';
        if (motion && receivers.has(id) && target.textContent !== text) {
          window.setTimeout(() => { if (my === token) setState(target, text, true); }, travel * STATE_AT);
        } else {
          setState(target, text, motion);
        }
      });
      if (motion && receivers.size) {
        window.setTimeout(() => {
          if (my !== token) return;
          receivers.forEach((id) => restart(actors.get(id)!, 'pulse'));
        }, travel * PULSE_AT);
      }

      root.querySelector('[data-narration]')!.textContent = frame.narration;
      root.querySelector('[data-count]')!.textContent = `Step ${index + 1} of ${frames.length}`;
      dots.forEach((d, i) => { d.classList.toggle('done', i < index); d.classList.toggle('now', i === index); });
      // aria-disabled (not disabled) so keyboard focus is never dropped when the end is reached.
      btn('prev').setAttribute('aria-disabled', String(index === 0));
      btn('next').setAttribute('aria-disabled', String(index === frames.length - 1));
    }

    function stop() {
      window.clearInterval(timer); timer = undefined;
      btn('play').textContent = 'Play';
    }
    function go(i: number) {
      const next = Math.max(0, Math.min(frames.length - 1, i));
      const forwardOne = next === index + 1;
      index = next;
      render(forwardOne);
    }

    btn('next').addEventListener('click', () => { stop(); if (index < frames.length - 1) go(index + 1); });
    btn('prev').addEventListener('click', () => { stop(); if (index > 0) go(index - 1); });
    btn('reset').addEventListener('click', () => { stop(); go(0); });
    btn('play').addEventListener('click', () => {
      if (timer) return stop();
      if (index === frames.length - 1) go(0);
      btn('play').textContent = 'Pause';
      timer = window.setInterval(() => {
        if (index >= frames.length - 1) return stop();
        go(index + 1);
      }, flowing() ? AUTOPLAY_MS / speed : AUTOPLAY_MS);
    });
    // The Flow / Step by step switch, speed and pause. Hidden for people who ask the system for reduced motion: they get the still step view.
    const bar = root.querySelector<HTMLElement>('[data-flowbar]');
    function syncBar() {
      if (!bar) return;
      bar.hidden = reduceMotion.matches;
      bar.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
      bar.querySelectorAll<HTMLButtonElement>('[data-speed]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.speed) === speed)));
      bar.querySelector<HTMLElement>('[data-speed-group]')!.hidden = mode !== 'flow';
      const pause = bar.querySelector<HTMLButtonElement>('[data-act=motion]')!;
      pause.hidden = mode !== 'flow';
      pause.setAttribute('aria-pressed', String(motionPaused));
    }
    function remember() { try { localStorage.setItem('sda-flow', JSON.stringify({ mode, speed })); } catch { /* private window: keep the choice for this visit only */ } }
    bar?.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button');
      if (!b) return;
      if (b.dataset.mode) mode = b.dataset.mode as 'flow' | 'step';
      else if (b.dataset.speed) speed = Number(b.dataset.speed);
      else if (b.dataset.act === 'motion') motionPaused = !motionPaused;
      else return;
      remember(); stop(); syncBar(); render(false);
    });
    reduceMotion.addEventListener('change', () => { syncBar(); render(false); });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { stop(); go(index + 1); }
      if (e.key === 'ArrowLeft') { stop(); go(index - 1); }
    });
    // Re-layout on resize without replaying the animation.
    new ResizeObserver(() => { if (stage.clientWidth !== laidFor) render(false); }).observe(stage);
    syncBar();
    render(false);
  });
</script>
<style>
  .player { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 0; overflow: hidden; }
  .player > :not(.stage) { margin-left: 16px; margin-right: 16px; }
  .player > :last-child { margin-bottom: 14px; }
  .stage { position: relative; height: 300px; overflow-x: clip; background-image: radial-gradient(var(--border) 1px, transparent 1px); background-size: 18px 18px; border-bottom: 1px solid var(--border); }
  .arrows { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--muted); pointer-events: none; }
  .arrows :global(line) { stroke: currentColor; }
  .arrows :global(.trail) { stroke-width: 2; opacity: .55; }
  .arrows :global(.trail.draw) { stroke-dasharray: 500; stroke-dashoffset: 500; animation: draw .85s cubic-bezier(.45, 0, .25, 1) forwards; }
  .arrows :global(.link) { stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 5 5; opacity: .6; }
  .arrows :global(.link.new) { animation: fade-in .6s ease both; }
  .arrows :global(.link.gone) { animation: fade-out .6s ease forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade-in { from { opacity: 0; } }
  @keyframes fade-out { to { opacity: 0; } }
  .labels :global(.dot.flow) { width: 12px; height: 12px; background: var(--dc, var(--accent)); box-shadow: 0 0 0 4px color-mix(in srgb, var(--dc, var(--accent)) 28%, transparent), 0 0 12px var(--dc, var(--accent)); }
  .labels :global(.tag) { position: absolute; z-index: 1; transform: translate(-50%, -140%); background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: 1px 8px; font: .78rem var(--font-mono); max-width: 90%; text-align: center; }
  .labels :global(.tag.in) { animation: tag-in .4s ease both; }
  @keyframes tag-in { from { opacity: 0; transform: translate(-50%, -100%); } }
  .labels :global(.dot) { position: absolute; left: 0; top: 0; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 30%, transparent), 0 0 14px var(--accent); opacity: 0; will-change: transform; }
  .actor { position: absolute; transform: translate(-50%, -50%); width: max-content; min-width: 130px; max-width: 42%; text-align: center; padding: 8px 10px; border: 2px solid var(--c); border-radius: 10px; background: var(--surface); transition: box-shadow .35s, background .35s, opacity .35s; z-index: 1; }
  .actor.active { background: color-mix(in srgb, var(--c) 14%, var(--surface)); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 28%, transparent); }
  .actor.pulse { animation: pulse .5s ease-out; }
  @keyframes pulse { 0% { transform: translate(-50%, -50%) scale(1); } 35% { transform: translate(-50%, -50%) scale(1.08); } 100% { transform: translate(-50%, -50%) scale(1); } }
  .state { display: block; min-height: 1.3em; font: .75rem var(--font-mono); color: var(--muted); overflow-wrap: anywhere; border-radius: 4px; }
  .state.flash { animation: flash .9s ease-out; }
  @keyframes flash { 0% { background: color-mix(in srgb, var(--c, var(--accent)) 26%, transparent); color: var(--text); } 100% { background: transparent; } }
  .narration { min-height: 3em; margin: 12px 0 10px; font-size: 1.02rem; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .progress { display: flex; gap: 4px; margin-left: 8px; }
  .progress :global(i) { width: 18px; height: 5px; border-radius: 3px; background: var(--border); transition: background .3s, transform .3s; }
  .progress :global(i.done) { background: color-mix(in srgb, var(--accent) 55%, var(--border)); }
  .progress :global(i.now) { background: var(--accent); transform: scaleY(1.5); }
  .flowbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 10px; }
  .flowbar[hidden], .flowbar [hidden] { display: none; }
  .seg { display: inline-flex; gap: 4px; }
  .flowbar .btn[aria-pressed='true'] { background: var(--accent-soft); border-color: var(--accent); color: var(--text); font-weight: 600; }
  .count { margin-left: auto; color: var(--muted); font-size: .85rem; }
  .key { display: flex; align-items: center; gap: 8px; margin: 10px 0 0; color: var(--muted); font-size: .8rem; }
  .key line { stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 5 5; }
  @media (max-width: 520px) { .stage { height: 340px; } .actor { min-width: 78px; max-width: 32%; font-size: .75rem; padding: 6px 6px; } .progress { order: 5; width: 100%; margin: 4px 0 0; } .progress :global(i) { flex: 1; } }
</style>
