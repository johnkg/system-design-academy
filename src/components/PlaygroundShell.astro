---
interface Props { title?: string; hint?: string }
const { title = 'Try it yourself', hint } = Astro.props;
---
<section class="playground card">
  <header><strong>{title}</strong>{hint && <span class="hint">{hint}</span>}</header>
  <slot />
</section>
<style>
  /* Amber band: amber marks the parts of a page you can drive yourself. */
  header { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; margin: -16px -16px 16px; padding: 12px 16px; background: var(--signal-soft); border-bottom: 1px solid var(--signal-line); border-radius: var(--radius) var(--radius) 0 0; }
  strong { font: 600 .8rem var(--font-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--signal-text); }
  .hint { color: var(--text); font-size: .92rem; }
</style>
