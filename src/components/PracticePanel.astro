---
// "Practise first": a place to write your own design before reading the solution, and a checklist of the design moves it contains.
// Notes and ticks stay in this browser (localStorage).
interface Props { slug: string; moves: string[] }
const { slug, moves } = Astro.props;
---
<details class="card practice" data-practice data-slug={slug}>
  <summary>Practise first: design it yourself</summary>
  <p>Read the task, then sketch your own answer before you open the steps below: what you would store, what runs where, and what breaks first. About fifteen minutes is plenty.</p>
  <label class="plabel" for={`notes-${slug}`}>Your design notes</label>
  <textarea id={`notes-${slug}`} class="pg-in notes" rows="7" data-notes placeholder="Components, data, numbers, what you would build first…"></textarea>
  <p class="pg-note" data-saved aria-live="polite">Notes stay in this browser only.</p>
  <fieldset class="checks">
    <legend>When you are done, tick the design moves your answer already had</legend>
    {moves.map((m, i) => (
      <label class="check"><input type="checkbox" data-check={i} /> <span>{m}</span></label>
    ))}
  </fieldset>
  <p class="result" data-result aria-live="polite"></p>
  <button type="button" class="btn" data-clear>Clear my notes and ticks</button>
</details>
<script>
  document.querySelectorAll<HTMLElement>('[data-practice]').forEach((root) => {
    const slug = root.dataset.slug!;
    const notesKey = `sda-notes/${slug}`, checksKey = `sda-checks/${slug}`;
    const notes = root.querySelector<HTMLTextAreaElement>('[data-notes]')!;
    const saved = root.querySelector<HTMLElement>('[data-saved]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-check]')];
    const read = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
    const write = (k: string, v: string | null) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); return true; } catch { return false; } };

    notes.value = read(notesKey) ?? '';
    try { const on: number[] = JSON.parse(read(checksKey) ?? '[]'); boxes.forEach((b, i) => (b.checked = on.includes(i))); } catch { /* ignore a damaged value */ }

    function summary() {
      const hit = boxes.filter((b) => b.checked).length;
      const missed = boxes.filter((b) => !b.checked).map((b) => b.nextElementSibling!.textContent);
      result.textContent = hit === 0 ? '' : hit === boxes.length
        ? `Your answer had all ${boxes.length} design moves. Open the steps to compare the trade-offs.`
        : `Your answer had ${hit} of ${boxes.length} design moves. Read these steps first: ${missed.join('; ')}.`;
    }
    let timer = 0;
    notes.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => { saved.textContent = write(notesKey, notes.value) ? 'Saved in this browser.' : 'Could not save here (storage is blocked); keep a copy of your notes.'; }, 400);
    });
    root.addEventListener('change', (e) => {
      if (!(e.target as Element).matches('[data-check]')) return;
      write(checksKey, JSON.stringify(boxes.flatMap((b, i) => (b.checked ? [i] : []))));
      summary();
    });
    root.querySelector('[data-clear]')!.addEventListener('click', () => {
      notes.value = ''; boxes.forEach((b) => (b.checked = false));
      write(notesKey, null); write(checksKey, null); summary();
      saved.textContent = 'Cleared.';
    });
    summary();
  });
</script>
<style>
  .practice { margin: 1.2rem 0 0; }
  .practice summary { cursor: pointer; font-weight: 600; }
  .practice summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 4px; }
  .plabel { display: block; font-weight: 600; margin: .6rem 0 .3rem; }
  .notes { width: 100%; font-family: inherit; resize: vertical; }
  .checks { border: 1px solid var(--border); border-radius: 10px; margin: .8rem 0; padding: 8px 14px 10px; display: grid; gap: 6px; }
  .checks legend { padding: 0 6px; font-weight: 600; }
  .check { display: flex; gap: 8px; align-items: flex-start; }
  .check input { margin-top: .35em; }
  .result { margin: .4rem 0 .8rem; }
</style>
