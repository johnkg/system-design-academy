---
// "Practise first": a guided run through the task before reading the solution, in the order a design interview goes:
// clarify the requirements, estimate a number, sketch a design, then compare it with the study's design moves.
// The estimate compares your guess with the page's own Estimator. Everything stays in this browser (localStorage).
interface Props { slug: string; moves: string[]; functional: string[]; nonFunctional: string[] }
const { slug, moves, functional, nonFunctional } = Astro.props;
---
<details class="card practice" data-practice data-slug={slug}>
  <summary>Practise first: design it yourself, step by step</summary>
  <p>Do these four steps before you read the rest of the page. About fifteen minutes is plenty, and a wrong guess teaches more than a right one.</p>

  <section class="stage" aria-labelledby={`s1-${slug}`}>
    <h3 id={`s1-${slug}`}>1. Clarify the task</h3>
    <label class="plabel" for={`assume-${slug}`}>What would you ask, and what would you assume? Think of users, scale, and what must never go wrong.</label>
    <textarea id={`assume-${slug}`} class="pg-in notes" rows="4" data-assume placeholder="Who uses it, how many, how fast, what can be eventually consistent…"></textarea>
    <button type="button" class="btn" data-reveal-req aria-expanded="false" aria-controls={`req-${slug}`}>Compare with the study's requirements</button>
    <div class="req" id={`req-${slug}`} hidden>
      <div><h4>It must</h4><ul class="clean">{functional.map((x) => <li>{x}</li>)}</ul></div>
      <div><h4>How well</h4><ul class="clean">{nonFunctional.map((x) => <li>{x}</li>)}</ul></div>
    </div>
  </section>

  <section class="stage" aria-labelledby={`s2-${slug}`} data-stage-estimate>
    <h3 id={`s2-${slug}`}>2. Estimate a number</h3>
    <p class="hint">Pick one number the design depends on and guess it before you look. Type a plain number, or use k, M or B (for example 50k or 2M). Use the unit the row is measured in.</p>
    <div class="row">
      <label for={`row-${slug}`}>Number to guess</label>
      <select id={`row-${slug}`} class="pg-in" data-row></select>
    </div>
    <div class="row">
      <label for={`guess-${slug}`}>Your guess</label>
      <input id={`guess-${slug}`} class="pg-in guess" type="text" inputmode="decimal" autocomplete="off" data-guess placeholder="e.g. 50k" />
      <button type="button" class="btn" data-reveal-est>Compare with the estimator</button>
    </div>
    <p class="result" data-est-result aria-live="polite"></p>
  </section>

  <section class="stage" aria-labelledby={`s3-${slug}`}>
    <h3 id={`s3-${slug}`}>3. Sketch your design</h3>
    <label class="plabel" for={`notes-${slug}`}>Your design notes</label>
    <textarea id={`notes-${slug}`} class="pg-in notes" rows="7" data-notes placeholder="Components, data, numbers, what you would build first, what breaks first…"></textarea>
    <p class="pg-note" data-saved aria-live="polite">Notes stay in this browser only.</p>
  </section>

  <section class="stage" aria-labelledby={`s4-${slug}`}>
    <h3 id={`s4-${slug}`}>4. Compare with the design moves</h3>
    <fieldset class="checks">
      <legend>Tick the moves your answer already had</legend>
      {moves.map((m, i) => (
        <label class="check"><input type="checkbox" data-check={i} /> <span>{m}</span></label>
      ))}
    </fieldset>
    <p class="result" data-result aria-live="polite"></p>
  </section>

  <button type="button" class="btn" data-clear>Clear my notes, guess and ticks</button>
</details>
<script>
  document.querySelectorAll<HTMLElement>('[data-practice]').forEach((root) => {
    const slug = root.dataset.slug!;
    const notesKey = `sda-notes/${slug}`, checksKey = `sda-checks/${slug}`, assumeKey = `sda-assume/${slug}`;
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const notes = q<HTMLTextAreaElement>('[data-notes]'), assume = q<HTMLTextAreaElement>('[data-assume]');
    const saved = q('[data-saved]'), result = q('[data-result]');
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-check]')];
    const read = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
    const write = (k: string, v: string | null) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); return true; } catch { return false; } };

    notes.value = read(notesKey) ?? '';
    assume.value = read(assumeKey) ?? '';
    try { const on: number[] = JSON.parse(read(checksKey) ?? '[]'); boxes.forEach((b, i) => (b.checked = on.includes(i))); } catch { /* ignore a damaged value */ }

    function summary() {
      const hit = boxes.filter((b) => b.checked).length;
      const missed = boxes.filter((b) => !b.checked).map((b) => b.nextElementSibling!.textContent);
      result.textContent = hit === 0 ? '' : hit === boxes.length
        ? `Your answer had all ${boxes.length} design moves. Open the steps to compare the trade-offs.`
        : `Your answer had ${hit} of ${boxes.length} design moves. Read these steps first: ${missed.join('; ')}.`;
    }
    const autosave = (el: HTMLTextAreaElement, key: string) => {
      let timer = 0;
      el.addEventListener('input', () => {
        clearTimeout(timer);
        timer = window.setTimeout(() => { saved.textContent = write(key, el.value) ? 'Saved in this browser.' : 'Could not save here (storage is blocked); keep a copy of your notes.'; }, 400);
      });
    };
    autosave(notes, notesKey); autosave(assume, assumeKey);
    root.addEventListener('change', (e) => {
      if (!(e.target as Element).matches('[data-check]')) return;
      write(checksKey, JSON.stringify(boxes.flatMap((b, i) => (b.checked ? [i] : []))));
      summary();
    });

    // Step 1: show the study's requirements next to what the learner wrote.
    const reqBtn = q<HTMLButtonElement>('[data-reveal-req]'), req = q('.req');
    reqBtn.addEventListener('click', () => {
      req.hidden = !req.hidden;
      reqBtn.setAttribute('aria-expanded', String(!req.hidden));
      reqBtn.textContent = req.hidden ? "Compare with the study's requirements" : "Hide the study's requirements";
    });

    // Step 2: guess one output row of the page's estimator, then compare. The estimator draws after this script runs, so read it on demand.
    const stage = q('[data-stage-estimate]'), rowSel = q<HTMLSelectElement>('[data-row]');
    const guess = q<HTMLInputElement>('[data-guess]'), estResult = q('[data-est-result]');
    const rowsOf = () => {
      const dl = document.querySelector('dl[data-out]');
      return dl ? [...dl.querySelectorAll('dt')].map((dt) => ({ label: dt.textContent ?? '', value: dt.nextElementSibling?.textContent ?? '' })) : [];
    };
    function fillRows() {
      if (rowSel.options.length) return;
      const rows = rowsOf();
      if (!rows.length) { stage.hidden = true; return; }
      rows.forEach((r, i) => rowSel.add(new Option(r.label, String(i))));
    }
    root.addEventListener('toggle', fillRows);
    const factors: Record<string, number> = { k: 1e3, thousand: 1e3, m: 1e6, million: 1e6, b: 1e9, billion: 1e9, t: 1e12, trillion: 1e12 };
    const parse = (text: string) => {
      const m = text.trim().toLowerCase().replace(/,/g, '').match(/^(\d+(?:\.\d+)?|\.\d+)\s*([a-z]+)?/);
      if (!m) return NaN;
      const f = m[2] ? factors[m[2]] : 1;
      return f ? Number(m[1]) * f : Number(m[1]);
    };
    const reveal = () => {
      const g = parse(guess.value);
      if (!(g > 0)) { estResult.textContent = 'Type a number first, for example 50k or 2M. A rough guess is the point.'; return; }
      const row = rowsOf()[Number(rowSel.value)];
      if (!row) return;
      const actual = parse(row.value);
      const note = document.querySelector('dl[data-out]')?.parentElement?.querySelector('.pg-note')?.textContent ?? '';
      const shown = `The estimator says: ${row.value} (with its sliders where they are now).`;
      if (!(actual > 0)) { estResult.textContent = `${shown} Compare it with your guess yourself.`; return; }
      const off = Math.max(g / actual, actual / g);
      const verdict = off <= 1.25 ? 'Very close.' : off <= 3 ? `Right ballpark, off by about ${off.toFixed(1)} times.` : off <= 10 ? `Off by about ${Math.round(off)} times. Check which assumption in your head differs.` : `Off by about ${Math.round(off)} times, so an assumption differs a lot. Compare it with the assumptions below.`;
      estResult.textContent = `${shown} ${verdict}${off > 1.25 && note ? ` ${note}` : ''}`;
    };
    q('[data-reveal-est]').addEventListener('click', reveal);
    guess.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); reveal(); } });
    rowSel.addEventListener('change', () => (estResult.textContent = ''));

    q('[data-clear]').addEventListener('click', () => {
      notes.value = ''; assume.value = ''; guess.value = ''; estResult.textContent = ''; boxes.forEach((b) => (b.checked = false));
      write(notesKey, null); write(checksKey, null); write(assumeKey, null); summary();
      saved.textContent = 'Cleared.';
    });
    summary();
  });
</script>
<style>
  .practice { margin: 1.2rem 0 0; }
  .practice summary { cursor: pointer; font-weight: 600; }
  .practice summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 4px; }
  .stage { border-top: 1px solid var(--border); margin-top: 1rem; padding-top: .4rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; justify-items: start; }
  .stage h3 { margin: .4rem 0 0; font-size: 1.05rem; }
  .hint { margin: 0; color: var(--muted); }
  .plabel { display: block; font-weight: 600; margin: .2rem 0 .1rem; }
  .notes { width: 100%; font-family: inherit; resize: vertical; }
  .row { display: flex; flex-wrap: wrap; gap: 8px 10px; align-items: center; max-width: 100%; }
  .row select { max-width: 100%; }
  .guess { width: 9rem; }
  .req { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 10px 20px; width: 100%; }
  .req h4 { margin: 0 0 .2rem; }
  .req[hidden] { display: none; }
  .checks { border: 1px solid var(--border); border-radius: 10px; margin: 0; padding: 8px 14px 10px; display: grid; gap: 6px; width: 100%; box-sizing: border-box; min-width: 0; }
  .checks legend { padding: 0 6px; font-weight: 600; }
  .check { display: flex; gap: 8px; align-items: flex-start; }
  .check input { margin-top: .35em; }
  .check span { min-width: 0; overflow-wrap: anywhere; }
  .result { margin: 0; overflow-wrap: anywhere; }
  .stage[hidden] { display: none; }
  [data-clear] { margin-top: 1rem; }
</style>
