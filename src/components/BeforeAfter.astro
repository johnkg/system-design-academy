---
import { getBefore, getCode } from '../lib';
import CodeBlock from './CodeBlock.astro';
interface Props { slug: string; name: string; pain: string[]; benefits: string[] }
const { slug, name, pain, benefits } = Astro.props;
---
<div class="ba">
  <section class="card bad">
    <h3>Without {name}</h3>
    <ul class="clean">{pain.map((p) => <li>{p}</li>)}</ul>
    <CodeBlock samples={getBefore(slug)} filename="before" />
  </section>
  <section class="card good">
    <h3>With {name}</h3>
    <ul class="clean">{benefits.map((p) => <li>{p}</li>)}</ul>
    <CodeBlock samples={getCode(slug)} filename="after" />
  </section>
</div>
<style>
  .ba { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); }
  .ba > section { min-width: 0; }
  h3 { margin: 0 0 .5rem; }
  .bad { border-top: 4px solid var(--bad); }
  .good { border-top: 4px solid var(--good); }
  ul { margin-bottom: 12px; color: var(--muted); font-size: .95rem; }
</style>
