---
import { Code } from 'astro:components';
import type { Sample } from '../lib';
interface Props { samples: Sample[]; filename?: string }
const { samples, filename = 'example' } = Astro.props;
---
{samples.map((s) => (
  <div class="lang-panel" data-lang={s.lang.id}>
    <div class="code-head"><span>{filename}.{s.lang.ext}</span><button class="btn copy" type="button">Copy</button></div>
    <Code code={s.code} lang={s.lang.shiki} themes={{ light: 'github-light-default', dark: 'github-dark-default' }} defaultColor={false}
      transformers={[{ pre(node) { node.properties.role = 'region'; node.properties['aria-label'] = `Code: ${filename}.${s.lang.ext}`; } }]} />
  </div>
))}
<script>
  const COPIED_MS = 1200; // how long the button says "Copied"
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('button.copy');
    if (!btn) return;
    const code = btn.closest('.lang-panel')?.querySelector('pre')?.textContent ?? '';
    navigator.clipboard?.writeText(code).then(() => {
      btn.textContent = 'Copied';
      setTimeout(() => (btn.textContent = 'Copy'), COPIED_MS);
    });
  });
</script>
<style is:global>
  .code-head { display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; background: var(--surface); border: 1px solid var(--border); border-bottom: 0; border-radius: var(--radius) var(--radius) 0 0; font: .8rem var(--font-mono); color: var(--muted); }
  .code-head .btn { min-height: 30px; padding: 2px 10px; font-size: .78rem; }
  .code-block-wrap pre.astro-code { border: 1px solid var(--border); }
  .lang-panel pre.astro-code { border: 1px solid var(--border); }
</style>
