---
// A "mark as done" button. State is kept by the progress script in Layout.astro.
interface Props { collection: 'concepts' | 'patterns' | 'studies'; slug: string }
const { collection, slug } = Astro.props;
---
<button type="button" class="btn done-toggle" data-done-toggle data-key={`${collection}/${slug}`} aria-pressed="false">Mark as done</button>
