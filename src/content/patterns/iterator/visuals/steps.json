{
  "actors": [
    { "id": "client", "label": "Client", "role": "client", "x": 12, "y": 50 },
    { "id": "playlist", "label": "Playlist", "role": "aggregate", "x": 46, "y": 16 },
    { "id": "iter", "label": "ForwardIterator", "role": "concrete-iterator", "x": 80, "y": 62 }
  ],
  "frames": [
    { "narration": "The client wants to walk the playlist. It does not look inside; it asks the playlist for an iterator.", "messages": [{ "from": "client", "to": "playlist", "label": "createIterator()" }] },
    { "narration": "The playlist creates an iterator that remembers a position (starting at 0) and returns it.", "messages": [{ "from": "playlist", "to": "iter", "label": "new ForwardIterator(songs)" }], "states": { "iter": "position 0 of 3" } },
    { "narration": "Loop step: is there anything left?", "messages": [{ "from": "client", "to": "iter", "label": "hasNext()" }], "states": { "client": "true" } },
    { "narration": "Fetch the next song. The iterator returns it and moves its own pointer.", "messages": [{ "from": "client", "to": "iter", "label": "next()" }], "states": { "iter": "returned 'Intro' · position 1", "client": "got 'Intro'" } },
    { "narration": "Repeat. The client never sees an index and never knows the songs are in an array.", "messages": [{ "from": "client", "to": "iter", "label": "next()" }], "states": { "iter": "returned 'Verse' · position 2", "client": "got 'Verse'" } },
    { "narration": "And the last song.", "messages": [{ "from": "client", "to": "iter", "label": "next()" }], "states": { "iter": "returned 'Chorus' · position 3", "client": "got 'Chorus'" } },
    { "narration": "Now hasNext() is false, so the loop ends. A ReverseIterator would use the same two methods in the opposite order.", "messages": [{ "from": "client", "to": "iter", "label": "hasNext()" }], "states": { "client": "false: done" } }
  ]
}
