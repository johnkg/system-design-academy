  "linkLabel": "paired with (the bridge)",
  "frames": [
    { "narration": "A remote is created and paired with a device. That reference is the bridge between the two hierarchies.", "links": { "add": [["remote", "tv"]] }, "highlight": ["remote", "tv"] },
    { "narration": "The client presses power. The remote does not know how a TV turns on; it asks the device.", "messages": [{ "from": "client", "to": "remote", "label": "togglePower()" }, { "from": "remote", "to": "tv", "label": "enable()" }], "states": { "tv": "on · volume 30" } },
    { "narration": "Volume up is the same story: the remote's logic, the device's implementation.", "messages": [{ "from": "client", "to": "remote", "label": "volumeUp()" }, { "from": "remote", "to": "tv", "label": "setVolume(40)" }], "states": { "tv": "on · volume 40" } },
    { "narration": "The advanced remote adds a mute button. It still just talks to the Device interface.", "messages": [{ "from": "client", "to": "remote", "label": "mute()" }, { "from": "remote", "to": "tv", "label": "setVolume(0)" }], "states": { "tv": "on · volume 0" } },
    { "narration": "Re-pair the same remote with a Radio. Nothing in the remote changes.", "links": { "remove": [["remote", "tv"]], "add": [["remote", "radio"]] }, "highlight": ["remote", "radio"] },
    { "narration": "The same call now drives a completely different device. Any remote works with any device.", "messages": [{ "from": "client", "to": "remote", "label": "togglePower()" }, { "from": "remote", "to": "radio", "label": "enable()" }], "states": { "radio": "on · volume 10" } }
  ]
