{
  "actors": [
    {
      "id": "channel",
      "label": "NewsChannel",
      "role": "subject",
      "x": 50,
      "y": 18
    },
    {
      "id": "email",
      "label": "EmailSubscriber",
      "role": "concrete",
      "x": 20,
      "y": 75
    },
    {
      "id": "sms",
      "label": "SmsSubscriber",
      "role": "concrete",
      "x": 80,
      "y": 75
    }
  ],
  "frames": [
    {
      "narration": "The channel starts with nobody listening.",
      "states": {
        "channel": "subscribers: []"
      },
      "highlight": [
        "channel"
      ]
    },
    {
      "narration": "EmailSubscriber registers itself with the channel.",
      "messages": [
        {
          "from": "email",
          "to": "channel",
          "label": "subscribe(email)"
        }
      ],
      "states": {
        "channel": "subscribers: [email]"
      },
      "links": {
        "add": [
          [
            "email",
            "channel"
          ]
        ]
      }
    },
    {
      "narration": "SmsSubscriber registers too. The channel stores both as plain Observers.",
      "messages": [
        {
          "from": "sms",
          "to": "channel",
          "label": "subscribe(sms)"
        }
      ],
      "states": {
        "channel": "subscribers: [email, sms]"
      },
      "links": {
        "add": [
          [
            "sms",
            "channel"
          ]
        ]
      }
    },
    {
      "narration": "A headline is published. The channel loops over its list.",
      "states": {
        "channel": "publish('Hello')"
      },
      "highlight": [
        "channel"
      ]
    },
    {
      "narration": "First observer is told. The channel only calls update(); it does not know this is email.",
      "messages": [
        {
          "from": "channel",
          "to": "email",
          "label": "update('Hello')"
        }
      ],
      "states": {
        "email": "sent email: Hello"
      }
    },
    {
      "narration": "Second observer is told, same call, different reaction.",
      "messages": [
        {
          "from": "channel",
          "to": "sms",
          "label": "update('Hello')"
        }
      ],
      "states": {
        "sms": "sent SMS: Hello"
      }
    },
    {
      "narration": "EmailSubscriber loses interest and unsubscribes at runtime.",
      "messages": [
        {
          "from": "email",
          "to": "channel",
          "label": "unsubscribe(email)"
        }
      ],
      "states": {
        "channel": "subscribers: [sms]"
      },
      "links": {
        "remove": [
          [
            "email",
            "channel"
          ]
        ]
      }
    },
    {
      "narration": "Next headline reaches only the remaining subscriber.",
      "messages": [
        {
          "from": "channel",
          "to": "sms",
          "label": "update('Again')"
        }
      ],
      "states": {
        "sms": "sent SMS: Again"
      }
    }
  ],
  "linkLabel": "subscribed"
}
