{
  "width": 640,
  "height": 280,
  "classes": [
    { "id": "app", "name": "PaymentsService", "role": "app", "x": 10, "y": 90, "w": 180,
      "members": ["+charge(order)", "// no network code"] },
    { "id": "sidecar", "name": "Sidecar", "role": "sidecar", "x": 250, "y": 70, "w": 180,
      "members": ["+send(target, payload)", "-retry policy", "-logging", "-TLS"] },
    { "id": "peer", "name": "Inventory service", "role": "peer", "x": 480, "y": 90, "w": 150,
      "members": ["+reserve(item)"] }
  ],
  "edges": [
    { "from": "app", "to": "sidecar", "kind": "association", "label": "localhost" },
    { "from": "sidecar", "to": "peer", "kind": "association", "label": "network" }
  ]
