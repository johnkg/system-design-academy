{
  "actors": [
    {
      "id": "client",
      "label": "Form (client)",
      "role": "factory",
      "x": 14,
      "y": 50
    },
    {
      "id": "light",
      "label": "LightFactory",
      "role": "concrete-factory",
      "x": 50,
      "y": 14
    },
    {
      "id": "dark",
      "label": "DarkFactory",
      "role": "concrete-factory",
      "x": 50,
      "y": 86
    },
    {
      "id": "lbtn",
      "label": "Light widgets",
      "role": "concrete-product",
      "x": 86,
      "y": 20
    },
    {
      "id": "dbtn",
      "label": "Dark widgets",
      "role": "concrete-product",
      "x": 86,
      "y": 80
    }
  ],
  "linkLabel": "factory in use",
  "frames": [
    {
      "narration": "The form is handed one factory at startup. Here it is the LightFactory.",
      "links": {
        "add": [
          [
            "client",
            "light"
          ]
        ]
      },
      "highlight": [
        "client",
        "light"
      ]
    },
    {
      "narration": "It asks the factory for a button. It does not say which class.",
      "messages": [
        {
          "from": "client",
          "to": "light",
          "label": "createButton()"
        }
      ]
    },
    {
      "narration": "The LightFactory returns a LightButton.",
      "messages": [
        {
          "from": "light",
          "to": "lbtn",
          "label": "new LightButton()"
        }
      ],
      "states": {
        "lbtn": "Button created"
      }
    },
    {
      "narration": "Next the checkbox. The same factory builds it, so it is guaranteed to match the button.",
      "messages": [
        {
          "from": "client",
          "to": "light",
          "label": "createCheckbox()"
        }
      ]
    },
    {
      "narration": "A LightCheckbox joins the family. Both widgets are Light, by construction.",
      "messages": [
        {
          "from": "light",
          "to": "lbtn",
          "label": "new LightCheckbox()"
        }
      ],
      "states": {
        "lbtn": "Button + Checkbox"
      }
    },
    {
      "narration": "Switch themes: hand the form a DarkFactory instead. The form's code does not change.",
      "links": {
        "remove": [
          [
            "client",
            "light"
          ]
        ],
        "add": [
          [
            "client",
            "dark"
          ]
        ]
      },
      "highlight": [
        "client",
        "dark"
      ]
    },
    {
      "narration": "The same two calls now go to the DarkFactory.",
      "messages": [
        {
          "from": "client",
          "to": "dark",
          "label": "createButton() + createCheckbox()"
        }
      ]
    },
    {
      "narration": "A whole Dark family appears. Mixing a Dark button with a Light checkbox is not possible here.",
      "messages": [
        {
          "from": "dark",
          "to": "dbtn",
          "label": "new DarkButton(), new DarkCheckbox()"
        }
      ],
      "states": {
        "dbtn": "Button + Checkbox"
      }
    }
  ]
}
