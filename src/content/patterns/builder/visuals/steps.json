  "frames": [
    { "narration": "A fresh builder starts with sensible defaults: medium, thin, no toppings.", "states": { "builder": "medium · thin · []" }, "highlight": ["builder"] },
    { "narration": "The client names one part at a time. Each call returns the builder, so calls chain.", "messages": [{ "from": "director", "to": "builder", "label": "size('large')" }], "states": { "builder": "large · thin · []" } },
    { "narration": "Another part. Only what differs from the default needs mentioning.", "messages": [{ "from": "director", "to": "builder", "label": "crust('thick')" }], "states": { "builder": "large · thick · []" } },
    { "narration": "Toppings accumulate.", "messages": [{ "from": "director", "to": "builder", "label": "addTopping('ham')" }], "states": { "builder": "large · thick · [ham]" } },
    { "narration": "A second topping, then a rule: build() will reject more than four.", "messages": [{ "from": "director", "to": "builder", "label": "addTopping('olives')" }], "states": { "builder": "large · thick · [ham, olives]" } },
    { "narration": "build() validates the choices. Only now does the Pizza exist.", "messages": [{ "from": "director", "to": "builder", "label": "build()" }], "highlight": ["builder"] },
    { "narration": "The builder creates the finished, immutable product from everything it collected.", "messages": [{ "from": "builder", "to": "pizza", "label": "new Pizza(parts)" }], "states": { "pizza": "large thick pizza: ham, olives" } }
  ]
