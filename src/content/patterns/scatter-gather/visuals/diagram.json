{
  "width": 640,
  "height": 320,
  "classes": [
    { "id": "caller", "name": "ComparisonPage", "role": "caller", "x": 10, "y": 120, "w": 140,
      "members": ["+bestPrice()"] },
    { "id": "scatterer", "name": "Scatterer", "role": "scatterer", "x": 190, "y": 30, "w": 160,
      "members": ["+sendToAll(request)"] },
    { "id": "gatherer", "name": "Gatherer", "role": "gatherer", "x": 190, "y": 210, "w": 170,
      "members": ["-deadline", "+collect(): answers", "+merge()"] },
    { "id": "worker", "name": "Vendor A..E", "role": "worker", "x": 440, "y": 120, "w": 180,
      "members": ["+ask(): price", "may be slow", "may fail"] }
  ],
  "edges": [
    { "from": "caller", "to": "scatterer", "kind": "association", "label": "asks" },
    { "from": "scatterer", "to": "worker", "kind": "association", "label": "all at once" },
    { "from": "worker", "to": "gatherer", "kind": "association", "label": "answers" },
    { "from": "gatherer", "to": "caller", "kind": "association", "label": "best price" }
  ]
}
