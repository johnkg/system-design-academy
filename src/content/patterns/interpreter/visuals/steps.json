    },
    {
      "narration": "Evaluate the whole thing by asking the root to interpret itself. Add needs both sides, so it asks its first child.",
      "messages": [
        {
          "from": "add",
          "to": "mul",
          "label": "interpret(ctx)"
        }
      ],
      "states": {
        "add": "needs left + right"
      }
    },
    {
      "narration": "Multiply also needs both of its operands. First the variable.",
      "messages": [
        {
          "from": "mul",
          "to": "x",
          "label": "interpret(ctx)"
        }
      ],
      "states": {
        "mul": "needs left * right"
      }
    },
    {
      "narration": "A terminal answers directly, here by looking x up in the context.",
      "messages": [
        {
          "from": "x",
          "to": "mul",
          "label": "4"
        }
      ],
      "states": {
        "x": "ctx[x] = 4"
