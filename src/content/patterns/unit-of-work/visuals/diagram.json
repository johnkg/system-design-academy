{
  "width": 640,
  "height": 290,
  "classes": [
    { "id": "client", "name": "Checkout", "role": "client", "x": 10, "y": 90, "w": 160,
      "members": ["+run(order)"] },
    { "id": "unit", "name": "UnitOfWork", "role": "unit", "x": 230, "y": 20, "w": 190,
      "members": ["-changes: Map", "+set(key, value)", "+commit()", "+rollback()"] },
    { "id": "store", "name": "DataStore", "role": "store", "x": 470, "y": 90, "w": 150,
      "members": ["+write(key, value)", "+snapshot()", "+restore(snapshot)"] }
  ],
  "edges": [
    { "from": "client", "to": "unit", "kind": "association", "label": "registers changes" },
    { "from": "unit", "to": "store", "kind": "association", "label": "one transaction" }
  ]
}
