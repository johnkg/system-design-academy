{
  "width": 640,
  "height": 300,
  "classes": [
    { "id": "client", "name": "SignupService", "role": "client", "x": 10, "y": 20, "w": 170,
      "members": ["+register(name, email)"] },
    { "id": "mapper", "name": "UserMapper", "role": "mapper", "x": 240, "y": 20, "w": 190,
      "members": ["-columns", "+find(id): User", "+save(user)"] },
    { "id": "domain", "name": "User", "role": "domain", "x": 10, "y": 200, "w": 190,
      "members": ["+id", "+name", "+email", "+rename(name)"] },
    { "id": "table", "name": "users table", "role": "table", "x": 450, "y": 200, "w": 170,
      "members": ["full_name", "mail"] }
  ],
  "edges": [
    { "from": "client", "to": "mapper", "kind": "association", "label": "asks" },
    { "from": "mapper", "to": "domain", "kind": "association", "label": "builds" },
