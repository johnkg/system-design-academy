  "frames": [
    {
      "narration": "The client wants to watch a movie. It knows one class: the facade.",
      "highlight": [
        "client",
        "facade"
      ]
    },
    {
      "narration": "One simple call. Everything below is the facade's problem now.",
      "messages": [
        {
          "from": "client",
          "to": "facade",
          "label": "watchMovie('Dune')"
        }
      ]
    },
    {
      "narration": "Step 1 of the recipe: dim the lights.",
      "messages": [
        {
          "from": "facade",
          "to": "lights",
          "label": "dim(10)"
        }
      ],
      "states": {
        "lights": "dimmed to 10%"
      }
    },
    {
      "narration": "Step 2: turn on the projector.",
      "messages": [
        {
          "from": "facade",
          "to": "projector",
          "label": "on()"
        }
      ],
      "states": {
        "projector": "on"
      }
    },
    {
      "narration": "Step 3: set a sensible volume.",
      "messages": [
        {
          "from": "facade",
          "to": "amp",
          "label": "setVolume(5)"
        }
      ],
      "states": {
        "amp": "volume 5"
      }
    },
    {
      "narration": "Step 4, last because the picture and sound must be ready first: press play.",
      "messages": [
        {
          "from": "facade",
          "to": "player",
          "label": "play('Dune')"
        }
      ],
      "states": {
        "player": "playing Dune"
      }
    },
    {
      "narration": "The order is right every time because it lives in exactly one place. The client made one call.",
      "states": {
        "client": "movie started"
      },
      "highlight": [
        "client"
      ]
    }
  ]
}
