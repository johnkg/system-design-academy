  ],
  "frames": [
    { "narration": "Reader 1 asks for the lock in shared mode. Nobody is writing, so it gets in.", "messages": [{ "from": "r1", "to": "lock", "label": "acquireRead()" }], "states": { "lock": "readers: 1" } },
    { "narration": "Reader 2 asks too and gets in at the same time. Readers do not block each other.", "messages": [{ "from": "r2", "to": "lock", "label": "acquireRead()" }], "states": { "lock": "readers: 2" } },
    { "narration": "The writer wants exclusive access, but two readers are inside, so it waits.", "messages": [{ "from": "writer", "to": "lock", "label": "acquireWrite()" }], "states": { "writer": "waiting" } },
    { "narration": "Both readers finish and release the lock.", "messages": [{ "from": "r1", "to": "lock", "label": "releaseRead()" }, { "from": "r2", "to": "lock", "label": "releaseRead()" }], "states": { "lock": "readers: 0" } },
    { "narration": "The writer enters alone and changes the data. No reader can see it half written.", "messages": [{ "from": "writer", "to": "data", "label": "version = 2" }], "states": { "lock": "writer active", "data": "version 2" } },
    { "narration": "A new reader has to wait while the writer is inside. When the writer leaves, it enters and sees version 2.", "states": { "r1": "new reader waits, then reads v2" }, "highlight": ["lock"] }
  ],
  "linkLabel": "uses"
}
