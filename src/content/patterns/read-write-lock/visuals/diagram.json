{
  "width": 640,
  "height": 310,
  "classes": [
    { "id": "reader", "name": "Reader (many)", "role": "reader", "x": 10, "y": 20, "w": 150,
      "members": ["+lookup(key)"] },
    { "id": "writer", "name": "Writer", "role": "writer", "x": 10, "y": 200, "w": 150,
      "members": ["+update(key, value)"] },
    { "id": "lock", "name": "ReadWriteLock", "role": "lock", "x": 230, "y": 100, "w": 200,
      "members": ["-readers: int", "-writerActive: bool", "+acquireRead() / releaseRead()", "+acquireWrite() / releaseWrite()"] },
    { "id": "data", "name": "Config (shared data)", "role": "data", "x": 480, "y": 110, "w": 150,
      "members": ["+version", "+values"] }
  ],
  "edges": [
    { "from": "reader", "to": "lock", "kind": "association", "label": "shared" },
    { "from": "writer", "to": "lock", "kind": "association", "label": "exclusive" },
    { "from": "lock", "to": "data", "kind": "association", "label": "guards" }
  ]
