  ],
  "linkLabel": "contains",
  "frames": [
    {
      "narration": "A small tree: project holds readme.md and a src folder, and src holds app.js.",
      "links": {
        "add": [
          [
            "root",
            "src"
          ],
          [
            "root",
            "readme"
          ],
          [
            "src",
            "app"
          ]
        ]
      },
      "highlight": [
        "root"
      ]
    },
    {
      "narration": "The client wants the total size. It calls getSize() on the root and does not care that it is a folder.",
      "messages": [
        {
          "from": "client",
          "to": "root",
          "label": "getSize()"
        }
      ]
    },
    {
      "narration": "The folder adds up its children, asking each one. First child: the src folder.",
      "messages": [
        {
          "from": "root",
          "to": "src",
          "label": "getSize()"
        }
      ],
      "states": {
        "root": "summing children..."
      }
    },
    {
      "narration": "src does exactly the same thing: it asks its own children.",
      "messages": [
        {
          "from": "src",
          "to": "app",
          "label": "getSize()"
        }
      ],
      "states": {
        "src": "summing children..."
      }
    },
    {
      "narration": "A leaf answers with its own size.",
      "messages": [
        {
          "from": "app",
          "to": "src",
          "label": "40"
        }
      ],
      "states": {
        "app": "size = 40",
        "src": "40"
      }
    },
    {
      "narration": "src passes its total up.",
      "messages": [
        {
          "from": "src",
          "to": "root",
          "label": "40"
        }
      ]
    },
    {
      "narration": "Back at the root, the next child is a file. Same call, same interface.",
      "messages": [
        {
          "from": "root",
          "to": "readme",
          "label": "getSize()"
        }
      ],
      "states": {
        "readme": "size = 10"
      }
    },
    {
      "narration": "The root now has 40 + 10 and answers the client. One call, any depth.",
      "messages": [
        {
          "from": "root",
          "to": "client",
          "label": "50"
        }
      ],
      "states": {
        "root": "40 + 10 = 50",
        "client": "total: 50"
      }
    }
  ]
}
