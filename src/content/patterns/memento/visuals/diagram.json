{
  "width": 640,
  "height": 260,
  "classes": [
    { "id": "manager", "name": "CheckpointManager", "role": "caretaker", "x": 10, "y": 60, "w": 220,
      "members": ["-stack: Snapshot[]", "+save(player)", "+loadLast(player)"] },
    { "id": "player", "name": "Player", "role": "originator", "x": 300, "y": 10, "w": 190,
      "members": ["-hp, -level", "+save(): Snapshot", "+restore(s)"] },
    { "id": "snap", "name": "Snapshot", "role": "memento", "x": 400, "y": 170, "w": 220,
      "members": ["-state  (opaque, immutable)"] }
  ],
  "edges": [
    { "from": "manager", "to": "player", "kind": "association", "label": "asks" },
    { "from": "player", "to": "snap", "kind": "association", "label": "creates" },
    { "from": "manager", "to": "snap", "kind": "association", "label": "stores" }
  ]
}
