{
  "actors": [
    { "id": "client", "label": "Client", "role": "component", "x": 13, "y": 18 },
    { "id": "mocha", "label": "Mocha", "role": "concrete-decorator", "x": 38, "y": 78 },
    { "id": "milk", "label": "Milk", "role": "concrete-decorator", "x": 62, "y": 18 },
    { "id": "espresso", "label": "Espresso", "role": "concrete-component", "x": 87, "y": 78 }
  ],
  "linkLabel": "wraps",
  "frames": [
    { "narration": "Start with a plain Espresso. On its own it costs 2.00.", "states": { "espresso": "base cost 2.00" }, "highlight": ["espresso"] },
    { "narration": "Wrap it in Milk. Milk has the same interface as Espresso and keeps a reference to the drink inside.", "states": { "milk": "wraps Espresso" }, "links": { "add": [["milk", "espresso"]] }, "highlight": ["milk"] },
    { "narration": "Wrap that in Mocha. The client will hold only the outermost layer.", "states": { "mocha": "wraps Milk" }, "links": { "add": [["mocha", "milk"]] }, "highlight": ["mocha"] },
    { "narration": "The client asks the outermost drink for its cost. It has no idea about the layers.", "messages": [{ "from": "client", "to": "mocha", "label": "cost()" }], "states": { "mocha": "asks inner drink first..." } },
    { "narration": "Mocha delegates inward. Its job is to add 0.70 after it hears back.", "messages": [{ "from": "mocha", "to": "milk", "label": "cost()" }], "states": { "milk": "asks inner drink first..." } },
    { "narration": "Milk delegates again, reaching the plain Espresso.", "messages": [{ "from": "milk", "to": "espresso", "label": "cost()" }], "states": { "espresso": "returns 2.00" } },
    { "narration": "The answer travels back out. Milk adds its 0.50.", "messages": [{ "from": "espresso", "to": "milk", "label": "2.00" }], "states": { "milk": "2.00 + 0.50 = 2.50" } },
    { "narration": "Mocha adds its 0.70 on top of that.", "messages": [{ "from": "milk", "to": "mocha", "label": "2.50" }], "states": { "mocha": "2.50 + 0.70 = 3.20" } },
    { "narration": "The client gets the total. Adding Whip later is one more wrapper, no changes to Milk, Mocha or Espresso.", "messages": [{ "from": "mocha", "to": "client", "label": "3.20" }], "states": { "client": "total: 3.20" } }
  ]
}
