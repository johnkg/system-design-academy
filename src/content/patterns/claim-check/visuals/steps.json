  ],
  "frames": [
    { "narration": "A 20 MB video arrives. It is far too big for a 256 KB queue message.", "states": { "producer": "holiday.mp4, 20 MB" }, "highlight": ["producer"] },
    { "narration": "The producer puts the video in blob storage and receives a ticket: blob-1.", "messages": [{ "from": "producer", "to": "store", "label": "put(video)" }], "states": { "store": "blob-1 (20 MB)" } },
    { "narration": "It sends a tiny message that holds only the ticket.", "messages": [{ "from": "producer", "to": "message", "label": "{ ticket: blob-1 }" }], "states": { "message": "1 small message" } },
    { "narration": "The processor receives the ticket. The queue never carried the video.", "messages": [{ "from": "message", "to": "consumer", "label": "{ ticket: blob-1 }" }] },
    { "narration": "It claims the video with the ticket and processes it.", "messages": [{ "from": "consumer", "to": "store", "label": "get(blob-1)" }], "states": { "consumer": "processing holiday.mp4" } },
    { "narration": "After success it deletes the blob. If it crashed before this step, the blob would be orphaned, so an expiry rule is needed too.", "messages": [{ "from": "consumer", "to": "store", "label": "delete(blob-1)" }], "states": { "store": "empty" } }
  ],
  "linkLabel": "sends"
