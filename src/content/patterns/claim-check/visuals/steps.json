  "actors": [
    { "id": "producer", "label": "UploadService", "role": "producer", "x": 10, "y": 25 },
    { "id": "message", "label": "Queue (tickets)", "role": "message", "x": 50, "y": 25 },
    { "id": "consumer", "label": "Processor", "role": "consumer", "x": 90, "y": 25 },
