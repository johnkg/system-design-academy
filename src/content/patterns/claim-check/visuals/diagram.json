{
  "width": 640,
  "height": 310,
  "classes": [
    { "id": "producer", "name": "UploadService", "role": "producer", "x": 10, "y": 20, "w": 170,
      "members": ["+publish(video)"] },
    { "id": "store", "name": "BlobStore", "role": "store", "x": 230, "y": 200, "w": 180,
      "members": ["+put(payload): id", "+get(id)", "+delete(id)"] },
    { "id": "message", "name": "Message", "role": "message", "x": 230, "y": 20, "w": 180,
      "members": ["+ticket: id", "// a few bytes"] },
    { "id": "consumer", "name": "Processor", "role": "consumer", "x": 470, "y": 20, "w": 160,
      "members": ["+handle(message)"] }
  ],
  "edges": [
    { "from": "producer", "to": "store", "kind": "association", "label": "put" },
    { "from": "producer", "to": "message", "kind": "association", "label": "sends ticket" },
    { "from": "message", "to": "consumer", "kind": "association", "label": "delivered to" },
    { "from": "consumer", "to": "store", "kind": "association", "label": "claims with ticket" }
  ]
}
