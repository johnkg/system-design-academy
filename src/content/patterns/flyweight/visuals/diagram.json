{
  "width": 640,
  "height": 280,
  "classes": [
    { "id": "forest", "name": "Forest", "role": "client", "x": 10, "y": 10, "w": 190,
      "members": ["-trees: Tree[]", "+plant(x, y, species)"] },
    { "id": "tree", "name": "Tree", "role": "context", "x": 10, "y": 150, "w": 190,
      "members": ["-x, -y  (extrinsic)", "-type: TreeType", "+draw()"] },
    { "id": "factory", "name": "TreeTypeFactory", "role": "factory", "x": 260, "y": 10, "w": 230,
      "members": ["-cache: Map", "+get(name, color, texture)"] },
    { "id": "type", "name": "TreeType", "role": "flyweight", "x": 330, "y": 160, "w": 230,
      "members": ["-name, -color, -texture", "+draw(x, y)  (immutable)"] }
  ],
  "edges": [
    { "from": "forest", "to": "factory", "kind": "association", "label": "asks" },
    { "from": "forest", "to": "tree", "kind": "association", "label": "plants" },
    { "from": "factory", "to": "type", "kind": "association", "label": "caches" },
