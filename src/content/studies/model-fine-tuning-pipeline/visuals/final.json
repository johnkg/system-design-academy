      "label": "Checkpoint store",
      "role": "data",
      "x": 70,
      "y": 84
    },
    {
      "id": "eval",
      "label": "Evaluation gate",
      "role": "compute",
      "x": 40,
      "y": 84
    },
    {
      "id": "registry",
      "label": "Model registry",
      "role": "data",
      "x": 10,
      "y": 84
    },
    {
      "id": "rollout",
      "label": "Canary rollout",
      "role": "edge",
      "x": 10,
      "y": 50
    }
  ],
  "frames": [
    {
      "narration": "A team registers a dataset. The platform checks it, makes a split from a stable key and freezes the test part. The version is a hash of the content.",
      "messages": [
        {
          "from": "team",
          "to": "datasets",
          "label": "upload data, v7"
        }
      ],
      "states": {
        "datasets": "v7, 2M examples, test split frozen"
      }
    },
    {
      "narration": "The team asks for an adapter run on a 7-billion-parameter base model, with dataset v7. The scheduler waits until the 8 GPUs it needs are all free.",
      "messages": [
        {
          "from": "team",
          "to": "sched",
          "label": "run: base, v7, LoRA, 8 GPUs"
        }
      ],
      "states": {
        "sched": "queued, then placed"
      }
    },
    {
      "narration": "Training starts. Every 30 minutes it writes the adapter, the optimizer state and the data position to object storage, with the manifest last.",
      "messages": [
        {
          "from": "sched",
          "to": "gpus",
          "label": "start"
        },
        {
          "from": "gpus",
          "to": "ckpt",
          "label": "checkpoint every 30 min"
        }
      ],
      "states": {
        "gpus": "step 41000",
        "ckpt": "latest: step 40000"
      }
    },
    {
      "narration": "At hour 30 a node is taken back. The scheduler restarts the job on other GPUs from the newest complete checkpoint. About 15 minutes of work are redone, not 30 hours.",
      "messages": [
        {
          "from": "ckpt",
          "to": "gpus",
          "label": "resume from step 40000"
        }
      ],
      "states": {
        "gpus": "resumed",
        "ckpt": "step 40000 loaded"
      }
    },
    {
      "narration": "The run ends. The evaluation job scores the candidate and the production model on the frozen test set and on named slices. The candidate wins overall and regresses no slice.",
      "messages": [
        {
          "from": "gpus",
          "to": "eval",
          "label": "candidate adapter"
        }
      ],
      "states": {
        "eval": "overall +0.050, no slice regressed"
      }
    },
    {
      "narration": "The gate passes. The adapter goes into the registry with its dataset version, code commit, base model, settings and scores.",
      "messages": [
        {
          "from": "eval",
          "to": "registry",
          "label": "promote"
        }
      ],
      "states": {
        "registry": "adapter a-31: lineage recorded"
      }
    },
    {
      "narration": "The rollout controller sends 5 percent of traffic to the new adapter and watches accepted answers and errors. They hold, so the share grows. If they had not, it would return to the old adapter at once.",
      "messages": [
        {
          "from": "registry",
          "to": "rollout",
          "label": "a-31"
        }
      ],
      "states": {
        "rollout": "5%, then 25%, then 100%"
      }
    }
  ],
  "linkLabel": "runs"
}
