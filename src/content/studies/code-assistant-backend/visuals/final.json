      "role": "compute",
      "x": 90,
      "y": 50
    },
    {
      "id": "fast",
      "label": "Fast model",
      "role": "compute",
      "x": 70,
      "y": 84
    },
    {
      "id": "index",
      "label": "Code index",
      "role": "data",
      "x": 40,
      "y": 84
    },
    {
      "id": "chat",
      "label": "Chat service",
      "role": "edge",
      "x": 10,
      "y": 84
    }
  ],
  "frames": [
    {
      "narration": "The developer types a function call and pauses. The extension waited for the pause, so it sends one request, with a one-second deadline.",
      "messages": [
        {
          "from": "dev",
          "to": "ext",
          "label": "typing, then a pause"
        }
      ],
      "states": {
        "ext": "1 request, not 12"
      }
    },
    {
      "narration": "The context builder gathers what the model needs, within 2500 tokens: the code around the cursor, the definition of the function being called, and a recently edited file.",
      "messages": [
        {
          "from": "ext",
          "to": "ctx",
          "label": "cursor, file, deadline"
        },
        {
          "from": "index",
          "to": "ctx",
          "label": "symbol definition"
        }
      ],
      "states": {
        "ctx": "2500 tokens, stable start"
      }
    },
    {
      "narration": "The secret filter drops files that match the exclusion rules and removes anything that looks like a key. The prompt that leaves it contains no secrets.",
      "messages": [
        {
          "from": "ctx",
          "to": "filter",
          "label": "prompt"
        }
      ],
      "states": {
        "filter": "1 file excluded, 0 secrets left"
      }
    },
    {
      "narration": "The small, fast model reuses the cached work for the unchanged start of the prompt, and writes a completion that streams to the editor in about 300 ms.",
      "messages": [
        {
          "from": "filter",
          "to": "fast",
          "label": "filtered prompt"
        },
        {
          "from": "fast",
          "to": "dev",
          "label": "completion"
        }
      ],
      "states": {
        "fast": "prefix reused"
      }
    },
    {
      "narration": "The developer keeps typing before an answer arrives. The extension cancels the request, and the model stops. Nothing stale is shown.",
      "messages": [
        {
          "from": "ext",
          "to": "fast",
          "label": "cancel"
        }
      ],
      "states": {
        "ext": "request cancelled"
      }
    },
    {
      "narration": "Later the developer asks in the chat panel where orders are validated. The chat service searches the index by meaning and by keyword, and asks the larger model.",
      "messages": [
        {
          "from": "dev",
          "to": "chat",
          "label": "Where are orders validated?"
        },
        {
          "from": "chat",
          "to": "index",
          "label": "search"
        }
      ],
      "states": {
        "chat": "5 chunks retrieved"
      }
    },
    {
      "narration": "The answer streams back within about 2 seconds, with links to the files and lines it used. Whether the developer accepts or rejects suggestions is recorded, to measure whether the assistant helps.",
      "messages": [
        {
          "from": "chat",
          "to": "dev",
          "label": "answer + citations"
        }
      ],
      "states": {
        "dev": "accepts, edits, or dismisses"
      }
    }
  ],
  "linkLabel": "asks"
}
