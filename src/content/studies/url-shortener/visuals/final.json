{
  "actors": [
    {
      "id": "browser",
      "label": "Browser",
      "role": "client",
      "x": 14,
      "y": 50
    },
    {
      "id": "edge",
      "label": "Gateway",
      "role": "edge",
      "x": 50,
      "y": 50
    },
    {
      "id": "app",
      "label": "App server",
      "role": "compute",
      "x": 86,
      "y": 50
    },
    {
      "id": "cache",
      "label": "Cache",
      "role": "data",
      "x": 50,
      "y": 16
    },
    {
      "id": "db",
      "label": "DB shard",
      "role": "data",
      "x": 86,
      "y": 16
    },
    {
      "id": "queue",
      "label": "Click queue",
      "role": "async",
      "x": 50,
      "y": 84
    }
  ],
  "frames": [
    {
      "narration": "A visitor opens sho.rt/aZ3k9Q. The request reaches the gateway, which rate-limits callers and balances load. This visitor is within their limit.",
      "messages": [
        {
          "from": "browser",
          "to": "edge",
          "label": "GET /aZ3k9Q"
        }
      ],
      "states": {
        "edge": "allowed"
      }
    },
    {
      "narration": "The gateway then picks any healthy app server. They are all identical and keep no data of their own.",
      "messages": [
        {
          "from": "edge",
          "to": "app",
          "label": "to a free server"
        }
      ],
      "states": {
        "app": "looks up"
      }
    },
    {
      "narration": "The app asks the cache first. The link is popular, so the cache has it.",
      "messages": [
        {
          "from": "app",
          "to": "cache",
          "label": "get aZ3k9Q"
        },
        {
          "from": "cache",
          "to": "app",
          "label": "hit: long URL"
        }
      ],
      "states": {
        "cache": "hit",
        "db": "idle"
      }
    },
    {
      "narration": "The server fires a click event at the queue and carries on without waiting for it.",
      "messages": [
        {
          "from": "app",
          "to": "queue",
          "label": "click event"
        }
      ],
      "states": {
        "queue": "stored"
      }
    },
    {
      "narration": "The browser gets its redirect and the whole trip was fast. Nothing slow was on the path.",
      "messages": [
        {
          "from": "app",
          "to": "browser",
          "label": "302 to long URL"
        }
      ],
      "states": {
        "browser": "redirected"
      }
    },
    {
      "narration": "Another visitor opens a link nobody has used for weeks. The cache does not have it.",
      "messages": [
        {
          "from": "app",
          "to": "cache",
          "label": "get q7Lm2X"
        },
        {
          "from": "cache",
          "to": "app",
          "label": "miss"
        }
      ],
      "states": {
        "cache": "miss"
      },
      "highlight": [
        "cache"
      ]
    },
    {
      "narration": "The app hashes the code to find the right shard and reads from it (a replica serves reads). Only misses like this reach the database.",
      "messages": [
        {
          "from": "app",
          "to": "db",
          "label": "read q7Lm2X"
        },
        {
          "from": "db",
          "to": "app",
          "label": "long URL"
        }
      ],
      "states": {
        "db": "1 shard read"
      }
    },
    {
      "narration": "The app stores the result in the cache for next time, then redirects. The next visitor to this link will be a cache hit.",
      "messages": [
        {
          "from": "app",
          "to": "cache",
          "label": "store q7Lm2X"
        },
        {
          "from": "app",
          "to": "browser",
          "label": "302 to long URL"
        }
      ],
      "states": {
        "cache": "cached"
      }
    }
  ]
}
