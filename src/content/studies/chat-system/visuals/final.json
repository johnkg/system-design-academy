{
  "actors": [
    {
      "id": "alice",
      "label": "Alice's phone",
      "role": "client",
      "x": 14,
      "y": 50
    },
    {
      "id": "bus",
      "label": "Pub/sub bus",
      "role": "async",
      "x": 50,
      "y": 16
    },
    {
      "id": "csa",
      "label": "Chat server A",
      "role": "edge",
      "x": 50,
      "y": 50
    },
    {
      "id": "store",
      "label": "Message store",
      "role": "data",
      "x": 50,
      "y": 80
    },
    {
      "id": "csb",
      "label": "Chat server B",
      "role": "edge",
      "x": 86,
      "y": 50
    },
    {
      "id": "bob",
      "label": "Bob's phone",
      "role": "client",
      "x": 86,
      "y": 80
    }
  ],
  "frames": [
    {
      "narration": "Alice types 'hi' and her app sends it over its open WebSocket, tagged with a unique client id, m-901.",
      "messages": [
        {
          "from": "alice",
          "to": "csa",
          "label": "send 'hi' (id m-901)"
        }
      ],
      "states": {
        "alice": "sending"
      }
    },
    {
      "narration": "Chat server A stores the message in the conversation's shard. The store assigns it the next sequence number, 57. Had m-901 been stored already, it would be ignored.",
      "messages": [
        {
          "from": "csa",
          "to": "store",
          "label": "append (m-901)"
        }
      ],
      "states": {
        "store": "seq 57 saved"
      }
    },
    {
      "narration": "Only now does the server acknowledge. Alice's app shows one tick: the message is safely stored.",
      "messages": [
        {
          "from": "csa",
          "to": "alice",
          "label": "ack: seq 57"
        }
      ],
      "states": {
        "alice": "sent (1 tick)"
      }
    },
    {
      "narration": "The server checks the registry: Bob's connection is on chat server B. It publishes the message to that server through the bus.",
      "messages": [
        {
          "from": "csa",
          "to": "bus",
          "label": "for Bob, server B"
        },
        {
          "from": "bus",
          "to": "csb",
          "label": "message 57"
        }
      ],
      "states": {
        "bus": "routes to B"
      }
    },
    {
      "narration": "Server B pushes the message down Bob's open connection. It appears on his screen within milliseconds.",
      "messages": [
        {
          "from": "csb",
          "to": "bob",
          "label": "seq 57: hi"
        }
      ],
      "states": {
        "bob": "sees 'hi'"
      }
    },
    {
      "narration": "Bob's app confirms receipt, and the confirmation travels back the same way. Alice's app now shows two ticks: delivered.",
      "messages": [
        {
          "from": "bob",
          "to": "csb",
          "label": "delivered 57"
        },
        {
          "from": "csb",
          "to": "alice",
          "label": "delivered (via bus and A)"
        }
      ],
      "states": {
        "alice": "delivered (2 ticks)"
      }
    },
    {
      "narration": "Now Bob is offline. The registry has no entry for him, so the message simply stays in the store, and a push notification is sent to his phone through the vendor's service.",
      "states": {
        "bob": "offline: push sent",
        "store": "seq 58 waiting"
      },
      "highlight": [
        "bob"
      ]
    },
    {
      "narration": "When Bob opens the app he reconnects and asks for everything after the last number he has, 57. He receives 58, and if any message arrives twice, his app ignores it by id.",
      "messages": [
        {
          "from": "bob",
          "to": "csb",
          "label": "sync after 57"
        },
        {
          "from": "csb",
          "to": "bob",
          "label": "message 58"
        }
      ],
      "states": {
        "bob": "caught up"
      }
    }
  ]
}
