{
  "actors": [
    { "id": "user", "label": "User", "role": "user", "x": 10, "y": 50 },
    { "id": "ui", "label": "Screen", "role": "ui", "x": 32, "y": 22 },
    { "id": "store", "label": "Local DB", "role": "store", "x": 52, "y": 70 },
    { "id": "sync", "label": "Sync loop", "role": "sync", "x": 72, "y": 40 },
    { "id": "server", "label": "Server", "role": "server", "x": 92, "y": 70 }
  ],
  "linkLabel": "tap and sync",
  "meters": [
    { "id": "queued", "label": "Changes waiting in the queue", "max": 6, "start": 0 },
    { "id": "lost", "label": "Changes lost on close", "max": 6, "start": 0, "warnAt": 1 }
  ],
  "frames": [
    {
      "narration": "The screen draws whatever the local database holds. The server is reachable, but the screen does not depend on it.",
      "states": { "ui": "shows 5 tasks", "store": "5 tasks", "server": "5 tasks" },
      "links": { "add": [["ui", "store"], ["sync", "store"], ["sync", "server"]] },
      "highlight": ["ui", "store"]
    },
    {
      "narration": "The user ticks a task. The app writes the change to the local database and redraws. That takes a few milliseconds, with no network involved.",
      "messages": [{ "from": "user", "to": "ui", "label": "tick task" }, { "from": "ui", "to": "store", "label": "write + queue" }],
      "states": { "ui": "task done", "store": "done, 1 queued" },
      "links": { "add": [["user", "ui"]] },
      "highlight": ["ui", "store"],
      "meters": { "queued": 1 }
    },
    {
      "narration": "The sync loop sends the queued change with an id. The server accepts it and the entry leaves the queue.",
      "messages": [{ "from": "sync", "to": "server", "label": "change #41" }, { "from": "server", "to": "sync", "label": "ok" }],
      "states": { "store": "done, queue empty", "server": "task done" },
      "highlight": ["sync", "server"],
      "meters": { "queued": 0 }
    },
    {
      "narration": "The train enters a tunnel. The connection drops, and the user keeps working: three more ticks, each applied locally and added to the queue.",
      "messages": [{ "from": "user", "to": "ui", "label": "3 more taps" }],
      "states": { "ui": "4 tasks done", "store": "3 queued", "sync": "offline" },
      "links": { "remove": [["sync", "server"]] },
      "highlight": ["user", "store"],
      "meters": { "queued": 3 }
    },
    {
      "narration": "The app is closed in the tunnel. In a design that kept the changes in memory, all three would be gone. Here they are on disk in the queue.",
      "states": { "ui": "app closed", "store": "3 queued, saved", "sync": "stopped" },
      "highlight": ["store"],
      "meters": { "queued": 3, "lost": 0 }
    },
    {
      "narration": "Back in signal, the app opens, shows the same 4 done tasks at once, and the sync loop sends the 3 queued changes. Ids make a repeat of any of them safe.",
      "messages": [{ "from": "sync", "to": "server", "label": "#42, #43, #44" }, { "from": "server", "to": "sync", "label": "ok" }],
      "states": { "ui": "4 tasks done", "store": "queue empty", "sync": "online", "server": "4 tasks done" },
      "links": { "add": [["sync", "server"]] },
      "highlight": ["sync", "server"],
      "meters": { "queued": 0 }
    },
    {
      "narration": "One change the server cannot accept, for a list someone else deleted. The app marks it as not synced and tells the user, instead of retrying it forever.",
      "messages": [{ "from": "sync", "to": "server", "label": "#45" }, { "from": "server", "to": "sync", "label": "rejected" }],
      "states": { "ui": "task flagged: not synced", "store": "#45 failed" },
      "highlight": ["ui", "server"],
      "meters": { "queued": 1 }
    },
    {
      "narration": "Compare with an optimistic update that holds the request in memory: the screen is as fast, but closing the app in the tunnel would have lost 3 changes the user saw succeed.",
      "states": { "ui": "looked saved", "store": "no queue on disk" },
      "highlight": ["ui"],
      "meters": { "queued": 0, "lost": 3 }
    }
  ]
}
