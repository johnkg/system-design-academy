  "frames": [
    {
      "narration": "20:10. Users report a slow checkout page. Start at the top: checkout p99 is 1.3 s against 220 ms an hour ago. The average (520 ms) says 'slower' but not where.",
      "messages": [
        {
          "from": "service",
          "to": "dashboard",
          "label": "p99 1.3 s"
        }
      ],
      "states": {
        "dashboard": "SLO burning",
        "service": "p99 1.3 s"
      },
      "links": {
        "add": [
          [
            "dashboard",
            "service"
          ],
          [
            "service",
            "dependency"
          ],
          [
            "service",
            "pool"
          ],
          [
            "pool",
            "db"
          ]
        ]
      },
      "highlight": [
        "service"
      ]
    },
    {
      "narration": "RED on checkout. Rate: 120 req/s, flat, so this is not a traffic spike. Errors: 2%, up from 0.2%. Duration: successes p50 150 ms but failed requests take 3 s, so they are timeouts, not fast 500s from a bad deploy.",
      "messages": [
        {
          "from": "service",
          "to": "dashboard",
          "label": "RED"
        }
      ],
      "states": {
        "service": "120/s, 2% err"
      },
      "highlight": [
        "dashboard",
        "service"
      ]
    },
    {
      "narration": "RED per dependency. Payments p99 is 150 ms, same as yesterday. Inventory is normal too. The slow hop is not a service we call.",
      "messages": [
        {
          "from": "service",
          "to": "dependency",
          "label": "charge"
        },
        {
          "from": "dependency",
          "to": "service",
          "label": "150 ms"
        }
      ],
      "states": {
        "dependency": "p99 150 ms, normal"
      },
      "highlight": [
        "dependency"
      ]
    },
    {
      "narration": "The database call itself: query p99 went from 12 ms to 900 ms. Now the question is why a database is slow, which is a job for USE.",
      "messages": [
        {
          "from": "pool",
          "to": "db",
          "label": "query"
        },
        {
          "from": "db",
          "to": "pool",
          "label": "900 ms"
        }
      ],
      "states": {
        "db": "query p99 900 ms"
      },
      "highlight": [
        "db"
      ]
    },
    {
      "narration": "USE on the pool. Utilization: 20 of 20 connections in use. Saturation: 40 threads are waiting for one, and that queue started growing before the first timeout. The pool is the place where requests are lining up.",
      "messages": [
        {
          "from": "service",
          "to": "pool",
          "label": "get conn"
        }
      ],
      "states": {
        "pool": "20/20 used, 40 waiting"
      },
      "highlight": [
        "pool"
      ]
    },
    {
      "narration": "USE on the database host. CPU 14%, down from 30%, and disk is quiet. The database is not out of capacity, it is idle and waiting. Slow queries with an idle host usually mean lock waits, not too much load.",
      "states": {
        "db": "CPU 14%, idle"
      },
      "highlight": [
        "db"
      ]
    },
    {
      "narration": "Now open the trace and the slow query log for the database only. An UPDATE on the inventory table waits about 1 s on a row lock held by a nightly stock-sync job that was started at 20:08.",
      "messages": [
        {
          "from": "dashboard",
          "to": "db",
          "label": "trace + logs"
        }
      ],
      "states": {
        "dashboard": "cause found",
        "db": "row lock wait ~1 s"
      },
      "highlight": [
        "db"
      ]
    },
    {
      "narration": "Pause the job. Lock waits end, each connection is held for 12 ms again, the 40 waiters drain, and checkout p99 returns to 220 ms. Four panels, in order, took us from 'slow' to the cause.",
      "messages": [
        {
          "from": "db",
          "to": "pool",
          "label": "12 ms"
        },
        {
          "from": "service",
          "to": "dashboard",
          "label": "p99 220 ms"
        }
      ],
      "states": {
        "pool": "6/20 used, 0 waiting",
        "db": "query p99 12 ms",
        "dashboard": "SLO recovering"
      },
      "highlight": [
        "pool"
      ]
    }
  ]
}
