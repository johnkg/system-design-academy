  ],
  "frames": [
    {
      "narration": "A client sends the command 'set x = 7' to the leader of a five-node cluster (the leader and four followers; three of the followers are shown).",
      "messages": [
        {
          "from": "client",
          "to": "leader",
          "label": "set x = 7"
        }
      ],
      "states": {
        "leader": "log: [x=7] (not committed)"
      }
    },
    {
      "narration": "The leader appends the command to its own log and sends it to all followers.",
      "messages": [
        {
          "from": "leader",
          "to": "f1",
          "label": "append x=7"
        },
        {
          "from": "leader",
          "to": "f2",
          "label": "append x=7"
        },
        {
          "from": "leader",
          "to": "f3",
          "label": "append x=7"
        }
      ],
      "states": {
        "leader": "waiting for a majority"
      }
    },
    {
      "narration": "Follower C is slow, but followers A and B append the entry and reply. With the leader, that is 3 of 5 copies: a majority.",
      "messages": [
        {
          "from": "f1",
          "to": "leader",
          "label": "stored"
        },
        {
          "from": "f2",
          "to": "leader",
          "label": "stored"
        }
      ],
      "states": {
        "f1": "has x=7",
        "f2": "has x=7",
        "f3": "not yet"
      }
    },
    {
      "narration": "A majority has the entry, so it is committed. The leader applies it, tells the client it is done, and tells the followers to apply it too.",
      "messages": [
        {
          "from": "leader",
          "to": "client",
          "label": "done: x = 7"
        }
      ],
      "states": {
        "leader": "x=7 COMMITTED"
      },
      "highlight": [
        "leader"
      ]
    },
    {
      "narration": "The leader crashes right after. Followers A and B hold the committed entry, so any new leader elected by a majority must come from nodes that have it. The committed write cannot be lost.",
      "states": {
        "leader": "CRASHED",
        "f1": "can become leader, has x=7"
      },
      "highlight": [
        "f1"
      ]
    },
    {
      "narration": "Follower C catches up: the new leader sends it the entries it missed, and it overwrites anything that conflicts. Every node ends with the same log in the same order.",
      "messages": [
        {
          "from": "f1",
          "to": "f3",
          "label": "catch up: x=7"
        }
      ],
      "states": {
        "f3": "log repaired"
      }
    }
  ]
}
