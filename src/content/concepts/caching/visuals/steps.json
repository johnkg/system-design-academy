{
  "actors": [
    { "id": "app", "label": "Application", "role": "app", "x": 14, "y": 50 },
    { "id": "cache", "label": "Cache", "role": "cache", "x": 50, "y": 18 },
    { "id": "db", "label": "Database", "role": "database", "x": 84, "y": 70 }
  ],
  "meters": [
    { "id": "db", "label": "Database queries", "max": 3 },
    { "id": "hits", "label": "Cache hits", "max": 3 },
    { "id": "lat", "label": "Latest read", "unit": " ms", "max": 60, "warnAt": 50 }
  ],
  "frames": [
    { "narration": "The cache starts empty. The database holds the real data.", "states": { "cache": "empty", "db": "product 42: $10" }, "highlight": ["cache", "db"] },
    { "narration": "First request for product 42. The application checks the cache before anything else.", "messages": [{ "from": "app", "to": "cache", "label": "get(product:42)" }], "states": { "cache": "MISS" } },
    { "narration": "A miss, so it pays the full price and asks the database (slow).", "messages": [{ "from": "app", "to": "db", "label": "SELECT product 42" }, { "from": "db", "to": "app", "label": "$10" }], "states": { "db": "query ran (about 50 ms)" }, "meters": { "db": 1, "lat": 50 } },
    { "narration": "The application stores the answer in the cache, with a time to live, for next time.", "messages": [{ "from": "app", "to": "cache", "label": "set(product:42, $10, ttl 60s)" }], "states": { "cache": "product:42 = $10" } },
    { "narration": "Second request for the same product. This time the cache has it.", "messages": [{ "from": "app", "to": "cache", "label": "get(product:42)" }], "states": { "cache": "HIT: $10 (about 1 ms)" }, "meters": { "hits": 1, "lat": 1 } },
    { "narration": "The database never saw that request. Multiply by thousands and the database stays calm.", "highlight": ["db"], "states": { "db": "idle" } },
    { "narration": "Now the price changes in the database. The cache does not know, so it still holds the old value: it is stale.", "states": { "db": "product 42: $12", "cache": "still $10 (stale!)" }, "highlight": ["cache"] },
    { "narration": "The application invalidates the entry when it writes. (A TTL would also remove it eventually, just later.)", "messages": [{ "from": "app", "to": "cache", "label": "delete(product:42)" }], "states": { "cache": "empty" } },
    { "narration": "The next read misses, loads the fresh price, and refills the cache.", "messages": [{ "from": "app", "to": "db", "label": "SELECT product 42" }, { "from": "db", "to": "cache", "label": "$12 (refill)" }], "states": { "cache": "product:42 = $12 (fresh)" }, "meters": { "db": 2, "lat": 50 } }
  ]
}
