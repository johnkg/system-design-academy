{
  "actors": [
    { "id": "client", "label": "Client", "role": "client", "x": 14, "y": 50 },
    { "id": "service", "label": "Service", "role": "service", "x": 84, "y": 50 }
  ],
  "meters": [
    { "id": "att", "label": "Attempts made", "max": 5, "warnAt": 5 },
    { "id": "wait", "label": "Wait before the next attempt (ms, about)", "max": 400 },
    { "id": "err", "label": "Errors the user saw", "max": 1, "warnAt": 1 }
  ],
  "frames": [
    {
      "narration": "The client calls the service. The service is restarting, so the call fails.",
      "meters": { "att": 1 },
      "messages": [{ "from": "client", "to": "service", "label": "attempt 1" }, { "from": "service", "to": "client", "label": "503 unavailable" }],
      "states": { "client": "failed once", "service": "restarting" }
    },
    {
      "narration": "The client waits 100 ms (plus a random amount) and tries again. It is still down.",
      "meters": { "att": 2, "wait": 100 },
      "messages": [{ "from": "client", "to": "service", "label": "attempt 2 (after ~100 ms)" }, { "from": "service", "to": "client", "label": "503 unavailable" }],
      "states": { "client": "waited ~100 ms" }
    },
    {
      "narration": "Backoff doubles the wait to about 200 ms. The service gets quiet gaps instead of a constant hammering.",
      "meters": { "att": 3, "wait": 200 },
      "messages": [{ "from": "client", "to": "service", "label": "attempt 3 (after ~200 ms)" }, { "from": "service", "to": "client", "label": "503 unavailable" }],
      "states": { "client": "waited ~200 ms" }
    },
    {
      "narration": "Next wait is about 400 ms. Meanwhile the other clients picked different random waits, so they are not all arriving together.",
      "meters": { "wait": 400 },
      "states": { "client": "waiting ~400 ms", "service": "almost ready" },
      "highlight": ["client"]
    },
    {
      "narration": "The service is back. Attempt 4 succeeds and the user never saw an error.",
      "meters": { "att": 4, "wait": 0 },
      "messages": [{ "from": "client", "to": "service", "label": "attempt 4" }, { "from": "service", "to": "client", "label": "200 ok" }],
      "states": { "client": "success after 4 attempts", "service": "healthy" }
    },
    {
      "narration": "If the service had stayed down, the client would stop after its maximum attempts and report the error instead of retrying forever.",
      "states": { "client": "max 5 attempts, then give up" },
      "highlight": ["client"]
    }
  ]
}
