{
  "actors": [
    { "id": "leader", "label": "Node 1 (leader)", "role": "leader", "x": 14, "y": 50 },
    { "id": "f2", "label": "Node 2", "role": "follower", "x": 50, "y": 16 },
    { "id": "f3", "label": "Node 3", "role": "follower", "x": 50, "y": 84 },
    { "id": "f4", "label": "Node 4", "role": "follower", "x": 86, "y": 50 }
  ],
  "meters": [
    { "id": "lead", "label": "Active leaders", "max": 2, "start": 1, "warnAt": 2 },
    { "id": "term", "label": "Current term", "max": 2, "start": 1 },
    { "id": "votes", "label": "Votes for node 3 (3 needed)", "max": 5 }
  ],
  "frames": [
    {
      "narration": "A five-node cluster. Node 1 is the leader, term 1. It sends heartbeats to the others, and each follower resets its election timer when one arrives.",
      "messages": [{ "from": "leader", "to": "f2", "label": "heartbeat" }, { "from": "leader", "to": "f3", "label": "heartbeat" }, { "from": "leader", "to": "f4", "label": "heartbeat" }],
      "states": { "leader": "term 1, leader" }
    },
    {
      "narration": "Node 1 crashes. The heartbeats stop.",
      "meters": { "lead": 0 },
      "states": { "leader": "CRASHED" },
      "highlight": ["leader"]
    },
    {
      "narration": "Node 3's election timer runs out first (timeouts are randomised). It becomes a candidate: it moves to term 2, votes for itself and asks the others for their votes.",
      "meters": { "term": 2, "votes": 1 },
      "messages": [{ "from": "f3", "to": "f2", "label": "vote for me, term 2?" }, { "from": "f3", "to": "f4", "label": "vote for me, term 2?" }],
      "states": { "f3": "candidate, term 2" }
    },
    {
      "narration": "Nodes 2 and 4 have not voted in term 2, so they grant their votes. Node 3 now has 3 of 5 votes, a majority of the whole cluster.",
      "meters": { "votes": 3 },
      "messages": [{ "from": "f2", "to": "f3", "label": "vote granted" }, { "from": "f4", "to": "f3", "label": "vote granted" }],
      "states": { "f3": "3 of 5 votes" }
    },
    {
      "narration": "Node 3 becomes the leader of term 2 and starts sending heartbeats. The cluster has a leader again, with no human involved.",
      "meters": { "lead": 1 },
      "messages": [{ "from": "f3", "to": "f2", "label": "heartbeat, term 2" }, { "from": "f3", "to": "f4", "label": "heartbeat, term 2" }],
      "states": { "f3": "term 2, leader" },
      "highlight": ["f3"]
    },
    {
      "narration": "Later node 1 restarts and still thinks it is the leader of term 1. The first heartbeat it receives carries term 2, so it steps down and becomes a follower. Two leaders never act at once.",
      "messages": [{ "from": "f3", "to": "leader", "label": "heartbeat, term 2" }],
      "states": { "leader": "sees term 2, becomes follower" }
    }
  ]
}
