{
  "actors": [
    {
      "id": "client",
      "label": "Payment app",
      "role": "client",
      "x": 14,
      "y": 50
    },
    {
      "id": "server",
      "label": "Payment API",
      "role": "server",
      "x": 50,
      "y": 50
    },
    {
      "id": "store",
      "label": "Key store",
      "role": "store",
      "x": 86,
      "y": 50
    }
  ],
  "frames": [
    {
      "narration": "The user taps Pay. The app creates a unique key for this action, 'abc-123', and sends the request.",
      "messages": [
        {
          "from": "client",
          "to": "server",
          "label": "charge $50, key abc-123"
        }
      ],
      "states": {
        "client": "key: abc-123"
      }
    },
    {
      "narration": "The server has never seen this key, so it records it and does the work: the card is charged once.",
      "messages": [
        {
          "from": "server",
          "to": "store",
          "label": "save key + result"
        }
      ],
      "states": {
        "server": "charged $50",
        "store": "abc-123 saved"
      }
    },
    {
      "narration": "The response is lost on the way back. The app sees only a timeout and cannot know if the charge happened.",
      "states": {
        "client": "timed out"
      },
      "highlight": [
        "client"
      ]
    },
    {
      "narration": "The app retries with the same key. A new key would be treated as a new payment.",
      "messages": [
        {
          "from": "client",
          "to": "server",
          "label": "charge $50, key abc-123"
        }
      ],
      "states": {
        "client": "same key"
      }
    },
    {
      "narration": "The server looks up the key and finds it. It does not charge again.",
      "messages": [
        {
          "from": "server",
          "to": "store",
          "label": "seen abc-123?"
        },
        {
          "from": "store",
          "to": "server",
          "label": "yes: charged"
        }
      ],
      "states": {
        "server": "no new charge"
      }
    },
    {
      "narration": "The server returns the saved result. The customer was charged exactly once.",
      "messages": [
        {
          "from": "server",
          "to": "client",
          "label": "ok (saved response)"
        }
      ],
      "states": {
        "client": "confirmed",
        "server": "charged $50 once"
      }
    }
  ]
}
