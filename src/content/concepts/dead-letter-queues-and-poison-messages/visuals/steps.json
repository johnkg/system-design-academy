{
  "actors": [
    {
      "id": "shop",
      "label": "Shop",
      "role": "producer",
      "x": 50,
      "y": 86
    },
    {
      "id": "queue",
      "label": "Order queue",
      "role": "queue",
      "x": 50,
      "y": 62
    },
    {
      "id": "worker",
      "label": "Order worker",
      "role": "worker",
      "x": 18,
      "y": 62
    },
    {
      "id": "dlq",
      "label": "Dead-letter queue",
      "role": "dlq",
      "x": 50,
      "y": 38
    },
    {
      "id": "ops",
      "label": "On-call engineer",
      "role": "operator",
      "x": 50,
      "y": 14
    }
  ],
  "frames": [
    {
      "narration": "The shop publishes orders to the queue and a worker ships them. About 98 orders in 100 are fine.",
      "messages": [
        {
          "from": "shop",
          "to": "queue",
          "label": "order 4820"
        },
        {
          "from": "queue",
          "to": "worker",
          "label": "order 4820"
        },
        {
          "from": "worker",
          "to": "queue",
          "label": "ack"
        }
      ],
      "states": {
        "queue": "ordered, 1 consumer",
        "worker": "ok"
      }
    },
    {
      "narration": "Order 4821 has an empty street field. The worker cannot build a shipping label and throws. It does not acknowledge the message.",
      "messages": [
        {
          "from": "queue",
          "to": "worker",
          "label": "order 4821"
        }
      ],
      "states": {
        "worker": "bad address, attempt 1",
        "queue": "4821 + 9 behind it"
      },
      "highlight": [
        "worker"
      ]
    },
    {
      "narration": "No ack, so an at-least-once queue redelivers it. The error is permanent (the data is wrong, not the network), so every attempt fails the same way. The 9 healthy orders behind it wait.",
      "messages": [
        {
          "from": "queue",
          "to": "worker",
          "label": "4821 again"
        }
      ],
      "states": {
        "worker": "bad address, attempt 2",
        "queue": "9 healthy waiting"
      },
      "highlight": [
        "queue"
      ]
    },
    {
      "narration": "Without a limit this repeats forever: the key is blocked, the worker is busy for nothing, and the 9 orders get later and later. Here the queue has a max receive count of 3, and attempt 3 fails too.",
      "messages": [
        {
          "from": "queue",
          "to": "worker",
          "label": "4821 again"
        }
      ],
      "states": {
        "worker": "bad address, attempt 3",
        "queue": "limit of 3 reached"
      },
      "highlight": [
        "worker"
      ]
    },
    {
      "narration": "The queue moves order 4821 to the dead-letter queue and keeps the metadata: the last error, 3 attempts, the source queue and the timestamps. It is parked, not lost.",
      "messages": [
        {
          "from": "queue",
          "to": "dlq",
          "label": "4821 + error, 3 tries"
        }
      ],
      "states": {
        "dlq": "depth 1",
        "queue": "9 healthy waiting"
      },
      "highlight": [
        "dlq"
      ]
    },
    {
      "narration": "The line moves again. Order 4822 goes through immediately. The one bad order cost 3 attempts instead of blocking everything.",
      "messages": [
        {
          "from": "queue",
          "to": "worker",
          "label": "order 4822"
        },
        {
          "from": "worker",
          "to": "queue",
          "label": "ack"
        }
      ],
      "states": {
        "worker": "ok",
        "queue": "8 healthy waiting"
      }
    },
    {
      "narration": "An alarm fires on DLQ depth above 0 (and later on the age of the oldest message). The engineer reads the parked message and its error and finds the missing street.",
      "messages": [
        {
          "from": "dlq",
          "to": "ops",
          "label": "alarm: depth 1"
        }
      ],
      "states": {
        "dlq": "oldest: 2 h",
        "ops": "inspecting 4821"
      },
      "highlight": [
        "ops"
      ]
    },
    {
      "narration": "The address is corrected (or the parser fixed). The engineer redrives the message into the source queue. Order 4821 is processed once and the handler is idempotent in case it had half-succeeded.",
      "messages": [
        {
          "from": "dlq",
          "to": "queue",
          "label": "redrive 4821"
        },
        {
          "from": "queue",
          "to": "worker",
          "label": "order 4821"
        },
        {
          "from": "worker",
          "to": "queue",
          "label": "ack"
        }
      ],
      "states": {
        "dlq": "depth 0",
        "worker": "ok",
        "ops": "redriven"
      },
      "highlight": [
        "dlq"
      ]
    }
  ]
}
