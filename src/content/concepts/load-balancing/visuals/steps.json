{
  "actors": [
    { "id": "client", "label": "Clients", "role": "client", "x": 12, "y": 50 },
    { "id": "lb", "label": "Load balancer", "role": "balancer", "x": 46, "y": 50 },
    { "id": "s1", "label": "Server 1", "role": "server", "x": 84, "y": 14 },
    { "id": "s2", "label": "Server 2", "role": "server", "x": 84, "y": 50 },
    { "id": "s3", "label": "Server 3", "role": "server", "x": 84, "y": 86 }
  ],
  "linkLabel": "in rotation",
  "meters": [
    { "id": "req", "label": "Requests handled", "max": 6 },
    { "id": "up", "label": "Healthy servers", "max": 3, "start": 3, "warnAt": 2, "good": "high" },
    { "id": "err", "label": "Errors seen by customers", "max": 3 }
  ],
  "frames": [
    { "narration": "Three healthy servers sit behind one load balancer. Clients only know the balancer's address.", "links": { "add": [["lb", "s1"], ["lb", "s2"], ["lb", "s3"]] }, "states": { "lb": "algorithm: round robin" }, "highlight": ["lb"] },
    { "narration": "Request 1 arrives at the balancer.", "messages": [{ "from": "client", "to": "lb", "label": "GET /cart" }], "states": { "lb": "next: Server 1" } },
    { "narration": "Round robin takes turns, so request 1 goes to Server 1.", "messages": [{ "from": "lb", "to": "s1", "label": "request 1" }], "states": { "s1": "handled 1", "lb": "next: Server 2" }, "meters": { "req": 1 } },
    { "narration": "Request 2 goes to Server 2, request 3 to Server 3.", "messages": [{ "from": "lb", "to": "s2", "label": "request 2" }, { "from": "lb", "to": "s3", "label": "request 3" }], "states": { "s2": "handled 1", "s3": "handled 1", "lb": "next: Server 1 again" }, "meters": { "req": 3 } },
    { "narration": "Request 4 wraps around to Server 1. The load is spread evenly, and each server does about a third of the work.", "messages": [{ "from": "lb", "to": "s1", "label": "request 4" }], "states": { "s1": "handled 2", "lb": "next: Server 2" }, "meters": { "req": 4 } },
    { "narration": "Server 2 crashes. The balancer's next health check fails, so it is removed from rotation.", "states": { "s2": "DOWN (health check failed)", "lb": "healthy: Server 1, 3" }, "links": { "remove": [["lb", "s2"]] }, "highlight": ["s2"], "meters": { "up": 2 } },
    { "narration": "A new request would have gone to Server 2. The balancer skips it, so no customer sees an error.", "messages": [{ "from": "client", "to": "lb", "label": "GET /checkout" }, { "from": "lb", "to": "s3", "label": "request 5" }], "states": { "s3": "handled 2", "lb": "skipped Server 2" }, "meters": { "req": 5 } },
    { "narration": "When Server 2 recovers and passes its health checks, it rejoins rotation without anyone changing a client.", "states": { "s2": "healthy again" }, "links": { "add": [["lb", "s2"]] }, "highlight": ["s2"], "meters": { "up": 3 } }
  ]
}
