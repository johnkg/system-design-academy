  "linkLabel": "network link",
  "frames": [
    {
      "narration": "Two nodes in different data centres hold a copy of x. The link between them is healthy, so they stay in step.",
      "links": {
        "add": [
          [
            "a",
            "b"
          ]
        ]
      },
      "states": {
        "a": "x = 1",
        "b": "x = 1"
      },
      "highlight": [
        "a",
        "b"
      ]
    },
    {
      "narration": "Client 1 writes x = 2 to node A. A replicates it to B over the link, so both agree.",
      "messages": [
        {
          "from": "c1",
          "to": "a",
          "label": "write x = 2"
        },
        {
          "from": "a",
          "to": "b",
          "label": "replicate x = 2"
        }
      ],
      "states": {
        "a": "x = 2",
        "b": "x = 2"
      }
    },
    {
      "narration": "The network between the data centres fails: a partition. Both nodes are still running, but neither can reach the other.",
      "links": {
        "remove": [
          [
            "a",
            "b"
          ]
        ]
      },
      "states": {
        "a": "cannot reach B",
        "b": "cannot reach A"
      },
      "highlight": [
        "a",
        "b"
      ]
    },
    {
      "narration": "Client 1 now writes x = 3 to node A. A cannot tell B. Whatever A does next is the CAP decision.",
      "messages": [
        {
          "from": "c1",
          "to": "a",
          "label": "write x = 3"
        }
      ]
    },
    {
      "narration": "Choice AP (available): A accepts the write. The system stays up, but B still holds x = 2, so Client 2 reads an old value.",
      "messages": [
        {
          "from": "c2",
          "to": "b",
          "label": "read x"
        }
      ],
      "states": {
        "a": "accepted: x = 3",
        "b": "answers x = 2 (stale)",
        "c2": "got x = 2 (stale but available)"
      }
    },
    {
      "narration": "Choice CP (consistent): instead, A refuses the write because it cannot confirm B has it. No stale data, but the client gets an error.",
      "states": {
        "a": "refused: error 503",
        "c1": "write failed (unavailable)",
        "c2": "read refused too"
      },
      "highlight": [
        "c1"
      ]
    },
    {
      "narration": "When the link heals, the nodes sync. An AP system must reconcile any writes made on both sides; if both changed x, one change is typically lost.",
      "links": {
        "add": [
          [
            "a",
            "b"
          ]
        ]
      },
      "states": {
        "a": "x = 3",
        "b": "x = 3 (caught up)"
      },
      "highlight": [
        "a",
        "b"
      ]
    }
  ]
