{
  "actors": [
    { "id": "dev", "label": "Developer", "role": "dev", "x": 12, "y": 25 },
    { "id": "git", "label": "Git repo", "role": "git", "x": 38, "y": 25 },
    { "id": "ctl", "label": "Controller", "role": "controller", "x": 64, "y": 50 },
    { "id": "cluster", "label": "Cluster", "role": "cluster", "x": 88, "y": 50 },
    { "id": "oncall", "label": "On-call", "role": "oncall", "x": 64, "y": 85 }
  ],
  "linkLabel": "pull and apply",
  "meters": [
    { "id": "deploys", "label": "Deploys done by commit", "max": 3, "start": 0 },
    { "id": "drift", "label": "Hand-made changes still live", "max": 1, "start": 0, "warnAt": 1 }
  ],
  "frames": [
    {
      "narration": "Git says: checkout image v1, 3 replicas, plus a cleanup job. The controller inside the cluster has applied exactly that, so the app is Synced.",
      "states": { "git": "v1, 3 replicas", "cluster": "v1, 3 replicas", "ctl": "Synced" },
      "links": { "add": [["git", "ctl"], ["ctl", "cluster"]] },
      "highlight": ["git"]
    },
    {
      "narration": "A developer changes the image to v2 in a pull request. Once it is reviewed and merged, the commit is the deploy. Nobody touches the cluster.",
      "messages": [{ "from": "dev", "to": "git", "label": "commit v2" }],
      "states": { "git": "v2, 3 replicas", "ctl": "OutOfSync" },
      "links": { "add": [["dev", "git"]] },
      "highlight": ["dev", "git"]
    },
    {
      "narration": "A webhook tells the controller about the push. It compares Git with the cluster, sees the image differs, and rolls the deployment to v2.",
      "messages": [{ "from": "git", "to": "ctl", "label": "webhook" }, { "from": "ctl", "to": "cluster", "label": "apply v2" }],
      "states": { "cluster": "v2, 3 replicas", "ctl": "Synced" },
      "highlight": ["ctl"],
      "meters": { "deploys": 1 }
    },
    {
      "narration": "During a traffic spike the on-call engineer runs kubectl scale --replicas=10. Git still says 3, so live state has drifted.",
      "messages": [{ "from": "oncall", "to": "cluster", "label": "scale to 10" }],
      "states": { "cluster": "v2, 10 replicas", "ctl": "OutOfSync" },
      "links": { "add": [["oncall", "cluster"]] },
      "highlight": ["oncall", "cluster"],
      "meters": { "drift": 1 }
    },
    {
      "narration": "Self-heal is on: the controller sees the change within seconds and puts 3 replicas back. A lasting change has to be a commit.",
      "messages": [{ "from": "ctl", "to": "cluster", "label": "replicas 3" }],
      "states": { "cluster": "v2, 3 replicas", "ctl": "Synced" },
      "links": { "remove": [["oncall", "cluster"]] },
      "highlight": ["ctl"],
      "meters": { "drift": 0 }
    },
    {
      "narration": "A commit to v3 goes live and breaks checkout. The alert fires, and the fix is not a command on the cluster but git revert.",
      "messages": [{ "from": "dev", "to": "git", "label": "commit v3" }, { "from": "ctl", "to": "cluster", "label": "apply v3" }],
      "states": { "git": "v3", "cluster": "v3 broken", "ctl": "Synced" },
      "highlight": ["cluster"],
      "meters": { "deploys": 2 }
    },
    {
      "narration": "The revert is a new commit. The controller applies it like any other: v2 is back, and the history shows what broke and who undid it.",
      "messages": [{ "from": "dev", "to": "git", "label": "revert" }, { "from": "git", "to": "ctl", "label": "webhook" }, { "from": "ctl", "to": "cluster", "label": "apply v2" }],
      "states": { "git": "v2 (revert)", "cluster": "v2, 3 replicas", "ctl": "Synced" },
      "highlight": ["git"],
      "meters": { "deploys": 3 }
    },
    {
      "narration": "Last, the cleanup job's file is deleted from Git. With pruning on, the controller deletes the job too; without it, the job keeps running as an orphan.",
      "messages": [{ "from": "ctl", "to": "cluster", "label": "prune job" }],
      "states": { "git": "no cleanup job", "cluster": "job deleted", "ctl": "Synced" },
      "highlight": ["ctl", "cluster"]
    }
  ]
}
