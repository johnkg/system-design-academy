{
  "actors": [
    { "id": "app", "label": "Application", "role": "app", "x": 12, "y": 50 },
    { "id": "db", "label": "Database", "role": "db", "x": 46, "y": 50 },
    { "id": "a", "label": "Account A", "role": "account", "x": 84, "y": 20 },
    { "id": "b", "label": "Account B", "role": "account", "x": 84, "y": 80 }
  ],
  "meters": [
    {"id": "tot", "label": "Total of both accounts (pending included)", "max": 150, "start": 150, "warnAt": 149, "good": "high"},
    {"id": "com", "label": "Transactions committed", "max": 1},
    {"id": "rb", "label": "Transactions rolled back", "max": 1}
  ],
  "frames": [
    { "narration": "Account A holds 100 and account B holds 50. The rule that must always hold: the total is 150.", "states": { "a": "balance 100", "b": "balance 50", "db": "total = 150" }, "highlight": ["a", "b"] },
    { "narration": "The application starts a transaction to move 100 from A to B.", "messages": [{ "from": "app", "to": "db", "label": "BEGIN" }], "states": { "db": "transaction open" } },
    { "narration": "Step one: debit A. The change is held pending inside the transaction; other users do not see it yet.", "meters": {"tot": 50}, "messages": [{ "from": "db", "to": "a", "label": "debit 100" }], "states": { "a": "pending: 0" } },
    { "narration": "Step two: credit B.", "meters": {"tot": 150}, "messages": [{ "from": "db", "to": "b", "label": "credit 100" }], "states": { "b": "pending: 150" } },
    { "narration": "COMMIT. Both changes become visible together (atomicity), the invariant still holds (consistency), and the change is written to the log on disk (durability).", "meters": {"com": 1}, "messages": [{ "from": "app", "to": "db", "label": "COMMIT" }], "states": { "a": "balance 0", "b": "balance 150", "db": "committed, total = 150" } },
    { "narration": "Now a transfer that goes wrong. The transaction debits account B, then the server crashes before the credit happens.", "meters": {"tot": 50}, "messages": [{ "from": "app", "to": "db", "label": "BEGIN, debit B 100" }], "states": { "db": "CRASH before credit!", "b": "pending: 50" }, "highlight": ["db"] },
    { "narration": "On restart the database sees an unfinished transaction and rolls it back. Without transactions the 100 would simply have vanished.", "meters": {"tot": 150, "rb": 1}, "states": { "b": "balance 150 (rolled back)", "db": "all or nothing: total = 150" }, "highlight": ["b"] }
  ]
}
