{
  "actors": [
    {
      "id": "pub",
      "label": "Order service",
      "role": "publisher",
      "x": 14,
      "y": 14
    },
    {
      "id": "topic",
      "label": "Topic: orders",
      "role": "topic",
      "x": 46,
      "y": 52
    },
    {
      "id": "email",
      "label": "Email",
      "role": "subscriber",
      "x": 84,
      "y": 14
    },
    {
      "id": "inv",
      "label": "Inventory",
      "role": "subscriber",
      "x": 84,
      "y": 50
    },
    {
      "id": "ana",
      "label": "Analytics (slow)",
      "role": "subscriber",
      "x": 84,
      "y": 86
    }
  ],
  "linkLabel": "subscribed",
  "frames": [
    {
      "narration": "Three services have subscribed to the 'orders' topic. The order service knows none of them.",
      "links": {
        "add": [
          [
            "topic",
            "email"
          ],
          [
            "topic",
            "inv"
          ],
          [
            "topic",
            "ana"
          ]
        ]
      },
      "highlight": [
        "topic"
      ]
    },
    {
      "narration": "An order is placed. The order service publishes one OrderPlaced event to the topic and is finished.",
      "messages": [
        {
          "from": "pub",
          "to": "topic",
          "label": "publish OrderPlaced #7"
        }
      ],
      "states": {
        "pub": "done, not waiting"
      }
    },
    {
      "narration": "The topic fans out: every subscription gets its own copy of the event.",
      "messages": [
        {
          "from": "topic",
          "to": "email",
          "label": "copy"
        },
        {
          "from": "topic",
          "to": "inv",
          "label": "copy"
        },
        {
          "from": "topic",
          "to": "ana",
          "label": "copy"
        }
      ],
      "states": {
        "email": "sending receipt",
        "inv": "reserving stock",
        "ana": "queued (busy)"
      }
    },
    {
      "narration": "Email and Inventory finish quickly. Analytics is slow, but it only delays itself, not the others or the publisher.",
      "states": {
        "email": "done",
        "inv": "done",
        "ana": "still working on #7"
      },
      "highlight": [
        "ana"
      ]
    },
    {
      "narration": "A new Fraud-check service is added. It simply subscribes. The order service is not touched or redeployed.",
      "links": {
        "add": [
          [
            "topic",
            "ana"
          ]
        ]
      },
      "states": {
        "topic": "new subscription added"
      },
      "highlight": [
        "topic"
      ]
    },
    {
      "narration": "Next order: the event is copied to all subscribers, including the new one.",
      "messages": [
        {
          "from": "pub",
          "to": "topic",
          "label": "publish OrderPlaced #8"
        }
      ],
      "states": {
        "topic": "fan-out to every subscription"
      }
    },
    {
      "narration": "Within one subscription, several instances can share the work: each event goes to just one instance of that group, while other groups still each receive it.",
      "states": {
        "inv": "2 workers share the group's events"
      },
      "highlight": [
        "inv"
      ]
    }
  ]
}
