{
  "actors": [
    {
      "id": "ana",
      "label": "Ana",
      "role": "agent",
      "x": 82,
      "y": 62
    },
    {
      "id": "ben",
      "label": "Ben",
      "role": "agent",
      "x": 50,
      "y": 86
    },
    {
      "id": "api",
      "label": "API",
      "role": "api",
      "x": 50,
      "y": 62
    },
    {
      "id": "db",
      "label": "Database",
      "role": "db",
      "x": 50,
      "y": 38
    }
  ],
  "meters": [
    {"id": "dbv", "label": "Version stored in the database", "max": 10},
    {"id": "benv", "label": "Version Ben is working from", "max": 10},
    {"id": "rej", "label": "Writes rejected", "max": 2, "warnAt": 1}
  ],
  "frames": [
    {
      "narration": "Ana opens customer 4821. The API reads the row (version 7) and returns it with ETag: \"7\".",
      "meters": {"dbv": 7},
      "messages": [
        {
          "from": "ana",
          "to": "api",
          "label": "GET /customers/4821"
        },
        {
          "from": "api",
          "to": "ana",
          "label": "200 ETag \"7\""
        }
      ],
      "states": {
        "db": "phone A, v7",
        "ana": "has v7"
      }
    },
    {
      "narration": "Ben opens the same record a moment later. He also gets version 7.",
      "meters": {"benv": 7},
      "messages": [
        {
          "from": "ben",
          "to": "api",
          "label": "GET /customers/4821"
        },
        {
          "from": "api",
          "to": "ben",
          "label": "200 ETag \"7\""
        }
      ],
      "states": {
        "ben": "has v7"
      }
    },
    {
      "narration": "Ana changes the phone number and saves with If-Match: \"7\". The API runs UPDATE ... WHERE id = 4821 AND version = 7. One row matches, so the version becomes 8.",
      "meters": {"dbv": 8},
      "messages": [
        {
          "from": "ana",
          "to": "api",
          "label": "PUT If-Match \"7\""
        },
        {
          "from": "api",
          "to": "db",
          "label": "UPDATE ... AND version=7"
        },
        {
          "from": "api",
          "to": "ana",
          "label": "200 ETag \"8\""
        }
      ],
      "states": {
        "db": "phone B, v8",
        "ana": "has v8"
      },
      "highlight": [
        "db"
      ]
    },
    {
      "narration": "Ben, still on version 7, adds a billing note and saves with If-Match: \"7\". The same UPDATE now matches 0 rows because the row is at version 8.",
      "messages": [
        {
          "from": "ben",
          "to": "api",
          "label": "PUT If-Match \"7\""
        },
        {
          "from": "api",
          "to": "db",
          "label": "UPDATE ... AND version=7"
        },
        {
          "from": "db",
          "to": "api",
          "label": "0 rows"
        }
      ],
      "highlight": [
        "api"
      ]
    },
    {
      "narration": "The API answers 412 Precondition Failed and changes nothing. Without the header the PUT would have replaced the row and erased Ana's phone number, and Ben would have got a 200.",
      "meters": {"rej": 1},
      "messages": [
        {
          "from": "api",
          "to": "ben",
          "label": "412 Precondition Failed"
        }
      ],
      "states": {
        "ben": "stale v7",
        "db": "phone B, v8"
      },
      "highlight": [
        "ben"
      ]
    },
    {
      "narration": "Ben's client re-reads the record, gets Ana's phone number with ETag \"8\", and re-applies his billing note on top. His change touches a different field, so it can be merged without asking him.",
      "meters": {"benv": 8},
      "messages": [
        {
          "from": "ben",
          "to": "api",
          "label": "GET /customers/4821"
        },
        {
          "from": "api",
          "to": "ben",
          "label": "200 ETag \"8\""
        }
      ],
      "states": {
        "ben": "has v8"
      }
    },
    {
      "narration": "Ben saves again with If-Match: \"8\". It matches, the version becomes 9, and the row now holds both Ana's phone number and Ben's note.",
      "meters": {"dbv": 9, "benv": 9},
      "messages": [
        {
          "from": "ben",
          "to": "api",
          "label": "PUT If-Match \"8\""
        },
        {
          "from": "api",
          "to": "db",
          "label": "UPDATE ... AND version=8"
        },
        {
          "from": "api",
          "to": "ben",
          "label": "200 ETag \"9\""
        }
      ],
      "states": {
        "db": "phone B + note, v9",
        "ben": "has v9"
      },
      "highlight": [
        "db"
      ]
    },
    {
      "narration": "A client that sends a PUT with no If-Match at all gets 428 Precondition Required, so skipping the check is not possible on this resource.",
      "meters": {"rej": 2},
      "messages": [
        {
          "from": "ana",
          "to": "api",
          "label": "PUT (no If-Match)"
        },
        {
          "from": "api",
          "to": "ana",
          "label": "428 Precondition Required"
        }
      ],
      "highlight": [
        "api"
      ]
    }
  ]
}
