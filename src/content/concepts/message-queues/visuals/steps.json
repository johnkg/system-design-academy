{
  "actors": [
    {
      "id": "producer",
      "label": "Checkout",
      "role": "producer",
      "x": 12,
      "y": 50
    },
    {
      "id": "queue",
      "label": "Queue",
      "role": "queue",
      "x": 46,
      "y": 50
    },
    {
      "id": "c1",
      "label": "Worker 1",
      "role": "consumer",
      "x": 84,
      "y": 14
    },
    {
      "id": "c2",
      "label": "Worker 2",
      "role": "consumer",
      "x": 84,
      "y": 50
    },
    {
      "id": "dlq",
      "label": "Dead letters",
      "role": "queue",
      "x": 84,
      "y": 84
    }
  ],
  "frames": [
    {
      "narration": "A customer checks out. Checkout puts an 'order placed' message on the queue instead of calling the email service directly.",
      "messages": [
        {
          "from": "producer",
          "to": "queue",
          "label": "publish: email for order 42"
        }
      ],
      "states": {
        "queue": "1 message waiting"
      }
    },
    {
      "narration": "The queue stores it durably and checkout carries on immediately. The customer does not wait for the email.",
      "states": {
        "producer": "done in a few ms"
      },
      "highlight": [
        "producer"
      ]
    },
    {
      "narration": "Worker 1 takes the message. While it works on it, the message is hidden from others but not deleted.",
      "messages": [
        {
          "from": "queue",
          "to": "c1",
          "label": "deliver (attempt 1)"
        }
      ],
      "states": {
        "c1": "processing order 42",
        "queue": "1 in flight"
      }
    },
    {
      "narration": "Worker 1 crashes before it finishes. It never acknowledges the message.",
      "states": {
        "c1": "CRASHED"
      },
      "highlight": [
        "c1"
      ]
    },
    {
      "narration": "After a timeout the queue makes the message visible again and gives it to Worker 2. Nothing was lost.",
      "messages": [
        {
          "from": "queue",
          "to": "c2",
          "label": "redeliver (attempt 2)"
        }
      ],
      "states": {
        "c2": "processing order 42"
      }
    },
    {
      "narration": "Worker 2 succeeds and acknowledges. Only now is the message deleted. (If Worker 1 had actually sent the email before crashing, it goes out twice: handlers must tolerate duplicates.)",
      "messages": [
        {
          "from": "c2",
          "to": "queue",
          "label": "ack"
        }
      ],
      "states": {
        "queue": "empty",
        "c2": "done"
      }
    },
    {
      "narration": "Another message is malformed and fails every time. After a few attempts the queue stops retrying it.",
      "messages": [
        {
          "from": "queue",
          "to": "c2",
          "label": "deliver bad message (attempt 3)"
        }
      ],
      "states": {
        "c2": "failed again"
      }
    },
    {
      "narration": "It is moved to the dead-letter queue, where a person can inspect it, while everything else keeps flowing.",
      "messages": [
        {
          "from": "queue",
          "to": "dlq",
          "label": "give up: dead-letter"
        }
      ],
      "states": {
        "dlq": "1 poison message"
      }
    }
  ]
}
