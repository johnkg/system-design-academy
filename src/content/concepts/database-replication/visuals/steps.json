{
  "actors": [
    { "id": "client", "label": "Client", "role": "client", "x": 12, "y": 50 },
    { "id": "primary", "label": "Primary", "role": "primary", "x": 46, "y": 50 },
    { "id": "r1", "label": "Replica 1", "role": "replica", "x": 84, "y": 20 },
    { "id": "r2", "label": "Replica 2", "role": "replica", "x": 84, "y": 80 }
  ],
  "linkLabel": "replicates to",
  "meters": [
    { "id": "has", "label": "Nodes holding price 12", "max": 3, "start": 0, "good": "high" },
    { "id": "stale", "label": "Stale reads served", "max": 2, "warnAt": 1 }
  ],
  "frames": [
    { "narration": "One primary and two replicas hold the same data. Right now the price is 10 everywhere.", "links": { "add": [["primary", "r1"], ["primary", "r2"]] }, "states": { "primary": "price 10 (version 1)", "r1": "price 10 (version 1)", "r2": "price 10 (version 1)" }, "highlight": ["primary"] },
    { "narration": "The client changes the price. All writes go to the primary, which applies it and replies straight away (asynchronous replication).", "meters": { "has": 1 }, "messages": [{ "from": "client", "to": "primary", "label": "write price = 12" }], "states": { "primary": "price 12 (version 2)", "client": "write acknowledged" } },
    { "narration": "The primary sends the change to the replicas. Replica 1 applies it quickly; Replica 2 is slower and has not yet.", "meters": { "has": 2 }, "messages": [{ "from": "primary", "to": "r1", "label": "log: price = 12" }, { "from": "primary", "to": "r2", "label": "log: price = 12 (slow link)" }], "states": { "r1": "price 12 (version 2)", "r2": "still price 10 (lagging)" } },
    { "narration": "A read lands on Replica 2 right now. It answers with the old price: a stale read caused by replication lag.", "meters": { "stale": 1 }, "messages": [{ "from": "client", "to": "r2", "label": "read price" }], "states": { "client": "read 10: STALE", "r2": "served 10 (primary has 12)" }, "highlight": ["r2"] },
    { "narration": "A moment later Replica 2 catches up. Reads from any node now agree again (eventual consistency).", "meters": { "has": 3 }, "states": { "r2": "price 12 (version 2)", "client": "all nodes agree" } },
    { "narration": "Disaster: the primary crashes.", "states": { "primary": "DOWN" }, "links": { "remove": [["primary", "r1"], ["primary", "r2"]] }, "highlight": ["primary"] },
    { "narration": "Failover: the most up-to-date replica is promoted to primary, and the other now follows it.", "states": { "r1": "PRIMARY now (version 2)", "r2": "follows Replica 1" }, "links": { "add": [["r1", "r2"]] }, "highlight": ["r1"] },
    { "narration": "The service stays up. The catch: a write the old primary had acknowledged but not yet sent would be gone. That is the price of asynchronous replication.", "states": { "client": "writes continue on the new primary" }, "highlight": ["client"] }
  ]
}
