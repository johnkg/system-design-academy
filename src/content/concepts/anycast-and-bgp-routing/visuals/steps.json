  "linkLabel": "BGP / traffic",
  "frames": [
    {
      "narration": "The service announces 192.0.2.0/23 from five cities, all with origin AS 64500 (NYC and LAX are drawn). Seattle's provider hears NYC from a customer (local-pref 200) and LAX only from a peer (100).",
      "messages": [
        {
          "from": "nyc",
          "to": "router",
          "label": "UPDATE /23"
        },
        {
          "from": "lax",
          "to": "router",
          "label": "UPDATE /23"
        }
      ],
      "states": {
        "router": "NYC: pref 200",
        "nyc": "AS 64500",
        "lax": "AS 64500"
      },
      "highlight": [
        "router"
      ]
    },
    {
      "narration": "A packet to 192.0.2.10 follows the best path. Local preference comes before path length and nothing measures RTT, so Seattle goes to New York (63 ms) although Los Angeles would be 28 ms away.",
      "messages": [
        {
          "from": "client",
          "to": "router",
          "label": "to 192.0.2.10"
        },
        {
          "from": "router",
          "to": "nyc",
          "label": "best path"
        }
      ],
      "states": {
        "client": "RTT 63 ms",
        "router": "picks NYC"
      },
      "highlight": [
        "nyc"
      ]
    },
    {
      "narration": "Short flows are unaffected by routing churn: a DNS query is one packet. A 10 minute download is one TCP connection that depends on every packet reaching the same server.",
      "messages": [
        {
          "from": "client",
          "to": "nyc",
          "label": "TCP stream"
        },
        {
          "from": "nyc",
          "to": "client",
          "label": "data"
        }
      ],
      "states": {
        "nyc": "holds the TCP state"
      }
    },
    {
      "narration": "The operator withdraws NYC for maintenance. The withdrawal spreads AS by AS and the network needs about 30 s (up to a few minutes) to settle. NYC keeps serving meanwhile.",
      "messages": [
        {
          "from": "operator",
          "to": "nyc",
          "label": "withdraw /23"
        },
        {
          "from": "nyc",
          "to": "router",
          "label": "WITHDRAW"
        }
      ],
      "states": {
        "router": "converging",
        "nyc": "draining"
      },
      "highlight": [
        "nyc"
      ]
    },
    {
      "narration": "Once the provider switches to LAX, reached through a peer with AS path 2002 2001 64500, the next segment lands on a server with no such connection and is answered with a RST. The download breaks. New short flows move without noticing.",
      "messages": [
        {
          "from": "client",
          "to": "router",
          "label": "next segment"
        },
        {
          "from": "router",
          "to": "lax",
          "label": "new best path"
        },
        {
          "from": "lax",
          "to": "client",
          "label": "RST"
        }
      ],
      "states": {
        "client": "RTT 28 ms",
        "lax": "no such connection",
        "nyc": "idle, can stop"
      },
      "highlight": [
        "lax"
      ]
    },
    {
      "narration": "A rogue AS announces 192.0.2.0/24. NYC is back, but longest-prefix match prefers a /24 over a /23 and AS path length does not matter: every network that accepts it sends traffic to the rogue AS.",
      "messages": [
        {
          "from": "attacker",
          "to": "router",
          "label": "UPDATE /24"
        },
        {
          "from": "client",
          "to": "attacker",
          "label": "traffic stolen"
        }
      ],
      "states": {
        "router": "/24 beats /23",
        "attacker": "AS 64499",
        "nyc": "back, /23 again"
      },
      "highlight": [
        "attacker"
      ]
    },
    {
      "narration": "A published ROA says only AS 64500 may originate 192.0.2.0/23 up to length /23. Routers doing RPKI validation mark the /24 invalid and drop it, so the legitimate /23 wins again. Networks that do not validate remain exposed.",
      "messages": [
        {
          "from": "attacker",
          "to": "router",
          "label": "UPDATE /24"
        },
        {
          "from": "router",
          "to": "nyc",
          "label": "back to /23"
        }
      ],
      "states": {
        "router": "ROV: invalid, drop",
        "client": "RTT 63 ms"
      },
      "highlight": [
        "router"
      ]
    },
    {
      "narration": "A 240 Gbps flood from a botnet spread over all regions is split by catchment, roughly 48 Gbps per site across the five sites, which each can absorb. The same flood from one region would hit one site only and saturate it.",
      "messages": [
        {
          "from": "attacker",
          "to": "nyc",
          "label": "~48 Gbps"
        },
        {
          "from": "attacker",
          "to": "lax",
          "label": "~48 Gbps"
        }
      ],
      "states": {
        "nyc": "absorbed",
        "lax": "absorbed",
        "client": "served"
      },
      "highlight": [
        "nyc",
        "lax"
      ]
    }
  ]
}
