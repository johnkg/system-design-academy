{
  "actors": [
    {
      "id": "client",
      "label": "Client",
      "role": "client",
      "x": 14,
      "y": 14
    },
    {
      "id": "agg",
      "label": "Account",
      "role": "aggregate",
      "x": 40,
      "y": 58
    },
    {
      "id": "store",
      "label": "Event store",
      "role": "store",
      "x": 78,
      "y": 24
    },
    {
      "id": "view",
      "label": "Balance view",
      "role": "view",
      "x": 80,
      "y": 88
    }
  ],
  "linkLabel": "feeds",
  "frames": [
    {
      "narration": "The account has no stored balance. The event store holds its history: Deposited 100, Withdrawn 30.",
      "states": {
        "store": "+100, -30"
      },
      "highlight": [
        "store"
      ]
    },
    {
      "narration": "A client asks to withdraw 50. The account first rebuilds its state by replaying the events: 100 minus 30 gives 70.",
      "messages": [
        {
          "from": "client",
          "to": "agg",
          "label": "command: withdraw 50"
        },
        {
          "from": "store",
          "to": "agg",
          "label": "replay events"
        }
      ],
      "states": {
        "agg": "balance = 70"
      }
    },
    {
      "narration": "The rule is satisfied (70 is at least 50), so the account decides an event happened.",
      "states": {
        "agg": "70 \u2265 50: allowed"
      },
      "highlight": [
        "agg"
      ]
    },
    {
      "narration": "The event is appended to the log. Nothing is updated in place: history only grows.",
      "messages": [
        {
          "from": "agg",
          "to": "store",
          "label": "append: Withdrawn 50"
        }
      ],
      "states": {
        "store": "+100, -30, -50"
      }
    },
    {
      "narration": "A projection listens to the log and updates a read-friendly view. The same events could feed a report, a search index or another service.",
      "messages": [
        {
          "from": "store",
          "to": "view",
          "label": "event 3"
        }
      ],
      "links": {
        "add": [
          [
            "store",
            "view"
          ]
        ]
      },
      "states": {
        "view": "balance: 20"
      }
    },
    {
      "narration": "A request that breaks a rule, such as withdrawing 500, is rejected. No event is recorded at all.",
      "messages": [
        {
          "from": "client",
          "to": "agg",
          "label": "command: withdraw 500"
        }
      ],
      "states": {
        "agg": "rejected: insufficient funds",
        "client": "error"
      }
    },
    {
      "narration": "To fix a mistake you never edit history. You append a compensating event, so the audit trail stays complete.",
      "messages": [
        {
          "from": "agg",
          "to": "store",
          "label": "append: Deposited 50 (reversal)"
        }
      ],
      "states": {
        "store": "+100, -30, -50, +50 (reversal)",
        "view": "balance: 70"
      }
    },
    {
      "narration": "With a long history, replaying everything is slow, so a snapshot of the state at event N is stored. Loading takes the snapshot plus only the newer events.",
      "states": {
        "agg": "snapshot at event 4 + later events"
      },
      "highlight": [
        "agg"
      ]
    }
  ]
}
