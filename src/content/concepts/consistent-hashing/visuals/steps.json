{
  "actors": [
    {
      "id": "client",
      "label": "Client",
      "role": "client",
      "x": 14,
      "y": 14
    },
    {
      "id": "ring",
      "label": "Hash ring",
      "role": "ring",
      "x": 46,
      "y": 52
    },
    {
      "id": "a",
      "label": "Server A",
      "role": "node",
      "x": 84,
      "y": 14
    },
    {
      "id": "b",
      "label": "Server B",
      "role": "node",
      "x": 84,
      "y": 50
    },
    {
      "id": "c",
      "label": "Server C",
      "role": "node",
      "x": 84,
      "y": 86
    }
  ],
  "linkLabel": "sits on the ring",
  "meters": [
    { "id": "srv", "label": "Servers on the ring", "max": 4, "start": 3 },
    { "id": "ring", "label": "Keys moved on the ring (about)", "unit": "%", "max": 100 },
    { "id": "mod", "label": "Keys moved with hash mod N (about)", "unit": "%", "max": 100 }
  ],
  "frames": [
    {
      "narration": "Three servers are hashed onto a ring. Each owns the stretch of ring leading up to its position.",
      "links": {
        "add": [
          [
            "ring",
            "a"
          ],
          [
            "ring",
            "b"
          ],
          [
            "ring",
            "c"
          ]
        ]
      },
      "states": {
        "ring": "hash space 0 to 2^32, wrapping"
      },
      "highlight": [
        "ring"
      ]
    },
    {
      "narration": "To find where a key lives, hash it onto the same ring.",
      "messages": [
        {
          "from": "client",
          "to": "ring",
          "label": "hash('user:42')"
        }
      ],
      "states": {
        "ring": "lands between A and B"
      }
    },
    {
      "narration": "Walk clockwise to the first server. That server owns the key.",
      "messages": [
        {
          "from": "ring",
          "to": "b",
          "label": "next clockwise: B"
        }
      ],
      "states": {
        "b": "owns user:42",
        "client": "send to Server B"
      }
    },
    {
      "narration": "Now add a fourth server, D. It is hashed onto the ring too, and lands in the stretch currently owned by C.",
      "meters": {
        "srv": 4
      },
      "states": {
        "ring": "D added"
      },
      "links": {
        "add": [
          [
            "ring",
            "c"
          ]
        ]
      },
      "highlight": [
        "ring"
      ]
    },
    {
      "narration": "D takes over only the keys between B and D. Keys owned by A, B and the rest of C do not move.",
      "meters": {
        "ring": 25
      },
      "states": {
        "c": "gives ~25% to D",
        "a": "unchanged",
        "b": "unchanged"
      },
      "highlight": [
        "c"
      ]
    },
    {
      "narration": "With hash mod N, going from 3 to 4 servers would have changed the owner of about 75 percent of all keys. Here it is about 25 percent.",
      "meters": {
        "ring": 25,
        "mod": 75
      },
      "states": {
        "ring": "moved ~25% (not ~75%)"
      },
      "highlight": [
        "ring"
      ]
    },
    {
      "narration": "If a server dies, its keys simply go to the next server clockwise. Everyone else keeps theirs.",
      "meters": {
        "srv": 3
      },
      "states": {
        "a": "DOWN",
        "b": "takes A's keys"
      },
      "highlight": [
        "a",
        "b"
      ]
    }
  ]
}
