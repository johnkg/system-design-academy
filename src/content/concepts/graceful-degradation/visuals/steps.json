{
  "actors": [
    {
      "id": "page",
      "label": "Page service",
      "role": "assembler",
      "x": 50,
      "y": 38
    },
    {
      "id": "product",
      "label": "Product",
      "role": "core",
      "x": 50,
      "y": 62
    },
    {
      "id": "reviews",
      "label": "Reviews",
      "role": "optional",
      "x": 18,
      "y": 14
    },
    {
      "id": "recs",
      "label": "Recommendations",
      "role": "optional",
      "x": 18,
      "y": 38
    },
    {
      "id": "inventory",
      "label": "Inventory",
      "role": "optional",
      "x": 50,
      "y": 14
    },
    {
      "id": "personal",
      "label": "Personalisation",
      "role": "optional",
      "x": 82,
      "y": 38
    },
    {
      "id": "cache",
      "label": "Stale cache / defaults",
      "role": "fallback",
      "x": 82,
      "y": 14
    }
  ],
  "frames": [
    {
      "narration": "A request for one product page. The page service fans out to 5 dependencies in parallel. Product is critical: no product, no page. The other four are optional and get a 300 ms timeout.",
      "messages": [
        {
          "from": "page",
          "to": "product",
          "label": "get product"
        },
        {
          "from": "page",
          "to": "reviews",
          "label": "get reviews"
        },
        {
          "from": "page",
          "to": "recs",
          "label": "get recs"
        },
        {
          "from": "page",
          "to": "inventory",
          "label": "get stock"
        },
        {
          "from": "page",
          "to": "personal",
          "label": "get profile"
        }
      ],
      "states": {
        "product": "critical, 2 s",
        "reviews": "optional, 300 ms",
        "recs": "optional, 300 ms",
        "inventory": "optional, 300 ms",
        "personal": "optional, 300 ms"
      }
    },
    {
      "narration": "Recommendations has a bad day: 2 s per call. Product, reviews, inventory and personalisation answer within 150 ms. The page is waiting on one box that is only decoration.",
      "messages": [
        {
          "from": "product",
          "to": "page",
          "label": "80 ms"
        },
        {
          "from": "reviews",
          "to": "page",
          "label": "60 ms"
        },
        {
          "from": "inventory",
          "to": "page",
          "label": "40 ms"
        },
        {
          "from": "personal",
          "to": "page",
          "label": "70 ms"
        }
      ],
      "states": {
        "recs": "slow: 2 s",
        "page": "waiting"
      },
      "highlight": [
        "recs"
      ]
    },
    {
      "narration": "At 300 ms the optional timeout fires. The page stops waiting for recommendations and records a failure for that one part. Without this timeout the whole page would take 2 s.",
      "states": {
        "page": "t = 300 ms",
        "recs": "timed out"
      },
      "highlight": [
        "page"
      ]
    },
    {
      "narration": "Fallback: the page asks the fallback store for generic bestsellers, a cached list refreshed hourly. This is a local read, about 5 ms. It is a cheap answer on purpose: a fallback that calls another busy system just moves the outage.",
      "messages": [
        {
          "from": "page",
          "to": "cache",
          "label": "bestsellers"
        },
        {
          "from": "cache",
          "to": "page",
          "label": "generic list"
        }
      ],
      "states": {
        "cache": "generic ranking"
      },
      "highlight": [
        "cache"
      ]
    },
    {
      "narration": "The page is served at 320 ms: full product, reviews, stock and profile, plus generic recommendations instead of personal ones. Most users see nothing wrong. A normal-looking page is the right result here.",
      "messages": [
        {
          "from": "page",
          "to": "page",
          "label": "200 degraded"
        }
      ],
      "states": {
        "page": "320 ms, degraded",
        "recs": "fallback"
      },
      "highlight": [
        "page"
      ]
    },
    {
      "narration": "The degradation must not be silent. The page emits a counter degraded_total{part=recs} and sets a response header. At 5% of pages degraded, an alert fires. A silent fallback hides the outage until revenue drops.",
      "states": {
        "page": "metric: recs 100%",
        "recs": "alert: degraded"
      },
      "highlight": [
        "page",
        "recs"
      ]
    },
    {
      "narration": "Next, reviews goes down and returns errors in 20 ms. Reviews is optional, so the page serves the last cached reviews (up to 24 h old) and shows the section with an 'as of yesterday' hint instead of failing.",
      "messages": [
        {
          "from": "reviews",
          "to": "page",
          "label": "error 20 ms"
        },
        {
          "from": "page",
          "to": "cache",
          "label": "stale reviews"
        },
        {
          "from": "cache",
          "to": "page",
          "label": "reviews, 6 h old"
        }
      ],
      "states": {
        "reviews": "down",
        "page": "degraded: stale"
      },
      "highlight": [
        "reviews"
      ]
    },
    {
      "narration": "Finally the product service fails. Here there is nothing to degrade to: the page is about the product. The page returns a fast error (503 with Retry-After) within 40 ms instead of rendering an empty shell. A critical failure fails the page; graceful degradation is only for the optional parts.",
      "messages": [
        {
          "from": "product",
          "to": "page",
          "label": "error 20 ms"
        },
        {
          "from": "page",
          "to": "page",
          "label": "503 Retry-After"
        }
      ],
      "states": {
        "product": "down",
        "page": "error, 40 ms"
      },
      "highlight": [
        "product"
      ]
    }
  ]
}
