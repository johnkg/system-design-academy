{
  "actors": [
    {
      "id": "browser",
      "label": "Browser",
      "role": "client",
      "x": 14,
      "y": 50
    },
    {
      "id": "resolver",
      "label": "Recursive resolver",
      "role": "resolver",
      "x": 50,
      "y": 50
    },
    {
      "id": "root",
      "label": "Root server",
      "role": "authority",
      "x": 86,
      "y": 18
    },
    {
      "id": "tld",
      "label": ".com server",
      "role": "authority",
      "x": 86,
      "y": 49
    },
    {
      "id": "auth",
      "label": "example.com server",
      "role": "authority",
      "x": 86,
      "y": 80
    }
  ],
  "frames": [
    {
      "narration": "The browser needs the IP address of shop.example.com. It checks its own cache and the operating system's cache first. Neither has it.",
      "states": {
        "browser": "cache miss"
      }
    },
    {
      "narration": "It asks the recursive resolver, a server run by the internet provider or a public service.",
      "messages": [
        {
          "from": "browser",
          "to": "resolver",
          "label": "shop.example.com?"
        }
      ],
      "states": {
        "resolver": "cache miss too"
      }
    },
    {
      "narration": "The resolver asks a root server. The root does not know the address, but it knows who handles .com.",
      "messages": [
        {
          "from": "resolver",
          "to": "root",
          "label": "shop.example.com?"
        },
        {
          "from": "root",
          "to": "resolver",
          "label": "ask the .com servers"
        }
      ],
      "states": {
        "root": "points to .com"
      }
    },
    {
      "narration": "The resolver asks a .com server, which knows which servers are responsible for example.com.",
      "messages": [
        {
          "from": "resolver",
          "to": "tld",
          "label": "shop.example.com?"
        },
        {
          "from": "tld",
          "to": "resolver",
          "label": "ask example.com's servers"
        }
      ],
      "states": {
        "tld": "points to example.com"
      }
    },
    {
      "narration": "Finally the authoritative server for example.com answers with the real record: 203.0.113.7, with a TTL of 300 seconds.",
      "messages": [
        {
          "from": "resolver",
          "to": "auth",
          "label": "shop.example.com?"
        },
        {
          "from": "auth",
          "to": "resolver",
          "label": "203.0.113.7, TTL 300 s"
        }
      ],
      "states": {
        "auth": "holds the truth"
      }
    },
    {
      "narration": "The resolver caches the answer for 300 seconds and returns it. The browser caches it too and can finally connect.",
      "messages": [
        {
          "from": "resolver",
          "to": "browser",
          "label": "203.0.113.7"
        }
      ],
      "states": {
        "resolver": "cached for 300 s",
        "browser": "connects to 203.0.113.7"
      },
      "highlight": [
        "browser"
      ]
    },
    {
      "narration": "The next person on the same resolver asks for the same name and gets the cached answer in a few milliseconds. When the TTL runs out, the resolver will ask again.",
      "messages": [
        {
          "from": "browser",
          "to": "resolver",
          "label": "shop.example.com?"
        },
        {
          "from": "resolver",
          "to": "browser",
          "label": "cached answer"
        }
      ],
      "states": {
        "resolver": "cache hit"
      }
    }
  ]
}
