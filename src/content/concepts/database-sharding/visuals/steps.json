{
  "actors": [
    {
      "id": "app",
      "label": "Application",
      "role": "app",
      "x": 14,
      "y": 14
    },
    {
      "id": "router",
      "label": "Shard router",
      "role": "router",
      "x": 46,
      "y": 62
    },
    {
      "id": "s1",
      "label": "Shard 1",
      "role": "shard",
      "x": 84,
      "y": 14
    },
    {
      "id": "s2",
      "label": "Shard 2",
      "role": "shard",
      "x": 84,
      "y": 50
    },
    {
      "id": "s3",
      "label": "Shard 3",
      "role": "shard",
      "x": 84,
      "y": 86
    }
  ],
  "linkLabel": "owns a slice of the data",
  "meters": [
    { "id": "touch", "label": "Shards touched by this query", "max": 3, "warnAt": 3 },
    { "id": "q", "label": "Queries run on shards so far", "max": 5 },
    { "id": "mv", "label": "Keys that must move after adding a shard (%)", "max": 100, "warnAt": 50 }
  ],
  "frames": [
    {
      "narration": "The users table is split across three databases by user id. Each shard holds about a third of the rows.",
      "links": {
        "add": [
          [
            "router",
            "s1"
          ],
          [
            "router",
            "s2"
          ],
          [
            "router",
            "s3"
          ]
        ]
      },
      "states": {
        "router": "shard = hash(user_id) mod 3"
      },
      "highlight": [
        "router"
      ]
    },
    {
      "narration": "The application wants user 42. It asks the router, which knows the sharding rule.",
      "messages": [
        {
          "from": "app",
          "to": "router",
          "label": "get user 42"
        }
      ],
      "states": {
        "router": "42 belongs to Shard 3 (example)"
      }
    },
    {
      "narration": "The router sends the query to exactly one shard. The other two are not touched.",
      "meters": { "touch": 1, "q": 1 },
      "messages": [
        {
          "from": "router",
          "to": "s3",
          "label": "get user 42"
        }
      ],
      "states": {
        "s3": "found user 42"
      }
    },
    {
      "narration": "Another user lives somewhere else. Different key, different shard, same routing rule.",
      "meters": { "touch": 1, "q": 2 },
      "messages": [
        {
          "from": "app",
          "to": "router",
          "label": "get user 7"
        },
        {
          "from": "router",
          "to": "s1",
          "label": "get user 7"
        }
      ],
      "states": {
        "s1": "found user 7",
        "router": "7 belongs to Shard 1 (example)"
      }
    },
    {
      "narration": "A query without the shard key is the weak spot: 'how many users live in France?' could be on any shard.",
      "meters": { "touch": 3 },
      "messages": [
        {
          "from": "app",
          "to": "router",
          "label": "count users in France"
        }
      ],
      "states": {
        "router": "no key: ask every shard"
      }
    },
    {
      "narration": "Scatter-gather: the router fans the query out to all shards and merges the partial answers.",
      "meters": { "q": 5 },
      "messages": [
        {
          "from": "router",
          "to": "s1",
          "label": "count"
        },
        {
          "from": "router",
          "to": "s2",
          "label": "count"
        },
        {
          "from": "router",
          "to": "s3",
          "label": "count"
        }
      ],
      "states": {
        "s1": "partial: 110k",
        "s2": "partial: 95k",
        "s3": "partial: 115k"
      }
    },
    {
      "narration": "The merged answer returns: 320k. It works, but it cost three queries and waits for the slowest shard.",
      "messages": [
        {
          "from": "router",
          "to": "app",
          "label": "320k"
        }
      ],
      "states": {
        "app": "total: 320k"
      }
    },
    {
      "narration": "Later the data grows and a fourth shard is added. With plain 'hash mod N', about 75 percent of all keys now map to a different shard and must move. Consistent hashing exists to avoid this.",
      "meters": { "mv": 75 },
      "states": {
        "router": "mod 3 to mod 4: ~75% of keys move"
      },
      "highlight": [
        "router"
      ]
    }
  ]
}
