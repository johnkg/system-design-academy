{
  "actors": [
    { "id": "server", "label": "Your server", "role": "app", "x": 10, "y": 50 },
    { "id": "platform", "label": "Push service", "role": "platform", "x": 36, "y": 50 },
    { "id": "device", "label": "Phone", "role": "device", "x": 62, "y": 25 },
    { "id": "app", "label": "App", "role": "client", "x": 88, "y": 25 },
    { "id": "api", "label": "Your API", "role": "api", "x": 62, "y": 80 }
  ],
  "linkLabel": "push",
  "meters": [
    { "id": "held", "label": "Messages held by the platform", "max": 5, "start": 0 },
    { "id": "dropped", "label": "Dropped (expired or replaced)", "max": 5, "start": 0, "warnAt": 1 }
  ],
  "frames": [
    {
      "narration": "The app registers for push and gets a device token from the platform. It sends the token to your server, which stores it. The server never talks to the phone directly.",
      "messages": [{ "from": "app", "to": "server", "label": "device token" }],
      "states": { "server": "token stored", "device": "online" },
      "links": { "add": [["server", "platform"], ["platform", "device"], ["device", "app"]] },
      "highlight": ["server", "app"]
    },
    {
      "narration": "A score changes. The server sends the payload with the token to the platform. The platform delivers it over the connection the phone already holds open.",
      "messages": [{ "from": "server", "to": "platform", "label": "score 1-0" }, { "from": "platform", "to": "device", "label": "score 1-0" }],
      "states": { "platform": "accepted", "device": "shown" },
      "highlight": ["platform", "device"]
    },
    {
      "narration": "The phone goes offline, in a tunnel or in flight mode. The platform keeps accepting messages but has nowhere to send them, so it holds them.",
      "messages": [{ "from": "server", "to": "platform", "label": "score 2-0" }],
      "states": { "device": "offline", "platform": "holding 1" },
      "links": { "remove": [["platform", "device"]] },
      "highlight": ["device", "platform"],
      "meters": { "held": 1 }
    },
    {
      "narration": "More scores arrive with the same collapse key. Each replaces the pending one, so the platform still holds a single message: the newest score.",
      "messages": [{ "from": "server", "to": "platform", "label": "score 3-0" }, { "from": "server", "to": "platform", "label": "score 3-1" }],
      "states": { "platform": "holding 1 (3-1)" },
      "highlight": ["platform"],
      "meters": { "held": 1, "dropped": 2 }
    },
    {
      "narration": "A chat message was sent with a time to live of 2 hours. The phone stays offline longer than that, so the platform drops the message without telling anyone.",
      "states": { "platform": "chat expired", "server": "sent, never failed" },
      "highlight": ["platform"],
      "meters": { "held": 1, "dropped": 3 }
    },
    {
      "narration": "The phone reconnects. The platform delivers what it still holds: the newest score. The expired chat message does not come.",
      "messages": [{ "from": "platform", "to": "device", "label": "score 3-1" }],
      "states": { "device": "online", "platform": "queue empty" },
      "links": { "add": [["platform", "device"]] },
      "highlight": ["device"],
      "meters": { "held": 0 }
    },
    {
      "narration": "Because delivery is best effort, the app fetches from your API when it opens. The dropped chat message is there, so nothing critical was lost.",
      "messages": [{ "from": "app", "to": "api", "label": "what did I miss?" }, { "from": "api", "to": "app", "label": "chat + scores" }],
      "states": { "app": "up to date" },
      "links": { "add": [["app", "api"]] },
      "highlight": ["app", "api"]
    },
    {
      "narration": "One user uninstalls the app. The next send to that token is answered with 'invalid token'. The server deletes the token, instead of sending to it for every future notification.",
      "messages": [{ "from": "server", "to": "platform", "label": "send to old token" }, { "from": "platform", "to": "server", "label": "invalid token" }],
      "states": { "server": "token deleted" },
      "highlight": ["server", "platform"]
    }
  ]
}
