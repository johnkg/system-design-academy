{
  "actors": [
    { "id": "caller", "label": "Checkout", "role": "caller", "x": 14, "y": 50 },
    { "id": "breaker", "label": "Circuit breaker", "role": "breaker", "x": 50, "y": 50 },
    { "id": "dep", "label": "Payment API", "role": "dependency", "x": 86, "y": 50 }
  ],
  "meters": [
    { "id": "fails", "label": "Failures in a row", "max": 3, "warnAt": 3 },
    { "id": "wait", "label": "Wait for the customer", "unit": " s", "max": 30, "warnAt": 30 }
  ],
  "frames": [
    { "narration": "The breaker is closed: calls pass through. It trips after 3 failures in a row.", "messages": [{ "from": "caller", "to": "breaker", "label": "charge" }, { "from": "breaker", "to": "dep", "label": "charge" }], "states": { "breaker": "CLOSED" } },
    { "narration": "The payment provider starts failing. Each failed call is slow, and the breaker counts it.", "messages": [{ "from": "dep", "to": "breaker", "label": "timeout" }], "states": { "breaker": "CLOSED, 2 fails", "dep": "failing" }, "highlight": ["dep"], "meters": { "fails": 2, "wait": 30 } },
    { "narration": "A third failure reaches the threshold. The breaker trips to OPEN.", "messages": [{ "from": "dep", "to": "breaker", "label": "timeout" }], "states": { "breaker": "OPEN", "dep": "failing" }, "highlight": ["breaker"], "meters": { "fails": 3 } },
    { "narration": "The next checkout is rejected immediately by the breaker. The payment API is not called, so there is no 30 second wait and no thread is held.", "messages": [{ "from": "caller", "to": "breaker", "label": "charge" }, { "from": "breaker", "to": "caller", "label": "fail fast" }], "states": { "caller": "fails fast", "breaker": "OPEN" }, "meters": { "wait": 0 } },
    { "narration": "While open, the failing service gets no traffic at all. This is its chance to recover.", "states": { "breaker": "OPEN", "dep": "recovering" }, "highlight": ["dep"] },
    { "narration": "After the cool-down, the breaker goes HALF-OPEN and lets exactly one trial call through.", "messages": [{ "from": "breaker", "to": "dep", "label": "probe call" }], "states": { "breaker": "HALF-OPEN" } },
    { "narration": "The probe succeeds, so the breaker closes and normal traffic resumes. Had the probe failed, it would have re-opened and waited again.", "messages": [{ "from": "dep", "to": "breaker", "label": "ok" }, { "from": "breaker", "to": "caller", "label": "ok" }], "states": { "breaker": "CLOSED", "dep": "healthy" }, "meters": { "fails": 0 } }
  ]
}
