{
  "actors": [
    { "id": "app", "label": "Mobile app", "role": "client", "x": 14, "y": 50 },
    { "id": "gw", "label": "API gateway", "role": "gateway", "x": 50, "y": 50 },
    { "id": "users", "label": "User service", "role": "service", "x": 86, "y": 16 },
    { "id": "orders", "label": "Order service", "role": "service", "x": 86, "y": 50 },
    { "id": "pay", "label": "Payment service", "role": "service", "x": 86, "y": 84 }
  ],
  "meters": [
    { "id": "stage", "label": "Gateway stages completed", "max": 3 },
    { "id": "ok", "label": "Services working normally", "max": 3, "start": 3, "good": "high", "warnAt": 2 },
    { "id": "log", "label": "Requests logged at the gateway", "max": 1 }
  ],
  "frames": [
    {
      "narration": "The app knows one address, api.shop.com. It sends a request with its access token.",
      "messages": [{ "from": "app", "to": "gw", "label": "GET /orders/42 + token" }],
      "states": { "gw": "request arrives" }
    },
    {
      "narration": "Stage 1: the gateway verifies the token. This is done once here, not separately in every service.",
      "meters": { "stage": 1 },
      "states": { "gw": "token valid" },
      "highlight": ["gw"]
    },
    {
      "narration": "Stage 2: it checks the caller's rate limit. A caller over the limit would get 429 right here, and no service would see the request.",
      "meters": { "stage": 2 },
      "states": { "gw": "within rate limit" },
      "highlight": ["gw"]
    },
    {
      "narration": "Stage 3: it routes by path. /orders goes to the order service, /users to the user service and /pay to the payment service.",
      "meters": { "stage": 3 },
      "messages": [{ "from": "gw", "to": "orders", "label": "GET /orders/42 (internal)" }],
      "states": { "orders": "handles it" }
    },
    {
      "narration": "The answer returns through the gateway, which adds logging and metrics for every request in one place.",
      "meters": { "log": 1 },
      "messages": [{ "from": "orders", "to": "gw", "label": "order 42" }, { "from": "gw", "to": "app", "label": "200 order 42" }],
      "states": { "gw": "logged" }
    },
    {
      "narration": "Now the payment service is slow. The gateway has a timeout and a circuit breaker for it, so it answers quickly instead of hanging.",
      "messages": [{ "from": "app", "to": "gw", "label": "POST /pay" }, { "from": "gw", "to": "app", "label": "503 try later" }],
      "states": { "pay": "slow", "gw": "breaker open for pay" },
      "highlight": ["pay"]
    },
    {
      "narration": "Orders and users keep working normally. The gateway contained the failure at the edge, and clients still see one stable address.",
      "meters": { "ok": 2 },
      "states": { "users": "fine", "orders": "fine" },
      "highlight": ["users", "orders"]
    }
  ]
}
