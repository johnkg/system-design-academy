{
  "actors": [
    { "id": "client", "label": "Client", "role": "client", "x": 12, "y": 50 },
    { "id": "limiter", "label": "Rate limiter", "role": "limiter", "x": 46, "y": 50 },
    { "id": "api", "label": "API", "role": "service", "x": 86, "y": 50 }
  ],
  "meters": [
    { "id": "tok", "label": "Tokens in the bucket", "max": 3, "start": 3, "warnAt": 0, "good": "high" },
    { "id": "ok", "label": "Requests allowed", "max": 5 },
    { "id": "no", "label": "Requests rejected (429)", "max": 3 }
  ],
  "frames": [
    { "narration": "A client's bucket holds 3 tokens and refills 1 token per second. The first request arrives.", "messages": [{ "from": "client", "to": "limiter", "label": "request 1" }], "states": { "limiter": "bucket: 3 tokens" } },
    { "narration": "The limiter takes one token and lets the request through to the API.", "messages": [{ "from": "limiter", "to": "api", "label": "allowed" }], "states": { "limiter": "bucket: 2 tokens", "api": "handling request 1" }, "meters": { "tok": 2, "ok": 1 } },
    { "narration": "The client sends a quick burst of two more. Both are allowed because the bucket still has tokens. This is why a bucket permits short bursts.", "messages": [{ "from": "client", "to": "limiter", "label": "requests 2 and 3" }], "states": { "limiter": "bucket: 0 tokens", "api": "handling 2 and 3" }, "meters": { "tok": 0, "ok": 3 } },
    { "narration": "A fourth request arrives straight away. The bucket is empty.", "messages": [{ "from": "client", "to": "limiter", "label": "request 4" }], "states": { "limiter": "bucket: 0 tokens" }, "highlight": ["limiter"] },
    { "narration": "The limiter rejects it with 429 and Retry-After: 1. The API never sees the request, so no work is wasted.", "messages": [{ "from": "limiter", "to": "client", "label": "429, retry after 1 s" }], "states": { "limiter": "rejects, API untouched" }, "meters": { "no": 1 } },
    { "narration": "One second passes and one token drips back into the bucket.", "states": { "limiter": "bucket: 1 token" }, "highlight": ["limiter"], "meters": { "tok": 1 } },
    { "narration": "The client waited as told, so its retry is allowed. Over time it can average one request per second, with bursts of up to three.", "messages": [{ "from": "client", "to": "limiter", "label": "retry request 4" }, { "from": "limiter", "to": "api", "label": "allowed" }], "states": { "limiter": "bucket: 0 tokens", "api": "handling request 4" }, "meters": { "tok": 0, "ok": 4 } }
  ]
}
