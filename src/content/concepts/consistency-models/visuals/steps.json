{
  "actors": [
    {
      "id": "user",
      "label": "User",
      "role": "user",
      "x": 14,
      "y": 16
    },
    {
      "id": "primary",
      "label": "Primary",
      "role": "primary",
      "x": 46,
      "y": 56
    },
    {
      "id": "r1",
      "label": "Replica 1 (fast)",
      "role": "replica",
      "x": 84,
      "y": 18
    },
    {
      "id": "r2",
      "label": "Replica 2 (slow)",
      "role": "replica",
      "x": 84,
      "y": 82
    }
  ],
  "linkLabel": "replicates to",
  "frames": [
    {
      "narration": "A post has 2 comments on every node. Replica 2 is a slow link and takes longer to receive changes.",
      "links": {
        "add": [
          [
            "primary",
            "r1"
          ],
          [
            "primary",
            "r2"
          ]
        ]
      },
      "states": {
        "primary": "2 comments",
        "r1": "2 comments",
        "r2": "2 comments"
      }
    },
    {
      "narration": "The user posts a third comment. The primary has it at once.",
      "messages": [
        {
          "from": "user",
          "to": "primary",
          "label": "add comment 3"
        }
      ],
      "states": {
        "primary": "3 comments"
      }
    },
    {
      "narration": "Replica 1 receives the change quickly. Replica 2 has not got it yet.",
      "messages": [
        {
          "from": "primary",
          "to": "r1",
          "label": "comment 3"
        }
      ],
      "states": {
        "r1": "3 comments",
        "r2": "still 2 comments"
      }
    },
    {
      "narration": "Eventual consistency: the user refreshes and the read lands on slow Replica 2. Their own comment is missing.",
      "messages": [
        {
          "from": "user",
          "to": "r2",
          "label": "refresh"
        }
      ],
      "states": {
        "user": "sees 2: my comment vanished!"
      },
      "highlight": [
        "user"
      ]
    },
    {
      "narration": "Read-your-writes fixes this: because this user just wrote, their reads go to the primary or a replica known to be up to date.",
      "messages": [
        {
          "from": "user",
          "to": "primary",
          "label": "refresh (routed to primary)"
        }
      ],
      "states": {
        "user": "sees 3: my own write is visible"
      }
    },
    {
      "narration": "Another refresh with plain eventual consistency hits Replica 2 again, then Replica 1. The count can go 2, then 3, then 2: time seems to run backwards.",
      "messages": [
        {
          "from": "user",
          "to": "r1",
          "label": "refresh"
        }
      ],
      "states": {
        "user": "2, then 3, then back to 2?"
      }
    },
    {
      "narration": "Monotonic reads stops that: once the user has seen 3, they are only sent to nodes that have at least 3.",
      "states": {
        "user": "never goes backwards"
      },
      "highlight": [
        "user"
      ]
    },
    {
      "narration": "Strong consistency would send every read to the primary (or a quorum): always the latest value, at the cost of speed and availability.",
      "states": {
        "primary": "serves all reads: always current"
      },
      "highlight": [
        "primary"
      ]
    }
  ]
}
