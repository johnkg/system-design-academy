---
import '../styles/global.css';
import { languages, defaultLanguage } from '../languages.config';
import { url } from '../lib';
import LangSwitch from '../components/LangSwitch.astro';

interface Props { title: string; description?: string }
const path = Astro.url.pathname.replace(/\/$/, '');
const onCompare = /\/compare(-concepts)?$/.test(path);
const onStudies = /\/case-studies(\/|$)/.test(Astro.url.pathname);
const { title, description = 'Learn system design concepts and design patterns visually, with simulations and code.' } = Astro.props;

// Show only the panel matching the chosen language. Generated from config so new languages need no CSS edits.
const langCss = '.lang-panel{display:none}\n' + languages
  .map((l, i) => `html[data-lang='${l.id}'] .lang-panel[data-lang='${l.id}']{display:block}\nhtml[data-lang='${l.id}'] .seg{--i:${i}}`)
  .join('\n');
---
<!doctype html>
<html lang="en" data-lang={defaultLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <style set:html={langCss}></style>
    <script is:inline define:vars={{ ids: languages.map((l) => l.id), fallback: defaultLanguage }}>
      // Runs before paint so the saved language and theme never flash.
      var root = document.documentElement;
      try {
        var lang = localStorage.getItem('lang');
        root.dataset.lang = ids.indexOf(lang) >= 0 ? lang : fallback;
        var theme = localStorage.getItem('theme');
        if (!theme) theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.dataset.theme = theme;
      } catch (e) { root.dataset.theme = 'light'; }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <div class="left">
          <a class="brand" href={url('')}>System Design Academy</a>
          <nav class="main-nav" aria-label="Main">
            <a href={url('')} aria-current={onCompare || onStudies ? undefined : 'page'}>Catalog</a>
            <a href={url('case-studies/')} aria-current={onStudies ? 'page' : undefined}>Case studies</a>
            <a href={url('compare/')} aria-current={onCompare ? 'page' : undefined}>Compare</a>
          </nav>
        </div>
        <div class="controls">
          <LangSwitch />
          <button class="btn" id="theme-toggle" aria-label="Dark mode" aria-pressed="false">◐</button>
        </div>
      </div>
    </header>
    <main class="wrap" id="main" tabindex="-1"><slot /></main>
    <footer class="wrap foot">Built with Astro. Samples are static; every language implements the same scenario.</footer>
    <script is:inline>
      var root = document.documentElement;
      function sync() {
        document.querySelectorAll('[data-set-lang]').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.dataset.setLang === root.dataset.lang));
        });
      }
      document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-set-lang]');
        if (b) {
          root.dataset.lang = b.dataset.setLang;
          try { localStorage.setItem('lang', b.dataset.setLang); } catch (err) {}
          sync();
        }
        if (e.target.closest('#theme-toggle')) {
          root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('theme', root.dataset.theme); } catch (err) {}
          syncTheme();
        }
      });
      function syncTheme() { document.getElementById('theme-toggle').setAttribute('aria-pressed', String(root.dataset.theme === 'dark')); }
      syncTheme();

      // Playgrounds and animations rebuild their buttons or disable the one just pressed.
      // If that drops keyboard focus to <body>, put it back on the equivalent control (or the region).
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('button');
        var zone = b && b.closest('.playground, [data-player]');
        if (!zone) return;
        var label = b.textContent.trim();
        var index = Array.prototype.indexOf.call(zone.querySelectorAll('button'), b);
        setTimeout(function () {
          var a = document.activeElement;
          if (a && a !== document.body && zone.contains(a)) return;
          if (a && a !== document.body) return; // focus moved somewhere deliberate
          var all = Array.prototype.slice.call(zone.querySelectorAll('button'));
          var t = all.filter(function (x) { return !x.disabled && x.textContent.trim() === label; })[0] || all[index];
          if (t && !t.disabled) t.focus({ preventScroll: true });
          if (document.activeElement === document.body || !document.activeElement) { zone.setAttribute('tabindex', '-1'); zone.focus({ preventScroll: true }); }
        }, 80);
      }, true); // capture phase: runs before the handler that may remove the pressed button
      sync();
    </script>
  </body>
</html>

<style is:global>
  .site-header { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 10px; padding-bottom: 10px; flex-wrap: wrap; }
  .brand { font-weight: 700; color: var(--text); text-decoration: none; }
  .left { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .main-nav { display: flex; gap: 4px; }
  @media (max-width: 640px) {
    .bar { display: grid; grid-template-columns: 1fr auto; gap: 6px 8px; }
    .left { display: contents; }
    .brand { grid-column: 1; grid-row: 1; white-space: nowrap; font-size: .92rem; }
    .controls { grid-column: 2; grid-row: 1; }
    .main-nav { grid-column: 1 / -1; grid-row: 2; }
  }
  .main-nav a { padding: 4px 10px; border-radius: 999px; color: var(--muted); text-decoration: none; font-size: .92rem; }
  .main-nav a:hover { background: var(--surface-2); color: var(--text); }
  .main-nav a[aria-current='page'] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .controls, .langs { display: flex; gap: 6px; align-items: center; }
  .foot { color: var(--muted); font-size: .85rem; padding-top: 3rem; padding-bottom: 3rem; }
</style>
