---
import '../styles/global.css';
import { languages, defaultLanguage } from '../languages.config';
import { url } from '../lib';
import LangMenu from '../components/LangMenu.astro';

interface Props { title: string; description?: string }
const path = Astro.url.pathname.replace(/\/$/, '');
const onCompare = /\/compare(-concepts)?$/.test(path);
const onStudies = /\/case-studies(\/|$)/.test(Astro.url.pathname);
// Absolute URLs need the deployed site address; local builds without SITE simply omit them.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(url('og.png'), Astro.site).href : undefined;
const onPractice = /\/(practice|paths|review|progress|interview|interview-guide|map|cheatsheets(\/[a-z]+)?)$/.test(path);
const onSearch = /\/search$/.test(path);
const onHome = path === url('').replace(/\/$/, '');
// Icons are drawn only in the phone tab bar; on wider screens the nav shows the words alone.
const nav = [
  { label: 'Learn', href: url(''), on: onHome || /\/(concepts|patterns)\//.test(Astro.url.pathname), icon: '<path d="M4 5h16M4 12h16M4 19h10" />' },
  { label: 'Case studies', href: url('case-studies/'), on: onStudies, icon: '<rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 9v11" />' },
  { label: 'Practice', href: url('practice/'), on: onPractice, icon: '<path d="M9 11l3 3 8-8" /><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9" />' },
  { label: 'Compare', href: url('compare/'), on: onCompare, icon: '<path d="M8 3v18M16 3v18M3 8h5M16 16h5" />' },
];
const { title, description = 'Learn system design concepts and design patterns visually, with simulations and code.' } = Astro.props;

// Self-hosted variable fonts (latin subset, SIL OFL; licences in public/fonts). Declared here so the URLs follow BASE.
const fontRange = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontCss = [['IBM Plex Sans', 'ibm-plex-sans-latin-wght.woff2', '100 700'], ['JetBrains Mono', 'jetbrains-mono-latin-wght.woff2', '100 800']]
  .map(([family, file, weight]) => `@font-face{font-family:'${family}';font-style:normal;font-weight:${weight};font-display:swap;src:url(${url(`fonts/${file}`)}) format('woff2');unicode-range:${fontRange}}`)
  .join('\n');

// Show only the panel matching the chosen language. Generated from config so new languages need no CSS edits.
const langCss = '.lang-panel{display:none}\n' + languages
  .map((l, i) => `html[data-lang='${l.id}'] .lang-panel[data-lang='${l.id}']{display:block}\nhtml[data-lang='${l.id}'] .seg{--i:${i}}`)
  .join('\n');
---
<!doctype html>
<html lang="en" data-lang={defaultLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="System Design Academy" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="System Design Academy: system design, seen not memorised." />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={url('icon-192.png')} />
    <meta name="theme-color" content="#1d4ed8" />
    <link rel="preload" href={url('fonts/ibm-plex-sans-latin-wght.woff2')} as="font" type="font/woff2" crossorigin />
    <style set:html={fontCss}></style>
    <style set:html={langCss}></style>
    <script is:inline define:vars={{ ids: languages.map((l) => l.id), fallback: defaultLanguage }}>
      // Runs before paint so the saved language and theme never flash.
      var root = document.documentElement;
      try {
        var lang = localStorage.getItem('lang');
        root.dataset.lang = ids.indexOf(lang) >= 0 ? lang : fallback;
        var theme = localStorage.getItem('theme');
        if (!theme) theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.dataset.theme = theme;
      } catch (e) { root.dataset.theme = 'light'; }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url('')}>
          <svg class="mark" width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="9" height="9" rx="2" /><rect x="17" y="2" width="9" height="9" rx="2" /><rect x="9.5" y="17" width="9" height="9" rx="2" /><path d="M11 6.5h6M6.5 11v4.5h3M21.5 11v4.5h-3" /></svg>
          <span class="brand-name">System Design Academy</span>
        </a>
        <nav class="main-nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.on ? 'page' : undefined}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={n.icon} /><span>{n.label}</span></a>
          ))}
        </nav>
        <div class="controls">
          <a class="btn search-btn" href={url('search/')} aria-current={onSearch ? 'page' : undefined}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <span class="search-label">Search</span><kbd class="kbd" aria-hidden="true">/</kbd>
          </a>
          <LangMenu />
          <button class="btn icon-btn" id="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false">
            <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
            <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </div>
      </div>
    </header>
    <main class="wrap" id="main" tabindex="-1"><slot /></main>
    <footer class="site-foot">
      <div class="wrap foot">
        <p>Works offline once visited. Progress, notes and review history never leave this browser. Every language implements the same scenario.</p>
        <p class="foot-links"><a href={url('whats-new/')}>What's new</a><a href={url('cheatsheets/')}>Cheat sheets</a><a href={url('map/')}>Concept map</a><a href={url('progress/')}>My progress</a></p>
      </div>
    </footer>
    <script is:inline>
      // Progress lives only in this browser (localStorage); nothing is sent anywhere. Keys look like "concepts/caching".
      (function () {
        var KEY = 'sda-progress';
        var done = [];
        function clean(raw) { return Array.isArray(raw) ? raw.filter(function (k) { return typeof k === 'string'; }) : []; }
        function save() { try { localStorage.setItem(KEY, JSON.stringify(done)); } catch (e) {} }
        try { done = clean(JSON.parse(localStorage.getItem(KEY) || '[]')); } catch (e) {}
        function has(k) { return done.indexOf(k) >= 0; }
        function render() {
          document.querySelectorAll('[data-done-toggle]').forEach(function (b) { b.setAttribute('aria-pressed', String(has(b.dataset.key))); });
          document.querySelectorAll('[data-card-key]').forEach(function (c) {
            var on = has(c.dataset.cardKey);
            c.classList.toggle('is-done', on);
            var flag = c.querySelector('.done-flag');
            if (on && !flag) { flag = document.createElement('span'); flag.className = 'done-flag'; flag.textContent = 'Done'; c.appendChild(flag); }
            if (!on && flag) flag.remove();
          });
          document.querySelectorAll('[data-path]').forEach(function (p) {
            var items = Array.prototype.slice.call(p.querySelectorAll('[data-card-key]'));
            var n = items.filter(function (i) { return has(i.dataset.cardKey); }).length;
            var out = p.querySelector('[data-path-count]');
            if (out) out.textContent = n + ' of ' + items.length + ' done';
            var bar = p.querySelector('[data-path-bar]');
            if (bar) bar.style.width = (items.length ? Math.round(100 * n / items.length) : 0) + '%';
            var next = items.filter(function (i) { return !has(i.dataset.cardKey); })[0];
            items.forEach(function (i) { i.classList.toggle('is-next', i === next); });
          });
          document.dispatchEvent(new CustomEvent('sda-progress'));
        }
        window.sdaProgress = { has: has, list: function () { return done.slice(); } };
        document.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('[data-done-toggle]');
          if (!b) return;
          var k = b.dataset.key, i = done.indexOf(k);
          if (i >= 0) done.splice(i, 1); else done.push(k);
          save(); render();
        });
        window.addEventListener('storage', function (e) {
          if (e.key !== KEY) return;
          try { done = clean(JSON.parse(e.newValue || '[]')); } catch (err) { done = []; }
          render();
        });
        render();
      })();
    </script>
    <script is:inline define:vars={{ swUrl: url('sw.js'), swScope: url('') }}>
      // Offline support: register the service worker, then hand it the files this page already loaded so it opens offline next time.
      if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost' || location.hostname === '127.0.0.1')) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register(swUrl, { scope: swScope }).then(function (reg) {
            return navigator.serviceWorker.ready.then(function () {
              var urls = performance.getEntriesByType('resource').map(function (r) { return r.name; }).concat([location.href]);
              var target = navigator.serviceWorker.controller || reg.active;
              if (target) target.postMessage({ type: 'cache', urls: urls });
            });
          }).catch(function () { /* no offline support in this browser or mode: the site works as before */ });
        });
      }
    </script>
    <script is:inline>
      // Spaced review (Leitner boxes), kept in this browser only. A right answer to a due (or new) question moves it to a longer gap,
      // a wrong one back to tomorrow. Answering again before it is due (a retry, or practice) never promotes it. Days are local days.
      // Entries look like { "concepts/caching#0": { b: box 0-4, d: day number it is next due, m: times missed } }.
      (function () {
        var KEY = 'sda-review', GAPS = [1, 3, 7, 14, 30]; // days until a question comes back, per box
        var MINUTE_MS = 60 * 1000, DAY_MS = 24 * 60 * MINUTE_MS;
        var today = function () { return Math.floor((Date.now() - new Date().getTimezoneOffset() * MINUTE_MS) / DAY_MS); };
        function load() { try { var v = JSON.parse(localStorage.getItem(KEY) || '{}'); return v && typeof v === 'object' && !Array.isArray(v) ? v : {}; } catch (e) { return {}; } }
        function save(v) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {} }
        window.sdaReview = {
          today: today,
          load: load,
          clear: function () { save({}); },
          record: function (key, ok) {
            var all = load(), was = all[key] && typeof all[key].b === 'number' ? all[key] : null;
            if (ok && was && was.d > today()) return; // right, but not due yet: keep the schedule
            var box = ok ? Math.min((was ? was.b : -1) + 1, GAPS.length - 1) : 0;
            all[key] = { b: box, d: today() + (ok ? GAPS[box] : 1), m: (was && was.m || 0) + (ok ? 0 : 1) };
            save(all);
          }
        };
      })();
    </script>
    <script is:inline>
      var root = document.documentElement;
      function sync() {
        document.querySelectorAll('[data-set-lang]').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.dataset.setLang === root.dataset.lang));
        });
        document.querySelectorAll('[data-lang-select]').forEach(function (m) { m.value = root.dataset.lang; });
      }
      document.addEventListener('change', function (e) {
        var m = e.target.closest('[data-lang-select]');
        if (m) {
          root.dataset.lang = m.value;
          try { localStorage.setItem('lang', m.value); } catch (err) {}
          sync();
        }
      });
      document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-set-lang]');
        if (b) {
          root.dataset.lang = b.dataset.setLang;
          try { localStorage.setItem('lang', b.dataset.setLang); } catch (err) {}
          sync();
        }
        if (e.target.closest('#theme-toggle')) {
          root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('theme', root.dataset.theme); } catch (err) {}
          syncTheme();
        }
      });
      function syncTheme() { document.getElementById('theme-toggle').setAttribute('aria-pressed', String(root.dataset.theme === 'dark')); }
      syncTheme();

      // Playgrounds and animations rebuild their buttons or disable the one just pressed.
      // If that drops keyboard focus to <body>, put it back on the equivalent control (or the region).
      var REFOCUS_AFTER_MS = 80; // long enough for the widget's own click handler to finish redrawing
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('button');
        var zone = b && b.closest('.playground, [data-player]');
        if (!zone) return;
        var label = b.textContent.trim();
        var index = Array.prototype.indexOf.call(zone.querySelectorAll('button'), b);
        setTimeout(function () {
          var a = document.activeElement;
          if (a && a !== document.body) return; // focus moved somewhere deliberate
          var all = Array.prototype.slice.call(zone.querySelectorAll('button'));
          var t = all.filter(function (x) { return !x.disabled && x.textContent.trim() === label; })[0] || all[index];
          if (t && !t.disabled) t.focus({ preventScroll: true });
          if (document.activeElement === document.body || !document.activeElement) { zone.setAttribute('tabindex', '-1'); zone.focus({ preventScroll: true }); }
        }, REFOCUS_AFTER_MS);
      }, true); // capture phase: runs before the handler that may remove the pressed button
      sync();

      // "/" focuses the page's own search box where there is one (those pages handle it); elsewhere it opens Search.
      document.addEventListener('keydown', function (e) {
        var t = e.target;
        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey || /INPUT|TEXTAREA|SELECT/.test(t.tagName) || t.isContentEditable) return;
        if (document.querySelector('[data-q]')) return;
        e.preventDefault();
        location.href = document.querySelector('.search-btn').href;
      });

      // Following an in-page link (such as "Read this part again") moves keyboard and screen reader focus there too, not only the view.
      window.addEventListener('hashchange', function () {
        var t = location.hash.length > 1 && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (!t || t.hidden || t.contains(document.activeElement)) return;
        if (!t.matches('a[href], button, input, select, textarea, [tabindex]')) t.setAttribute('tabindex', '-1');
        t.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>

<style is:global>
  .site-header { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; gap: 8px 24px; min-height: var(--header-h); flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-weight: 700; font-size: 1.05rem; color: var(--text); text-decoration: none; }
  .brand:hover { color: var(--text); }
  .brand .mark { color: var(--accent); flex: none; }
  .main-nav { display: flex; gap: 4px; flex-wrap: wrap; }
  .main-nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; color: var(--muted); text-decoration: none; font-weight: 500; border-radius: 8px; }
  .main-nav a:hover { background: var(--surface-2); color: var(--text); }
  .main-nav a[aria-current='page'] { color: var(--text); border-radius: 0; box-shadow: inset 0 -3px 0 var(--accent); }
  .main-nav svg { display: none; }
  .controls { display: flex; gap: 8px; align-items: center; margin-left: auto; }
  .search-btn { color: var(--muted); min-width: 150px; justify-content: flex-start; }
  .search-btn .kbd { margin-left: auto; }
  .search-btn[aria-current='page'] { border-color: var(--accent); color: var(--text); }
  .kbd { font: .75rem var(--font-mono); border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 5px; padding: 0 6px; color: var(--muted); background: var(--bg); }
  .icon-btn { padding: 0; width: 40px; }
  :root[data-theme='dark'] #theme-toggle .moon, :root:not([data-theme='dark']) #theme-toggle .sun { display: none; }
  /* Phones: the main nav becomes a bottom tab bar, the header keeps the logo, search, language and theme. */
  @media (max-width: 640px) {
    :root { --header-h: 56px; --tabbar-h: 60px; }
    html { scroll-padding-bottom: calc(var(--tabbar-h) + 12px); }
    /* backdrop-filter would make the header the containing block of the fixed tab bar. */
    .site-header { backdrop-filter: none; background: var(--surface); }
    body { padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom)); }
    .bar { flex-wrap: nowrap; gap: 8px; }
    .brand { min-width: 0; font-size: .95rem; }
    .brand-name { overflow-wrap: anywhere; }
    .search-btn { min-width: 0; width: 40px; padding: 0; }
    .search-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .search-btn .kbd { display: none; }
    .main-nav { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; padding-bottom: env(safe-area-inset-bottom); background: var(--surface); border-top: 1px solid var(--border); }
    .main-nav a { flex-direction: column; justify-content: center; gap: 2px; min-height: var(--tabbar-h); padding: 4px 2px; font-size: .72rem; text-align: center; line-height: 1.2; border-radius: 0; }
    .main-nav a[aria-current='page'] { color: var(--accent); font-weight: 600; box-shadow: inset 0 3px 0 var(--accent); }
    .main-nav svg { display: block; }
  }
  @media (max-width: 420px) { .brand-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } }
  .done-row { display: flex; gap: 8px 16px; align-items: center; flex-wrap: wrap; margin: .8rem 0 0; }
  [data-card-key] { position: relative; }
  .done-flag { position: absolute; top: 12px; right: 12px; font: 500 .72rem var(--font-mono); padding: 2px 8px; border-radius: 6px; border: 1px solid var(--good); background: var(--surface); color: var(--good-text); }
  .done-flag::before { content: '\2713\00a0'; }
  .done-toggle::before { content: '\2610\00a0'; }
  .done-toggle[aria-pressed='true'] { background: var(--good-soft); border-color: var(--good); color: var(--good-text); }
  .done-toggle[aria-pressed='true']::before { content: '\2713\00a0'; }
  .site-foot { margin-top: 4rem; border-top: 1px solid var(--border); background: var(--surface); }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; color: var(--muted); font-size: .88rem; padding-top: 1.5rem; padding-bottom: 1.5rem; }
  .foot p { margin: 0; max-width: 70ch; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  @media (forced-colors: active) { .main-nav a[aria-current='page'] { box-shadow: none; } }
</style>
