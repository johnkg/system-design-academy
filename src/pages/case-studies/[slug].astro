---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LessonShell from '../../components/LessonShell.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Quiz from '../../components/Quiz.astro';
import { learnFor } from '../../learn';
import PracticePanel from '../../components/PracticePanel.astro';
import CodeTabs from '../../components/CodeTabs.astro';
import StepPlayer from '../../components/StepPlayer.astro';
import GrowDiagram from '../../components/GrowDiagram.astro';
import { getCode, getVisual, url, minutesFor, numbered } from '../../lib';

export async function getStaticPaths() {
  const studies = await getCollection('studies');
  const concepts = await getCollection('concepts');
  const patterns = await getCollection('patterns');
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry, concepts, patterns } }));
}

const { entry, concepts, patterns } = Astro.props;
const { data } = entry;
const slug = entry.id;
const finalFlow = getVisual<any>(slug, 'final', 'studies');
const hasCode = getCode(slug, 'studies').length > 0;
const colors = Object.fromEntries(data.roles.map((r, i) => [r.id, `var(--role-${i + 1})`]));

// Optional study-specific interactive parts live in src/studies/<slug>/.
const parts = import.meta.glob('../../studies/*/*.astro', { eager: true }) as Record<string, { default: any }>;
const part = (name: string) => parts[`../../studies/${slug}/${name}.astro`]?.default;
const Estimator = part('Estimator');
const BreakIt = part('BreakIt');

// Resolve a concept or pattern reference, and fail the build on a typo.
function ref(r: { kind: 'concept' | 'pattern'; slug: string }) {
  const hit = r.kind === 'concept' ? concepts.find((c) => c.id === r.slug) : patterns.find((p) => p.id === r.slug);
  if (!hit) throw new Error(`Study "${slug}" references unknown ${r.kind} "${r.slug}"`);
  return { name: hit.data.name, href: url(`${r.kind === 'concept' ? 'concepts' : 'patterns'}/${r.slug}/`), kind: r.kind };
}
const panels = [
  { title: 'Start: the first attempt', lines: [{ label: 'Design.', text: data.firstAttempt.text }], links: [] },
  ...data.steps.map((s, i) => ({
    title: `${i + 1}. ${s.title}`,
    lines: [{ label: 'Problem.', text: s.problem }, { label: 'Fix.', text: s.fix }, { label: 'Trade-off.', text: s.tradeoff }],
    links: s.concepts.map(ref),
  })),
];
const used = new Map<string, ReturnType<typeof ref>>();
[...data.steps.flatMap((s) => s.concepts), ...data.failures.flatMap((f) => f.concepts)].forEach((c) => used.set(`${c.kind}:${c.slug}`, ref(c)));
const sections = numbered([
  ['requirements', 'Requirements'], ['first-attempt', 'The first attempt'], !!BreakIt && ['break', 'Break it'], ['fix', 'Fix it, one step at a time'],
  !!finalFlow && ['final', 'The final design in action'], ['failures', 'What if something fails?'], ['choices', 'Choices that could go the other way'],
  hasCode && ['code', `Code: ${data.codeTitle}`], !!data.quiz && ['quiz', 'Test yourself'],
]);
const sec = (id: string) => sections.find((x) => x.id === id)!;
---
<Layout title={`${data.name} | System Design Academy`} description={data.intent}>
  <LessonShell
    crumbs={[{ label: 'Case studies', href: url('case-studies/') }, { label: data.name }]}
    level={data.difficulty} title={data.name} intent={data.intent} scenario={{ label: 'The task', text: data.prompt }}
    facts={[`about ${minutesFor('study', data)} min`, `${used.size} concepts`]} sections={sections} done={{ collection: 'studies', slug }} hasQuiz={!!data.quiz}>
    <div class="card side-box" slot="side">
      <p class="eyebrow">Practise it</p>
      <a href={url(`interview/?study=${slug}&min=45`)}>Run a 45-minute mock interview</a>
    </div>
  <PracticePanel slug={slug} moves={data.steps.map((st) => st.title)} functional={data.functional} nonFunctional={data.nonFunctional} />

  <SectionHeading s={sec('requirements')} />
  <div class="judge two">
    <section class="card"><h3>What it must do</h3><ul class="clean">{data.functional.map((x) => <li>{x}</li>)}</ul></section>
    <section class="card"><h3>How well it must do it</h3><ul class="clean">{data.nonFunctional.map((x) => <li>{x}</li>)}</ul></section>
  </div>
  {Estimator && <Estimator />}

  <SectionHeading s={sec('first-attempt')} />
  <p>{data.firstAttempt.text}</p>
  <p><strong>Where it hurts:</strong></p>
  <ul>{data.firstAttempt.limits.map((x) => <li>{x}</li>)}</ul>

  {BreakIt && (<>
    <SectionHeading s={sec('break')} />
    <BreakIt />
  </>)}

  <SectionHeading s={sec('fix')} />
  <p>Each step solves the bottleneck the previous one exposed. The diagram grows as you go, and every concept links to its own page.</p>
  <GrowDiagram nodes={data.nodes} edges={data.edges} panels={panels} colors={colors} label={`${data.name}: the design growing step by step`} />

  {finalFlow && (<>
    <SectionHeading s={sec('final')} />
    <p>{data.finalIntro}</p>
    <StepPlayer steps={finalFlow} colors={colors} />
  </>)}

  <SectionHeading s={sec('failures')} />
  <div class="fails">
    {data.failures.map((f, i) => (
      <section class="card" id={`fail-${i}`}>
        <h3>{f.scenario}</h3>
        <p><strong>Impact.</strong> {f.impact}</p>
        <p><strong>Answer.</strong> {f.answer}</p>
        <p class="uses"><strong>Concepts:</strong> {f.concepts.map(ref).map((c, i) => <>{i > 0 && ', '}<a href={c.href}>{c.name}</a></>)}</p>
      </section>
    ))}
  </div>

  <SectionHeading s={sec('choices')} />
  {data.alternatives.map((a, i) => (
    <section class="card alt" id={`alt-${i}`}>
      <h3>{a.title}</h3>
      <div class="tablewrap" tabindex="0" role="region" aria-label={a.title}>
        <table>
          <caption class="sr">{a.title}</caption>
          <thead><tr><th scope="col">Option</th><th scope="col">Good</th><th scope="col">Costs</th></tr></thead>
          <tbody>{a.options.map((o) => <tr><th scope="row">{o.name}</th><td>{o.pro}</td><td>{o.con}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="rule"><strong>Pick:</strong> {a.pick}</p>
    </section>
  ))}

  {hasCode && (<>
    <SectionHeading s={sec('code')} />
    <CodeTabs slug={slug} collection="studies" />
  </>)}

  {data.quiz && (<>
    <SectionHeading s={sec('quiz')} />
    <Quiz slug={slug} kind="studies" questions={data.quiz} links={data.quiz.map((q) => learnFor('studies', slug, data, q, new Map(concepts.map((c) => [c.id, c.data.name])), new Map(patterns.map((p) => [p.id, p.data.name]))))} />
  </>)}

  <h2>Concepts used</h2>
  <p>{[...used.values()].map((c, i) => <>{i > 0 && ', '}<a href={c.href}>{c.name}</a></>)}</p>
  </LessonShell>
</Layout>
<style>
  .judge { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); }
  .judge h3 { margin-top: 0; }
  .fails { display: grid; gap: 12px; }
  .fails h3, .alt h3 { margin-top: 0; }
  .fails p { margin: .4rem 0; }
  .uses { color: var(--muted); }
  .alt { margin: 14px 0; }
  .tablewrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
  table { width: 100%; border-collapse: collapse; font-size: .92rem; min-width: 520px; }
  th, td { text-align: left; vertical-align: top; padding: 8px 12px; border-bottom: 1px solid var(--border); }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { background: var(--surface-2); }
  tbody th[scope='row'] { font-weight: 600; width: 24%; }
  .rule { margin: 12px 0 0; padding: 10px 14px; border-radius: 10px; background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); }
</style>
