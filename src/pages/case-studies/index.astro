---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import { url } from '../../lib';

const studies = (await getCollection('studies')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const difficulties = ['beginner', 'intermediate', 'advanced'] as const;
const count = (d: string) => studies.filter((s) => s.data.difficulty === d).length;
const conceptCount = (s: (typeof studies)[number]) => new Set(s.data.steps.flatMap((x) => x.concepts.map((c) => c.slug))).size;
// Studies built from a company's own published engineering posts get a strip of their own.
const real = studies.filter((s) => (s.data.sources?.length ?? 0) > 0);
---
<Layout title="Case studies | System Design Academy" description="Design real systems step by step by combining the concepts from the catalog.">
  <PageHead eyebrow={`Case studies · ${studies.length} designs`} title="Design real systems, one fix at a time" lede='Each study starts with a naive version, shows where it breaks, and repairs it with concepts from the catalog. Then try the estimator and break it on purpose.' />

  {real.length > 0 && (
    <section class="real" data-featured aria-labelledby="real-h">
      <div class="real-head">
        <h2 id="real-h" class="eyebrow">From real companies</h2>
        <p>Built from each company's own published engineering posts, with the sources listed at the end.</p>
      </div>
      <ul class="real-list">
        {real.map((s) => (
          <li>
            <a class="real-card" href={url(`case-studies/${s.id}/`)} data-card-key={`studies/${s.id}`}>
              <span class="badge" data-level={s.data.difficulty}>{s.data.difficulty}</span>
              <strong>{s.data.name}</strong>
              <span class="real-by">{[...new Set(s.data.sources!.map((x) => x.publisher))].join(', ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <form class="toolbar" role="search" data-filters onsubmit="return false">
    <div class="field">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <label class="sr" for="q">Search the case studies</label>
      <input id="q" type="search" placeholder="Search by system or idea, e.g. feed, payments, chat" autocomplete="off" data-q />
      <kbd class="kbd" aria-hidden="true">/</kbd>
    </div>
    <div class="toolbar-row">
      <div class="chips" role="group" aria-label="Difficulty">
        <button type="button" class="chip-btn" data-diff="all" aria-pressed="true">Any level <span>{studies.length}</span></button>
        {difficulties.map((d) => <button type="button" class="chip-btn cap" data-diff={d} aria-pressed="false">{d} <span>{count(d)}</span></button>)}
      </div>
      <button type="button" class="chip-btn" data-hide-done aria-pressed="false">Hide the ones I finished</button>
      <p class="status"><span data-count aria-live="polite"></span> <button type="button" class="linklike" data-reset hidden>Clear filters</button></p>
    </div>
  </form>

  <ul class="grid studies">
    {studies.map((s) => (
      <li>
        <a class="study" href={url(`case-studies/${s.id}/`)} data-card data-card-key={`studies/${s.id}`} data-diff={s.data.difficulty} data-text={`${s.data.name} ${s.data.intent} ${s.data.prompt}`.toLowerCase()}>
          <span class="badge" data-level={s.data.difficulty}>{s.data.difficulty}</span>
          <h2>{s.data.name}</h2>
          <p>{s.data.intent}</p>
          <span class="foot"><span>{s.data.steps.length} fixes</span><span>{conceptCount(s)} concepts</span><svg class="go" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
        </a>
      </li>
    ))}
  </ul>
  <p class="empty" data-empty hidden>No matches. Try fewer words or <button type="button" class="linklike" data-reset>clear the filters</button>.</p>
</Layout>
<script>
  const root = document.querySelector<HTMLElement>('[data-filters]')!;
  const input = root.querySelector<HTMLInputElement>('[data-q]')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const resets = document.querySelectorAll<HTMLButtonElement>('[data-reset]');
  const hideBtn = root.querySelector<HTMLElement>('[data-hide-done]')!;
  const featured = document.querySelector<HTMLElement>('[data-featured]');

  const params = new URLSearchParams(location.search);
  const state = { q: params.get('q') ?? '', diff: params.get('level') ?? 'all', hideDone: params.get('hide') === 'done' };
  input.value = state.q;
  const isDone = (key: string) => !!(window as any).sdaProgress?.has(key);

  function apply() {
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    cards.forEach((c) => {
      const ok = (state.diff === 'all' || c.dataset.diff === state.diff)
        && !(state.hideDone && isDone(c.dataset.cardKey!))
        && words.every((w) => c.dataset.text!.includes(w));
      c.hidden = !ok;
      if (ok) shown++;
    });
    root.querySelectorAll<HTMLElement>('[data-diff]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.diff === state.diff)));
    hideBtn.setAttribute('aria-pressed', String(state.hideDone));
    const filtered = !!words.length || state.diff !== 'all' || state.hideDone;
    if (featured) featured.hidden = filtered;
    count.textContent = filtered ? `Showing ${shown} of ${cards.length}` : `${cards.length} case studies`;
    resets.forEach((r) => (r.hidden = !filtered && r.closest('form') !== null));
    empty.hidden = shown > 0;
    const next = new URLSearchParams();
    if (state.q) next.set('q', state.q);
    if (state.diff !== 'all') next.set('level', state.diff);
    if (state.hideDone) next.set('hide', 'done');
    history.replaceState(null, '', next.size ? `?${next}` : location.pathname);
  }

  input.addEventListener('input', () => { state.q = input.value; apply(); });
  root.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('.chip-btn');
    if (!b) return;
    if (b.hasAttribute('data-hide-done')) state.hideDone = !state.hideDone;
    else if (b.dataset.diff) state.diff = b.dataset.diff;
    apply();
  });
  resets.forEach((r) => r.addEventListener('click', () => { state.q = ''; state.diff = 'all'; state.hideDone = false; input.value = ''; apply(); input.focus(); }));
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(t.tagName)) { e.preventDefault(); input.focus(); }
    if (e.key === 'Escape' && t === input) { input.value = ''; state.q = ''; apply(); }
  });
  document.addEventListener('sda-progress', apply);
  apply();
</script>
<style>
  .real { margin: .5rem 0 1.5rem; padding: 16px 18px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); display: grid; gap: 12px; }
  .real-head { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; }
  .real-head p { margin: 0; color: var(--muted); font-size: .92rem; }
  .real-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .real-card { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; height: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg); color: var(--text); text-decoration: none; }
  .real-card:hover { border-color: var(--accent); color: var(--text); }
  .real-card:focus-visible, .study:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .real-by { font: .78rem var(--font-mono); color: var(--muted); }
  .empty { margin: 3rem 0; text-align: center; color: var(--muted); }
  .studies { list-style: none; margin: 0 0 3rem; padding: 0; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); }
  .studies > li { display: flex; min-width: 0; }
  .studies > li:has(> [hidden]) { display: none; }
  .study { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 18px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); color: var(--text); text-decoration: none; }
  .study:hover { border-color: var(--accent); color: var(--text); box-shadow: 0 0 0 3px var(--accent-soft); }
  .study h2 { margin: 2px 0 0; font-size: 1.2rem; line-height: 1.25; }
  .study p { margin: 0; color: var(--muted); font-size: .95rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { margin-top: auto; padding-top: 10px; width: 100%; display: flex; align-items: center; gap: 14px; border-top: 1px dashed var(--border); font: .78rem var(--font-mono); color: var(--muted); }
  .go { margin-left: auto; color: var(--accent); }
  .study:hover .go { transform: translateX(2px); }
  @media (prefers-reduced-motion: no-preference) { .go { transition: transform .15s; } }
</style>
