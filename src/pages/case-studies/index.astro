---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib';

const studies = (await getCollection('studies')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<Layout title="Case studies | System Design Academy" description="Design real systems step by step by combining the concepts from the catalog.">
  <section class="hero">
    <h1>Case studies</h1>
    <p class="lede">Real "design this" problems. Start with a naive version, see where it breaks, and fix it with the concepts from the catalog, one step at a time.</p>
  </section>
  <div class="grid">
    {studies.map((s) => (
      <a class="card pat" href={url(`case-studies/${s.id}/`)}>
        <span class="badge">{s.data.difficulty}</span>
        <h2>{s.data.name}</h2>
        <p>{s.data.intent}</p>
        <small>{s.data.steps.length} improvements · {new Set(s.data.steps.flatMap((x) => x.concepts.map((c) => c.slug))).size} concepts used</small>
      </a>
    ))}
  </div>
</Layout>
<style>
  .hero { padding: 2.5rem 0 1rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .4rem; }
  .card h2 { font-size: 1.15rem; margin: .4rem 0; }
  .pat { text-decoration: none; color: var(--text); display: block; transition: transform .15s, border-color .15s; }
  .pat:hover { transform: translateY(-2px); border-color: var(--accent); }
  .pat p { margin: 0 0 .5rem; color: var(--muted); }
  .pat small { color: var(--accent); }
  .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); margin-bottom: 3rem; }
</style>
