---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { url } from '../lib';
import { areaLabel } from '../data/areas';

// One list of everything on the site, filtered in the browser. Quiz questions are searchable too, so a half-remembered
// idea ("what happens when the cache expires for everyone at once") still finds its concept.
const concepts = await getCollection('concepts');
const patterns = await getCollection('patterns');
const studies = await getCollection('studies');
interface Hit { href: string; key: string; kind: string; name: string; intent: string; where: string; level: string; text: string }
const hits: Hit[] = [
  ...concepts.map((c) => ({
    href: url(`concepts/${c.id}/`), key: `concepts/${c.id}`, kind: 'concept', name: c.data.name, intent: c.data.intent, where: areaLabel(c.data.area), level: c.data.difficulty,
    text: [c.data.scenario, c.data.problem, ...c.data.pitfalls, ...c.data.whenToUse, ...c.data.howItWorks.map((h) => h.title), ...(c.data.quiz ?? []).map((q) => q.question)].join(' '),
  })),
  ...patterns.map((p) => ({
    href: url(`patterns/${p.id}/`), key: `patterns/${p.id}`, kind: 'pattern', name: p.data.name, intent: p.data.intent, where: `${p.data.category} pattern`, level: p.data.difficulty,
    text: [p.data.scenario, p.data.problem, ...p.data.pitfalls, ...p.data.whenToUse, 'design pattern'].join(' '),
  })),
  ...studies.map((s) => ({
    href: url(`case-studies/${s.id}/`), key: `studies/${s.id}`, kind: 'study', name: s.data.name, intent: s.data.intent, where: 'Case study', level: s.data.difficulty,
    text: [s.data.prompt, ...s.data.steps.map((x) => x.title)].join(' '),
  })),
].sort((a, b) => a.name.localeCompare(b.name));
const kinds = [['all', 'Everything'], ['concept', 'Concepts'], ['pattern', 'Patterns'], ['study', 'Case studies']] as const;
---
<Layout title="Search | System Design Academy" description="Search every concept, design pattern and case study on the site at once.">
  <section class="hero">
    <h1>Search</h1>
    <p class="lede">Looks through every concept, pattern and case study, including the quiz questions.</p>
  </section>

  <form class="filters" role="search" data-filters onsubmit="return false">
    <div class="searchbox">
      <label class="sr" for="q">Search the whole site</label>
      <input id="q" class="pg-in" type="search" placeholder="Try &quot;cache stampede&quot; or &quot;exactly once&quot;…  (press / to focus)" autocomplete="off" data-q />
    </div>
    <div class="chips" role="group" aria-label="Type">
      {kinds.map(([id, label]) => <button type="button" class="chip-btn" data-kind={id} aria-pressed={id === 'all' ? 'true' : 'false'}>{label}</button>)}
    </div>
    <p class="status"><span data-count aria-live="polite"></span></p>
  </form>

  <ul class="results" data-results>
    {hits.map((h) => (
      <li data-hit data-kind={h.kind} data-name={h.name.toLowerCase()} data-intent={h.intent.toLowerCase()} data-text={`${h.where} ${h.text}`.toLowerCase()} data-card-key={h.key}>
        <a href={h.href}>
          <span class="top"><strong>{h.name}</strong> <span class="badge">{h.level}</span></span>
          <span class="where">{h.where}</span>
          <span class="intent">{h.intent}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="empty" data-empty hidden>Nothing matches. Try fewer or simpler words.</p>
</Layout>
<script>
  const root = document.querySelector<HTMLElement>('[data-filters]')!;
  const input = root.querySelector<HTMLInputElement>('[data-q]')!;
  const list = document.querySelector<HTMLElement>('[data-results]')!;
  const items = [...list.querySelectorAll<HTMLElement>('[data-hit]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const alphabetical = [...items];

  const params = new URLSearchParams(location.search);
  const state = { q: params.get('q') ?? '', kind: params.get('type') ?? 'all' };
  input.value = state.q;

  // Name matches outrank intent matches, which outrank matches anywhere else; every word must match somewhere.
  const SCORE = { namePrefix: 12, name: 8, intent: 4, text: 1 };
  function score(el: HTMLElement, words: string[]) {
    let total = 0;
    for (const w of words) {
      if (el.dataset.name!.includes(w)) total += el.dataset.name!.startsWith(w) ? SCORE.namePrefix : SCORE.name;
      else if (el.dataset.intent!.includes(w)) total += SCORE.intent;
      else if (el.dataset.text!.includes(w)) total += SCORE.text;
      else return 0;
    }
    return total;
  }

  function apply() {
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    const scored = alphabetical.map((el) => ({ el, s: words.length ? score(el, words) : 1 }));
    const visible = scored.filter(({ el, s }) => s > 0 && (state.kind === 'all' || el.dataset.kind === state.kind));
    if (words.length) visible.sort((a, b) => b.s - a.s);
    const shown = new Set(visible.map((v) => v.el));
    alphabetical.forEach((el) => (el.hidden = !shown.has(el)));
    visible.forEach(({ el }) => list.appendChild(el));
    root.querySelectorAll<HTMLElement>('[data-kind]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === state.kind)));
    count.textContent = words.length || state.kind !== 'all' ? `${visible.length} result${visible.length === 1 ? '' : 's'}` : `${items.length} pages to search`;
    empty.hidden = visible.length > 0;
    const next = new URLSearchParams();
    if (state.q) next.set('q', state.q);
    if (state.kind !== 'all') next.set('type', state.kind);
    history.replaceState(null, '', next.size ? `?${next}` : location.pathname);
  }

  input.addEventListener('input', () => { state.q = input.value; apply(); });
  root.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('.chip-btn');
    if (b?.dataset.kind) { state.kind = b.dataset.kind; apply(); }
  });
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(t.tagName)) { e.preventDefault(); input.focus(); }
    if (e.key === 'Escape' && t === input) { input.value = ''; state.q = ''; apply(); }
  });
  apply();
  input.focus({ preventScroll: true });
</script>
<style>
  .hero { padding: 2.5rem 0 1rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .4rem; }
  .filters { position: sticky; top: var(--header-h); z-index: 5; display: grid; gap: 10px; padding: 12px 0; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); margin-bottom: 14px; }
  .searchbox input { width: 100%; padding: 10px 14px; font-size: 1rem; border-radius: 999px; }
  .status { margin: 0; color: var(--muted); font-size: .85rem; }
  .empty { margin: 3rem 0; text-align: center; color: var(--muted); }
  .results { list-style: none; margin: 0 0 3rem; padding: 0; display: grid; gap: 8px; }
  .results li { position: relative; }
  .results li[hidden] { display: none; }
  .results a { display: grid; gap: 2px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); text-decoration: none; color: var(--text); overflow-wrap: anywhere; }
  .results a:hover { border-color: var(--accent); }
  .top { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .where { color: var(--muted); font-size: .8rem; text-transform: capitalize; }
  .intent { color: var(--muted); font-size: .92rem; }
</style>
