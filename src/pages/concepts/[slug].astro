---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LessonShell from '../../components/LessonShell.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Quiz from '../../components/Quiz.astro';
import CodeTabs from '../../components/CodeTabs.astro';
import StepPlayer from '../../components/StepPlayer.astro';
import { getCode, getVisual, playgroundFor, url, minutesFor, numbered } from '../../lib';
import { areaLabel } from '../../data/areas';
import { learnFor } from '../../learn';
import { buildGraph } from '../../graph';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  const patterns = await getCollection('patterns');
  const studies = await getCollection('studies');
  return concepts.map((entry) => ({ params: { slug: entry.id }, props: { entry, concepts, patterns, studies } }));
}

const { entry, concepts, patterns, studies } = Astro.props;
const { data } = entry;
const slug = entry.id;
const steps = getVisual<any>(slug, 'steps', 'concepts');
const hasCode = getCode(slug, 'concepts').length > 0;
const node = buildGraph(concepts, studies).find((x) => x.slug === slug)!;
const readFirst = node.first.map((f) => concepts.find((c) => c.id === f)!).filter(Boolean);
const colors = Object.fromEntries(data.roles.map((r, i) => [r.id, `var(--role-${i + 1})`]));

const Playground = playgroundFor(data.name);

const related = data.related.flatMap((r) => {
  const hit = r.kind === 'concept' ? concepts.find((c) => c.id === r.slug) : patterns.find((p) => p.id === r.slug);
  return hit ? [{ name: hit.data.name, href: url(`${r.kind === 'concept' ? 'concepts' : 'patterns'}/${r.slug}/`), kind: r.kind }] : [];
});
const usedIn = studies
  .filter((st) => [...st.data.steps.flatMap((x) => x.concepts), ...st.data.failures.flatMap((x) => x.concepts)].some((c) => c.kind === 'concept' && c.slug === slug))
  .map((st) => ({ name: st.data.name, href: url(`case-studies/${st.id}/`) }));
const sections = numbered([
  ['problem', 'The problem'], ['how', 'How it works'], !!steps && ['watch', 'Watch it flow'], !!Playground && ['simulate', 'Simulate it'],
  ['tradeoffs', 'Trade-offs'], hasCode && ['code', 'Code'], ['judgment', 'Judgment'], !!data.quiz && ['quiz', 'Test yourself'],
]);
const sec = (id: string) => sections.find((x) => x.id === id)!;
const facts = [`about ${minutesFor('concept', data)} min`, ...(usedIn.length ? [`used in ${usedIn.length} case ${usedIn.length === 1 ? 'study' : 'studies'}`] : [])];
---
<Layout title={`${data.name} | System Design Academy`} description={data.intent}>
  <LessonShell
    crumbs={[{ label: 'Learn', href: url('') }, { label: areaLabel(data.area), href: url(`?area=${data.area}#catalog`) }, { label: data.name }]}
    level={data.difficulty} title={data.name} intent={data.intent} scenario={{ label: 'Example used throughout', text: data.scenario }}
    facts={facts} sections={sections} done={{ collection: 'concepts', slug }} hasQuiz={!!data.quiz}>
    <div class="card side-box" slot="side">
      {readFirst.length > 0 && (<>
        <p class="eyebrow">Read first</p>
        {readFirst.map((c) => <a href={url(`concepts/${c.id}/`)}>{c.data.name}</a>)}
      </>)}
      <p class="eyebrow">Where it fits</p>
      <a href={url(`map/?c=${slug}`)}>See it on the concept map</a>
    </div>

    <SectionHeading s={sec('problem')} />
    <p>{data.problem}</p>

    <SectionHeading s={sec('how')} />
    <ol class="how">
      {data.howItWorks.map((s, i) => <li class="card" id={`how-${i}`}><h3>{s.title}</h3><p>{s.text}</p></li>)}
    </ol>

    {steps && (<>
      <SectionHeading s={sec('watch')} />
      <StepPlayer steps={steps} colors={colors} />
    </>)}

    {Playground && (<>
      <SectionHeading s={sec('simulate')} />
      <Playground />
    </>)}

    <SectionHeading s={sec('tradeoffs')} />
    <div class="judge two">
      <section class="card pros" id="gain"><h3>What you gain</h3><ul class="clean">{data.pros.map((x) => <li>{x}</li>)}</ul></section>
      <section class="card cons" id="cost"><h3>What it costs</h3><ul class="clean">{data.cons.map((x) => <li>{x}</li>)}</ul></section>
    </div>

    {hasCode && (<>
      <SectionHeading s={sec('code')} />
      <CodeTabs slug={slug} collection="concepts" />
    </>)}

    <SectionHeading s={sec('judgment')} />
    <div class="judge">
      <section class="card" id="use-when"><h3>Use it when</h3><ul class="clean">{data.whenToUse.map((x) => <li>{x}</li>)}</ul></section>
      <section class="card" id="skip-when"><h3>Skip it when</h3><ul class="clean">{data.whenNotToUse.map((x) => <li>{x}</li>)}</ul></section>
      <section class="card" id="pitfalls"><h3>Watch out for</h3><ul class="clean">{data.pitfalls.map((x) => <li>{x}</li>)}</ul></section>
    </div>

    {data.quiz && (<>
      <SectionHeading s={sec('quiz')} />
      <Quiz slug={slug} questions={data.quiz} links={data.quiz.map((q) => learnFor('concepts', slug, data, q, new Map(), new Map()))} />
    </>)}

    {usedIn.length > 0 && (<>
      <h2>Used in case studies</h2>
      <p>{usedIn.map((u, i) => <>{i > 0 && ', '}<a href={u.href}>{u.name}</a></>)}</p>
    </>)}

    {related.length > 0 && (<>
      <h2>Related</h2>
      <p>{related.map((r, i) => <>{i > 0 && ', '}<a href={r.href}>{r.name}</a> <small class="kind">({r.kind === 'pattern' ? 'design pattern' : 'concept'})</small></>)}</p>
    </>)}
  </LessonShell>
</Layout>
<style>
  .how { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); counter-reset: step; }
  .how li { counter-increment: step; display: flex; flex-direction: column; gap: 4px; min-width: 0; overflow-wrap: anywhere; }
  .how li::before { content: counter(step, decimal-leading-zero); font: 600 .8rem var(--font-mono); color: var(--accent); }
  .how h3 { margin: 0; font-size: 1.05rem; }
  .how p { margin: 0; color: var(--muted); font-size: .95rem; }
  .judge { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .judge.two { grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); }
  .judge h3 { margin-top: 0; font-size: 1.05rem; }
  .pros h3::before { content: '+'; color: var(--good); font: 700 1.1rem var(--font-mono); margin-right: .45em; }
  .cons h3::before { content: '\2212'; color: var(--signal); font: 700 1.1rem var(--font-mono); margin-right: .45em; }
  .kind { color: var(--muted); }
</style>
