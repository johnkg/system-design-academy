---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DoneToggle from '../../components/DoneToggle.astro';
import Quiz from '../../components/Quiz.astro';
import CodeTabs from '../../components/CodeTabs.astro';
import StepPlayer from '../../components/StepPlayer.astro';
import { getCode, getVisual, url } from '../../lib';
import { areaLabel } from '../../data/areas';
import { learnFor } from '../../learn';
import { buildGraph } from '../../graph';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  const patterns = await getCollection('patterns');
  const studies = await getCollection('studies');
  return concepts.map((entry) => ({ params: { slug: entry.id }, props: { entry, concepts, patterns, studies } }));
}

const { entry, concepts, patterns, studies } = Astro.props;
const { data } = entry;
const slug = entry.id;
const steps = getVisual<any>(slug, 'steps', 'concepts');
const hasCode = getCode(slug, 'concepts').length > 0;
const node = buildGraph(concepts, studies).find((x) => x.slug === slug)!;
const readFirst = node.first.map((f) => concepts.find((c) => c.id === f)!).filter(Boolean);
const colors = Object.fromEntries(data.roles.map((r, i) => [r.id, `var(--role-${i + 1})`]));

// Each concept may ship an interactive simulation at src/playgrounds/<Name>Playground.astro.
const playgrounds = import.meta.glob('../../playgrounds/*.astro', { eager: true }) as Record<string, { default: any }>;
const Playground = Object.entries(playgrounds).find(([p]) => p.toLowerCase().endsWith(`/${data.name.replace(/[^a-z0-9]+/gi, '').toLowerCase()}playground.astro`))?.[1].default;

const related = data.related.flatMap((r) => {
  const hit = r.kind === 'concept' ? concepts.find((c) => c.id === r.slug) : patterns.find((p) => p.id === r.slug);
  return hit ? [{ name: hit.data.name, href: url(`${r.kind === 'concept' ? 'concepts' : 'patterns'}/${r.slug}/`), kind: r.kind }] : [];
});
const usedIn = studies
  .filter((st) => [...st.data.steps.flatMap((x) => x.concepts), ...st.data.failures.flatMap((x) => x.concepts)].some((c) => c.kind === 'concept' && c.slug === slug))
  .map((st) => ({ name: st.data.name, href: url(`case-studies/${st.id}/`) }));
let n = 0;
---
<Layout title={`${data.name} | System Design Academy`} description={data.intent}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href={url('')}>Catalog</a></li>
      <li><a href={url(`?area=${data.area}`)}>{areaLabel(data.area)}</a></li>
      <li aria-current="page">{data.name}</li>
    </ol>
  </nav>
  <header>
    <span class="badge">{data.difficulty}</span>
    <h1>{data.name}</h1>
    <p class="lede">{data.intent}</p>
    <p class="scenario"><strong>Example used throughout:</strong> {data.scenario}</p>
    {readFirst.length > 0 && <p class="first"><strong>Read first:</strong> {readFirst.map((c, i) => <>{i > 0 && ', '}<a href={url(`concepts/${c.id}/`)}>{c.data.name}</a></>)}. <a href={url(`map/?c=${slug}`)}>See it on the concept map</a>.</p>}
    <p class="done-row"><DoneToggle collection="concepts" slug={slug} />{data.quiz && <a class="quiz-link" href="#quiz">Test yourself</a>}</p>
  </header>

  <h2 id="problem">{++n}. The problem</h2>
  <p>{data.problem}</p>

  <h2 id="how">{++n}. How it works</h2>
  <ol class="how">
    {data.howItWorks.map((s, i) => <li class="card" id={`how-${i}`}><h3>{s.title}</h3><p>{s.text}</p></li>)}
  </ol>

  {steps && (<>
    <h2>{++n}. Watch it flow</h2>
    <StepPlayer steps={steps} colors={colors} />
  </>)}

  {Playground && (<>
    <h2>{++n}. Simulate it</h2>
    <Playground />
  </>)}

  <h2 id="tradeoffs">{++n}. Trade-offs</h2>
  <div class="judge two">
    <section class="card pros" id="gain"><h3>What you gain</h3><ul class="clean">{data.pros.map((x) => <li>{x}</li>)}</ul></section>
    <section class="card cons" id="cost"><h3>What it costs</h3><ul class="clean">{data.cons.map((x) => <li>{x}</li>)}</ul></section>
  </div>

  {hasCode && (<>
    <h2>{++n}. Code</h2>
    <CodeTabs slug={slug} collection="concepts" />
  </>)}

  <h2 id="judgment">{++n}. Judgment</h2>
  <div class="judge">
    <section class="card" id="use-when"><h3>Use it when</h3><ul class="clean">{data.whenToUse.map((x) => <li>{x}</li>)}</ul></section>
    <section class="card" id="skip-when"><h3>Skip it when</h3><ul class="clean">{data.whenNotToUse.map((x) => <li>{x}</li>)}</ul></section>
    <section class="card" id="pitfalls"><h3>Watch out for</h3><ul class="clean">{data.pitfalls.map((x) => <li>{x}</li>)}</ul></section>
  </div>

  {data.quiz && (<>
    <h2 id="quiz">{++n}. Test yourself</h2>
    <Quiz slug={slug} questions={data.quiz} links={data.quiz.map((q) => learnFor('concepts', slug, data, q, new Map(), new Map()))} />
  </>)}

  {usedIn.length > 0 && (<>
    <h2>Used in case studies</h2>
    <p>{usedIn.map((u, i) => <>{i > 0 && ', '}<a href={u.href}>{u.name}</a></>)}</p>
  </>)}

  {related.length > 0 && (<>
    <h2>Related</h2>
    <p>{related.map((r, i) => <>{i > 0 && ', '}<a href={r.href}>{r.name}</a> <small class="kind">({r.kind === 'pattern' ? 'design pattern' : 'concept'})</small></>)}</p>
  </>)}
</Layout>
<style>
  .crumbs { padding-top: 1rem; font-size: .9rem; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; color: var(--muted); }
  .crumbs li + li::before { content: '›'; margin-right: 6px; color: var(--muted); }
  .crumbs [aria-current] { color: var(--text); font-weight: 600; }
  h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: .5rem 0 0; }
  .first { margin: .4rem 0 0; color: var(--muted); }
  .scenario { background: var(--accent-soft); padding: 10px 14px; border-radius: 10px; max-width: 70ch; }
  h2 { scroll-margin-top: calc(var(--header-h) + 12px); }
  .how { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; counter-reset: step; }
  .how li { counter-increment: step; position: relative; padding-left: 56px; min-width: 0; overflow-wrap: anywhere; }
  .how li::before { content: counter(step); position: absolute; left: 14px; top: 14px; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--on-accent); font-weight: 700; font-size: .85rem; }
  .how h3 { margin: 0 0 4px; font-size: 1.05rem; }
  .how p { margin: 0; color: var(--muted); }
  .judge { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .judge.two { grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); }
  .judge h3 { margin-top: 0; }
  .pros { border-top: 4px solid var(--good); } .cons { border-top: 4px solid var(--bad); }
  .kind { color: var(--muted); }
  main > :global(*:last-child) { margin-bottom: 2rem; }
</style>
