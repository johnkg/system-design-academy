---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { url } from '../lib';

// Everything here is read from this browser's localStorage; the build only supplies the totals and the names of pages.
const concepts = await getCollection('concepts');
const patterns = await getCollection('patterns');
const studies = await getCollection('studies');
const totals = { concepts: concepts.length, patterns: patterns.length, studies: studies.length };
const names: Record<string, { name: string; href: string }> = {};
for (const [kind, list, dir] of [['concepts', concepts, 'concepts'], ['patterns', patterns, 'patterns'], ['studies', studies, 'case-studies']] as const) {
  for (const e of list) names[`${kind}/${e.id}`] = { name: e.data.name, href: url(`${dir}/${e.id}/`) };
}
const payload = JSON.stringify({ totals, names }).replace(/</g, '\\u003c');
---
<Layout title="My progress | System Design Academy" description="Your progress through the concepts, patterns and case studies, with backup and restore for moving between browsers.">
  <section class="hero">
    <h1>My progress</h1>
    <p class="lede">Everything is stored in this browser only. Export it to keep a backup or to move to another device.</p>
  </section>

  <div class="stats" data-stats></div>

  <div class="card panel">
    <h2>Review</h2>
    <p data-review></p>
    <p><a class="btn pg-primary" href={url('review/')}>Go to review</a></p>
  </div>

  <div class="card panel">
    <h2>Quiz results</h2>
    <p class="muted" data-quiz-empty hidden>No quiz results yet. Each concept, pattern and case study has a "Test yourself" section.</p>
    <ul class="results" data-quizzes></ul>
  </div>

  <div class="card panel">
    <h2>Back up or move your data</h2>
    <p>The file holds your done marks, notes, quiz results and review schedule. Nothing is uploaded anywhere.</p>
    <div class="actions">
      <button type="button" class="btn pg-primary" data-export>Download backup</button>
      <input id="import-file" class="sr" type="file" accept="application/json,.json" data-import />
      <label class="btn" for="import-file">Restore from backup</label>
    </div>
    <p class="note" data-msg aria-live="polite"></p>
    <p class="muted">Restoring merges your done marks with the ones in the file and replaces notes, quiz results and review history for the pages in the file.</p>
  </div>

  <div class="card panel">
    <h2>Start over</h2>
    <p><button type="button" class="btn" data-wipe>Erase all my progress in this browser</button></p>
  </div>
  <script type="application/json" id="progress-data" set:html={payload}></script>
</Layout>
<script>
  const meta: { totals: Record<string, number>; names: Record<string, { name: string; href: string }> } = JSON.parse(document.getElementById('progress-data')!.textContent!);
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const keys = () => { try { return Object.keys(localStorage).filter((k) => k.startsWith('sda-')); } catch { return []; } };
  const labels: Record<string, string> = { concepts: 'Concepts', patterns: 'Patterns', studies: 'Case studies' };

  const review = (window as any).sdaReview;
  const strings = (v: unknown) => (Array.isArray(v) ? v.filter((x): x is string => typeof x === 'string') : []);
  const isObject = (v: unknown): v is Record<string, unknown> => !!v && typeof v === 'object' && !Array.isArray(v);
  const parse = (text: string | null) => { try { return JSON.parse(text ?? 'null'); } catch { return null; } };

  function render() {
    // Read storage directly (not the layout's copy) so the page reflects a restore or erase immediately.
    const done = strings(parse(get('sda-progress')));
    const stats = $('[data-stats]'); stats.replaceChildren();
    const sum = { d: 0, t: 0 };
    for (const kind of ['concepts', 'patterns', 'studies']) {
      const t = meta.totals[kind], d = done.filter((k) => k.startsWith(kind + '/') && meta.names[k]).length;
      sum.d += d; sum.t += t;
      const card = document.createElement('div'); card.className = 'card stat';
      const big = document.createElement('strong'); big.textContent = `${d} of ${t}`;
      const label = document.createElement('span'); label.textContent = `${labels[kind]} done`;
      const bar = document.createElement('div'); bar.className = 'bar'; const fill = document.createElement('i'); fill.style.width = `${Math.round(100 * d / t)}%`; bar.append(fill);
      card.append(big, label, bar); stats.append(card);
    }
    // Review summary.
    const hist: Record<string, { b: number; d: number; m?: number }> = review.load();
    const entries = Object.entries(hist).filter(([k]) => !k.startsWith('interview/')).map(([, v]) => v), today = review.today(); // interview questions have their own tally
    $('[data-review]').textContent = entries.length
      ? `${entries.length} questions answered so far: ${entries.filter((e) => e.d <= today).length} due now, ${entries.filter((e) => e.b >= 3).length} well remembered, ${entries.filter((e) => (e.m ?? 0) > 0).length} missed at least once.`
      : 'No review history yet.';
    // Last quiz result per page.
    const list = $('[data-quizzes]'); list.replaceChildren();
    const quizKeys = keys().filter((k) => k.startsWith('sda-quiz/'));
    for (const k of quizKeys) {
      const rest = k.slice('sda-quiz/'.length);
      // New keys are "kind/slug"; older concept results were saved as just the slug, and the new key wins when both exist.
      const id = rest.includes('/') ? rest : `concepts/${rest}`;
      if (!rest.includes('/') && quizKeys.includes(`sda-quiz/${id}`)) continue;
      const hit = meta.names[id];
      if (!hit) continue;
      const li = document.createElement('li'), a = document.createElement('a'); a.href = hit.href + '#quiz'; a.textContent = hit.name;
      li.append(a, `: ${get(k)}`); list.append(li);
    }
    $('[data-quiz-empty]').hidden = list.children.length > 0;
  }

  const REVOKE_AFTER_MS = 1000; // give the browser time to start the download before the file URL is freed
  $('[data-export]').addEventListener('click', () => {
    const data: Record<string, string> = {};
    for (const k of keys()) { const v = get(k); if (v !== null) data[k] = v; }
    const blob = new Blob([JSON.stringify({ app: 'system-design-academy', version: 1, exported: new Date().toISOString(), data }, null, 1)], { type: 'application/json' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'system-design-academy-progress.json'; a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), REVOKE_AFTER_MS);
    $('[data-msg]').textContent = `Saved ${Object.keys(data).length} items to your downloads.`;
  });

  $('[data-import]').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement, msg = $('[data-msg]');
    const file = input.files?.[0]; if (!file) return;
    const parsed = parse(await file.text().catch(() => null));
    input.value = '';
    if (parsed?.app !== 'system-design-academy' || !isObject(parsed.data)) { msg.textContent = 'That file is not a System Design Academy backup, so nothing was changed.'; return; }
    // Work out every write first, so a damaged entry cannot leave a half-applied restore.
    const writes: [string, string][] = [];
    for (const [k, v] of Object.entries(parsed.data)) {
      if (!k.startsWith('sda-') || typeof v !== 'string') continue;
      if (k === 'sda-progress') writes.push([k, JSON.stringify([...new Set([...strings(parse(get(k))), ...strings(parse(v))])])]);
      else if (k === 'sda-review') { const theirs = parse(v); if (isObject(theirs)) writes.push([k, JSON.stringify({ ...review.load(), ...theirs })]); }
      else writes.push([k, v]);
    }
    let n = 0;
    for (const [k, v] of writes) { try { localStorage.setItem(k, v); n++; } catch { break; } }
    msg.textContent = n === writes.length ? `Restored ${n} items.` : `Restored ${n} of ${writes.length} items; this browser refused the rest (storage full or blocked).`;
    render();
  });

  $('[data-wipe]').addEventListener('click', () => {
    if (!confirm('Erase your done marks, notes, quiz results and review history in this browser? This cannot be undone.')) return;
    for (const k of keys()) { try { localStorage.removeItem(k); } catch { /* ignore */ } }
    $('[data-msg]').textContent = 'Erased.'; render();
  });
  render();
</script>
<style>
  .hero { padding: 2.5rem 0 1rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .4rem; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 12px; margin-bottom: 14px; }
  .stat { display: grid; gap: 4px; }
  .stat strong { font-size: 1.6rem; }
  .stat span, .muted, .note { color: var(--muted); }
  .bar { height: 8px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .bar :global(i) { display: block; height: 100%; background: var(--accent); }
  .panel { margin-bottom: 14px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
  .panel h2 { margin: 0; font-size: 1.15rem; }
  .panel p { margin: 0; }
  .results { margin: 0; padding-left: 1.2rem; display: grid; gap: 4px; overflow-wrap: anywhere; }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; }
  label.btn { display: inline-flex; align-items: center; }
  .sr:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
