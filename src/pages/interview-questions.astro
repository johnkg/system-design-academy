---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { url } from '../lib';
import { interviewQuestions, kindLabels } from '../data/interviewQuestions';
import type { QuestionKind, QuestionLevel, ReadLink } from '../data/interviewQuestions';

// Interview questions with model answers: browse and filter them, or drill with a timer and grade yourself against the list of points.
const concepts = await getCollection('concepts');
const studies = await getCollection('studies');
const link = (r: ReadLink, where: string) => {
  if (r.kind === 'concept') {
    const hit = concepts.find((c) => c.id === r.slug);
    if (!hit) throw new Error(`Interview question "${where}" references unknown concept "${r.slug}"`);
    return { name: hit.data.name, href: url(`concepts/${r.slug}/`), type: 'Concept' };
  }
  const hit = studies.find((c) => c.id === r.slug);
  if (!hit) throw new Error(`Interview question "${where}" references unknown case study "${r.slug}"`);
  return { name: hit.data.name, href: url(`case-studies/${r.slug}/`), type: 'Case study' };
};

const kinds = Object.keys(kindLabels) as QuestionKind[];
const levels: QuestionLevel[] = ['beginner', 'intermediate', 'advanced'];
const rows = interviewQuestions.map((q) => ({
  ...q,
  links: q.read.map((r) => link(r, q.id)),
  haystack: [q.question, q.summary, ...q.covers, ...q.followUps].join(' ').toLowerCase(),
}));
const count = (f: (q: (typeof rows)[number]) => boolean) => rows.filter(f).length;
// Only what the drill needs goes to the browser.
const drillData = JSON.stringify(rows.map((q) => ({ id: q.id, kind: q.kind, level: q.level, question: q.question, summary: q.summary, covers: q.covers, links: q.links })))
  .replace(/</g, '\\u003c');
---
<Layout title="Interview questions | System Design Academy" description="24 system design interview questions with model answers: what a strong answer covers, likely follow-ups, common pitfalls and pages to read. Filter, search, or drill with a timer and grade yourself.">
  <PageHead eyebrow="Interview questions" title="Questions to practise, with model answers" lede="Concept questions, design questions and the trade-off and story questions that come with them. Open one to see what a strong answer includes, or let Drill me pick one, start a clock and grade yourself. Grades stay in this browser." />

  <section class="card drill" aria-labelledby="drill-h" data-drill>
    <h2 id="drill-h">Drill me</h2>
    <div data-setup>
      <p class="hint">Pick a question you have not graded yet, say your answer out loud before the clock ends, then tick the points you covered.</p>
      <div class="opts">
        <fieldset class="mins-set">
          <legend>Time</legend>
          {[2, 3, 5].map((m, i) => (
            <label class="radio"><input type="radio" name="mins" value={m} checked={i === 1} /> {m} min</label>
          ))}
        </fieldset>
        <div class="sel"><label for="d-kind">Kind</label>
          <select id="d-kind" class="pg-in" data-d-kind>
            <option value="all">Any kind</option>
            {kinds.map((k) => <option value={k}>{kindLabels[k]}</option>)}
          </select></div>
        <div class="sel"><label for="d-level">Level</label>
          <select id="d-level" class="pg-in" data-d-level>
            <option value="all">Any level</option>
            {levels.map((l) => <option value={l}>{l[0].toUpperCase() + l.slice(1)}</option>)}
          </select></div>
      </div>
      <div class="actions"><button type="button" class="btn pg-primary" data-draw>Draw a question</button></div>
      <p class="note" data-empty hidden></p>
    </div>

    <div data-run hidden>
      <p class="meta mono" data-meta></p>
      <h3 class="dq" data-question tabindex="-1"></h3>
      <div data-timer-box>
        <p class="clock"><span class="time mono" data-time role="timer">0:00</span></p>
        <div class="actions">
          <button type="button" class="btn pg-primary" data-pause>Pause</button>
          <button type="button" class="btn" data-reveal>Show the points now</button>
          <button type="button" class="btn" data-skip>Different question</button>
        </div>
      </div>
      <div data-result hidden>
        <h4 class="rh" data-result-h tabindex="-1">Tick the points you covered</h4>
        <p class="short" data-summary></p>
        <form data-grade onsubmit="return false">
          <fieldset class="points"><legend class="sr">Points a strong answer covers</legend><ul data-points></ul></fieldset>
          <p class="score" data-score aria-live="polite"></p>
          <div class="actions">
            <button type="submit" class="btn pg-primary" data-save>Save my grade</button>
            <button type="button" class="btn" data-next>Draw another</button>
          </div>
        </form>
        <p class="readline" data-read hidden></p>
      </div>
    </div>

    <p class="sr" data-announce aria-live="polite"></p>
    <p class="tally mono" data-tally></p>
  </section>

  <form class="toolbar" role="search" data-filters onsubmit="return false">
    <div class="field">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <label class="sr" for="q">Search the questions</label>
      <input id="q" type="search" placeholder="Search, e.g. cache, retry, queue, shard" autocomplete="off" data-q />
    </div>
    <div class="toolbar-row">
      <div class="chips" role="group" aria-label="Kind">
        <button type="button" class="chip-btn" data-kind="all" aria-pressed="true">All kinds <span>{rows.length}</span></button>
        {kinds.map((k) => <button type="button" class="chip-btn" data-kind={k} aria-pressed="false">{kindLabels[k]} <span>{count((q) => q.kind === k)}</span></button>)}
      </div>
      <div class="chips" role="group" aria-label="Level">
        <button type="button" class="chip-btn" data-level="all" aria-pressed="true">Any level</button>
        {levels.map((l) => <button type="button" class="chip-btn cap" data-level={l} aria-pressed="false">{l} <span>{count((q) => q.level === l)}</span></button>)}
      </div>
      <p class="status"><span data-count aria-live="polite"></span> <button type="button" class="linklike" data-reset hidden>Clear filters</button></p>
    </div>
  </form>

  <p class="empty" data-none hidden>No questions match. Try fewer words or clear the filters.</p>
  <ul class="list">
    {rows.map((q) => (
      <li class="card q" data-id={q.id} data-kind={q.kind} data-level={q.level} data-text={q.haystack}>
        <details>
          <summary>
            <span class="qtext">{q.question}</span>
            <span class="tags"><span class="tag">{kindLabels[q.kind]}</span><span class="tag cap">{q.level}</span><span class="tag grade" data-grade-tag hidden></span></span>
          </summary>
          <div class="body">
            <p class="short">{q.summary}</p>
            <h3>A strong answer covers</h3>
            <ul>{q.covers.map((c) => <li>{c}</li>)}</ul>
            <h3>Likely follow-ups</h3>
            <ul>{q.followUps.map((c) => <li>{c}</li>)}</ul>
            <h3>Common pitfalls</h3>
            <ul>{q.pitfalls.map((c) => <li>{c}</li>)}</ul>
            <h3>Read next</h3>
            <ul class="reads">{q.links.map((l) => <li><a href={l.href}>{l.name}</a> <span class="type">{l.type}</span></li>)}</ul>
          </div>
        </details>
      </li>
    ))}
  </ul>
  <p class="foot">Looking for how to spend the 45 minutes? Read the <a href={url('interview-guide/')}>interview guide</a>, or run a full <a href={url('interview/')}>mock interview</a>.</p>
  <script type="application/json" id="iq-data" set:html={drillData} />
</Layout>
<script>
  type Link = { name: string; href: string; type: string };
  type Q = { id: string; kind: string; level: string; question: string; summary: string; covers: string[]; links: Link[] };
  type Grade = { c: number; t: number };

  const data: Q[] = JSON.parse(document.getElementById('iq-data')!.textContent || '[]');
  const byId = new Map(data.map((q) => [q.id, q]));
  const $ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;

  // Self-grades live in this browser only. Everything still works for the session if storage is blocked.
  const KEY = 'sda-interview-questions';
  let grades: Record<string, Grade> = {};
  try {
    const raw = JSON.parse(localStorage.getItem(KEY) || '{}');
    for (const [id, g] of Object.entries(raw as Record<string, Grade>)) if (byId.has(id) && g && Number.isFinite(g.c) && Number.isFinite(g.t)) grades[id] = { c: g.c, t: g.t };
  } catch { grades = {}; }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(grades)); } catch { /* keep going without storage */ } };

  // ---- Browse: filter and search
  const root = $('[data-filters]');
  const input = $<HTMLInputElement>('[data-q]');
  const items = [...document.querySelectorAll<HTMLElement>('.q')];
  const state = { q: '', kind: 'all', level: 'all' };
  const countEl = $('[data-count]'), resetBtn = $('[data-reset]'), none = $('[data-none]');

  function apply() {
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const li of items) {
      const ok = (state.kind === 'all' || li.dataset.kind === state.kind) && (state.level === 'all' || li.dataset.level === state.level)
        && words.every((w) => (li.dataset.text || '').includes(w));
      li.hidden = !ok;
      if (ok) shown++;
    }
    root.querySelectorAll<HTMLElement>('[data-kind]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === state.kind)));
    root.querySelectorAll<HTMLElement>('[data-level]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.level === state.level)));
    countEl.textContent = `${shown} of ${items.length} questions`;
    resetBtn.hidden = !(state.q || state.kind !== 'all' || state.level !== 'all');
    none.hidden = shown > 0;
  }
  input.addEventListener('input', () => { state.q = input.value; apply(); });
  root.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('.chip-btn');
    if (!b) return;
    if (b.dataset.kind) state.kind = b.dataset.kind;
    else if (b.dataset.level) state.level = b.dataset.level;
    apply();
  });
  resetBtn.addEventListener('click', () => { state.q = ''; state.kind = 'all'; state.level = 'all'; input.value = ''; apply(); input.focus(); });
  input.addEventListener('keydown', (e) => { if (e.key === 'Escape') { input.value = ''; state.q = ''; apply(); } });

  function showGrades() {
    for (const li of items) {
      const tag = $('[data-grade-tag]', li), g = grades[li.dataset.id!];
      tag.hidden = !g;
      if (g) tag.textContent = `Self-graded ${g.c} of ${g.t}`;
    }
  }

  // ---- Drill
  const drill = $('[data-drill]');
  const setup = $('[data-setup]', drill), run = $('[data-run]', drill), emptyMsg = $('[data-empty]', drill);
  const qEl = $('[data-question]', drill), meta = $('[data-meta]', drill), timeEl = $('[data-time]', drill);
  const timerBox = $('[data-timer-box]', drill), pauseBtn = $('[data-pause]', drill), result = $('[data-result]', drill);
  const announce = $('[data-announce]', drill), tallyEl = $('[data-tally]', drill);
  const points = $('[data-points]', drill), scoreEl = $('[data-score]', drill), summaryEl = $('[data-summary]', drill), readEl = $('[data-read]', drill);
  const saveBtn = $<HTMLButtonElement>('[data-save]', drill);

  let current: Q | null = null;
  let total = 0, remaining = 0, deadline = 0, running = false, tick = 0;
  let said = new Set<number>();

  const clock = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  const say = (t: string) => { announce.textContent = ''; setTimeout(() => { announce.textContent = t; }, 50); };

  function tally() {
    const ids = Object.keys(grades);
    const got = ids.reduce((n, id) => n + grades[id].c, 0), all = ids.reduce((n, id) => n + grades[id].t, 0);
    tallyEl.innerHTML = '';
    tallyEl.append(ids.length ? `Graded ${ids.length} of ${data.length} questions. Points covered: ${got} of ${all}. ` : `Graded 0 of ${data.length} questions. `);
    if (ids.length) {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'linklike'; b.textContent = 'Clear my grades';
      b.addEventListener('click', () => {
        if (!confirm('Clear all your self-grades on this browser?')) return;
        grades = {}; save(); tally(); showGrades();
      });
      tallyEl.append(b);
    }
  }

  function stopTimer() { running = false; clearInterval(tick); }
  function paint() { timeEl.textContent = clock(Math.max(0, Math.ceil(remaining / 1000))); }

  function loop() {
    remaining = Math.max(0, deadline - Date.now());
    paint();
    const secs = Math.ceil(remaining / 1000);
    // Milestones only, never every second.
    const marks: [number, string][] = [[120, '2 minutes left.'], [60, '1 minute left.'], [30, '30 seconds left.']];
    for (const [at, msg] of marks) if (total > at && secs <= at && !said.has(at)) { said.add(at); say(msg); }
    if (remaining <= 0) { stopTimer(); showResult('Time is up.'); }
  }
  function startTimer() {
    deadline = Date.now() + remaining; running = true;
    clearInterval(tick); tick = window.setInterval(loop, 250);
    pauseBtn.textContent = 'Pause';
  }
  function togglePause() {
    if (running) { remaining = Math.max(0, deadline - Date.now()); stopTimer(); pauseBtn.textContent = 'Resume'; say('Paused.'); }
    else { startTimer(); say('Resumed.'); }
  }

  function pool() {
    const kind = ($('[data-d-kind]', drill) as HTMLSelectElement).value, level = ($('[data-d-level]', drill) as HTMLSelectElement).value;
    return data.filter((q) => (kind === 'all' || q.kind === kind) && (level === 'all' || q.level === level));
  }
  function draw() {
    const all = pool();
    const fresh = all.filter((q) => !grades[q.id] && q.id !== current?.id);
    emptyMsg.hidden = true;
    if (!fresh.length) {
      emptyMsg.textContent = all.length ? 'You have graded every question in this selection. Pick another kind or level, or clear your grades below.' : 'No questions match that selection.';
      emptyMsg.hidden = false; setup.hidden = false; run.hidden = true;
      return;
    }
    current = fresh[Math.floor(Math.random() * fresh.length)];
    const mins = Number((document.querySelector<HTMLInputElement>('input[name="mins"]:checked') || { value: '3' }).value);
    total = mins * 60; remaining = total * 1000; said = new Set();
    setup.hidden = true; run.hidden = false; result.hidden = true; timerBox.hidden = false;
    meta.textContent = `${current.kind === 'concept' ? 'Concept' : current.kind === 'design' ? 'Design' : 'Trade-off and story'} · ${current.level} · ${mins} min`;
    qEl.textContent = current.question;
    paint(); startTimer();
    say(`Question drawn. ${mins} minutes on the clock.`);
    qEl.focus();
  }

  function updateScore() {
    const boxes = [...points.querySelectorAll<HTMLInputElement>('input')];
    scoreEl.textContent = `${boxes.filter((b) => b.checked).length} of ${boxes.length} points covered`;
  }
  function showResult(why: string) {
    if (!current) return;
    stopTimer();
    timerBox.hidden = true; result.hidden = false;
    summaryEl.textContent = current.summary;
    points.innerHTML = '';
    current.covers.forEach((c, i) => {
      const li = document.createElement('li'), label = document.createElement('label'), cb = document.createElement('input');
      cb.type = 'checkbox'; cb.id = `pt-${i}`;
      cb.addEventListener('change', updateScore);
      label.append(cb, ' ', c); li.append(label); points.append(li);
    });
    readEl.hidden = !current.links.length;
    readEl.textContent = 'Read next: ';
    current.links.forEach((l, i) => {
      const a = document.createElement('a'); a.href = l.href; a.textContent = l.name;
      readEl.append(i ? ', ' : '', a);
    });
    updateScore();
    saveBtn.disabled = false; saveBtn.textContent = 'Save my grade';
    say(`${why} Here are the points a strong answer covers. Tick the ones you covered.`);
    $('[data-result-h]', drill).focus();
  }

  $('[data-draw]', drill).addEventListener('click', draw);
  pauseBtn.addEventListener('click', togglePause);
  $('[data-reveal]', drill).addEventListener('click', () => showResult('Clock stopped.'));
  $('[data-skip]', drill).addEventListener('click', () => { stopTimer(); draw(); });
  $('[data-next]', drill).addEventListener('click', draw);
  $('[data-grade]', drill).addEventListener('submit', () => {
    if (!current) return;
    const boxes = [...points.querySelectorAll<HTMLInputElement>('input')];
    grades[current.id] = { c: boxes.filter((b) => b.checked).length, t: boxes.length };
    save(); tally(); showGrades();
    saveBtn.textContent = 'Saved'; saveBtn.disabled = true;
    say(`Saved. ${grades[current.id].c} of ${grades[current.id].t} points.`);
  });

  apply(); showGrades(); tally();
</script>
<style>
  .drill { margin: .5rem 0 1.75rem; padding: 18px; display: grid; gap: 12px; }
  .drill h2 { margin: 0; font-size: 1.3rem; }
  .hint, .note, .meta { margin: 0 0 10px; color: var(--muted); }
  .opts { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: end; margin-bottom: 12px; }
  .mins-set { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: center; min-width: 0; }
  .mins-set legend, .sel label { font: .75rem var(--font-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--muted); padding: 0; }
  .mins-set legend { float: left; margin-right: 12px; }
  .radio { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; cursor: pointer; }
  .radio input { width: 18px; height: 18px; accent-color: var(--accent); }
  .sel { display: grid; gap: 4px; min-width: 0; }
  .sel select { min-height: 40px; max-width: 100%; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .dq { margin: 0 0 8px; font-size: 1.3rem; line-height: 1.3; overflow-wrap: anywhere; }
  .dq:focus-visible, .rh:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .clock { margin: 0 0 10px; }
  [data-time] { font: 600 2.4rem var(--font-mono); font-variant-numeric: tabular-nums; }
  .rh { margin: 0 0 6px; font-size: 1.05rem; }
  .short { margin: 0 0 10px; color: var(--muted); }
  .points { border: 0; margin: 0 0 8px; padding: 0; min-width: 0; }
  .points ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .points :global(label) { display: flex; gap: 10px; align-items: flex-start; padding: 8px 10px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); cursor: pointer; min-height: 40px; overflow-wrap: anywhere; }
  .points :global(input) { flex: none; width: 18px; height: 18px; margin-top: 3px; accent-color: var(--accent); }
  .score { margin: 0 0 10px; font: 600 .95rem var(--font-mono); color: var(--accent); }
  .readline { margin: 12px 0 0; color: var(--muted); }
  .tally { margin: 0; color: var(--muted); font-size: .82rem; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .cap { text-transform: capitalize; }
  .empty { margin: 3rem 0; text-align: center; color: var(--muted); }
  .list { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; gap: 10px; }
  .list > li[hidden] { display: none; }
  .q { padding: 0; }
  .q summary { list-style: none; cursor: pointer; display: grid; gap: 8px; padding: 14px 16px 14px 40px; border-radius: var(--radius); position: relative; }
  .q summary::-webkit-details-marker { display: none; }
  .q summary::before { content: '+'; position: absolute; left: 16px; top: 11px; font: 600 1.2rem var(--font-mono); color: var(--accent); }
  .q details[open] > summary::before { content: '\2212'; }
  .q summary:hover { background: var(--surface-2); }
  .q details[open] > summary { border-bottom: 1px solid var(--border); border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .qtext { font-weight: 600; overflow-wrap: anywhere; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag { padding: 1px 10px; border-radius: 999px; border: 1px solid var(--border); font: .74rem var(--font-mono); color: var(--muted); }
  .tag.grade { border-color: var(--good); color: var(--good-text); background: var(--good-soft); }
  .tag[hidden] { display: none; }
  .body { padding: 14px 16px 16px 40px; display: grid; gap: 4px; }
  .body h3 { margin: 10px 0 2px; font: 500 .8rem var(--font-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .body ul { margin: 0; padding-left: 1.2rem; }
  .body li { margin: 3px 0; overflow-wrap: anywhere; }
  .body .short { margin: 0; color: var(--text); }
  .reads { list-style: none; padding-left: 0 !important; display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .type { color: var(--muted); font: .74rem var(--font-mono); }
  .foot { color: var(--muted); margin-bottom: 3rem; }
  @media (max-width: 480px) {
    .body { padding-left: 16px; }
    [data-time] { font-size: 2rem; }
  }
</style>
