---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { url } from '../lib';

// A short guide to the interview itself: what is being judged, how to spend the time, what to say, and which pages to read for common questions.
const concepts = await getCollection('concepts');
const studies = await getCollection('studies');
const concept = (slug: string) => {
  const hit = concepts.find((c) => c.id === slug);
  if (!hit) throw new Error(`Interview guide references unknown concept "${slug}"`);
  return { name: hit.data.name, href: url(`concepts/${slug}/`) };
};
const study = (slug: string) => {
  const hit = studies.find((c) => c.id === slug);
  if (!hit) throw new Error(`Interview guide references unknown case study "${slug}"`);
  return { name: hit.data.name, href: url(`case-studies/${slug}/`) };
};

const signals = [
  { title: 'You ask before you build', text: 'Real systems have requirements. Interviewers watch for questions about users, scale and what must never go wrong, before you draw anything.' },
  { title: 'You can reason with numbers', text: 'Rough arithmetic is enough: requests per second, data per year. The point is to show which part will be the hard part.' },
  { title: 'You start simple, then fix what breaks', text: 'A single server and one database is a fine first design. Then you say what fails first and change only that.' },
  { title: 'You name the trade-off', text: 'Every choice costs something. "I pick this, and I accept that" is worth more than a long list of technologies.' },
];

// Shares match the Mock interview page; the minutes add up to 45.
const plan = [
  { stage: 'Clarify', share: 10, mins: 5, say: ['Who uses this, and roughly how many of them?', 'Is it mostly reads or mostly writes?', 'What must never go wrong: lost data, double charges, stale answers?', 'I will assume X. Tell me if that is wrong.'] },
  { stage: 'Estimate', share: 10, mins: 5, say: ['Say 10 million users a day, 10 actions each: about 1,200 requests a second on average.', 'Peak is often 2 to 3 times the average, so I will size for about 3,000.', 'A year of this is about 5 TB, so one disk is not enough but a few machines are.'] },
  { stage: 'High-level design', share: 35, mins: 16, say: ['The simplest version is a web server and a database. Here is the API.', 'These are the main tables or documents and their keys.', 'This is the path of one request, from the client to the data and back.'] },
  { stage: 'Deep dive', share: 30, mins: 13, say: ['The first thing to break at this scale is the database, because of X.', 'I can fix it with A or B. A is simpler, B scales further. I pick A because...', 'The cost of that choice is...'] },
  { stage: 'Wrap up', share: 15, mins: 6, say: ['If this component fails, the user sees X, and we recover by Y.', 'I would watch these two numbers and alert when they cross Z.', 'With more time, I would look at...'] },
];

const mistakes = [
  { wrong: 'Jumping straight to a diagram.', fix: 'Spend the first five minutes on questions and assumptions. Write them down where the interviewer can see them.' },
  { wrong: 'Naming a product for every box.', fix: 'Say what the box must do ("a store that keeps data sorted by key") and name a product only if asked.' },
  { wrong: 'Designing for a billion users first.', fix: 'Start with the simplest design that works for the numbers you estimated, and scale the part that breaks.' },
  { wrong: 'Going silent while you think.', fix: 'Think aloud. A wrong turn you notice and fix yourself is a good sign.' },
  { wrong: 'Treating the interviewer as an examiner.', fix: 'Treat them as a teammate. Check in: "Does this direction make sense, or would you like me to go deeper somewhere?"' },
  { wrong: 'Never saying what fails.', fix: 'For each main component, say what the user sees when it is down. Then say how you would notice.' },
];

const swaps = [
  { ask: 'SQL or NoSQL?', say: 'Relational if I need joins or transactions across rows; a key-value or document store if access is by key and I need to spread writes.', slug: 'sql-vs-nosql' },
  { ask: 'Consistency or availability?', say: 'During a partition I choose per feature: money and inventory favour consistency; feeds and counters can serve slightly old data.', slug: 'cap-theorem' },
  { ask: 'Push or pull?', say: 'Push work when reads are far more common than writes and followers are few; pull at read time when a few accounts have huge followings.', slug: 'pub-sub' },
  { ask: 'How do you scale reads?', say: 'Cache first, then read replicas, and only then split the data across shards.', slug: 'caching' },
  { ask: 'How do you scale writes?', say: 'Shard by a key that spreads load evenly, and queue work that does not need an answer now.', slug: 'database-sharding' },
  { ask: 'What if a request is repeated?', say: 'Give it an idempotency key so the second attempt returns the first result instead of repeating the work.', slug: 'idempotency' },
  { ask: 'What if a dependency is slow?', say: 'Set a timeout, retry with backoff for a limited time, and stop calling it with a circuit breaker.', slug: 'circuit-breaker' },
  { ask: 'How do you keep order?', say: 'Order only matters per key, so route everything for one key to one partition.', slug: 'ordering-and-partitioning' },
];
const swapRows = swaps.map((s) => ({ ...s, ...concept(s.slug) }));

const questions = [
  { q: 'Design a URL shortener', study: 'url-shortener', ideas: ['caching', 'database-sharding', 'consistent-hashing'] },
  { q: 'Design a chat system', study: 'chat-system', ideas: ['real-time-communication', 'message-queues', 'ordering-and-partitioning'] },
  { q: 'Design a news feed', study: 'news-feed', ideas: ['caching', 'pub-sub', 'database-sharding'] },
  { q: 'Design a rate limiter', study: 'rate-limiter-service', ideas: ['rate-limiting', 'load-shedding', 'caching'] },
  { q: 'Design a notification system', study: 'notification-system', ideas: ['message-queues', 'retries-and-backoff', 'idempotency'] },
  { q: 'Design ticket booking', study: 'ticket-booking', ideas: ['mvcc-and-isolation-levels', 'optimistic-concurrency-and-etags', 'idempotency'] },
  { q: 'Design a payment system', study: 'payment-system', ideas: ['idempotency', 'saga', 'transactional-outbox'] },
  { q: 'Design a key-value store', study: 'key-value-store', ideas: ['consistent-hashing', 'quorums', 'lsm-trees-vs-b-trees'] },
  { q: 'Design a distributed cache', study: 'distributed-cache', ideas: ['caching', 'consistent-hashing', 'cap-theorem'] },
  { q: 'Design search autocomplete', study: 'search-autocomplete', ideas: ['caching', 'database-indexing'] },
  { q: 'Design a web crawler', study: 'web-crawler', ideas: ['probabilistic-data-structures', 'message-queues', 'rate-limiting'] },
  { q: 'Design video streaming', study: 'video-streaming', ideas: ['cdn', 'caching'] },
  { q: 'Design a ride-sharing service', study: 'ride-sharing', ideas: ['geospatial-indexing', 'real-time-communication'] },
  { q: 'Design photo sharing', study: 'photo-sharing', ideas: ['cdn', 'caching'] },
  { q: 'Design a leaderboard', study: 'leaderboard', ideas: ['caching', 'database-sharding'] },
  { q: 'Design metrics and monitoring', study: 'metrics-monitoring', ideas: ['metrics', 'alerting', 'cardinality-and-sampling'] },
  { q: 'Design a distributed lock', study: 'distributed-lock-service', ideas: ['leases-and-fencing-tokens', 'consensus'] },
  { q: 'Design a collaborative editor', study: 'collaborative-editor', ideas: ['crdts', 'logical-clocks'] },
].map((r) => ({ q: r.q, study: study(r.study), ideas: r.ideas.map(concept) }));

const before = [
  'Say the five stages out loud once, with the minutes. Your clock matters as much as your design.',
  'Pick three numbers you can estimate from memory (requests per second, storage per year, bandwidth) and practise the arithmetic.',
  'Do one Mock interview and say your answers aloud instead of typing them.',
  'Open Review and clear whatever is due. Questions you missed are the ones to read again.',
  'Sleep. A tired mind forgets to ask questions.',
];
const tools = [
  { href: 'interview/', title: 'Mock interview', text: 'A random task, a clock and five stages.' },
  { href: 'interview-questions/', title: 'Interview questions', text: '24 questions with model answers, and a timed Drill me mode.' },
  { href: 'review/', title: 'Review', text: 'Spaced quiz questions across the whole site.' },
  { href: 'paths/', title: 'One week to an interview', text: 'Seven short sessions that end with a mock interview.' },
  { href: 'cheatsheets/', title: 'Cheat sheets', text: 'One printable page per area.' },
];
---
<Layout title="Interview guide | System Design Academy" description="How a system design interview is judged, how to spend the 45 minutes, what to say at each stage, common mistakes, and which pages to read for 18 classic questions.">
  <PageHead eyebrow="Interview guide" title="What the interview is really testing" lede="A system design interview is a conversation about trade-offs, not a quiz with one right answer. Here is what is being judged, how to spend the time, and where to read for the questions that come up most." />

  <nav class="toc card" aria-label="On this page">
    <ol>
      <li><a href="#judged">What is judged</a></li>
      <li><a href="#plan">The 45 minutes</a></li>
      <li><a href="#mistakes">Common mistakes</a></li>
      <li><a href="#swaps">Questions you will be asked</a></li>
      <li><a href="#questions">Classic questions, mapped</a></li>
      <li><a href="#before">The day before</a></li>
    </ol>
  </nav>

  <section id="judged" aria-labelledby="judged-h">
    <h2 id="judged-h"><span class="num mono">01</span> What is judged</h2>
    <ul class="grid signals">
      {signals.map((s) => <li class="card"><h3>{s.title}</h3><p>{s.text}</p></li>)}
    </ul>
    <p class="note">You are not expected to know one right design. Clear thinking stands out more than a long list of technologies.</p>
  </section>

  <section id="plan" aria-labelledby="plan-h">
    <h2 id="plan-h"><span class="num mono">02</span> The 45 minutes</h2>
    <p>The same five stages as the <a href={url('interview/')}>Mock interview</a>. The minutes below are for a 45 minute interview; the Mock interview scales them to the length you choose.</p>
    <ol class="plan">
      {plan.map((p) => (
        <li class="card">
          <div class="head"><h3>{p.stage}</h3><span class="mins mono">about {p.mins} min</span></div>
          <p class="sub">Things you might say:</p>
          <ul>{p.say.map((l) => <li>“{l}”</li>)}</ul>
        </li>
      ))}
    </ol>
  </section>

  <section id="mistakes" aria-labelledby="mistakes-h">
    <h2 id="mistakes-h"><span class="num mono">03</span> Common mistakes</h2>
    <ul class="mist">
      {mistakes.map((m) => (
        <li class="card"><p class="wrong"><span class="tag">Instead of</span> {m.wrong}</p><p class="fix"><span class="tag good">Try</span> {m.fix}</p></li>
      ))}
    </ul>
  </section>

  <section id="swaps" aria-labelledby="swaps-h">
    <h2 id="swaps-h"><span class="num mono">04</span> Questions you will be asked</h2>
    <p>Short answers to the follow-ups that come up in almost every interview. Each links to the page that explains the idea.</p>
    <dl class="swaps">
      {swapRows.map((s) => (
        <div class="card">
          <dt>{s.ask}</dt>
          <dd>{s.say} <a href={s.href}>Read: {s.name}</a></dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="questions" aria-labelledby="questions-h">
    <h2 id="questions-h"><span class="num mono">05</span> Classic questions, mapped</h2>
    <p>For each question, the case study that works through it, and the ideas worth naming while you answer.</p>
    <div class="table-wrap" role="region" aria-label="Classic questions and where to read" tabindex="0">
      <table>
        <thead><tr><th scope="col">If you are asked</th><th scope="col">Read the case study</th><th scope="col">Ideas to name</th></tr></thead>
        <tbody>
          {questions.map((r) => (
            <tr>
              <th scope="row">{r.q}</th>
              <td><a href={r.study.href}>{r.study.name}</a></td>
              <td><ul class="chips">{r.ideas.map((i) => <li><a href={i.href}>{i.name}</a></li>)}</ul></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="before" aria-labelledby="before-h">
    <h2 id="before-h"><span class="num mono">06</span> The day before</h2>
    <ul class="check">{before.map((b) => <li>{b}</li>)}</ul>
    <h3 class="eyebrow">Tools to practise with</h3>
    <p>Want model answers to practise against? <a href={url('interview-questions/')}>Interview questions</a> shows what a strong answer covers, and can time you while you answer.</p>
    <ul class="grid tools">
      {tools.map((t) => <li><a class="card tool" href={url(t.href)}><strong>{t.title}</strong><span>{t.text}</span></a></li>)}
    </ul>
  </section>
</Layout>
<style>
  section { margin-bottom: 2.75rem; }
  h2 { display: flex; align-items: baseline; gap: 10px; margin: 0 0 12px; }
  .num { color: var(--accent); font-size: .9rem; }
  .toc { padding: 14px 18px; margin-bottom: 2rem; }
  .toc ol { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .grid { list-style: none; margin: 0 0 12px; padding: 0; display: grid; gap: 12px; }
  .signals { grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .signals li { padding: 16px; }
  .signals h3, .plan h3 { margin: 0 0 6px; font-size: 1.05rem; }
  .signals p { margin: 0; color: var(--muted); }
  .note { color: var(--muted); }
  .plan { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; counter-reset: stage; }
  .plan > li { padding: 16px; }
  .plan .head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .plan .head h3 { margin: 0; }
  .plan .head h3::before { counter-increment: stage; content: counter(stage) ". "; color: var(--accent); }
  .mins { color: var(--muted); font-size: .85rem; }
  .sub { margin: 8px 0 4px; color: var(--muted); font-size: .9rem; }
  .plan ul { margin: 0; padding-left: 1.2rem; }
  .plan li li { margin: 2px 0; }
  .mist { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); }
  .mist li { padding: 16px; display: grid; gap: 8px; }
  .mist p { margin: 0; }
  .tag { display: inline-block; margin-right: 6px; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--border); font: .72rem var(--font-mono); color: var(--muted); }
  .tag.good { border-color: var(--accent); color: var(--accent); }
  .swaps { display: grid; gap: 10px; margin: 0; }
  .swaps .card { padding: 14px 16px; }
  .swaps dt { font-weight: 600; margin-bottom: 4px; }
  .swaps dd { margin: 0; color: var(--muted); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
  .table-wrap:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  table { width: 100%; border-collapse: collapse; min-width: 560px; }
  th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
  thead th { background: var(--surface-2); font-size: .85rem; color: var(--muted); }
  tbody tr:last-child > * { border-bottom: 0; }
  tbody th { font-weight: 600; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .check { padding-left: 1.2rem; }
  .check li { margin: 6px 0; }
  .tools { grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); }
  .tools li { display: flex; min-width: 0; }
  .tool { flex: 1; display: grid; gap: 4px; padding: 14px 16px; color: var(--text); text-decoration: none; }
  .tool span { color: var(--muted); font-size: .92rem; }
  .tool:hover { border-color: var(--accent); }
  .tool:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 640px) { table { min-width: 0; } th, td { padding: 8px 10px; } }
</style>
