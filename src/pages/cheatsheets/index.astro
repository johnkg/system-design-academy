---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib';
import { areas } from '../../data/areas';

const concepts = await getCollection('concepts');
const count = (id: string) => (id === 'patterns' ? 23 : concepts.filter((c) => c.data.area === id).length);
const shown = areas.filter((a) => count(a.id) > 0);
---
<Layout title="Cheat sheets | System Design Academy" description="One printable page per area: what each idea is for, when to use it, when to skip it, and the main trap.">
  <section class="hero">
    <h1>Cheat sheets</h1>
    <p class="lede">One page per area for quick revision or printing. Each idea gets its purpose, when to use it, when to skip it and the main trap. Open the full page when a line is not enough.</p>
  </section>
  <div class="grid">
    {shown.map((a) => (
      <a class="card tool" href={url(`cheatsheets/${a.id}/`)}>
        <h2>{a.label}</h2>
        <p>{a.blurb}.</p>
        <small>{count(a.id)} {a.id === 'patterns' ? 'patterns' : 'concepts'}</small>
      </a>
    ))}
  </div>
</Layout>
<style>
  .hero { padding: 2.5rem 0 1rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .4rem; }
  .grid { grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); margin-bottom: 3rem; }
  .tool { text-decoration: none; color: var(--text); display: block; transition: transform .15s, border-color .15s; }
  .tool:hover { transform: translateY(-2px); border-color: var(--accent); }
  .tool h2 { margin: 0 0 .3rem; font-size: 1.1rem; }
  .tool p { margin: 0 0 .5rem; color: var(--muted); }
  .tool small { color: var(--accent); }
</style>
