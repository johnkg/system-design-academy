---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib';
import { areas } from '../../data/areas';

// One printable page per area: every concept (or pattern) with what it is for, when to use it, when to skip it and the main trap.
export async function getStaticPaths() {
  const concepts = (await getCollection('concepts')).sort((a, b) => a.data.name.localeCompare(b.data.name));
  const patterns = await getCollection('patterns');
  return areas.filter((a) => a.id === 'patterns' || concepts.some((c) => c.data.area === a.id)).map((area) => ({
    params: { area: area.id },
    props: {
      area,
      items: area.id === 'patterns'
        ? patterns.sort((a, b) => a.data.category.localeCompare(b.data.category) || a.data.name.localeCompare(b.data.name)).map((p) => ({
            href: url(`patterns/${p.id}/`), name: p.data.name, tag: p.data.category, intent: p.data.intent,
            use: p.data.whenToUse.slice(0, 2), skip: p.data.whenNotToUse.slice(0, 2), trap: p.data.pitfalls.slice(0, 2),
          }))
        : concepts.filter((c) => c.data.area === area.id).map((c) => ({
            href: url(`concepts/${c.id}/`), name: c.data.name, tag: c.data.difficulty, intent: c.data.intent,
            use: c.data.whenToUse.slice(0, 2), skip: c.data.whenNotToUse.slice(0, 2), trap: c.data.pitfalls.slice(0, 2),
          })),
    },
  }));
}
const { area, items } = Astro.props;
---
<Layout title={`${area.label} cheat sheet | System Design Academy`} description={`A one-page summary of ${area.label.toLowerCase()}: what each idea is for, when to use it, when to skip it, and the main trap.`}>
  <nav class="crumbs noprint" aria-label="Breadcrumb">
    <ol><li><a href={url('cheatsheets/')}>Cheat sheets</a></li><li aria-current="page">{area.label}</li></ol>
  </nav>
  <header>
    <h1>{area.label}</h1>
    <p class="lede">{area.blurb}. {items.length} {area.id === 'patterns' ? 'patterns' : 'concepts'}.</p>
    <p class="noprint"><button type="button" class="btn pg-primary" data-print>Print or save as PDF</button></p>
  </header>
  <div class="sheet">
    {items.map((i) => (
      <article class="item">
        <h2><a href={i.href}>{i.name}</a> <small class="cap">{i.tag}</small></h2>
        <p class="intent">{i.intent}</p>
        <dl>
          <dt>Use when</dt><dd><ul>{i.use.map((x) => <li>{x}</li>)}</ul></dd>
          <dt>Skip when</dt><dd><ul>{i.skip.map((x) => <li>{x}</li>)}</ul></dd>
          <dt>Watch out</dt><dd><ul>{i.trap.map((x) => <li>{x}</li>)}</ul></dd>
        </dl>
      </article>
    ))}
  </div>
</Layout>
<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
<style>
  .crumbs { padding-top: 1rem; font-size: .9rem; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; color: var(--muted); }
  .crumbs li + li::before { content: '›'; margin-right: 6px; }
  .crumbs [aria-current] { color: var(--text); font-weight: 600; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: .5rem 0 .3rem; }
  .sheet { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 12px; margin: 1rem 0 3rem; }
  .item { border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px 12px; background: var(--surface); min-width: 0; break-inside: avoid; }
  .item h2 { font-size: 1.05rem; margin: 0 0 .2rem; }
  .item h2 small { font-weight: 500; color: var(--muted); font-size: .75rem; margin-left: .3rem; }
  .intent { margin: 0 0 .4rem; color: var(--muted); font-size: .92rem; }
  dl { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; font-size: .88rem; }
  dt { font-weight: 700; margin-top: .3rem; }
  dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  dd ul { margin: 0; padding-left: 1.1rem; }
  .cap { text-transform: capitalize; }
</style>
<style is:global>
  @media print {
    .site-header, .foot, .skip, .noprint { display: none !important; }
    html, body { background: #fff !important; color: #000 !important; }
    main { max-width: none !important; padding: 0 !important; }
    .item { border-color: #999 !important; background: #fff !important; box-shadow: none !important; }
    .item * { color: #000 !important; }
    .sheet { grid-template-columns: repeat(2, 1fr) !important; gap: 8px !important; }
    a { text-decoration: none; }
    @page { margin: 12mm; }
  }
</style>
