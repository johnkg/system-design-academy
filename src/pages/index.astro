---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { url, getCode } from '../lib';
import { areas } from '../data/areas';

interface Item {
  href: string; name: string; intent: string; difficulty: string;
  area: string; sub?: string; langs: string[]; text: string; key: string;
}

const patterns = await getCollection('patterns');
const concepts = await getCollection('concepts');
const items: Item[] = [
  ...concepts.map((c) => ({
    href: url(`concepts/${c.id}/`), key: `concepts/${c.id}`, name: c.data.name, intent: c.data.intent, difficulty: c.data.difficulty,
    area: c.data.area, langs: getCode(c.id, 'concepts').map((s) => s.lang.label),
    text: `${c.data.name} ${c.data.intent} ${c.data.scenario} ${c.data.area}`.toLowerCase(),
  })),
  ...patterns.map((p) => ({
    href: url(`patterns/${p.id}/`), key: `patterns/${p.id}`, name: p.data.name, intent: p.data.intent, difficulty: p.data.difficulty,
    area: 'patterns', sub: p.data.category, langs: getCode(p.id).map((s) => s.lang.label),
    text: `${p.data.name} ${p.data.intent} ${p.data.scenario} ${p.data.category} design pattern`.toLowerCase(),
  })),
].sort((a, b) => a.name.localeCompare(b.name));

const difficulties = ['beginner', 'intermediate', 'advanced'] as const;
const subBlurb: Record<string, string> = { creational: 'How objects get made', structural: 'How objects fit together', behavioral: 'How objects talk to each other' };
const shown = areas.filter((a) => items.some((i) => i.area === a.id));
const count = (f: (i: Item) => boolean) => items.filter(f).length;
---
<Layout title="System Design Academy">
  <section class="hero">
    <h1>System design, <em>seen</em> not memorised.</h1>
    <p class="lede">{items.length} concepts and patterns, each with a diagram, a step-by-step animation, something to play with, and code where it helps. Pick your language at the top; it sticks across the site.</p>
    <p class="newhere">New here? <a href={url('paths/#thirty-minutes')}>Start with thirty minutes</a>, <a href={url('paths/#from-web-developer')}>follow a web request down to the servers</a>, or <a href={url('paths/#interview-week')}>prepare for an interview in a week</a>.</p>
  </section>

  <form class="filters" role="search" data-filters onsubmit="return false">
    <div class="searchbox">
      <label class="sr" for="q">Search the catalog</label>
      <input id="q" class="pg-in" type="search" placeholder="Search by name or idea…  (press / to focus)" autocomplete="off" data-q />
    </div>
    <div class="chips" role="group" aria-label="Area">
      <button type="button" class="chip-btn" data-area="all" aria-pressed="true">All <span>{items.length}</span></button>
      {shown.map((a) => <button type="button" class="chip-btn" data-area={a.id} aria-pressed="false">{a.label} <span>{count((i) => i.area === a.id)}</span></button>)}
    </div>
    <div class="chips" role="group" aria-label="Difficulty">
      <button type="button" class="chip-btn" data-diff="all" aria-pressed="true">Any level</button>
      {difficulties.map((d) => <button type="button" class="chip-btn cap" data-diff={d} aria-pressed="false">{d} <span>{count((i) => i.difficulty === d)}</span></button>)}
    </div>
    <p class="status"><span data-count aria-live="polite"></span> <button type="button" class="linklike" data-reset hidden>Clear filters</button></p>
  </form>

  {shown.map((a) => {
    const inArea = items.filter((i) => i.area === a.id);
    const subs = a.id === 'patterns' ? ['creational', 'structural', 'behavioral'] : [undefined];
    return (
      <section id={a.id} data-section>
        <h2 class="cat">{a.label} <small>{a.blurb}</small></h2>
        {subs.map((sub) => {
          const group = sub ? inArea.filter((i) => i.sub === sub) : inArea;
          return group.length > 0 && (
            <div data-sub>
              {sub && <h3 class="subhead cap" id={sub}>{sub} <small>{subBlurb[sub]}</small></h3>}
              <div class="grid">
                {group.map((i) => (
                  <a class="card pat" href={i.href} data-card data-card-key={i.key} data-area={i.area} data-diff={i.difficulty} data-text={i.text}>
                    <span class="badge">{i.difficulty}</span>
                    <h3>{i.name}</h3>
                    <p>{i.intent}</p>
                    {i.langs.length > 0 && <small>{i.langs.join(' · ')}</small>}
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </section>
    );
  })}
  <p class="empty" data-empty hidden>No matches. Try fewer words or <button type="button" class="linklike" data-reset>clear the filters</button>.</p>
</Layout>
<script>
  const root = document.querySelector<HTMLElement>('[data-filters]')!;
  const input = root.querySelector<HTMLInputElement>('[data-q]')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  const subs = [...document.querySelectorAll<HTMLElement>('[data-sub]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const resets = document.querySelectorAll<HTMLButtonElement>('[data-reset]');

  const params = new URLSearchParams(location.search);
  const state = { q: params.get('q') ?? '', area: params.get('area') ?? 'all', diff: params.get('level') ?? 'all' };
  input.value = state.q;

  const anyVisible = (el: HTMLElement) => [...el.querySelectorAll<HTMLElement>('[data-card]')].some((c) => !c.hidden);

  function apply() {
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    cards.forEach((c) => {
      const ok = (state.area === 'all' || c.dataset.area === state.area)
        && (state.diff === 'all' || c.dataset.diff === state.diff)
        && words.every((w) => c.dataset.text!.includes(w));
      c.hidden = !ok;
      if (ok) shown++;
    });
    subs.forEach((s) => (s.hidden = !anyVisible(s)));
    sections.forEach((s) => (s.hidden = !anyVisible(s)));
    root.querySelectorAll<HTMLElement>('[data-area]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.area === state.area)));
    root.querySelectorAll<HTMLElement>('[data-diff]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.diff === state.diff)));
    const filtered = !!words.length || state.area !== 'all' || state.diff !== 'all';
    count.textContent = filtered ? `Showing ${shown} of ${cards.length}` : `${cards.length} concepts and patterns`;
    resets.forEach((r) => (r.hidden = !filtered && r.closest('form') !== null));
    empty.hidden = shown > 0;
    const next = new URLSearchParams();
    if (state.q) next.set('q', state.q);
    if (state.area !== 'all') next.set('area', state.area);
    if (state.diff !== 'all') next.set('level', state.diff);
    history.replaceState(null, '', next.size ? `?${next}` : location.pathname);
  }

  input.addEventListener('input', () => { state.q = input.value; apply(); });
  root.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('.chip-btn');
    if (!b) return;
    if (b.dataset.area) state.area = b.dataset.area;
    if (b.dataset.diff) state.diff = b.dataset.diff;
    apply();
  });
  resets.forEach((r) => r.addEventListener('click', () => { state.q = ''; state.area = 'all'; state.diff = 'all'; input.value = ''; apply(); input.focus(); }));
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(t.tagName)) { e.preventDefault(); input.focus(); }
    if (e.key === 'Escape' && t === input) { input.value = ''; state.q = ''; apply(); }
  });
  apply();
</script>
<style>
  .hero { padding: 3rem 0 1rem; }
  .newhere { margin: .6rem 0 0; color: var(--muted); }
  h1 { font-size: clamp(2rem, 6vw, 3.2rem); margin: 0 0 .5rem; }
  em { color: var(--accent); font-style: normal; }
  .filters { position: sticky; top: var(--header-h); z-index: 5; display: grid; gap: 10px; padding: 12px 0; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); margin-top: 1rem; }
  .searchbox input { width: 100%; padding: 10px 14px; font-size: 1rem; border-radius: 999px; }
  .status { margin: 0; color: var(--muted); font-size: .85rem; }
  .empty { margin: 3rem 0; text-align: center; color: var(--muted); }
  section[id] { scroll-margin-top: calc(var(--header-h) + 170px); }
  .cat small, .subhead small { color: var(--muted); font-weight: 400; font-size: .9rem; margin-left: .5rem; text-transform: none; }
  .subhead { margin: 1.4rem 0 .6rem; font-size: 1.1rem; scroll-margin-top: calc(var(--header-h) + 170px); }
  .pat { text-decoration: none; color: var(--text); display: block; transition: transform .15s, border-color .15s; }
  .pat:hover { transform: translateY(-2px); border-color: var(--accent); }
  .pat h3 { margin: .5rem 0 .25rem; }
  .pat p { margin: 0 0 .5rem; color: var(--muted); }
  .pat small { color: var(--accent); }
</style>
