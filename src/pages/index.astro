---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { url, getVisual, playgroundFor, minutesFor } from '../lib';
import { paths } from '../data/paths';
import { areas } from '../data/areas';

interface Item {
  href: string; name: string; intent: string; difficulty: string;
  area: string; sub?: string; has: string; text: string; key: string;
}

const patterns = await getCollection('patterns');
const concepts = await getCollection('concepts');
const studies = await getCollection('studies');
// What a lesson offers, as one short line: "animation · simulation · quiz · 12 min".
const offers = (name: string, slug: string, collection: 'concepts' | 'patterns', data: any) => [
  getVisual(slug, 'steps', collection) && 'animation', playgroundFor(name) && 'simulation', data.quiz && 'quiz', `${minutesFor('concept', data)}\u00a0min`,
].filter(Boolean).join(' · ');
const items: Item[] = [
  ...concepts.map((c) => ({
    href: url(`concepts/${c.id}/`), key: `concepts/${c.id}`, name: c.data.name, intent: c.data.intent, difficulty: c.data.difficulty,
    area: c.data.area, has: offers(c.data.name, c.id, 'concepts', c.data),
    text: `${c.data.name} ${c.data.intent} ${c.data.scenario} ${c.data.area}`.toLowerCase(),
  })),
  ...patterns.map((p) => ({
    href: url(`patterns/${p.id}/`), key: `patterns/${p.id}`, name: p.data.name, intent: p.data.intent, difficulty: p.data.difficulty,
    area: 'patterns', sub: p.data.category, has: offers(p.data.name, p.id, 'patterns', p.data),
    text: `${p.data.name} ${p.data.intent} ${p.data.scenario} ${p.data.category} design pattern`.toLowerCase(),
  })),
].sort((a, b) => a.name.localeCompare(b.name));

const difficulties = ['beginner', 'intermediate', 'advanced'] as const;
const subBlurb: Record<string, string> = { creational: 'How objects get made', structural: 'How objects fit together', behavioral: 'How objects talk to each other' };
const shown = areas.filter((a) => items.some((i) => i.area === a.id));
const count = (f: (i: Item) => boolean) => items.filter(f).length;
const total = items.length + studies.length;

// The "Start here" paths, with each step resolved so the progress panel can name the next one.
const find = (kind: string, slug: string) => kind === 'concept' ? concepts.find((c) => c.id === slug) : kind === 'pattern' ? patterns.find((x) => x.id === slug) : studies.find((x) => x.id === slug);
const startPaths = paths.filter((p) => p.audience === 'Start here').map((p) => {
  const steps = p.steps.map((st) => {
    const hit = find(st.kind, st.slug)!;
    const folder = st.kind === 'concept' ? 'concepts' : st.kind === 'pattern' ? 'patterns' : 'studies';
    return { key: `${folder}/${st.slug}`, name: hit.data.name, href: url(`${st.kind === 'study' ? 'case-studies' : folder}/${st.slug}/`), minutes: minutesFor(st.kind, hit.data) };
  });
  const mins = steps.reduce((n, x) => n + x.minutes, 0);
  return { id: p.id, title: p.title, blurb: p.blurb, steps, length: p.maxMinutes ? `${p.maxMinutes} min` : mins >= 90 ? `about ${Math.round(mins / 60)} hours` : `about ${mins} min` };
});
const first = startPaths[0];
const ways = [
  ['Read', 'The problem first', 'A concrete scenario, then how the idea solves it in a few plain steps.'],
  ['Watch', 'Step through it', 'Messages move between the parts of a system, one narrated step at a time.'],
  ['Simulate', 'Push until it breaks', 'Change the load and the settings, and watch the numbers respond.'],
  ['Test', 'Three scenario questions', 'Every wrong answer is explained and links back to the part that teaches it.'],
];
---
<Layout title="System Design Academy">
  <div class="hero-band">
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">{concepts.length} concepts · {patterns.length} patterns · {studies.length} case studies</p>
        <h1>System design, <span class="seen">seen</span> not memorised.</h1>
        <p class="lede">Every idea comes with a diagram, a step-by-step animation, a simulation you can push until it breaks, and code in the language you pick at the top.</p>
        <p class="cta">
          <a class="btn primary" href={url(`paths/#${first.id}`)}>Start with thirty minutes <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
          <a class="btn" href="#catalog">Browse the catalog</a>
        </p>
      </div>
      <aside class="you card" aria-labelledby="you-h" data-you data-total={total} data-paths={JSON.stringify(startPaths.map((p) => ({ title: p.title, href: url(`paths/#${p.id}`), steps: p.steps.map(({ key, name, href, minutes }) => ({ key, name, href, minutes })) })))}>
        <h2 id="you-h" class="eyebrow">Your progress</h2>
        <div>
          <p class="you-count"><span data-you-done>0 of {total} done</span><span class="mono" data-you-pct>0%</span></p>
          <div class="meter" aria-hidden="true"><i data-you-bar></i></div>
        </div>
        <a class="you-link" href={first.steps[0].href} data-you-next>
          <span class="eyebrow" data-you-path>Next on “{first.title}”</span>
          <strong data-you-name>{first.steps[0].name}</strong>
          <span class="you-sub" data-you-step>Step 1 of {first.steps.length} · about {first.steps[0].minutes} min</span>
        </a>
        <a class="you-link row" href={url('review/')}>
          <span><strong>Review</strong><span class="you-sub" data-you-review>Answer a quiz to start your review schedule</span></span>
          <span class="due mono" data-you-due aria-hidden="true"></span>
        </a>
        <p class="you-note">Stored in this browser only. <a href={url('progress/')}>Back up or restore</a></p>
      </aside>
    </section>
  </div>

  <section class="ways card" aria-labelledby="ways-h">
    <h2 id="ways-h" class="eyebrow">Every lesson, four ways in</h2>
    <ol>
      {ways.map(([verb, title, text], i) => <li><span class="mono step-n">0{i + 1} / {verb}</span><strong>{title}</strong><span>{text}</span></li>)}
    </ol>
  </section>

  <section class="start" aria-labelledby="start-h">
    <div class="head-row"><h2 id="start-h">Start here</h2><a href={url('paths/')}>All {paths.length} learning paths</a></div>
    <div class="grid">
      {startPaths.map((p) => (
        <a class="card pat" href={url(`paths/#${p.id}`)}>
          <span class="meta-row"><span class="badge">{p.length}</span><span class="mono small">{p.steps.length} steps</span></span>
          <h3>{p.title}</h3>
          <p>{p.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="catalog" aria-labelledby="catalog" >
    <h2 id="catalog">Catalog</h2>
    <form class="filters card" role="search" data-filters onsubmit="return false">
      <div class="searchbox">
        <label class="sr" for="q">Search the catalog</label>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input id="q" class="pg-in" type="search" placeholder="Name or idea, e.g. “stale data”  (press / to focus)" autocomplete="off" data-q />
      </div>
      <div class="seg-group" role="group" aria-label="Level">
        <button type="button" data-diff="all" aria-pressed="true">Any level</button>
        {difficulties.map((d) => <button type="button" class="cap" data-diff={d} aria-pressed="false">{d} <span>{count((i) => i.difficulty === d)}</span></button>)}
      </div>
      <label class="hide-done"><input type="checkbox" data-hide-done /> Hide done</label>
    </form>

    <div class="cat-layout">
      <div class="areas card" role="group" aria-label="Area" data-areas>
        <button type="button" class="area-btn" data-area="all" aria-pressed="true"><span>All areas</span><span class="n">{items.length}</span></button>
        {shown.map((a) => <button type="button" class="area-btn" data-area={a.id} aria-pressed="false"><span>{a.label}</span><span class="n">{count((i) => i.area === a.id)}</span></button>)}
      </div>

      <div class="cat-main">
        <p class="status mono"><span data-count aria-live="polite"></span> <button type="button" class="linklike" data-reset hidden>Clear filters</button></p>
        {shown.map((a) => {
          const inArea = items.filter((i) => i.area === a.id);
          const subs = a.id === 'patterns' ? ['creational', 'structural', 'behavioral'] : [undefined];
          return (
            <section id={a.id} data-section>
              <h2 class="cat">{a.label} <small>{a.blurb}</small></h2>
              {subs.map((sub) => {
                const group = sub ? inArea.filter((i) => i.sub === sub) : inArea;
                return group.length > 0 && (
                  <div data-sub>
                    {sub && <h3 class="subhead cap" id={sub}>{sub} <small>{subBlurb[sub]}</small></h3>}
                    <div class="grid">
                      {group.map((i) => (
                        <a class="card pat" href={i.href} data-card data-card-key={i.key} data-area={i.area} data-diff={i.difficulty} data-text={i.text}>
                          <span class="badge" data-level={i.difficulty}>{i.difficulty}</span>
                          <h3>{i.name}</h3>
                          <p>{i.intent}</p>
                          <small class="mono">{i.has}</small>
                        </a>
                      ))}
                    </div>
                  </div>
                );
              })}
            </section>
          );
        })}
        <p class="empty" data-empty hidden>No matches. Try fewer words or <button type="button" class="linklike" data-reset>clear the filters</button>.</p>
      </div>
    </div>
  </section>
</Layout>
<script>
  const root = document.querySelector<HTMLElement>('[data-filters]')!;
  const areaBox = document.querySelector<HTMLElement>('[data-areas]')!;
  const input = root.querySelector<HTMLInputElement>('[data-q]')!;
  const hideDone = root.querySelector<HTMLInputElement>('[data-hide-done]')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  const subs = [...document.querySelectorAll<HTMLElement>('[data-sub]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const resets = document.querySelectorAll<HTMLButtonElement>('[data-reset]');
  const progress = (window as any).sdaProgress as { has: (k: string) => boolean; list: () => string[] } | undefined;

  const params = new URLSearchParams(location.search);
  const state = { q: params.get('q') ?? '', area: params.get('area') ?? 'all', diff: params.get('level') ?? 'all', hide: params.get('hide') === 'done' };
  input.value = state.q;
  hideDone.checked = state.hide;

  const anyVisible = (el: HTMLElement) => [...el.querySelectorAll<HTMLElement>('[data-card]')].some((c) => !c.hidden);

  function apply() {
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    cards.forEach((c) => {
      const ok = (state.area === 'all' || c.dataset.area === state.area)
        && (state.diff === 'all' || c.dataset.diff === state.diff)
        && !(state.hide && progress?.has(c.dataset.cardKey!))
        && words.every((w) => c.dataset.text!.includes(w));
      c.hidden = !ok;
      if (ok) shown++;
    });
    subs.forEach((s) => (s.hidden = !anyVisible(s)));
    sections.forEach((s) => (s.hidden = !anyVisible(s)));
    areaBox.querySelectorAll<HTMLElement>('[data-area]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.area === state.area)));
    root.querySelectorAll<HTMLElement>('[data-diff]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.diff === state.diff)));
    const filtered = !!words.length || state.area !== 'all' || state.diff !== 'all' || state.hide;
    count.textContent = filtered ? `Showing ${shown} of ${cards.length}` : `${cards.length} concepts and patterns`;
    resets.forEach((r) => (r.hidden = !filtered && !r.closest('[data-empty]')));
    empty.hidden = shown > 0;
    const next = new URLSearchParams();
    if (state.q) next.set('q', state.q);
    if (state.area !== 'all') next.set('area', state.area);
    if (state.diff !== 'all') next.set('level', state.diff);
    if (state.hide) next.set('hide', 'done');
    history.replaceState(null, '', next.size ? `?${next}${location.hash}` : location.pathname + location.hash);
  }

  input.addEventListener('input', () => { state.q = input.value; apply(); });
  hideDone.addEventListener('change', () => { state.hide = hideDone.checked; apply(); });
  root.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-diff]');
    if (b) { state.diff = b.dataset.diff!; apply(); }
  });
  areaBox.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-area]');
    if (b) { state.area = b.dataset.area!; apply(); }
  });
  resets.forEach((r) => r.addEventListener('click', () => {
    state.q = ''; state.area = 'all'; state.diff = 'all'; state.hide = false; input.value = ''; hideDone.checked = false; apply(); input.focus();
  }));
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(t.tagName)) { e.preventDefault(); input.focus(); }
    if (e.key === 'Escape' && t === input) { input.value = ''; state.q = ''; apply(); }
  });
  document.addEventListener('sda-progress', () => { if (state.hide) apply(); renderYou(); });
  apply();

  // "Your progress" panel: done count, the next unfinished step on a Start-here path, and reviews due today. All from localStorage.
  interface Step { key: string; name: string; href: string; minutes: number }
  const you = document.querySelector<HTMLElement>('[data-you]')!;
  const total = Number(you.dataset.total);
  const startPaths: { title: string; href: string; steps: Step[] }[] = JSON.parse(you.dataset.paths!);
  const $ = (k: string) => you.querySelector<HTMLElement>(`[data-you-${k}]`)!;
  function renderYou() {
    const done = progress ? progress.list().length : 0;
    const pct = total ? Math.round((100 * done) / total) : 0;
    $('done').textContent = `${done} of ${total} done`;
    $('pct').textContent = `${pct}%`;
    $('bar').style.width = `${pct}%`;
    const path = startPaths.find((p) => p.steps.some((x) => !progress?.has(x.key)));
    const link = $('next') as HTMLAnchorElement;
    if (path) {
      const i = path.steps.findIndex((x) => !progress?.has(x.key));
      const step = path.steps[i];
      link.href = step.href;
      $('path').textContent = `Next on “${path.title}”`;
      $('name').textContent = step.name;
      $('step').textContent = `Step ${i + 1} of ${path.steps.length} · about ${step.minutes} min`;
    } else {
      link.href = startPaths[0].href.replace(/#.*/, '');
      $('path').textContent = 'Start-here paths';
      $('name').textContent = 'All done. Pick any path next';
      $('step').textContent = 'Or draw a mock interview';
    }
    const review = (window as any).sdaReview;
    const all = review ? review.load() : {};
    const today = review ? review.today() : 0;
    const keys = Object.keys(all).filter((k) => !k.startsWith('interview/')); // interview questions are counted apart
    const due = keys.filter((k) => all[k] && all[k].d <= today).length;
    const iqDue = Object.keys(all).filter((k) => k.startsWith('interview/') && all[k].d <= today).length;
    $('review').textContent = !keys.length ? 'Answer a quiz to start your review schedule' : due ? `${due} question${due === 1 ? '' : 's'} due today${iqDue ? `, ${iqDue} interview` : ''}` : iqDue ? `Nothing due today, ${iqDue} interview question${iqDue === 1 ? '' : 's'} to retry` : 'Nothing due today';
    $('due').textContent = due ? String(due) : '';
  }
  renderYou();
</script>
<style>
  .hero-band { position: relative; isolation: isolate; }
  .hero-band::before { content: ''; position: absolute; inset: 0 -16px; z-index: -1; pointer-events: none;
    background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 32px 32px; background-position: center -1px; opacity: .7;
    -webkit-mask-image: radial-gradient(ellipse at 30% 40%, #000 30%, transparent 75%); mask-image: radial-gradient(ellipse at 30% 40%, #000 30%, transparent 75%); }
  .hero { display: flex; flex-wrap: wrap; gap: 32px; align-items: stretch; padding: 3.5rem 0 1rem; }
  .hero-text { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .hero-text > * { margin: 0; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.5rem); line-height: 1.08; max-width: 16ch; }
  .seen { color: var(--accent); }
  .hero .lede { font-size: 1.15rem; max-width: 58ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta .btn { min-height: 44px; padding: 0 18px; }
  .you { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 14px; padding: 20px; align-self: flex-start; }
  .you-count { display: flex; justify-content: space-between; margin: 0 0 8px; font-weight: 600; }
  .you-count .mono { font-size: .85rem; color: var(--muted); font-weight: 400; }
  .meter { height: 8px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .meter i { display: block; height: 100%; width: 0; background: var(--accent); }
  .you-link { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; border: 1px solid var(--border); border-radius: 12px; color: var(--text); text-decoration: none; }
  .you-link:hover { border-color: var(--accent); color: var(--text); }
  .you-link.row { flex-direction: row; justify-content: space-between; align-items: center; gap: 12px; }
  .you-link strong { display: block; }
  .you-sub { display: block; font-size: .9rem; color: var(--muted); }
  .due { font-size: 1.4rem; font-weight: 600; color: var(--signal-text); }
  .you-note { margin: 0; font-size: .82rem; color: var(--muted); }
  .ways { margin-top: 2rem; padding: 0; overflow: hidden; }
  .ways h2 { padding: 12px 20px; border-bottom: 1px solid var(--border); }
  .ways ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); }
  .ways li { display: flex; flex-direction: column; gap: 4px; padding: 18px 20px; border-right: 1px dashed var(--border); border-bottom: 1px dashed var(--border); margin: 0 -1px -1px 0; }
  .ways li span:last-child { color: var(--muted); font-size: .95rem; }
  .step-n { font-size: .8rem; font-weight: 600; color: var(--accent); }
  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; margin: 3rem 0 .75rem; }
  .head-row h2 { margin: 0; }
  .meta-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .small { font-size: .78rem; color: var(--muted); }
  .catalog > h2 { margin-bottom: .75rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 10px 12px; align-items: center; padding: 10px; }
  .searchbox { position: relative; flex: 1 1 260px; min-width: 0; }
  .searchbox svg { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
  .searchbox input { width: 100%; min-height: 44px; padding: 8px 14px 8px 40px; font-size: 1rem; border-radius: 10px; }
  .seg-group { display: flex; flex-wrap: wrap; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--surface); }
  .seg-group button { font: inherit; font-size: .9rem; min-height: 42px; padding: 0 12px; border: 0; border-right: 1px solid var(--border); background: none; color: var(--text); cursor: pointer; }
  .seg-group button:last-child { border-right: 0; }
  .seg-group button span { font: .75rem var(--font-mono); color: var(--muted); margin-left: 4px; }
  .seg-group button:hover { background: var(--surface-2); }
  .seg-group button[aria-pressed='true'] { background: var(--text); color: var(--bg); font-weight: 600; }
  .seg-group button[aria-pressed='true'] span { color: inherit; opacity: .8; }
  .seg-group button:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .hide-done { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 4px; cursor: pointer; }
  .hide-done input { width: 18px; height: 18px; margin: 0; accent-color: var(--accent); }
  .cat-layout { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; margin-top: 20px; }
  .areas { flex: 1 1 240px; min-width: 0; display: flex; flex-direction: column; gap: 2px; padding: 8px; }
  @media (min-width: 900px) { .areas { position: sticky; top: calc(var(--header-h) + 16px); } }
  .area-btn { display: flex; justify-content: space-between; align-items: center; gap: 8px; width: 100%; min-height: 42px; padding: 6px 12px; border-radius: 9px; border: 1px solid transparent; background: none; font: inherit; font-size: .95rem; color: var(--text); text-align: left; cursor: pointer; }
  .area-btn .n { font: .78rem var(--font-mono); color: var(--muted); }
  .area-btn:hover { background: var(--surface-2); }
  .area-btn[aria-pressed='true'] { background: var(--accent-soft); border-color: var(--accent); font-weight: 600; }
  .area-btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 0; }
  @media (max-width: 899px) {
    .areas { flex-direction: row; flex-wrap: wrap; gap: 6px; padding: 0; background: none; border: 0; }
    .area-btn { width: auto; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); padding: 4px 12px; font-size: .88rem; }
  }
  .cat-main { flex: 999 1 560px; min-width: 0; }
  .status { margin: 0 0 4px; color: var(--muted); font-size: .82rem; }
  .empty { margin: 3rem 0; text-align: center; color: var(--muted); }
  .cat { margin: 1.6rem 0 .8rem; font-size: 1.35rem; }
  section[data-section]:first-of-type .cat { margin-top: .5rem; }
  .cat small, .subhead small { display: block; color: var(--muted); font-weight: 400; font-size: .92rem; margin-top: 2px; text-transform: none; letter-spacing: 0; }
  .subhead { margin: 1.4rem 0 .6rem; font-size: 1.05rem; }
  .pat { text-decoration: none; color: var(--text); display: flex; flex-direction: column; gap: 6px; padding: 18px; transition: border-color .15s, box-shadow .15s; }
  .pat:hover { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); color: var(--text); }
  .pat h3 { margin: .2rem 0 0; font-size: 1.1rem; }
  .pat p { margin: 0; color: var(--muted); font-size: .95rem; }
  .pat small { margin-top: auto; padding-top: 8px; border-top: 1px dashed var(--border); color: var(--muted); font-size: .75rem; }
  .pat .badge { align-self: flex-start; }
</style>
