---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { url } from '../lib';
import { problems, confusions } from '../data/compareConcepts';
import { areas, areaLabel } from '../data/areas';

const all = await getCollection('concepts');
const bySlug = new Map(all.map((p) => [p.id, p]));
const pat = (slug: string) => {
  const p = bySlug.get(slug);
  if (!p) throw new Error(`src/data/compareConcepts.ts references unknown concept "${slug}"`);
  return p;
};
// Fail the build on any typo in the hand-written data.
problems.forEach((pr) => pr.patterns.forEach((x) => pat(x.slug)));
confusions.forEach((c) => c.patterns.forEach((s) => pat(s)));
confusions.forEach((c) => c.rows.forEach((r) => {
  if (r.values.length !== c.patterns.length) throw new Error(`compareConcepts.ts: "${c.title}" row "${r.aspect}" has ${r.values.length} values for ${c.patterns.length} concepts`);
}));

const categories = areas.filter((a) => a.id !== 'patterns');
const order = new Map(categories.map((a, i) => [a.id as string, i]));
const sheet = [...all].sort((a, b) => order.get(a.data.area)! - order.get(b.data.area)! || a.data.name.localeCompare(b.data.name));
const href = (slug: string) => url(`concepts/${slug}/`);
---
<Layout title="Compare concepts | System Design Academy" description="Find the right system design concept for a problem, and see how look-alike concepts differ.">
  <header class="top">
    <h1>Which concept do I need?</h1>
    <p class="lede">Start from the problem you have, check the concepts people mix up, or scan everything on one page.</p>
    <p class="switch">Comparing: <a href={url('compare/')}>Design patterns</a> · <strong aria-current="page">System design concepts</strong></p>
    <nav class="jump" aria-label="On this page">
      <a href="#find">By problem</a><a href="#confused">Easily confused</a><a href="#cheat">Cheat sheet</a>
    </nav>
  </header>

  <section id="find" aria-labelledby="find-h">
    <h2 id="find-h">Find a concept by problem</h2>
    <form class="finder" data-finder onsubmit="return false" role="search">
      <label class="sr" for="fq">Search problems</label>
      <input id="fq" class="pg-in" type="search" placeholder="Describe what you need… e.g. slow reads, retries, duplicates" autocomplete="off" data-fq />
      <div class="chips" role="group" aria-label="Area">
        <button type="button" class="chip-btn" data-fcat="all" aria-pressed="true">All</button>
        {categories.map((c) => <button type="button" class={`chip-btn dot-${c.id}`} data-fcat={c.id} aria-pressed="false">{c.label}</button>)}
      </div>
      <p class="status" aria-live="polite" data-fcount></p>
    </form>
    <ul class="problems">
      {problems.map((pr) => (
        <li class="prob card" data-prob
            data-text={`${pr.text} ${pr.patterns.map((x) => `${pat(x.slug).data.name} ${x.why}`).join(' ')}`.toLowerCase()}
            data-cats={[...new Set(pr.patterns.map((x) => pat(x.slug).data.area))].join(' ')}>
          <p class="need">{pr.text}</p>
          <ul class="answers">
            {pr.patterns.map((x) => (
              <li>
                <a class={`pill cat-${pat(x.slug).data.area}`} href={href(x.slug)}>{pat(x.slug).data.name}</a>
                <span class="why">{x.why}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
    <p class="empty" data-fempty hidden>Nothing matches. Try a simpler word, or <button type="button" class="linklike" data-freset>clear the filter</button>.</p>
  </section>

  <section id="confused" aria-labelledby="confused-h">
    <h2 id="confused-h">Easily confused</h2>
    <p class="lede">These groups look alike. The rule of thumb under each table is the quickest way to tell them apart.</p>
    {confusions.map((c) => (
      <article class="conf card">
        <h3>{c.title}</h3>
        <p class="blurb">{c.blurb}</p>
        <div class="tablewrap">
          <table>
            <caption class="sr">{c.title}</caption>
            <thead>
              <tr><th scope="col"><span class="sr">Aspect</span></th>{c.patterns.map((s) => <th scope="col"><a href={href(s)} class={`pill cat-${pat(s).data.area}`}>{pat(s).data.name}</a></th>)}</tr>
            </thead>
            <tbody>
              {c.rows.map((r) => <tr><th scope="row">{r.aspect}</th>{r.values.map((v) => <td>{v}</td>)}</tr>)}
            </tbody>
          </table>
        </div>
        <p class="rule"><strong>Rule of thumb:</strong> {c.rule}</p>
      </article>
    ))}
  </section>

  <section id="cheat" aria-labelledby="cheat-h">
    <h2 id="cheat-h">Cheat sheet: all {all.length} concepts</h2>
    <div class="tablewrap">
      <table class="sheet">
        <caption class="sr">All concepts with a one-line idea, when to use them and when to skip them</caption>
        <thead><tr><th scope="col">Concept</th><th scope="col">In one line</th><th scope="col">Reach for it when</th><th scope="col">Skip it when</th></tr></thead>
        <tbody>
          {sheet.map((p, i) => (
            <>
              {(i === 0 || sheet[i - 1].data.area !== p.data.area) && (
                <tr class="grouprow"><th colspan="4" scope="colgroup" class="cap">{areaLabel(p.data.area)}</th></tr>
              )}
              <tr>
                <th scope="row"><a href={href(p.id)}>{p.data.name}</a><small class="lvl">{p.data.difficulty}</small></th>
                <td>{p.data.intent}</td>
                <td>{p.data.whenToUse[0]}</td>
                <td>{p.data.whenNotToUse[0]}</td>
              </tr>
            </>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>
<script>
  const form = document.querySelector<HTMLElement>('[data-finder]')!;
  const input = form.querySelector<HTMLInputElement>('[data-fq]')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-prob]')];
  const empty = document.querySelector<HTMLElement>('[data-fempty]')!;
  const count = form.querySelector<HTMLElement>('[data-fcount]')!;
  let cat = 'all';
  function apply() {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    items.forEach((li) => {
      const ok = (cat === 'all' || li.dataset.cats!.split(' ').includes(cat)) && words.every((w) => li.dataset.text!.includes(w));
      li.hidden = !ok; if (ok) shown++;
    });
    form.querySelectorAll<HTMLElement>('[data-fcat]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.fcat === cat)));
    count.textContent = words.length || cat !== 'all' ? `Showing ${shown} of ${items.length} problems` : `${items.length} common problems`;
    empty.hidden = shown > 0;
  }
  input.addEventListener('input', apply);
  form.addEventListener('click', (e) => { const b = (e.target as Element).closest<HTMLElement>('[data-fcat]'); if (b) { cat = b.dataset.fcat!; apply(); } });
  document.querySelector('[data-freset]')!.addEventListener('click', () => { input.value = ''; cat = 'all'; apply(); input.focus(); });
  apply();
</script>
<style>
  .top { padding: 2.5rem 0 .5rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .4rem; }
  .switch { margin: .6rem 0 0; color: var(--muted); }
  .jump { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 1rem; }
  .jump a { padding: 4px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); text-decoration: none; font-size: .9rem; }
  .jump a:hover { background: var(--surface-2); }
  section { scroll-margin-top: 70px; }
  .finder { display: grid; gap: 10px; margin: 1rem 0; }
  .finder input { width: 100%; padding: 10px 14px; border-radius: 999px; font-size: 1rem; }
  .status { margin: 0; color: var(--muted); font-size: .85rem; }
  .problems { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .prob { padding: 12px 16px; }
  .need { margin: 0 0 8px; font-weight: 600; }
  .answers { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .answers li { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  .why { color: var(--muted); font-size: .92rem; }
  .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: .85rem; font-weight: 600; text-decoration: none; border: 1px solid color-mix(in srgb, var(--pc) 55%, transparent); background: color-mix(in srgb, var(--pc) 12%, var(--surface)); color: var(--text); white-space: nowrap; }
  .pill:hover { background: color-mix(in srgb, var(--pc) 24%, var(--surface)); }
  .cat-scaling { --pc: var(--role-1); } .cat-data { --pc: var(--role-2); } .cat-messaging { --pc: var(--role-3); } .cat-reliability { --pc: var(--role-4); } .cat-api { --pc: var(--role-5); } .cat-security { --pc: var(--role-6); } .cat-observability { --pc: var(--accent); } .cat-networking { --pc: var(--good); } .cat-distributed { --pc: var(--role-3); }
  .dot-scaling::before, .dot-data::before, .dot-messaging::before, .dot-reliability::before, .dot-api::before, .dot-security::before, .dot-observability::before, .dot-networking::before, .dot-distributed::before { content: ''; display: inline-block; width: .6em; height: .6em; border-radius: 50%; margin-right: .45em; background: var(--pc); }
  .dot-scaling { --pc: var(--role-1); } .dot-data { --pc: var(--role-2); } .dot-messaging { --pc: var(--role-3); } .dot-reliability { --pc: var(--role-4); } .dot-api { --pc: var(--role-5); } .dot-security { --pc: var(--role-6); } .dot-observability { --pc: var(--accent); } .dot-networking { --pc: var(--good); } .dot-distributed { --pc: var(--role-3); }
  .empty { text-align: center; color: var(--muted); margin: 2rem 0; }
  .conf { margin: 14px 0; }
  .conf h3 { margin: 0 0 4px; }
  .blurb { margin: 0 0 12px; color: var(--muted); }
  .tablewrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
  table { width: 100%; border-collapse: collapse; font-size: .92rem; min-width: 560px; }
  th, td { text-align: left; vertical-align: top; padding: 8px 12px; border-bottom: 1px solid var(--border); }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { background: var(--surface-2); position: sticky; top: 0; }
  tbody th[scope='row'] { font-weight: 600; width: 22%; background: color-mix(in srgb, var(--surface-2) 50%, transparent); }
  .rule { margin: 12px 0 0; padding: 10px 14px; border-radius: 10px; background: var(--accent-soft); }
  .sheet th[scope='row'] { white-space: nowrap; }
  .lvl { display: block; font-weight: 400; color: var(--muted); text-transform: capitalize; }
  .grouprow th { background: var(--accent-soft); color: var(--accent); font-size: .85rem; letter-spacing: .04em; }
  main > :global(section:last-of-type) { margin-bottom: 3rem; }
</style>
