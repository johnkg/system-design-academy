---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CompareView from '../components/CompareView.astro';
import { url } from '../lib';
import { problems, confusions } from '../data/compareConcepts';
import { areas } from '../data/areas';

const all = await getCollection('concepts');
// Fail the build on any typo in the hand-written data.
const known = new Set(all.map((p) => p.id));
const need = (slug: string) => { if (!known.has(slug)) throw new Error(`src/data/compareConcepts.ts references unknown concept "${slug}"`); };
problems.forEach((pr) => pr.patterns.forEach((x) => need(x.slug)));
confusions.forEach((c) => c.patterns.forEach(need));
confusions.forEach((c) => c.rows.forEach((r) => {
  if (r.values.length !== c.patterns.length) throw new Error(`compareConcepts.ts: "${c.title}" row "${r.aspect}" has ${r.values.length} values for ${c.patterns.length} concepts`);
}));

// Each area's colour in the pills and filter dots.
const colors: Record<string, string> = {
  scaling: 'var(--role-1)', data: 'var(--role-2)', messaging: 'var(--role-3)', reliability: 'var(--role-4)', api: 'var(--role-5)', security: 'var(--role-6)',
  observability: 'var(--accent)', networking: 'var(--good)', distributed: 'var(--role-3)', deployment: 'var(--role-5)', databases: 'var(--role-2)',
  dataengineering: 'var(--role-4)', aiml: 'var(--role-1)',
};
const groups = areas.filter((a) => a.id !== 'patterns').map((a) => ({ id: a.id, label: a.label, color: colors[a.id] ?? 'var(--accent)' }));
const items = all.map((p) => ({ id: p.id, name: p.data.name, group: p.data.area, difficulty: p.data.difficulty, intent: p.data.intent, use: p.data.whenToUse[0], skip: p.data.whenNotToUse[0], href: url(`concepts/${p.id}/`) }));
---
<Layout title="Compare concepts | System Design Academy" description="Find the right system design concept for a problem, and see how look-alike concepts differ.">
  <header class="top">
    <h1>Which concept do I need?</h1>
    <p class="lede">Start from the problem you have, check the concepts people mix up, or scan everything on one page.</p>
    <p class="switch">Comparing: <a href={url('compare/')}>Design patterns</a> · <strong aria-current="page">System design concepts</strong></p>
    <nav class="jump" aria-label="On this page">
      <a href="#find">By problem</a><a href="#confused">Easily confused</a><a href="#cheat">Cheat sheet</a>
    </nav>
  </header>
  <CompareView noun="concept" groups={groups} groupLabel="Area" placeholder="Describe what you need… e.g. slow reads, retries, duplicates" items={items} problems={problems} confusions={confusions} />
</Layout>
<style>
  .top { padding: 2.5rem 0 .5rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .4rem; }
  .switch { margin: .6rem 0 0; color: var(--muted); }
  .jump { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 1rem; }
  .jump a { padding: 4px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); text-decoration: none; font-size: .9rem; }
  .jump a:hover { background: var(--surface-2); }
</style>
