---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib';
---
<Layout title="Offline | System Design Academy" description="This page has not been saved for offline use yet.">
  <section class="hero">
    <h1>You are offline</h1>
    <p class="lede">This page has not been saved on this device yet. Pages you have already opened still work without a connection. Your progress, notes and review schedule are stored here too, so they are available.</p>
    <p><a class="btn pg-primary" href={url('practice/')}>Go to practice</a> <a class="btn" href={url('')}>Go to the catalog</a></p>
  </section>
</Layout>
<style>
  .hero { padding: 3rem 0 1rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .4rem; }
</style>
