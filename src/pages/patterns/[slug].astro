---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LessonShell from '../../components/LessonShell.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Quiz from '../../components/Quiz.astro';
import { learnFor } from '../../learn';
import CodeTabs from '../../components/CodeTabs.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import UmlDiagram from '../../components/UmlDiagram.astro';
import StepPlayer from '../../components/StepPlayer.astro';
import { getVisual, playgroundFor, url, minutesFor, numbered } from '../../lib';

export async function getStaticPaths() {
  const patterns = await getCollection('patterns');
  return patterns.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: patterns } }));
}

const { entry, all } = Astro.props;
const { data } = entry;
const slug = entry.id;
const diagram = getVisual<any>(slug, 'diagram');
const steps = getVisual<any>(slug, 'steps');

const Playground = playgroundFor(data.name);
// Colours follow the order of `roles` in meta.json, so any pattern can name its roles freely.
const colors = Object.fromEntries(data.roles.map((r, i) => [r.id, `var(--role-${i + 1})`]));
const related = all.filter((p) => data.related.includes(p.id));
const sections = numbered([
  ['problem', 'The problem'], ['solution', 'The solution'], !!steps && ['watch', 'Watch it work'], !!Playground && ['try', 'Try it'],
  ['code', 'Full code'], ['judgment', 'Judgment'], !!data.quiz && ['quiz', 'Test yourself'],
]);
const sec = (id: string) => sections.find((x) => x.id === id)!;
---
<Layout title={`${data.name} pattern | System Design Academy`} description={data.intent}>
  <LessonShell
    crumbs={[{ label: 'Learn', href: url('') }, { label: 'Design patterns', href: url('?area=patterns#catalog') }, { label: data.category, href: url(`#${data.category}`), cap: true }, { label: data.name }]}
    level={data.difficulty} title={data.name} intent={data.intent} scenario={{ label: 'Example used throughout', text: data.scenario }}
    facts={[`${data.category} pattern`, `about ${minutesFor('pattern', data)} min`]} sections={sections} done={{ collection: 'patterns', slug }} hasQuiz={!!data.quiz}>
    {related.length > 0 && (
      <div class="card side-box" slot="side">
        <p class="eyebrow">Related patterns</p>
        {related.map((r) => <a href={url(`patterns/${r.id}/`)}>{r.data.name}</a>)}
      </div>
    )}

    <SectionHeading s={sec('problem')} />
    <p>{data.problem}</p>
    <BeforeAfter slug={slug} name={data.name} pain={data.pain} benefits={data.benefits} />

    <SectionHeading s={sec('solution')} />
    <p>{data.solution}</p>
    {diagram && <UmlDiagram diagram={diagram} roles={data.roles} colors={colors} />}

    {steps && (<>
      <SectionHeading s={sec('watch')} />
      <StepPlayer steps={steps} colors={colors} />
    </>)}

    {Playground && (<>
      <SectionHeading s={sec('try')} />
      <Playground />
    </>)}

    <SectionHeading s={sec('code')} />
    <CodeTabs slug={slug} />

    <SectionHeading s={sec('judgment')} />
    <div class="judge">
      <section class="card" id="use-when"><h3>Use it when</h3><ul class="clean">{data.whenToUse.map((x) => <li>{x}</li>)}</ul></section>
      <section class="card" id="skip-when"><h3>Skip it when</h3><ul class="clean">{data.whenNotToUse.map((x) => <li>{x}</li>)}</ul></section>
      <section class="card" id="pitfalls"><h3>Watch out for</h3><ul class="clean">{data.pitfalls.map((x) => <li>{x}</li>)}</ul></section>
    </div>

    {data.quiz && (<>
      <SectionHeading s={sec('quiz')} />
      <Quiz slug={slug} kind="patterns" questions={data.quiz} links={data.quiz.map((q) => learnFor('patterns', slug, data, q, new Map(), new Map()))} />
    </>)}

    {related.length > 0 && (<>
      <h2>Related patterns</h2>
      <p>{related.map((r, i) => <>{i > 0 && ', '}<a href={url(`patterns/${r.id}/`)}>{r.data.name}</a></>)}</p>
    </>)}
  </LessonShell>
</Layout>
<style>
  .judge { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .judge h3 { margin-top: 0; font-size: 1.05rem; }
</style>
