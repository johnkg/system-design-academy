---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DoneToggle from '../../components/DoneToggle.astro';
import Quiz from '../../components/Quiz.astro';
import CodeTabs from '../../components/CodeTabs.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import UmlDiagram from '../../components/UmlDiagram.astro';
import StepPlayer from '../../components/StepPlayer.astro';
import { getVisual, url } from '../../lib';

export async function getStaticPaths() {
  const patterns = await getCollection('patterns');
  return patterns.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: patterns } }));
}

const { entry, all } = Astro.props;
const { data } = entry;
const slug = entry.id;
const diagram = getVisual<any>(slug, 'diagram');
const steps = getVisual<any>(slug, 'steps');

// Each pattern may ship an interactive demo at src/playgrounds/<Name>Playground.astro.
const playgrounds = import.meta.glob('../../playgrounds/*.astro', { eager: true }) as Record<string, { default: any }>;
const Playground = Object.entries(playgrounds).find(([p]) => p.toLowerCase().endsWith(`/${data.name.replace(/\s+/g, '').toLowerCase()}playground.astro`))?.[1].default;
// Colours follow the order of `roles` in meta.json, so any pattern can name its roles freely.
const colors = Object.fromEntries(data.roles.map((r, i) => [r.id, `var(--role-${i + 1})`]));
const related = all.filter((p) => data.related.includes(p.id));
---
<Layout title={`${data.name} pattern | System Design Academy`} description={data.intent}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href={url('')}>Catalog</a></li>
      <li><a href={url('?area=patterns')}>Design patterns</a></li>
      <li><a href={url(`#${data.category}`)} class="cap">{data.category}</a></li>
      <li aria-current="page">{data.name}</li>
    </ol>
  </nav>
  <header>
    <span class="badge">{data.difficulty}</span>
    <h1>{data.name}</h1>
    <p class="lede">{data.intent}</p>
    <p class="scenario"><strong>Example used throughout:</strong> {data.scenario}</p>
    <p class="done-row"><DoneToggle collection="patterns" slug={slug} />{data.quiz && <a class="quiz-link" href="#quiz">Test yourself</a>}</p>
  </header>

  <h2>1. The problem</h2>
  <p>{data.problem}</p>
  <BeforeAfter slug={slug} name={data.name} pain={data.pain} benefits={data.benefits} />

  <h2>2. The solution</h2>
  <p>{data.solution}</p>
  {diagram && <UmlDiagram diagram={diagram} roles={data.roles} colors={colors} />}

  {steps && (<>
    <h2>3. Watch it work</h2>
    <StepPlayer steps={steps} colors={colors} />
  </>)}

  {Playground && (<>
    <h2>4. Try it</h2>
    <Playground />
  </>)}

  <h2>5. Full code</h2>
  <CodeTabs slug={slug} />

  <h2>6. Judgment</h2>
  <div class="judge">
    <section class="card"><h3>Use it when</h3><ul class="clean">{data.whenToUse.map((x) => <li>{x}</li>)}</ul></section>
    <section class="card"><h3>Skip it when</h3><ul class="clean">{data.whenNotToUse.map((x) => <li>{x}</li>)}</ul></section>
    <section class="card"><h3>Watch out for</h3><ul class="clean">{data.pitfalls.map((x) => <li>{x}</li>)}</ul></section>
  </div>

  {data.quiz && (<>
    <h2 id="quiz">7. Test yourself</h2>
    <Quiz slug={slug} kind="patterns" questions={data.quiz} />
  </>)}

  {related.length > 0 && (<>
    <h2>Related patterns</h2>
    <p>{related.map((r, i) => <>{i > 0 && ', '}<a href={url(`patterns/${r.id}/`)}>{r.data.name}</a></>)}</p>
  </>)}
</Layout>
<style>
  .crumbs { padding-top: 1rem; font-size: .9rem; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; color: var(--muted); }
  .crumbs li + li::before { content: '›'; margin-right: 6px; color: var(--muted); }
  .crumbs [aria-current] { color: var(--text); font-weight: 600; }
  .cap { text-transform: capitalize; }
  h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: .5rem 0 0; }
  .scenario { background: var(--accent-soft); padding: 10px 14px; border-radius: 10px; max-width: 70ch; }
  .judge { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .judge h3 { margin-top: 0; }
  h2 { scroll-margin-top: 70px; }
  main > :global(*:last-child) { margin-bottom: 2rem; }
</style>
