---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { url } from '../lib';
import { changelog } from '../data/changelog';
import { pageDates, metaPath } from '../freshness';

const dates = pageDates();
const rows = [
  ...(await getCollection('concepts')).map((e) => ({ kind: 'Concept', dir: 'concepts', e, key: metaPath('concepts', e.id) })),
  ...(await getCollection('patterns')).map((e) => ({ kind: 'Pattern', dir: 'patterns', e, key: metaPath('patterns', e.id) })),
  ...(await getCollection('studies')).map((e) => ({ kind: 'Case study', dir: 'case-studies', e, key: metaPath('studies', e.id) })),
].map((r) => ({ kind: r.kind, name: r.e.data.name, href: url(`${r.dir}/${r.e.id}/`), added: dates.added.get(r.key) ?? '' })).filter((r) => r.added);
// The newest three days that added pages, so the list stays short however large a batch was.
const days = [...new Set(rows.map((r) => r.added))].sort().reverse().slice(0, 3);
const recent = days.map((d) => ({ date: d, items: rows.filter((r) => r.added === d).sort((a, b) => a.name.localeCompare(b.name)) }));
const fmt = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Layout title="What's new | System Design Academy" description="New concepts, case studies and features, and what changed on the site.">
  <section class="hero">
    <h1>What's new</h1>
    <p class="lede">New pages and features, newest first. Your progress and notes are stored in your browser, so updates never reset them.</p>
  </section>

  {changelog.map((c) => (
    <section class="entry">
      <h2><time datetime={c.date}>{fmt(c.date)}</time> <span>{c.title}</span></h2>
      <ul>
        {c.items.map((i) => <li>{i.href ? <a href={url(i.href)}>{i.text}</a> : i.text}</li>)}
      </ul>
    </section>
  ))}

  {recent.length > 0 && (
    <section class="entry added">
      <h2>Recently added pages</h2>
      {recent.map((g) => (
        <>
          <h3><time datetime={g.date}>{fmt(g.date)}</time> <small>{g.items.length} page{g.items.length === 1 ? '' : 's'}</small></h3>
          <ul class="chips">
            {g.items.slice(0, 40).map((i) => <li><a href={i.href}>{i.name}</a> <small>{i.kind}</small></li>)}
          </ul>
          {g.items.length > 40 && <p class="more">and {g.items.length - 40} more.</p>}
        </>
      ))}
    </section>
  )}
</Layout>
<style>
  .hero { padding: 2.5rem 0 1rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .4rem; }
  .entry { border-left: 3px solid var(--border); padding: .2rem 0 .2rem 16px; margin: 0 0 1.6rem; }
  .entry h2 { font-size: 1.15rem; margin: 0 0 .5rem; display: flex; flex-wrap: wrap; gap: 2px 12px; align-items: baseline; }
  .entry h2 time { color: var(--muted); font-size: .9rem; font-weight: 600; }
  .entry h3 { font-size: 1rem; margin: 1rem 0 .4rem; }
  .entry h3 small, .chips small { color: var(--muted); font-weight: 400; }
  .entry ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 6px; overflow-wrap: anywhere; }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .more { color: var(--muted); margin: .4rem 0 0; }
</style>
