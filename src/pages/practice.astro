---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib';

const tools = [
  { href: 'review/', title: 'Review', text: 'Ten scenario questions at a time, scheduled so right answers return later and wrong ones tomorrow.', cta: 'Start a review' },
  { href: 'interview/', title: 'Mock interview', text: 'A random case-study task, a clock, and five stages from clarifying to wrap-up. Compare with the real design at the end.', cta: 'Draw a task' },
  { href: 'paths/', title: 'Learning paths', text: 'Curated sequences of concepts and case studies, with the next step highlighted.', cta: 'Pick a path' },
  { href: 'map/', title: 'Concept map', text: 'Pick a concept to see what to read first, what it opens the door to, and the case studies that use it.', cta: 'Explore the map' },
  { href: 'cheatsheets/', title: 'Cheat sheets', text: 'One printable page per area: what each idea is for, when to use it, when to skip it and the main trap.', cta: 'Open the sheets' },
  { href: 'progress/', title: 'My progress', text: 'What you have finished, how your quizzes went, and a backup you can move to another browser.', cta: 'See my progress' },
];
---
<Layout title="Practice | System Design Academy" description="Review quizzes, mock interviews, learning paths and your progress in one place.">
  <section class="hero">
    <h1>Practice</h1>
    <p class="lede">Reading is the start. These are the ways to make it stick.</p>
  </section>
  <div class="grid">
    {tools.map((t) => (
      <a class="card tool" href={url(t.href)}>
        <h2>{t.title}</h2>
        <p>{t.text}</p>
        <small>{t.cta}</small>
      </a>
    ))}
  </div>
</Layout>
<style>
  .hero { padding: 2.5rem 0 1rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .4rem; }
  .grid { grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); margin-bottom: 3rem; }
  .tool { text-decoration: none; color: var(--text); display: block; transition: transform .15s, border-color .15s; }
  .tool:hover { transform: translateY(-2px); border-color: var(--accent); }
  .tool h2 { margin: 0 0 .3rem; font-size: 1.15rem; }
  .tool p { margin: 0 0 .5rem; color: var(--muted); }
  .tool small { color: var(--accent); }
</style>
