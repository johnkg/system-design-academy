---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { url } from '../lib';

// The two ways to practise get a large card each; the rest are tools that support them.
const main = [
  {
    href: 'review/', title: 'Review', cta: 'Start a review', icon: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l3 2" />',
    text: 'Ten scenario questions at a time. Right answers come back later; wrong ones come back tomorrow.',
    detail: ['Spaced over days', 'Ten questions a round'],
    live: true,
  },
  {
    href: 'interview/', title: 'Mock interview', cta: 'Draw a task', icon: '<circle cx="12" cy="13" r="8" /><path d="M12 9v4l2.5 2M9 2h6" />',
    text: 'A random case-study task, a clock and five stages. Compare with the real design at the end.',
    detail: ['Clarify', 'Estimate', 'Design', 'Deep dive', 'Wrap up'],
  },
];
const tools = [
  { href: 'paths/', title: 'Learning paths', text: 'Curated sequences of concepts and case studies, with the next step highlighted.', cta: 'Pick a path', icon: '<circle cx="6" cy="19" r="2.5" /><circle cx="18" cy="5" r="2.5" /><path d="M8.5 19H15a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6.5" />' },
  { href: 'map/', title: 'Concept map', text: 'Pick a concept to see what to read first, what it opens up, and the case studies that use it.', cta: 'Explore the map', icon: '<circle cx="12" cy="12" r="2.5" /><circle cx="5" cy="5" r="2" /><circle cx="19" cy="6" r="2" /><circle cx="6" cy="19" r="2" /><circle cx="19" cy="18" r="2" /><path d="m10 10-3.5-3.5M14 11l3.5-3.5M10 14l-2.5 3.5M14 13.5l3.5 3" />' },
  { href: 'cheatsheets/', title: 'Cheat sheets', text: 'One printable page per area: what each idea is for, when to use it, when to skip it, and the main trap.', cta: 'Open the sheets', icon: '<path d="M7 3h8l4 4v14H7z" /><path d="M15 3v4h4M10 12h6M10 16h6" />' },
  { href: 'progress/', title: 'My progress', text: 'What you have finished, how your quizzes went, and a backup you can move to another browser.', cta: 'See my progress', icon: '<path d="M4 20V10M10 20V4M16 20v-8M22 20H2" />' },
];
const arrow = '<path d="M5 12h14M13 6l6 6-6 6" />';
---
<Layout title="Practice | System Design Academy" description="Review quizzes, mock interviews, learning paths and your progress in one place.">
  <PageHead eyebrow="Practice" title="Reading is the start. Practice makes it stick." lede="Quiz yourself on a schedule, rehearse a full interview, and keep track of where you are. Everything is saved in this browser only." />

  <section class="main" aria-label="Practise">
    {main.map((m) => (
      <a class="big card" href={url(m.href)}>
        <span class="ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={m.icon} /></span>
        <h2>{m.title}</h2>
        <p>{m.text}</p>
        {m.live && <p class="live" data-due hidden><span class="n mono" data-due-n></span> <span data-due-text></span></p>}
        <ul class="steps">{m.detail.map((d) => <li>{d}</li>)}</ul>
        <span class="cta">{m.cta}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></span>
      </a>
    ))}
  </section>

  <section aria-labelledby="tools-h" class="tools">
    <h2 id="tools-h" class="eyebrow">Tools to go with it</h2>
    <ul class="grid">
      {tools.map((t) => (
        <li>
          <a class="tool card" href={url(t.href)}>
            <span class="ic sm"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} /></span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
            <span class="cta">{t.cta}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
<script>
  // How many review questions are due today, from the same browser storage the review page uses.
  const box = document.querySelector<HTMLElement>('[data-due]');
  const review = (window as any).sdaReview;
  if (box && review) {
    const all = review.load(), today = review.today();
    const keys = Object.keys(all);
    const due = keys.filter((k) => all[k] && all[k].d <= today).length;
    box.querySelector('[data-due-n]')!.textContent = due ? String(due) : '';
    box.querySelector('[data-due-text]')!.textContent = !keys.length ? 'Answer a quiz question anywhere to start your schedule.' : due ? `question${due === 1 ? '' : 's'} due today` : 'Nothing due today. Nice.';
    box.hidden = false;
  }
</script>
<style>
  .main { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); margin-bottom: 2.5rem; }
  .big, .tool { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; color: var(--text); text-decoration: none; }
  .big { padding: 24px; }
  .big:hover, .tool:hover { border-color: var(--accent); color: var(--text); box-shadow: 0 0 0 3px var(--accent-soft); }
  .big:focus-visible, .tool:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; border: 1px solid var(--border); background: var(--accent-soft); color: var(--accent); margin-bottom: 6px; }
  .ic.sm { width: 40px; height: 40px; }
  .big h2 { margin: 0; font-size: 1.5rem; }
  .big p, .tool p { margin: 0; color: var(--muted); }
  .live { display: flex; align-items: baseline; gap: 8px; padding: 6px 12px; border-radius: 8px; background: var(--signal-soft); border: 1px solid var(--signal-line); color: var(--signal-text); font-weight: 600; }
  .live .n { font-size: 1.2rem; }
  .steps { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .steps li { padding: 2px 10px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg); font: .76rem var(--font-mono); color: var(--muted); }
  .cta { margin-top: auto; padding-top: 10px; display: inline-flex; align-items: center; gap: 8px; color: var(--accent); font-weight: 600; }
  .tools h2 { margin: 0 0 12px; }
  .tools .grid { list-style: none; margin: 0 0 3rem; padding: 0; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .tools li { display: flex; min-width: 0; }
  .tool { flex: 1; padding: 18px; }
  .tool h3 { margin: 0; font-size: 1.1rem; }
  .tool p { font-size: .95rem; }
</style>
