---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CompareView from '../components/CompareView.astro';
import PageHead from '../components/PageHead.astro';
import CompareTabs from '../components/CompareTabs.astro';
import { url } from '../lib';
import { problems, confusions } from '../data/compare';

const all = await getCollection('patterns');
// Fail the build on any typo in the hand-written data.
const known = new Set(all.map((p) => p.id));
const need = (slug: string) => { if (!known.has(slug)) throw new Error(`src/data/compare.ts references unknown pattern "${slug}"`); };
problems.forEach((pr) => pr.patterns.forEach((x) => need(x.slug)));
confusions.forEach((c) => c.patterns.forEach(need));
confusions.forEach((c) => c.rows.forEach((r) => {
  if (r.values.length !== c.patterns.length) throw new Error(`compare.ts: "${c.title}" row "${r.aspect}" has ${r.values.length} values for ${c.patterns.length} patterns`);
}));

const groups = [
  { id: 'creational', label: 'Creational', color: 'var(--role-1)' },
  { id: 'structural', label: 'Structural', color: 'var(--role-3)' },
  { id: 'behavioral', label: 'Behavioral', color: 'var(--role-4)' },
];
const items = all.map((p) => ({ id: p.id, name: p.data.name, group: p.data.category, difficulty: p.data.difficulty, intent: p.data.intent, use: p.data.whenToUse[0], skip: p.data.whenNotToUse[0], href: url(`patterns/${p.id}/`) }));
---
<Layout title="Compare patterns | System Design Academy" description="Find the right design pattern for a problem, and see how look-alike patterns differ.">
  <PageHead eyebrow="Compare · design patterns" title="Which pattern do I need?" lede="Start from the problem you have, check the patterns people mix up, or scan everything on one page.">
    <CompareTabs current="patterns" />
  </PageHead>
  <CompareView noun="pattern" groups={groups} groupLabel="Pattern category" placeholder="Describe what you need… e.g. undo, copy, notify, tree" items={items} problems={problems} confusions={confusions} />
</Layout>
