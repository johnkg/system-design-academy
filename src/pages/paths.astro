---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { url } from '../lib';
import { paths } from '../data/paths';

const concepts = await getCollection('concepts');
const patterns = await getCollection('patterns');
const studies = await getCollection('studies');

// Resolve every step; a typo in src/data/paths.ts fails the build.
const resolved = paths.map((p) => ({
  ...p,
  items: p.steps.map((st) => {
    const hit = st.kind === 'concept' ? concepts.find((c) => c.id === st.slug) : st.kind === 'pattern' ? patterns.find((x) => x.id === st.slug) : studies.find((x) => x.id === st.slug);
    if (!hit) throw new Error(`Path "${p.id}" references unknown ${st.kind} "${st.slug}"`);
    const folder = st.kind === 'concept' ? 'concepts' : st.kind === 'pattern' ? 'patterns' : 'studies';
    return {
      kind: st.kind, name: hit.data.name, intent: hit.data.intent, difficulty: hit.data.difficulty,
      key: `${folder}/${st.slug}`, href: url(`${st.kind === 'study' ? 'case-studies' : folder}/${st.slug}/`),
    };
  }),
}));
---
<Layout title="Learning paths | System Design Academy" description="Curated sequences of concepts and case studies, with your progress kept in this browser.">
  <section class="hero">
    <h1>Learning paths</h1>
    <p class="lede">Each path puts concepts first and case studies last, so every design uses ideas you have already met. Mark pages as done and the path shows what is next. Progress stays in this browser; nothing is sent anywhere.</p>
  </section>
  <nav class="jump" aria-label="Paths">
    <ul>{resolved.map((p) => <li><a href={`#${p.id}`}>{p.title}</a></li>)}</ul>
  </nav>
  {resolved.map((p) => (
    <section class="path" id={p.id} data-path aria-labelledby={`${p.id}-h`}>
      <p class="aud">{p.audience}</p>
      <h2 id={`${p.id}-h`}>{p.title}</h2>
      <p class="blurb">{p.blurb}</p>
      <p class="prog"><span data-path-count aria-live="polite">0 of {p.items.length} done</span></p>
      <div class="bar" aria-hidden="true"><span data-path-bar></span></div>
      <ol class="steps">
        {p.items.map((i) => (
          <li class="card step" data-card-key={i.key}>
            <span class="kind">{i.kind === 'study' ? 'Case study' : i.kind === 'concept' ? 'Concept' : 'Pattern'}</span>
            <h3><a href={i.href}>{i.name}</a></h3>
            <p>{i.intent}</p>
            <span class="next-flag">Next up</span>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Layout>
<style>
  .hero { padding: 2.5rem 0 1rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .4rem; }
  .jump ul { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0 0 1rem; }
  .jump a { display: inline-block; padding: 4px 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--text); text-decoration: none; font-size: .88rem; }
  .jump a:hover { background: var(--surface-2); }
  .path { scroll-margin-top: calc(var(--header-h) + 12px); }
  .path h2 { margin: .1rem 0 .3rem; }
  .aud { margin: 2.5rem 0 0; font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .blurb { margin: 0 0 .5rem; max-width: 70ch; color: var(--muted); }
  .prog { margin: 0 0 .3rem; font-size: .9rem; }
  .bar { height: 6px; border-radius: 99px; background: var(--surface-2); overflow: hidden; margin-bottom: 1rem; max-width: 420px; }
  .bar span { display: block; height: 100%; width: 0; background: var(--accent); transition: width .25s; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; counter-reset: step; }
  .step { padding: 10px 14px 10px 54px; position: relative; counter-increment: step; }
  .step::before { content: counter(step); position: absolute; left: 14px; top: 12px; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: .85rem; }
  .step h3 { margin: 0; font-size: 1.02rem; }
  .step p { margin: .2rem 0 0; color: var(--muted); font-size: .92rem; }
  .kind { font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  .step.is-done { border-color: var(--good); }
  .step.is-done::before { content: '\2713'; background: var(--accent-soft); color: var(--text); box-shadow: inset 0 0 0 2px var(--good); }
  .step.is-next { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .next-flag { display: none; position: absolute; top: 10px; right: 10px; font-size: .75rem; padding: 2px 8px; border-radius: 99px; background: var(--accent); color: var(--on-accent); }
  .step.is-next .next-flag { display: inline-block; }
  main > :global(*:last-child) { margin-bottom: 3rem; }
</style>
