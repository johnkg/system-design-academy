---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { url } from '../lib';
import { areas } from '../data/areas';
import { buildGraph } from '../graph';

const concepts = (await getCollection('concepts')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const studies = await getCollection('studies');
const graph = buildGraph(concepts, studies);
const nodes = Object.fromEntries(graph.map((n) => [n.slug, n]));
const groups = areas.filter((a) => graph.some((n) => n.area === a.id)).map((a) => ({ ...a, items: graph.filter((n) => n.area === a.id) }));
const payload = JSON.stringify(nodes).replace(/</g, '\\u003c');
---
<Layout title="Concept map | System Design Academy" description="Pick a concept to see what to read first, what it opens the door to, and which case studies use it.">
  <section class="hero">
    <h1>Concept map</h1>
    <p class="lede">Pick a concept and see what to read first, what it opens the door to, and which case studies put it to work. Click any name to move the map there.</p>
  </section>

  <div class="card picker">
    <label for="concept">Concept</label>
    <select id="concept" class="pg-in" data-pick>
      {groups.map((g) => (
        <optgroup label={g.label}>{g.items.map((n) => <option value={n.slug}>{n.name}</option>)}</optgroup>
      ))}
    </select>
  </div>

  <div class="map" aria-live="polite">
    <section class="col" aria-labelledby="first-h">
      <h2 id="first-h">Read first</h2>
      <ul data-first></ul>
      <p class="none" data-first-none hidden>Nothing needed first. This is a good place to start.</p>
    </section>
    <section class="col centre" aria-labelledby="this-h">
      <h2 id="this-h">This concept</h2>
      <p class="name" data-name tabindex="-1"></p>
      <p class="meta" data-meta></p>
      <p><a class="btn pg-primary" data-open href={url('')}>Open the page</a></p>
    </section>
    <section class="col" aria-labelledby="next-h">
      <h2 id="next-h">Opens the door to</h2>
      <ul data-next></ul>
      <p class="none" data-next-none hidden>Nothing builds directly on this yet.</p>
    </section>
  </div>

  <p class="note">The map is derived from each concept's related links (same area, or both list each other) and its difficulty, so treat it as a suggestion for where to read next, not a strict order.</p>

  <section class="card studies">
    <h2>Case studies that use it</h2>
    <ul data-studies></ul>
    <p class="none" data-studies-none hidden>No case study uses this concept yet.</p>
  </section>
  <script type="application/json" id="map-data" set:html={payload}></script>
</Layout>
<script>
  interface N { slug: string; name: string; area: string; level: string; href: string; first: string[]; next: string[]; studies: { name: string; href: string }[] }
  const nodes: Record<string, N> = JSON.parse(document.getElementById('map-data')!.textContent!);
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const pick = $<HTMLSelectElement>('[data-pick]');

  function list(el: HTMLElement, slugs: string[]) {
    el.replaceChildren(...slugs.map((s) => {
      const li = document.createElement('li'), b = document.createElement('button');
      b.type = 'button'; b.className = 'chip'; b.textContent = nodes[s].name; b.dataset.go = s;
      b.setAttribute('aria-label', `Move the map to ${nodes[s].name}`);
      li.append(b); return li;
    }));
  }
  function show(slug: string, push = true) {
    const n = nodes[slug]; if (!n) return;
    pick.value = slug;
    $('[data-name]').textContent = n.name;
    $('[data-meta]').textContent = `${n.level}, ${n.area}`;
    $<HTMLAnchorElement>('[data-open]').href = n.href;
    list($('[data-first]'), n.first); $('[data-first-none]').hidden = n.first.length > 0;
    list($('[data-next]'), n.next); $('[data-next-none]').hidden = n.next.length > 0;
    const ul = $('[data-studies]'); ul.replaceChildren(...n.studies.map((s) => { const li = document.createElement('li'), a = document.createElement('a'); a.href = s.href; a.textContent = s.name; li.append(a); return li; }));
    $('[data-studies-none]').hidden = n.studies.length > 0;
    if (push) history.replaceState(null, '', `?c=${slug}`);
  }
  pick.addEventListener('change', () => show(pick.value));
  document.addEventListener('click', (e) => { const b = (e.target as Element).closest<HTMLElement>('[data-go]'); if (b) { show(b.dataset.go!); $('#this-h').scrollIntoView({ block: 'nearest' }); $('[data-name]').focus({ preventScroll: true }); } }); // the pressed chip is gone, so focus the new concept
  const q = new URLSearchParams(location.search).get('c');
  show(q && nodes[q] ? q : pick.value, !!q);
</script>
<style>
  .hero { padding: 2.5rem 0 1rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 .4rem; }
  .picker { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; margin-bottom: 14px; }
  .picker select { max-width: 100%; }
  .map { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 14px; margin-bottom: 14px; }
  .col { border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; background: var(--surface); min-width: 0; }
  .col h2, .studies h2 { font-size: 1rem; margin: 0 0 .6rem; color: var(--muted); }
  .centre { border-color: var(--accent); }
  .name { font-size: 1.3rem; font-weight: 700; margin: 0; overflow-wrap: anywhere; }
  .meta { margin: .2rem 0 .8rem; color: var(--muted); text-transform: capitalize; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .none { margin: 0; color: var(--muted); }
  .note { color: var(--muted); font-size: .9rem; margin: 0 0 14px; }
  .studies { margin-bottom: 3rem; }
  .studies ul { display: grid; gap: 4px; }
  .studies a { overflow-wrap: anywhere; }
  :global(.map .chip) { font: inherit; border: 1px solid var(--border); background: var(--surface); color: var(--text); border-radius: 999px; padding: 6px 12px; cursor: pointer; text-align: left; overflow-wrap: anywhere; min-height: 32px; }
  :global(.map .chip:hover) { border-color: var(--accent); background: var(--surface-2); }
</style>
