---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Clone goblins from a prototype, then change one and see who else changes.">
  <ol class="how">
    <li>Press <b>Spawn clone</b> two or three times.</li>
    <li>Press <b>Give shield</b> on one goblin.</li>
    <li>Switch between <b>Deep clone</b> and <b>Shallow copy (bug)</b> and repeat. Watch the other goblins.</li>
  </ol>
  <div class="pg" data-proto>
    <div class="pg-row" role="group" aria-label="Copy mode">
      <button class="btn" type="button" data-mode="deep" aria-pressed="true">Deep clone</button>
      <button class="btn" type="button" data-mode="shallow" aria-pressed="false">Shallow copy (bug)</button>
      <button class="btn pg-primary" type="button" data-spawn>Spawn clone</button>
      <button class="btn" type="button" data-clear>Clear</button>
    </div>
    <div class="pg-box" style="--c: var(--role-2)" data-protobox></div>
    <div class="pg-grid" data-grid></div>
    <p class="pg-note" data-note aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  const GOBLIN_HP = 30;
  class Enemy {
    constructor(public name: string, public hp: number, public items: string[]) {}
    clone() { return new Enemy(this.name, this.hp, [...this.items]); }          // deep: copies the list
    shallow() { return new Enemy(this.name, this.hp, this.items); }               // shallow: shares the list
  }
  document.querySelectorAll<HTMLElement>('[data-proto]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let deep = true;
    let proto = new Enemy('Goblin', GOBLIN_HP, ['club']);
    let goblins: Enemy[] = [];
    let n = 0;
    function render() {
      q('[data-protobox]').innerHTML = `<h3>Prototype: Goblin</h3><span class="pg-mono">hp ${proto.hp} · items [${proto.items.join(', ')}]</span>`;
      const grid = q('[data-grid]'); grid.innerHTML = '';
      goblins.forEach((g, i) => {
        const shared = g.items === proto.items;
        const d = document.createElement('div'); d.className = 'pg-box'; d.style.setProperty('--c', shared ? 'var(--bad)' : 'var(--role-3)');
        d.innerHTML = `<h3>Goblin #${i + 1}</h3><span class="pg-mono">items [${g.items.join(', ')}]</span><span class="pg-note">${shared ? 'shares the prototype list' : 'own list'}</span>`;
        const b = document.createElement('button'); b.className = 'btn'; b.type = 'button'; b.textContent = 'Give shield';
        b.addEventListener('click', () => { g.items.push('shield'); render(); }); d.appendChild(b); grid.appendChild(d);
      });
      q('[data-note]').textContent = goblins.length ? (deep ? 'Deep clone: each goblin owns its list.' : 'Shallow copy: one array shared by everyone. A shield for one is a shield for all.') : 'No goblins yet.';
    }
    q('[data-spawn]').addEventListener('click', () => { n++; goblins.push(deep ? proto.clone() : proto.shallow()); render(); });
    q('[data-clear]').addEventListener('click', () => { goblins = []; proto = new Enemy('Goblin', GOBLIN_HP, ['club']); render(); });
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
      deep = b.dataset.mode === 'deep'; root.querySelectorAll('[data-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      goblins = []; proto = new Enemy('Goblin', GOBLIN_HP, ['club']); render();
    }));
    render();
  });
</script>
