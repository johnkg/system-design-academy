---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A 32-test suite run 200 times. Four tests flake for dull reasons (shared state, the clock, a fixed sleep), and one test hides a real bug that fails about 1 attempt in 20. Choose how to deal with the flakiness and watch what happens to the real bug.">
  <ol class="how">
    <li>Start with the defaults, no retries, nothing fixed: <b>68</b> of 200 builds go red, and <b>54</b> of them are false alarms. The real bug shows up <b>14</b> times and is reported <b>14</b> times, but it is buried in noise.</li>
    <li>Set <b>Extra attempts</b> to <b>2</b>: the builds go green, <b>0</b> red, so the retry looks like a fix. But the real bug still showed up <b>14</b> times and was reported <b>0</b> times: all <b>14</b> hidden.</li>
    <li>Set <b>Extra attempts</b> back to <b>0</b> and tick <b>Quarantine the flaky tests</b>: again <b>0</b> red builds, and again <b>14</b> hidden, because the real-bug test looked flaky and was quarantined with the rest.</li>
    <li>Untick <b>Quarantine the flaky tests</b> and tick <b>Isolate shared state</b>, <b>Use a fake clock</b> and <b>Poll instead of sleeping</b>: only <b>14</b> builds go red, every one of them the real bug, with <b>0</b> false alarms, and the suite is cheaper to run (<b>10,617</b> units).</li>
  </ol>
  <div class="pg fl" data-fl>
    <div class="pg-row">
      <label>Extra attempts <select class="pg-in" data-retries>
        <option value="0" selected>0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option>
      </select></label>
      <label><input type="checkbox" data-quarantine /> Quarantine the flaky tests</label>
      <label><input type="checkbox" data-state /> Isolate shared state</label>
      <label><input type="checkbox" data-clock /> Use a fake clock</label>
      <label><input type="checkbox" data-poll /> Poll instead of sleeping</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Red builds</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>False alarms</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Real bug showed up</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Real bug reported by the build</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Real bug hidden</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Suite cost</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
    </div>
    <ul class="pg-log" data-log tabindex="0" aria-label="The flaky tests and their causes">
      <li>reader: fails when a writer test ran just before it and left shared state (order dependence)</li>
      <li>clock: fails when the test happens to run near a minute boundary (time)</li>
      <li>sleep, twice: waits 18 ticks for a job that takes 1 to 20 (a fixed wait for an async job)</li>
      <li>race: a real bug in the code, failing on about 1 attempt in 20 (looks identical from outside)</li>
    </ul>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const TESTS = 32, RUNS = 200, WAIT = 18;

  // The same model as the code samples.
  function seeded(seed: number) {
    let s = seed;
    return (n: number) => { s = (s * 48271) % 2147483647; return s % n; };
  }
  function simulate(retries: number, quarantine: boolean, fixState: boolean, fixClock: boolean, fixPoll: boolean) {
    const rand = seeded(7), again = seeded(99);
    let red = 0, falseAlarm = 0, showed = 0, reported = 0, cost = 0;
    for (let run = 0; run < RUNS; run++) {
      const w = rand(TESTS), rd0 = rand(TESTS - 1), rd = rd0 >= w ? rd0 + 1 : rd0;
      const jobs = [1 + rand(20), 1 + rand(20)];
      let order = !fixState && rd > w && rd - w <= 3;
      const tick = rand(60);
      let clock = !fixClock && tick >= 58;
      const sleep = jobs.map((d) => !fixPoll && d > WAIT);
      let race = rand(20) === 0;
      cost += TESTS + jobs.reduce((sum, d) => sum + (fixPoll ? d : WAIT), 0);
      if (race) showed++;
      for (let attempt = 0; attempt < retries; attempt++) {
        if (order) { order = false; cost += 1; }
        if (clock) { clock = !fixClock && again(60) >= 58; cost += 1; }
        for (let i = 0; i < 2; i++) if (sleep[i]) { const d = 1 + again(20); sleep[i] = d > WAIT; cost += 1 + WAIT; }
        if (race) { race = again(20) === 0; cost += 1; }
      }
      if (quarantine) { order = false; clock = false; sleep[0] = false; sleep[1] = false; race = false; }
      const failed = order || clock || sleep[0] || sleep[1] || race;
      if (failed) { red++; if (!race) falseAlarm++; }
      if (race) reported++;
    }
    return { red, falseAlarm, showed, reported, hidden: showed - reported, cost };
  }

  document.querySelectorAll<HTMLElement>('[data-fl]').forEach((root) => {
    const q = query(root);
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    const checked = (s: string) => q<HTMLInputElement>(s).checked;
    function draw() {
      const retries = Number(q<HTMLSelectElement>('[data-retries]').value);
      const r = simulate(retries, checked('[data-quarantine]'), checked('[data-state]'), checked('[data-clock]'), checked('[data-poll]'));
      set(1, `${r.red} of ${RUNS}`, 'builds that ended red');
      box(1, r.red <= 20);
      set(2, String(r.falseAlarm), 'red builds where the real bug did not fail: noise');
      box(2, r.falseAlarm === 0);
      set(3, String(r.showed), 'runs where the real bug failed on the first attempt');
      box(3, true);
      set(4, String(r.reported), 'runs where the build was red because of the real bug');
      box(4, r.reported === r.showed);
      set(5, String(r.hidden), r.hidden === 0 ? 'nothing real was masked' : 'the bug failed once, a retry or quarantine turned the build green, and it shipped');
      box(5, r.hidden === 0);
      set(6, formatThousands(r.cost), 'assumed units: 1 per test, 1 per tick of waiting, retries included');
      box(6, true);
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
