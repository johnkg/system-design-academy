---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Choose parts. The builder code is generated as you go; build() decides if it is valid.">
  <ol class="how">
    <li>Pick a <b>size</b>, a <b>crust</b> and some <b>toppings</b>.</li>
    <li>Watch the <b>builder chain</b> grow. Press <b>Build</b> to get the pizza.</li>
    <li>Choose more than 4 toppings: <b>build()</b> refuses. Or press <b>Margherita</b> to let the director do it.</li>
  </ol>
  <div class="pg" data-builder>
    <div class="pg-row">
      <label>Size <select class="pg-in" data-size><option>small</option><option selected>medium</option><option>large</option></select></label>
      <label>Crust <select class="pg-in" data-crust><option selected>thin</option><option>thick</option><option>stuffed</option></select></label>
      <label><input type="checkbox" data-sauce /> Extra sauce</label>
    </div>
    <div class="pg-row" data-tops></div>
    <pre class="pg-code" data-code></pre>
    <div class="pg-row"><button class="btn pg-primary" type="button" data-build>Build</button><button class="btn" type="button" data-margherita>Margherita (director)</button></div>
    <output class="pg-out" data-out>Press Build.</output>
  </div>
</PlaygroundShell>
<script>
  class Pizza { constructor(public size: string, public crust: string, public toppings: string[], public extra: boolean) { Object.freeze(this); }
    describe() { return `${this.size} ${this.crust} pizza with ${this.toppings.join(', ') || 'no toppings'}${this.extra ? ', extra sauce' : ''}`; } }
  const MAX_TOPPINGS = 4;
  class PizzaBuilder {
    private s = 'medium'; private c = 'thin'; private t: string[] = []; private x = false;
    size(v: string) { this.s = v; return this; } crust(v: string) { this.c = v; return this; }
    addTopping(n: string) { this.t.push(n); return this; } extraSauce() { this.x = true; return this; }
    build() { if (this.t.length > MAX_TOPPINGS) throw new Error(`Too many toppings (max ${MAX_TOPPINGS})`); return new Pizza(this.s, this.c, [...this.t], this.x); }
  }
  const toppings = ['ham', 'olives', 'mushrooms', 'peppers', 'basil', 'pineapple'];
  document.querySelectorAll<HTMLElement>('[data-builder]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const picked = new Set<string>();
    const box = q('[data-tops]');
    toppings.forEach((t) => {
      const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = t; b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', () => { picked.has(t) ? picked.delete(t) : picked.add(t); b.setAttribute('aria-pressed', String(picked.has(t))); code(); });
      box.appendChild(b);
    });
    function chain() {
      const size = q<HTMLSelectElement>('[data-size]').value, crust = q<HTMLSelectElement>('[data-crust]').value, sauce = q<HTMLInputElement>('[data-sauce]').checked;
      return { size, crust, sauce };
    }
    function code() {
      const { size, crust, sauce } = chain();
      q('[data-code]').textContent = `new PizzaBuilder()\n  .size("${size}")\n  .crust("${crust}")` + [...picked].map((t) => `\n  .addTopping("${t}")`).join('') + (sauce ? '\n  .extraSauce()' : '') + '\n  .build()';
    }
    const show = (text: string, bad = false) => { const o = q('[data-out]'); o.textContent = text; o.classList.toggle('bad', bad); o.classList.remove('pg-pop'); void o.offsetWidth; o.classList.add('pg-pop'); };
    q('[data-build]').addEventListener('click', () => {
      const { size, crust, sauce } = chain();
      try { const b = new PizzaBuilder().size(size).crust(crust); picked.forEach((t) => b.addTopping(t)); if (sauce) b.extraSauce(); show(b.build().describe()); }
      catch (e) { show(`Error from build(): ${(e as Error).message}`, true); }
    });
    q('[data-margherita]').addEventListener('click', () => show('Director: ' + new PizzaBuilder().size('medium').addTopping('mozzarella').addTopping('basil').build().describe()));
    root.querySelectorAll('select,input').forEach((e) => e.addEventListener('change', code));
    code();
  });
</script>
