---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Sort a list with one algorithm and count comparisons (counting sort: steps), not time. The input is generated by a fixed formula, so the numbers never change. Any time shown assumes one comparison per nanosecond, a rough guide.">
  <ol class="how">
    <li>Set <b>Algorithm</b> to <b>Insertion sort</b>, <b>Input</b> to <b>Random</b> and <b>Items n</b> to <b>1,000</b>: <b>256,407</b> comparisons, against <b>8,728</b> for merge sort on the same list. Quicksort with a first-element pivot needs <b>12,469</b> on random data.</li>
    <li>Set <b>Algorithm</b> to <b>Quicksort (first element as pivot)</b> and <b>Input</b> to <b>Already sorted</b>: <b>499,500</b> comparisons, marked as the worst case, while merge sort needs <b>4,932</b>. Every pivot is the smallest item left, so each partition peels off one element. With <b>Many duplicates</b> it needs <b>53,015</b>.</li>
    <li>Set <b>Algorithm</b> to <b>Counting sort</b> and <b>Input</b> to <b>Random</b>: <b>67,532</b> steps, more than merge sort, because the keys go up to 100,000 and the scan visits every possible key. Set <b>Input</b> to <b>Many duplicates</b> (only 10 distinct keys) and it falls to <b>2,010</b> steps. Then set <b>Algorithm</b> to <b>Top 10 with a heap</b> and <b>Input</b> to <b>Random</b>: <b>1,171</b> comparisons instead of sorting everything. Set <b>Input</b> to <b>Already sorted</b>: <b>6,015</b>, since every new item beats the smallest of the ten.</li>
    <li>In the box <b>Search many times</b>, with <b>Input</b> <b>Random</b> and <b>Items n</b> <b>1,000</b>, sorting first pays off from <b>18</b> searches. Set <b>Searches to run</b> to <b>100</b>: linear search costs <b>50,000</b> comparisons, sorting once and using binary search costs <b>9,728</b>.</li>
  </ol>
  <div class="pg ss" data-ss>
    <div class="pg-row">
      <label>Algorithm <select class="pg-in" data-algo><option value="insertion" selected>Insertion sort</option><option value="merge">Merge sort</option><option value="quick">Quicksort (first element as pivot)</option><option value="counting">Counting sort</option><option value="heap">Top 10 with a heap</option></select></label>
      <label>Input <select class="pg-in" data-pattern><option value="random" selected>Random</option><option value="sorted">Already sorted</option><option value="reversed">Reversed</option><option value="duplicates">Many duplicates</option></select></label>
      <label>Items n <select class="pg-in" data-n><option value="10">10</option><option value="50">50</option><option value="100">100</option><option value="500">500</option><option value="1000" selected>1,000</option><option value="5000">5,000</option><option value="10000">10,000</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3 data-h1>Comparisons</h3><span class="pg-mono ss-big" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Merge sort on the same list</h3><span class="pg-mono ss-big" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Against merge sort</h3><span class="pg-mono ss-big" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Crossover with merge sort</h3><span class="pg-mono ss-big" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Operations, log scale</h3>
      <div class="ss-bars" data-bars></div>
      <span class="pg-note" data-verdict></span>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Search many times</h3>
      <div class="pg-row"><label>Searches to run <input class="pg-in" type="number" data-q value="100" min="1" max="1000000" step="1" style="width: 8em" /></label></div>
      <div class="pg-grid">
        <div class="pg-box" style="--c: var(--border)"><h3>Sort once (merge sort)</h3><span class="pg-mono ss-big" data-s1></span></div>
        <div class="pg-box" style="--c: var(--border)"><h3>Per search: linear / binary</h3><span class="pg-mono ss-big" data-s2></span><span class="pg-note">linear averages about n/2 comparisons; binary needs about log2 n</span></div>
        <div class="pg-box" data-sb3><h3>Sorting pays off from</h3><span class="pg-mono ss-big" data-s3></span></div>
      </div>
      <span class="pg-mono" data-s4></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  type Counter = (a: number[]) => number;

  // The same model as the code samples: a fixed integer generator, and comparison counters for each algorithm.
  function makeInput(pattern: string, n: number): number[] {
    const a: number[] = []; let x = 12345;
    for (let i = 0; i < n; i++) {
      x = (x * 1664525 + 1013904223) % 4294967296;
      const r = Math.floor(x / 65536) % 100000;
      a.push(pattern === 'sorted' ? i + 1 : pattern === 'reversed' ? n - i : pattern === 'duplicates' ? r % 10 : r);
    }
    return a;
  }
  const insertion: Counter = (a) => {
    let count = 0;
    for (let i = 1; i < a.length; i++) {
      const v = a[i]; let j = i;
      while (j > 0) { count++; if (a[j - 1] > v) { a[j] = a[j - 1]; j--; } else break; }
      a[j] = v;
    }
    return count;
  };
  const merge: Counter = (a) => {
    let count = 0;
    const sort = (lo: number, hi: number) => {
      if (hi - lo < 2) return;
      const mid = Math.floor((lo + hi) / 2);
      sort(lo, mid); sort(mid, hi);
      const left = a.slice(lo, mid), right = a.slice(mid, hi);
      let i = 0, j = 0, k = lo;
      while (i < left.length && j < right.length) { count++; if (right[j] < left[i]) a[k++] = right[j++]; else a[k++] = left[i++]; }
      while (i < left.length) a[k++] = left[i++];
      while (j < right.length) a[k++] = right[j++];
    };
    sort(0, a.length);
    return count;
  };
  const quick: Counter = (a) => {
    let count = 0; const stack: [number, number][] = [[0, a.length - 1]];
    while (stack.length) {
      const [lo, hi] = stack.pop()!;
      if (lo >= hi) continue;
      const pivot = a[lo]; let i = lo;
      for (let j = lo + 1; j <= hi; j++) { count++; if (a[j] < pivot) { i++; [a[i], a[j]] = [a[j], a[i]]; } }
      [a[lo], a[i]] = [a[i], a[lo]];
      stack.push([lo, i - 1], [i + 1, hi]);
    }
    return count;
  };
  const counting: Counter = (a) => {
    let max = 0; for (const v of a) max = Math.max(max, v);
    const counts = new Array<number>(max + 1).fill(0); let steps = 0;
    for (const v of a) { counts[v]++; steps++; }
    for (let v = 0; v <= max; v++) { steps++; steps += counts[v]; }
    return steps;
  };
  const heap: Counter = (a) => {
    const K = 10; let count = 0; const h: number[] = [];
    const siftUp = (i: number) => { while (i > 0) { const p = (i - 1) >> 1; count++; if (h[i] < h[p]) { [h[i], h[p]] = [h[p], h[i]]; i = p; } else break; } };
    const siftDown = (i: number) => {
      for (;;) {
        const l = 2 * i + 1, r = l + 1;
        if (l >= h.length) break;
        let s = l;
        if (r < h.length) { count++; if (h[r] < h[l]) s = r; }
        count++;
        if (h[s] < h[i]) { [h[i], h[s]] = [h[s], h[i]]; i = s; } else break;
      }
    };
    for (const x of a) { if (h.length < K) { h.push(x); siftUp(h.length - 1); } else { count++; if (x > h[0]) { h[0] = x; siftDown(0); } } }
    return count;
  };
  const ALGOS: Record<string, { run: Counter; unit: string; name: string }> = {
    insertion: { run: insertion, unit: 'comparisons', name: 'Insertion sort' },
    merge: { run: merge, unit: 'comparisons', name: 'Merge sort' },
    quick: { run: quick, unit: 'comparisons', name: 'Quicksort (first element as pivot)' },
    counting: { run: counting, unit: 'steps', name: 'Counting sort' },
    heap: { run: heap, unit: 'comparisons', name: 'Top 10 with a heap' },
  };
  const cost = (algo: string, pattern: string, n: number) => ALGOS[algo].run(makeInput(pattern, n));

  const GRID = [4, 5, 6, 8, 10, 13, 16, 20, 25, 32, 40, 50, 64, 80, 100, 130, 160, 200, 250, 320, 400, 500, 640, 800, 1000, 1300, 1600, 2000];
  const crossCache = new Map<string, number | null>();
  // The first size where the chosen algorithm switches from cheaper to dearer than merge sort (or the reverse).
  function crossover(algo: string, pattern: string): number | null {
    const key = `${algo}/${pattern}`;
    if (crossCache.has(key)) return crossCache.get(key)!;
    let base = 0, found: number | null = null;
    for (const n of GRID) {
      const d = Math.sign(cost(algo, pattern, n) - cost('merge', pattern, n));
      if (d === 0) continue;
      if (base === 0) base = d; else if (d !== base) { found = n; break; }
    }
    crossCache.set(key, found);
    return found;
  }
  function duration(steps: number): string {
    const s = steps / 1e9;
    if (s < 1) return 'under a second';
    if (s < 120) return `about ${Math.round(s)} seconds`;
    if (s < 7200) return `about ${Math.round(s / 60)} minutes`;
    if (s < 172800) return `about ${Math.round(s / 3600)} hours`;
    return `about ${formatThousands(Math.round(s / 86400))} days`;
  }

  document.querySelectorAll<HTMLElement>('[data-ss]').forEach((root) => {
    const q = query(root);
    const colour = (id: string, c: string) => q<HTMLElement>(id).style.setProperty('--c', c);
    function draw() {
      const algo = q<HTMLSelectElement>('[data-algo]').value, pattern = q<HTMLSelectElement>('[data-pattern]').value;
      const n = Number(q<HTMLSelectElement>('[data-n]').value);
      const a = ALGOS[algo];
      const mine = cost(algo, pattern, n), mer = cost('merge', pattern, n);
      const quadratic = (n * (n - 1)) / 2;
      const worst = n >= 10 && mine >= 0.8 * quadratic && algo !== 'counting' && algo !== 'heap';
      q('[data-h1]').textContent = a.unit === 'steps' ? 'Steps (no comparisons)' : 'Comparisons';
      q('[data-o1]').textContent = formatThousands(mine);
      q('[data-n1]').textContent = worst ? `worst case: close to n(n-1)/2 = ${formatThousands(quadratic)}, growing with the square of n` : algo === 'insertion' && pattern === 'sorted' ? 'best case: one comparison per item, because nothing has to move' : a.name;
      colour('[data-b1]', worst ? 'var(--bad)' : 'var(--good)');
      q('[data-o2]').textContent = formatThousands(mer);
      q('[data-n2]').textContent = 'about n log2 n on any input pattern: its split never depends on the data';
      const ratio = mine / mer;
      q('[data-o3]').textContent = algo === 'merge' ? 'the baseline' : ratio >= 1 ? `${ratio >= 10 ? Math.round(ratio) : (Math.round(ratio * 10) / 10)}x more` : `${Math.round((mer / mine) * 10) / 10}x fewer`;
      q('[data-n3]').textContent = algo === 'merge' ? 'compare the other algorithms with it' : ratio >= 1 ? 'more operations than merge sort needs here' : 'fewer operations than merge sort needs here';
      colour('[data-b3]', algo === 'merge' ? 'var(--border)' : ratio > 2 ? 'var(--bad)' : 'var(--good)');
      const cross = algo === 'merge' ? null : crossover(algo, pattern);
      q('[data-o4]').textContent = algo === 'merge' ? 'none' : cross === null ? 'none' : `n = ${formatThousands(cross)}`;
      q('[data-n4]').textContent = algo === 'merge' ? 'merge sort is compared with itself' : cross === null ? 'on this input the order between the two never flips between 4 and 2,000 items' : 'the first size (4 to 2,000 tested) where the order between this algorithm and merge sort flips';
      colour('[data-b4]', 'var(--border)');

      const bars = q('[data-bars]'); bars.textContent = '';
      const rows: [string, number][] = [[a.name, mine], ['Merge sort', mer], ['n log2 n (reference)', Math.round(n * Math.log2(n))], ['n squared (reference)', n * n]];
      const top = Math.log10(Math.max(...rows.map((r) => r[1]), 10));
      for (const [label, v] of rows) {
        const row = document.createElement('div'); row.className = 'ss-bar';
        const name = document.createElement('span'); name.textContent = label;
        const track = document.createElement('span'); track.className = 'ss-track';
        const fill = document.createElement('span'); fill.className = 'ss-fill'; fill.style.width = `${Math.max(2, (Math.log10(Math.max(1, v)) / top) * 100)}%`;
        track.appendChild(fill);
        const num = document.createElement('span'); num.className = 'pg-mono'; num.textContent = formatThousands(v);
        row.append(name, track, num); bars.appendChild(row);
      }
      // Growth measured on the model itself: what happened when n grew tenfold, extrapolated to 1,000,000 items.
      if (n >= 100) {
        const small = cost(algo, pattern, n / 10);
        const e = Math.log10(Math.max(1, mine) / Math.max(1, small));
        const million = Math.round(mine * Math.pow(1e6 / n, e));
        q('[data-verdict]').textContent = `Ten times fewer items (${formatThousands(n / 10)}) cost ${formatThousands(small)}, so growth is about n to the power ${Math.round(e * 100) / 100}. Extrapolated to 1,000,000 items: about ${formatThousands(million)} operations, ${duration(million)} at one per nanosecond (an assumption). Big O describes this growth, not the exact count.`;
      } else q('[data-verdict]').textContent = 'Pick 100 items or more to see how the cost grows when n grows tenfold. Bars are on a log scale.';

      const searches = Math.max(1, Math.min(1000000, Math.round(Number(q<HTMLInputElement>('[data-q]').value) || 1)));
      const linear = Math.ceil(n / 2), binary = Math.floor(Math.log2(n)) + 1;
      let breakEven = 1; while (mer + breakEven * binary >= breakEven * linear) breakEven++;
      q('[data-s1]').textContent = formatThousands(mer);
      q('[data-s2]').textContent = `${formatThousands(linear)} / ${formatThousands(binary)}`;
      q('[data-s3]').textContent = `${formatThousands(breakEven)} searches`;
      const withSort = mer + searches * binary, without = searches * linear;
      q('[data-s4]').textContent = `${formatThousands(searches)} searches: linear scans ${formatThousands(without)} comparisons; sorting once then binary search ${formatThousands(withSort)}.`;
      colour('[data-sb3]', searches >= breakEven ? 'var(--good)' : 'var(--bad)');
    }
    root.addEventListener('change', draw);
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .playground .ss-big { font-size: 1.15rem; font-weight: 600; }
  .playground .ss-bars { display: grid; gap: 6px; }
  .playground .ss-bar { display: grid; grid-template-columns: 9.5rem 1fr; gap: 2px 8px; align-items: center; }
  .playground .ss-bar .pg-mono { grid-column: 2; }
  .playground .ss-track { display: block; height: 12px; border-radius: 6px; background: var(--surface-2); overflow: hidden; }
  .playground .ss-fill { display: block; height: 100%; background: var(--accent); border-radius: 6px; }
  @media (max-width: 520px) { .playground .ss-bar { grid-template-columns: 1fr; } .playground .ss-bar .pg-mono { grid-column: 1; } }
</style>
