---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Order the events" hint="Six events on three machines. A and B exchange messages, and B and C exchange messages. Set how wrong the clocks of B and C are, and sort the events by physical time or by Lamport time.">
  <ol class="how">
    <li>Sort by <b>physical clock</b> with B's clock <b>30 ms behind</b> (the default): B's <b>receive</b> appears <b>before</b> A's <b>send</b>, an effect ordered before its cause. The count of violations shows it.</li>
    <li>Switch to <b>Lamport time</b>: zero violations, whatever the clocks say.</li>
    <li>Use <b>Compare two events</b> with vector clocks. C's local event and A's write are <b>concurrent</b>, although Lamport time lists them in a tidy order anyway (both are 1, and the tie is broken by machine name).</li>
  </ol>
  <div class="pg lc" data-lc>
    <div class="pg-row">
      <label>Clock of B is off by <input type="range" min="-100" max="100" step="10" value="-30" data-skewb /> <b data-skewbval></b></label>
      <label>Clock of C is off by <input type="range" min="-100" max="100" step="10" value="0" data-skewc /> <b data-skewcval></b></label>
      <label>Order events by <select class="pg-in" data-order><option value="phys" selected>Physical clock time</option><option value="lamport">Lamport time</option></select></label>
    </div>
    <div class="tablewrap" tabindex="0" role="region" aria-label="Events in the chosen order">
      <table class="lc-table">
        <caption class="sr">Events in the chosen order</caption>
        <thead><tr><th scope="col">Event</th><th scope="col">Machine</th><th scope="col">Physical time</th><th scope="col">Lamport time</th><th scope="col">Vector clock</th></tr></thead>
        <tbody data-rows></tbody>
      </table>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <div class="pg-row">
      <label>Compare <select class="pg-in" data-x></select></label>
      <label>with <select class="pg-in" data-y></select></label>
    </div>
    <p class="pg-mono" data-rel></p>
  </div>
</PlaygroundShell>
<script>
  const procs = ['A', 'B', 'C'];
  type Ev = { id: string; name: string; p: string; real: number; kind: 'local' | 'send' | 'recv'; from?: string };
  const events: Ev[] = [
    { id: 'e1', name: 'A writes x', p: 'A', real: 10, kind: 'local' }, { id: 'e2', name: 'A sends m1 to B', p: 'A', real: 20, kind: 'send' },
    { id: 'e3', name: 'B receives m1', p: 'B', real: 40, kind: 'recv', from: 'e2' }, { id: 'e4', name: 'B sends m2 to C', p: 'B', real: 50, kind: 'send' },
    { id: 'e5', name: 'C local event', p: 'C', real: 45, kind: 'local' }, { id: 'e6', name: 'C receives m2', p: 'C', real: 70, kind: 'recv', from: 'e4' },
  ];
  // Compute Lamport and vector clocks in real-time order
  const lam: Record<string, number> = {}; const vec: Record<string, number[]> = {}; const cl = { A: 0, B: 0, C: 0 } as Record<string, number>; const cv: Record<string, number[]> = { A: [0, 0, 0], B: [0, 0, 0], C: [0, 0, 0] };
  [...events].sort((a, b) => a.real - b.real).forEach((e) => {
    if (e.kind === 'recv') { cl[e.p] = Math.max(cl[e.p], lam[e.from!]) + 1; cv[e.p] = cv[e.p].map((v, i) => Math.max(v, vec[e.from!][i])); } else cl[e.p] += 1;
    cv[e.p][procs.indexOf(e.p)] += 1; lam[e.id] = cl[e.p]; vec[e.id] = [...cv[e.p]];
  });
  const before = (a: string, b: string) => { const x = vec[a], y = vec[b]; return a !== b && x.every((v, i) => v <= y[i]); };
  const rel = (a: string, b: string) => (a === b ? 'the same event' : before(a, b) ? 'happened before' : before(b, a) ? 'happened after' : 'concurrent');
  document.querySelectorAll<HTMLElement>('[data-lc]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const opts = events.map((e) => `<option value="${e.id}">${e.name}</option>`).join('');
    q('[data-x]').innerHTML = opts; q('[data-y]').innerHTML = opts; q<HTMLSelectElement>('[data-x]').value = 'e1'; q<HTMLSelectElement>('[data-y]').value = 'e5';
    const trs = events.map(() => { const tr = document.createElement('tr'); tr.innerHTML = '<th scope="row"></th><td></td><td></td><td></td><td></td>'; q('[data-rows]').appendChild(tr); return tr; });
    function draw() {
      const sb = Number(q<HTMLInputElement>('[data-skewb]').value); const sc = Number(q<HTMLInputElement>('[data-skewc]').value);
      q('[data-skewbval]').textContent = `${sb > 0 ? '+' : ''}${sb} ms`; q('[data-skewcval]').textContent = `${sc > 0 ? '+' : ''}${sc} ms`;
      const phys = (e: Ev) => e.real + (e.p === 'B' ? sb : e.p === 'C' ? sc : 0);
      const byLamport = q<HTMLSelectElement>('[data-order]').value === 'lamport';
      const sorted = [...events].sort((a, b) => (byLamport ? lam[a.id] - lam[b.id] || a.p.localeCompare(b.p) : phys(a) - phys(b)));
      sorted.forEach((e, i) => { const tr = trs[i]; tr.querySelector('th')!.textContent = e.name; const td = tr.querySelectorAll('td'); td[0].textContent = e.p; td[1].textContent = `${phys(e)} ms`; td[2].textContent = String(lam[e.id]); td[3].textContent = `[${vec[e.id]}]`; });
      let bad = 0; sorted.forEach((x, i) => sorted.slice(0, i).forEach((y) => { if (before(x.id, y.id)) bad++; }));
      const out = q('[data-verdict]'); out.classList.toggle('bad', bad > 0);
      out.textContent = bad ? `${bad} cause-and-effect pair${bad > 1 ? 's are' : ' is'} in the wrong order: an effect is listed before its cause.` : 'Every effect is listed after its cause.';
      q('[data-rel]').textContent = `${events.find((e) => e.id === q<HTMLSelectElement>('[data-x]').value)!.name} ${rel(q<HTMLSelectElement>('[data-x]').value, q<HTMLSelectElement>('[data-y]').value)} ${events.find((e) => e.id === q<HTMLSelectElement>('[data-y]').value)!.name}`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw); draw();
  });
</script>
<style is:global>
  .playground .lc-table { width: 100%; border-collapse: collapse; font-size: .9rem; min-width: 520px; }
  .playground .lc-table th, .playground .lc-table td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border); }
  .playground .lc-table tbody tr:last-child > * { border-bottom: 0; }
  .playground .lc-table thead th { background: var(--surface-2); }
</style>
