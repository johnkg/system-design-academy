---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Two components share settings. Switch between using the pattern and not.">
  <ol class="how">
    <li>Pick a mode: <b>Singleton</b> or <b>No pattern</b>.</li>
    <li>In <b>Header</b>, choose a theme and press <b>Save</b>.</li>
    <li>In <b>Footer</b>, press <b>Read theme</b>. Does it see what Header saved?</li>
    <li>Try <b>new AppConfig()</b> to see whether duplicates are allowed.</li>
  </ol>
  <div data-singleton-demo class="s-demo">
    <div role="group" aria-label="Mode" class="s-modes">
      <button class="btn" type="button" data-mode="singleton" aria-pressed="true">Singleton</button>
      <button class="btn" type="button" data-mode="plain" aria-pressed="false">No pattern</button>
    </div>
    <div class="s-grid">
      <section class="s-box"><h3>Header</h3>
        <span class="s-inst" data-inst="header">no AppConfig yet</span>
        <label class="s-row">Theme
          <select data-theme><option>light</option><option>dark</option><option>ocean</option></select>
        </label>
        <button class="btn" type="button" data-act="save">Save</button>
      </section>
      <section class="s-box"><h3>Footer</h3>
        <span class="s-inst" data-inst="footer">no AppConfig yet</span>
        <button class="btn" type="button" data-act="read">Read theme</button>
        <output class="s-out" data-out aria-live="polite">press Read theme</output>
      </section>
    </div>
    <div class="s-row">
      <button class="btn" type="button" data-act="new"><code>new AppConfig()</code></button>
      <span class="s-msg" data-msg aria-live="polite"></span>
    </div>
    <p class="s-count">Instances in memory: <b data-count>0</b></p>
  </div>
</PlaygroundShell>
<script>
  // Two implementations of the same class so the difference is visible.
  class AppConfig {
    static created = 0;
    static #instance: AppConfig | null = null;
    static #creating = false;
    static guarded = true; // true = Singleton mode, constructor refuses outsiders
    readonly id: number;
    private settings = new Map<string, string>();
    constructor() {
      if (AppConfig.guarded && !AppConfig.#creating) throw new Error('Use AppConfig.getInstance()');
      this.id = ++AppConfig.created;
    }
    static getInstance() {
      if (!AppConfig.#instance) { AppConfig.#creating = true; AppConfig.#instance = new AppConfig(); AppConfig.#creating = false; }
      return AppConfig.#instance;
    }
    static reset() { AppConfig.#instance = null; AppConfig.created = 0; }
    set(k: string, v: string) { this.settings.set(k, v); }
    get(k: string) { return this.settings.get(k); }
  }

  document.querySelectorAll<HTMLElement>('[data-singleton-demo]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let singleton = true;
    // Without the pattern each component keeps its own private copy.
    const own: Record<string, AppConfig | undefined> = {};
    const cfg = (who: 'header' | 'footer') => (singleton ? AppConfig.getInstance() : (own[who] ??= new AppConfig()));
    const show = () => {
      for (const who of ['header', 'footer'] as const) {
        const c = singleton ? (AppConfig.created ? AppConfig.getInstance() : undefined) : own[who];
        q(`[data-inst=${who}]`).textContent = c ? `uses AppConfig #${c.id}` : 'no AppConfig yet';
      }
      q('[data-count]').textContent = String(AppConfig.created);
    };
    const reset = () => { AppConfig.reset(); AppConfig.guarded = singleton; delete own.header; delete own.footer; q('[data-out]').textContent = 'press Read theme'; q('[data-msg]').textContent = ''; show(); };

    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
      singleton = b.dataset.mode === 'singleton';
      root.querySelectorAll('[data-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      reset();
    }));
    q('[data-act=save]').addEventListener('click', () => { cfg('header').set('theme', q<HTMLSelectElement>('[data-theme]').value); show(); });
    q('[data-act=read]').addEventListener('click', () => {
      const v = cfg('footer').get('theme');
      q('[data-out]').textContent = v ? `theme = ${v}` : 'theme = undefined (this is a different object)';
      show();
    });
    q('[data-act=new]').addEventListener('click', () => {
      try { const c = new AppConfig(); q('[data-msg]').textContent = `Created AppConfig #${c.id}. Now there are ${AppConfig.created}.`; }
      catch (e) { q('[data-msg]').textContent = `Error: ${(e as Error).message}`; }
      show();
    });
    reset();
  });
</script>
<style is:global>
  .playground .s-demo { display: grid; gap: 12px; }
  .playground .s-modes { display: flex; gap: 6px; }
  .playground .s-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .playground .s-box { border: 2px solid var(--role-2); border-radius: 10px; padding: 10px 12px; display: grid; gap: 8px; align-content: start; background: color-mix(in srgb, var(--role-2) 7%, var(--surface)); }
  .playground .s-box h3 { margin: 0; }
  .playground .s-inst { font: .8rem ui-monospace, monospace; color: var(--muted); }
  .playground .s-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .playground .s-row select { font: inherit; padding: 4px 8px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--text); }
  .playground .s-out { font: .85rem ui-monospace, monospace; }
  .playground .s-msg { font: .85rem ui-monospace, monospace; color: var(--muted); }
  .playground .s-count { margin: 0; color: var(--muted); font-size: .9rem; }
</style>
