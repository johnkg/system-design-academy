---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Pick a problem and compare trying everything with the pointer technique. A step is one pair checked, or one element added to or removed from a window. Nothing is timed: the data comes from fixed formulas, so the numbers never change. Time estimates assume one step per nanosecond, a rough guide.">
  <ol class="how">
    <li>Set <b>Problem</b> to <b>A pair with a target sum (sorted list)</b>, <b>Items n</b> to <b>1,000</b> and <b>Pair target</b> to <b>No pair exists</b>: trying every pair costs <b>499,500</b> checks, two pointers cost <b>999</b>. Set <b>Pair target</b> to <b>A pair exists</b> and trying every pair stops after <b>1,997</b> checks, because that pair sits early in the order: a test with such a target would not show the problem.</li>
    <li>Set <b>Problem</b> to <b>Longest stretch with sum at most K</b>, <b>Numbers</b> to <b>All positive</b>, <b>Items n</b> to <b>10,000</b> and <b>Limit K</b> to <b>500</b>: trying every start costs <b>1,001,650</b> steps and the window <b>19,900</b>, with the same answer. At <b>Limit K</b> <b>50</b> the stretches are short, so trying every start costs only <b>106,615</b>: the gain is about the window length.</li>
    <li>Set <b>Numbers</b> to <b>Some negative</b>, <b>Items n</b> to <b>1,000</b> and <b>Limit K</b> to <b>500</b>: the window is fast (<b>1,499</b> steps) but says <b>502</b> where the true answer is <b>506</b>. Trying every start needs <b>500,500</b> steps here, because with negative numbers it can no longer stop early.</li>
  </ol>
  <div class="pg tp" data-tp>
    <div class="pg-row">
      <label>Problem <select class="pg-in" data-problem><option value="pair" selected>A pair with a target sum (sorted list)</option><option value="window">Longest stretch with sum at most K</option></select></label>
      <label>Items n <select class="pg-in" data-n><option value="10">10</option><option value="100">100</option><option value="1000" selected>1,000</option><option value="10000">10,000</option></select></label>
    </div>
    <div class="pg-row">
      <label>Pair target <select class="pg-in" data-target><option value="none" selected>No pair exists</option><option value="exists">A pair exists</option></select></label>
      <label>Numbers <select class="pg-in" data-mode><option value="positive" selected>All positive</option><option value="mixed">Some negative</option></select></label>
      <label>Limit K <select class="pg-in" data-k><option value="50">50</option><option value="500" selected>500</option></select></label>
    </div>
    <p class="pg-note" data-which></p>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3 data-h1>Try everything</h3><span class="pg-mono tp-big" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3 data-h2>Two pointers</h3><span class="pg-mono tp-big" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Ratio</h3><span class="pg-mono tp-big" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Is the fast answer right?</h3><span class="pg-mono tp-big" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Steps, log scale</h3>
      <div class="tp-bars" data-bars></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';

  // The same model as the code samples, ported to TypeScript.
  const sortedList = (n: number) => Array.from({ length: n }, (_, i) => 3 * i + ((i * 7 + 1) % 3));
  function pairBrute(a: number[], target: number): [number, boolean] {
    let steps = 0;
    for (let i = 0; i < a.length; i++) for (let j = i + 1; j < a.length; j++) { steps++; if (a[i] + a[j] === target) return [steps, true]; }
    return [steps, false];
  }
  function pairTwoPointers(a: number[], target: number): [number, boolean] {
    let lo = 0, hi = a.length - 1, steps = 0;
    while (lo < hi) { steps++; const s = a[lo] + a[hi]; if (s === target) return [steps, true]; if (s < target) lo++; else hi--; }
    return [steps, false];
  }
  const values = (n: number, mode: string) => Array.from({ length: n }, (_, i) => ((i * 7 + 3) % 9) + (mode === 'positive' ? 1 : -3));
  function windowBrute(v: number[], k: number, mode: string): [number, number] {
    let best = 0, steps = 0;
    for (let l = 0; l < v.length; l++) {
      let s = 0;
      for (let r = l; r < v.length; r++) { s += v[r]; steps++; if (s <= k) best = Math.max(best, r - l + 1); else if (mode === 'positive') break; }
    }
    return [steps, best];
  }
  function windowSliding(v: number[], k: number): [number, number] {
    let best = 0, steps = 0, l = 0, s = 0;
    for (let r = 0; r < v.length; r++) {
      s += v[r]; steps++;
      while (s > k && l <= r) { s -= v[l]; l++; steps++; }
      best = Math.max(best, r - l + 1);
    }
    return [steps, best];
  }

  // Returns { slow steps, fast steps, slow answer, fast answer } for one setting.
  function run(problem: string, n: number, target: string, mode: string, k: number) {
    if (problem === 'pair') {
      const a = sortedList(n);
      const t = target === 'none' ? 1 : a[Math.floor(n / 4)] + a[Math.floor((3 * n) / 4)];
      const [bs, bf] = pairBrute(a, t), [ts, tf] = pairTwoPointers(a, t);
      return { slow: bs, fast: ts, slowAns: bf ? 1 : 0, fastAns: tf ? 1 : 0 };
    }
    const v = values(n, mode);
    const [bs, bb] = windowBrute(v, k, mode), [ws, wb] = windowSliding(v, k);
    return { slow: bs, fast: ws, slowAns: bb, fastAns: wb };
  }
  function duration(steps: number): string {
    const s = steps / 1e9;
    if (s < 1) return 'under a second';
    if (s < 120) return `about ${Math.round(s)} seconds`;
    if (s < 7200) return `about ${Math.round(s / 60)} minutes`;
    if (s < 172800) return `about ${Math.round(s / 3600)} hours`;
    return `about ${formatThousands(Math.round(s / 86400))} days`;
  }

  document.querySelectorAll<HTMLElement>('[data-tp]').forEach((root) => {
    const q = query(root);
    const colour = (id: string, c: string) => q<HTMLElement>(id).style.setProperty('--c', c);
    const sel = (s: string) => q<HTMLSelectElement>(s).value;
    function draw() {
      const problem = sel('[data-problem]'), n = Number(sel('[data-n]')), target = sel('[data-target]'), mode = sel('[data-mode]'), k = Number(sel('[data-k]'));
      const isPair = problem === 'pair';
      q('[data-which]').textContent = isPair ? 'Uses Items n and Pair target. A sorted list of distinct numbers; is there a pair that adds up to the target?' : 'Uses Items n, Numbers and Limit K. Numbers are 1 to 9 (all positive) or -3 to 5 (some negative). What is the longest run of neighbours whose sum is at most K?';
      const r = run(problem, n, target, mode, k);
      q('[data-h1]').textContent = isPair ? 'Try every pair' : 'Try every start';
      q('[data-h2]').textContent = isPair ? 'Two pointers' : 'Sliding window';
      q('[data-o1]').textContent = `${formatThousands(r.slow)} steps`;
      q('[data-o2]').textContent = `${formatThousands(r.fast)} steps`;
      const quadratic = isPair ? (n * (n - 1)) / 2 : (n * (n + 1)) / 2;
      const worst = r.slow >= 0.8 * quadratic && n >= 100;
      q('[data-n1]').textContent = worst ? `worst case: about n squared / 2 = ${formatThousands(quadratic)}` : isPair ? 'stopped early: this pair sits near the start of the pair order, so the quadratic cost is hidden' : mode === 'positive' ? 'each start stops as soon as its sum passes K, so the cost is about n times the window length' : 'with negative numbers a sum can come back down, so every start must look at every end';
      colour('[data-b1]', worst ? 'var(--bad)' : 'var(--border)');
      q('[data-n2]').textContent = isPair ? 'one check per pointer move: at most n - 1' : 'each element enters once and leaves at most once: at most 2n';
      colour('[data-b2]', 'var(--good)');
      const ratio = r.slow / r.fast;
      q('[data-o3]').textContent = ratio >= 1 ? `${ratio >= 10 ? formatThousands(Math.round(ratio)) : Math.round(ratio * 10) / 10}x fewer` : 'no gain';
      q('[data-n3]').textContent = 'steps for trying everything, divided by steps for the pointer technique';
      colour('[data-b3]', 'var(--border)');
      const same = r.slowAns === r.fastAns;
      q('[data-o4]').textContent = same ? 'Yes' : `No: ${formatThousands(r.fastAns)} against ${formatThousands(r.slowAns)}`;
      q('[data-n4]').textContent = isPair ? (r.slowAns ? 'both found a pair' : 'both report that no pair exists') : same ? `both find a longest stretch of ${formatThousands(r.slowAns)}` : `the window says ${formatThousands(r.fastAns)}, the true longest stretch is ${formatThousands(r.slowAns)}: with negative numbers, shrinking from the left can throw away a start that would have worked, and nothing tells you`;
      colour('[data-b4]', same ? 'var(--good)' : 'var(--bad)');

      const bars = q('[data-bars]'); bars.textContent = '';
      const rows: [string, number][] = [[isPair ? 'Every pair' : 'Every start', r.slow], [isPair ? 'Two pointers' : 'Sliding window', r.fast], ['n (reference)', n], ['n squared / 2 (reference)', Math.round((n * n) / 2)]];
      const top = Math.log10(Math.max(...rows.map((x) => x[1]), 10));
      for (const [label, v] of rows) {
        const row = document.createElement('div'); row.className = 'tp-bar';
        const name = document.createElement('span'); name.textContent = label;
        const track = document.createElement('span'); track.className = 'tp-track';
        const fill = document.createElement('span'); fill.className = 'tp-fill'; fill.style.width = `${Math.max(2, (Math.log10(Math.max(1, v)) / top) * 100)}%`;
        track.appendChild(fill);
        const num = document.createElement('span'); num.className = 'pg-mono'; num.textContent = formatThousands(v);
        row.append(name, track, num); bars.appendChild(row);
      }
      if (n >= 100) {
        const small = run(problem, n / 10, target, mode, k);
        const grow = (a: number, b: number) => Math.log10(Math.max(1, a) / Math.max(1, b));
        const eSlow = grow(r.slow, small.slow), eFast = grow(r.fast, small.fast);
        const million = (steps: number, e: number) => Math.round(steps * Math.pow(1e6 / n, e));
        const ms = million(r.slow, eSlow), mf = million(r.fast, eFast);
        q('[data-verdict]').textContent = `Ten times fewer items cost ${formatThousands(small.slow)} and ${formatThousands(small.fast)} steps, so growth is about n to the power ${Math.round(eSlow * 100) / 100} and ${Math.round(eFast * 100) / 100}. Extrapolated to 1,000,000 items: about ${formatThousands(ms)} steps (${duration(ms)} at one step per nanosecond, an assumption) against about ${formatThousands(mf)} (${duration(mf)}). Big O describes this growth, not the exact count.`;
      } else q('[data-verdict]').textContent = 'Pick 100 items or more to see how the cost grows when n grows tenfold. Bars are on a log scale.';
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .tp-big { font-size: 1.15rem; font-weight: 600; }
  .playground .tp-bars { display: grid; gap: 6px; }
  .playground .tp-bar { display: grid; grid-template-columns: 9.5rem 1fr; gap: 2px 8px; align-items: center; }
  .playground .tp-bar .pg-mono { grid-column: 2; }
  .playground .tp-track { display: block; height: 12px; border-radius: 6px; background: var(--surface-2); overflow: hidden; }
  .playground .tp-fill { display: block; height: 100%; background: var(--accent); border-radius: 6px; }
  @media (max-width: 520px) { .playground .tp-bar { grid-template-columns: 1fr; } .playground .tp-bar .pg-mono { grid-column: 1; } }
</style>
