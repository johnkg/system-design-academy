---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="The origin is in the US. Request the same image from three regions, with and without a CDN.">
  <ol class="how">
    <li>With the CDN <b>off</b>, request the image from each region. Distance decides the wait.</li>
    <li>Turn the CDN <b>on</b>. The first request in a region is a miss; repeat it and it becomes a hit.</li>
    <li>Press <b>Send 10 from every region</b> and compare how many requests reached the origin.</li>
  </ol>
  <div class="pg" data-cdn>
    <div class="pg-row">
      <span role="group" aria-label="CDN" class="pg-row">
        <button class="btn" type="button" data-mode="off" aria-pressed="true">CDN off</button>
        <button class="btn" type="button" data-mode="on" aria-pressed="false">CDN on</button>
      </span>
      <button class="btn" type="button" data-purge>Purge edge caches</button>
      <button class="btn" type="button" data-reset>Reset counters</button>
    </div>
    <div class="pg-grid" data-regions></div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-bulk>Send 10 from every region</button>
    </div>
    <output class="pg-out" data-out>Request the image from a region.</output>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const regions = [
    { name: 'US East', origin: 30 },   // round trip to the origin, ms
    { name: 'Europe', origin: 100 },
    { name: 'Asia-Pacific', origin: 220 },
  ];
  const EDGE = 15; const PROCESS = 20; // user to nearby edge, origin processing time
  const BULK = 10; // requests per region sent by the bulk button
  document.querySelectorAll<HTMLElement>('[data-cdn]').forEach((root) => {
    const q = query(root);
    let cdn = false; let requests = 0; let toOrigin = 0; let sumLatency = 0;
    const cached = regions.map(() => false);
    const last: { ms: number; kind: string }[] = regions.map(() => ({ ms: 0, kind: '' }));
    const cards: { box: HTMLElement; edge: HTMLElement; bar: HTMLElement; res: HTMLElement }[] = [];

    function request(i: number) {
      requests++; let ms: number; let kind: string;
      if (!cdn) { ms = regions[i].origin + PROCESS; kind = 'direct to origin'; toOrigin++; }
      else if (cached[i]) { ms = EDGE; kind = 'edge HIT'; }
      else { ms = EDGE + regions[i].origin + PROCESS; kind = 'edge MISS, fetched from origin'; cached[i] = true; toOrigin++; }
      sumLatency += ms; last[i] = { ms, kind };
    }
    function draw(msg?: string) {
      regions.forEach((r, i) => {
        const c = cards[i];
        c.edge.textContent = cdn ? (cached[i] ? 'edge cache: has image' : 'edge cache: empty') : 'no edge';
        c.bar.style.width = last[i].ms ? `${Math.min(100, (last[i].ms / 260) * 100)}%` : '0%';
        c.bar.style.background = last[i].kind.includes('HIT') ? 'var(--good)' : 'var(--role-4)';
        c.res.textContent = last[i].ms ? `${last[i].ms} ms (${last[i].kind})` : 'no request yet';
        c.box.classList.toggle('off', cdn && !cached[i] && !last[i].ms);
      });
      q('[data-out]').textContent = `${msg ? msg + '\n' : ''}requests ${requests} · reached the origin ${toOrigin}${requests ? ` · average ${Math.round(sumLatency / requests)} ms` : ''}`;
    }
    function build() {
      const g = q('[data-regions]');
      regions.forEach((r, i) => {
        const box = document.createElement('div'); box.className = 'pg-box'; box.style.setProperty('--c', 'var(--role-2)');
        box.innerHTML = `<h3></h3><span class="pg-note">origin is ${r.origin} ms away</span><span class="pg-mono" data-edge></span><div class="cd-track"><div class="cd-bar"></div></div><span class="pg-mono" data-res></span>`;
        box.querySelector('h3')!.textContent = r.name;
        const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = 'Request image';
        b.addEventListener('click', () => { request(i); draw(`${r.name}: ${last[i].ms} ms, ${last[i].kind}.`); });
        box.appendChild(b); g.appendChild(box);
        cards.push({ box, edge: box.querySelector('[data-edge]')!, bar: box.querySelector('.cd-bar')!, res: box.querySelector('[data-res]')! });
      });
    }
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => { cdn = b.dataset.mode === 'on'; root.querySelectorAll('[data-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b))); draw(cdn ? 'CDN on: edge caches start empty.' : 'CDN off: everything goes to the origin.'); }));
    q('[data-purge]').addEventListener('click', () => { cached.fill(false); draw('Purged: the next request in each region will miss.'); });
    q('[data-reset]').addEventListener('click', () => { requests = 0; toOrigin = 0; sumLatency = 0; last.forEach((l) => { l.ms = 0; l.kind = ''; }); draw('Counters reset.'); });
    q('[data-bulk]').addEventListener('click', () => { for (let n = 0; n < BULK; n++) regions.forEach((_, i) => request(i)); draw(`Sent ${BULK} requests from every region (${BULK * regions.length} total).`); });
    build(); draw();
  });
</script>
<style is:global>
  .playground .cd-track { height: 12px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .playground .cd-bar { height: 100%; width: 0; border-radius: 99px; transition: width .3s; }
</style>
