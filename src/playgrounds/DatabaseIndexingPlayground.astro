---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A table of 20,000 users. Choose which columns are indexed, run queries, and see how many rows the database has to touch.">
  <ol class="how">
    <li>Run the <b>email lookup</b> with no indexes: a full scan reads all 20,000 rows.</li>
    <li>Tick <b>Index on email</b> and run it again: a handful of comparisons.</li>
    <li>Try the <b>“ends with son”</b> query. No index helps it. Then press <b>Insert 1,000 rows</b> with several indexes on and see what writes cost.</li>
  </ol>
  <div class="pg" data-index>
    <fieldset class="ix-set"><legend>Indexes on the table</legend>
      <label><input type="checkbox" data-ix="email" /> email</label>
      <label><input type="checkbox" data-ix="age" /> age</label>
      <label><input type="checkbox" data-ix="name" /> name</label>
    </fieldset>
    <div class="pg-row" role="group" aria-label="Query" data-queries></div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-run>Run query</button>
      <button class="btn" type="button" data-insert>Insert 1,000 rows</button>
    </div>
    <pre class="pg-code" data-sql></pre>
    <div class="ix-meter"><div class="ix-fill" data-fill></div></div>
    <output class="pg-out" data-out>Choose a query and run it.</output>
  </div>
</PlaygroundShell>
<script>
  interface Row { id: number; email: string; age: number; name: string }
  type Col = 'email' | 'age' | 'name';
  const first = ['Maria', 'Mark', 'James', 'Linda', 'Marta', 'Omar', 'Aisha', 'Wei', 'Sofia', 'Noah', 'Mason', 'Priya', 'Lucas', 'Elena', 'Marco', 'Ivan'];
  const last = ['Johnson', 'Smith', 'Wilson', 'Garcia', 'Anderson', 'Brown', 'Khan', 'Lee', 'Davis', 'Nguyen', 'Jackson', 'Moore', 'Taylor', 'Costa'];
  const N = 20000;
  const SEED = 12345; const FIRST_PICK = 12345; // row shown in the email query before the first run
  const AGE = { min: 18, span: 63 }; // user ages 18..80
  const AGE_RANGE = { lo: 30, hi: 32 }; // the BETWEEN query
  const MS_PER_ROW = 0.005; // cost model for examining one row
  const INSERT_ROWS = 1000; const INDEXABLE_COLS = 3; // insert demo batch, columns that can carry an index
  // LCG PRNG
  let seed = SEED; const rnd = () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296;
  const rows: Row[] = Array.from({ length: N }, (_, id) => ({ id, email: `u${id}@example.com`, age: AGE.min + Math.floor(rnd() * AGE.span), name: `${first[Math.floor(rnd() * first.length)]} ${last[Math.floor(rnd() * last.length)]}` }));
  const sortedBy = (c: Col) => rows.map((r) => ({ key: r[c] as string | number, pos: r.id })).sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));
  const idx: Record<Col, { key: string | number; pos: number }[]> = { email: sortedBy('email'), age: sortedBy('age'), name: sortedBy('name') };
  function lowerBound(c: Col, key: string | number) { const e = idx[c]; let lo = 0, hi = e.length, cmp = 0; while (lo < hi) { const mid = (lo + hi) >> 1; cmp++; if (e[mid].key < key) lo = mid + 1; else hi = mid; } return { at: lo, cmp }; }

  document.querySelectorAll<HTMLElement>('[data-index]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const queries = [
      { id: 'email', label: 'email = one user', col: 'email' as Col, sql: () => `SELECT * FROM users WHERE email = '${pick}';` },
      { id: 'age', label: 'age between 30 and 32', col: 'age' as Col, sql: () => 'SELECT * FROM users WHERE age BETWEEN 30 AND 32;' },
      { id: 'prefix', label: "name starts with 'Ma'", col: 'name' as Col, sql: () => "SELECT * FROM users WHERE name LIKE 'Ma%';" },
      { id: 'suffix', label: "name ends with 'son'", col: 'name' as Col, sql: () => "SELECT * FROM users WHERE name LIKE '%son';" },
    ];
    let cur = queries[0]; let pick = rows[FIRST_PICK].email;
    const on = (c: Col) => q<HTMLInputElement>(`[data-ix=${c}]`).checked;
    const sql = () => { q('[data-sql]').textContent = cur.sql(); };

    function run() {
      let examined = N, matches = 0, plan = 'Full table scan (no usable index)';
      if (cur.id === 'email') { pick = rows[Math.floor(Math.random() * N)].email; matches = 1; if (on('email')) { const r = lowerBound('email', pick); examined = r.cmp + 1; plan = 'Index lookup on email'; } }
      else if (cur.id === 'age') { matches = rows.filter((r) => r.age >= AGE_RANGE.lo && r.age <= AGE_RANGE.hi).length; if (on('age')) { examined = lowerBound('age', AGE_RANGE.lo).cmp + matches; plan = 'Index range scan on age'; } }
      else if (cur.id === 'prefix') { matches = rows.filter((r) => r.name.startsWith('Ma')).length; if (on('name')) { examined = lowerBound('name', 'Ma').cmp + matches; plan = 'Index range scan on name (prefix)'; } }
      else { matches = rows.filter((r) => r.name.endsWith('son')).length; plan = on('name') ? 'Full table scan: the name index cannot help with a suffix' : plan; }
      sql();
      const ms = examined * MS_PER_ROW;
      q('[data-fill]').style.width = `${Math.max(1, (examined / N) * 100)}%`;
      q('[data-out]').textContent = `${plan}\nrows examined: ${examined.toLocaleString()} of ${N.toLocaleString()} · matches: ${matches.toLocaleString()} · about ${ms < 1 ? ms.toFixed(3) : ms.toFixed(0)} ms (model: ${MS_PER_ROW} ms per row)`;
    }
    q('[data-run]').addEventListener('click', run);
    q('[data-insert]').addEventListener('click', () => {
      const k = (['email', 'age', 'name'] as Col[]).filter(on).length; const writes = INSERT_ROWS * (1 + k);
      q('[data-out]').textContent = `Insert 1,000 rows with ${k} index${k === 1 ? '' : 'es'}: ${writes.toLocaleString()} write operations (1 table write + ${k} index update${k === 1 ? '' : 's'} per row).`;
      q('[data-fill]').style.width = `${(writes / (INSERT_ROWS * (1 + INDEXABLE_COLS))) * 100}%`;
    });
    queries.forEach((qq) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = qq.label; b.setAttribute('aria-pressed', String(qq === cur)); b.addEventListener('click', () => { cur = qq; q('[data-queries]').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); sql(); }); q('[data-queries]').appendChild(b); });
    sql();
  });
</script>
<style is:global>
  .playground .ix-set { display: flex; flex-wrap: wrap; gap: 6px 18px; border: 1px solid var(--border); border-radius: 8px; }
  .playground .ix-meter { height: 14px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .playground .ix-fill { height: 100%; width: 0; background: var(--accent); border-radius: 99px; transition: width .3s; }
</style>
