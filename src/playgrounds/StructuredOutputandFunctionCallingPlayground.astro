---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A model returns invalid output some of the time. Choose how often, how many retries you allow, and whether you ask and validate or constrain the decoder, then see how many requests end in valid output and how many end in a correct answer. The rates are ones you set, not measurements.">
  <ol class="how">
    <li>Start with the defaults: <b>Invalid output rate</b> <b>20</b>, <b>Retries allowed</b> <b>2</b>, <b>Chance a valid output is still wrong</b> <b>10</b> and <b>Method</b> <b>Ask and validate</b>. <b>99.2</b> percent of requests end in valid output, with <b>1.24</b> calls on average, and <b>89.3</b> percent have a correct answer.</li>
    <li>Set <b>Method</b> to <b>Constrained decoding</b>: <b>100.0</b> percent valid with <b>1</b> call, but only <b>90.0</b> percent correct. A valid shape does not make the content right.</li>
    <li>Set <b>Method</b> to <b>Ask and validate</b>, <b>Invalid output rate</b> to <b>60</b> and <b>Retries allowed</b> to <b>0</b>: only <b>40.0</b> percent are valid and <b>36.0</b> percent are correct.</li>
    <li>Set <b>Retries allowed</b> to <b>4</b>: <b>92.2</b> percent are valid, with <b>2.31</b> calls on average, and <b>83.0</b> percent are correct. Retries recover most failures, for a larger bill.</li>
  </ol>
  <div class="pg sof" data-sof>
    <div class="pg-row">
      <label>Invalid output rate <input class="pg-in" type="range" min="0" max="60" step="5" value="20" data-p /> <b data-pv></b> %</label>
      <label>Retries allowed <input class="pg-in" type="range" min="0" max="4" step="1" value="2" data-r /> <b data-rv></b></label>
      <label>Chance a valid output is still wrong <input class="pg-in" type="range" min="0" max="30" step="5" value="10" data-w /> <b data-wv></b> %</label>
      <label>Method <select class="pg-in" data-method><option value="0" selected>Ask and validate</option><option value="1">Constrained decoding</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Requests that end in valid output</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Model calls per request, on average</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Requests with a correct answer</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // Ask and validate: each try fails with probability p, so all n = retries + 1 tries fail with p^n. Calls = 1 + p + p^2 + ... up to the retries.
  type Tone = 'good' | 'bad' | 'mid';
  const trim = (n: number) => String(Number(n.toFixed(2)));
  document.querySelectorAll<HTMLElement>('[data-sof]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const p = Number(q<HTMLInputElement>('[data-p]').value) / 100, retries = Number(q<HTMLInputElement>('[data-r]').value);
      const wrong = Number(q<HTMLInputElement>('[data-w]').value) / 100, constrained = q<HTMLSelectElement>('[data-method]').value === '1';
      q('[data-pv]').textContent = String(Math.round(p * 100)); q('[data-rv]').textContent = String(retries); q('[data-wv]').textContent = String(Math.round(wrong * 100));
      const valid = constrained ? 1 : 1 - p ** (retries + 1);
      let calls = 1; if (!constrained) { calls = 0; for (let k = 0; k <= retries; k++) calls += p ** k; }
      setBox(1, `${(100 * valid).toFixed(1)} %`, constrained ? 'the decoder cannot write an invalid token' : `a request fails only if all ${retries + 1} tries fail`, valid > 0.99 ? 'good' : valid < 0.7 ? 'bad' : 'mid');
      setBox(2, trim(calls), constrained ? 'one call, because there is nothing to retry' : calls > 1.5 ? 'retries add delay and tokens' : 'close to one call', calls > 2 ? 'bad' : 'mid');
      setBox(3, `${(100 * valid * (1 - wrong)).toFixed(1)} %`, 'valid output whose content is also right', 'mid');
      q('[data-verdict]').textContent = constrained
        ? 'Constrained decoding guarantees the shape. Whether the content is right is a separate question for your own checks.'
        : 'Validation detects bad output after it is written, and retries recover most of it. Each retry costs time and tokens, so keep the limit small.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
