---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A run-length encoder (&quot;aaab&quot; becomes &quot;3a1b&quot;) with a bug: a run of 10 or more equal characters is encoded wrongly. Five hand-written examples all pass. Choose a generator, a property and a seed, and see whether random inputs find the bug and how far shrinking cuts the failing input.">
  <ol class="how">
    <li>Start with the defaults: <b>Generator</b> <b>letters a to z, uniform</b>, <b>Cases</b> <b>1,000</b>. The round-trip property finds <b>no failure in 1,000 cases</b>. Set <b>Cases</b> to <b>10,000</b> and still nothing: a run of 10 equal letters is almost never generated from the full alphabet.</li>
    <li>Set <b>Cases</b> back to <b>1,000</b> and <b>Generator</b> to <b>letters a and b, uniform</b>: the bug is found at case <b>845</b>, with a <b>15</b>-character input that shrinks to <b>10</b> characters in <b>5</b> steps. Set <b>Cases</b> to <b>100</b> and it is missed: the generator can find the bug, but only with enough cases.</li>
    <li>Set <b>Cases</b> to <b>1,000</b> and <b>Generator</b> to <b>biased toward repeats</b>: found at case <b>2</b>. A generator shaped to the data beats a larger number of blind cases. Untick <b>Shrink the failing input</b> to see the raw <b>19</b>-character input instead of the shrunk one.</li>
    <li>Set <b>Property</b> to <b>weak: encode(s) is not empty when s is not</b>: <b>no failure in 1,000 cases</b>, though the bug is still there. A property that cannot fail is a green light that means nothing.</li>
  </ol>
  <div class="pg pb" data-pb>
    <div class="pg-row">
      <label>Generator <select class="pg-in" data-gen>
        <option value="0" selected>letters a to z, uniform</option>
        <option value="1">letters a and b, uniform</option>
        <option value="2">biased toward repeats</option>
      </select></label>
      <label>Property <select class="pg-in" data-prop>
        <option value="0" selected>round trip: decode(encode(s)) equals s</option>
        <option value="1">weak: encode(s) is not empty when s is not</option>
      </select></label>
      <label>Seed <select class="pg-in" data-seed>
        <option value="101" selected>101</option><option value="202">202</option><option value="303">303</option>
      </select></label>
      <label>Cases <select class="pg-in" data-cases>
        <option value="100">100</option><option value="1000" selected>1,000</option><option value="10000">10,000</option>
      </select></label>
      <label><input type="checkbox" data-shrink checked /> Shrink the failing input</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Result</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>First failing input</h3><span class="pg-mono pb-wrap" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>After shrinking</h3><span class="pg-mono pb-wrap" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Hand-written examples</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  // The same model as the code samples.
  function encode(s: string): string {
    let out = '', i = 0;
    while (i < s.length) { let j = i; while (j < s.length && s[j] === s[i]) j++; out += ((j - i) % 10) + s[i]; i = j; }
    return out;
  }
  function decode(e: string): string {
    let out = '', i = 0;
    while (i < e.length) {
      let n = 0;
      while (e[i] >= '0' && e[i] <= '9') { n = n * 10 + (e.charCodeAt(i) - 48); i++; }
      for (let k = 0; k < n; k++) out += e[i];
      i++;
    }
    return out;
  }
  const EXAMPLES = ['', 'a', 'aaabcc', 'abab', 'zzzzzzzzz'];
  const PROPS: ((s: string) => boolean)[] = [(s) => decode(encode(s)) === s, (s) => s.length === 0 || encode(s).length > 0];
  const LETTERS = 'abcdefghijklmnopqrstuvwxyz';
  type Rand = (n: number) => number;
  const GENS: ((r: Rand) => string)[] = [
    (r) => { let s = ''; for (let n = r(21); n > 0; n--) s += LETTERS[r(26)]; return s; },
    (r) => { let s = ''; for (let n = r(21); n > 0; n--) s += 'ab'[r(2)]; return s; },
    (r) => { let s = ''; for (let n = r(21); n > 0; n--) s += s.length > 0 && r(10) < 8 ? s[s.length - 1] : 'abc'[r(3)]; return s; },
  ];
  function seeded(seed: number): Rand { let s = seed; return (n) => { s = (s * 48271) % 2147483647; return s % n; }; }
  function shrink(s: string, prop: (s: string) => boolean): [string, number] {
    let steps = 0, again = true;
    while (again) {
      again = false;
      for (let i = 0; i < s.length; i++) {
        const smaller = s.slice(0, i) + s.slice(i + 1);
        if (!prop(smaller)) { s = smaller; steps++; again = true; break; }
      }
    }
    return [s, steps];
  }

  document.querySelectorAll<HTMLElement>('[data-pb]').forEach((root) => {
    const q = query(root);
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    const val = (s: string) => Number(q<HTMLSelectElement>(s).value);
    function draw() {
      const prop = PROPS[val('[data-prop]')], gen = GENS[val('[data-gen]')], cases = val('[data-cases]');
      const rand = seeded(val('[data-seed]'));
      let found = 0, input = '';
      for (let c = 1; c <= cases && !found; c++) { const s = gen(rand); if (!prop(s)) { found = c; input = s; } }
      if (found) {
        set(1, `failed at case ${formatThousands(found)}`, 'the same seed finds the same case again, so the failure can be replayed');
        box(1, true);
        set(2, input, `${input.length} characters`);
        box(2, true);
        if (q<HTMLInputElement>('[data-shrink]').checked) {
          const [small, steps] = shrink(input, prop);
          set(3, small, `${small.length} characters, after ${steps} steps of deleting one character at a time`);
        } else set(3, 'not shrunk', 'tick Shrink the failing input to reduce it');
        box(3, true);
      } else {
        set(1, `no failure in ${formatThousands(cases)} cases`, 'the code still has the bug: nothing here could show it');
        box(1, false);
        set(2, 'none', 'no generated input failed');
        box(2, false);
        set(3, 'nothing to shrink', '');
        box(3, false);
      }
      const passing = EXAMPLES.filter((s) => PROPS[0](s)).length;
      set(4, `${passing} of ${EXAMPLES.length} pass`, 'the longest run in them is 9, so they never touch the bug');
      box(4, false);
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .pb-wrap { overflow-wrap: anywhere; }
</style>
