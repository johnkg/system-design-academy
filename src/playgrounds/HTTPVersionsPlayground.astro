---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Load a page" hint="A page of small files over each HTTP version. This is a simple model, not a measurement: it counts handshakes, request waves and loss stalls.">
  <ol class="how">
    <li>At <b>0% loss</b>, HTTP/2 beats HTTP/1.1 clearly because there is one handshake and no queueing, and HTTP/3 saves one more round trip.</li>
    <li>Raise <b>packet loss</b>: HTTP/2 loses its edge because one lost packet stalls every stream on its one TCP connection. HTTP/3 only stalls the affected stream.</li>
    <li>Raise the <b>round trip time</b> or the <b>number of files</b> and see which version wastes the most waiting.</li>
  </ol>
  <div class="pg hv" data-hv>
    <div class="pg-row">
      <label>Round trip time <input type="range" min="20" max="300" step="10" value="100" data-rtt /> <b data-rttval></b></label>
      <label>Packet loss <input type="range" min="0" max="5" step="0.5" value="1" data-loss /> <b data-lossval></b></label>
      <label>Files on the page <input type="range" min="10" max="100" step="5" value="60" data-files /> <b data-filesval></b></label>
    </div>
    <div class="hv-rows" data-rows></div>
    <p class="pg-note" data-note></p>
  </div>
</PlaygroundShell>
<script>
  const versions = [
    { id: 'h1', label: 'HTTP/1.1 (6 connections)', c: 'var(--role-3)' }, { id: 'h2', label: 'HTTP/2 (1 TCP connection)', c: 'var(--role-1)' }, { id: 'h3', label: 'HTTP/3 (QUIC)', c: 'var(--role-2)' },
  ];
  document.querySelectorAll<HTMLElement>('[data-hv]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const rows = versions.map((v) => { const r = document.createElement('div'); r.className = 'hv-row'; r.innerHTML = '<span class="hv-name"></span><div class="hv-track"><i></i></div><span class="pg-mono hv-ms"></span>'; r.querySelector('.hv-name')!.textContent = v.label; r.querySelector<HTMLElement>('i')!.style.background = v.c; q('[data-rows]').appendChild(r); return { bar: r.querySelector<HTMLElement>('i')!, ms: r.querySelector<HTMLElement>('.hv-ms')! }; });
    function draw() {
      const rtt = Number(q<HTMLInputElement>('[data-rtt]').value); const loss = Number(q<HTMLInputElement>('[data-loss]').value) / 100; const files = Number(q<HTMLInputElement>('[data-files]').value);
      q('[data-rttval]').textContent = `${rtt} ms`; q('[data-lossval]').textContent = `${(loss * 100).toFixed(1)}%`; q('[data-filesval]').textContent = String(files);
      const packets = files * 10; const transfer = packets * 1; // 1 ms of transmission per packet
      const t = [
        2 * rtt + Math.ceil(files / 6) * rtt + transfer + (packets / 6) * loss * rtt,
        2 * rtt + rtt + transfer + packets * loss * rtt,
        1 * rtt + rtt + transfer + (packets * loss * rtt) / 8,
      ];
      const max = Math.max(...t);
      t.forEach((v, i) => { rows[i].bar.style.width = `${(v / max) * 100}%`; rows[i].ms.textContent = `${Math.round(v)} ms`; });
      const best = t.indexOf(Math.min(...t));
      q('[data-note]').textContent = `Fastest here: ${versions[best].label}. Model: HTTP/1.1 needs ${Math.ceil(files / 6)} request waves per connection; HTTP/2 and HTTP/3 send all requests at once; a lost packet stalls one HTTP/1.1 connection, the whole HTTP/2 connection, or about one HTTP/3 stream.`;
    }
    root.addEventListener('input', draw); draw();
  });
</script>
<style is:global>
  .playground .hv-rows { display: grid; gap: 8px; }
  .playground .hv-row { display: grid; grid-template-columns: 190px 1fr 64px; gap: 8px; align-items: center; font-size: .88rem; }
  .playground .hv-track { height: 20px; background: var(--surface-2); border-radius: 5px; overflow: hidden; }
  .playground .hv-track i { display: block; height: 100%; border-radius: 5px; transition: width .15s; }
  .playground .hv-ms { text-align: right; }
  @media (max-width: 560px) { .playground .hv-row { grid-template-columns: 1fr; gap: 2px; } .playground .hv-ms { text-align: left; } }
</style>
