---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="One service has 10 workers. Payment and search requests both need a worker. Make payments slow and see who is affected.">
  <ol class="how">
    <li>With <b>Shared pool</b> and payments <b>Normal</b>, everything is served. Switch payments to <b>Slow</b>: payment calls hold workers for 6 seconds, the pool fills with P, and <b>search</b> requests start being rejected too.</li>
    <li>Switch to <b>Bulkheads</b>. Payments can use only their 5 workers, so they are rejected a lot, but search keeps its own 5 workers and stays at 0 rejections.</li>
    <li>With payments <b>Slow</b>, raise the request rate: the payments compartment rejects even more. Search stays at 0 rejections at every rate, because 8 requests per second at 0.4 s each need only about 3 of its 5 workers.</li>
  </ol>
  <div class="pg bh" data-bh>
    <div class="pg-row">
      <label>Pool layout <select class="pg-in" data-layout><option value="shared" selected>Shared pool (10)</option><option value="split">Bulkheads (5 payments + 5 search)</option></select></label>
      <label>Payment API <select class="pg-in" data-slow><option value="no" selected>Normal (0.4 s)</option><option value="yes">Slow (6 s)</option></select></label>
      <label>Requests per second, each kind <input type="range" min="1" max="8" value="4" data-rate /> <b data-rateval>4</b></label>
      <button class="btn" type="button" data-play>Pause</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="bh-slots" role="img" aria-label="Worker pool" data-slots></div>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-1)"><h3>Payments (P)</h3><span class="pg-mono" data-pay></span></div>
      <div class="pg-box" style="--c: var(--role-2)"><h3>Search (S)</h3><span class="pg-mono" data-search></span></div>
    </div>
    <p class="sr" aria-live="polite" data-status></p>
  </div>
</PlaygroundShell>
<script>
  type Kind = 'P' | 'S';
  interface Slot { kind: Kind; end: number }
  const SIZE = 10;
  const PAY_SLOTS = 5; // workers reserved for payments in the split layout
  const SLOW_PAY_MS = 6000; const FAST_MS = 400; // time a request holds a worker
  const TICK_MS = 100; // how often finished work is cleared
  const SEARCH_GAP_FACTOR = 1.07; // search arrives slightly slower so the two streams drift apart
  document.querySelectorAll<HTMLElement>('[data-bh]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    let slots: (Slot | null)[] = []; const done = { P: 0, S: 0 }; const rejected = { P: 0, S: 0 };
    let tickTimer: number | undefined; let sendP: number | undefined; let sendS: number | undefined; let onScreen = true;
    let running = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els: HTMLElement[] = [];
    for (let i = 0; i < SIZE; i++) { const d = document.createElement('div'); d.className = 'bh-slot'; q('[data-slots]').appendChild(d); els.push(d); }

    const range = (k: Kind): [number, number] => q<HTMLSelectElement>('[data-layout]').value === 'shared' ? [0, SIZE] : k === 'P' ? [0, PAY_SLOTS] : [PAY_SLOTS, SIZE];
    function arrive(k: Kind) {
      const [a, b] = range(k); const now = performance.now();
      for (let i = a; i < b; i++) if (!slots[i]) { slots[i] = { kind: k, end: now + (k === 'P' && q<HTMLSelectElement>('[data-slow]').value === 'yes' ? SLOW_PAY_MS : FAST_MS) }; draw(); return; }
      rejected[k]++; draw();
    }
    function tick() {
      const now = performance.now();
      slots.forEach((s, i) => { if (s && now >= s.end) { done[s.kind]++; slots[i] = null; } });
      draw();
    }
    function draw() {
      q('[data-rateval]').textContent = String(val('[data-rate]'));
      const split = q<HTMLSelectElement>('[data-layout]').value === 'split';
      slots.forEach((s, i) => { const e = els[i]; e.textContent = s ? s.kind : ''; e.classList.toggle('p', s?.kind === 'P'); e.classList.toggle('s', s?.kind === 'S'); e.classList.toggle('gap', split && i === PAY_SLOTS); });
      const busy = slots.filter(Boolean).length;
      q('[data-slots]').setAttribute('aria-label', `Worker pool: ${busy} of ${SIZE} workers busy, ${slots.filter((s) => s?.kind === 'P').length} on payments and ${slots.filter((s) => s?.kind === 'S').length} on search`);
      const line = (k: Kind) => { const tot = done[k] + rejected[k]; return `completed: ${done[k]} · rejected: ${rejected[k]}${tot ? ` (${Math.round((rejected[k] / tot) * 100)}%)` : ''}`; };
      q('[data-pay]').textContent = line('P'); q('[data-search]').textContent = line('S');
    }
    function reset() { slots = new Array(SIZE).fill(null); done.P = done.S = rejected.P = rejected.S = 0; draw(); }
    function clock() {
      window.clearInterval(tickTimer); window.clearInterval(sendP); window.clearInterval(sendS); tickTimer = sendP = sendS = undefined;
      if (!running || !onScreen || document.hidden) return;
      const gap = 1000 / val('[data-rate]');
      tickTimer = window.setInterval(tick, TICK_MS);
      sendP = window.setInterval(() => arrive('P'), gap);
      sendS = window.setInterval(() => arrive('S'), gap * SEARCH_GAP_FACTOR);
    }
    const playLabel = () => { q('[data-play]').textContent = running ? 'Pause' : 'Play'; };
    q('[data-play]').addEventListener('click', () => {
      running = !running; playLabel(); clock();
      q('[data-status]').textContent = running ? 'Running.' : `Paused. Payments ${q('[data-pay]').textContent}. Search ${q('[data-search]').textContent}.`;
    });
    q('[data-reset]').addEventListener('click', reset);
    q('[data-layout]').addEventListener('change', reset); q('[data-slow]').addEventListener('change', reset);
    q('[data-rate]').addEventListener('input', () => { clock(); draw(); });
    new IntersectionObserver(([en]) => { onScreen = en.isIntersecting; clock(); }).observe(root);
    document.addEventListener('visibilitychange', clock);
    playLabel(); reset(); clock();
  });
</script>
<style is:global>
  .playground .bh-slots { display: flex; gap: 6px; flex-wrap: wrap; }
  .playground .bh-slot { width: 38px; height: 38px; border: 2px dashed var(--border); border-radius: 8px; display: grid; place-items: center; font: 700 .95rem var(--font-mono); color: var(--on-accent); background: var(--surface); }
  .playground .bh-slot.p { border-style: solid; border-color: var(--role-1); background: var(--role-1); }
  .playground .bh-slot.s { border-style: solid; border-color: var(--role-2); background: var(--role-2); }
  .playground .bh-slot.gap { margin-left: 18px; }
</style>
