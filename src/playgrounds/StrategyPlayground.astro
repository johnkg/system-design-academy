---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Change the cart and swap the pricing strategy while the total updates live.">
  <ol class="how">
    <li>Change quantities in the <b>cart</b>.</li>
    <li>Click different <b>strategies</b>. The Checkout code stays the same; only the object it calls changes.</li>
    <li>Press <b>+ Add a strategy</b> to plug in a brand new rule.</li>
  </ol>
  <div data-strategy-demo class="st-demo">
    <div class="st-cart" data-cart></div>
    <div role="group" aria-label="Pricing strategy" class="st-row" data-strategies></div>
    <div class="st-result">
      <div><small>Cart total</small><b data-sum></b></div>
      <span aria-hidden="true">→</span>
      <div><small data-call>strategy.apply(total)</small><b class="st-final" data-final></b></div>
    </div>
    <p class="st-note" data-note aria-live="polite"></p>
    <div class="st-row"><button class="btn" type="button" data-add>+ Add a strategy</button></div>
  </div>
</PlaygroundShell>
<script>
  type Strategy = { name: string; blurb: string; apply(total: number): number };
  // Checkout never changes. Only the strategy it is handed.
  class Checkout {
    strategy: Strategy;
    constructor(s: Strategy) { this.strategy = s; }
    total(prices: number[]) { return this.strategy.apply(prices.reduce((a, b) => a + b, 0)); }
  }
  const strategies: Strategy[] = [
    { name: 'RegularPrice', blurb: 'No discount.', apply: (t) => t },
    { name: 'PercentOff(20)', blurb: '20% off everything.', apply: (t) => t * 0.8 },
    { name: 'FlatOff(15)', blurb: '$15 off, never below zero.', apply: (t) => Math.max(0, t - 15) },
  ];
  const later: Strategy = { name: 'Loyalty(30%, max $25)', blurb: '30% off but the saving is capped at $25. Added later, no Checkout edits.', apply: (t) => t - Math.min(t * 0.3, 25) };
  const items = [{ name: 'Keyboard', price: 60, qty: 1 }, { name: 'Mouse', price: 25, qty: 1 }, { name: 'Cable', price: 15, qty: 2 }];
  const money = (n: number) => `$${n.toFixed(2)}`;

  document.querySelectorAll<HTMLElement>('[data-strategy-demo]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const checkout = new Checkout(strategies[0]);

    function renderCart() {
      const cart = q('[data-cart]');
      cart.innerHTML = '';
      items.forEach((it) => {
        const row = document.createElement('div');
        row.className = 'st-item';
        row.innerHTML = `<span></span><span class="st-qty"><button class="btn" type="button" aria-label="Fewer">−</button><output></output><button class="btn" type="button" aria-label="More">+</button></span>`;
        row.firstElementChild!.textContent = `${it.name} (${money(it.price)})`;
        const out = row.querySelector('output')!;
        const [minus, plus] = row.querySelectorAll('button');
        const sync = () => { out.textContent = String(it.qty); update(); };
        minus.addEventListener('click', () => { it.qty = Math.max(0, it.qty - 1); sync(); });
        plus.addEventListener('click', () => { it.qty += 1; sync(); });
        out.textContent = String(it.qty);
        cart.appendChild(row);
      });
    }
    function renderStrategies() {
      const wrap = q('[data-strategies]');
      wrap.innerHTML = '';
      strategies.forEach((s) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn'; b.textContent = s.name;
        b.setAttribute('aria-pressed', String(checkout.strategy === s));
        b.addEventListener('click', () => { checkout.strategy = s; renderStrategies(); update(); });
        wrap.appendChild(b);
      });
    }
    function update() {
      const prices = items.flatMap((i) => Array(i.qty).fill(i.price));
      const sum = prices.reduce((a, b) => a + b, 0);
      q('[data-sum]').textContent = money(sum);
      q('[data-call]').textContent = `${checkout.strategy.name}.apply(${money(sum)})`;
      const f = q('[data-final]');
      const next = money(checkout.total(prices));
      if (f.textContent !== next) { f.textContent = next; f.classList.remove('bump'); void f.offsetWidth; f.classList.add('bump'); }
      q('[data-note]').textContent = checkout.strategy.blurb;
    }
    q('[data-add]').addEventListener('click', (e) => {
      strategies.push(later);
      checkout.strategy = later;
      (e.currentTarget as HTMLButtonElement).disabled = true;
      renderStrategies(); update();
    });
    renderCart(); renderStrategies(); update();
  });
</script>
<style is:global>
  .playground .st-demo { display: grid; gap: 12px; }
  .playground .st-cart { display: grid; gap: 6px; }
  .playground .st-item { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 6px 10px; border: 1px solid var(--border); border-radius: 8px; }
  .playground .st-qty { display: flex; align-items: center; gap: 8px; }
  .playground .st-qty .btn { padding: 0 10px; }
  .playground .st-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .playground .st-result { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 12px; border-radius: 10px; background: var(--accent-soft); }
  .playground .st-result small { display: block; color: var(--muted); font: .75rem ui-monospace, monospace; overflow-wrap: anywhere; }
  .playground .st-result b { font-size: 1.5rem; }
  .playground .st-final { color: var(--accent); display: inline-block; }
  .playground .st-final.bump { animation: st-bump .4s ease-out; }
  .playground .st-note { margin: 0; color: var(--muted); font-size: .9rem; min-height: 1.4em; }
  @keyframes st-bump { 40% { transform: scale(1.18); } }
</style>
