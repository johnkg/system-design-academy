---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="An example model with 32 layers, 8 key-value heads of size 128 and 16-bit numbers needs 2 x 32 x 8 x 128 x 2 = 131072 bytes (128 KiB) of KV cache for every token. Choose the window, the prompt, the answer and the number of requests at once.">
  <ol class="how">
    <li>Start with the defaults: <b>Window</b> <b>8192</b>, <b>Prompt tokens</b> <b>6000</b>, <b>Answer tokens</b> <b>1000</b> and <b>Concurrent requests</b> <b>1</b>. <b>7000</b> tokens of the <b>8192</b> are used, the KV cache for one request is <b>875</b> MiB, and the total is <b>875</b> MiB. It fits.</li>
    <li>Set <b>Concurrent requests</b> to <b>32</b>: the cache for all of them is <b>27.34</b> GiB, before the model's own weights.</li>
    <li>Set <b>Window</b> to <b>131072</b>, <b>Prompt tokens</b> to <b>100000</b> and <b>Concurrent requests</b> to <b>8</b>: one request now holds <b>101000</b> tokens and its cache is <b>12.33</b> GiB, so the eight need <b>98.63</b> GiB, which is more than an 80 GB GPU holds.</li>
    <li>Set <b>Window</b> back to <b>8192</b> with the same prompt: the request is over the window by <b>92808</b> tokens, so something has to be cut.</li>
  </ol>
  <div class="pg ctx" data-ctx>
    <div class="pg-row">
      <label>Window <select class="pg-in" data-w><option value="4096">4096</option><option value="8192" selected>8192</option><option value="32768">32768</option><option value="131072">131072</option></select></label>
      <label>Prompt tokens <input class="pg-in" type="range" min="500" max="131072" step="500" value="6000" data-p /> <b data-pv></b></label>
      <label>Answer tokens <input class="pg-in" type="range" min="100" max="4000" step="100" value="1000" data-a /> <b data-av></b></label>
      <label>Concurrent requests <input class="pg-in" type="range" min="1" max="64" step="1" value="1" data-n /> <b data-nv></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Window used</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>KV cache for one request</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>KV cache for all requests</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // Example model: 32 layers x 8 key-value heads x 128 per head, keys and values (x 2), 16-bit numbers (2 bytes) = 131072 bytes per token.
  const BYTES_PER_TOKEN = 2 * 32 * 8 * 128 * 2;
  const GPU_GIB = 80 * 1e9 / 2 ** 30; // an 80 GB GPU is about 74.5 GiB
  type Tone = 'good' | 'bad' | 'mid';
  const trim = (n: number) => String(Number(n.toFixed(2)));
  const size = (b: number) => (b >= 2 ** 30 ? `${trim(b / 2 ** 30)} GiB` : `${trim(b / 2 ** 20)} MiB`);
  document.querySelectorAll<HTMLElement>('[data-ctx]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const win = Number(q<HTMLSelectElement>('[data-w]').value), prompt = Number(q<HTMLInputElement>('[data-p]').value);
      const answer = Number(q<HTMLInputElement>('[data-a]').value), n = Number(q<HTMLInputElement>('[data-n]').value);
      q('[data-pv]').textContent = String(prompt); q('[data-av]').textContent = String(answer); q('[data-nv]').textContent = String(n);
      const tokens = prompt + answer, over = tokens - win;
      const one = tokens * BYTES_PER_TOKEN, all = one * n;
      setBox(1, `${tokens} of ${win}`, over > 0 ? `over the window by ${over} tokens: something must be cut` : `${win - tokens} tokens to spare, and it fits`, over > 0 ? 'bad' : 'good');
      setBox(2, size(one), `${tokens} tokens x 128 KiB`, 'mid');
      setBox(3, size(all), all / 2 ** 30 > GPU_GIB ? `${n} requests: more than an 80 GB GPU holds, before the weights` : `${n} request${n === 1 ? '' : 's'} at once`, all / 2 ** 30 > GPU_GIB ? 'bad' : 'mid');
      q('[data-verdict]').textContent = 'Memory for the cache grows with every token of every request, so long prompts limit how many requests a GPU can serve at once. This is a model of one example configuration, not any particular product.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
