---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="One seeded day of failed logins from 23 sources. A fast attacker guesses 8 passwords a minute from minute 800 and gets in at 810. A slow one guesses once a minute from minute 200 and gets in at 500. One on-call engineer spends 10 minutes per alert. The hash in the log chain is a 32-bit stand-in, not secure.">
  <ol class="how">
    <li>Start with <b>Window</b> at <b>5 min</b>, <b>Failures to alert</b> at <b>3</b> and <b>Response</b> at <b>Manual</b>: <b>36</b> alerts, <b>30</b> of them false. The fast attacker is detected at once but contained <b>25</b> min after it began, and had access for <b>15</b> min.</li>
    <li>Set <b>Failures to alert</b> to <b>10</b>: only <b>2</b> alerts, but the slow attacker is never detected. Set it to <b>20</b>: <b>1</b> alert, no false one, and the slow attacker is still missed.</li>
    <li>Set <b>Window</b> to <b>60 min</b> and <b>Failures to alert</b> to <b>40</b>: <b>7</b> alerts, none false, and the slow attacker is detected <b>39</b> min after it began, before the login succeeds. With <b>Response</b> at <b>Manual</b> the fast attacker is contained <b>29</b> min after it began; set it to <b>Runbook</b> and it is <b>16</b>.</li>
    <li>Set <b>Window</b> to <b>5 min</b>, <b>Failures to alert</b> to <b>10</b> and <b>Response</b> to <b>Auto-block</b>: the fast attacker is stopped before the login succeeds, but <b>40</b> legitimate users behind the office address are locked out.</li>
  </ol>
  <div class="pg sl" data-sl>
    <div class="pg-row">
      <label>Window <select class="pg-in" data-win><option value="5" selected>5 min</option><option value="15">15 min</option><option value="60">60 min</option></select></label>
      <label>Failures to alert <select class="pg-in" data-thr><option value="3" selected>3</option><option value="5">5</option><option value="10">10</option><option value="20">20</option><option value="40">40</option></select></label>
      <label><input type="checkbox" data-cor /> Also alert on a success after failures</label>
      <label>Response <select class="pg-in" data-resp><option value="manual" selected>Manual</option><option value="runbook">Runbook</option><option value="auto">Auto-block</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Alerts in the day</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Fast attacker</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Slow attacker</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Legitimate users locked out</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The day, one cell per hour</h3>
      <div class="sl-strip" data-strip></div>
      <span class="pg-note">Red: a false alert fired in that hour. Green: only real ones. Grey: none.</span>
    </div>
    <div class="pg-row">
      <label>Tampering with the log <select class="pg-in" data-tamper><option value="none" selected>None</option><option value="edit">Edit entry 2</option><option value="rewrite">Edit entry 2 and recompute the chain</option><option value="trunc">Delete the last 2 entries</option></select></label>
      <label><input type="checkbox" data-anchor checked /> Head hash kept in a separate store</label>
    </div>
    <div class="pg-box" data-b5><h3>Hash-chained log check</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  // The same model as the code samples: a Park-Miller seeded day of login events, rate and correlation rules, one on-call queue.
  const DAY = 1440, NORMAL = 20, OFFICE = 20, A = 21, B = 22, SRC = 23, TRIAGE = 10, COOLDOWN = 60;
  const USERS = Array.from({ length: SRC }, (_, i) => (i === OFFICE ? 40 : 1));
  const ATTACK: Record<number, { start: number; breach: number }> = { [A]: { start: 800, breach: 810 }, [B]: { start: 200, breach: 500 } };
  let seed = 12345;
  const rnd = (n: number): number => { seed = (seed * 48271) % 2147483647; return seed % n; };
  const fails = Array.from({ length: SRC }, () => new Array<number>(DAY).fill(0));
  const wins = Array.from({ length: SRC }, () => new Array<number>(DAY).fill(0));
  for (let m = 0; m < DAY; m++) {
    for (let s = 0; s < SRC; s++) {
      if (s < NORMAL) {
        if (rnd(1000) < 6) { fails[s][m] += 1 + (rnd(100) < 25 ? 1 + rnd(3) : 0); if (m + 1 < DAY) wins[s][m + 1] = 1; }
      } else if (s === OFFICE) {
        if (rnd(100) < 5) fails[s][m] += 1;
        if (m >= 540 && m < 550) fails[s][m] += 3;
        wins[s][m] = 1;
      } else if (s === A && m >= 800 && m < 810) fails[s][m] = 8;
      else if (s === B && m >= 200 && m < 500) fails[s][m] = 1;
    }
  }
  wins[A][810] = 1; wins[B][500] = 1;
  const sum = (arr: number[], from: number, to: number): number => { let t = 0; for (let i = Math.max(0, from); i <= to; i++) t += arr[i]; return t; };
  interface Alert { t: number; s: number; done: number }

  function detect(window: number, threshold: number, correlate: boolean, response: string) {
    const alerts: Alert[] = []; const last = new Array<number>(SRC).fill(-1000);
    for (let m = 0; m < DAY; m++) for (let s = 0; s < SRC; s++) {
      if (m - last[s] < COOLDOWN) continue;
      const hit = sum(fails[s], m - window + 1, m) >= threshold || (correlate && wins[s][m] === 1 && sum(fails[s], m - 15, m - 1) >= 3);
      if (hit) { alerts.push({ t: m, s, done: 0 }); last[s] = m; }
    }
    let free = 0, blocked = 0; const seenBlocked = new Set<number>();
    const first: Record<number, Alert | null> = { [A]: null, [B]: null };
    for (const a of alerts) {
      const start = Math.max(a.t, free); free = start + TRIAGE; a.done = free;
      const real = a.s === A || a.s === B;
      if (!real && response === 'auto' && !seenBlocked.has(a.s)) { seenBlocked.add(a.s); blocked += USERS[a.s]; }
      if (real && first[a.s] === null) first[a.s] = a;
    }
    const falseAlerts = alerts.filter((a) => a.s !== A && a.s !== B).length;
    const who: Record<number, { text: string; good: boolean }> = {};
    for (const s of [A, B]) {
      const a = first[s];
      if (!a) { who[s] = { text: 'never detected', good: false }; continue; }
      const contained = response === 'auto' ? a.t + 1 : a.done + (response === 'runbook' ? 2 : 15);
      const early = contained < ATTACK[s].breach;
      who[s] = { text: `detected ${a.t - ATTACK[s].start} min after it began, contained ${contained - ATTACK[s].start} min after; ${early ? 'stopped before the login succeeded' : `attacker had access for ${contained - ATTACK[s].breach} min`}`, good: early };
    }
    return { alerts, falseAlerts, blocked, who };
  }

  // The hash-chained log from the samples. The hash is a 32-bit FNV-1a STAND-IN, not secure.
  const hex = (h: number): string => h.toString(16).padStart(8, '0');
  const fnv = (s: string): number => { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; } return h >>> 0; };
  const LINES = ['login ok user=alice', 'role_change user=bob role=admin by=alice', 'export_report user=bob rows=50000', 'login ok user=carol', 'delete_user user=dave by=bob'];
  const chain = (lines: string[]): number[] => { let prev = 0; return lines.map((l) => (prev = fnv(hex(prev) + '|' + l))); };
  function verify(lines: string[], stored: number[], anchor: number | null): { text: string; good: boolean } {
    const now = chain(lines);
    for (let i = 0; i < stored.length; i++) if (now[i] !== stored[i]) return { text: `broken at entry ${i + 1}`, good: true };
    if (lines.length !== stored.length) return { text: 'chain consistent, but length differs from the stored hashes', good: true };
    if (anchor === null) return { text: 'chain consistent, nothing outside to compare the head with', good: false };
    return now[now.length - 1] === anchor ? { text: 'intact, head matches the anchor', good: true } : { text: 'chain consistent, but the head does not match the anchor: tampering detected', good: true };
  }

  document.querySelectorAll<HTMLElement>('[data-sl]').forEach((root) => {
    const q = query(root);
    const strip = q('[data-strip]');
    const cells = Array.from({ length: 24 }, () => { const c = document.createElement('span'); c.className = 'sl-cell'; strip.appendChild(c); return c; });
    const color = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    function draw() {
      const r = detect(Number(q<HTMLSelectElement>('[data-win]').value), Number(q<HTMLSelectElement>('[data-thr]').value), q<HTMLInputElement>('[data-cor]').checked, q<HTMLSelectElement>('[data-resp]').value);
      q('[data-o1]').textContent = `${r.alerts.length} alerts, ${r.falseAlerts} false`;
      let maxWait = 0, free = 0;
      for (const a of r.alerts) { const start = Math.max(a.t, free); free = start + TRIAGE; maxWait = Math.max(maxWait, start - a.t); }
      q('[data-n1]').textContent = `Longest wait before an alert was looked at: ${maxWait} min`;
      color(1, r.falseAlerts <= 2);
      q('[data-o2]').textContent = r.who[A].text; q('[data-n2]').textContent = 'guesses 8 a minute, from minute 800'; color(2, r.who[A].good);
      q('[data-o3]').textContent = r.who[B].text; q('[data-n3]').textContent = 'guesses 1 a minute, from minute 200'; color(3, r.who[B].good);
      q('[data-o4]').textContent = `${r.blocked}`;
      q('[data-n4]').textContent = r.blocked ? 'auto-block acted on false alerts, including the shared office address' : 'nobody legitimate was blocked';
      color(4, r.blocked === 0);
      cells.forEach((c, h) => {
        const inHour = r.alerts.filter((a) => a.t >= h * 60 && a.t < h * 60 + 60);
        const bad = inHour.some((a) => a.s !== A && a.s !== B);
        c.style.setProperty('--c', inHour.length === 0 ? 'var(--border)' : bad ? 'var(--bad)' : 'var(--good)');
        c.title = `hour ${h}: ${inHour.length} alerts`;
      });
      const stored = chain(LINES); const head = stored[stored.length - 1];
      const edited = [...LINES]; edited[1] = 'role_change user=bob role=viewer by=alice';
      const anchor = q<HTMLInputElement>('[data-anchor]').checked ? head : null;
      const mode = q<HTMLSelectElement>('[data-tamper]').value;
      const v = mode === 'edit' ? verify(edited, stored, anchor)
        : mode === 'rewrite' ? verify(edited, chain(edited), anchor)
        : mode === 'trunc' ? verify(LINES.slice(0, 3), chain(LINES.slice(0, 3)), anchor)
        : verify(LINES, stored, anchor);
      q('[data-o5]').textContent = v.text;
      q('[data-n5]').textContent = mode === 'none' ? 'Nothing changed.' : v.good ? 'The tampering was noticed.' : 'The attacker rewrote the chain and nothing outside it exists to disagree: tampering goes unnoticed.';
      color(5, v.good);
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .sl-strip { display: flex; flex-wrap: wrap; gap: 3px; }
  .playground .sl-cell { width: 22px; height: 22px; border-radius: 4px; background: var(--c); }
</style>
