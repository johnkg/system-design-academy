---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A service logs in several places, and the logger is optional. Choose how a missing logger is handled and see what that costs in checks and in crashes.">
  <ol class="how">
    <li>Start with the defaults: <b>Places that log</b> at <b>5</b>, <b>Checks forgotten</b> at <b>1</b>, <b>Logger</b> <b>Not configured</b> and <b>Design</b> <b>Null checks</b>. The code has <b>4</b> null checks (one of the 5 places forgot its check), <b>1</b> crash and writes <b>0</b> log lines.</li>
    <li>Set <b>Design</b> to <b>Null object</b>: <b>0</b> checks and <b>0</b> crashes, but still <b>0</b> log lines. The missing logger is now silent, which is right for logging and wrong for something that must happen.</li>
    <li>Set <b>Logger</b> to <b>Configured</b>: the service writes <b>5</b> log lines, with either design.</li>
    <li>Set <b>Places that log</b> to <b>12</b> and <b>Design</b> to <b>Null checks</b>: <b>11</b> checks to write and keep, and the one forgotten check is still a crash waiting.</li>
  </ol>
  <div class="pg nulo" data-nulo>
    <div class="pg-row">
      <label>Places that log <input class="pg-in" type="range" min="1" max="12" step="1" value="5" data-p /> <b data-pv></b></label>
      <label>Checks forgotten <input class="pg-in" type="range" min="0" max="3" step="1" value="1" data-f /> <b data-fv></b></label>
      <label>Logger <select class="pg-in" data-logger><option value="0" selected>Not configured</option><option value="1">Configured</option></select></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Null checks</option><option value="1">Null object</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Null checks in the service</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Crashes with no logger</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Log lines written</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // The same model as the code samples: a null check per logging place, or one NullLogger chosen once.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-nulo]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const places = Number(q<HTMLInputElement>('[data-p]').value);
      const forgotten = Math.min(Number(q<HTMLInputElement>('[data-f]').value), places);
      const configured = q<HTMLSelectElement>('[data-logger]').value === '1';
      const nullObject = q<HTMLSelectElement>('[data-design]').value === '1';
      q('[data-pv]').textContent = String(places);
      q('[data-fv]').textContent = String(Math.min(forgotten, places));
      const crashes = nullObject || configured ? 0 : forgotten;
      const lines = configured ? places : 0;
      setBox(1, String(nullObject ? 0 : places - forgotten), nullObject ? 'the service just calls the logger' : `${places} places need a check, ${forgotten} of them forgot it`, nullObject ? 'good' : 'bad');
      setBox(2, String(crashes), crashes > 0 ? 'a place with no check meets a missing logger' : nullObject ? 'a missing logger is a logger that does nothing' : 'no crash, because a logger is configured', crashes > 0 ? 'bad' : 'good');
      setBox(3, String(lines), configured ? 'every place logs one line' : nullObject ? 'nothing is logged and nobody is told' : 'nothing is logged', configured || !nullObject ? 'good' : 'mid');
      q('[data-verdict]').textContent = nullObject
        ? 'The choice is made once, where the logger is created. Use it when doing nothing is a correct behaviour, and fail loudly when it is not.'
        : 'Every place that logs repeats the check, and any one that forgets it fails when the logger is missing.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
