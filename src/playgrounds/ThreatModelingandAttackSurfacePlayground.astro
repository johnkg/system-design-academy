---
import PlaygroundShell from '../components/PlaygroundShell.astro';
import RangeField from '../components/RangeField.astro';
---
<PlaygroundShell title="Simulate it" hint="A toy photo-sharing app with 12 threats, each scored likelihood x impact (1 to 5 each, judgement calls). You draw the model around some of the system, then spend a fixed budget on fixes ranked by what the model can see.">
  <ol class="how">
    <li>Start with <b>Scope</b> on <b>Public endpoints only</b>, <b>Budget</b> 8 and <b>Ranking</b> on <b>Risk removed per cost</b>. The model reports <b>0</b> risk left, yet <b>75</b> of 143 is really still there: the threats nobody drew are still open.</li>
    <li>Set <b>Scope</b> to <b>Everything, including admin, build and backups</b>. The same budget now removes <b>80</b> of 143 (<b>55%</b>), because the ranking can now see the logs and the backup bucket and spends part of the budget there instead of on the photo-by-id check, which removes less per unit of cost.</li>
    <li>Set <b>Budget</b> to <b>5</b>. At full scope the fixes remove <b>54</b> (<b>37%</b>). Now set <b>Scope</b> back to <b>Public endpoints only</b>: only <b>33</b> (<b>23%</b>) is removed, and the model still says <b>20</b> is left, which looks like a small problem.</li>
    <li>Set <b>Budget</b> to 8 and <b>Scope</b> to everything, then <b>Ranking</b> to <b>Cheapest first</b>: only <b>58</b> (<b>40%</b>) is removed. Doing the easy fixes first feels productive but spends the budget on small threats.</li>
  </ol>
  <div class="pg tm" data-tm>
    <div class="pg-row">
      <label>Scope <select class="pg-in" data-scope>
        <option value="1" selected>Public endpoints only</option>
        <option value="2">Plus data stores and internal services</option>
        <option value="3">Everything, including admin, build and backups</option>
      </select></label>
      <RangeField label="Budget" name="budget" min="1" max="19" value="8" />
      <label>Ranking <select class="pg-in" data-rank>
        <option value="value" selected>Risk removed per cost</option>
        <option value="biggest">Biggest single threat first</option>
        <option value="cheap">Cheapest first</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-1)"><h3>The model says is left</h3><span class="pg-mono" data-seen></span><span class="pg-note" data-seennote></span></div>
      <div class="pg-box" data-realbox><h3>Really left</h3><span class="pg-mono" data-real></span><span class="pg-note" data-realnote></span></div>
      <div class="pg-box" style="--c: var(--role-2)"><h3>Risk removed</h3><span class="pg-mono" data-removed></span><span class="pg-note" data-spent></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Fixes chosen, in order</h3>
      <span class="pg-note" data-fixes></span>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The 12 threats</h3>
      <div style="overflow-x:auto"><table class="tm-table"><thead><tr><th>Flow</th><th>STRIDE</th><th>Score</th><th>In the model</th><th>Status</th></tr></thead><tbody data-rows></tbody></table></div>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  // The same model as the code samples. scope 1 = public endpoints, 2 = adds data stores and internal services, 3 = adds the rest.
  interface Threat { id: string; flow: string; stride: string; like: number; impact: number; scope: number }
  interface Fix { id: string; name: string; cost: number; removes: string[] }
  const THREATS: Threat[] = [
    { id: 't1', flow: 'login endpoint', stride: 'S', like: 5, impact: 4, scope: 1 },
    { id: 't2', flow: 'photo by id endpoint', stride: 'I', like: 4, impact: 4, scope: 1 },
    { id: 't3', flow: 'upload endpoint', stride: 'D', like: 4, impact: 2, scope: 1 },
    { id: 't4', flow: 'comment form', stride: 'T', like: 3, impact: 3, scope: 1 },
    { id: 't5', flow: 'import photo from URL', stride: 'E', like: 3, impact: 5, scope: 2 },
    { id: 't6', flow: 'app to database', stride: 'I', like: 2, impact: 5, scope: 2 },
    { id: 't7', flow: 'job queue to workers', stride: 'T', like: 3, impact: 4, scope: 2 },
    { id: 't8', flow: 'application logs', stride: 'I', like: 4, impact: 3, scope: 2 },
    { id: 't9', flow: 'admin panel', stride: 'E', like: 3, impact: 5, scope: 3 },
    { id: 't10', flow: 'dependencies and CI', stride: 'T', like: 2, impact: 5, scope: 3 },
    { id: 't11', flow: 'backup bucket', stride: 'I', like: 2, impact: 5, scope: 3 },
    { id: 't12', flow: 'who deleted a photo', stride: 'R', like: 3, impact: 2, scope: 3 },
  ];
  const FIXES: Fix[] = [
    { id: 'F1', name: 'MFA and login rate limits', cost: 3, removes: ['t1', 't9'] },
    { id: 'F2', name: 'owner check on every photo read', cost: 2, removes: ['t2'] },
    { id: 'F3', name: 'upload size and type limits', cost: 1, removes: ['t3'] },
    { id: 'F4', name: 'encode output', cost: 1, removes: ['t4'] },
    { id: 'F5', name: 'egress allow-list for the importer', cost: 2, removes: ['t5'] },
    { id: 'F6', name: 'least-privilege database account', cost: 2, removes: ['t6'] },
    { id: 'F7', name: 'authenticate service-to-service calls', cost: 3, removes: ['t7'] },
    { id: 'F8', name: 'scrub logs and keep an audit trail', cost: 2, removes: ['t8', 't12'] },
    { id: 'F9', name: 'pin dependencies, scope CI secrets', cost: 2, removes: ['t10'] },
    { id: 'F10', name: 'private, encrypted backup bucket', cost: 1, removes: ['t11'] },
  ];
  const risk = (t: Threat) => t.like * t.impact;
  const sum = (list: Threat[]) => list.reduce((a, t) => a + risk(t), 0);
  const TOTAL = sum(THREATS);

  function order(visible: Threat[], ranking: string): Fix[] {
    const gain = (f: Fix) => sum(visible.filter((t) => f.removes.includes(t.id)));
    const top = (f: Fix) => Math.max(0, ...visible.filter((t) => f.removes.includes(t.id)).map(risk));
    const cmps: Record<string, (a: Fix, b: Fix) => number> = {
      value: (a, b) => gain(b) * a.cost - gain(a) * b.cost,
      biggest: (a, b) => top(b) - top(a),
      cheap: (a, b) => a.cost - b.cost,
    };
    return FIXES.filter((f) => gain(f) > 0).sort((a, b) => cmps[ranking](a, b) || FIXES.indexOf(a) - FIXES.indexOf(b));
  }
  function run(scope: number, budget: number, ranking: string) {
    const visible = THREATS.filter((t) => t.scope <= scope);
    let left = budget;
    const picked: Fix[] = [];
    for (const f of order(visible, ranking)) if (f.cost <= left) { picked.push(f); left -= f.cost; }
    const gone = new Set(picked.flatMap((f) => f.removes));
    return { visible, picked, gone, spent: budget - left, seenLeft: sum(visible.filter((t) => !gone.has(t.id))), realLeft: sum(THREATS.filter((t) => !gone.has(t.id))) };
  }

  document.querySelectorAll<HTMLElement>('[data-tm]').forEach((root) => {
    const q = query(root);
    function draw() {
      const scope = Number(q<HTMLSelectElement>('[data-scope]').value);
      const budget = Number(q<HTMLInputElement>('[data-budget]').value);
      const ranking = q<HTMLSelectElement>('[data-rank]').value;
      q('[data-budgetval]').textContent = String(budget);
      const r = run(scope, budget, ranking);
      const removed = TOTAL - r.realLeft;
      q('[data-seen]').textContent = `${r.seenLeft}`;
      q('[data-seennote]').textContent = `of ${sum(r.visible)} the model knows about`;
      q('[data-real]').textContent = `${r.realLeft} of ${TOTAL}`;
      const hidden = r.realLeft - r.seenLeft;
      q('[data-realnote]').textContent = hidden > 0 ? `${hidden} of it sits where the model did not look` : 'the model and reality agree';
      q<HTMLElement>('[data-realbox]').style.setProperty('--c', hidden > 0 ? 'var(--bad)' : 'var(--good)');
      q('[data-removed]').textContent = `${removed} of ${TOTAL} (${Math.floor((100 * removed) / TOTAL)}%)`;
      q('[data-spent]').textContent = `${r.spent} of ${budget} budget spent`;
      q('[data-fixes]').textContent = r.picked.length ? r.picked.map((f) => `${f.id} ${f.name} (cost ${f.cost})`).join(', ') : 'none';
      const rows = q('[data-rows]'); rows.textContent = '';
      for (const t of THREATS) {
        const tr = document.createElement('tr');
        const inModel = t.scope <= scope;
        const cells = [t.flow, t.stride, String(risk(t)), inModel ? 'yes' : 'not drawn', r.gone.has(t.id) ? 'removed' : 'open'];
        cells.forEach((c) => { const td = document.createElement('td'); td.textContent = c; tr.appendChild(td); });
        if (!r.gone.has(t.id) && !inModel) tr.style.color = 'var(--bad-text)';
        rows.appendChild(tr);
      }
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .tm-table { width: 100%; border-collapse: collapse; font-size: 0.9em; }
  .playground .tm-table th, .playground .tm-table td { text-align: left; padding: 2px 8px 2px 0; overflow-wrap: anywhere; }
</style>
