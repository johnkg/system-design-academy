---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Look up a name" hint="See which steps a lookup of shop.example.com goes through, depending on what is already cached. Times are typical, not measured.">
  <div class="pg dnsa" data-dnsa>
    <div class="pg-row">
      <label>What is already cached <select class="pg-in" data-cache><option value="cold" selected>Nothing (cold lookup)</option><option value="resolver">Only the recursive resolver has it</option><option value="browser">The browser has it</option></select></label>
    </div>
    <ol class="dns-steps" data-steps aria-label="Lookup steps"></ol>
    <p class="pg-out" data-total aria-live="polite"></p>
  </div>
</PlaygroundShell>
<PlaygroundShell title="Change the address" hint="You move the site to a new server and update the DNS record. How long until everyone reaches the new server depends on the TTL.">
  <ol class="how">
    <li>With a <b>TTL of 1 day</b>, move the slider to a few hours: most users still reach the <b>old</b> server. With <b>30 seconds</b> almost nobody does after a minute.</li>
    <li>Look at the <b>authoritative load</b>: a short TTL means far more queries to your DNS provider, and every user pays more cold lookups.</li>
  </ol>
  <div class="pg dnsb" data-dnsb>
    <div class="pg-row">
      <label>TTL <select class="pg-in" data-ttl><option value="30">30 seconds</option><option value="300" selected>5 minutes</option><option value="3600">1 hour</option><option value="86400">1 day</option></select></label>
      <label>Time since you changed the record <input type="range" min="0" max="1440" step="1" value="10" data-min /> <b data-minval></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-oldbox><h3>Users still reaching the old server</h3><span class="pg-mono" data-old></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Queries to your name server</h3><span class="pg-mono" data-load></span><span class="pg-note">per popular resolver, in steady state</span></div>
    </div>
  </div>
</PlaygroundShell>
<script>
  const stages = [
    { name: 'Browser cache', ms: 0 }, { name: 'Operating system cache', ms: 1 }, { name: 'Recursive resolver', ms: 20 },
    { name: 'Root server', ms: 30 }, { name: '.com server', ms: 30 }, { name: 'example.com name server', ms: 40 },
  ];
  const RESOLVER = stages.findIndex((s) => s.name === 'Recursive resolver'); const AUTHORITATIVE = stages.length - 1;
  const MIN_PER_H = 60, SEC_PER_MIN = 60;
  const STALE_BAD_PCT = 10; // share of users still on the old address that turns the box red
  document.querySelectorAll<HTMLElement>('[data-dnsa]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const lis = stages.map(() => { const li = document.createElement('li'); q('[data-steps]').appendChild(li); return li; });
    function draw() {
      const cache = q<HTMLSelectElement>('[data-cache]').value; const hitAt = cache === 'browser' ? 0 : cache === 'resolver' ? RESOLVER : AUTHORITATIVE;
      let total = 0;
      stages.forEach((s, i) => {
        const used = i <= hitAt; if (used) total += s.ms;
        const result = i === hitAt ? 'answer found here' : i < hitAt ? 'miss' : 'not needed';
        lis[i].textContent = `${s.name}: ${used ? `${s.ms} ms, ${result}` : 'not needed'}`; lis[i].className = used ? (i === hitAt ? 'hit' : '') : 'skip';
      });
      q('[data-total]').textContent = `Total lookup time: about ${total} ms before the browser can connect.`;
    }
    root.addEventListener('change', draw); draw();
  });
  document.querySelectorAll<HTMLElement>('[data-dnsb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    function draw() {
      const ttl = Number(q<HTMLSelectElement>('[data-ttl]').value); const min = Number(q<HTMLInputElement>('[data-min]').value);
      q('[data-minval]').textContent = min >= MIN_PER_H ? `${Math.floor(min / MIN_PER_H)} h ${min % MIN_PER_H} min` : `${min} min`;
      const old = Math.max(0, 1 - (min * SEC_PER_MIN) / ttl) * 100;
      q('[data-old]').textContent = `${old.toFixed(0)}%`; q<HTMLElement>('[data-oldbox]').style.setProperty('--c', old > STALE_BAD_PCT ? 'var(--bad)' : 'var(--role-2)');
      q('[data-load]').textContent = `${(3600 / ttl).toFixed(ttl >= 3600 ? 2 : 0)} per hour`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw); draw();
  });
</script>
<style is:global>
  .playground .dns-steps { margin: 0; padding-left: 1.2rem; display: grid; gap: 4px; font: .88rem ui-monospace, monospace; }
  .playground .dns-steps li.hit { font-weight: 700; color: var(--accent); }
  .playground .dns-steps li.skip { color: var(--muted); }
</style>
