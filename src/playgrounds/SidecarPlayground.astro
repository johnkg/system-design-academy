---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A fleet of services needs the same retry and logging behaviour. Compare putting it in a library inside every service with running a sidecar beside each one.">
  <ol class="how">
    <li>Start with the defaults: <b>Services</b> at <b>6</b>, <b>Languages</b> at <b>3</b> and <b>Design</b> <b>Library in each service</b>. The behaviour must be written <b>3</b> times, once per language, a policy change needs <b>6</b> application builds, and there are <b>0</b> extra processes.</li>
    <li>Set <b>Design</b> to <b>Sidecar</b>: <b>1</b> implementation, <b>0</b> application builds for a policy change, and <b>6</b> extra processes to run, one beside each service. Every call also pays for the local hop: <b>1</b> ms is added to it.</li>
    <li>Set <b>Services</b> to <b>30</b>: the sidecar design runs <b>30</b> extra processes, and the library design needs <b>30</b> builds for a policy change.</li>
    <li>Set <b>Local hop cost</b> to <b>5</b>: every call through a sidecar takes <b>5</b> ms longer. A request that makes ten calls pays that ten times, so the hop matters on latency-sensitive paths.</li>
    <li>Set <b>Languages</b> to <b>1</b> with <b>Design</b> on <b>Library in each service</b>: <b>1</b> implementation. With one language a library is hard to beat.</li>
  </ol>
  <div class="pg side" data-side>
    <div class="pg-row">
      <label>Services <input class="pg-in" type="range" min="1" max="30" step="1" value="6" data-s /> <b data-sv></b></label>
      <label>Languages <input class="pg-in" type="range" min="1" max="5" step="1" value="3" data-l /> <b data-lv></b></label>
      <label>Local hop cost <input class="pg-in" type="range" min="0" max="5" step="1" value="1" data-h /> <b data-hv></b> ms</label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Library in each service</option><option value="1">Sidecar</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Implementations to write</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Application builds for a policy change</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Extra processes to run</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Time added to every call</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // The same model as the code samples: the plumbing lives in each service's own code, or in one helper process beside each.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-side]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const services = Number(q<HTMLInputElement>('[data-s]').value), languages = Number(q<HTMLInputElement>('[data-l]').value);
      const sidecar = q<HTMLSelectElement>('[data-design]').value === '1';
      const hop = Number(q<HTMLInputElement>('[data-h]').value);
      q('[data-sv]').textContent = String(services); q('[data-lv]').textContent = String(languages); q('[data-hv]').textContent = String(hop);
      const impl = sidecar ? 1 : languages, builds = sidecar ? 0 : services, procs = sidecar ? services : 0;
      setBox(1, String(impl), sidecar ? 'one sidecar serves every language' : 'one port of the library for each language', impl === 1 ? 'good' : 'bad');
      setBox(2, String(builds), sidecar ? 'the sidecar is upgraded on its own' : 'every service is rebuilt and redeployed', builds === 0 ? 'good' : 'bad');
      setBox(3, String(procs), sidecar ? 'one helper beside each service, and one more local hop for every call' : 'the code runs inside each service', procs === 0 ? 'good' : 'mid');
      setBox(4, `${sidecar ? hop : 0} ms`, sidecar ? 'the extra hop to the sidecar on localhost, assumed to cost the amount set above' : 'the code runs inside the service, so there is no extra hop', sidecar && hop > 0 ? 'mid' : 'good');
      q('[data-verdict]').textContent = sidecar
        ? 'One implementation and no application builds, paid for with an extra process and hop for every instance.'
        : languages === 1 ? 'With one language a shared library is simple, has no extra hop, and is hard to beat.' : 'The same behaviour is written once per language, and each service must be rebuilt to change it.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
