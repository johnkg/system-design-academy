---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A shop with six modules and one team per module, cut five ways. Pick a design and a change to see how many modules are edited, how many deploys it takes, which teams must release together, how many network calls a checkout makes and what fails when Payments misbehaves.">
  <ol class="how">
    <li>Set <b>Design</b> to <b>Big ball monolith</b> and <b>Change</b> to <b>Rename a column in the Orders table</b>: <b>6</b> modules are edited and <b>6</b> teams release together. Set <b>Design</b> to <b>Modular monolith</b>: only <b>1</b> module is edited, but all <b>6</b> teams still share the release.</li>
    <li>Set <b>Design</b> to <b>Microservices</b>: <b>1</b> deploy and <b>1</b> team. Set <b>Design</b> to <b>Distributed monolith</b>: the same rename needs <b>6</b> deploys, with <b>6</b> teams in lockstep, and <b>6</b> of <b>6</b> modules fail when Payments misbehaves.</li>
    <li>Set <b>Design</b> to <b>Nanoservices</b> and <b>Network call cost (ms)</b> to <b>2</b>: a checkout makes <b>17</b> network calls, which adds <b>34 ms</b>. Set <b>Design</b> to <b>Microservices</b>: <b>5</b> calls, which adds <b>10 ms</b>.</li>
    <li>Read the table of all four changes. Deploys: <b>4</b> for the big ball, <b>4</b> for the modular monolith, <b>12</b> for microservices, <b>18</b> for the distributed monolith, <b>27</b> for nanoservices. Team-releases: <b>24</b>, <b>24</b>, <b>12</b>, <b>18</b> and <b>12</b>.</li>
  </ol>
  <div class="pg arc" data-arc>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design>
        <option value="0">Big ball monolith</option>
        <option value="1">Modular monolith</option>
        <option value="2">Microservices</option>
        <option value="3" selected>Distributed monolith</option>
        <option value="4">Nanoservices</option>
      </select></label>
      <label>Change <select class="pg-in" data-req>
        <option value="0">Change a price rule in Catalog</option>
        <option value="1">Add a field to the Orders contract</option>
        <option value="2" selected>Rename a column in the Orders table</option>
        <option value="3">Upgrade the web framework everywhere</option>
      </select></label>
      <label>Network call cost (ms) <input class="pg-in" type="range" min="1" max="10" step="1" value="2" data-ms /> <span class="pg-mono" data-msv></span></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Modules edited</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Deploys</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Teams that release together</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Network calls per checkout</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Latency added to a checkout</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Modules that fail when Payments misbehaves</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The same four changes, five designs</h3>
      <div class="arc-scroll" tabindex="0" role="region" aria-label="Totals for the five designs"><table class="arc-table" data-table>
        <thead><tr><th scope="col">Design</th><th scope="col">Modules edited</th><th scope="col">Deploys</th><th scope="col">Team-releases</th><th scope="col">Calls per checkout</th><th scope="col">Failing modules</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <span class="pg-note">Totals over the four changes. A team-release is one team that has to take part in a release. Failing modules are those whose requests fail when Payments crashes or holds a lock.</span>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="Edits per change, for the chosen design"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type Design = { name: string; together: boolean; sharedDb: boolean; leaky: boolean; split: number; fallbacks: boolean };
  type Change = { text: string; kind: string; module: string; consumers: string[] };
  const MODULES = ['catalog', 'cart', 'orders', 'payments', 'shipping', 'notify'];
  const CHECKOUT: [string, string][] = [['orders', 'cart'], ['cart', 'catalog'], ['orders', 'payments'], ['orders', 'shipping'], ['shipping', 'notify']];
  const LAYERS = ['api', 'logic', 'store'];
  const DESIGNS: Design[] = [
    { name: 'Big ball monolith', together: true, sharedDb: true, leaky: true, split: 1, fallbacks: false },
    { name: 'Modular monolith', together: true, sharedDb: false, leaky: false, split: 1, fallbacks: false },
    { name: 'Microservices', together: false, sharedDb: false, leaky: false, split: 1, fallbacks: true },
    { name: 'Distributed monolith', together: false, sharedDb: true, leaky: true, split: 1, fallbacks: false },
    { name: 'Nanoservices', together: false, sharedDb: false, leaky: false, split: 3, fallbacks: false },
  ];
  const CHANGES: Change[] = [
    { text: 'Change a price rule in Catalog', kind: 'logic', module: 'catalog', consumers: [] },
    { text: 'Add a field to the Orders contract', kind: 'contract', module: 'orders', consumers: ['payments', 'shipping', 'notify'] },
    { text: 'Rename a column in the Orders table', kind: 'schema', module: 'orders', consumers: [] },
    { text: 'Upgrade the web framework everywhere', kind: 'all', module: '', consumers: [] },
  ];

  // The same model as the code samples.
  const callersOf = (m: string) => CHECKOUT.filter((e) => e[1] === m).map((e) => e[0]);
  function edits(d: Design, c: Change): [string, string[]][] {
    if (c.kind === 'all') return MODULES.map((m) => [m, LAYERS] as [string, string[]]);
    if (c.kind === 'logic') return ([[c.module, ['logic']]] as [string, string[]][]).concat(d.leaky ? callersOf(c.module).map((m) => [m, ['logic']] as [string, string[]]) : []);
    if (c.kind === 'contract') return ([[c.module, LAYERS]] as [string, string[]][]).concat(c.consumers.map((m) => [m, ['logic']] as [string, string[]]));
    return d.sharedDb ? MODULES.map((m) => [m, m === c.module ? ['logic', 'store'] : ['logic']] as [string, string[]]) : [[c.module, ['logic', 'store']]];
  }
  const deployable = (d: Design, m: string, layer: string) => (d.together ? 'app' : d.split === 1 ? m : `${m}.${layer}`);
  function analyse(d: Design, c: Change) {
    const es = edits(d, c);
    const units = new Set<string>();
    for (const [m, layers] of es) for (const l of layers) units.add(deployable(d, m, l));
    return { modules: es.map((e) => e[0]), deploys: units.size, teams: d.together ? MODULES.length : es.length };
  }
  function checkoutCalls(d: Design) {
    if (d.together) return 0;
    const visited = new Set(CHECKOUT.flat());
    return CHECKOUT.length + (d.split === 3 ? 2 * visited.size : 0);
  }
  function failing(d: Design) {
    if (d.together || d.sharedDb) return MODULES.length;
    const out = new Set(['payments']);
    if (!d.fallbacks) {
      let grew = true;
      while (grew) { grew = false; for (const [a, b] of CHECKOUT) if (out.has(b) && !out.has(a)) { out.add(a); grew = true; } }
    }
    return out.size;
  }

  document.querySelectorAll<HTMLElement>('[data-arc]').forEach((root) => {
    const q = query(root);
    const tbody = q('[data-table] tbody');
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const di = Number(q<HTMLSelectElement>('[data-design]').value);
      const ri = Number(q<HTMLSelectElement>('[data-req]').value);
      const ms = Number(q<HTMLInputElement>('[data-ms]').value);
      q('[data-msv]').textContent = `${ms} ms`;
      const d = DESIGNS[di];
      const a = analyse(d, CHANGES[ri]);
      const calls = checkoutCalls(d);
      const fail = failing(d);
      set(1, String(a.modules.length), a.modules.join(', '));
      box(1, a.modules.length <= 1);
      set(2, String(a.deploys), a.deploys <= 1 ? 'one release carries the change' : 'releases that all have to go out for the change to work');
      box(2, a.deploys <= 1);
      set(3, String(a.teams), d.together ? 'one deployable: every team ships in the same release' : 'teams that own an edited module');
      box(3, a.teams <= 1);
      set(4, String(calls), d.together ? 'modules call each other inside one process' : 'each call can time out, be slow or fail');
      box(4, calls <= 5);
      set(5, `${calls * ms} ms`, `${calls} calls at ${ms} ms each (an assumption, the same for every call)`);
      box(5, calls * ms <= 10);
      set(6, `${fail} of ${MODULES.length}`, d.together ? 'one process: a crash or leak in Payments takes every module down' : d.sharedDb ? 'a stuck query in the shared database stalls every service' : d.fallbacks ? 'callers have timeouts and fallbacks, so only Payments stops' : 'callers wait on Payments and fail with it');
      box(6, fail <= 2);
      tbody.textContent = '';
      DESIGNS.forEach((x, i) => {
        let tm = 0, td = 0, tt = 0;
        for (const c of CHANGES) { const s = analyse(x, c); tm += s.modules.length; td += s.deploys; tt += s.teams; }
        const tr = document.createElement('tr');
        if (i === di) tr.className = 'sel';
        [x.name, String(tm), String(td), String(tt), String(checkoutCalls(x)), `${failing(x)} of ${MODULES.length}`].forEach((text, k) => {
          const cell = document.createElement(k === 0 ? 'th' : 'td'); if (k === 0) cell.setAttribute('scope', 'row'); cell.textContent = text; tr.appendChild(cell);
        });
        tbody.appendChild(tr);
      });
      const log = q('[data-log]'); log.textContent = '';
      CHANGES.forEach((c) => {
        const s = analyse(d, c);
        const li = document.createElement('li'); li.textContent = `${c.text}: edit ${s.modules.join(', ')}; ${s.deploys} deploys`; log.appendChild(li);
      });
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .arc-scroll { overflow-x: auto; }
  .playground .arc-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .arc-table th, .playground .arc-table td { padding: 5px 8px; border-bottom: 1px solid var(--border); text-align: left; }
  .playground .arc-table tr.sel { background: var(--accent-soft); font-weight: 600; }
</style>
