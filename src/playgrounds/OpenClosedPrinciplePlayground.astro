---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A discount calculator with 2 rule types today: regular and member. Pick a design and how many new rule types arrive, one at a time, and see how much existing code each design makes you edit, and what the abstraction costs up front.">
  <ol class="how">
    <li>Start with <b>Switch on customer type</b> and <b>New rule types</b> at <b>6</b>: every addition edits the same function, so you make <b>6</b> edits in existing code with <b>27</b> existing branches exposed to accidental change, and <b>33</b> touch points in all. The design is only <b>1</b> file.</li>
    <li>Set <b>Design</b> to <b>Strategy-style rules</b>: each new rule is a new file and a line in the registry, so <b>0</b> existing branches are exposed and the cost is <b>12</b> touch points. The abstraction itself costs <b>5</b> files for the 2 rules that exist, and it starts to pay off from <b>3</b> added rules.</li>
    <li>Set <b>Design</b> to <b>Plug-in framework</b>: the same rules cost <b>11</b> files before the first new rule, and <b>29</b> files after six, and it only beats the switch from <b>7</b> added rules. Now read the box for the unexpected change: when every rule needs a new input, the switch edits <b>1</b> file, the strategy-style design <b>10</b>, and the framework <b>12</b>.</li>
  </ol>
  <div class="pg ocp" data-ocp>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design>
        <option value="0" selected>Switch on customer type</option>
        <option value="1">Strategy-style rules</option>
        <option value="2">Plug-in framework</option>
      </select></label>
      <label>New rule types <select class="pg-in" data-k>
        <option value="1">1</option>
        <option value="3">3</option>
        <option value="6" selected>6</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Edits to existing files</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>New files</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Existing branches exposed</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Touch points</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Files for the 2 rules that exist</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Unexpected change: a new input for every rule</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>When does the abstraction pay off?</h3>
      <span class="pg-mono" data-cross></span>
      <span class="pg-note">Touch points counted from scratch: the files that exist for the 2 rules, plus the cost of each added rule. If only 2 variants ever exist, the extra files are pure cost.</span>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="Touch points per added rule, for the chosen design"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const EXISTING = 2;
  interface Design { name: string; setupFiles: number; newFilesPerRule: number; exposesBranches: boolean; inputChangeBase: number; note: string }
  const DESIGNS: Design[] = [
    { name: 'Switch on customer type', setupFiles: 1, newFilesPerRule: 0, exposesBranches: true, inputChangeBase: 0, note: 'PriceCalculator holds one branch per rule' },
    { name: 'Strategy-style rules', setupFiles: 5, newFilesPerRule: 1, exposesBranches: false, inputChangeBase: 2, note: 'DiscountRule, PricingEngine, RuleRegistry, 2 rule classes' },
    { name: 'Plug-in framework', setupFiles: 11, newFilesPerRule: 3, exposesBranches: false, inputChangeBase: 4, note: 'rule, factory and descriptor per rule, plus loader, context, registry, engine, interface' },
  ];
  // The same model as the code samples.
  function addRules(d: Design, k: number) {
    let exposed = 0;
    if (d.exposesBranches) for (let i = 0; i < k; i++) exposed += EXISTING + i;
    const edits = k, created = d.newFilesPerRule * k;
    return { edits, created, exposed, touch: edits + created + exposed, filesAfter: d.setupFiles + created };
  }
  const inputChange = (d: Design, k: number) => (d.inputChangeBase === 0 ? 1 : d.inputChangeBase + EXISTING + k);
  const total = (d: Design, k: number) => d.setupFiles + addRules(d, k).touch;
  function crossover(a: Design, b: Design): number {
    for (let k = 0; k <= 50; k++) if (total(a, k) > total(b, k)) return k;
    return -1;
  }

  document.querySelectorAll<HTMLElement>('[data-ocp]').forEach((root) => {
    const q = query(root);
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const d = DESIGNS[Number(q<HTMLSelectElement>('[data-design]').value)];
      const k = Number(q<HTMLSelectElement>('[data-k]').value);
      const r = addRules(d, k);
      set(1, String(r.edits), d.exposesBranches ? 'the same function is edited again for every rule' : 'one line in the registry or config for each rule');
      box(1, true);
      set(2, String(r.created), `${d.newFilesPerRule === 0 ? 'nothing new: the rules are branches' : `${d.newFilesPerRule} per rule`}; ${r.filesAfter} files in all`);
      box(2, d.newFilesPerRule <= 1);
      set(3, String(r.exposed), r.exposed === 0 ? 'existing rules are not in any edited code' : 'existing rules sit inside the code you edit, so a slip can change them');
      box(3, r.exposed === 0);
      set(4, String(r.touch), 'edits, new files and exposed branches together');
      box(4, r.touch <= 12);
      set(5, String(d.setupFiles), d.note);
      box(5, d.setupFiles <= 5);
      const ic = inputChange(d, k);
      set(6, `${ic} ${ic === 1 ? 'file' : 'files'}`, d.inputChangeBase === 0 ? 'only the function signature changes' : 'the interface, the engine and every rule class change: the abstraction is closed against the wrong kind of change');
      box(6, ic <= 3);
      const x1 = crossover(DESIGNS[0], DESIGNS[1]), x2 = crossover(DESIGNS[0], DESIGNS[2]);
      q('[data-cross]').textContent = `Strategy-style costs less than the switch from ${x1} added rules. The plug-in framework costs less from ${x2} added rules.`;
      const log = q('[data-log]'); log.textContent = '';
      let exposed = 0;
      for (let i = 0; i < k; i++) {
        const e = d.exposesBranches ? EXISTING + i : 0; exposed += e;
        const li = document.createElement('li');
        li.textContent = `rule ${EXISTING + i + 1}: edit 1 existing file, add ${d.newFilesPerRule} files, ${e} existing branches exposed`;
        log.appendChild(li);
      }
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
