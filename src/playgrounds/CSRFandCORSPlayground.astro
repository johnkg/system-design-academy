---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it" hint="You are logged in to bank.example. A page on evil.example tries three things. Choose the bank's defences and see what gets through. This models browser behaviour, it does not send any real requests.">
  <ol class="how">
    <li>With <b>SameSite: None</b> and no other defence, press <b>evil.example submits a hidden form</b>: the transfer <b>goes through</b>.</li>
    <li>Set <b>SameSite: Lax</b>, or tick <b>require a CSRF token</b>, or <b>check the Origin header</b>: the same attack is stopped. Each one works alone, and they work best together.</li>
    <li>Press <b>evil.example reads /balance with fetch()</b>. With <b>CORS: not allowed</b> the browser hides the response. Switch to <b>allow evil.example</b> and the attacker can read it. CORS has no effect on the form attack: it controls reading, not sending.</li>
  </ol>
  <div class="pg cc" data-cc>
    <div class="pg-row">
      <label>Session cookie <select class="pg-in" data-samesite><option value="none" selected>SameSite: None</option><option value="lax">SameSite: Lax</option><option value="strict">SameSite: Strict</option></select></label>
      <label>CORS policy <select class="pg-in" data-cors><option value="none" selected>Not allowed for other sites</option><option value="evil">Allows evil.example (misconfigured)</option></select></label>
      <label class="cc-check"><input type="checkbox" data-token /> Require a CSRF token</label>
      <label class="cc-check"><input type="checkbox" data-origin /> Check the Origin header</label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-attack="form">evil.example submits a hidden form (POST /transfer)</button>
      <button class="btn" type="button" data-attack="json">evil.example sends a JSON POST with fetch()</button>
      <button class="btn" type="button" data-attack="read">evil.example reads /balance with fetch()</button>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-box><h3>Result</h3><span class="pg-mono" data-res>Press an attack button.</span><span class="pg-note" data-why></span></div>
    </div>
    <ol class="pg-log" data-log aria-label="Attempts so far"></ol>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-cc]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const sel = (s: string) => q<HTMLSelectElement>(s).value; const on = (s: string) => q<HTMLInputElement>(s).checked;
    const log: string[] = []; const LOG = 8; const rows: HTMLElement[] = [];
    for (let i = 0; i < LOG; i++) { const li = document.createElement('li'); li.hidden = true; q('[data-log]').appendChild(li); rows.push(li); }
    function attack(kind: string) {
      const cookieSent = sel('[data-samesite]') === 'none'; // a cross-site POST or fetch only carries the cookie with SameSite=None
      let res = ''; let why = ''; let bad = false;
      const state = (): boolean => {
        if (!cookieSent) { res = 'Blocked: the request arrived without the session cookie (401)'; why = 'SameSite stopped the browser from attaching the cookie to a cross-site request.'; return false; }
        if (on('[data-token]')) { res = 'Blocked: missing CSRF token (403)'; why = 'evil.example cannot read the bank\'s pages, so it cannot copy the token.'; return false; }
        if (on('[data-origin]')) { res = 'Blocked: Origin is evil.example, not bank.example (403)'; why = 'The server compared the Origin header with its own site.'; return false; }
        res = 'The transfer went through!'; why = 'The cookie was sent, and nothing else checked that the request came from the bank\'s own pages.'; bad = true; return true;
      };
      if (kind === 'form') { state(); }
      else if (kind === 'json') {
        if (sel('[data-cors]') === 'none') { res = 'Blocked by the browser before sending: the CORS preflight failed'; why = 'A JSON request triggers a preflight, and the bank does not allow evil.example. No request reached the bank.'; }
        else state();
      } else {
        // reading a response across origins needs CORS permission; the cookie also has to be sent for private data
        if (sel('[data-cors]') === 'none') { res = 'The request may arrive, but the browser hides the response from the attacker'; why = 'The same-origin policy blocks reading it, because the bank sent no CORS permission.'; }
        else if (!cookieSent) { res = 'The attacker reads a response, but without the cookie it is only the logged-out view'; why = 'SameSite withheld the cookie, so the response holds no private data.'; }
        else { res = 'The attacker reads the balance!'; why = 'The bank allowed evil.example through CORS and the cookie was sent. Never allow origins you do not trust.'; bad = true; }
      }
      q('[data-res]').textContent = res; q('[data-why]').textContent = why;
      q<HTMLElement>('[data-box]').style.setProperty('--c', bad ? 'var(--bad)' : 'var(--role-2)');
      q<HTMLElement>('[data-why]').style.color = bad ? 'var(--bad-text)' : '';
      log.unshift(`${kind === 'form' ? 'Hidden form' : kind === 'json' ? 'JSON fetch' : 'Read /balance'}: ${bad ? 'ATTACK SUCCEEDED' : 'stopped'}`); if (log.length > LOG) log.pop();
      rows.forEach((li, i) => { li.hidden = log[i] === undefined; if (log[i] !== undefined) { li.textContent = log[i]; li.style.color = log[i].includes('SUCCEEDED') ? 'var(--bad-text)' : ''; } });
    }
    root.querySelectorAll<HTMLElement>('[data-attack]').forEach((b) => b.addEventListener('click', () => attack(b.dataset.attack!)));
  });
</script>
<style is:global>
  .playground .cc-check { display: inline-flex; align-items: center; gap: 6px; }
</style>
