---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Every token is scored against every earlier token. Choose the length of the text, the number of heads and the model width, and see how the number of scores and the work to compute them grow.">
  <ol class="how">
    <li>Start with the defaults: <b>Sequence length</b> <b>1024</b>, <b>Heads</b> <b>8</b> and <b>Model width</b> <b>4096</b>. Each head has <b>1048576</b> scores per layer, computing them takes <b>4.29</b> billion multiply-adds, a text twice as long would need <b>4194304</b> scores, and storing one head's scores in 16-bit numbers would take <b>2</b> MiB. Each head works on a slice of <b>512</b>.</li>
    <li>Set <b>Sequence length</b> to <b>32768</b>: <b>1073741824</b> scores per head, <b>4.40</b> trillion multiply-adds, and <b>2</b> GiB for one head's scores if they were stored in full. A text 32 times longer needs 1024 times more work.</li>
    <li>Set <b>Heads</b> to <b>32</b>: each head's slice shrinks to <b>128</b>, and the multiply-adds for the scores stay at <b>4.40</b> trillion. More heads split the same work, they do not add to it.</li>
  </ol>
  <div class="pg att" data-att>
    <div class="pg-row">
      <label>Sequence length <select class="pg-in" data-n><option value="128">128</option><option value="512">512</option><option value="1024" selected>1024</option><option value="4096">4096</option><option value="16384">16384</option><option value="32768">32768</option></select></label>
      <label>Heads <select class="pg-in" data-h><option value="1">1</option><option value="2">2</option><option value="4">4</option><option value="8" selected>8</option><option value="16">16</option><option value="32">32</option></select></label>
      <label>Model width <select class="pg-in" data-w><option value="1024">1024</option><option value="2048">2048</option><option value="4096" selected>4096</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Scores per head, per layer</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Multiply-adds for the scores, per layer</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Scores if the text were twice as long</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>One head's scores in 16-bit numbers</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // Scores = n x n per head. Multiply-adds for QK^T in one layer = n x n x width (each of h heads uses width / h). 16-bit numbers = 2 bytes.
  type Tone = 'good' | 'bad' | 'mid';
  const trim = (n: number) => String(Number(n.toFixed(2)));
  const work = (x: number) => (x >= 1e12 ? `${(x / 1e12).toFixed(2)} trillion` : `${(x / 1e9).toFixed(2)} billion`);
  const bytes = (b: number) => (b >= 2 ** 30 ? `${trim(b / 2 ** 30)} GiB` : b >= 2 ** 20 ? `${trim(b / 2 ** 20)} MiB` : `${trim(b / 2 ** 10)} KiB`);
  document.querySelectorAll<HTMLElement>('[data-att]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const n = Number(q<HTMLSelectElement>('[data-n]').value), h = Number(q<HTMLSelectElement>('[data-h]').value), w = Number(q<HTMLSelectElement>('[data-w]').value);
      const scores = n * n, flops = n * n * w, twice = (2 * n) * (2 * n), mem = scores * 2;
      setBox(1, String(scores), `${n} tokens, each scored against every earlier one (the causal mask removes about half of the pairs)`, n >= 16384 ? 'bad' : 'mid');
      setBox(2, work(flops), `${h} heads, each working on a slice of ${w / h}; the total does not depend on the number of heads`, n >= 16384 ? 'bad' : 'mid');
      setBox(3, String(twice), 'doubling the length gives four times the scores', 'mid');
      setBox(4, bytes(mem), 'per head, if the matrix were kept in full; optimised kernels compute it in pieces and avoid that', mem >= 2 ** 30 ? 'bad' : 'mid');
      q('[data-verdict]').textContent = 'Attention cost grows with the square of the length. That is why long prompts are slow and expensive, and why the context window is a limit to design around.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
