---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Step through it" hint="A coordinator runs a transaction across three services. Pick a scenario and step through the protocol.">
  <ol class="how">
    <li>Start with <b>Everyone votes yes</b> and press <b>Next</b> through all steps: prepare, votes, decision, commit.</li>
    <li>Try <b>One participant votes no</b>: the coordinator aborts everywhere, and the two that had prepared roll back.</li>
    <li>Try <b>Coordinator crashes after the votes</b>: every participant has voted yes, so none can decide alone and all <b>stay locked</b>. Compare with <b>A participant crashes</b>, which recovers by asking the coordinator.</li>
  </ol>
  <div class="pg tp" data-tp>
    <div class="pg-row">
      <label>Scenario <select class="pg-in" data-scenario>
        <option value="yes" selected>Everyone votes yes</option>
        <option value="no">One participant votes no</option>
        <option value="ccrash">Coordinator crashes after the votes</option>
        <option value="pcrash">A participant crashes after voting yes</option>
      </select></label>
      <button class="btn" type="button" data-act="prev" aria-disabled="true">Back</button>
      <button class="btn pg-primary" type="button" data-act="next">Next</button>
      <span class="pg-mono" data-count></span>
    </div>
    <p class="pg-out" data-text aria-live="polite"></p>
    <div class="pg-grid" data-cards></div>
  </div>
</PlaygroundShell>
<script>
  type Frame = { text: string; coord: string; parts: { s: string; lock: boolean; bad?: boolean }[]; bad?: boolean };
  const names = ['Orders service', 'Payment service', 'Inventory service'];
  const P = (s: string, lock = false, bad = false) => ({ s, lock, bad });
  function frames(sc: string): Frame[] {
    const f: Frame[] = [
      { text: 'The coordinator starts transaction 77, which touches three services.', coord: 'transaction started', parts: [P('idle'), P('idle'), P('idle')] },
      { text: 'Phase 1: the coordinator sends "prepare" to every participant.', coord: 'waiting for votes', parts: [P('preparing'), P('preparing'), P('preparing')] },
    ];
    if (sc === 'no') {
      f.push({ text: 'Orders and Payment do the work, lock the data and vote YES. Inventory cannot reserve the stock and votes NO.', coord: 'collected votes: yes, yes, NO', parts: [P('prepared', true), P('prepared', true), P('voted no, aborted', false, true)] });
      f.push({ text: 'One NO is enough: the coordinator logs ABORT.', coord: 'decision logged: ABORT', parts: [P('prepared', true), P('prepared', true), P('aborted')] });
      f.push({ text: 'Phase 2: the coordinator tells everyone to abort. Orders and Payment roll back and release their locks. Nothing happened anywhere.', coord: 'transaction aborted', parts: [P('rolled back'), P('rolled back'), P('aborted')] });
      return f;
    }
    f.push({ text: 'All three do the work, write it to durable storage, lock the data and vote YES. Each YES is a binding promise.', coord: 'collected votes: yes, yes, yes', parts: [P('prepared', true), P('prepared', true), P('prepared', true)] });
    f.push({ text: sc === 'ccrash' ? 'The coordinator logs COMMIT, and then crashes before telling anyone.' : 'Every vote was yes, so the coordinator logs COMMIT. The transaction is now decided.', coord: sc === 'ccrash' ? 'logged COMMIT, then CRASHED' : 'decision logged: COMMIT', parts: [P('prepared', true), P('prepared', true), P('prepared', true)], bad: sc === 'ccrash' });
    if (sc === 'ccrash') {
      f.push({ text: 'Every participant promised to commit, so none can abort on its own, and none knows the decision. They wait with their locks held, and every other transaction touching this data is stuck. This is the blocking problem. Only the coordinator coming back resolves it.', coord: 'DOWN', parts: [P('BLOCKED, locks held', true, true), P('BLOCKED, locks held', true, true), P('BLOCKED, locks held', true, true)], bad: true });
      return f;
    }
    if (sc === 'pcrash') {
      f.push({ text: 'Phase 2: the coordinator sends commit. Orders and Inventory commit. Payment crashed after voting yes and does not answer.', coord: 'waiting for the Payment acknowledgement', parts: [P('committed'), P('DOWN', true, true), P('committed')] });
      f.push({ text: 'Payment restarts and reads its own durable log: it had voted yes but never saw the decision. It asks the coordinator, which answers COMMIT, so Payment commits and releases its locks. The promise it logged made recovery safe.', coord: 'transaction committed', parts: [P('committed'), P('committed'), P('committed')] });
      return f;
    }
    f.push({ text: 'Phase 2: the coordinator tells everyone to commit. They apply the change, release their locks and acknowledge.', coord: 'transaction committed', parts: [P('committed'), P('committed'), P('committed')] });
    return f;
  }
  document.querySelectorAll<HTMLElement>('[data-tp]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const cards = ['Coordinator', ...names].map((n) => { const b = document.createElement('div'); b.className = 'pg-box'; b.innerHTML = '<h3></h3><span class="pg-mono"></span><span class="pg-note"></span>'; b.querySelector('h3')!.textContent = n; q('[data-cards]').appendChild(b); return { b, a: b.querySelector<HTMLElement>('.pg-mono')!, n: b.querySelector<HTMLElement>('.pg-note')! }; });
    let list = frames('yes'); let i = 0;
    function draw() {
      const fr = list[i]; q('[data-text]').textContent = fr.text; q('[data-text]').classList.toggle('bad', !!fr.bad);
      q('[data-count]').textContent = `Step ${i + 1} of ${list.length}`;
      cards[0].a.textContent = fr.coord; cards[0].b.style.setProperty('--c', fr.bad ? 'var(--bad)' : 'var(--role-1)'); cards[0].n.textContent = '';
      fr.parts.forEach((p, k) => { const c = cards[k + 1]; c.a.textContent = p.s; c.n.textContent = p.lock ? 'locks held on its data' : 'no locks held'; c.b.style.setProperty('--c', p.bad ? 'var(--bad)' : p.s.startsWith('committed') ? 'var(--role-2)' : 'var(--role-3)'); });
      q('[data-act="prev"]').setAttribute('aria-disabled', String(i === 0)); q('[data-act="next"]').setAttribute('aria-disabled', String(i === list.length - 1));
    }
    q('[data-act="prev"]').addEventListener('click', () => { if (i > 0) { i--; draw(); } });
    q('[data-act="next"]').addEventListener('click', () => { if (i < list.length - 1) { i++; draw(); } });
    q('[data-scenario]').addEventListener('change', () => { list = frames(q<HTMLSelectElement>('[data-scenario]').value); i = 0; draw(); });
    draw();
  });
</script>
