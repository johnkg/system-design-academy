---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it" hint="Choose where the data is encrypted, and see which attackers can still read a private note.">
  <ol class="how">
    <li>With nothing ticked, every attacker reads the note. Tick <b>In transit (TLS)</b> and the <b>Wi-Fi sniffer</b> is stopped, and nobody else.</li>
    <li>Add <b>At rest</b>: a <b>stolen backup</b> is now useless, but an attacker who controls the running server (and so can use its keys) still reads everything.</li>
    <li>Only <b>End to end</b> stops the server-side attackers, because the server never holds a key. Notice the trade-off listed below the table.</li>
  </ol>
  <div class="pg enc" data-enc>
    <div class="pg-row">
      <label class="enc-check"><input type="checkbox" data-transit /> In transit (TLS)</label>
      <label class="enc-check"><input type="checkbox" data-rest /> At rest (disk or database encryption, keys held by the server)</label>
      <label class="enc-check"><input type="checkbox" data-e2e /> End to end (only the users hold keys)</label>
    </div>
    <div class="tablewrap">
      <table class="enc-table">
        <caption class="sr">Which attackers can read the note</caption>
        <thead><tr><th scope="col">Attacker</th><th scope="col">Can read the note?</th></tr></thead>
        <tbody data-rows></tbody>
      </table>
    </div>
    <p class="pg-out" data-cost aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  const attackers = [
    { name: 'Eavesdropper on café Wi-Fi', open: (t: boolean, r: boolean, e: boolean) => !t && !e },
    { name: 'Thief with a stolen disk or backup', open: (t: boolean, r: boolean, e: boolean) => !r && !e },
    { name: 'Hacker who controls the running server', open: (_t: boolean, _r: boolean, e: boolean) => !e },
    { name: 'Database administrator', open: (_t: boolean, _r: boolean, e: boolean) => !e },
    { name: 'The service operator itself (or a court order to it)', open: (_t: boolean, _r: boolean, e: boolean) => !e },
  ];
  document.querySelectorAll<HTMLElement>('[data-enc]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const on = (s: string) => q<HTMLInputElement>(s).checked;
    const rows = attackers.map((a) => { const tr = document.createElement('tr'); tr.innerHTML = '<th scope="row"></th><td></td>'; tr.querySelector('th')!.textContent = a.name; q('[data-rows]').appendChild(tr); return tr.querySelector('td')!; });
    function draw() {
      const t = on('[data-transit]'); const r = on('[data-rest]'); const e = on('[data-e2e]');
      attackers.forEach((a, i) => { const open = a.open(t, r, e); rows[i].textContent = open ? 'YES, readable' : 'No, protected'; rows[i].className = open ? 'enc-bad' : 'enc-ok'; });
      q('[data-cost]').textContent = e ? 'End to end costs: the server cannot search, index or process the notes, password reset cannot recover them, and a lost key means lost data.' : r || t ? 'Server-side encryption keeps the server useful, but whoever controls the server and its keys can still read the data.' : 'Nothing is encrypted: every attacker above reads the note.';
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .enc-check { display: inline-flex; align-items: center; gap: 6px; }
  .playground .tablewrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; margin: 10px 0; }
  .playground .enc-table { width: 100%; border-collapse: collapse; font-size: .92rem; min-width: 420px; }
  .playground .enc-table th, .playground .enc-table td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--border); }
  .playground .enc-table tbody tr:last-child > * { border-bottom: 0; }
  .playground .enc-table thead th { background: var(--surface-2); }
  .playground .enc-bad { color: var(--bad-text); font-weight: 600; }
  .playground .enc-ok { font-weight: 600; }
</style>
