---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Compare scanning every vector, an IVF index with about the square root of N lists, and IVF with product quantization (16 one-byte parts for each vector). Choose the number of vectors, their size and how many lists a query probes. Lists are assumed equal in size, and memory counts only the vectors or their codes, not centroids, vector ids or graph links.">
  <ol class="how">
    <li>Start with the defaults: <b>Vectors</b> <b>10 million</b>, <b>Dimensions</b> <b>128</b>, <b>Index</b> <b>Exact scan</b> and <b>Lists probed</b> <b>8</b>. Memory is <b>5.12</b> GB, each query computes <b>10000000</b> distances, and <b>100</b> percent of the vectors are examined.</li>
    <li>Set <b>Index</b> to <b>IVF</b>: memory is still <b>5.12</b> GB, but a query computes only <b>28462</b> distances and examines <b>0.253</b> percent of the vectors. The price is that the nearest neighbour can be missed.</li>
    <li>Set <b>Index</b> to <b>IVF + product quantization</b>: memory falls to <b>0.16</b> GB, 32 times less, with the same <b>28462</b> distance estimates.</li>
    <li>Set <b>Lists probed</b> to <b>1</b>: <b>6325</b> distances and <b>0.032</b> percent examined. It is faster and misses more. Set it back to <b>8</b>, and <b>Vectors</b> to <b>100 million</b>: memory is <b>1.6</b> GB, a query computes <b>90000</b> distances, and <b>0.08</b> percent of the vectors are examined.</li>
    <li>Set <b>Index</b> to <b>Exact scan</b> with <b>Dimensions</b> <b>768</b>: <b>307.2</b> GB for the 100 million vectors, which is why compression matters at this scale.</li>
  </ol>
  <div class="pg vix" data-vix>
    <div class="pg-row">
      <label>Vectors <select class="pg-in" data-n><option value="1e6">1 million</option><option value="1e7" selected>10 million</option><option value="1e8">100 million</option></select></label>
      <label>Dimensions <select class="pg-in" data-d><option value="128" selected>128</option><option value="768">768</option></select></label>
      <label>Index <select class="pg-in" data-index><option value="0" selected>Exact scan</option><option value="1">IVF</option><option value="2">IVF + product quantization</option></select></label>
      <label>Lists probed <input class="pg-in" type="range" min="1" max="64" step="1" value="8" data-p /> <b data-pv></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Memory for the vectors</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Distances computed per query</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Share of the vectors examined</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // C = round(sqrt(N)) lists of about N / C vectors. IVF per query: C centroid distances + nprobe x N / C. Product quantization: 16 bytes a vector.
  const PQ_BYTES = 16;
  type Tone = 'good' | 'bad' | 'mid';
  const trim = (n: number, digits = 2) => String(Number(n.toFixed(digits)));
  document.querySelectorAll<HTMLElement>('[data-vix]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const n = Number(q<HTMLSelectElement>('[data-n]').value), d = Number(q<HTMLSelectElement>('[data-d]').value);
      const index = Number(q<HTMLSelectElement>('[data-index]').value), probes = Number(q<HTMLInputElement>('[data-p]').value);
      q('[data-pv]').textContent = String(probes);
      const lists = Math.round(Math.sqrt(n));
      const bytes = index === 2 ? n * PQ_BYTES : n * d * 4;
      const distances = index === 0 ? n : Math.round(lists + probes * (n / lists));
      const share = index === 0 ? 100 : (100 * probes) / lists;
      setBox(1, `${trim(bytes / 1e9)} GB`, index === 2 ? `${PQ_BYTES} bytes a vector instead of ${d * 4}` : `${d} numbers x 4 bytes x ${n} vectors`, index === 2 ? 'good' : bytes > 50e9 ? 'bad' : 'mid');
      setBox(2, String(distances), index === 0 ? 'every vector is compared' : `${lists} centroids, then ${probes} lists of about ${Math.round(n / lists)}`, index === 0 ? 'bad' : 'good');
      setBox(3, `${trim(share, 3)} percent`, index === 0 ? 'always right, and slowest' : 'a true neighbour in an unprobed list is missed', index === 0 ? 'mid' : 'good');
      q('[data-verdict]').textContent = index === 0 ? 'Exact search is the baseline: always right, and cost grows with every vector.'
        : index === 1 ? 'IVF examines a small share of the vectors. More lists probed gives better recall and costs more work.'
        : 'Product quantization cuts memory a lot, and estimates distances from the codes, which loses some precision. Measure the recall.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
