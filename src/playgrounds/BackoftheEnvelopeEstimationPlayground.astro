---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Estimate it" hint="A photo app where each action uploads one photo. Set the users, the actions and the size, and watch every number come out of simple arithmetic, shown line by line.">
  <ol class="how">
    <li>Press <b>Reset</b>. 10 million daily users who each do 2 actions of 500 KB make 20,000,000 requests a day. Divided by the rounded 100,000 seconds, that is 200 requests per second on average, and the peak is 600 (3 times the average).</li>
    <li>Set <b>Seconds in a day</b> to Exact 86,400: the average becomes 231 per second instead of 200, a gap of 14%. Both answers lead to the same design, which is why rounding hard is safe.</li>
    <li>Press <b>Reset</b>, then set <b>Peak multiplier</b> to 10: the peak is 2,000 requests per second and the peak bandwidth is 8 Gbps, which is 80% of one 10 Gbps link.</li>
    <li>Press <b>Reset</b>, then set <b>Years of data kept</b> to 2: storage grows from 3.65 PB to 7.3 PB, because 10 TB a day is kept for twice as long.</li>
    <li>Press <b>Reset</b>, then set <b>Size of one action (KB)</b> to 5000, like a 5 MB photo: peak bandwidth jumps to 24 Gbps, which is 240% of one 10 Gbps link, so one link is not enough. Storage for a year grows to 36.5 PB.</li>
  </ol>
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Daily users (millions) <input class="pg-in" type="number" inputmode="numeric" min="1" max="1000" step="1" value="10" data-users /></label>
      <label>Actions per user per day <input class="pg-in" type="number" inputmode="numeric" min="1" max="100" step="1" value="2" data-actions /></label>
      <label>Size of one action (KB) <input class="pg-in" type="number" inputmode="numeric" min="1" max="10000" step="1" value="500" data-kb /></label>
    </div>
    <div class="pg-row">
      <label>Peak multiplier <input class="pg-in" type="number" inputmode="numeric" min="1" max="20" step="1" value="3" data-peak /></label>
      <label>Years of data kept <input class="pg-in" type="number" inputmode="numeric" min="1" max="10" step="1" value="1" data-years /></label>
      <label>Seconds in a day
        <select class="pg-in" data-day>
          <option value="100000" selected>Round number 100,000</option>
          <option value="86400">Exact 86,400</option>
        </select>
      </label>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <p class="pg-note" data-notes></p>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-1)"><h3>Requests per day</h3><span class="pg-mono est-big" data-perday></span><span class="pg-note" data-perdaynote></span></div>
      <div class="pg-box" style="--c: var(--role-2)"><h3>Average per second</h3><span class="pg-mono est-big" data-avg></span><span class="pg-note" data-avgnote></span></div>
      <div class="pg-box" style="--c: var(--role-4)"><h3>Peak per second</h3><span class="pg-mono est-big" data-peakqps></span><span class="pg-note" data-peaknote></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3 data-storetitle>Storage</h3><span class="pg-mono est-big" data-store></span><span class="pg-note" data-storenote></span></div>
      <div class="pg-box" style="--c: var(--role-6)"><h3>Peak bandwidth</h3><span class="pg-mono est-big" data-bw></span><span class="pg-note" data-bwnote></span></div>
      <div class="pg-box" data-linkbox style="--c: var(--role-5)"><h3>Share of one 10 Gbps link</h3><span class="pg-mono est-big" data-link></span><span class="pg-note" data-linknote></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <h3 class="est-h">The arithmetic, step by step</h3>
    <ol class="est-steps" data-steps aria-label="Arithmetic behind each result"></ol>
    <p class="pg-note">Model: every action sends and stores one item of the size you set, so reads (viewing photos) are not counted; estimate them separately. Units are decimal (1 KB is 1,000 bytes). The average is rounded to a whole number before the peak is worked out, as you would on paper. The sanity checks assume one 10 Gbps network link and 20 TB disks, and ignore copies, indexes and backups. Real traffic is never flat, so the peak multiplier is a guess you should state.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const KILO = 1000; const BITS_PER_BYTE = 8; const DAYS_PER_YEAR = 365; const MILLION = 1_000_000;
  const SECONDS_ROUNDED = 100_000; const SECONDS_EXACT = 86_400;
  const LINK_KBPS = 10_000_000; // one 10 Gbps link, in kilobits per second
  const DISK_KB = 20_000_000_000; // one 20 TB disk, in KB
  const BYTE_UNITS = ['KB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB'];
  const BIT_UNITS = ['Kbps', 'Mbps', 'Gbps', 'Tbps', 'Pbps', 'Ebps', 'Zbps'];
  const SIG_FIGS = 3; const SCI_FIGS = 2;
  const ROUNDING_GAP_PCT = Math.round(100 * (1 - SECONDS_EXACT / SECONDS_ROUNDED));
  const DEFAULTS = { users: '10', actions: '2', kb: '500', peak: '3', years: '1', day: String(SECONDS_ROUNDED) };

  const commas = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 2 });
  const sig = (n: number) => Number(n.toPrecision(SIG_FIGS));
  const whole = (n: number) => commas(Math.round(n));
  // Show a number in the unit that keeps it between 1 and 1,000.
  function unitFor(value: number, count: number) { let u = 0; while (u < count - 1 && value >= Math.pow(KILO, u + 1)) u++; return u; }
  const inUnit = (value: number, u: number, units: string[]) => `${commas(sig(value / Math.pow(KILO, u)))} ${units[u]}`;
  const human = (value: number, units: string[]) => inUnit(value, unitFor(value, units.length), units);
  function sci(n: number) {
    let e = Math.floor(Math.log10(n)); let m = Number((n / Math.pow(10, e)).toPrecision(SCI_FIGS));
    if (m >= 10) { m /= 10; e += 1; }
    return `${m} × 10^${e}`;
  }

  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const FIELDS = [
      { sel: '[data-users]', name: 'Daily users' }, { sel: '[data-actions]', name: 'Actions per user per day' },
      { sel: '[data-kb]', name: 'Size of one action' }, { sel: '[data-peak]', name: 'Peak multiplier' }, { sel: '[data-years]', name: 'Years of data kept' },
    ];
    let frame = 0;
    function read() {
      const vals: number[] = []; const notes: string[] = [];
      for (const f of FIELDS) {
        const el = q<HTMLInputElement>(f.sel); const raw = el.value.trim(); const n = Number(raw);
        if (raw === '' || !Number.isFinite(n)) return null;
        const min = Number(el.min); const max = Number(el.max);
        const v = Math.min(max, Math.max(min, Math.round(n)));
        if (v !== n) notes.push(`${f.name}: using ${commas(v)} (allowed range ${commas(min)} to ${commas(max)}, whole numbers).`);
        vals.push(v);
      }
      return { users: vals[0], actions: vals[1], kb: vals[2], peak: vals[3], years: vals[4], day: Number(q<HTMLSelectElement>('[data-day]').value), notes };
    }
    function draw() {
      frame = 0;
      const c = read(); const verdict = q('[data-verdict]');
      if (!c) { q('[data-notes]').textContent = 'Type a number in every box to see the estimate.'; return; }
      q('[data-notes]').textContent = c.notes.join(' ');
      const users = c.users * MILLION; const exact = c.day === SECONDS_EXACT; const dayText = commas(c.day);
      const perDay = users * c.actions;
      const avg = Math.round(perDay / c.day); const other = Math.round(perDay / (exact ? SECONDS_ROUNDED : SECONDS_EXACT));
      const peak = avg * c.peak;
      const dayKb = perDay * c.kb; const totalKb = dayKb * DAYS_PER_YEAR * c.years;
      const peakKbs = peak * c.kb; const peakKbps = peakKbs * BITS_PER_BYTE;
      const linkPct = Math.round((100 * peakKbps) / LINK_KBPS);
      const disks = Math.ceil(totalKb / DISK_KB);
      const yearsText = `${c.years} year${c.years === 1 ? '' : 's'}`;
      const dayU = unitFor(dayKb, BYTE_UNITS.length); const rateU = unitFor(peakKbs, BYTE_UNITS.length);
      const dayHuman = human(dayKb, BYTE_UNITS); const totalHuman = human(totalKb, BYTE_UNITS);
      const rateHuman = human(peakKbs, BYTE_UNITS); const bitsHuman = human(peakKbps, BIT_UNITS);
      const totalInDayUnit = inUnit(totalKb, dayU, BYTE_UNITS);

      q('[data-perday]').textContent = commas(perDay);
      q('[data-perdaynote]').textContent = `${commas(users)} users × ${commas(c.actions)} actions, about ${sci(perDay)}`;
      q('[data-avg]').textContent = commas(avg);
      q('[data-avgnote]').textContent = `${commas(perDay)} ÷ ${dayText} seconds`;
      q('[data-peakqps]').textContent = commas(peak);
      q('[data-peaknote]').textContent = `${commas(avg)} × ${commas(c.peak)} (peak multiplier)`;
      q('[data-storetitle]').textContent = `Storage for ${yearsText}`;
      q('[data-store]').textContent = totalHuman;
      q('[data-storenote]').textContent = `${dayHuman} a day × ${DAYS_PER_YEAR} days${c.years > 1 ? ` × ${c.years} years` : ''}`;
      q('[data-bw]').textContent = bitsHuman;
      q('[data-bwnote]').textContent = `${rateHuman}/s × ${BITS_PER_BYTE} bits per byte`;
      q('[data-link]').textContent = `${commas(linkPct)}%`;
      q('[data-linknote]').textContent = linkPct > 100 ? `more than one link: at least ${commas(Math.ceil(linkPct / 100))} needed` : 'one link is enough for the peak';
      q<HTMLElement>('[data-linkbox]').style.setProperty('--c', linkPct > 100 ? 'var(--bad)' : 'var(--role-5)');

      const lines = [
        `Requests per day: ${commas(users)} users × ${commas(c.actions)} actions = ${commas(perDay)} (about ${sci(perDay)}).`,
        `Average per second: ${commas(perDay)} ÷ ${dayText} seconds = ${commas(avg)}.`,
        `${exact ? 'With the round number 100,000' : 'With the exact 86,400'} seconds instead, the average would be ${commas(other)}, so the ${exact ? 'rounded answer is' : 'rounded answer above is'} ${ROUNDING_GAP_PCT}% lower than the exact one.`,
        `Peak per second: ${commas(avg)} × ${commas(c.peak)} = ${commas(peak)}.`,
        `Storage per day: ${commas(perDay)} requests × ${commas(c.kb)} KB = ${commas(dayKb)} KB = ${dayHuman}.`,
        `Storage for ${yearsText}: ${dayHuman} × ${DAYS_PER_YEAR} days${c.years > 1 ? ` × ${c.years} years` : ''} = ${totalInDayUnit}${totalInDayUnit === totalHuman ? '' : ` = ${totalHuman}`}.`,
        `Peak bandwidth in bytes: ${commas(peak)} per second × ${commas(c.kb)} KB = ${commas(peakKbs)} KB/s = ${rateHuman}/s.`,
        `Peak bandwidth in bits: ${rateHuman}/s × ${BITS_PER_BYTE} bits per byte = ${inUnit(peakKbps, rateU, BIT_UNITS)}${inUnit(peakKbps, rateU, BIT_UNITS) === bitsHuman ? '' : ` = ${bitsHuman}`}.`,
        `Check: ${bitsHuman} is ${commas(linkPct)}% of one 10 Gbps link.`,
        `Check: ${totalHuman} is about ${commas(disks)} disk${disks === 1 ? '' : 's'} of 20 TB, before any copies.`,
      ];
      const ol = q('[data-steps]'); ol.replaceChildren();
      for (const t of lines) { const li = document.createElement('li'); li.textContent = t; ol.appendChild(li); }

      verdict.classList.toggle('bad', linkPct > 100);
      verdict.textContent = `Average ${commas(avg)} requests per second, peak ${commas(peak)}. Storage for ${yearsText}: ${totalHuman}. Peak bandwidth: ${bitsHuman}, ${commas(linkPct)}% of one 10 Gbps link.${linkPct > 100 ? ' One link is not enough.' : ''}`;
    }
    const schedule = () => { if (!frame) frame = requestAnimationFrame(draw); };
    [...FIELDS.map((f) => f.sel), '[data-day]'].forEach((sel) => { q(sel).addEventListener('input', schedule); q(sel).addEventListener('change', schedule); });
    q('[data-reset]').addEventListener('click', () => {
      for (const [key, sel] of [['users', '[data-users]'], ['actions', '[data-actions]'], ['kb', '[data-kb]'], ['peak', '[data-peak]'], ['years', '[data-years]'], ['day', '[data-day]']] as const) q<HTMLInputElement>(sel).value = DEFAULTS[key];
      schedule();
    });
    draw();
  });
</script>
<style is:global>
  .playground .est input[type='number'] { width: 7em; max-width: 100%; }
  .playground .est-big { font-size: 1.15rem; font-weight: 600; color: var(--text); }
  .playground .est-h { margin: 16px 0 6px; font-size: 1rem; }
  .playground .est-steps { margin: 0 0 12px; padding-left: 1.6rem; display: grid; gap: 6px; font: .85rem var(--font-mono); overflow-wrap: anywhere; }
</style>
