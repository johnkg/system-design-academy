---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Publish orders to a topic with three subscribers. One of them is slow. Compare broadcast with a shared queue.">
  <ol class="how">
    <li>In <b>Pub/Sub</b> mode press <b>Publish 5 orders</b>. Every subscriber receives all of them, and the slow Analytics service only delays itself.</li>
    <li>Switch to <b>Queue</b> mode and publish again. Now each order goes to <b>just one</b> subscriber.</li>
    <li>Back in Pub/Sub, press <b>+ Add Fraud check</b>. The publisher is unchanged. Try it with and without <b>replay history</b>.</li>
  </ol>
  <div class="pg" data-ps>
    <div class="pg-row">
      <span role="group" aria-label="Delivery mode" class="pg-row">
        <button class="btn" type="button" data-mode="pubsub" aria-pressed="true">Pub/Sub (everyone gets a copy)</button>
        <button class="btn" type="button" data-mode="queue" aria-pressed="false">Queue (one subscriber per message)</button>
      </span>
      <label><input type="checkbox" data-replay /> Replay history for new subscribers</label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-pub>Publish 1 order</button>
      <button class="btn pg-primary" type="button" data-pub5>Publish 5 orders</button>
      <button class="btn" type="button" data-add>+ Add Fraud check</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="pg-grid" data-subs></div>
    <output class="pg-out" data-out aria-live="polite">Publish an order.</output>
  </div>
</PlaygroundShell>
<script>
  interface Sub { name: string; ms: number; backlog: number[]; busy: number | null; until: number; done: number[]; el?: { box: HTMLElement; body: HTMLElement } }
  document.querySelectorAll<HTMLElement>('[data-ps]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let subs: Sub[] = []; let log: number[] = []; let nextId = 1; let rr = 0; let mode: 'pubsub' | 'queue' = 'pubsub'; let hasFraud = false;
    let tickTimer: number | undefined; let onScreen = true;
    const mk = (name: string, ms: number): Sub => ({ name, ms, backlog: [], busy: null, until: 0, done: [] });
    const say = (t: string) => { q('[data-out]').textContent = t; };

    function build() {
      const g = q('[data-subs]'); g.innerHTML = '';
      subs.forEach((s) => { const box = document.createElement('div'); box.className = 'pg-box'; box.style.setProperty('--c', 'var(--role-3)'); box.innerHTML = '<h3></h3><span class="pg-mono"></span>'; box.querySelector('h3')!.textContent = `${s.name} (${s.ms >= 1000 ? 'slow' : 'fast'}: ${s.ms} ms each)`; g.appendChild(box); s.el = { box, body: box.querySelector('span')! }; });
    }
    function draw() {
      subs.forEach((s) => { if (s.el) s.el.body.textContent = `received ${s.done.length + s.backlog.length + (s.busy ? 1 : 0)} · done ${s.done.length} · waiting ${s.backlog.length}\nlast: ${s.done.length ? '#' + s.done[s.done.length - 1] : 'nothing yet'}`; });
    }
    function reset() { subs = [mk('Email', 400), mk('Inventory', 400), mk('Analytics', 1500)]; log = []; nextId = 1; rr = 0; hasFraud = false; q<HTMLElement>('[data-add]').setAttribute('aria-disabled', 'false'); build(); draw(); say('Publish an order.'); }
    function publish(n: number) {
      const t0 = performance.now();
      for (let i = 0; i < n; i++) { const id = nextId++; log.push(id); if (mode === 'pubsub') subs.forEach((s) => s.backlog.push(id)); else subs[rr++ % subs.length].backlog.push(id); }
      const ms = performance.now() - t0;
      say(`Published ${n} order${n > 1 ? 's' : ''} (#${nextId - n} to #${nextId - 1}). The publisher was done in ${ms < 1 ? '<1' : ms.toFixed(0)} ms and does not wait for any subscriber. ${mode === 'pubsub' ? 'Every subscriber got a copy.' : 'Each order went to one subscriber only.'}`);
      draw();
    }
    function tick() {
      const now = performance.now();
      subs.forEach((s) => { if (s.busy && now >= s.until) { s.done.push(s.busy); s.busy = null; } if (!s.busy && s.backlog.length) { s.busy = s.backlog.shift()!; s.until = now + s.ms; } });
      draw();
    }
    function clock() { window.clearInterval(tickTimer); tickTimer = undefined; if (onScreen && !document.hidden) tickTimer = window.setInterval(tick, 100); }
    q('[data-pub]').addEventListener('click', () => publish(1)); q('[data-pub5]').addEventListener('click', () => publish(5));
    q('[data-add]').addEventListener('click', (e) => {
      if (hasFraud) return; hasFraud = true; (e.currentTarget as HTMLElement).setAttribute('aria-disabled', 'true');
      const s = mk('Fraud check', 400); if (mode === 'pubsub' && q<HTMLInputElement>('[data-replay]').checked) s.backlog = [...log]; subs.push(s); build(); draw();
      say(`Fraud check subscribed. The publisher was not changed or redeployed.${s.backlog.length ? ` It replayed ${s.backlog.length} past event${s.backlog.length > 1 ? 's' : ''} from the retained log.` : ' It will only see events published from now on.'}`);
    });
    q('[data-reset]').addEventListener('click', reset);
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => { mode = b.dataset.mode as 'pubsub' | 'queue'; root.querySelectorAll('[data-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b))); reset(); }));
    new IntersectionObserver(([en]) => { onScreen = en.isIntersecting; clock(); }).observe(root);
    document.addEventListener('visibilitychange', clock);
    reset(); clock();
  });
</script>
