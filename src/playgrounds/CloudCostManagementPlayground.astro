---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="One web service, one day of traffic (between 3 and 16 servers' worth of work an hour), billed for a 30-day month. On demand is $0.20 per server-hour, a commitment is 40% off but paid every hour, and spot is 70% off with about 1 hour in 20 taken back and rerun on demand.">
  <ol class="how">
    <li>Start with the defaults: large servers, a fleet fixed for the peak, everything on demand and the test environment on all day. The bill is <b>$7,488</b> a month, and utilization is <b>23%</b>: only 225 of 960 paid server-hours a day do work.</li>
    <li>Set <b>Server size</b> to <b>Right-sized</b>: the same work for <b>$3,744</b>. Then set <b>Fleet</b> to <b>Autoscale to the load</b>: the quiet hours stop costing peak prices, the bill falls to <b>$2,598</b> and utilization rises to <b>77%</b>.</li>
    <li>Set <b>Commit to</b> to <b>4 servers</b> (the fleet never runs fewer), tick <b>Run the rest on spot</b> and set <b>Test environment</b> to <b>Off at night</b>: <b>$1,179</b> a month for the same traffic.</li>
    <li>Now over-commit: set <b>Commit to</b> to <b>20 servers</b>. The quiet hours are paid for again, the bill climbs to <b>$2,160</b> and utilization falls back to <b>46%</b>. Commit to the base, not to the peak.</li>
  </ol>
  <div class="pg cc" data-cc>
    <div class="pg-row">
      <label>Server size <select class="pg-in" data-size><option value="2" selected>Large (twice what it uses)</option><option value="1">Right-sized</option></select></label>
      <label>Fleet <select class="pg-in" data-fleet><option value="fixed" selected>Fixed for the peak</option><option value="auto">Autoscale to the load</option></select></label>
      <label>Commit to <select class="pg-in" data-commit><option value="0" selected>No commitment</option><option value="4">4 servers</option><option value="8">8 servers</option><option value="12">12 servers</option><option value="20">20 servers</option></select></label>
      <label><input type="checkbox" data-spot /> Run the rest on spot</label>
      <label>Test environment <select class="pg-in" data-test><option value="24" selected>On all day</option><option value="12">Off at night</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-billbox><h3>Monthly bill</h3><span class="pg-mono cc-big" data-bill></span><span class="pg-note" data-billnote></span></div>
      <div class="pg-box" data-utilbox><h3>Utilization</h3><span class="pg-mono cc-big" data-util></span><span class="pg-note" data-utilnote></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Where the money goes</h3>
      <div class="cc-parts" data-parts></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>One day: work needed against capacity paid for</h3>
      <div class="cc-chart" data-chart role="img" aria-label="For each hour of the day, the servers the load needs and the servers paid for"></div>
      <span class="pg-note">Each column is an hour, midnight on the left. Solid: servers the load needs. Outline: capacity paid for (a large server counts twice). The gap is money spent on idle servers.</span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const LOAD = [4, 3, 3, 3, 3, 4, 6, 9, 12, 14, 15, 16, 16, 15, 15, 14, 13, 12, 11, 10, 9, 7, 6, 5];
  const ON_DEMAND = 20, COMMITTED = 12, SPOT = 6, RECLAIM_EVERY = 20, TEST_SERVERS = 6, DAYS = 30;
  const headroom = (load: number) => Math.floor((load * 5 + 3) / 4);

  // The same model as the code samples. Cents per server-hour, integers throughout.
  function price(size: number, autoscale: boolean, commit: number, spot: boolean, testHours: number) {
    const peak = headroom(Math.max(...LOAD));
    let committed = 0, onDemand = 0, spotCost = 0, spotHours = 0, used = 0, paid = 0;
    const hours = LOAD.map((load) => {
      const run = autoscale ? headroom(load) : peak;
      committed += commit * COMMITTED * size;
      const extra = Math.max(0, run - commit);
      if (spot) { spotHours += extra; spotCost += extra * SPOT * size; } else onDemand += extra * ON_DEMAND * size;
      used += load;
      paid += Math.max(run, commit) * size;
      return { load, paid: Math.max(run, commit) * size };
    });
    const reclaimed = Math.floor(spotHours / RECLAIM_EVERY);
    onDemand += reclaimed * ON_DEMAND * size;
    const test = TEST_SERVERS * testHours * ON_DEMAND * size;
    const day = committed + onDemand + spotCost + test;
    return { month: day * DAYS, committed: committed * DAYS, onDemand: onDemand * DAYS, spot: spotCost * DAYS, test: test * DAYS, used, paid, hours, reclaimed };
  }
  const dollars = (cents: number) => `$${formatThousands(Math.floor(cents / 100))}${cents % 100 ? `.${String(cents % 100).padStart(2, '0')}` : ''}`;
  const START = price(2, false, 0, false, 24).month;

  document.querySelectorAll<HTMLElement>('[data-cc]').forEach((root) => {
    const q = query(root);
    const chart = q('[data-chart]');
    const MAX = 40; // tallest column, in right-sized servers (a fixed fleet of large servers)
    const cols = LOAD.map(() => {
      const c = document.createElement('span'); c.className = 'cc-col';
      const paid = document.createElement('span'); paid.className = 'cc-paid';
      const need = document.createElement('span'); need.className = 'cc-need';
      c.append(paid, need); chart.appendChild(c); return { c, paid, need };
    });
    function draw() {
      const size = Number(q<HTMLSelectElement>('[data-size]').value);
      const commit = Number(q<HTMLSelectElement>('[data-commit]').value);
      const p = price(size, q<HTMLSelectElement>('[data-fleet]').value === 'auto', commit, q<HTMLInputElement>('[data-spot]').checked, Number(q<HTMLSelectElement>('[data-test]').value));
      const util = Math.floor((p.used * 100) / p.paid);
      q('[data-bill]').textContent = dollars(p.month);
      q('[data-billnote]').textContent = p.month === START ? 'the starting point' : `${Math.round(((START - p.month) * 100) / START)}% less than the starting point, for the same traffic`;
      q<HTMLElement>('[data-billbox]').style.setProperty('--c', p.month <= 150000 ? 'var(--good)' : p.month <= 300000 ? 'var(--role-3)' : 'var(--bad)');
      q('[data-util]').textContent = `${util}%`;
      q('[data-utilnote]').textContent = `${p.used} of ${p.paid} paid server-hours a day do work`;
      q<HTMLElement>('[data-utilbox]').style.setProperty('--c', util >= 70 ? 'var(--good)' : util >= 40 ? 'var(--role-3)' : 'var(--bad)');
      const parts: [string, number, string][] = [
        ['Committed', p.committed, commit ? `${commit} servers paid every hour at 40% off` : 'no commitment'],
        ['On demand', p.onDemand, p.reclaimed ? `includes ${p.reclaimed} reclaimed spot hours a day rerun on demand` : 'full price'],
        ['Spot', p.spot, p.spot ? '70% off, can be taken back' : 'not used'],
        ['Test environment', p.test, `${TEST_SERVERS} servers, ${Number(q<HTMLSelectElement>('[data-test]').value)} hours a day`],
      ];
      const box = q('[data-parts]'); box.textContent = '';
      for (const [name, cents, note] of parts) {
        const row = document.createElement('div'); row.className = 'cc-part';
        const bar = document.createElement('span'); bar.className = 'cc-bar'; bar.style.width = `${(cents * 100) / START}%`; bar.hidden = cents === 0;
        const label = document.createElement('span'); label.className = 'cc-label'; label.textContent = `${name}: ${dollars(cents)}`;
        const n = document.createElement('span'); n.className = 'pg-note'; n.textContent = note;
        row.append(label, bar, n); box.appendChild(row);
      }
      p.hours.forEach((h, i) => {
        cols[i].paid.style.height = `${(h.paid * 100) / MAX}%`;
        cols[i].need.style.height = `${(h.load * 100) / MAX}%`;
        cols[i].c.title = `${String(i).padStart(2, '0')}:00, needs ${h.load}, pays for ${h.paid}`;
      });
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .cc-big { font-size: 1.6rem; }
  .playground .cc-parts { display: grid; gap: 8px; }
  .playground .cc-part { display: grid; grid-template-columns: minmax(10rem, max-content) 1fr; gap: 2px 10px; align-items: center; }
  .playground .cc-part .pg-note { grid-column: 1 / -1; }
  .playground .cc-label { font: .85rem var(--font-mono); }
  .playground .cc-bar { display: block; height: 10px; border-radius: 5px; background: var(--accent); min-width: 2px; max-width: 100%; }
  .playground .cc-chart { display: grid; grid-template-columns: repeat(24, 1fr); gap: 2px; height: 140px; align-items: end; }
  .playground .cc-col { position: relative; height: 100%; }
  .playground .cc-paid, .playground .cc-need { position: absolute; left: 0; right: 0; bottom: 0; border-radius: 2px 2px 0 0; }
  .playground .cc-paid { border: 1px solid var(--role-3); background: color-mix(in srgb, var(--role-3) 12%, transparent); }
  .playground .cc-need { background: var(--role-2); }
  @media (max-width: 520px) { .playground .cc-part { grid-template-columns: 1fr; } }
</style>
