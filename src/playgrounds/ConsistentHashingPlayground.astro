---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="240 keys sit on a ring. Add or remove servers and see which keys change owner.">
  <ol class="how">
    <li>Each dot is a key, coloured by the server that owns it. The ticks on the ring are the servers' positions.</li>
    <li>Press <b>Add server</b>. Only the highlighted dots move, and the message compares with <b>hash mod N</b>.</li>
    <li>Set <b>virtual nodes</b> to 1, then 50. Watch the balance bars even out.</li>
  </ol>
  <div class="pg" data-ring>
    <div class="pg-row">
      <span class="pg-row" role="group" aria-label="Virtual nodes per server" data-vn></span>
      <button class="btn pg-primary" type="button" data-add>Add server</button>
      <button class="btn" type="button" data-remove>Remove server</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="ch-layout">
      <svg class="ch-svg" viewBox="0 0 320 320" role="img" aria-label="Hash ring with servers and keys" data-svg></svg>
      <div class="ch-bars" data-bars></div>
    </div>
    <output class="pg-out" data-out aria-live="polite">Three servers, 10 virtual nodes each.</output>
  </div>
</PlaygroundShell>
<script>
  // FNV-1a over the characters, then the murmur3 finalizer
  function hash32(text: string) {
    let h = 2166136261;
    for (const ch of text) { h ^= ch.charCodeAt(0); h = Math.imul(h, 16777619) >>> 0; }
    h ^= h >>> 16; h = Math.imul(h, 0x85ebca6b) >>> 0; h ^= h >>> 13; h = Math.imul(h, 0xc2b2ae35) >>> 0; h ^= h >>> 16;
    return h >>> 0;
  }
  const NAMES = ['A', 'B', 'C', 'D', 'E', 'F'];
  const KEY_COUNT = 240; const DEFAULT_VNODES = 10; const MAX_NODES = NAMES.length; const UINT32 = 4294967296;
  const RING = { c: 160, tickIn: 112, tickOut: 128, keyR: 98 }; // svg centre and radii
  const KEYS = Array.from({ length: KEY_COUNT }, (_, i) => `key-${i}`);
  const TWO_PI = Math.PI * 2;
  const angle = (pos: number) => (pos / UINT32) * TWO_PI - Math.PI / 2;
  const SVG = 'http://www.w3.org/2000/svg';

  document.querySelectorAll<HTMLElement>('[data-ring]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let nodes = ['A', 'B', 'C']; let vnodes = DEFAULT_VNODES;
    let owners = new Map<string, string>();

    function build(list: string[], vn: number) {
      const pts: { pos: number; node: string }[] = [];
      list.forEach((n) => { for (let i = 0; i < vn; i++) pts.push({ pos: hash32(`${n}#${i}`), node: n }); });
      pts.sort((a, b) => a.pos - b.pos);
      const nodeFor = (key: string) => { const h = hash32(key); let lo = 0, hi = pts.length; while (lo < hi) { const mid = (lo + hi) >> 1; if (pts[mid].pos < h) lo = mid + 1; else hi = mid; } return pts[lo % pts.length].node; };
      return { pts, nodeFor };
    }
    const color = (n: string) => `var(--role-${NAMES.indexOf(n) + 1})`;
    function el(tag: string, attrs: Record<string, string>) { const e = document.createElementNS(SVG, tag); Object.entries(attrs).forEach(([k, v]) => e.setAttribute(k, v)); return e; }

    function draw(msg: string, moved = new Set<string>()) {
      const { pts, nodeFor } = build(nodes, vnodes);
      const svg = q<SVGSVGElement>('[data-svg]'); svg.replaceChildren();
      svg.appendChild(el('circle', { cx: '160', cy: '160', r: '120', fill: 'none', style: 'stroke: var(--border)', 'stroke-width': '2' }));
      pts.forEach((p) => { const a = angle(p.pos); svg.appendChild(el('line', { x1: String(RING.c + Math.cos(a) * RING.tickIn), y1: String(RING.c + Math.sin(a) * RING.tickIn), x2: String(RING.c + Math.cos(a) * RING.tickOut), y2: String(RING.c + Math.sin(a) * RING.tickOut), style: `stroke: ${color(p.node)}`, 'stroke-width': '3' })); });
      const next = new Map<string, string>(); const counts: Record<string, number> = Object.fromEntries(nodes.map((n) => [n, 0]));
      KEYS.forEach((k) => {
        const o = nodeFor(k); next.set(k, o); counts[o]++;
        const a = angle(hash32(k)); const m = moved.has(k);
        svg.appendChild(el('circle', { cx: String(RING.c + Math.cos(a) * RING.keyR), cy: String(RING.c + Math.sin(a) * RING.keyR), r: m ? '4' : '2.4', style: `fill: ${color(o)}${m ? '; stroke: var(--text); stroke-width: 1.5' : ''}` }));
      });
      owners = next;
      const bars = q('[data-bars]'); bars.innerHTML = '';
      const max = Math.max(...Object.values(counts), 1);
      nodes.forEach((n) => { const r = document.createElement('div'); r.className = 'ch-bar'; r.innerHTML = `<span>Server ${n}</span><div class="ch-track"><div class="ch-fill" style="width:${(counts[n] / max) * 100}%; background:${color(n)}"></div></div><b>${counts[n]}</b>`; bars.appendChild(r); });
      q('[data-out]').textContent = msg;
      q('[data-add]').setAttribute('aria-disabled', String(nodes.length >= MAX_NODES)); q('[data-remove]').setAttribute('aria-disabled', String(nodes.length <= 1));
    }
    function change(newNodes: string[], newV: number, what: string) {
      const old = owners; const oldN = nodes.length;
      const { nodeFor } = build(newNodes, newV);
      const moved = new Set<string>(); KEYS.forEach((k) => { if (old.get(k) !== nodeFor(k)) moved.add(k); });
      const modMoved = KEYS.filter((k) => hash32(k) % oldN !== hash32(k) % newNodes.length).length;
      nodes = newNodes; vnodes = newV;
      draw(`${what}: ${moved.size} of ${KEYS.length} keys (${Math.round((moved.size / KEYS.length) * 100)}%) changed owner. Hash mod N would have moved ${modMoved} (${Math.round((modMoved / KEYS.length) * 100)}%).`, moved);
    }
    q('[data-add]').addEventListener('click', () => { if (nodes.length < MAX_NODES) change([...nodes, NAMES[nodes.length]], vnodes, `Added server ${NAMES[nodes.length]}`); });
    q('[data-remove]').addEventListener('click', () => { if (nodes.length > 1) change(nodes.slice(0, -1), vnodes, `Removed server ${nodes[nodes.length - 1]}`); });
    q('[data-reset]').addEventListener('click', () => { nodes = ['A', 'B', 'C']; vnodes = DEFAULT_VNODES; owners = new Map(); sync(); draw(`Three servers, ${DEFAULT_VNODES} virtual nodes each.`); });
    const vn = q('[data-vn]');
    [1, 10, 50].forEach((v) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.dataset.v = String(v); b.textContent = `${v} virtual node${v > 1 ? 's' : ''}`; b.addEventListener('click', () => { if (v === vnodes) return; const t = nodes; change(t, v, `Switched to ${v} virtual node${v > 1 ? 's' : ''} per server`); sync(); }); vn.appendChild(b); });
    function sync() { vn.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(Number((b as HTMLElement).dataset.v) === vnodes))); }
    owners = new Map(KEYS.map((k) => [k, build(nodes, vnodes).nodeFor(k)])); sync(); draw('Three servers, 10 virtual nodes each.');
  });
</script>
<style is:global>
  .playground .ch-layout { display: grid; gap: 14px; grid-template-columns: minmax(220px, 320px) 1fr; align-items: center; }
  .playground .ch-svg { width: 100%; height: auto; }
  .playground .ch-bars { display: grid; gap: 8px; }
  .playground .ch-bar { display: grid; grid-template-columns: 76px 1fr 38px; gap: 8px; align-items: center; font-size: .85rem; }
  .playground .ch-track { height: 12px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .playground .ch-fill { height: 100%; border-radius: 99px; transition: width .3s; }
  @media (max-width: 560px) { .playground .ch-layout { grid-template-columns: 1fr; } }
</style>
