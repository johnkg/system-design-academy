---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Open a gallery of six photos, with and without a proxy.">
  <ol class="how">
    <li>Pick <b>Eager</b> or <b>With Proxy</b>, then press <b>Open gallery</b>. Count how many photos load.</li>
    <li>Click a photo to <b>display</b> it. With the proxy, the first click loads it and later clicks are instant.</li>
  </ol>
  <div class="pg" data-proxy>
    <div class="pg-row" role="group" aria-label="Mode">
      <button class="btn" type="button" data-mode="eager" aria-pressed="false">Eager (no proxy)</button>
      <button class="btn" type="button" data-mode="proxy" aria-pressed="true">With Proxy</button>
      <button class="btn pg-primary" type="button" data-open>Open gallery</button>
    </div>
    <div class="pg-grid" data-grid></div>
    <p class="pg-mono" data-stats></p>
    <ol class="pg-log" data-log></ol>
  </div>
</PlaygroundShell>
<script>
  const wait = (ms: number) => new Promise((r) => setTimeout(r, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : ms));
  document.querySelectorAll<HTMLElement>('[data-proxy]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const files = ['beach.jpg', 'city.jpg', 'forest.jpg', 'lake.jpg', 'peak.jpg', 'dunes.jpg'];
    let eager = false; let loaded = new Set<string>(); let shown = new Set<string>();
    const log = (t: string) => { const li = document.createElement('li'); li.textContent = t; q('[data-log]').prepend(li); };
    class RealImage { static async create(file: string) { log(`Loading ${file} from disk (slow)...`); await wait(700); loaded.add(file); render(); return new RealImage(); } display() {} }
    class ImageProxy { real: RealImage | null = null; constructor(public file: string) {}
      async display() { if (!this.real) this.real = await RealImage.create(this.file); shown.add(this.file); log(`Displaying ${this.file}`); render(); } }
    let items: (RealImage | ImageProxy)[] = [];
    function render() {
      const g = q('[data-grid]'); g.innerHTML = '';
      files.forEach((f, i) => { const open = items.length > 0; const b = document.createElement('button'); b.type = 'button'; b.className = 'btn pg-box ' + (loaded.has(f) ? '' : 'off'); b.disabled = !open; b.style.setProperty('--c', 'var(--role-3)');
        b.innerHTML = `<h3>${f}</h3><span class="pg-note">${loaded.has(f) ? (shown.has(f) ? 'loaded · displayed' : 'loaded in memory') : open ? 'proxy only (not loaded)' : '—'}</span>`;
        b.addEventListener('click', () => { const it = items[i]; if (it instanceof ImageProxy) it.display(); else { shown.add(f); log(`Displaying ${f}`); render(); } }); g.appendChild(b); });
      q('[data-stats]').textContent = items.length ? `Loaded from disk: ${loaded.size} of ${files.length}` : 'Gallery closed.';
    }
    q('[data-open]').addEventListener('click', async () => {
      loaded = new Set(); shown = new Set(); q('[data-log]').innerHTML = ''; items = [];
      if (eager) { for (const f of files) { log(`Loading ${f} from disk (slow)...`); loaded.add(f); } items = files.map(() => new RealImage()); log('Gallery ready: everything loaded up front.'); }
      else { items = files.map((f) => new ImageProxy(f)); log('Gallery ready instantly: only proxies exist.'); }
      render();
    });
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => { eager = b.dataset.mode === 'eager'; root.querySelectorAll('[data-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b))); items = []; loaded = new Set(); shown = new Set(); q('[data-log]').innerHTML = ''; render(); }));
    render();
  });
</script>
