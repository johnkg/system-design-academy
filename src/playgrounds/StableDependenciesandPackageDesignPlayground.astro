---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="The same product described as packages and dependencies, in three designs. Pick a design and a change, and see how many packages must be rebuilt and retested, which are stuck in a cycle, and how often the whole graph is rebuilt in a quarter from the change counts shown in the list below.">
  <ol class="how">
    <li>Start with <b>Design</b> at <b>Tangled: a utils package and a cycle</b> and <b>Change to</b> at <b>The shared helper package</b>: the change to utils rebuilds and retests <b>7 of 7</b> packages (instability <b>16</b>), <b>4</b> packages sit in a cycle, <b>2</b> edges depend on something less stable, and the graph costs <b>241</b> package builds a quarter.</li>
    <li>Set <b>Design</b> to <b>Layered: acyclic, small stable bases</b>: the helper is now money with instability <b>0</b>, the cycle is gone (0), and builds fall to <b>117</b> a quarter. Set <b>Change to</b> to <b>Order rules</b>: only <b>3 of 8</b> packages are affected.</li>
    <li>Set <b>Design</b> to <b>Over-split: an api and an impl package for everything</b> and <b>Change to</b> to <b>Customer rules</b>: only <b>2 of 13</b> packages are rebuilt, but a feature that adds a customer field edits <b>5</b> packages instead of 3, and builds per quarter are <b>113</b>, barely better than 117.</li>
  </ol>
  <div class="pg spd" data-spd>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design>
        <option value="0" selected>Tangled: a utils package and a cycle</option>
        <option value="1">Layered: acyclic, small stable bases</option>
        <option value="2">Over-split: an api and an impl package for everything</option>
      </select></label>
      <label>Change to <select class="pg-in" data-change>
        <option value="0" selected>The shared helper package</option>
        <option value="1">Customer rules</option>
        <option value="2">Order rules</option>
        <option value="3">The customer contract</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Rebuilt and retested</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Packages in a cycle</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Edges to something less stable</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Package builds per quarter</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Instability of the changed package</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Packages edited by a cross-layer feature</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="Every package: instability, dependents, dependencies, changes per quarter"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  // The same model as the code samples: each design is data, and everything shown is computed from it.
  interface Design { name: string; changes: Record<string, number>; edges: string[][]; feature: string[]; roles: Record<string, string> }
  const D = (name: string, changes: Record<string, number>, edges: string[], feature: string[], roles: Record<string, string>): Design => ({ name, changes, edges: edges.map((e) => e.split('>')), feature, roles });
  const DESIGNS: Design[] = [
    D('Tangled: a utils package and a cycle',
      { web: 10, orders: 8, billing: 6, customers: 5, notifications: 3, reports: 4, utils: 12 },
      ['web>orders', 'web>billing', 'web>reports', 'web>notifications', 'orders>billing', 'billing>customers', 'customers>orders', 'orders>utils',
       'billing>utils', 'customers>utils', 'notifications>utils', 'notifications>customers', 'reports>orders', 'reports>utils', 'utils>customers'],
      ['customers', 'billing', 'web'], { helper: 'utils', customerRules: 'customers', orderRules: 'orders', customerContract: 'customers' }),
    D('Layered: acyclic, small stable bases',
      { web: 10, orders: 8, billing: 6, customers: 5, notifications: 3, reports: 4, money: 1, text: 2 },
      ['web>orders', 'web>billing', 'web>reports', 'web>notifications', 'orders>billing', 'orders>customers', 'billing>customers', 'billing>money',
       'reports>orders', 'reports>text', 'notifications>customers', 'notifications>text', 'customers>money'],
      ['customers', 'billing', 'web'], { helper: 'money', customerRules: 'customers', orderRules: 'orders', customerContract: 'customers' }),
    D('Over-split: an api and an impl package for everything',
      { web: 10, 'orders-api': 1, 'orders-impl': 8, 'billing-api': 1, 'billing-impl': 6, 'customers-api': 1, 'customers-impl': 5,
        'notifications-api': 1, 'notifications-impl': 3, reports: 4, money: 1, text: 2, app: 3 },
      ['web>orders-api', 'web>billing-api', 'web>reports', 'web>notifications-api', 'orders-impl>orders-api', 'orders-impl>billing-api',
       'orders-impl>customers-api', 'billing-impl>billing-api', 'billing-impl>customers-api', 'billing-impl>money', 'customers-impl>customers-api',
       'customers-impl>money', 'notifications-impl>notifications-api', 'notifications-impl>customers-api', 'notifications-impl>text',
       'reports>orders-api', 'reports>text', 'app>web', 'app>orders-impl', 'app>billing-impl', 'app>customers-impl', 'app>notifications-impl'],
      ['customers-api', 'customers-impl', 'billing-api', 'billing-impl', 'web'], { helper: 'money', customerRules: 'customers-impl', orderRules: 'orders-impl', customerContract: 'customers-api' }),
  ];
  const KEYS = ['helper', 'customerRules', 'orderRules', 'customerContract'];

  function reach(edges: string[][], start: string): Set<string> {
    const seen = new Set<string>(); const queue = [start];
    while (queue.length) {
      const cur = queue.shift()!;
      for (const [a, b] of edges) if (a === cur && !seen.has(b)) { seen.add(b); queue.push(b); }
    }
    return seen;
  }
  function rebuildSet(d: Design, p: string): Set<string> {
    const out = new Set([p]);
    for (const q of Object.keys(d.changes)) if (reach(d.edges, q).has(p)) out.add(q);
    return out;
  }
  const inCycle = (d: Design) => Object.keys(d.changes).filter((p) => reach(d.edges, p).has(p));
  const counts = (d: Design, p: string) => ({ ce: d.edges.filter((e) => e[0] === p).length, ca: d.edges.filter((e) => e[1] === p).length });
  const instability = (d: Design, p: string) => { const { ce, ca } = counts(d, p); return ca + ce === 0 ? 0 : Math.floor((ce * 100) / (ca + ce)); };
  const violations = (d: Design) => d.edges.filter(([a, b]) => instability(d, b) > instability(d, a));
  const buildsPerQuarter = (d: Design) => Object.keys(d.changes).reduce((sum, p) => sum + d.changes[p] * rebuildSet(d, p).size, 0);

  document.querySelectorAll<HTMLElement>('[data-spd]').forEach((root) => {
    const q = query(root);
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const d = DESIGNS[Number(q<HTMLSelectElement>('[data-design]').value)];
      const key = KEYS[Number(q<HTMLSelectElement>('[data-change]').value)];
      const p = d.roles[key];
      const all = Object.keys(d.changes);
      const rb = rebuildSet(d, p), cyc = inCycle(d), viol = violations(d), bpq = buildsPerQuarter(d);
      set(1, `${rb.size} of ${all.length}`, `a change to ${p} forces these packages to rebuild and retest`);
      box(1, rb.size <= Math.ceil(all.length / 2));
      set(2, String(cyc.length), cyc.length ? `${cyc.join(', ')}: none can be released alone` : 'every package can be built and released in order');
      box(2, cyc.length === 0);
      set(3, String(viol.length), viol.length ? `${viol.map((e) => e.join(' to ')).join('; ')}` : 'every arrow points toward the steadier package');
      box(3, viol.length === 0);
      set(4, String(bpq), 'each package change times the packages it rebuilds, using the changes per quarter listed below');
      box(4, bpq <= 120);
      set(5, String(instability(d, p)), 'Ce x 100 / (Ca + Ce): 0 is steady, 100 changes freely');
      box(5, true);
      set(6, String(d.feature.length), d.feature.join(', '));
      box(6, d.feature.length <= 3);
      const log = q('[data-log]'); log.textContent = '';
      for (const name of all) {
        const { ca, ce } = counts(d, name);
        const li = document.createElement('li');
        li.textContent = `${name}: instability ${instability(d, name)} (${ca} depend on it, it depends on ${ce}), ${d.changes[name]} changes a quarter${cyc.includes(name) ? ', in a cycle' : ''}${rb.has(name) ? ', REBUILT' : ''}`;
        log.appendChild(li);
      }
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
