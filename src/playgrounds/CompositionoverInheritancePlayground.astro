---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A game where units combine any movement abilities (walk, swim, fly, ...) with one attack style, and every combination is needed. Choose how many of each exist and how the code is organised, then see what it costs.">
  <ol class="how">
    <li>Start with the defaults: <b>Movement abilities</b> at <b>3</b>, <b>Attack styles</b> at <b>2</b> and <b>Design</b> <b>Deep inheritance</b>. The game has 14 unit types, so it needs <b>15</b> classes, with <b>24</b> copies of ability code, and adding one more ability costs <b>16</b> classes.</li>
    <li>Set <b>Design</b> to <b>Composition</b>: <b>8</b> classes, no copied ability code, and a change to the base reaches 1 class. Set <b>Design</b> to <b>Shallow inheritance plus composition</b>: <b>10</b> classes, and a base change reaches 3.</li>
    <li>Set <b>Movement abilities</b> to <b>6</b> and <b>Design</b> to <b>Deep inheritance</b>: <b>127</b> classes, <b>384</b> copies of ability code and <b>128</b> classes to add one ability. Set <b>Attack styles</b> to <b>4</b>: <b>253</b> classes. Set <b>Movement abilities</b> to <b>2</b> and <b>Attack styles</b> to <b>1</b> to see where inheritance is the smaller design.</li>
  </ol>
  <div class="pg coi" data-coi>
    <div class="pg-row">
      <label>Movement abilities <input class="pg-in" type="range" min="2" max="6" step="1" value="3" data-m /> <b data-mv></b></label>
      <label>Attack styles <input class="pg-in" type="range" min="1" max="4" step="1" value="2" data-a /> <b data-av></b></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Deep inheritance</option><option value="1">Composition</option><option value="2">Shallow inheritance plus composition</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Classes needed</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Copies of ability code</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Classes hit by one base change</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Classes to add one ability</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The three designs at these settings</h3>
      <div class="coi-scroll" tabindex="0" role="region" aria-label="The three designs compared at the current settings"><table class="coi-table" data-table></table></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  interface R { classes: number; duplicated: number; affected: number; addAbility: number }

  // The same model as the code samples: every non-empty set of movements times one attack style is a unit type.
  const types = (m: number, a: number) => (2 ** m - 1) * a;
  const DESIGNS: [string, (m: number, a: number) => R, string][] = [
    ['Deep inheritance', (m, a) => ({ classes: 1 + types(m, a), duplicated: a * m * 2 ** (m - 1), affected: 1 + types(m, a), addAbility: 2 ** m * a }),
      'One class per unit type under a base Unit. A class has one parent, so every behaviour beyond the first is written again in it.'],
    ['Composition', (m, a) => ({ classes: 3 + m + a, duplicated: 0, affected: 1, addAbility: 1 }),
      'A Unit class, 2 interfaces and one class per behaviour. Unit types are assembled from parts, as configuration rather than as classes.'],
    ['Shallow inheritance plus composition', (m, a) => ({ classes: 5 + m + a, duplicated: 0, affected: 3, addAbility: 1 }),
      'Composition for what varies, plus 2 real subclasses of Unit that keep its contract. A base change reaches the base and those 2.'],
  ];

  document.querySelectorAll<HTMLElement>('[data-coi]').forEach((root) => {
    const q = query(root);
    const setBox = (n: number, value: number, note: string, tone: 'good' | 'bad' | 'mid') => {
      q(`[data-o${n}]`).textContent = String(value); q(`[data-n${n}]`).textContent = note;
      q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    const tone = (v: number, all: number[]): 'good' | 'bad' | 'mid' => { const lo = Math.min(...all); return v === lo ? 'good' : v >= 2 * lo ? 'bad' : 'mid'; };
    function draw() {
      const m = Number(q<HTMLInputElement>('[data-m]').value), a = Number(q<HTMLInputElement>('[data-a]').value), di = Number(q<HTMLSelectElement>('[data-design]').value);
      q('[data-mv]').textContent = String(m); q('[data-av]').textContent = String(a);
      const all = DESIGNS.map(([, f]) => f(m, a)), r = all[di];
      setBox(1, r.classes, `${types(m, a)} unit types: every set of movements with one attack style`, tone(r.classes, all.map((x) => x.classes)));
      setBox(2, r.duplicated, 'behaviour written again because a class has one parent', tone(r.duplicated, all.map((x) => x.duplicated)));
      setBox(3, r.affected, 'the base class and every class that inherits from it', tone(r.affected, all.map((x) => x.affected)));
      setBox(4, r.addAbility, 'new classes so that the new ability can be combined with all the others', tone(r.addAbility, all.map((x) => x.addAbility)));
      const table = q('[data-table]'); table.textContent = '';
      const head = table.insertRow(); ['Design', 'Classes', 'Copies', 'Base change', 'Add ability'].forEach((h) => { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); });
      DESIGNS.forEach(([name], i) => { const row = table.insertRow(); if (i === di) row.className = 'on'; [name, all[i].classes, all[i].duplicated, all[i].affected, all[i].addAbility].forEach((v) => { row.insertCell().textContent = String(v); }); });
      const small = all[0].classes <= all[1].classes;
      q('[data-verdict]').textContent = `${DESIGNS[di][0]}: ${DESIGNS[di][2]} ${small ? 'At these settings the hierarchy is no bigger than the composed design, so composition has nothing to win yet.' : ''}`;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .coi-scroll { overflow-x: auto; }
  .playground .coi-table { border-collapse: collapse; font: .82rem var(--font-mono); min-width: 100%; }
  .playground .coi-table th, .playground .coi-table td { padding: 4px 8px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
  .playground .coi-table th:first-child, .playground .coi-table td:first-child { text-align: left; }
  .playground .coi-table tr.on td { font-weight: 700; background: var(--accent-soft); }
</style>
