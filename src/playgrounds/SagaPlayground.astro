---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Book a trip across three services. Choose which step fails, and whether a saga is protecting you.">
  <ol class="how">
    <li>Set <b>Payment fails</b> and <b>No saga</b>, then press <b>Book trip</b>: the flight and hotel stay reserved for a customer who never paid.</li>
    <li>Switch to <b>Saga</b> and run again. The completed steps are compensated in reverse order.</li>
    <li>Try <b>Hotel fails</b>: only the flight needs undoing.</li>
  </ol>
  <div class="pg" data-saga>
    <div class="pg-row" role="group" aria-label="Which step fails" data-fails></div>
    <div class="pg-row" role="group" aria-label="Protection" data-modes></div>
    <div class="pg-row"><button class="btn pg-primary" type="button" data-run>Book trip</button><button class="btn" type="button" data-reset>Reset</button></div>
    <div class="pg-grid" data-services></div>
    <ol class="pg-log sg-log" data-log tabindex="0" aria-label="Saga log"></ol>
    <output class="pg-out" data-out aria-live="polite">Choose a failure and press Book trip.</output>
  </div>
</PlaygroundShell>
<script>
  interface Svc { name: string; state: string; el?: { box: HTMLElement; body: HTMLElement } }
  const STEP_MS = 500; // pause between saga steps so each one is visible
  const wait = (ms: number) => new Promise((r) => setTimeout(r, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : ms));
  document.querySelectorAll<HTMLElement>('[data-saga]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const names = ['Flight', 'Hotel', 'Payment']; const verbs: Record<string, [string, string, string]> = { Flight: ['seat RESERVED', 'seat CANCELLED', 'flight'], Hotel: ['room RESERVED', 'room CANCELLED', 'hotel'], Payment: ['CHARGED', 'REFUNDED', 'card'] };
    let svcs: Svc[] = []; let failAt = 'Payment'; let useSaga = false; let run = 0; let running = false;
    const log = (t: string) => { const li = document.createElement('li'); li.textContent = t; q('[data-log]').appendChild(li); };
    const out = (t: string, bad = false) => { const o = q('[data-out]'); o.textContent = t; o.classList.toggle('bad', bad); };
    function draw() { svcs.forEach((s) => { if (s.el) { s.el.body.textContent = s.state; s.el.box.style.setProperty('--c', /FAILED|DECLINED/.test(s.state) ? 'var(--bad)' : /CANCELLED|REFUNDED/.test(s.state) ? 'var(--role-4)' : /RESERVED|CHARGED/.test(s.state) ? 'var(--role-3)' : 'var(--border)'); } }); }
    function reset() { run++; running = false; svcs.forEach((s) => (s.state = 'idle')); q('[data-log]').innerHTML = ''; draw(); out('Choose a failure and press Book trip.'); }
    async function go() {
      if (running) return; reset(); const id = ++run; running = true; const done: Svc[] = [];
      for (const s of svcs) {
        if (id !== run) return; log(`do ${s.name.toLowerCase()}`); await wait(STEP_MS);
        if (s.name === failAt) { s.state = s.name === 'Payment' ? 'DECLINED' : 'FAILED'; draw(); log(`FAIL ${s.name.toLowerCase()}`); break; }
        s.state = verbs[s.name][0]; done.push(s); draw();
      }
      if (done.length === svcs.length) { out('Booked: flight, hotel and payment all succeeded.'); running = false; return; }
      if (useSaga) {
        for (const s of [...done].reverse()) { if (id !== run) return; log(`undo ${s.name.toLowerCase()} (compensation)`); await wait(STEP_MS); s.state = verbs[s.name][1]; draw(); }
        out('Saga compensated every completed step. The system is consistent: nothing is booked.');
      } else {
        const held = done.map((s) => verbs[s.name][2]).join(' and ');
        out(held ? `INCONSISTENT: ${held} ${done.length > 1 ? 'are' : 'is'} still held, but the trip failed. Nothing will release ${done.length > 1 ? 'them' : 'it'}.` : 'Nothing completed before the failure, so nothing to undo.', done.length > 0); }
      running = false;
    }
    names.forEach((n) => { const box = document.createElement('div'); box.className = 'pg-box'; box.innerHTML = '<h3></h3><span class="pg-mono"></span>'; box.querySelector('h3')!.textContent = `${n} service`; q('[data-services]').appendChild(box); svcs.push({ name: n, state: 'idle', el: { box, body: box.querySelector('span')! } }); });
    ['Hotel', 'Payment', 'None'].forEach((f) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = f === 'None' ? 'Everything works' : `${f} fails`; b.dataset.f = f; b.setAttribute('aria-pressed', String(f === failAt)); b.addEventListener('click', () => { failAt = f; q('[data-fails]').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); reset(); }); q('[data-fails]').appendChild(b); });
    [['No saga', false], ['Saga (compensate)', true]].forEach(([l, v]) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = l as string; b.setAttribute('aria-pressed', String(v === useSaga)); b.addEventListener('click', () => { useSaga = v as boolean; q('[data-modes]').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); reset(); }); q('[data-modes]').appendChild(b); });
    q('[data-run]').addEventListener('click', go); q('[data-reset]').addEventListener('click', reset);
    draw();
  });
</script>
<style is:global>
  .playground .sg-log { max-height: 200px; }
</style>
