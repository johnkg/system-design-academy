---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A page asks several vendors for a price. Most answer in a typical time, and some are five times slower. Compare asking one by one with scatter-gather, with and without a deadline.">
  <ol class="how">
    <li>Start with the defaults: <b>Vendors</b> at <b>5</b>, <b>Typical answer time</b> at <b>100</b>, <b>Chance a vendor is slow</b> at <b>20</b>, <b>Deadline</b> at <b>300</b> and <b>Design</b> <b>One after another</b>. The page waits <b>900</b> ms and uses <b>5</b> of 5 answers.</li>
    <li>Set <b>Design</b> to <b>Scatter-gather, wait for all</b>: <b>500</b> ms, because the one slow vendor still sets the pace, and <b>5</b> of 5 answers.</li>
    <li>Set <b>Design</b> to <b>Scatter-gather with a deadline</b>: <b>300</b> ms, with <b>4</b> of 5 answers. The slow vendor is ignored.</li>
    <li>Set <b>Vendors</b> to <b>20</b>: the page still takes <b>300</b> ms and now uses <b>16</b> of 20 answers. One after another would take <b>3600</b> ms.</li>
  </ol>
  <div class="pg sg" data-sg>
    <div class="pg-row">
      <label>Vendors <input class="pg-in" type="range" min="2" max="20" step="1" value="5" data-n /> <b data-nv></b></label>
      <label>Typical answer time <input class="pg-in" type="range" min="50" max="200" step="10" value="100" data-t /> <b data-tv></b> ms</label>
      <label>Chance a vendor is slow <input class="pg-in" type="range" min="0" max="50" step="5" value="20" data-p /> <b data-pv></b> %</label>
      <label>Deadline <input class="pg-in" type="range" min="100" max="1000" step="50" value="300" data-d /> <b data-dv></b> ms</label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>One after another</option><option value="1">Scatter-gather, wait for all</option><option value="2">Scatter-gather with a deadline</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Time until prices are shown</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Answers used</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Slow vendors in this run</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // A vendor answers in the typical time, or in SLOW_FACTOR times that when it is slow. The number of slow vendors is the expected value, rounded.
  const SLOW_FACTOR = 5;
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-sg]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    const num = (sel: string) => Number(q<HTMLInputElement>(sel).value);
    function draw() {
      const n = num('[data-n]'), t = num('[data-t]'), p = num('[data-p]'), deadline = num('[data-d]');
      const design = Number(q<HTMLSelectElement>('[data-design]').value);
      for (const [k, v] of [['nv', n], ['tv', t], ['pv', p], ['dv', deadline]] as const) q(`[data-${k}]`).textContent = String(v);
      const slow = Math.round((n * p) / 100), normal = n - slow, slowTime = t * SLOW_FACTOR;
      const waitAll = slow > 0 ? slowTime : t;
      const time = design === 0 ? normal * t + slow * slowTime : design === 1 ? waitAll : Math.min(deadline, waitAll);
      const used = design === 2 ? (t <= deadline ? normal : 0) + (slowTime <= deadline ? slow : 0) : n;
      setBox(1, `${time} ms`, design === 0 ? 'every answer is waited for in turn' : design === 1 ? 'as long as the slowest vendor takes' : 'the page stops waiting at the deadline, or sooner', design === 0 ? 'bad' : design === 1 && slow > 0 ? 'mid' : 'good');
      setBox(2, `${used} of ${n}`, used === n ? 'every vendor is in the result' : `${n - used} left out, and the page should say so`, used === n ? 'good' : 'mid');
      setBox(3, String(slow), slow === 0 ? 'nobody is slow, so a deadline changes nothing' : `each takes ${slowTime} ms instead of ${t} ms`, slow === 0 ? 'good' : 'mid');
      q('[data-verdict]').textContent = design === 0
        ? 'The waits add up, and the slow vendors are paid for in full.'
        : design === 1 ? 'Asking everyone at once removes the adding up, but the slowest vendor still decides how long the page takes.'
        : 'A deadline puts a ceiling on the wait. The price is that slow vendors are left out, so the page should say how many answers it used.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
