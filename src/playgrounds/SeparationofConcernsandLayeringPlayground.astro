---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A small shop app (orders, invoices, customers) cut four ways. Pick a design and a change to see which files are edited, how many only forward data, how much unrelated behaviour sits in the edited files and which tests run again.">
  <ol class="how">
    <li>Set <b>Design</b> to <b>Leaky layers</b> and <b>Change</b> to <b>Rename an invoice column</b>: <b>3</b> files are edited, one in each layer, and <b>3</b> unrelated behaviours sit in them. Set <b>Design</b> to <b>Clean layers</b>: only <b>1</b> file is edited.</li>
    <li>Set <b>Design</b> to <b>Over-layered</b> and <b>Change</b> to <b>Add a field to the order screen</b>: <b>7</b> files are edited, <b>4</b> of them only forward the field. The design has <b>21</b> files and every request passes through <b>7</b> of them.</li>
    <li>Set <b>Design</b> to <b>Vertical slices</b> and <b>Change</b> to <b>Swap the database engine</b>: <b>3</b> slices are edited with <b>9</b> unrelated behaviours beside the change, against <b>3</b> for <b>Clean layers</b>.</li>
    <li>Read the table of all five changes. Files edited: <b>13</b> for leaky layers, <b>10</b> for clean layers, <b>9</b> for slices, <b>17</b> for seven layers. Unrelated behaviour: <b>12</b>, <b>5</b>, <b>26</b> and <b>7</b>. Tests run again: <b>20</b>, <b>20</b>, <b>9</b> and <b>42</b>.</li>
  </ol>
  <div class="pg sol" data-sol>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design>
        <option value="0" selected>Leaky layers</option>
        <option value="1">Clean layers</option>
        <option value="2">Vertical slices</option>
        <option value="3">Over-layered</option>
      </select></label>
      <label>Change <select class="pg-in" data-req>
        <option value="0">Add a field to the order screen</option>
        <option value="1">Change the order discount rule</option>
        <option value="2" selected>Rename an invoice column</option>
        <option value="3">Swap the database engine</option>
        <option value="4">Restyle every screen</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Files edited</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Forwarding-only edits</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Unrelated behaviours in edited files</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Files to test again</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Files on the path of one request</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Files in the design</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The same five changes, four designs</h3>
      <div class="sol-scroll" tabindex="0" role="region" aria-label="Totals for the four designs"><table class="sol-table" data-table>
        <thead><tr><th scope="col">Design</th><th scope="col">Files</th><th scope="col">Files edited</th><th scope="col">Forwarding edits</th><th scope="col">Unrelated behaviours</th><th scope="col">Tests run again</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <span class="pg-note">Totals over the five changes. Unrelated behaviours are other concerns that live inside a file you had to edit. A file is tested again when it is edited or calls an edited file.</span>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="Files edited per change, for the chosen design"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type Layer = [string, string[], string[]]; // name, what it holds, what it only passes along
  type Mod = { name: string; holds: string[]; passes: string[]; calls: string[] };
  const FEATURES = ['orders', 'invoices', 'customers'];
  const DESIGNS: { name: string; layers: Layer[] }[] = [
    { name: 'Leaky layers', layers: [
      ['Controller', ['ui', 'data'], ['shape']],
      ['Service', ['rule', 'data'], ['shape']],
      ['Repository', ['data', 'db'], ['shape']],
    ] },
    { name: 'Clean layers', layers: [
      ['Controller', ['ui'], ['shape']],
      ['Service', ['rule'], []],
      ['Repository', ['data', 'db'], ['shape']],
    ] },
    { name: 'Vertical slices', layers: [
      ['Slice', ['ui', 'rule', 'data', 'db'], []],
    ] },
    { name: 'Over-layered', layers: [
      ['Controller', ['ui'], ['shape']],
      ['Facade', [], ['shape']],
      ['Service', ['rule'], ['shape']],
      ['Manager', ['rule'], ['shape']],
      ['DomainModel', [], ['shape']],
      ['Repository', ['data'], ['shape']],
      ['Dao', ['data', 'db'], ['shape']],
    ] },
  ];
  const CHANGES: { text: string; touches: string[] }[] = [
    { text: 'Add a field to the order screen', touches: ['orders.ui', 'orders.data', 'orders.shape'] },
    { text: 'Change the order discount rule', touches: ['orders.rule'] },
    { text: 'Rename an invoice column', touches: ['invoices.data'] },
    { text: 'Swap the database engine', touches: ['orders.db', 'invoices.db', 'customers.db'] },
    { text: 'Restyle every screen', touches: ['orders.ui', 'invoices.ui', 'customers.ui'] },
  ];

  // The same model as the code samples.
  const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
  function build(layers: Layer[]): Mod[] {
    const mods: Mod[] = [];
    for (const f of FEATURES) {
      layers.forEach(([layer, holds, passes], i) => {
        const nxt = i + 1 < layers.length ? cap(f) + layers[i + 1][0] : null;
        mods.push({ name: cap(f) + layer, holds: holds.map((t) => `${f}.${t}`), passes: passes.map((t) => `${f}.${t}`), calls: nxt ? [nxt] : [] });
      });
    }
    return mods;
  }
  function analyse(mods: Mod[], touches: string[]) {
    const hit = (ts: string[]) => ts.some((t) => touches.includes(t));
    const edited = mods.filter((m) => hit(m.holds.concat(m.passes)));
    const forwarding = edited.filter((m) => !hit(m.holds));
    let bystanders = 0;
    for (const m of edited) for (const t of m.holds) if (!touches.includes(t)) bystanders++;
    const retest = new Set(edited.map((m) => m.name));
    let grew = true;
    while (grew) { // anything that calls a retested file must be retested too
      grew = false;
      for (const m of mods) if (!retest.has(m.name) && m.calls.some((c) => retest.has(c))) { retest.add(m.name); grew = true; }
    }
    return { edited: edited.map((m) => m.name), forwarding: forwarding.length, bystanders, retest: retest.size };
  }

  document.querySelectorAll<HTMLElement>('[data-sol]').forEach((root) => {
    const q = query(root);
    const tbody = q('[data-table] tbody');
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const di = Number(q<HTMLSelectElement>('[data-design]').value);
      const ri = Number(q<HTMLSelectElement>('[data-req]').value);
      const d = DESIGNS[di];
      const mods = build(d.layers);
      const a = analyse(mods, CHANGES[ri].touches);
      set(1, String(a.edited.length), a.edited.join(', '));
      box(1, a.edited.length <= 1);
      set(2, String(a.forwarding), a.forwarding === 0 ? 'every edited file has real work to do for this change' : 'files edited only because they copy the data on to the next layer');
      box(2, a.forwarding === 0);
      set(3, String(a.bystanders), a.bystanders === 0 ? 'nothing unrelated shares a file with the change' : 'other concerns in the edited files, which this edit can break');
      box(3, a.bystanders <= 1);
      set(4, String(a.retest), 'the edited files plus every file that calls them');
      box(4, a.retest <= 3);
      set(5, String(d.layers.length), 'files a request passes through, one per layer');
      box(5, d.layers.length <= 3);
      set(6, String(mods.length), `${FEATURES.length} features, ${d.layers.length} per feature`);
      box(6, mods.length <= 9);
      tbody.textContent = '';
      DESIGNS.forEach((x, i) => {
        const xm = build(x.layers);
        let te = 0, tf = 0, tb = 0, tr = 0;
        for (const c of CHANGES) { const s = analyse(xm, c.touches); te += s.edited.length; tf += s.forwarding; tb += s.bystanders; tr += s.retest; }
        const tr_ = document.createElement('tr');
        if (i === di) tr_.className = 'sel';
        [x.name, String(xm.length), String(te), String(tf), String(tb), String(tr)].forEach((text, k) => {
          const cell = document.createElement(k === 0 ? 'th' : 'td'); if (k === 0) cell.setAttribute('scope', 'row'); cell.textContent = text; tr_.appendChild(cell);
        });
        tbody.appendChild(tr_);
      });
      const log = q('[data-log]'); log.textContent = '';
      CHANGES.forEach((c) => {
        const s = analyse(mods, c.touches);
        const li = document.createElement('li'); li.textContent = `${c.text}: edit ${s.edited.join(', ')}`; log.appendChild(li);
      });
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .sol-scroll { overflow-x: auto; }
  .playground .sol-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .sol-table th, .playground .sol-table td { padding: 5px 8px; border-bottom: 1px solid var(--border); text-align: left; }
  .playground .sol-table tr.sel { background: var(--accent-soft); font-weight: 600; }
</style>
