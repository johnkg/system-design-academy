---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Three situations. Run each with and without the guarantee.">
  <ol class="how">
    <li>Pick a <b>scenario</b> and a <b>mode</b>, then press <b>Run</b>.</li>
    <li>In the first two, see money vanish or double-spend without ACID.</li>
    <li>In the third, compare strict one-at-a-time updates with BASE-style local counters that settle after a sync.</li>
  </ol>
  <div class="pg" data-acid>
    <div class="pg-row" role="group" aria-label="Scenario" data-scenarios></div>
    <div class="pg-row" role="group" aria-label="Mode" data-modes></div>
    <p class="pg-note" data-desc></p>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-run>Run</button>
      <button class="btn" type="button" data-sync hidden>Sync the replicas</button>
    </div>
    <ol class="pg-log ac-steps" data-steps tabindex="0" aria-label="Steps"></ol>
    <output class="pg-out" data-out aria-live="polite">Press Run.</output>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type Sid = 'crash' | 'race' | 'likes';
  const scenarios: { id: Sid; label: string; modes: [string, string]; desc: string }[] = [
    { id: 'crash', label: 'Crash mid-transfer', modes: ['No transaction', 'ACID transaction'], desc: 'Move $100 from A (100) to B (50). The server crashes after the debit and before the credit. The rule: the total must stay $150.' },
    { id: 'race', label: 'Two withdrawals at once', modes: ['No isolation', 'Isolated (serialised)'], desc: 'Balance is $100. Two customers each withdraw $80 at the same moment. The rule: the balance must never go negative and you can only pay out what exists.' },
    { id: 'likes', label: 'Counting likes at scale', modes: ['ACID: one global counter', 'BASE: local counters, sync later'], desc: 'Ten likes arrive. ACID updates one locked counter one at a time. BASE lets each of two replicas count its own likes and merges them later.' },
  ];
  document.querySelectorAll<HTMLElement>('[data-acid]').forEach((root) => {
    const q = query(root);
    let sc = scenarios[0]; let mode = 0; let r1 = 0; let r2 = 0;
    const LIKES = 10, LOCK_MS = 50; // likes in the counter scenario, and the cost of one locked increment
    const PER_REPLICA = LIKES / 2; // the likes split evenly over two replicas
    const steps = (lines: string[]) => { q('[data-steps]').innerHTML = lines.map((l) => `<li>${l}</li>`).join(''); };
    const out = (t: string, bad = false) => { const o = q('[data-out]'); o.textContent = t; o.classList.toggle('bad', bad); };
    function chips() {
      const s = q('[data-scenarios]'); s.innerHTML = ''; scenarios.forEach((x) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = x.label; b.setAttribute('aria-pressed', String(x === sc)); b.addEventListener('click', () => { sc = x; mode = 0; chips(); show(); }); s.appendChild(b); });
      const m = q('[data-modes]'); m.innerHTML = ''; sc.modes.forEach((x, i) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = x; b.setAttribute('aria-pressed', String(i === mode)); b.addEventListener('click', () => { mode = i; chips(); show(); }); m.appendChild(b); });
    }
    function show() { q('[data-desc]').textContent = sc.desc; steps([]); out('Press Run.'); q('[data-sync]').hidden = true; r1 = 0; r2 = 0; }
    function run() {
      q('[data-sync]').hidden = true;
      if (sc.id === 'crash') {
        const log = ['A = 100, B = 50 (total 150)', mode ? 'BEGIN TRANSACTION' : '(no transaction)', 'debit A by 100 → A = 0', 'CRASH before crediting B'];
        if (mode) { log.push('restart: unfinished transaction found → ROLLBACK', 'A = 100, B = 50'); steps(log); out('Total = $150. Atomicity: the failed transfer left no trace.'); }
        else { log.push('restart: nothing to undo', 'A = 0, B = 50'); steps(log); out('Total = $50. $100 has vanished, and nothing can say where it went.', true); }
      } else if (sc.id === 'race') {
        if (mode) { steps(['Customer 1 locks the account, reads 100, withdraws 80 → balance 20', 'Customer 2 waits for the lock, reads 20: insufficient funds → rejected', 'Balance 20, paid out $80']); out('Correct: one withdrawal succeeded, one was refused. Balance $20.'); }
        else { steps(['Customer 1 reads balance 100', 'Customer 2 reads balance 100 (before 1 has written)', 'Customer 1 writes 20, pays out $80', 'Customer 2 writes 20, pays out $80', 'Balance 20, paid out $160']); out('Broken: $160 was paid out from a $100 balance (a lost update).', true); }
      } else if (!mode) {
        steps(Array.from({ length: LIKES }, (_, i) => `like ${i + 1}: lock counter, +1, unlock (${LOCK_MS} ms)`)); out(`Counter = ${LIKES}, always exact. It took about ${LIKES * LOCK_MS} ms because likes are applied one at a time.`);
      } else {
        r1 = PER_REPLICA; r2 = PER_REPLICA; steps([`Replica 1 counts ${PER_REPLICA} likes locally, instantly`, `Replica 2 counts ${PER_REPLICA} likes locally, instantly`, 'No coordination and no lock, so no 50 ms wait per like']);
        out(`Replica 1 shows ${PER_REPLICA} and Replica 2 shows ${PER_REPLICA}. The true total is ${LIKES}, but nobody has merged yet (soft state).`, true); q('[data-sync]').hidden = false;
      }
    }
    q('[data-run]').addEventListener('click', run);
    q('[data-sync]').addEventListener('click', () => { const t = r1 + r2; r1 = r2 = t; steps(['Replicas exchange counts and add them together', `Replica 1 = ${t}, Replica 2 = ${t}`]); out(`Converged: both replicas now show ${t}. Eventually consistent.`); q('[data-sync]').hidden = true; });
    chips(); show();
  });
</script>
<style is:global>
  .playground .ac-steps { max-height: none; }
</style>
