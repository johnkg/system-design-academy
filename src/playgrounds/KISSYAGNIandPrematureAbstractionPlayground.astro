---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A year of 12 change requests: 10 inside the code and 2 on a public contract. Count the touch points (places a person must edit) for plain code, for code with speculative options, and for plain code with a planned contract.">
  <ol class="how">
    <li>Set <b>Design</b> to <b>Speculative options</b>, <b>Guess right (%)</b> to <b>50</b> and <b>Cost of a late contract change</b> to <b>Public API (9)</b>: the year costs <b>52</b> touch points, while plain code would cost <b>41</b>.</li>
    <li>Set <b>Guess right (%)</b> to <b>100</b>: speculation now costs <b>37</b> and beats plain code by 4. Set it to <b>90</b>: <b>40</b>, one point under plain code. Below that it loses.</li>
    <li>Set <b>Design</b> to <b>Plain code, planned contract</b>: <b>27</b> touch points, because the 2 contract changes cost 1 each instead of 9. Set <b>Cost of a late contract change</b> to <b>Stored file format (15)</b>: plain code now costs <b>53</b>.</li>
    <li>Break it: set <b>Cost of a late contract change</b> to <b>Internal function (1)</b>. Plain code costs <b>25</b> and the planned contract <b>27</b>, so the 2 points of foresight were wasted. Planning pays only where a late change is expensive.</li>
  </ol>
  <div class="pg kiss" data-kiss>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design><option value="simple">Plain code</option><option value="speculative" selected>Speculative options</option><option value="targeted">Plain code, planned contract</option></select></label>
      <label>Guess right (%) <input class="pg-in" type="range" min="0" max="100" step="10" value="50" data-hit /> <b data-hitv></b></label>
      <label>Cost of a late contract change <select class="pg-in" data-late><option value="1">Internal function (1)</option><option value="9" selected>Public API (9)</option><option value="15">Stored file format (15)</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Touch points in the year</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Build up front</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>10 internal changes</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>2 contract changes</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>All three designs at these settings</h3>
      <div class="kiss-scroll" tabindex="0" role="region" aria-label="Touch points per design at the chosen settings"><table class="kiss-table" data-table></table></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type Design = 'simple' | 'speculative' | 'targeted';
  interface Year { build: number; internal: number; contract: number; total: number }
  const INTERNAL = 10, CONTRACT = 2;

  // The same model as the code samples. simple: build 3, an internal change 2, a contract change costs the late price.
  // speculative: build 3 + 6 unused options, a guessed change 1, a missed one 4, a contract change costs the late price.
  // targeted: build 3 + 2 (version field and a rule to reject unknown versions), an internal change 2, a contract change 1.
  function year(design: Design, hit: number, late: number): Year {
    let build: number, internal: number, contract: number;
    if (design === 'simple') { build = 3; internal = INTERNAL * 2; contract = CONTRACT * late; }
    else if (design === 'speculative') {
      const h = Math.floor((INTERNAL * hit) / 100);
      build = 9; internal = h * 1 + (INTERNAL - h) * 4; contract = CONTRACT * late;
    } else { build = 5; internal = INTERNAL * 2; contract = CONTRACT * 1; }
    return { build, internal, contract, total: build + internal + contract };
  }
  const NAMES: Record<Design, string> = { simple: 'Plain code', speculative: 'Speculative options', targeted: 'Plain code, planned contract' };
  const ALL: Design[] = ['simple', 'speculative', 'targeted'];

  document.querySelectorAll<HTMLElement>('[data-kiss]').forEach((root) => {
    const q = query(root);
    const setBox = (n: number, value: string, note: string, good: boolean | null) => {
      q(`[data-o${n}]`).textContent = value; q(`[data-n${n}]`).textContent = note;
      q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good === null ? 'var(--border)' : good ? 'var(--good)' : 'var(--bad)');
    };
    function draw() {
      const design = q<HTMLSelectElement>('[data-design]').value as Design;
      const hit = Number(q<HTMLInputElement>('[data-hit]').value), late = Number(q<HTMLSelectElement>('[data-late]').value);
      q('[data-hitv]').textContent = `${hit}% (${Math.floor((INTERNAL * hit) / 100)} of ${INTERNAL} guesses)`;
      const r = year(design, hit, late), totals = ALL.map((d) => year(d, hit, late).total);
      setBox(1, `${r.total}`, `${NAMES[design]}`, r.total === Math.min(...totals));
      setBox(2, `${r.build}`, design === 'speculative' ? 'plain 3, plus 6 options nobody asked for' : design === 'targeted' ? 'plain 3, plus 2 for a version field' : 'one function', null);
      setBox(3, `${r.internal}`, design === 'speculative' ? '1 when the guess fits, 4 when it does not' : '2 each: edit and test', r.internal <= INTERNAL * 2);
      setBox(4, `${r.contract}`, design === 'targeted' ? '1 each: add a version, readers reject unknown ones' : `${late} each, because other people's code depends on it`, r.contract <= CONTRACT * 2);
      const table = q('[data-table]'); table.textContent = '';
      const head = table.insertRow(); ['Design', 'Build', 'Internal', 'Contract', 'Total'].forEach((h) => { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); });
      ALL.forEach((d) => {
        const y = year(d, hit, late), row = table.insertRow(); if (d === design) row.className = 'on';
        [NAMES[d], `${y.build}`, `${y.internal}`, `${y.contract}`, `${y.total}`].forEach((v) => { row.insertCell().textContent = v; });
      });
      let first = -1; for (let h = 0; h <= 100; h += 10) if (year('speculative', h, late).total <= year('simple', h, late).total) { first = h; break; }
      q('[data-verdict]').textContent = `Speculation matches plain code from a hit rate of ${first}% and never pays for itself below that. A planned contract costs ${year('targeted', hit, late).total - year('simple', hit, late).total > 0 ? 'more' : 'less'} than plain code here (${year('targeted', hit, late).total} against ${year('simple', hit, late).total}), because a late contract change costs ${late}.`;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .kiss-scroll { overflow-x: auto; }
  .playground .kiss-table { border-collapse: collapse; font: .82rem var(--font-mono); min-width: 100%; }
  .playground .kiss-table th, .playground .kiss-table td { padding: 4px 8px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
  .playground .kiss-table th:first-child, .playground .kiss-table td:first-child { text-align: left; }
  .playground .kiss-table tr.on td { font-weight: 700; background: var(--accent-soft); }
</style>
