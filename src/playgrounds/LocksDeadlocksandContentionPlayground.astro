---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Two toys, both deterministic. The first runs every interleaving of threads that take locks and counts the ones that end stuck. The second is a tick model: each thread does 20 jobs, each job is 20 ticks of work outside any lock and then some ticks inside a lock, and every thread has its own core. A tick is one unit of work, not a real time.">
  <ol class="how">
    <li>In <b>Lock order</b>, start with <b>Opposite order (A then B, B then A)</b>: the scheduler finds <b>6</b> schedules and <b>2</b> of them end deadlocked, with T0 holding A and wanting B while T1 holds B and wants A. Only a third of the schedules fail, which is why the bug passes tests.</li>
    <li>Set <b>Lock order</b> to <b>Three threads in a ring</b>: <b>234</b> schedules, and just <b>6</b> are deadlocked. Set it to <b>Ring, lowest lock first</b>: <b>236</b> schedules, none stuck. Then <b>Same lock taken twice</b>: every schedule is stuck, because the lock is not re-entrant.</li>
    <li>In the second panel, start with <b>Threads</b> <b>8</b>, <b>Locks</b> <b>1 (one coarse lock)</b> and <b>Time inside the lock</b> <b>2 ticks</b>: the run takes <b>454</b> ticks, barely more than the <b>440</b> ticks one thread needs for its own 20 jobs, so 8 threads do 8 times the work in about the same time. Set <b>Threads</b> to <b>16</b>: it takes <b>660</b> ticks and threads wait <b>31%</b> of the time, because the single lock is now busy all the time. Set <b>Locks</b> to <b>4 (one per group of data)</b> and it falls to <b>446</b> ticks.</li>
    <li>Set <b>Time inside the lock</b> to <b>20 ticks</b> and <b>Locks</b> back to <b>1 (one coarse lock)</b>, then try <b>Threads</b> <b>4</b>: <b>1,620</b> ticks and a speedup of <b>1.9x</b>. At <b>16</b> threads it is <b>6,420</b> ticks and still <b>1.9x</b>: threads wait <b>85%</b> of the time, and extra threads only lengthen the queue.</li>
  </ol>
  <div class="pg lk" data-lk>
    <h3 class="lk-h">Lock order</h3>
    <div class="pg-row">
      <label>Lock order <select class="pg-in" data-order>
        <option value="opposite" selected>Opposite order (A then B, B then A)</option>
        <option value="ordered">Same order (A then B, A then B)</option>
        <option value="ring">Three threads in a ring</option>
        <option value="ringOrdered">Ring, lowest lock first</option>
        <option value="reentry">Same lock taken twice</option>
        <option value="coarse">One coarse lock for everything</option>
      </select></label>
    </div>
    <ul class="lk-progs" data-progs></ul>
    <div class="pg-grid">
      <div class="pg-box" data-ab1><h3>Schedules explored</h3><span class="pg-mono" data-ao1></span><span class="pg-note" data-an1></span></div>
      <div class="pg-box" data-ab2><h3>Deadlocked</h3><span class="pg-mono" data-ao2></span><span class="pg-note" data-an2></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)"><h3>First deadlock found</h3><span class="pg-mono" data-stuck></span><span class="pg-note" data-example></span></div>

    <h3 class="lk-h">Contention</h3>
    <div class="pg-row">
      <label>Threads <select class="pg-in" data-threads><option>1</option><option>2</option><option>4</option><option selected>8</option><option>16</option></select></label>
      <label>Locks <select class="pg-in" data-locks><option value="1" selected>1 (one coarse lock)</option><option value="4">4 (one per group of data)</option></select></label>
      <label>Time inside the lock <select class="pg-in" data-hold><option value="2" selected>2 ticks</option><option value="20">20 ticks</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-bb1><h3>Ticks to finish</h3><span class="pg-mono" data-bo1></span><span class="pg-note" data-bn1></span></div>
      <div class="pg-box" data-bb2><h3>Speedup over one thread</h3><span class="pg-mono" data-bo2></span><span class="pg-note" data-bn2></span></div>
      <div class="pg-box" data-bb3><h3>Time spent waiting</h3><span class="pg-mono" data-bo3></span><span class="pg-note" data-bn3></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Speedup at each thread count</h3>
      <div class="lk-bars" data-bars></div>
      <span class="pg-note">Solid bar: the speedup the model gives. Outline: the speedup if the lock cost nothing (equal to the thread count).</span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const NAMES = 'ABCG';
  const SCENARIOS: Record<string, string[][]> = {
    opposite: [['L0', 'L1', 'W', 'U1', 'U0'], ['L1', 'L0', 'W', 'U0', 'U1']],
    ordered: [['L0', 'L1', 'W', 'U1', 'U0'], ['L0', 'L1', 'W', 'U1', 'U0']],
    ring: [['L0', 'L1', 'W', 'U1', 'U0'], ['L1', 'L2', 'W', 'U2', 'U1'], ['L2', 'L0', 'W', 'U0', 'U2']],
    ringOrdered: [['L0', 'L1', 'W', 'U1', 'U0'], ['L1', 'L2', 'W', 'U2', 'U1'], ['L0', 'L2', 'W', 'U2', 'U0']],
    reentry: [['L0', 'L0', 'W', 'U0', 'U0'], ['L0', 'L0', 'W', 'U0', 'U0']],
    coarse: [['L3', 'W', 'U3'], ['L3', 'W', 'U3']],
  };
  const lockNo = (op: string) => Number(op.slice(1));
  const sayOp = (op: string) => op === 'W' ? 'work' : `${op[0] === 'L' ? 'lock' : 'unlock'} ${NAMES[lockNo(op)]}`;

  // The same model as the code samples: every schedule of the threads' lock steps, depth first.
  function explore(progs: string[][]) {
    const n = progs.length;
    const r = { complete: 0, deadlocked: 0, example: '', stuck: '' };
    const trail: number[] = [];
    const canRun = (owner: number[], pc: number[], i: number) => pc[i] < progs[i].length && !(progs[i][pc[i]][0] === 'L' && owner[lockNo(progs[i][pc[i]])] !== -1);
    const walk = (owner: number[], pc: number[]) => {
      const ready: number[] = [];
      for (let i = 0; i < n; i++) if (canRun(owner, pc, i)) ready.push(i);
      if (ready.length === 0) {
        const unfinished: number[] = [];
        for (let i = 0; i < n; i++) if (pc[i] < progs[i].length) unfinished.push(i);
        if (unfinished.length === 0) { r.complete++; return; }
        r.deadlocked++;
        if (!r.example) {
          r.example = trail.join('');
          r.stuck = unfinished.map((i) => {
            const holds: string[] = [];
            for (let l = 0; l < 4; l++) if (owner[l] === i) holds.push(NAMES[l]);
            return `T${i} holds ${holds.length ? holds.join('') : 'nothing'} wants ${NAMES[lockNo(progs[i][pc[i]])]}`;
          }).join(' | ');
        }
        return;
      }
      for (const i of ready) {
        const o = owner.slice(), p = pc.slice();
        const op = progs[i][p[i]];
        p[i]++;
        if (op[0] === 'L') o[lockNo(op)] = i;
        if (op[0] === 'U') o[lockNo(op)] = -1;
        trail.push(i); walk(o, p); trail.pop();
      }
    };
    walk([-1, -1, -1, -1], Array(n).fill(0));
    return r;
  }

  const OUTSIDE = 20, JOBS = 20;
  function contention(threads: number, locks: number, hold: number) {
    const phase: string[] = Array(threads).fill('out'), rem: number[] = Array(threads).fill(OUTSIDE), job: number[] = Array(threads).fill(0);
    const owner: number[] = Array(locks).fill(-1), queue: number[][] = Array.from({ length: locks }, () => []);
    let finished = 0, t = 0, waiting = 0, longest = 0;
    while (finished < threads) {
      for (let i = 0; i < threads; i++) {
        if (phase[i] === 'out') { if (--rem[i] === 0) { phase[i] = 'wait'; queue[(i + job[i]) % locks].push(i); } }
        else if (phase[i] === 'hold') {
          if (--rem[i] === 0) {
            owner[(i + job[i]) % locks] = -1; job[i]++;
            if (job[i] === JOBS) { phase[i] = 'done'; finished++; } else { phase[i] = 'out'; rem[i] = OUTSIDE; }
          }
        }
      }
      for (let l = 0; l < locks; l++) if (owner[l] === -1 && queue[l].length > 0) { const i = queue[l].shift()!; owner[l] = i; phase[i] = 'hold'; rem[i] = hold; }
      for (let l = 0; l < locks; l++) { waiting += queue[l].length; if (queue[l].length > longest) longest = queue[l].length; }
      t++;
    }
    const alone = threads * JOBS * (OUTSIDE + hold);
    return { ticks: t, waitPct: Math.floor((waiting * 100) / (threads * t)), longest, x10: Math.floor((alone * 10) / t) };
  }

  const COUNTS = [1, 2, 4, 8, 16];
  document.querySelectorAll<HTMLElement>('[data-lk]').forEach((root) => {
    const q = query(root);
    const setBox = (sel: string, good: boolean) => q<HTMLElement>(sel).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const bars = q('[data-bars]');
    const rows = COUNTS.map((n) => {
      const row = document.createElement('div'); row.className = 'lk-row';
      const lab = document.createElement('span'); lab.className = 'pg-mono lk-lab'; lab.textContent = `${n}`;
      const track = document.createElement('span'); track.className = 'lk-track';
      const ideal = document.createElement('span'); ideal.className = 'lk-ideal'; ideal.style.width = `${(n * 100) / 16}%`;
      const bar = document.createElement('span'); bar.className = 'lk-bar';
      track.append(ideal, bar);
      const val = document.createElement('span'); val.className = 'pg-mono lk-val';
      row.append(lab, track, val); bars.appendChild(row);
      return { bar, val, row };
    });
    function drawOrder() {
      const progs = SCENARIOS[q<HTMLSelectElement>('[data-order]').value];
      const r = explore(progs);
      const list = q('[data-progs]'); list.textContent = '';
      progs.forEach((p, i) => { const li = document.createElement('li'); li.textContent = `T${i}: ${p.map(sayOp).join(', ')}`; list.appendChild(li); });
      q('[data-ao1]').textContent = String(r.complete + r.deadlocked);
      q('[data-an1]').textContent = 'every order in which the threads can take their steps, blocked threads waiting';
      setBox('[data-ab1]', true);
      q('[data-ao2]').textContent = `${r.deadlocked} of ${r.complete + r.deadlocked}`;
      q('[data-an2]').textContent = r.deadlocked === 0 ? 'no schedule gets stuck' : 'these schedules end with every remaining thread waiting forever';
      setBox('[data-ab2]', r.deadlocked === 0);
      q('[data-stuck]').textContent = r.deadlocked ? r.stuck : 'none';
      q('[data-example]').textContent = r.deadlocked ? `reached by the schedule ${r.example.split('').map((c) => 'T' + c).join(' ')}` : 'every schedule runs to the end';
    }
    function drawContention() {
      const threads = Number(q<HTMLSelectElement>('[data-threads]').value);
      const locks = Number(q<HTMLSelectElement>('[data-locks]').value);
      const hold = Number(q<HTMLSelectElement>('[data-hold]').value);
      const r = contention(threads, locks, hold);
      const one = contention(1, locks, hold);
      q('[data-bo1]').textContent = formatThousands(r.ticks);
      q('[data-bn1]').textContent = `${threads} thread${threads > 1 ? 's' : ''}, ${JOBS} jobs each; one thread alone would need ${formatThousands(one.ticks)} for its own ${JOBS} jobs`;
      setBox('[data-bb1]', true);
      q('[data-bo2]').textContent = `${(r.x10 / 10).toFixed(1)}x`;
      q('[data-bn2]').textContent = `with ${threads} threads and no lock cost it would be ${threads}.0x`;
      setBox('[data-bb2]', r.x10 >= threads * 10 * 0.8);
      q('[data-bo3]').textContent = `${r.waitPct}%`;
      q('[data-bn3]').textContent = `of all thread time is spent in a queue for a lock; the longest queue was ${r.longest}`;
      setBox('[data-bb3]', r.waitPct < 20);
      COUNTS.forEach((n, k) => { const c = contention(n, locks, hold); rows[k].bar.style.width = `${(c.x10 * 10) / 16}%`; rows[k].val.textContent = `${(c.x10 / 10).toFixed(1)}x`; rows[k].row.classList.toggle('lk-on', n === threads); });
    }
    root.addEventListener('change', (e) => { if ((e.target as HTMLElement).hasAttribute('data-order')) drawOrder(); else drawContention(); });
    drawOrder(); drawContention();
  });
</script>
<style is:global>
  .playground .lk-h { margin: 14px 0 8px; font-size: 1rem; }
  .playground .lk-progs { margin: 8px 0 12px; padding-left: 1.2em; font-family: var(--mono, monospace); font-size: .85rem; }
  .playground .lk-bars { display: grid; gap: 6px; }
  .playground .lk-row { display: grid; grid-template-columns: 2.5em 1fr 4em; gap: 8px; align-items: center; }
  .playground .lk-row.lk-on .lk-lab { font-weight: 700; }
  .playground .lk-lab { text-align: right; }
  .playground .lk-track { position: relative; display: block; height: 16px; }
  .playground .lk-ideal { position: absolute; left: 0; top: 0; bottom: 0; border: 1px solid var(--muted, #888); border-radius: 3px; box-sizing: border-box; }
  .playground .lk-bar { position: absolute; left: 0; top: 3px; bottom: 3px; border-radius: 2px; background: var(--good); }
  .playground .lk-row.lk-on .lk-bar { background: var(--accent, var(--good)); }
</style>
