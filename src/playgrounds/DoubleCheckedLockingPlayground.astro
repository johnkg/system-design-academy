---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A shared object is created on first use. A burst of callers arrives while it is being built, and many more calls follow. Compare four ways to guard its creation.">
  <ol class="how">
    <li>Start with the defaults: <b>Calls</b> at <b>100</b>, <b>Callers at the start</b> at <b>8</b> and <b>Design</b> <b>No lock</b>. The <b>8</b> callers at the start each build an instance, so <b>8</b> exist, and <b>0</b> locks are taken. That is the bug.</li>
    <li>Set <b>Design</b> to <b>Lock on every call</b>: <b>1</b> instance, correct, but <b>100</b> lock acquisitions, one for each call.</li>
    <li>Set <b>Design</b> to <b>Double-checked locking</b>: <b>1</b> instance, and only <b>8</b> lock acquisitions, by the callers at the start. The other calls take the fast path.</li>
    <li>Set <b>Design</b> to <b>Double-checked, no safe publication</b>: the counts are the same, but a half-built object is <b>Possible</b>, because the reference may be seen before the object's fields.</li>
    <li>Set <b>Calls</b> to <b>1000</b> with <b>Design</b> on <b>Lock on every call</b>: <b>1000</b> lock acquisitions. With double-checked locking it would still be <b>8</b>.</li>
  </ol>
  <div class="pg dcl" data-dcl>
    <div class="pg-row">
      <label>Calls <input class="pg-in" type="range" min="10" max="1000" step="10" value="100" data-c /> <b data-cv></b></label>
      <label>Callers at the start <input class="pg-in" type="range" min="1" max="20" step="1" value="8" data-b /> <b data-bv></b></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>No lock</option><option value="1">Lock on every call</option><option value="2">Double-checked locking</option><option value="3">Double-checked, no safe publication</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Instances created</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Lock acquisitions</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Half-built object visible</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // A burst of callers arrives while the object is being built; every later call finds it built.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-dcl]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const calls = Number(q<HTMLInputElement>('[data-c]').value), burst = Math.min(Number(q<HTMLInputElement>('[data-b]').value), calls);
      const design = Number(q<HTMLSelectElement>('[data-design]').value);
      q('[data-cv]').textContent = String(calls); q('[data-bv]').textContent = String(burst);
      const instances = design === 0 ? burst : 1;
      const locks = design === 0 ? 0 : design === 1 ? calls : burst;
      const unsafe = design === 3;
      setBox(1, String(instances), instances === 1 ? 'one shared instance' : `each of the ${burst} callers at the start built its own`, instances === 1 ? 'good' : 'bad');
      setBox(2, String(locks), design === 1 ? 'every call takes the lock, even long after the object exists' : design === 0 ? 'there is no lock at all' : 'only the callers at the start, the rest take the fast path', design === 1 ? 'bad' : 'good');
      setBox(3, unsafe ? 'Possible' : 'No', unsafe ? 'the reference may be seen before the object is fully built' : 'the reference is published safely', unsafe ? 'bad' : 'good');
      q('[data-verdict]').textContent = design === 0 ? 'Check-then-create without a lock lets every early caller build an object.'
        : design === 1 ? 'Correct, but every call for the rest of the program pays for a lock it does not need.'
        : design === 2 ? 'Correct and fast. In real code, prefer the language\'s own lazy tool, such as Lazy<T> in C#, to a hand-written version.'
        : 'This looks identical, but without volatile or an atomic the pattern is broken: a thread can use an object whose fields are not yet visible to it.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
