---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Threads share a cache that is mostly read. Compare one plain lock with a read-write lock, and see how readers that never stop can keep a writer out.">
  <ol class="how">
    <li>Start with the defaults: <b>Threads</b> at <b>8</b>, <b>Writes</b> at <b>10</b>, <b>Readers arrive constantly</b> <b>No</b> and <b>Lock</b> <b>Plain mutex</b>. Throughput is <b>1</b> times a plain mutex, by definition, and a writer waits up to <b>70</b> ms behind the other threads.</li>
    <li>Set <b>Lock</b> to <b>Read-write, readers first</b>: throughput rises to <b>4.7</b> times, and a writer waits <b>10</b> ms for the current readers to leave.</li>
    <li>Set <b>Readers arrive constantly</b> to <b>Yes</b>: with readers first the writer waits <b>never</b>, since new readers keep getting in.</li>
    <li>Set <b>Lock</b> to <b>Read-write, fair</b>: throughput stays <b>4.7</b> times and the writer waits <b>10</b> ms, because new readers queue behind it.</li>
    <li>Set <b>Writes</b> to <b>50</b>: throughput falls to <b>1.8</b> times. Set <b>Writes</b> to <b>0</b>: it is <b>8</b> times, one for each thread.</li>
  </ol>
  <div class="pg rwl" data-rwl>
    <div class="pg-row">
      <label>Threads <input class="pg-in" type="range" min="2" max="32" step="1" value="8" data-n /> <b data-nv></b></label>
      <label>Writes <input class="pg-in" type="range" min="0" max="50" step="10" value="10" data-w /> <b data-wv></b> %</label>
      <label>Readers arrive constantly <select class="pg-in" data-busy><option value="0" selected>No</option><option value="1">Yes</option></select></label>
      <label>Lock <select class="pg-in" data-lock><option value="0" selected>Plain mutex</option><option value="1">Read-write, readers first</option><option value="2">Read-write, fair</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Throughput compared with a plain mutex</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Longest wait of a writer</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // Each operation takes OP_MS while holding the lock. Readers share the lock, writers are alone: speed-up = 1 / (w + (1 - w) / n).
  const OP_MS = 10;
  type Tone = 'good' | 'bad' | 'mid';
  const trim = (n: number) => String(Number(n.toFixed(1)));
  document.querySelectorAll<HTMLElement>('[data-rwl]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const n = Number(q<HTMLInputElement>('[data-n]').value), w = Number(q<HTMLInputElement>('[data-w]').value) / 100;
      const busy = q<HTMLSelectElement>('[data-busy]').value === '1', lock = Number(q<HTMLSelectElement>('[data-lock]').value);
      q('[data-nv]').textContent = String(n); q('[data-wv]').textContent = String(Math.round(w * 100));
      const speedup = lock === 0 ? 1 : 1 / (w + (1 - w) / n);
      setBox(1, `${trim(speedup)} x`, lock === 0 ? 'every operation takes its turn' : `readers share the lock, so up to ${n} of them run together`, lock === 0 ? 'mid' : speedup >= 2 ? 'good' : 'mid');
      if (w === 0) setBox(2, 'no writers', 'with no writes there is nobody to wait', 'good');
      else if (lock === 0) setBox(2, `${(n - 1) * OP_MS} ms`, `it queues behind the other ${n - 1} threads' operations`, n > 4 ? 'bad' : 'mid');
      else if (lock === 1 && busy) setBox(2, 'never', 'new readers keep arriving, so the number of readers never reaches zero', 'bad');
      else setBox(2, `${OP_MS} ms`, lock === 2 ? 'new readers queue behind the writer, so only the current readers must leave' : 'the current readers leave, and no new ones arrive', 'good');
      q('[data-verdict]').textContent = lock === 0
        ? 'A plain mutex is simple and fair, but readers wait for each other.'
        : lock === 1 ? 'Readers-first keeps reads fast, but with readers always arriving a writer can starve.'
        : 'A fair policy admits the waiting writer before newer readers, so writers are not starved, at a small cost in read parallelism.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
