---
import PlaygroundShell from '../components/PlaygroundShell.astro';
import RangeField from '../components/RangeField.astro';
---
<PlaygroundShell title="Simulate it" hint="A catalogue of 40 popular shopping searches, each with a count. Type a prefix and compare four ways to answer it. 'Looked at' counts the entries (list items, trie nodes or postings) the method reads for that one keystroke; 'stores' counts the entries it keeps in memory.">
  <ol class="how">
    <li>Leave <b>Prefix</b> as <b>ip</b>, <b>Suggestions (k)</b> at 3 and <b>Order</b> on <b>Most popular first</b>: the suggestions are iphone, iphone 15 and ipad. The sorted list reads <b>16</b> entries, the plain trie <b>39</b> nodes and the edge n-grams <b>11</b> postings. Storing the answers costs memory: <b>40</b> entries for the sorted list, <b>250</b> for the trie, <b>598</b> with top-k at each node and <b>645</b> for edge n-grams.</li>
    <li>Set <b>Prefix</b> to <b>i</b>: a short prefix matches the most queries. The plain trie now reads <b>78</b> nodes and the sorted list <b>21</b> entries, but the trie with top-k stored at each node still reads 4: it paid in memory, once, so each keystroke costs almost nothing.</li>
    <li>Set <b>Prefix</b> back to <b>ip</b> and <b>Order</b> to <b>Alphabetical</b>: the suggestions become ipad, ipad case and ipad pro, and the plain trie reads only <b>12</b> nodes. Alphabetical order is cheaper to find and useless to a shopper: iphone, searched <b>9,800</b> times, is no longer offered.</li>
    <li>In the typing box, <b>14</b> keystrokes send <b>14</b> requests. Set <b>Cache the first characters</b> to <b>2</b>: <b>12</b> reach the backend, which is <b>120,000</b> for <b>10,000</b> people. Then set <b>Debounce</b> to <b>200 ms</b>: only <b>3</b> requests are sent, <b>30,000</b> for 10,000 people, but suggestions appear only when the typist pauses.</li>
  </ol>
  <div class="pg ac" data-ac>
    <div class="pg-row">
      <label>Prefix <input class="pg-in" type="text" value="ip" maxlength="20" autocomplete="off" spellcheck="false" data-prefix /></label>
      <label>Method <select class="pg-in" data-method><option value="0" selected>Sorted list + binary search</option><option value="1">Trie</option><option value="2">Trie with top-k at each node</option><option value="3">Edge n-grams in an index</option></select></label>
      <RangeField label="Suggestions (k)" name="k" min="1" max="8" step="1" value="3" readout="3" />
      <label>Order <select class="pg-in" data-order><option value="1" selected>Most popular first</option><option value="0">Alphabetical</option></select></label>
    </div>
    <div class="pg-box" style="--c: var(--accent)">
      <h3>Suggestions</h3>
      <ol class="ac-sugg" data-sugg></ol>
      <span class="pg-note" data-n0></span>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-m0><h3>Sorted list + binary search</h3><span class="pg-mono" data-o0></span><span class="pg-note" data-d0>binary search for the first entry at or after the prefix, then read every match</span></div>
      <div class="pg-box" data-m1><h3>Trie</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-d1>walk down the prefix, then visit every node below it</span></div>
      <div class="pg-box" data-m2><h3>Trie with top-k at each node</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-d2>walk down the prefix, then read the k answers stored there</span></div>
      <div class="pg-box" data-m3><h3>Edge n-grams in an index</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-d3>every query is indexed under each of its prefixes; one term lookup returns the postings</span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>One person types "iphone 15 case"</h3>
      <div class="pg-row">
        <label>Debounce <select class="pg-in" data-debounce><option value="0" selected>Off</option><option value="100">100 ms</option><option value="200">200 ms</option><option value="300">300 ms</option></select></label>
        <label>Cache the first characters <select class="pg-in" data-cache><option value="0" selected>0</option><option value="1">1</option><option value="2">2</option></select></label>
      </div>
      <span class="pg-mono" data-typing></span>
      <span class="pg-note" data-n5></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  type Q = [string, number];
  const QUERIES: Q[] = [
    ['ipad', 5200], ['ipad case', 2100], ['ipad pro', 3300], ['iphone', 9800], ['iphone 15', 8700], ['iphone 15 case', 4100],
    ['iphone 15 pro', 3900], ['iphone charger', 2600], ['iphone case', 3000], ['ipod', 600], ['ice maker', 900],
    ['ice cream maker', 1500], ['icon pack', 300], ['ikea desk', 1800], ['ikea shelf', 1100], ['headphones', 7600],
    ['headphones wireless', 3400], ['hdmi cable', 2300], ['hard drive', 2800], ['hair dryer', 4300], ['laptop', 8100],
    ['laptop stand', 2500], ['laptop bag', 2000], ['laptop charger', 3100], ['lamp', 1400], ['keyboard', 6200],
    ['keyboard mechanical', 2900], ['kindle', 3600], ['kitchen scale', 800], ['monitor', 5900], ['monitor arm', 1700],
    ['mouse', 5400], ['mouse pad', 2200], ['microwave', 2400], ['mattress', 3700], ['phone case', 6800],
    ['phone charger', 4600], ['power bank', 3500], ['printer', 4900], ['printer ink', 2700],
  ];
  const SORTED = [...QUERIES].sort((a, b) => (a[0] < b[0] ? -1 : 1));
  const MAX_GRAM = 20;
  interface Node { kids: Record<string, Node>; query: Q | null }
  interface Answer { results: string[]; looked: number; memory: number }

  const byPopularity = (a: Q, b: Q) => b[1] - a[1] || (a[0] < b[0] ? -1 : 1);
  const pick = (list: Q[], k: number, popular: boolean) => (popular ? [...list].sort(byPopularity) : list).slice(0, k).map((q) => q[0]);

  const root: Node = { kids: {}, query: null };
  let nodes = 0;
  for (const q of SORTED) {
    let n = root;
    for (const ch of q[0]) { if (!n.kids[ch]) { n.kids[ch] = { kids: {}, query: null }; nodes++; } n = n.kids[ch]; }
    n.query = q;
  }
  const subtree = (n: Node, out: Q[] = []): Q[] => { if (n.query) out.push(n.query); for (const ch of Object.keys(n.kids).sort()) subtree(n.kids[ch], out); return out; };
  const size = (n: Node): number => 1 + Object.values(n.kids).reduce((s, c) => s + size(c), 0);

  // The same four methods as the code samples.
  function sortedList(prefix: string, k: number, popular: boolean): Answer {
    let lo = 0, hi = SORTED.length, compares = 0;
    while (lo < hi) { const mid = (lo + hi) >> 1; compares++; if (SORTED[mid][0] < prefix) lo = mid + 1; else hi = mid; }
    const found: Q[] = [];
    let looked = compares;
    for (let i = lo; i < SORTED.length; i++) {
      looked++;
      if (!SORTED[i][0].startsWith(prefix)) break;
      found.push(SORTED[i]);
      if (!popular && found.length === k) break;
    }
    return { results: pick(found, k, popular), looked, memory: SORTED.length };
  }
  function trie(prefix: string, k: number, popular: boolean): Answer {
    let n: Node | undefined = root, looked = 0;
    for (const ch of prefix) { n = n.kids[ch]; if (!n) return { results: [], looked, memory: nodes }; looked++; }
    if (!popular) {
      const found: Q[] = [];
      const walk = (m: Node) => { if (found.length >= k) return; looked++; if (m.query) found.push(m.query); for (const ch of Object.keys(m.kids).sort()) walk(m.kids[ch]); };
      walk(n); looked--;
      return { results: found.map((q) => q[0]), looked, memory: nodes };
    }
    looked += size(n) - 1;
    return { results: pick(subtree(n), k, true), looked, memory: nodes };
  }
  function topK(prefix: string, k: number, popular: boolean): Answer {
    let n: Node | undefined = root, looked = 0, stored = 0;
    const count = (m: Node) => { stored += Math.min(k, subtree(m).length); for (const ch of Object.keys(m.kids)) count(m.kids[ch]); };
    count(root);
    for (const ch of prefix) { n = n.kids[ch]; if (!n) return { results: [], looked, memory: nodes + stored }; looked++; }
    const results = pick(subtree(n), k, popular);
    return { results, looked: looked + results.length, memory: nodes + stored };
  }
  function edgeNgram(prefix: string, k: number, popular: boolean): Answer {
    const postings = new Map<string, Q[]>();
    let total = 0;
    for (const q of SORTED) for (let len = 1; len <= Math.min(q[0].length, MAX_GRAM); len++) {
      const term = q[0].slice(0, len);
      if (!postings.has(term)) postings.set(term, []);
      postings.get(term)!.push(q); total++;
    }
    const list = postings.get(prefix) || [];
    return { results: pick(list, k, popular), looked: 1 + (popular ? list.length : Math.min(k, list.length)), memory: postings.size + total };
  }
  const METHODS = [sortedList, trie, topK, edgeNgram];

  const TEXT = 'iphone 15 case';
  const GAPS = [120, 110, 140, 100, 130, 90, 250, 120, 110, 260, 130, 100, 120];
  function typing(debounce: number, cacheChars: number) {
    const lengths: number[] = [];
    for (let i = 0; i < TEXT.length; i++) if (debounce === 0 || i === TEXT.length - 1 || GAPS[i] >= debounce) lengths.push(i + 1);
    return { sent: lengths.length, backend: lengths.filter((len) => len > cacheChars).length };
  }

  document.querySelectorAll<HTMLElement>('[data-ac]').forEach((root_) => {
    const q = query(root_);
    function draw() {
      const prefix = q<HTMLInputElement>('[data-prefix]').value.toLowerCase();
      const method = Number(q<HTMLSelectElement>('[data-method]').value);
      const k = Number(q<HTMLInputElement>('[data-k]').value);
      const popular = q<HTMLSelectElement>('[data-order]').value === '1';
      q('[data-kval]').textContent = String(k);
      const sugg = q('[data-sugg]'); sugg.textContent = '';
      const answers = METHODS.map((fn) => fn(prefix, k, popular));
      for (const text of answers[method].results) {
        const li = document.createElement('li');
        const count = QUERIES.find((x) => x[0] === text)![1];
        li.textContent = `${text}  (${formatThousands(count)} searches)`;
        sugg.appendChild(li);
      }
      q('[data-n0]').textContent = prefix === '' ? 'Type a prefix to see suggestions.' : answers[method].results.length === 0 ? 'No stored query starts with this prefix.' : popular ? 'Ranked by how often each query was searched.' : 'Ranked alphabetically: the most popular queries are not necessarily shown.';
      answers.forEach((a, i) => {
        q(`[data-o${i}]`).textContent = prefix === '' ? '' : `looked at ${formatThousands(a.looked)}, stores ${formatThousands(a.memory)}`;
        const b = q<HTMLElement>(`[data-m${i}]`);
        b.classList.toggle('lit', i === method);
        b.style.setProperty('--c', i === method ? 'var(--accent)' : 'var(--border)');
      });
      const debounce = Number(q<HTMLSelectElement>('[data-debounce]').value);
      const cache = Number(q<HTMLSelectElement>('[data-cache]').value);
      const t = typing(debounce, cache);
      q('[data-typing]').textContent = `${TEXT.length} keystrokes: ${t.sent} requests sent, ${t.backend} reach the backend, ${formatThousands(t.backend * 10000)} for 10,000 people typing it`;
      q('[data-n5]').textContent = (debounce === 0 ? 'Every keystroke sends a request. ' : `A request is sent only when the typist pauses for ${debounce} ms (or stops). `) + (cache === 0 ? 'Nothing is cached.' : `The first ${cache} character${cache === 1 ? '' : 's'} of every query are answered from a cache, since the same few short prefixes are typed by everyone.`);
    }
    root_.addEventListener('input', draw);
    root_.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .ac-sugg { margin: 0; padding-left: 1.6rem; font: .9rem var(--font-mono); }
  .playground .ac-sugg:empty { display: none; }
</style>
