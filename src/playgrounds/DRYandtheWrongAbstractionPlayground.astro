---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A year of 20 change requests to two shipping functions. Some concern both cases (the carrier changes its price list), the rest only retail or only wholesale. Choose how many diverge and how the code was organised, and count the edits and the risk.">
  <ol class="how">
    <li>Start with the defaults: <b>Divergent changes (%)</b> at <b>50</b> and <b>Design</b> <b>Merged with flags</b>. Ten of the 20 requests concern one case, so the merged function ends up with <b>10</b> flags and <b>1,024</b> possible paths, and the year costs <b>31</b> edits.</li>
    <li>Set <b>Design</b> to <b>Copy-paste</b>: the year costs <b>30</b> edits, and <b>10</b> shared changes could miss one of the two copies. Set <b>Design</b> to <b>Shared core with separate edges</b>: <b>21</b> edits and no flags.</li>
    <li>Set <b>Divergent changes (%)</b> to <b>0</b>: copy-paste now costs <b>40</b> edits and <b>20</b> risky changes, and merging is cheap at <b>21</b>. Set it to <b>100</b> and <b>Design</b> to <b>Merged with flags</b>: <b>41</b> edits, <b>20</b> flags and <b>1,048,576</b> paths.</li>
  </ol>
  <div class="pg dry" data-dry>
    <div class="pg-row">
      <label>Divergent changes (%) <input class="pg-in" type="range" min="0" max="100" step="5" value="50" data-pct /> <b data-pctv></b></label>
      <label>Design <select class="pg-in" data-design><option value="merged" selected>Merged with flags</option><option value="copy">Copy-paste</option><option value="core">Shared core with separate edges</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Total edits in the year</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Flags in the merged function</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Paths to reason about</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Bug-risk points</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Edits per design, as more requests diverge</h3>
      <div class="dry-scroll" tabindex="0" role="region" aria-label="Edits per design at each share of divergent changes"><table class="dry-table" data-table></table></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const N = 20;
  type Design = 'copy' | 'merged' | 'core';
  interface Year { edits: number; flags: number; paths: number; risk: number }

  // The same model as the code samples. copy: a shared change is made twice, a divergent one once. merged: the merge is 1 edit,
  // a shared change 1, a divergent one 2 (flag and call); each divergent change adds a flag, and flags combine into 2^flags paths.
  // core: extracting the core is 1 edit, then every change is 1 edit.
  function year(pct: number, design: Design): Year {
    const d = (N * pct) / 100, s = N - d;
    if (design === 'copy') return { edits: 2 * s + d, flags: 0, paths: 1, risk: s };
    if (design === 'merged') return { edits: 1 + s + 2 * d, flags: d, paths: 2 ** d, risk: d };
    return { edits: 1 + N, flags: 0, paths: 1, risk: 0 };
  }
  const NAMES: Record<Design, string> = { copy: 'Copy-paste', merged: 'Merged with flags', core: 'Shared core with separate edges' };

  document.querySelectorAll<HTMLElement>('[data-dry]').forEach((root) => {
    const q = query(root);
    const setBox = (n: number, value: string, note: string, good: boolean | null) => {
      q(`[data-o${n}]`).textContent = value; q(`[data-n${n}]`).textContent = note;
      q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good === null ? 'var(--border)' : good ? 'var(--good)' : 'var(--bad)');
    };
    function draw() {
      const pct = Number(q<HTMLInputElement>('[data-pct]').value), design = q<HTMLSelectElement>('[data-design]').value as Design;
      q('[data-pctv]').textContent = `${pct}% (${(N * pct) / 100} of ${N} requests)`;
      const r = year(pct, design), all = (['copy', 'merged', 'core'] as Design[]).map((x) => year(pct, x).edits);
      setBox(1, `${r.edits}`, design === 'copy' ? 'a shared change is made in both copies' : design === 'merged' ? 'a divergent change costs the flag and the call that sets it' : 'one edit each, in the core or in one edge', r.edits === Math.min(...all));
      const m = year(pct, 'merged');
      setBox(2, `${m.flags}`, design === 'merged' ? 'one more parameter for every request that concerns one case' : 'what the merged design would have: this design has none', design === 'merged' ? m.flags < 3 : null);
      setBox(3, formatThousands(m.paths), design === 'merged' ? 'flag combinations, 2 to the power of the flags' : 'merged design shown for comparison: this one has 1 path per function', design === 'merged' ? m.paths < 8 : null);
      setBox(4, `${r.risk}`, design === 'copy' ? 'shared changes, each of which could miss a copy' : design === 'merged' ? 'flag branches a change for one case can reach by mistake' : 'the true rule has one home and the edges are apart', r.risk <= 2);
      const table = q('[data-table]'); table.textContent = '';
      const head = table.insertRow(); ['Divergent (%)', 'Copy-paste', 'Merged with flags', 'Shared core'].forEach((h) => { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); });
      for (let p = 0; p <= 100; p += 25) {
        const row = table.insertRow(); if (p === pct) row.className = 'on';
        [`${p}`, ...(['copy', 'merged', 'core'] as Design[]).map((x) => `${year(p, x).edits}`)].forEach((v) => { row.insertCell().textContent = v; });
      }
      let cross = -1; for (let p = 0; p <= 100; p += 5) if (year(p, 'merged').edits > year(p, 'copy').edits) { cross = p; break; }
      q('[data-verdict]').textContent = `${NAMES[design]} at ${pct}% divergent: ${r.edits} edits. Merging costs more edits than copy-paste from ${cross}% divergent on, and the shared core never costs more than ${Math.max(...[0, 25, 50, 75, 100].map((p) => year(p, 'core').edits))}.`;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .dry-scroll { overflow-x: auto; }
  .playground .dry-table { border-collapse: collapse; font: .82rem var(--font-mono); min-width: 100%; }
  .playground .dry-table th, .playground .dry-table td { padding: 4px 8px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
  .playground .dry-table th:first-child, .playground .dry-table td:first-child { text-align: left; }
  .playground .dry-table tr.on td { font-weight: 700; background: var(--accent-soft); }
</style>
