---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="100 orders go through four layers: API, service, pricing and ledger. Some carry bad user input, some hit a bug in our own service. Choose where the checks live and see what is caught, what is paid, and what reaches the ledger wrong.">
  <ol class="how">
    <li>Start with <b>Bad user input (%)</b> at <b>20</b>, <b>Bugs in our own code (%)</b> at <b>10</b> and <b>Design</b> <b>Contract: boundary and postcondition</b>. All <b>30</b> bad requests are stopped, <b>0</b> wrong records are written, and it costs <b>260</b> checks.</li>
    <li>Set <b>Design</b> to <b>Check everything everywhere</b>: the same <b>0</b> wrong records, but <b>940</b> checks, <b>12</b> for each good request, and the quantity rule in <b>4</b> places.</li>
    <li>Set <b>Design</b> to <b>Repair silently</b>: no request is rejected, <b>1,200</b> checks run, and <b>30</b> wrong records are written that look fine.</li>
    <li>Set <b>Design</b> back to <b>Contract: boundary and postcondition</b> and untick <b>Internal contract checks on</b>: the boundary still stops the user mistakes, but the <b>10</b> bugs become wrong records and the cost falls to <b>180</b> checks.</li>
  </ol>
  <div class="pg dbc" data-dbc>
    <div class="pg-row">
      <label>Bad user input (%) <input class="pg-in" type="range" min="0" max="50" step="10" value="20" data-user /> <b data-userv></b></label>
      <label>Bugs in our own code (%) <input class="pg-in" type="range" min="0" max="30" step="10" value="10" data-bug /> <b data-bugv></b></label>
      <label>Design <select class="pg-in" data-design><option value="trust">Trust everyone</option><option value="everywhere">Check everything everywhere</option><option value="contract" selected>Contract: boundary and postcondition</option><option value="repair">Repair silently</option></select></label>
      <label><input type="checkbox" data-internals checked /> Internal contract checks on</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Correct records</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Wrong records written</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Stopped loudly</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Checks run</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Checks per good request</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Places holding the quantity rule</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Every design at these settings</h3>
      <div class="dbc-scroll" tabindex="0" role="region" aria-label="Correct, wrong and checks for each design"><table class="dbc-table" data-table></table></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  type Design = 'trust' | 'everywhere' | 'contract' | 'repair';
  interface R { correct: number; rejected: number; loud: number; wrong: number; checks: number }
  const N = 100;

  // The same model as the code samples. checks: everywhere 12 per good request, 1 for a rejected one, 8 for a bug (api 3, service 3,
  // pricing 2); contract 3, 1, 3; contract with internal checks off 2, 1, 2; repair 12 for every request; trust none.
  function model(design: Design, u: number, b: number, internals: boolean): R {
    const user = Math.floor((N * u) / 100), bug = Math.floor((N * b) / 100), ok = N - user - bug;
    if (design === 'trust') return { correct: ok, rejected: 0, loud: 0, wrong: user + bug, checks: 0 };
    if (design === 'everywhere') return { correct: ok, rejected: user, loud: bug, wrong: 0, checks: ok * 12 + user + bug * 8 };
    if (design === 'contract' && internals) return { correct: ok, rejected: user, loud: bug, wrong: 0, checks: ok * 3 + user + bug * 3 };
    if (design === 'contract') return { correct: ok, rejected: user, loud: 0, wrong: bug, checks: ok * 2 + user + bug * 2 };
    return { correct: ok, rejected: 0, loud: 0, wrong: user + bug, checks: N * 12 };
  }
  const PER_GOOD = (d: Design, internals: boolean) => (d === 'trust' ? 0 : d === 'contract' ? (internals ? 3 : 2) : 12);
  const PLACES: Record<Design, number> = { trust: 0, everywhere: 4, contract: 1, repair: 4 };
  const ROWS: [string, Design, boolean][] = [['Trust everyone', 'trust', true], ['Check everything everywhere', 'everywhere', true],
    ['Contract', 'contract', true], ['Contract, internal checks off', 'contract', false], ['Repair silently', 'repair', true]];
  const NAMES: Record<Design, string> = { trust: 'Trust everyone', everywhere: 'Check everything everywhere', contract: 'Contract', repair: 'Repair silently' };

  document.querySelectorAll<HTMLElement>('[data-dbc]').forEach((root) => {
    const q = query(root);
    const setBox = (n: number, value: string, note: string, good: boolean | null) => {
      q(`[data-o${n}]`).textContent = value; q(`[data-n${n}]`).textContent = note;
      q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good === null ? 'var(--border)' : good ? 'var(--good)' : 'var(--bad)');
    };
    function draw() {
      const u = Number(q<HTMLInputElement>('[data-user]').value), b = Number(q<HTMLInputElement>('[data-bug]').value);
      const design = q<HTMLSelectElement>('[data-design]').value as Design, internals = q<HTMLInputElement>('[data-internals]').checked;
      q('[data-userv]').textContent = `${u}% (${Math.floor((N * u) / 100)} of ${N})`;
      q('[data-bugv]').textContent = `${b}% (${Math.floor((N * b) / 100)} of ${N})`;
      const r = model(design, u, b, internals), noteInternals = design === 'contract' && !internals;
      setBox(1, `${r.correct}`, 'requests recorded with the right total', null);
      setBox(2, `${r.wrong}`, r.wrong === 0 ? 'nothing wrong reaches the ledger' : design === 'repair' ? 'repaired quietly: they look valid, so nobody notices' : 'bad input or bugs recorded as if they were orders', r.wrong === 0);
      setBox(3, `${r.rejected + r.loud}`, `${r.rejected} rejected at the boundary, ${r.loud} failed at the layer that broke its contract`, r.rejected + r.loud > 0 || r.wrong === 0 ? true : null);
      setBox(4, formatThousands(r.checks), 'conditions evaluated for these 100 requests', r.checks <= 300 ? true : r.checks >= 900 ? false : null);
      setBox(5, `${PER_GOOD(design, internals)}`, design === 'everywhere' ? 'every layer re-checks what the layer above already checked' : design === 'repair' ? 'clamps in every layer, on every request' : noteInternals ? 'the boundary only: quantity and price' : design === 'contract' ? 'two preconditions at the boundary, one postcondition in pricing' : 'no checks at all', null);
      setBox(6, `${PLACES[design]}`, design === 'contract' ? 'one: the boundary' : design === 'trust' ? 'nobody states the rule' : 'every layer carries its own copy: a changed limit means editing each', design === 'contract' ? true : design === 'trust' ? null : false);
      const table = q('[data-table]'); table.textContent = '';
      const head = table.insertRow(); ['Design', 'Correct', 'Wrong', 'Checks'].forEach((h) => { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); });
      ROWS.forEach(([name, d, i]) => {
        const x = model(d, u, b, i), row = table.insertRow(); if (d === design && (d !== 'contract' || i === internals)) row.className = 'on';
        [name, `${x.correct}`, `${x.wrong}`, formatThousands(x.checks)].forEach((v) => { row.insertCell().textContent = v; });
      });
      q('[data-verdict]').textContent = `${NAMES[design]}${noteInternals ? ' with internal checks off' : ''}: ${r.wrong} wrong records and ${formatThousands(r.checks)} checks. Internal checks find bugs in our own code; they do not replace validating what comes from outside.`;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .dbc-scroll { overflow-x: auto; }
  .playground .dbc-table { border-collapse: collapse; font: .82rem var(--font-mono); min-width: 100%; }
  .playground .dbc-table th, .playground .dbc-table td { padding: 4px 8px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
  .playground .dbc-table th:first-child, .playground .dbc-table td:first-child { text-align: left; }
  .playground .dbc-table tr.on td { font-weight: 700; background: var(--accent-soft); }
</style>
