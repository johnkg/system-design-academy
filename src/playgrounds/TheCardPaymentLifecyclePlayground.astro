---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="One order of 100.00 on a card with 500.00 available. Authorize it, capture all or part of it, void it, refund it, and move the calendar forward. The rules that refuse an action are shown with their reason. Amounts are in cents, so 10000 is 100.00; the fee and delay settings are illustrative.">
  <ol class="how">
    <li>Press <b>Authorize</b>: the cardholder's available balance drops from 50000 to <b>40000</b> and <b>10000</b> is held, but nothing is charged yet. Press <b>Capture all</b>: the hold becomes a charge, the fee is <b>320</b> (2.9% plus 30), and the merchant has <b>9680</b> pending. Press <b>Advance day</b> twice, the settlement time, and it moves to settled.</li>
    <li>Press <b>Reset</b>, <b>Authorize</b>, then <b>Partial capture</b> (4000 by default): the fee is <b>146</b> and <b>6000</b> is still held. Press <b>Advance day</b> 7 times, the hold limit: the remaining hold is released and the available balance is <b>46000</b>. Press <b>Capture all</b> and it is rejected, because the hold expired on day 7.</li>
    <li>Press <b>Reset</b>, <b>Authorize</b>, <b>Partial capture</b>, set <b>Money to refund (cents)</b> to <b>10000</b> and press <b>Refund</b>: it is rejected, because only <b>4000</b> was captured. Set <b>Money to refund (cents)</b> to <b>2500</b> and press <b>Refund</b> again: it works, and the available balance is <b>42500</b>.</li>
    <li>Set <b>Merchant fee percent</b> to <b>3.5%</b> and <b>Fixed fee per capture (cents)</b> to <b>0</b>, press <b>Reset</b>, <b>Authorize</b> and <b>Capture all</b>: the fee is <b>350</b> and the merchant gets <b>9650</b> instead of <b>9680</b>. A <b>Void</b> instead of the capture would put the available balance back to <b>50000</b>.</li>
  </ol>
  <div class="pg cp" data-cp>
    <div class="pg-row">
      <label>Hold expires after (days) <select class="pg-in" data-expiry><option value="3">3</option><option value="7" selected>7</option><option value="30">30</option></select></label>
      <label>Settlement takes (days) <select class="pg-in" data-settle><option value="1">1</option><option value="2" selected>2</option><option value="3">3</option></select></label>
      <label>Merchant fee percent <select class="pg-in" data-pct><option value="150">1.5%</option><option value="290" selected>2.9%</option><option value="350">3.5%</option></select></label>
      <label>Fixed fee per capture (cents) <select class="pg-in" data-fixed><option value="0">0</option><option value="10">10</option><option value="30" selected>30</option></select></label>
    </div>
    <div class="pg-row">
      <label>Portion to capture (cents) <input class="pg-in" type="number" min="1" max="10000" step="1" value="4000" data-part /></label>
      <label>Money to refund (cents) <input class="pg-in" type="number" min="1" max="10000" step="1" value="2500" data-refund /></label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-op="authorize">Authorize</button>
      <button class="btn" type="button" data-op="capture">Capture all</button>
      <button class="btn" type="button" data-op="partial">Partial capture</button>
      <button class="btn" type="button" data-op="void">Void</button>
      <button class="btn" type="button" data-op="refund">Refund</button>
      <button class="btn" type="button" data-op="advance">Advance day</button>
      <button class="btn" type="button" data-op="reset">Reset</button>
    </div>
    <div class="pg-out" data-msg aria-live="polite"></div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Day</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Cardholder available</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Held (authorization)</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Captured (charged)</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Refunded</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Fees</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
      <div class="pg-box" data-b7><h3>Merchant pending</h3><span class="pg-mono" data-o7></span><span class="pg-note" data-n7></span></div>
      <div class="pg-box" data-b8><h3>Merchant settled</h3><span class="pg-mono" data-o8></span><span class="pg-note" data-n8></span></div>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="What happened, in order"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const OPENING = 50000; const ORDER = 10000;

  interface Settings { expiry: number; settle: number; bp: number; fixed: number }
  // The same model as the code samples, with the settings read at the moment of each action.
  function divRoundUp(num: number, den: number): number { const q = (num - (num % den)) / den; return 2 * (num - q * den) >= den ? q + 1 : q; }
  function newPayment() {
    const p = { day: 0, available: OPENING, held: 0, captured: 0, refunded: 0, fees: 0, pending: 0, settled: 0, authDay: -1, ended: '', endedDay: -1, due: [] as number[][] };
    return p;
  }
  type Payment = ReturnType<typeof newPayment>;
  interface Result { ok: boolean; text: string }
  const reject = (reason: string): Result => ({ ok: false, text: `rejected: ${reason}` });
  const ok = (text: string): Result => ({ ok: true, text });

  const authorize = (p: Payment, amount: number): Result => {
    if (p.authDay >= 0) return reject('an authorization already exists for this order');
    if (p.available < amount) return reject(`the card has ${p.available} available, ${amount} needed`);
    p.available -= amount; p.held = amount; p.authDay = p.day;
    return ok(`hold of ${amount} placed, nothing charged yet`);
  };
  const capture = (p: Payment, amount: number, s: Settings): Result => {
    if (p.authDay < 0) return reject('there is no authorization to capture');
    if (p.ended === 'expired') return reject(`the hold expired on day ${p.endedDay}`);
    if (p.ended === 'voided') return reject(`the authorization was voided on day ${p.endedDay}`);
    if (amount > p.held) return reject(p.held === 0 ? 'everything held was already captured' : `capture of ${amount} is above the ${p.held} still held`);
    const fee = divRoundUp(amount * s.bp, 10000) + s.fixed;
    p.held -= amount; p.captured += amount; p.fees += fee; p.pending += amount - fee;
    p.due.push([p.day + s.settle, amount - fee]);
    return ok(`captured ${amount}, fee ${fee}, merchant will receive ${amount - fee} on day ${p.day + s.settle}`);
  };
  const voidHold = (p: Payment): Result => {
    if (p.held === 0) return reject('there is no hold left to release');
    const released = p.held; p.available += released; p.held = 0; p.ended = 'voided'; p.endedDay = p.day;
    return ok(`released the hold of ${released}`);
  };
  const refund = (p: Payment, amount: number): Result => {
    const left = p.captured - p.refunded;
    if (amount > left) return reject(`refund of ${amount} is above the ${left} captured and not yet refunded`);
    p.refunded += amount; p.available += amount;
    return ok(`refunded ${amount} to the cardholder`);
  };
  const LAST_DAY = 35;
  const advance = (p: Payment, s: Settings): Result => {
    if (p.day >= LAST_DAY) return reject(`the simulation stops at day ${LAST_DAY}`);
    p.day += 1;
    const notes: string[] = [];
    for (const d of p.due) if (d[1] > 0 && d[0] <= p.day) { p.pending -= d[1]; p.settled += d[1]; notes.push(`settled ${d[1]} to the merchant`); d[1] = 0; }
    if (p.held > 0 && p.day - p.authDay >= s.expiry) { p.available += p.held; notes.push(`hold expired, ${p.held} released`); p.held = 0; p.ended = 'expired'; p.endedDay = p.day; }
    return ok(`day ${p.day}${notes.length ? ': ' + notes.join('; ') : ''}`);
  };

  document.querySelectorAll<HTMLElement>('[data-cp]').forEach((root) => {
    const q = query(root);
    let p = newPayment();
    let log: Result[] = [];
    const msg = q('[data-msg]');
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    const num = (s: string) => Math.max(1, Math.min(ORDER, Math.floor(Number(q<HTMLInputElement>(s).value) || 1)));
    const settings = (): Settings => ({
      expiry: Number(q<HTMLSelectElement>('[data-expiry]').value), settle: Number(q<HTMLSelectElement>('[data-settle]').value),
      bp: Number(q<HTMLSelectElement>('[data-pct]').value), fixed: Number(q<HTMLSelectElement>('[data-fixed]').value),
    });

    function press(op: string) {
      const s = settings();
      let r: Result;
      if (op === 'reset') { p = newPayment(); log = []; msg.textContent = 'New order of 10000. The card has 50000 available.'; msg.classList.remove('bad'); return; }
      let label = op;
      if (op === 'authorize') r = authorize(p, ORDER);
      else if (op === 'capture') { r = capture(p, p.held > 0 ? p.held : ORDER, s); label = 'capture'; }
      else if (op === 'partial') { const a = num('[data-part]'); r = capture(p, a, s); label = `partial capture ${a}`; }
      else if (op === 'void') r = voidHold(p);
      else if (op === 'refund') { const a = num('[data-refund]'); r = refund(p, a); label = `refund ${a}`; }
      else { r = advance(p, s); label = 'advance day'; }
      log.push({ ok: r.ok, text: `day ${p.day} ${label}: ${r.text}` });
      msg.textContent = r.text; msg.classList.toggle('bad', !r.ok);
    }

    function draw() {
      const s = settings();
      const state = p.authDay < 0 ? 'no authorization yet' : p.ended === 'expired' ? 'hold expired' : p.ended === 'voided' ? 'authorization voided' : p.held > 0 ? (p.captured > 0 ? 'partly captured' : 'authorized') : 'fully captured';
      set(1, String(p.day), state);
      box(1, true);
      set(2, String(p.available), 'opening balance 50000; a hold lowers it before any charge');
      box(2, true);
      set(3, String(p.held), p.held > 0 ? `a hold, not a charge; it ends on day ${p.authDay + s.expiry} if unused` : 'nothing held');
      box(3, p.held === 0);
      set(4, String(p.captured), 'charged to the cardholder');
      box(4, true);
      set(5, String(p.refunded), `${p.captured - p.refunded} captured and still refundable`);
      box(5, true);
      set(6, String(p.fees), `taken from what the merchant receives: ${s.bp / 100}% plus ${s.fixed} cents per capture`);
      box(6, true);
      set(7, String(p.pending), 'captured, but the money has not moved between banks yet');
      box(7, p.pending === 0);
      set(8, String(p.settled), `net of fees, ${s.settle} day${s.settle === 1 ? '' : 's'} after each capture`);
      box(8, true);
      const el = q('[data-log]'); el.textContent = '';
      for (const l of log) { const li = document.createElement('li'); li.textContent = l.text; if (!l.ok) li.className = 'cp-bad'; el.appendChild(li); }
    }
    root.querySelectorAll<HTMLButtonElement>('[data-op]').forEach((b) => b.addEventListener('click', () => { press(b.dataset.op!); draw(); }));
    root.addEventListener('change', draw);
    msg.textContent = 'New order of 10000. The card has 50000 available.';
    draw();
  });
</script>
<style is:global>
  .playground .cp { display: grid; gap: 12px; }
  .playground .cp-bad { color: var(--bad-text); font-weight: 700; }
</style>
