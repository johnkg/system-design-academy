---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A cart whose total should always read 90 (a subtotal of 100 and a one-time coupon of 10), and a ticket counter at 7 shared by two workers. Pick how the methods are designed and what the program does with them, and see what each caller is told.">
  <ol class="how">
    <li>Start with <b>Mixed everywhere</b> and <b>Situation</b> set to <b>Page reads the total 3 times</b>: the page shows <b>90, 100, 100</b>, because the first read spent the coupon. One read changed state and 2 page reads show a wrong total.</li>
    <li>Set <b>Situation</b> to <b>Page plus one debug log read</b>: the log line spends the coupon, and the page shows <b>100, 100, 100</b>, so all 3 reads are wrong. Then set <b>Design</b> to <b>Separated, with a named atomic exception</b>: the page shows <b>90, 90, 90</b> with or without the log line, and 0 reads change state.</li>
    <li>Set <b>Situation</b> to <b>Two workers take a ticket</b> and <b>Design</b> to <b>Strict separation everywhere</b>: both workers peek before either advances, so the tickets issued are <b>7, 7</b>, the counter ends at 9 and 1 number is skipped. Set <b>Design</b> back to <b>Separated, with a named atomic exception</b>: the tickets are <b>7, 8</b> and nothing is lost, in 1 call each.</li>
  </ol>
  <div class="pg cqs" data-cqs>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design>
        <option value="0" selected>Mixed everywhere</option>
        <option value="1">Strict separation everywhere</option>
        <option value="2">Separated, with a named atomic exception</option>
      </select></label>
      <label>Situation <select class="pg-in" data-sit>
        <option value="1" selected>Page reads the total 3 times</option>
        <option value="2">Page plus one debug log read</option>
        <option value="3">Two workers take a ticket</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3 data-h1>What the page shows</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3 data-h2>Reads that changed state</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3 data-h3>Wrong results</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3 data-h4>Calls the caller must make</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The design in one line</h3>
      <span class="pg-note" data-design-note></span>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="What each call returned, in order"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  // The same model as the code samples. The right total is 90; the counter starts at 7.
  class MixedCart {
    coupon = 10;
    total() { let t = 100; if (this.coupon > 0) { t -= this.coupon; this.coupon = 0; } return t; }
  }
  class SeparatedCart {
    discount = 0;
    applyCoupon() { this.discount = 10; }
    total() { return 100 - this.discount; }
  }
  class MixedCounter { n = 7; nextTicket() { return this.n++; } }
  class StrictCounter { n = 7; peek() { return this.n; } advance() { this.n++; } }

  const NOTES = [
    'total() reads and spends the coupon; nextTicket() reads and changes in one atomic step. Simple to call, but the read is not safe to repeat.',
    'Every method is a pure query or a pure command, even taking a ticket. The reads are safe, but the ticket now needs two calls that can interleave.',
    'Reads are pure and the coupon is a command called once. Taking a ticket is one named atomic call (takeTicket), kept as a documented exception.',
  ];

  function cartRun(design: number, situation: number) {
    const reads = situation === 1 ? 3 : 4;
    const shown: number[] = []; const log: string[] = [];
    let changed = 0;
    if (design === 0) {
      const c = new MixedCart();
      for (let i = 0; i < reads; i++) {
        const before = c.coupon; const v = c.total(); shown.push(v);
        const ch = c.coupon !== before; if (ch) changed++;
        log.push(`read ${i + 1}${situation === 2 && i === 0 ? ' (debug log line)' : ''}: total() returned ${v}${ch ? ' and spent the coupon' : ''}`);
      }
    } else {
      const c = new SeparatedCart(); c.applyCoupon();
      log.push('applyCoupon(): discount set to 10, once, at checkout');
      for (let i = 0; i < reads; i++) {
        const v = c.total(); shown.push(v);
        log.push(`read ${i + 1}${situation === 2 && i === 0 ? ' (debug log line)' : ''}: total() returned ${v}`);
      }
    }
    const page = situation === 1 ? shown : shown.slice(1);
    return { page, changed, wrong: page.filter((v) => v !== 90).length, log };
  }

  function ticketRun(design: number) {
    const issued: number[] = []; const log: string[] = [];
    let counter: number;
    if (design === 1) {
      const c = new StrictCounter();
      const a = c.peek(); log.push(`worker A peek(): ${a}`);
      const b = c.peek(); log.push(`worker B peek(): ${b}`);
      c.advance(); log.push('worker A advance()');
      c.advance(); log.push('worker B advance()');
      issued.push(a, b); counter = c.n;
    } else {
      const c = new MixedCounter();
      const a = c.nextTicket(); log.push(`worker A ${design === 2 ? 'takeTicket' : 'nextTicket'}(): ${a}`);
      const b = c.nextTicket(); log.push(`worker B ${design === 2 ? 'takeTicket' : 'nextTicket'}(): ${b}`);
      issued.push(a, b); counter = c.n;
    }
    const distinct = new Set(issued).size;
    return { issued, counter, duplicates: issued.length - distinct, skipped: (counter - 7) - distinct, calls: design === 1 ? 2 : 1, log };
  }

  document.querySelectorAll<HTMLElement>('[data-cqs]').forEach((root) => {
    const q = query(root);
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, head: string, out: string, note: string) => { q(`[data-h${n}]`).textContent = head; q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const design = Number(q<HTMLSelectElement>('[data-design]').value);
      const sit = Number(q<HTMLSelectElement>('[data-sit]').value);
      q('[data-design-note]').textContent = NOTES[design];
      let log: string[];
      if (sit === 3) {
        const t = ticketRun(design); log = t.log;
        log.push(`counter ends at ${t.counter}`);
        set(1, 'Tickets issued', t.issued.join(', '), `the counter ends at ${t.counter}`);
        box(1, t.duplicates === 0);
        set(2, 'Duplicate tickets', String(t.duplicates), t.duplicates ? 'both workers were told the same number' : 'every worker got its own number');
        box(2, t.duplicates === 0);
        set(3, 'Numbers skipped', String(t.skipped), t.skipped ? 'the counter moved past a number nobody received' : 'no number was lost');
        box(3, t.skipped === 0);
        set(4, 'Calls to take one ticket', String(t.calls), t.calls === 2 ? 'peek then advance: the gap between them is where the race lives' : 'one call, so nothing can slip in between');
        box(4, t.calls === 1);
      } else {
        const r = cartRun(design, sit); log = r.log;
        set(1, 'What the page shows', r.page.join(', '), 'the right total is 90 every time');
        box(1, r.wrong === 0);
        set(2, 'Reads that changed state', String(r.changed), r.changed ? 'a read spent the coupon, so the next read differs' : 'every read is safe to repeat');
        box(2, r.changed === 0);
        set(3, 'Page reads showing a wrong total', String(r.wrong), r.wrong ? 'the customer would be charged more than the coupon allowed' : 'all reads agree and are right');
        box(3, r.wrong === 0);
        set(4, 'Commands the caller must call', design === 0 ? '0' : '1', design === 0 ? 'nothing to remember, but nothing to protect the coupon either' : 'applyCoupon() once at checkout, before the reads');
        box(4, true);
      }
      const ol = q('[data-log]'); ol.textContent = '';
      for (const line of log) { const li = document.createElement('li'); li.textContent = line; ol.appendChild(li); }
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
