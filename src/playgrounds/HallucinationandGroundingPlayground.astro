---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A simple model of an assistant answering questions. You set the rates, so the numbers are not measurements: they show how grounding and abstaining change what the user sees. In this model the assistant answers correctly when it knows the answer or retrieval finds it.">
  <ol class="how">
    <li>Start with the defaults: <b>Questions the model knows</b> <b>70</b>, <b>Retrieval finds the answer</b> <b>60</b> and <b>Model abstains when unsure</b> <b>Off</b>. <b>88.0</b> percent of answers are correct, <b>12.0</b> percent are wrong but confident, and <b>0.0</b> percent are declined.</li>
    <li>Set <b>Model abstains when unsure</b> to <b>On</b>: the same <b>88.0</b> percent are correct, the confident errors fall to <b>0.0</b> percent and <b>12.0</b> percent of questions are declined. The error has become an honest not found.</li>
    <li>Set <b>Retrieval finds the answer</b> to <b>0</b> with abstaining <b>Off</b>: only <b>70.0</b> percent are correct and <b>30.0</b> percent are confident errors. Without grounding, whatever the model does not know becomes an error.</li>
    <li>Set <b>Retrieval finds the answer</b> to <b>100</b>: <b>100.0</b> percent are correct. Real retrieval is not perfect, which is why the checker matters.</li>
  </ol>
  <div class="pg hal" data-hal>
    <div class="pg-row">
      <label>Questions the model knows <input class="pg-in" type="range" min="0" max="100" step="5" value="70" data-k /> <b data-kv></b> %</label>
      <label>Retrieval finds the answer <input class="pg-in" type="range" min="0" max="100" step="5" value="60" data-r /> <b data-rv></b> %</label>
      <label>Model abstains when unsure <select class="pg-in" data-abs><option value="0" selected>Off</option><option value="1">On</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Answered correctly</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Wrong, but confident</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Declined</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // correct = known + (1 - known) x retrieved. What neither covers is wrong when the model never abstains, and declined when it always abstains.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-hal]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const known = Number(q<HTMLInputElement>('[data-k]').value) / 100, found = Number(q<HTMLInputElement>('[data-r]').value) / 100;
      const abstain = q<HTMLSelectElement>('[data-abs]').value === '1';
      q('[data-kv]').textContent = String(Math.round(known * 100)); q('[data-rv]').textContent = String(Math.round(found * 100));
      const correct = known + (1 - known) * found, rest = (1 - known) * (1 - found);
      const wrong = abstain ? 0 : rest, declined = abstain ? rest : 0;
      setBox(1, `${(100 * correct).toFixed(1)} %`, 'the model knew it, or retrieval supplied it', 'good');
      setBox(2, `${(100 * wrong).toFixed(1)} %`, wrong > 0 ? 'fluent, confident and unsupported: the hallucination' : 'none, because the model declines when it has no support', wrong > 0 ? 'bad' : 'good');
      setBox(3, `${(100 * declined).toFixed(1)} %`, declined > 0 ? 'an honest not found, which is unhelpful but safe' : 'the assistant always gives an answer', 'mid');
      q('[data-verdict]').textContent = 'Grounding raises the share that is correct. Abstaining turns the rest from confident errors into declined answers. In practice abstaining is not perfect, so claims are also checked against the sources.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
