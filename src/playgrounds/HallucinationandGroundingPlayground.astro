---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A simple model of an assistant answering questions. You set the rates, so the numbers are not measurements: they show how grounding and abstaining change what the user sees. In this model the assistant answers correctly when it knows the answer or retrieval finds it, and a real assistant declines only some of what it cannot support, so you choose how much.">
  <ol class="how">
    <li>Start with the defaults: <b>Questions the model knows</b> <b>70</b>, <b>Retrieval finds the answer</b> <b>60</b> and <b>Declines what it cannot support</b> at <b>0</b>. <b>88.0</b> percent of answers are correct, <b>12.0</b> percent are wrong but confident, and <b>0.0</b> percent are declined.</li>
    <li>Set <b>Declines what it cannot support</b> to <b>100</b>: the same <b>88.0</b> percent are correct, the confident errors fall to <b>0.0</b> percent and <b>12.0</b> percent of questions are declined. That is the ideal, which a real assistant does not reach. Set it to <b>50</b>: <b>6.0</b> percent are still confident errors and <b>6.0</b> percent are declined.</li>
    <li>Set <b>Declines what it cannot support</b> to <b>0</b> and <b>Retrieval finds the answer</b> to <b>0</b>: only <b>70.0</b> percent are correct and <b>30.0</b> percent are confident errors. Without grounding, whatever the model does not know becomes an error.</li>
    <li>Set <b>Retrieval finds the answer</b> to <b>100</b>: <b>100.0</b> percent are correct. Real retrieval is not perfect, which is why the checker matters.</li>
  </ol>
  <div class="pg hal" data-hal>
    <div class="pg-row">
      <label>Questions the model knows <input class="pg-in" type="range" min="0" max="100" step="5" value="70" data-k /> <b data-kv></b> %</label>
      <label>Retrieval finds the answer <input class="pg-in" type="range" min="0" max="100" step="5" value="60" data-r /> <b data-rv></b> %</label>
      <label>Declines what it cannot support <input class="pg-in" type="range" min="0" max="100" step="10" value="0" data-abs /> <b data-absval></b> %</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Answered correctly</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Wrong, but confident</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Declined</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // correct = known + (1 - known) x retrieved. What neither covers is wrong when the model never abstains, and declined when it always abstains.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-hal]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const known = Number(q<HTMLInputElement>('[data-k]').value) / 100, found = Number(q<HTMLInputElement>('[data-r]').value) / 100;
      const abstain = Number(q<HTMLInputElement>('[data-abs]').value) / 100;
      q('[data-absval]').textContent = String(Math.round(abstain * 100));
      q('[data-kv]').textContent = String(Math.round(known * 100)); q('[data-rv]').textContent = String(Math.round(found * 100));
      const correct = known + (1 - known) * found, rest = (1 - known) * (1 - found);
      const wrong = rest * (1 - abstain), declined = rest * abstain;
      setBox(1, `${(100 * correct).toFixed(1)} %`, 'the model knew it, or retrieval supplied it', 'good');
      setBox(2, `${(100 * wrong).toFixed(1)} %`, wrong > 0 ? 'fluent, confident and unsupported: the hallucination' : 'none, in this idealised model that declines everything it cannot support', wrong > 0 ? 'bad' : 'good');
      setBox(3, `${(100 * declined).toFixed(1)} %`, declined > 0 ? 'an honest not found, which is unhelpful but safe' : 'the assistant always gives an answer', 'mid');
      q('[data-verdict]').textContent = 'Grounding raises the share that is correct. Declining turns some of the rest from confident errors into declined answers. Declining is never perfect, since a model does not know exactly what it does not know, so claims are also checked against the sources.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
