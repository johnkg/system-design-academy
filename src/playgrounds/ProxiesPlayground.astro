---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Send requests through a reverse proxy in front of two backends. Switch its features on and off and watch what reaches the backends and what the client receives.">
  <ol class="how">
    <li>Press <b>GET /logo.png</b> several times with <b>Cache</b> on: only the first reaches a backend. Turn <b>Compression</b> on and the API response shrinks on the wire.</li>
    <li>Send <b>Malicious request</b> with the <b>Filter</b> on: it is stopped at the proxy. Turn the filter off and it reaches a backend.</li>
    <li>Press <b>Backend 1 fails</b>, then <b>5 API requests</b>, with <b>Load balancing and failover</b> on and off: with it, requests move to backend 2 and none fail.</li>
  </ol>
  <div class="pg px" data-px>
    <div class="pg-row">
      <label class="px-check"><input type="checkbox" checked data-cache /> Cache static files</label>
      <label class="px-check"><input type="checkbox" checked data-gzip /> Compression</label>
      <label class="px-check"><input type="checkbox" checked data-filter /> Filter bad requests</label>
      <label class="px-check"><input type="checkbox" checked data-lb /> Load balancing and failover</label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-send="logo">GET /logo.png</button>
      <button class="btn" type="button" data-send="api">GET /api/orders</button>
      <button class="btn" type="button" data-send="bad">Malicious request</button>
      <button class="btn" type="button" data-burst>5 API requests</button>
      <button class="btn" type="button" data-down aria-pressed="false">Backend 1 fails</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-1)"><h3>Backend 1</h3><span class="pg-mono" data-b1></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Backend 2</h3><span class="pg-mono" data-b2></span></div>
      <div class="pg-box" data-clientbox><h3>Client received</h3><span class="pg-mono" data-client></span></div>
    </div>
    <p class="pg-out" data-res aria-live="polite">No request yet.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-px]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const on = (s: string) => q<HTMLInputElement>(s).checked;
    let b1 = 0; let b2 = 0; let cacheHits = 0; let blocked = 0; let failed = 0; let bytes = 0; let ok = 0; let down = false; let turn = 0; const cached = new Set<string>();
    function send(kind: string): string {
      if (kind === 'bad' && on('[data-filter]')) { blocked++; return 'Blocked at the proxy: the request never reached a backend.'; }
      if (kind === 'logo' && on('[data-cache]') && cached.has('logo')) { cacheHits++; ok++; bytes += on('[data-gzip]') ? 50 : 50; return 'Served from the proxy cache (50 KB). The backends were not involved.'; }
      // choose a backend
      let target = on('[data-lb]') ? (turn++ % 2) + 1 : 1;
      if (down && target === 1) { if (on('[data-lb]')) target = 2; else { failed++; return 'Failed: the only backend is down and nothing can take over (502).'; } }
      if (target === 1) b1++; else b2++;
      if (kind === 'bad') { ok++; return `Reached backend ${target}: nothing filtered it out.`; }
      const size = kind === 'logo' ? 50 : on('[data-gzip]') ? 6 : 20; bytes += size; ok++;
      if (kind === 'logo' && on('[data-cache]')) cached.add('logo');
      return `Handled by backend ${target}. ${size} KB sent to the client${kind === 'api' && on('[data-gzip]') ? ' (compressed from 20 KB)' : ''}.`;
    }
    function draw(msg?: string) {
      q('[data-b1]').textContent = `${b1} requests${down ? ' (DOWN)' : ''}`; q('[data-b2]').textContent = `${b2} requests`;
      q('[data-client]').textContent = `${bytes} KB in ${ok} responses${failed ? `, ${failed} failed` : ''}${blocked ? `, ${blocked} blocked` : ''}`;
      q<HTMLElement>('[data-clientbox]').style.setProperty('--c', failed ? 'var(--bad)' : 'var(--role-2)');
      if (msg) { const o = q('[data-res]'); o.textContent = `${msg}${cacheHits ? ` (cache hits so far: ${cacheHits})` : ''}`; o.classList.toggle('bad', /Failed|nothing filtered/.test(msg)); }
    }
    root.querySelectorAll<HTMLElement>('[data-send]').forEach((b) => b.addEventListener('click', () => draw(send(b.dataset.send!))));
    q('[data-burst]').addEventListener('click', () => { let last = ''; for (let i = 0; i < 5; i++) last = send('api'); draw(`Last of 5: ${last}`); });
    q('[data-down]').addEventListener('click', (e) => { down = !down; const b = e.currentTarget as HTMLElement; b.setAttribute('aria-pressed', String(down)); b.textContent = down ? 'Backend 1 recovers' : 'Backend 1 fails'; draw(); });
    q('[data-reset]').addEventListener('click', () => { b1 = b2 = cacheHits = blocked = failed = bytes = ok = 0; down = false; turn = 0; cached.clear(); const b = q('[data-down]'); b.setAttribute('aria-pressed', 'false'); b.textContent = 'Backend 1 fails'; draw(); q('[data-res]').textContent = 'No request yet.'; q('[data-res]').classList.remove('bad'); });
    draw();
  });
</script>
<style is:global>
  .playground .px-check { display: inline-flex; align-items: center; gap: 6px; }
</style>
