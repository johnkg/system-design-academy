---
import PlaygroundShell from '../components/PlaygroundShell.astro';
import RangeField from '../components/RangeField.astro';
---
<PlaygroundShell title="Simulate it" hint="A toy attack: 20,000 email and password pairs leaked from another site are replayed against a login with 2,000 real accounts, one try per pair. 10% of those users reuse the leaked password. The random draws are seeded, so the same settings always give the same result. Every rate is an assumption of the toy.">
  <ol class="how">
    <li>With the defaults, <b>216</b> of the 20,000 attempts hit and <b>267</b> accounts are taken over (216 by password, 51 through recovery). Set <b>Attacker's IP addresses</b> to <b>20</b> and <b>Per-IP limit</b> to <b>20 failed logins per hour</b>: the hits fall to <b>6</b>. Now set <b>Attacker's IP addresses</b> to <b>5,000</b>: the botnet puts about 4 tries on each address, never reaches the limit, and the hits are back to <b>216</b>.</li>
    <li>Set <b>Per-account limit</b> to <b>5 failures per hour</b>: nothing changes, because each account gets one try. Set <b>Breached-password check</b> to <b>70% of leaked passwords known</b>: the hits fall to <b>66</b> and <b>120</b> accounts are taken over, whatever addresses the attacker uses.</li>
    <li>Set <b>Breached-password check</b> back to none. Set <b>Second factor</b> to <b>Authenticator app code (TOTP)</b>: <b>159</b> accounts are taken over. Choose <b>Push, tap to approve</b> and it is <b>196</b>, because tired users approve some of the 5 prompts. <b>Push with number matching</b> goes back to <b>159</b>. Now tick <b>Attacker runs a live phishing page</b>: the authenticator app rises to <b>186</b>, while <b>Passkey</b> stays at <b>159</b>.</li>
    <li>With <b>Passkey</b> selected, set <b>Users enrolled in MFA (%)</b> to <b>100</b>. Nobody is taken over by password, but <b>57</b> still fall to <b>Account recovery</b> by email link. Set <b>Account recovery</b> to <b>Link plus the second factor</b> and the total is <b>0</b>.</li>
  </ol>
  <div class="pg cs" data-cs>
    <div class="pg-row">
      <label>Attacker's IP addresses <select class="pg-in" data-ips><option value="5000" selected>5,000 (a botnet)</option><option value="20">20</option></select></label>
      <label>Per-IP limit <select class="pg-in" data-iplimit><option value="0" selected>None</option><option value="20">20 failed logins per hour</option></select></label>
      <label>Per-account limit <select class="pg-in" data-acctlimit><option value="0" selected>None</option><option value="5">5 failures per hour</option></select></label>
      <label>Breached-password check <select class="pg-in" data-cover><option value="0" selected>None</option><option value="70">70% of leaked passwords known</option></select></label>
    </div>
    <div class="pg-row">
      <label>Second factor <select class="pg-in" data-mfa>
        <option value="none" selected>None</option>
        <option value="sms">SMS code</option>
        <option value="totp">Authenticator app code (TOTP)</option>
        <option value="push">Push, tap to approve</option>
        <option value="pushnm">Push with number matching</option>
        <option value="passkey">Passkey</option>
      </select></label>
      <RangeField label="Users enrolled in MFA (%)" name="enrol" min="0" max="100" step="10" value="50" />
      <label><input type="checkbox" data-relay /> Attacker runs a live phishing page</label>
      <label>Account recovery <select class="pg-in" data-recovery><option value="email" selected>Email link only</option><option value="email+mfa">Link plus the second factor</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-1)"><h3>Password hits</h3><span class="pg-mono" data-hits></span><span class="pg-note" data-hitsnote></span></div>
      <div class="pg-box" style="--c: var(--role-2)"><h3>Stopped by the second factor</h3><span class="pg-mono" data-stopped></span><span class="pg-note" data-stoppednote></span></div>
      <div class="pg-box" data-box><h3>Accounts taken over</h3><span class="pg-mono" data-total></span><span class="pg-note" data-split></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)"><h3>Where the other attempts went</h3><span class="pg-note" data-blocked></span></div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  // The same model as the code samples: a MINSTD generator (48271 modulo 2147483647), seeded, integers only.
  const USERS = 2000, ATTEMPTS = 20000, SEED = 12345, REUSE_PCT = 10;
  let state = SEED;
  const next = () => (state = (state * 48271) % 2147483647);
  interface Person { reuse: number; enrol: number; fooled: number; simSwap: number; mail: number; known: number; tap: number[] }
  const users: Person[] = [];
  for (let u = 0; u < USERS; u++) {
    const d = Array.from({ length: 11 }, () => next() % 100);
    users.push({ reuse: d[0], enrol: d[1], fooled: d[2], simSwap: d[3], mail: d[4], known: d[5], tap: d.slice(6, 11) });
  }
  const ipRaw = Array.from({ length: ATTEMPTS }, () => next());

  interface Config { ips: number; ipLimit: number; acctLimit: number; breachCover: number; mfa: string; enrolPct: number; relay: boolean; recovery: string }
  function simulate(c: Config) {
    const ipFails = new Array(c.ips).fill(0), acctFails = new Array(USERS).fill(0);
    let blockedIp = 0, blockedAcct = 0, screened = 0, hits = 0, wrong = 0;
    const hit: number[] = [];
    for (let i = 0; i < ATTEMPTS; i++) {
      const ip = ipRaw[i] % c.ips;
      if (c.ipLimit > 0 && ipFails[ip] >= c.ipLimit) { blockedIp++; continue; }
      const u = i % 10 === 0 ? i / 10 : -1;
      if (u < 0) { ipFails[ip]++; wrong++; continue; }
      if (c.acctLimit > 0 && acctFails[u] >= c.acctLimit) { blockedAcct++; continue; }
      const w = users[u];
      if (w.reuse < REUSE_PCT) {
        if (c.breachCover > 0 && w.known < c.breachCover) { screened++; continue; }
        hits++; hit.push(u);
      } else { ipFails[ip]++; acctFails[u]++; wrong++; }
    }
    const enrolled = (w: Person) => c.mfa !== 'none' && w.enrol < c.enrolPct;
    const mfaBeaten = (w: Person) => {
      const relayed = c.relay && w.fooled < 20;
      if (c.mfa === 'sms') return relayed || w.simSwap < 2;
      if (c.mfa === 'totp' || c.mfa === 'pushnm') return relayed;
      if (c.mfa === 'push') return relayed || w.tap.some((d) => d < 10);
      return false;
    };
    const taken = new Set<number>();
    let stopped = 0;
    for (const u of hit) { const w = users[u]; if (!enrolled(w) || mfaBeaten(w)) taken.add(u); else stopped++; }
    const viaPassword = taken.size;
    for (let u = 0; u < USERS; u++) {
      const w = users[u];
      if (taken.has(u) || w.mail >= 3) continue;
      if (c.recovery === 'email' || !enrolled(w)) taken.add(u);
    }
    return { blockedIp, blockedAcct, screened, hits, wrong, stopped, viaPassword, viaRecovery: taken.size - viaPassword, total: taken.size };
  }

  document.querySelectorAll<HTMLElement>('[data-cs]').forEach((root) => {
    const q = query(root);
    const num = (s: string) => Number(q<HTMLSelectElement>(s).value);
    function draw() {
      const enrolPct = num('[data-enrol]');
      q('[data-enrolval]').textContent = String(enrolPct);
      const mfa = q<HTMLSelectElement>('[data-mfa]').value;
      q<HTMLInputElement>('[data-enrol]').disabled = mfa === 'none';
      const r = simulate({ ips: num('[data-ips]'), ipLimit: num('[data-iplimit]'), acctLimit: num('[data-acctlimit]'), breachCover: num('[data-cover]'), mfa, enrolPct, relay: q<HTMLInputElement>('[data-relay]').checked, recovery: q<HTMLSelectElement>('[data-recovery]').value });
      q('[data-hits]').textContent = `${formatThousands(r.hits)} of ${formatThousands(ATTEMPTS)} attempts`;
      q('[data-hitsnote]').textContent = 'the leaked password was right and nothing blocked the try';
      q('[data-stopped]').textContent = formatThousands(r.stopped);
      q('[data-stoppednote]').textContent = mfa === 'none' ? 'no second factor is asked for' : 'password hits that failed at the second step';
      q('[data-total]').textContent = formatThousands(r.total);
      q('[data-split]').textContent = `${formatThousands(r.viaPassword)} by password, ${formatThousands(r.viaRecovery)} through account recovery`;
      q<HTMLElement>('[data-box]').style.setProperty('--c', r.total === 0 ? 'var(--good)' : 'var(--bad)');
      q('[data-blocked]').textContent = `${formatThousands(r.wrong)} tries failed on the password, ${formatThousands(r.blockedIp)} were blocked by the IP limit, ${formatThousands(r.blockedAcct)} by the account limit, and ${formatThousands(r.screened)} had a breached password caught and a reset forced.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
