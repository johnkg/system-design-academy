---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Two toys, both counted in operations, never timed. The tree box inserts keys into a plain binary search tree or a balanced (AVL) one. The graph box counts the steps and memory of graph algorithms from formulas that the code samples check against real runs. Times assume one step per nanosecond, and one cell is 8 bytes.">
  <ol class="how">
    <li>In the tree box set <b>Key order</b> to <b>Random</b>, <b>Keys n</b> to <b>1,000</b> and <b>Tree</b> to <b>Plain binary search tree</b>: height <b>21</b>, <b>10,109</b> comparisons to build and <b>11,109</b> for the 1,000 lookups. Set <b>Tree</b> to <b>Balanced (AVL)</b>: height <b>12</b>, with <b>9,199</b> comparisons for the lookups. The smallest possible height is <b>10</b>.</li>
    <li>Set <b>Key order</b> to <b>Already sorted</b> and <b>Tree</b> to <b>Plain binary search tree</b>: the tree is a chain of height <b>1,000</b>, building it takes <b>499,500</b> comparisons and the lookups <b>500,500</b>. Set <b>Tree</b> to <b>Balanced (AVL)</b>: height <b>10</b> and <b>8,987</b> comparisons for the lookups. <b>Zig-zag</b> order breaks the plain tree just as badly.</li>
    <li>In the graph box set <b>Vertices V</b> to <b>100,000</b>, <b>Edges</b> to <b>Sparse (2 per vertex)</b>, <b>Stored as</b> to <b>Adjacency matrix</b> and <b>Algorithm</b> to <b>Breadth-first search</b>: the matrix needs <b>10,000,000,000</b> cells, about <b>80 GB</b>, and the search takes <b>10,000,100,000</b> steps. Set <b>Stored as</b> to <b>Adjacency list</b>: <b>500,000</b> cells and <b>500,000</b> steps.</li>
    <li>Keep the list and set <b>Algorithm</b> to <b>Dijkstra with a heap</b>: <b>8,500,000</b> steps, against <b>10,000,400,000</b> for Dijkstra with a scan in the table. Tick <b>Separate search for each of 100 destinations</b> and the heap version costs <b>850,000,000</b> steps instead of one search. Set <b>Algorithm</b> to <b>Depth-first search (recursive)</b>: <b>100,000</b> frames deep on a path-shaped graph, far beyond Python's default limit of 1,000.</li>
  </ol>
  <div class="pg tg" data-tg>
    <h3 class="tg-h">Tree shape</h3>
    <div class="pg-row">
      <label>Key order <select class="pg-in" data-order><option value="random" selected>Random</option><option value="sorted">Already sorted</option><option value="zigzag">Zig-zag (smallest, largest, ...)</option></select></label>
      <label>Keys n <select class="pg-in" data-n><option value="10">10</option><option value="100">100</option><option value="1000" selected>1,000</option><option value="5000">5,000</option><option value="10000">10,000</option></select></label>
      <label>Tree <select class="pg-in" data-kind><option value="plain" selected>Plain binary search tree</option><option value="avl">Balanced (AVL)</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-t1><h3>Height</h3><span class="pg-mono tg-big" data-to1></span><span class="pg-note" data-tn1></span></div>
      <div class="pg-box" data-t2><h3>Comparisons to build</h3><span class="pg-mono tg-big" data-to2></span><span class="pg-note" data-tn2></span></div>
      <div class="pg-box" data-t3><h3>Comparisons for n lookups</h3><span class="pg-mono tg-big" data-to3></span><span class="pg-note" data-tn3></span></div>
    </div>
    <span class="pg-note" data-tverdict></span>

    <h3 class="tg-h">Graph size and representation</h3>
    <div class="pg-row">
      <label>Vertices V <select class="pg-in" data-v><option value="100">100</option><option value="1000">1,000</option><option value="10000">10,000</option><option value="100000" selected>100,000</option></select></label>
      <label>Edges <select class="pg-in" data-dens><option value="sparse" selected>Sparse (2 per vertex)</option><option value="medium">Medium (10 per vertex)</option><option value="dense">Dense (about half of all pairs)</option></select></label>
      <label>Stored as <select class="pg-in" data-rep><option value="list" selected>Adjacency list</option><option value="matrix">Adjacency matrix</option></select></label>
      <label>Algorithm <select class="pg-in" data-alg><option value="bfs" selected>Breadth-first search</option><option value="dfs">Depth-first search (recursive)</option><option value="bfsnv">Breadth-first search, no visited set</option><option value="dheap">Dijkstra with a heap</option><option value="dscan">Dijkstra with a scan</option></select></label>
      <label><input type="checkbox" data-many /> Separate search for each of 100 destinations</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-g1><h3>Steps</h3><span class="pg-mono tg-big" data-go1></span><span class="pg-note" data-gn1></span></div>
      <div class="pg-box" data-g2><h3>Memory for the graph</h3><span class="pg-mono tg-big" data-go2></span><span class="pg-note" data-gn2></span></div>
      <div class="pg-box" data-g3><h3>Edges E</h3><span class="pg-mono tg-big" data-go3></span><span class="pg-note" data-gn3></span></div>
      <div class="pg-box" data-g4><h3>Recursion depth, worst case</h3><span class="pg-mono tg-big" data-go4></span><span class="pg-note" data-gn4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Every algorithm at these settings</h3>
      <div class="tg-scroll" tabindex="0" role="region" aria-label="Steps of each algorithm"><table class="tg-table"><thead><tr><th>Algorithm</th><th>Steps</th><th>At one step per ns</th></tr></thead><tbody data-rows></tbody></table></div>
      <span class="pg-note" data-gverdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands, formatOneDecimalBelow100 } from '../playground';

  // ---------- trees: the same model as the code samples ----------
  function keyOrder(order: string, n: number): number[] {
    const keys: number[] = [];
    if (order === 'sorted') for (let i = 1; i <= n; i++) keys.push(i);
    else if (order === 'zigzag') { let lo = 1, hi = n; while (lo <= hi) { keys.push(lo++); if (lo <= hi) keys.push(hi--); } }
    else {
      for (let i = 1; i <= n; i++) keys.push(i);
      let x = 777;
      for (let i = n - 1; i > 0; i--) { x = (x * 1664525 + 1013904223) % 4294967296; const j = Math.floor(x / 65536) % (i + 1); [keys[i], keys[j]] = [keys[j], keys[i]]; }
    }
    return keys;
  }
  type TreeResult = { height: number; build: number; lookups: number };
  function plainTree(keys: number[]): TreeResult {
    const key: number[] = [], left: number[] = [], right: number[] = [];
    let comparisons = 0, height = 0;
    for (const k of keys) {
      if (key.length === 0) { key.push(k); left.push(-1); right.push(-1); height = 1; continue; }
      let at = 0, depth = 1;
      for (;;) {
        comparisons++;
        const side = k < key[at] ? left : right;
        if (side[at] === -1) { key.push(k); left.push(-1); right.push(-1); side[at] = key.length - 1; depth++; break; }
        at = side[at]; depth++;
      }
      height = Math.max(height, depth);
    }
    let lookups = 0;
    for (const k of keys) { let at = 0; while (at !== -1) { lookups++; if (k === key[at]) break; at = k < key[at] ? left[at] : right[at]; } }
    return { height, build: comparisons, lookups };
  }
  interface Node { k: number; l: Node | null; r: Node | null; h: number }
  function avlTree(keys: number[]): TreeResult {
    let comparisons = 0;
    const h = (t: Node | null) => (t ? t.h : 0);
    const fix = (t: Node) => { t.h = 1 + Math.max(h(t.l), h(t.r)); };
    const rotR = (t: Node) => { const l = t.l!; t.l = l.r; l.r = t; fix(t); fix(l); return l; };
    const rotL = (t: Node) => { const r = t.r!; t.r = r.l; r.l = t; fix(t); fix(r); return r; };
    const insert = (t: Node | null, k: number): Node => {
      if (!t) return { k, l: null, r: null, h: 1 };
      comparisons++;
      if (k < t.k) t.l = insert(t.l, k); else t.r = insert(t.r, k);
      fix(t);
      const bal = h(t.l) - h(t.r);
      if (bal > 1) { if (h(t.l!.l) < h(t.l!.r)) t.l = rotL(t.l!); return rotR(t); }
      if (bal < -1) { if (h(t.r!.r) < h(t.r!.l)) t.r = rotR(t.r!); return rotL(t); }
      return t;
    };
    let root: Node | null = null;
    for (const k of keys) root = insert(root, k);
    let lookups = 0;
    for (const k of keys) { let t = root; while (t) { lookups++; if (k === t.k) break; t = k < t.k ? t.l : t.r; } }
    return { height: h(root), build: comparisons, lookups };
  }
  const treeCache = new Map<string, TreeResult>();
  function tree(kind: string, order: string, n: number): TreeResult {
    const id = `${kind}/${order}/${n}`;
    let r = treeCache.get(id);
    if (!r) { const keys = keyOrder(order, n); r = kind === 'plain' ? plainTree(keys) : avlTree(keys); treeCache.set(id, r); }
    return r;
  }

  // ---------- graphs: the step formulas of the code samples (E counts each undirected edge once, so there are 2E arcs) ----------
  const edgesFor = (V: number, dens: string) => (dens === 'sparse' ? 2 * V : dens === 'medium' ? 10 * V : Math.floor((V * (V - 1)) / 4));
  const lg = (V: number) => Math.ceil(Math.log2(V));
  type Alg = 'bfs' | 'dfs' | 'bfsnv' | 'dheap' | 'dscan';
  const NAMES: Record<Alg, string> = { bfs: 'Breadth-first search', dfs: 'Depth-first search (recursive)', bfsnv: 'Breadth-first search, no visited set', dheap: 'Dijkstra with a heap', dscan: 'Dijkstra with a scan' };
  function steps(alg: Alg, rep: string, V: number, E: number): number {
    if (alg === 'bfs' || alg === 'dfs') return rep === 'list' ? V + 2 * E : V + V * V;
    if (alg === 'bfsnv') return Infinity;
    if (alg === 'dheap') return rep === 'list' ? (V + 2 * E) * lg(V) : V * V + (V + 2 * E) * lg(V);
    return rep === 'list' ? V * V + 2 * E : 2 * V * V;
  }
  const cells = (rep: string, V: number, E: number) => (rep === 'list' ? V + 2 * E : V * V);
  function bytes(b: number): string {
    const units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB']; let i = 0, v = b;
    while (v >= 1000 && i < units.length - 1) { v /= 1000; i++; }
    return `${formatOneDecimalBelow100(v)} ${units[i]}`;
  }
  function duration(s: number): string {
    if (!isFinite(s)) return 'never finishes';
    if (s < 1) return 'under a second';
    if (s < 120) return `about ${Math.round(s)} seconds`;
    if (s < 7200) return `about ${Math.round(s / 60)} minutes`;
    if (s < 172800) return `about ${Math.round(s / 3600)} hours`;
    if (s < 63072000) return `about ${formatThousands(Math.round(s / 86400))} days`;
    return `about ${formatThousands(Math.round(s / 31557600))} years`;
  }
  const show = (x: number) => (isFinite(x) ? formatThousands(x) : 'never finishes');

  document.querySelectorAll<HTMLElement>('[data-tg]').forEach((root) => {
    const q = query(root);
    const colour = (id: string, c: string) => q<HTMLElement>(id).style.setProperty('--c', c);
    function drawTree() {
      const order = q<HTMLSelectElement>('[data-order]').value, kind = q<HTMLSelectElement>('[data-kind]').value;
      const n = Number(q<HTMLSelectElement>('[data-n]').value);
      const r = tree(kind, order, n), other = tree(kind === 'plain' ? 'avl' : 'plain', order, n);
      const best = Math.ceil(Math.log2(n + 1));
      q('[data-to1]').textContent = formatThousands(r.height);
      q('[data-tn1]').textContent = `the smallest possible height for ${formatThousands(n)} keys is ${best}${r.height > 4 * best ? `; this tree is ${formatThousands(Math.round((r.height / best) * 10) / 10)}x taller: close to a linked list` : ''}`;
      colour('[data-t1]', r.height > 4 * best ? 'var(--bad)' : 'var(--good)');
      q('[data-to2]').textContent = formatThousands(r.build);
      q('[data-tn2]').textContent = 'one comparison for each node passed on the way down, for every insert';
      colour('[data-t2]', r.height > 4 * best ? 'var(--bad)' : 'var(--good)');
      q('[data-to3]').textContent = formatThousands(r.lookups);
      q('[data-tn3]').textContent = `on average ${formatOneDecimalBelow100(r.lookups / n)} comparisons per lookup`;
      colour('[data-t3]', r.height > 4 * best ? 'var(--bad)' : 'var(--good)');
      q('[data-tverdict]').textContent = kind === 'plain'
        ? `The balanced tree on the same keys has height ${other.height} and needs ${formatThousands(other.lookups)} comparisons for the lookups. A plain tree is only as good as the order its keys arrive in.`
        : `A plain tree on the same keys would have height ${other.height} and need ${formatThousands(other.lookups)} comparisons for the lookups. Rotations after each insert keep the height near log2 n whatever the order.`;
    }
    function drawGraph() {
      const V = Number(q<HTMLSelectElement>('[data-v]').value), dens = q<HTMLSelectElement>('[data-dens]').value;
      const rep = q<HTMLSelectElement>('[data-rep]').value, alg = q<HTMLSelectElement>('[data-alg]').value as Alg;
      const many = q<HTMLInputElement>('[data-many]').checked;
      const E = edgesFor(V, dens), mult = many ? 100 : 1;
      const st = steps(alg, rep, V, E) * mult;
      const mem = cells(rep, V, E);
      q('[data-go1]').textContent = show(st);
      q('[data-gn1]').textContent = alg === 'bfsnv' ? 'with no visited set, every cycle sends the search round again: it never ends (a real run on 100 vertices was stopped at 1,000,000 steps)' : `${duration((st * 1) / 1e9)} at one step per nanosecond (an assumption)${many ? '; 100 searches that should have been one' : ''}`;
      colour('[data-g1]', !isFinite(st) || st > 1e10 ? 'var(--bad)' : 'var(--good)');
      q('[data-go2]').textContent = `${formatThousands(mem)} cells`;
      q('[data-gn2]').textContent = `${bytes(mem * 8)} at 8 bytes a cell${rep === 'matrix' ? ': V times V, whatever the number of edges' : ': V + 2E, proportional to what is there'}`;
      colour('[data-g2]', mem * 8 > 16e9 ? 'var(--bad)' : 'var(--good)');
      q('[data-go3]').textContent = formatThousands(E);
      q('[data-gn3]').textContent = dens === 'dense' ? 'about half of all V(V-1)/2 pairs: here the matrix is no longer wasteful' : 'few edges compared with the V x V possible pairs: a matrix is mostly empty';
      colour('[data-g3]', 'var(--border)');
      q('[data-go4]').textContent = alg === 'dfs' ? `${formatThousands(V)} frames` : 'none';
      q('[data-gn4]').textContent = alg === 'dfs' ? (V > 1000 ? `a graph shaped like one long path makes the recursion V deep, over Python's default limit of 1,000 frames (other runtimes also stop at some limit)` : 'a long path makes the recursion V frames deep') : 'this algorithm uses a queue or heap, not recursion';
      colour('[data-g4]', alg === 'dfs' && V > 1000 ? 'var(--bad)' : 'var(--border)');
      const rows = q('[data-rows]'); rows.textContent = '';
      for (const a of ['bfs', 'dfs', 'bfsnv', 'dheap', 'dscan'] as Alg[]) {
        const s = steps(a, rep, V, E) * mult;
        const tr = document.createElement('tr');
        if (a === alg) tr.className = 'tg-sel';
        [NAMES[a] + (a === alg ? ' (selected)' : ''), show(s), duration(s / 1e9)].forEach((t, i) => { const td = document.createElement('td'); td.textContent = t; if (i) td.className = 'pg-mono'; tr.appendChild(td); });
        rows.appendChild(tr);
      }
      const h = steps('dheap', rep, V, E), s = steps('dscan', rep, V, E);
      q('[data-gverdict]').textContent = `Dijkstra with a scan costs ${formatThousands(Math.round(s / h))} times the heap version here. Steps for the heap version use the formula (V + 2E) log2 V, an upper estimate: a real run is typically several times lower. Big O describes growth, not exact counts.`;
    }
    root.addEventListener('change', () => { drawTree(); drawGraph(); });
    drawTree(); drawGraph();
  });
</script>
<style is:global>
  .playground .tg-big { font-size: 1.15rem; font-weight: 600; }
  .playground .tg-h { margin: 12px 0 4px; font-size: 1rem; }
  .playground .tg-scroll { overflow-x: auto; }
  .playground .tg-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .tg-table th, .playground .tg-table td { text-align: left; padding: 4px 8px; border-bottom: 1px solid var(--border); }
  .playground .tg-table tr.tg-sel td { background: var(--accent-soft); font-weight: 600; }
  .playground .pg.tg { display: grid; gap: 12px; }
</style>
