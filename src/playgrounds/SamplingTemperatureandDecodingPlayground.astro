---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="The model gives scores to eight tokens (4, 3.2, 2.5, 2, 1, 0.5, 0 and -1). Choose the temperature, top-k and top-p, and see how likely the best token is, how many tokens stay in play, and how uncertain the final choice is.">
  <ol class="how">
    <li>Start with the defaults: <b>Temperature</b> <b>1</b>, <b>Top-k</b> <b>8</b> and <b>Top-p</b> <b>1</b>. The best token has <b>52.3</b> percent, <b>8</b> tokens stay in play, and the choice has <b>1.94</b> bits of uncertainty.</li>
    <li>Set <b>Temperature</b> to <b>0.5</b>: the best token rises to <b>78.5</b> percent and the uncertainty falls to <b>0.99</b> bits. Set it to <b>2</b>: the best token falls to <b>32.0</b> percent and the uncertainty rises to <b>2.62</b> bits. Set it to <b>0.1</b>: the best token has <b>100.0</b> percent and the uncertainty is <b>0.00</b> bits, which is almost exactly greedy decoding (the true values are a hair below 100 percent and a hair above 0 bits, so the display rounds them).</li>
    <li>Set <b>Temperature</b> to <b>1</b> and <b>Top-p</b> to <b>0.9</b>: only <b>4</b> tokens stay in play, because the tail is cut off, the best token has <b>55.3</b> percent and the uncertainty is <b>1.62</b> bits.</li>
    <li>Set <b>Top-p</b> back to <b>1</b> and <b>Top-k</b> to <b>3</b>: <b>3</b> tokens stay in play, the best has <b>59.8</b> percent and the uncertainty is <b>1.34</b> bits. The count is fixed at 3 whatever the shape of the distribution.</li>
  </ol>
  <div class="pg smp" data-smp>
    <div class="pg-row">
      <label>Temperature <input class="pg-in" type="range" min="0.1" max="2" step="0.1" value="1" data-t /> <b data-tv></b></label>
      <label>Top-k <input class="pg-in" type="range" min="1" max="8" step="1" value="8" data-k /> <b data-kv></b></label>
      <label>Top-p <input class="pg-in" type="range" min="0.1" max="1" step="0.05" value="1" data-p /> <b data-pv></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Probability of the best token</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Tokens that stay in play</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Uncertainty of the choice</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // Softmax with temperature, then top-k, then top-p (applied to the renormalised probabilities; a top-p of 1 keeps everything).
  const LOGITS = [4, 3.2, 2.5, 2, 1, 0.5, 0, -1];
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-smp]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const t = Number(q<HTMLInputElement>('[data-t]').value), k = Number(q<HTMLInputElement>('[data-k]').value), p = Number(q<HTMLInputElement>('[data-p]').value);
      q('[data-tv]').textContent = String(t); q('[data-kv]').textContent = String(k); q('[data-pv]').textContent = String(p);
      const exps = LOGITS.map((x) => Math.exp(x / t));
      const total = exps.reduce((a, b) => a + b, 0);
      const probs = exps.map((e) => e / total);
      let order = probs.map((_, i) => i).sort((a, b) => probs[b] - probs[a]).slice(0, k);
      const renorm = (ids: number[]) => { const s = ids.reduce((a, i) => a + probs[i], 0); return ids.map((i) => probs[i] / s); };
      if (p < 1) {
        const r = renorm(order);
        let cum = 0, n = 0;
        for (const x of r) { n++; cum += x; if (cum >= p - 1e-9) break; }
        order = order.slice(0, n);
      }
      const final = renorm(order);
      const entropy = Math.max(0, -final.reduce((a, x) => a + (x > 0 ? x * Math.log2(x) : 0), 0));
      setBox(1, `${(100 * final[0]).toFixed(1)} %`, 'after the cut and renormalising', final[0] > 0.9 ? 'bad' : 'mid');
      setBox(2, String(order.length), order.length === LOGITS.length ? 'nothing is cut off' : `${LOGITS.length - order.length} unlikely tokens are removed`, 'mid');
      setBox(3, `${entropy.toFixed(2)} bits`, entropy < 0.05 ? 'almost no choice left: nearly always the same token' : 'higher means more variety in the output', 'mid');
      q('[data-verdict]').textContent = 'Lower temperature and tighter cut-offs give predictable text. Higher temperature and looser cut-offs give variety, and the risk of an odd token that derails the rest.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
