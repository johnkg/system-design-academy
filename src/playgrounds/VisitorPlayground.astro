---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Choose a visitor to run over a list of shapes. Shapes never change.">
  <ol class="how">
    <li><b>Add shapes</b> with a size.</li>
    <li>Choose an <b>operation</b> (a visitor). Each shape picks the right visit method.</li>
    <li>Press <b>+ Add Scale visitor</b>: a brand new operation, with zero changes to the shape classes.</li>
  </ol>
  <div class="pg" data-visitor>
    <div class="pg-row">
      <input class="pg-in" type="number" min="1" value="3" data-a aria-label="Size" style="width:80px" />
      <input class="pg-in" type="number" min="1" value="4" data-b aria-label="Second side" style="width:80px" />
      <button class="btn" type="button" data-add-circle>+ Circle (radius = size)</button>
      <button class="btn" type="button" data-add-rect>+ Rectangle (size × second)</button>
    </div>
    <div class="pg-row" role="group" aria-label="Visitor" data-visitors></div>
    <div class="vi-scroll" tabindex="0" role="region" aria-label="Results table"><table class="vi-table" data-table></table></div>
    <p class="pg-note" data-note aria-live="polite"></p>
    <p class="sr" aria-live="polite" data-status></p>
  </div>
</PlaygroundShell>
<script>
  interface Visitor { name: string; visitCircle(c: Circle): string; visitRectangle(r: Rectangle): string }
  class Circle { constructor(public radius: number) {} accept(v: Visitor) { return v.visitCircle(this); } label() { return `Circle r=${this.radius}`; } }
  class Rectangle { constructor(public w: number, public h: number) {} accept(v: Visitor) { return v.visitRectangle(this); } label() { return `Rectangle ${this.w}×${this.h}`; } }
  const f = (n: number) => n.toFixed(2);
  const area: Visitor = { name: 'AreaVisitor', visitCircle: (c) => f(Math.PI * c.radius ** 2), visitRectangle: (r) => f(r.w * r.h) };
  const perimeter: Visitor = { name: 'PerimeterVisitor', visitCircle: (c) => f(2 * Math.PI * c.radius), visitRectangle: (r) => f(2 * (r.w + r.h)) };
  const describe: Visitor = { name: 'DescribeVisitor', visitCircle: (c) => `a round shape, diameter ${c.radius * 2}`, visitRectangle: (r) => (r.w === r.h ? `a square of side ${r.w}` : `a ${r.w} by ${r.h} box`) };
  const scale: Visitor = { name: 'ScaleVisitor (new)', visitCircle: (c) => `radius ${c.radius} → ${c.radius * 2}`, visitRectangle: (r) => `${r.w}×${r.h} → ${r.w * 2}×${r.h * 2}` };
  document.querySelectorAll<HTMLElement>('[data-visitor]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const shapes: (Circle | Rectangle)[] = [new Circle(2), new Rectangle(3, 4)]; const visitors = [area, perimeter, describe]; let cur = area;
    const size = (s: string) => Math.max(1, Number(q<HTMLInputElement>(s).value) || 1);
    const btns = new Map<Visitor, HTMLButtonElement>();
    function buttons() {
      const v = q('[data-visitors]'); v.innerHTML = ''; btns.clear();
      visitors.forEach((x) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = x.name; b.setAttribute('aria-pressed', String(x === cur)); b.addEventListener('click', () => { cur = x; btns.forEach((o, k) => o.setAttribute('aria-pressed', String(k === cur))); draw(); q('[data-status]').textContent = `${cur.name}: ` + shapes.map((s) => `${s.label()} ${s.accept(cur)}`).join('; '); }); v.appendChild(b); btns.set(x, b); });
      if (visitors.length < 4) { const a = document.createElement('button'); a.type = 'button'; a.className = 'btn'; a.textContent = '+ Add Scale visitor'; a.addEventListener('click', () => { visitors.push(scale); cur = scale; q('[data-note]').textContent = 'ScaleVisitor added. Circle and Rectangle were not modified.'; buttons(); draw(); btns.get(scale)!.focus(); }); v.appendChild(a); }
    }
    function draw() {
      q('[data-table]').innerHTML = `<tr><th scope="col">Shape</th><th scope="col">shape.accept(${cur.name})</th></tr>` + shapes.map((s) => `<tr><th scope="row">${s.label()}</th><td>${s.accept(cur)}</td></tr>`).join('');
    }
    q('[data-add-circle]').addEventListener('click', () => { shapes.push(new Circle(size('[data-a]'))); draw(); });
    q('[data-add-rect]').addEventListener('click', () => { shapes.push(new Rectangle(size('[data-a]'), size('[data-b]'))); draw(); });
    buttons(); draw();
  });
</script>
<style is:global>
  .playground .vi-scroll { overflow-x: auto; max-width: 100%; }
  .playground .vi-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .playground .vi-table th, .playground .vi-table td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border); }
  .playground .vi-table td:last-child { font-family: ui-monospace, monospace; }
</style>
