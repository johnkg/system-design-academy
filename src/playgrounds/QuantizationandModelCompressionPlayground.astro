---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="The memory for a model's weights is its parameters times the bytes per weight. Choose the size of the model and the bits per weight, and count the 80 GB GPUs the weights alone need. The KV cache and activations need memory on top of this.">
  <ol class="how">
    <li>Start with the defaults: <b>Parameters</b> <b>70</b> billion and <b>Bits per weight</b> <b>16</b>. The weights take <b>140</b> GB, so they need <b>2</b> GPUs, and <b>0.0</b> percent of the memory is saved.</li>
    <li>Set <b>Bits per weight</b> to <b>8</b>: <b>70</b> GB, <b>1</b> GPU and <b>50.0</b> percent saved. Set it to <b>4</b>: <b>35</b> GB, still <b>1</b> GPU, and <b>75.0</b> percent saved, which leaves room on the GPU for the KV cache.</li>
    <li>Set <b>Parameters</b> to <b>405</b> billion with <b>Bits per weight</b> <b>16</b>: <b>810</b> GB and <b>11</b> GPUs. At <b>4</b> bits the same model needs <b>202.5</b> GB and <b>3</b> GPUs.</li>
  </ol>
  <div class="pg qnt" data-qnt>
    <div class="pg-row">
      <label>Parameters <select class="pg-in" data-p><option value="7">7 billion</option><option value="13">13 billion</option><option value="70" selected>70 billion</option><option value="405">405 billion</option></select></label>
      <label>Bits per weight <select class="pg-in" data-b><option value="16" selected>16</option><option value="8">8</option><option value="4">4</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Memory for the weights</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>80 GB GPUs for the weights alone</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Memory saved compared with 16-bit</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // Weights memory = parameters x bits / 8 bytes. GPUs = ceil(weights / 80 GB), counting weights alone.
  type Tone = 'good' | 'bad' | 'mid';
  const trim = (n: number) => String(Number(n.toFixed(1)));
  document.querySelectorAll<HTMLElement>('[data-qnt]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const params = Number(q<HTMLSelectElement>('[data-p]').value), bits = Number(q<HTMLSelectElement>('[data-b]').value);
      const gb = (params * bits) / 8; // billions of parameters x bytes each = GB
      const gpus = Math.ceil(gb / 80);
      const saved = 100 * (1 - bits / 16);
      setBox(1, `${trim(gb)} GB`, `${params} billion parameters x ${bits / 8} byte${bits === 8 ? '' : 's'} each`, 'mid');
      setBox(2, String(gpus), gb < 80 ? 'fits on one GPU, with some room left for the KV cache' : 'does not fit on one GPU', gpus === 1 ? 'good' : 'bad');
      setBox(3, `${saved.toFixed(1)} percent`, bits === 16 ? 'full 16-bit weights' : 'accuracy cost: measure it on your own tasks', 'mid');
      q('[data-verdict]').textContent = 'The saving in weights memory is exact. The loss in quality is not: published methods report small losses at 8 and 4 bits for the models they tested, but you must check your own model and tasks.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
