---
import PlaygroundShell from '../components/PlaygroundShell.astro';
import RangeField from '../components/RangeField.astro';
---
<PlaygroundShell title="Simulate it" hint="Choose N, W and R, then write and read. To show the worst case, a write reaches the first W replicas that are up, and a read asks the last R that are up.">
  <ol class="how">
    <li>Keep <b>N=5, W=3, R=3</b>. Press <b>Write</b> then <b>Read</b>: the read always finds the new version, because 3 + 3 &gt; 5.</li>
    <li>Lower <b>R to 2</b> and repeat (Reset first): 3 + 2 = 5 is not greater than 5, so the read can miss the write and return the <b>old version</b>.</li>
    <li>Raise <b>crashed replicas</b>: a write needs W replicas up and a read needs R. Raising W or R improves consistency but lowers availability.</li>
  </ol>
  <div class="pg qr" data-qr>
    <div class="pg-row">
      <RangeField label="Replicas (N)" name="n" min="3" max="7" value="5" />
      <RangeField label="Write quorum (W)" name="w" min="1" max="7" value="3" />
      <RangeField label="Read quorum (R)" name="r" min="1" max="7" value="3" />
      <RangeField label="Crashed replicas" name="down" min="0" max="6" value="0" />
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-write>Write a new version</button>
      <button class="btn" type="button" data-read>Read</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="qr-reps" data-reps></div>
    <p class="pg-mono" data-rule></p>
    <p class="pg-out" data-msg aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../playground';
  const REPLICAS = 7;
  document.querySelectorAll<HTMLElement>('[data-qr]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    let versions: number[] = []; let latest = 1; let marks: Record<number, string> = {};
    const boxes = Array.from({ length: REPLICAS }, (_, i) => { const b = document.createElement('div'); b.className = 'qr-rep'; b.innerHTML = '<strong></strong><span class="pg-mono"></span>'; b.querySelector('strong')!.textContent = `Replica ${i + 1}`; q('[data-reps]').appendChild(b); return { b, v: b.querySelector<HTMLElement>('.pg-mono')! }; });
    const n = () => val('[data-n]'); const upIdx = () => { const down = Math.min(val('[data-down]'), n() - 1); return Array.from({ length: n() - down }, (_, i) => i); };
    function reset() { versions = Array(REPLICAS).fill(1); latest = 1; marks = {}; draw('Every replica holds version 1.'); }
    function sync() {
      const N = n(); const wEl = q<HTMLInputElement>('[data-w]'); const rEl = q<HTMLInputElement>('[data-r]'); const dEl = q<HTMLInputElement>('[data-down]');
      [wEl, rEl].forEach((e) => (e.max = String(N))); dEl.max = String(N - 1);
      if (Number(wEl.value) > N) wEl.value = String(N); if (Number(rEl.value) > N) rEl.value = String(N); if (Number(dEl.value) > N - 1) dEl.value = String(N - 1);
    }
    function draw(msg?: string) {
      sync(); const N = n(); const W = val('[data-w]'); const R = val('[data-r]'); const up = upIdx();
      q('[data-nval]').textContent = String(N); q('[data-wval]').textContent = String(W); q('[data-rval]').textContent = String(R); q('[data-downval]').textContent = String(Math.min(val('[data-down]'), N - 1));
      boxes.forEach((x, i) => { x.b.hidden = i >= N; const isUp = up.includes(i); x.b.classList.toggle('down', !isUp); x.b.classList.toggle('stale', isUp && versions[i] < latest); x.v.textContent = isUp ? `version ${versions[i]}${marks[i] ? ` · ${marks[i]}` : ''}` : 'DOWN'; });
      q('[data-rule]').textContent = `R + W = ${R + W} ${R + W > N ? '>' : '<='} N = ${N}: ${R + W > N ? 'a read always overlaps the latest write' : 'a read can miss the latest write'} · writes survive ${N - W} failures · reads survive ${N - R}`;
      if (msg !== undefined) { const o = q('[data-msg]'); o.textContent = msg; o.classList.toggle('bad', /stale|cannot|only/.test(msg)); }
    }
    q('[data-write]').addEventListener('click', () => {
      const W = val('[data-w]'); const up = upIdx(); marks = {};
      if (up.length < W) { draw(`Cannot write: only ${up.length} replicas are up and W = ${W}. The write is refused.`); return; }
      latest++; up.slice(0, W).forEach((i) => { versions[i] = latest; marks[i] = 'wrote'; });
      draw(`Version ${latest} written to ${W} replicas and acknowledged. The other up replicas still hold older versions.`);
    });
    q('[data-read]').addEventListener('click', () => {
      const R = val('[data-r]'); const up = upIdx(); marks = {};
      if (up.length < R) { draw(`Cannot read: only ${up.length} replicas are up and R = ${R}.`); return; }
      const asked = up.slice(-R); asked.forEach((i) => (marks[i] = 'asked')); const got = Math.max(...asked.map((i) => versions[i]));
      draw(got === latest ? `Read asked replicas ${asked.map((i) => i + 1).join(', ')} and returned version ${got}: the latest.` : `Read asked replicas ${asked.map((i) => i + 1).join(', ')} and returned version ${got}, but the latest is ${latest}: a STALE read.`);
    });
    q('[data-reset]').addEventListener('click', reset);
    root.addEventListener('input', () => draw()); reset();
  });
</script>
<style is:global>
  .playground .qr-reps { display: flex; gap: 8px; flex-wrap: wrap; }
  .playground .qr-rep { border: 2px solid var(--role-2); border-radius: 10px; padding: 8px 10px; display: grid; gap: 4px; min-width: 104px; background: color-mix(in srgb, var(--role-2) 10%, var(--surface)); }
  .playground .qr-rep[hidden] { display: none; }
  .playground .qr-rep.stale { border-color: var(--role-3); background: color-mix(in srgb, var(--role-3) 14%, var(--surface)); }
  .playground .qr-rep.down { border-style: dashed; border-color: var(--border); background: var(--surface); color: var(--muted); }
</style>
