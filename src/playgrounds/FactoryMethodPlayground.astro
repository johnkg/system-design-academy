---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Pick a creator, plan a delivery, and watch the factory method choose the product.">
  <ol class="how">
    <li>Choose a <b>creator</b> (Road or Sea).</li>
    <li>Press <b>Plan delivery</b>. Watch the three steps light up.</li>
    <li>Press <b>+ Add AirLogistics</b>. The planner code is not touched, yet it can now deliver by air.</li>
  </ol>
  <div data-factory-demo class="f-demo">
    <div role="group" aria-label="Creator" class="f-row" data-creators></div>
    <form class="f-row" data-form>
      <label class="sr" for="cargo">Cargo</label>
      <input id="cargo" name="cargo" value="40 crates" autocomplete="off" />
      <button class="btn f-primary" type="submit">Plan delivery</button>
    </form>
    <div class="f-flow" aria-live="polite">
      <div class="f-node" data-n="0"><small>shared code</small><b>planDelivery(cargo)</b></div>
      <span class="f-arrow">→</span>
      <div class="f-node" data-n="1"><small>overridden by subclass</small><b data-factory>createTransport()</b></div>
      <span class="f-arrow">→</span>
      <div class="f-node" data-n="2"><small>product</small><b data-product>?</b></div>
    </div>
    <output class="f-out" data-out>Press Plan delivery.</output>
    <div class="f-row">
      <button class="btn" type="button" data-add>+ Add AirLogistics</button>
      <span class="f-note" data-note></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  // The pattern in miniature: planDelivery() is written once and never edited.
  interface Transport { icon: string; name: string; deliver(cargo: string): string }
  abstract class Logistics {
    abstract readonly label: string;
    abstract createTransport(): Transport; // factory method
    planDelivery(cargo: string) { return this.createTransport().deliver(cargo); }
  }
  const make = (icon: string, name: string, how: string): Transport => ({ icon, name, deliver: (c) => `${name} delivers ${c} by ${how}` });
  class RoadLogistics extends Logistics { label = 'RoadLogistics'; createTransport() { return make('🚚', 'Truck', 'road'); } }
  class SeaLogistics extends Logistics { label = 'SeaLogistics'; createTransport() { return make('🚢', 'Ship', 'sea'); } }
  class AirLogistics extends Logistics { label = 'AirLogistics'; createTransport() { return make('✈️', 'Plane', 'air'); } }

  document.querySelectorAll<HTMLElement>('[data-factory-demo]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const creators: Logistics[] = [new RoadLogistics(), new SeaLogistics()];
    let current = creators[0];
    let runId = 0;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const nodes = [...root.querySelectorAll<HTMLElement>('[data-n]')];

    function renderCreators() {
      const wrap = q('[data-creators]');
      wrap.innerHTML = '';
      creators.forEach((c) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn'; b.textContent = c.label;
        b.setAttribute('aria-pressed', String(c === current));
        b.addEventListener('click', () => { current = c; renderCreators(); });
        wrap.appendChild(b);
      });
    }
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce.matches ? 0 : ms));

    q('[data-form]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = ++runId;
      const cargo = q<HTMLInputElement>('input[name=cargo]').value.trim() || 'something';
      nodes.forEach((n) => n.classList.remove('lit'));
      q('[data-factory]').textContent = 'createTransport()';
      q('[data-product]').textContent = '?';
      q('[data-out]').textContent = '...';
      nodes[0].classList.add('lit'); await wait(450); if (id !== runId) return;
      nodes[1].classList.add('lit'); q('[data-factory]').textContent = `${current.label}.createTransport()`; await wait(450); if (id !== runId) return;
      const t = current.createTransport();
      nodes[2].classList.add('lit'); q('[data-product]').textContent = `${t.icon} new ${t.name}()`; await wait(300); if (id !== runId) return;
      q('[data-out]').textContent = current.planDelivery(cargo);
    });

    q('[data-add]').addEventListener('click', (e) => {
      creators.push(new AirLogistics());
      (e.currentTarget as HTMLButtonElement).disabled = true;
      current = creators[creators.length - 1];
      renderCreators();
      q('[data-note]').textContent = 'AirLogistics + Plane added. planDelivery() was not edited.';
    });
    renderCreators();
  });
</script>
<style is:global>
  .playground .f-demo { display: grid; gap: 12px; }
  .playground .f-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .playground .f-demo input[name=cargo] { flex: 1 1 180px; font: inherit; padding: 6px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); }
  .playground .f-primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 600; }
  .playground .f-primary:hover { background: var(--accent); filter: brightness(1.1); }
  .playground .f-flow { display: flex; gap: 8px; align-items: stretch; flex-wrap: wrap; }
  .playground .f-node { flex: 1 1 150px; border: 2px dashed var(--border); border-radius: 10px; padding: 8px 10px; display: grid; gap: 2px; transition: border-color .3s, background .3s, box-shadow .3s; }
  .playground .f-node small { color: var(--muted); font-size: .72rem; }
  .playground .f-node b { font: .85rem ui-monospace, monospace; overflow-wrap: anywhere; }
  .playground .f-node.lit { border: 2px solid var(--accent); background: var(--accent-soft); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent); }
  .playground .f-arrow { align-self: center; color: var(--muted); }
  .playground .f-out { font: .9rem ui-monospace, monospace; min-height: 1.4em; }
  .playground .f-note { color: var(--muted); font-size: .85rem; }
</style>
