---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A fast producer feeds a slow consumer through a buffer. Pick what the buffer does when the consumer cannot keep up.">
  <ol class="how">
    <li>With <b>No limit</b>, the producer (14/s) outruns the consumer (8/s). The buffer and the delay keep growing until the process <b>runs out of memory and crashes</b>, losing everything in it.</li>
    <li>With <b>Bounded, drop when full</b>, memory and delay stay small, but items are thrown away. The dropped counter shows the cost.</li>
    <li>With <b>Bounded, push back</b>, nothing is lost and nothing grows: the producer's real rate falls to the consumer's 8/s. Lower the producer below the consumer's speed and the buffer empties in every mode.</li>
  </ol>
  <div class="pg bp" data-bp>
    <div class="pg-row">
      <label>When the consumer falls behind <select class="pg-in" data-mode>
        <option value="none">No limit (unbounded buffer)</option>
        <option value="drop">Bounded (20), drop when full</option>
        <option value="push">Bounded (20), push back on producer</option>
      </select></label>
      <label>Producer items/s <input type="range" min="1" max="20" value="14" data-prod /> <b data-prodval>14</b></label>
      <label>Consumer items/s <input type="range" min="1" max="15" value="8" data-cons /> <b data-consval>8</b></label>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="bp-bar" role="img" aria-label="Buffer" data-bar><div class="bp-fill" data-fill></div></div>
    <div class="pg-grid">
      <div class="pg-box" data-membox><h3>Buffer</h3><span class="pg-mono" data-buf></span><span class="pg-note" data-memnote></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Delay for a new item</h3><span class="pg-mono" data-delay></span><span class="pg-note">time spent waiting in the buffer</span></div>
      <div class="pg-box" style="--c: var(--role-1)"><h3>Producer's real speed</h3><span class="pg-mono" data-real></span><span class="pg-note" data-realnote></span></div>
    </div>
    <p class="pg-mono" data-stats></p>
  </div>
</PlaygroundShell>
<script>
  const BOUND = 20; const OOM = 120;
  document.querySelectorAll<HTMLElement>('[data-bp]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const mode = () => q<HTMLSelectElement>('[data-mode]').value;
    let buf = 0; let prodAcc = 0; let consAcc = 0; let accepted = 0; let consumed = 0; let dropped = 0; let lost = 0; let crashes = 0; let real = 0; let blocked = false;
    let last = performance.now(); let timer: number | undefined; let onScreen = true;

    function tick() {
      const now = performance.now(); const dt = Math.min(0.25, (now - last) / 1000); last = now;
      prodAcc += val('[data-prod]') * dt; consAcc += val('[data-cons]') * dt;
      let acc = 0; blocked = false;
      while (prodAcc >= 1) {
        prodAcc -= 1;
        if (mode() === 'none') { buf++; acc++; }
        else if (buf < BOUND) { buf++; acc++; }
        else if (mode() === 'drop') dropped++;
        else { blocked = true; prodAcc = 0; break; } // push back: the producer simply waits
      }
      accepted += acc;
      while (consAcc >= 1 && buf > 0) { consAcc -= 1; buf--; consumed++; }
      if (buf === 0) consAcc = Math.min(consAcc, 1);
      if (buf > OOM) { lost += buf; buf = 0; crashes++; }
      real = real * 0.9 + (acc / Math.max(dt, 0.001)) * 0.1;
      draw();
    }
    function draw() {
      const m = mode(); const cons = val('[data-cons]');
      q('[data-prodval]').textContent = String(val('[data-prod]')); q('[data-consval]').textContent = String(cons);
      const cap = m === 'none' ? OOM : BOUND;
      q('[data-fill]').style.width = `${Math.min(100, (buf / cap) * 100)}%`;
      q('[data-fill]').classList.toggle('hot', buf / cap > 0.7);
      q('[data-bar]').setAttribute('aria-label', `Buffer holds ${buf} items${m === 'none' ? ` of the ${OOM} that fit in memory` : ` of ${BOUND}`}`);
      q('[data-buf]').textContent = m === 'none' ? `${buf} items (memory limit ${OOM})` : `${buf} of ${BOUND} items`;
      q('[data-memnote]').textContent = crashes ? `crashed ${crashes}x, ${lost} items lost` : m === 'none' && buf > OOM * 0.7 ? 'nearly out of memory' : '';
      q('[data-delay]').textContent = `${(buf / cons).toFixed(1)} s`;
      q('[data-real]').textContent = `${real.toFixed(1)} items/s`;
      q('[data-realnote]').textContent = blocked ? 'waiting for space' : m === 'drop' && dropped ? 'sends at full speed, extra is dropped' : '';
      q('[data-stats]').textContent = `accepted: ${accepted} · consumed: ${consumed} · dropped: ${dropped} · lost in crashes: ${lost}`;
    }
    function reset() { buf = 0; prodAcc = consAcc = 0; accepted = consumed = dropped = lost = crashes = 0; real = 0; blocked = false; last = performance.now(); draw(); }
    function clock() {
      window.clearInterval(timer); timer = undefined;
      if (!onScreen || document.hidden) return;
      last = performance.now(); timer = window.setInterval(tick, 100);
    }
    q('[data-reset]').addEventListener('click', reset);
    q('[data-mode]').addEventListener('change', reset);
    q('[data-prod]').addEventListener('input', draw); q('[data-cons]').addEventListener('input', draw);
    new IntersectionObserver(([en]) => { onScreen = en.isIntersecting; clock(); }).observe(root);
    document.addEventListener('visibilitychange', clock);
    reset(); clock();
  });
</script>
<style is:global>
  .playground .bp-bar { height: 20px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .playground .bp-fill { height: 100%; width: 0; border-radius: 99px; background: var(--accent); transition: width .1s linear, background .2s; }
  .playground .bp-fill.hot { background: var(--bad); }
</style>
