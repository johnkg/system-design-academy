---
import PlaygroundShell from '../components/PlaygroundShell.astro';
import RangeField from '../components/RangeField.astro';
---
<PlaygroundShell title="Simulate it" hint="Eight short documents, written out below, and three queries. Document 3 is a keyword-stuffed page: it repeats 'laptop' 14 times. Change how the documents are scored and watch the list re-sort.">
  <ol class="how">
    <li>Leave <b>Query</b> on <b>cheap laptop battery</b> and set <b>Ranking</b> to <b>Plain term count</b>: the stuffed document 3 wins with a score of <b>15</b>, because it simply has the most matching words (the next best scores 3). Set <b>Ranking</b> to <b>TF-IDF</b>: the rare word counts for more, but the stuffed page still wins with <b>13.16</b>.</li>
    <li>Set <b>Ranking</b> to <b>BM25</b> (<b>Term saturation k1</b> 1.2 and <b>Length normalization b</b> 0.75): document 2, which has all three words, wins with <b>2.06</b>, document 1 follows with <b>1.93</b>, and the stuffed page falls to number 3 with <b>1.44</b>. Repeating a word 14 times no longer pays.</li>
    <li>Break it: set <b>Length normalization b</b> to <b>0</b> and the stuffed page climbs back to number 2 with <b>1.60</b>, because its length is no longer held against it. Set <b>Length normalization b</b> to <b>1</b> and the 2-word document 1 jumps to the top with <b>2.34</b>: too much length correction favors tiny documents.</li>
    <li>Set <b>Length normalization b</b> back to <b>0.75</b> and <b>Term saturation k1</b> to <b>0</b>: a word either appears or it does not, so documents 1 and 3 tie at <b>1.27</b>. Then set <b>Query</b> to <b>the laptop battery</b>, <b>Ranking</b> to <b>Plain term count</b> and <b>Term saturation k1</b> to <b>1.2</b>: the 40-word review (document 4) scores <b>12</b> mostly by repeating 'the'. Under <b>BM25</b> the short guide, document 6, wins with <b>2.17</b>.</li>
  </ol>
  <div class="pg b25" data-b25>
    <div class="pg-row">
      <label>Query <select class="pg-in" data-query><option value="cheap laptop battery" selected>cheap laptop battery</option><option value="laptop">laptop</option><option value="the laptop battery">the laptop battery</option></select></label>
      <label>Ranking <select class="pg-in" data-mode><option value="count">Plain term count</option><option value="tfidf">TF-IDF</option><option value="bm25" selected>BM25</option></select></label>
      <RangeField label="Term saturation k1" name="k1" min="0" max="3" step="0.1" value="1.2" readout="1.2" />
      <RangeField label="Length normalization b" name="b" min="0" max="1" step="0.05" value="0.75" readout="0.75" />
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-stuffbox><h3>Keyword-stuffed document 3</h3><span class="pg-mono" data-stuff></span><span class="pg-note" data-stuffnote></span></div>
      <div class="pg-box" data-idfbox style="--c: var(--border)"><h3>How rare is each query word</h3><span class="pg-mono" data-idf></span><span class="pg-note" data-idfnote></span></div>
      <div class="pg-box" data-satbox style="--c: var(--border)"><h3>What the Nth occurrence of a word is worth</h3><span class="pg-mono" data-sat></span><span class="pg-note" data-satnote></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Ranked results</h3>
      <ol class="b25-list" data-list></ol>
      <span class="pg-note" data-listnote></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  // The corpus, written as data, and the scoring: the same model as the code samples.
  const DOCS = [
    'cheap laptop',
    'cheap laptop with a long battery life for travel and study',
    'laptop laptop cheap laptop laptop laptop best laptop laptop laptop deals laptop laptop laptop laptop laptop laptop shop',
    'the review tests the screen the keyboard the speakers and the fan noise of one laptop and notes that the battery lasts all day while the charger is heavy and the price is fair for the quality of the build',
    'battery packs for phones and tablets with fast charging',
    'the best laptop battery replacement guide',
    'desktop computers and monitors for the office',
    'a laptop stand for the desk',
  ];
  const STUFFED = 3;
  const DEFAULT_K1X10 = 12, DEFAULT_BX100 = 75;
  const tokens = DOCS.map((d) => d.split(' '));
  const N = tokens.length;
  const AVG_LEN = tokens.reduce((sum, t) => sum + t.length, 0) / N;
  const countIn = (doc: string[], word: string) => doc.filter((w) => w === word).length;
  const docFreq = (word: string) => tokens.filter((t) => t.includes(word)).length;
  const idfBm25 = (df: number) => Math.log(1 + (N - df + 0.5) / (df + 0.5));
  type Mode = 'count' | 'tfidf' | 'bm25';
  interface Row { doc: number; score: number }

  // Plain counts are whole numbers; the other scores are kept in hundredths so ties and ordering match the samples exactly.
  function rank(q: string, mode: Mode, k1x10: number, bx100: number): Row[] {
    const k1 = k1x10 / 10, b = bx100 / 100;
    const terms = q.split(' ');
    return tokens.map((doc, i) => {
      let s = 0;
      for (const w of terms) {
        const tf = countIn(doc, w);
        if (tf === 0) continue;
        const df = docFreq(w);
        if (mode === 'count') s += tf;
        else if (mode === 'tfidf') s += tf * Math.log(1 + N / df);
        else s += idfBm25(df) * (tf * (k1 + 1)) / (tf + k1 * (1 - b + b * doc.length / AVG_LEN));
      }
      return { doc: i + 1, score: mode === 'count' ? s : Math.floor(s * 100 + 0.5) };
    }).sort((x, y) => y.score - x.score || x.doc - y.doc);
  }
  const place = (r: Row[], doc: number) => r.findIndex((x) => x.doc === doc) + 1;
  const show = (mode: Mode, score: number) => (mode === 'count' ? String(score) : (score / 100).toFixed(2));

  document.querySelectorAll<HTMLElement>('[data-b25]').forEach((root) => {
    const q = query(root);
    function draw() {
      const text = q<HTMLSelectElement>('[data-query]').value;
      const mode = q<HTMLSelectElement>('[data-mode]').value as Mode;
      const k1v = Number(q<HTMLInputElement>('[data-k1]').value), bv = Number(q<HTMLInputElement>('[data-b]').value);
      const k1x10 = Math.round(k1v * 10), bx100 = Math.round(bv * 100);
      q('[data-k1val]').textContent = String(k1v);
      q('[data-bval]').textContent = String(bv);
      const terms = text.split(' ');
      const r = rank(text, mode, k1x10, bx100);
      const base = rank(text, 'bm25', DEFAULT_K1X10, DEFAULT_BX100);

      const list = q('[data-list]'); list.textContent = '';
      r.forEach((row, i) => {
        const doc = tokens[row.doc - 1];
        const moved = place(base, row.doc) - (i + 1); // positive: higher than under BM25 with the default k1 and b
        const li = document.createElement('li');
        li.className = 'b25-row' + (row.doc === STUFFED ? ' stuffed' : '');
        const counts = terms.map((w) => `${w} ${countIn(doc, w)}`).join(', ');
        const rk = document.createElement('span'); rk.className = "b25-rank"; rk.textContent = `${i + 1}.`;
        const sc = document.createElement('span'); sc.className = 'pg-mono b25-score'; sc.textContent = show(mode, row.score);
        const mv = document.createElement('span'); mv.className = 'pg-note b25-move';
        mv.textContent = moved === 0 ? 'same place' : moved > 0 ? `up ${moved}` : `down ${-moved}`;
        const body = document.createElement('span'); body.className = 'b25-text';
        const head = document.createElement('b'); head.textContent = `Document ${row.doc}`;
        const meta = document.createElement('span'); meta.className = 'pg-note'; meta.textContent = ` ${doc.length} words (${counts})`;
        const snippet = document.createElement('span'); snippet.className = 'pg-mono b25-snip';
        snippet.textContent = row.doc === STUFFED ? 'laptop laptop cheap laptop laptop laptop best laptop ... shop (keyword stuffing)' : DOCS[row.doc - 1];
        body.append(head, meta, document.createElement('br'), snippet);
        li.append(rk, sc, mv, body);
        list.appendChild(li);
      });
      q('[data-listnote]').textContent = `Movement is measured against BM25 with k1 ${DEFAULT_K1X10 / 10} and b ${DEFAULT_BX100 / 100}.` + (mode === 'count' ? ' Plain count: the score is the number of query-word occurrences.' : mode === 'tfidf' ? ' TF-IDF: each occurrence counts in full, times how rare the word is.' : ` BM25: k1 ${k1v}, b ${bv}.`);

      const sp = place(r, STUFFED);
      q('[data-stuff]').textContent = `number ${sp} of ${N}`;
      q('[data-stuffnote]').textContent = `${tokens[STUFFED - 1].length} words, 'laptop' ${countIn(tokens[STUFFED - 1], 'laptop')} times. ` + (sp === 1 ? 'Repetition wins.' : 'Repetition stopped paying.');
      q('[data-stuffbox]').style.setProperty('--c', sp === 1 ? 'var(--bad)' : 'var(--good)');

      q('[data-idf]').textContent = terms.map((w) => `${w}: in ${docFreq(w)} of ${N} documents, idf ${idfBm25(docFreq(w)).toFixed(2)}`).join('\n');
      q('[data-idfnote]').textContent = 'A word found in many documents says little, so its idf is small. BM25 and TF-IDF both use it.';

      const k1 = k1x10 / 10;
      q('[data-sat]').textContent = [1, 2, 5, 10, 20].map((tf) => `${tf} times: count ${tf}, BM25 weight ${(tf * (k1 + 1) / (tf + k1)).toFixed(2)}`).join('\n');
      q('[data-satnote]').textContent = `For a document of average length. The weight can never pass ${(k1 + 1).toFixed(2)} (that is k1 + 1).`;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .b25-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .playground .b25-row { display: grid; grid-template-columns: 2.2rem 4.2rem 6rem minmax(0, 1fr); gap: 2px 10px; align-items: baseline; padding: 6px 8px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }
  .playground .b25-row.stuffed { border-color: var(--bad); }
  .playground .b25-snip { overflow-wrap: anywhere; }
  .playground [data-idf], .playground [data-sat] { white-space: pre-wrap; }
  @media (max-width: 560px) { .playground .b25-row { grid-template-columns: 2rem 3.6rem minmax(0, 1fr); } .playground .b25-text { grid-column: 1 / -1; } }
</style>
