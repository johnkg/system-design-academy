---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Place orders on the write side. A projector updates the read side after a delay you control.">
  <ol class="how">
    <li>Set a long <b>projection lag</b>, place an order, and press <b>Query the read model</b> straight away: it is stale. Query again after the lag.</li>
    <li>Press <b>+ Add revenue view</b>. A brand-new read model is built from history with no change to the write side.</li>
    <li>Press <b>Rebuild read models</b> to wipe them and replay every event.</li>
  </ol>
  <div class="pg" data-cqrs>
    <div class="pg-row">
      <label>Projection lag <input type="range" min="300" max="4000" step="100" value="2000" data-lag /> <b data-lagval>2.0 s</b></label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-order="Ada">Place order for Ada</button>
      <button class="btn pg-primary" type="button" data-order="Bob">Place order for Bob</button>
      <button class="btn" type="button" data-query>Query the read model</button>
      <button class="btn" type="button" data-addview>+ Add revenue view</button>
      <button class="btn" type="button" data-rebuild>Rebuild read models</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-2)"><h3>Write model</h3><span class="pg-mono" data-write></span></div>
      <div class="pg-box" style="--c: var(--role-4)"><h3>Read model: orders per customer</h3><span class="pg-mono" data-read></span></div>
      <div class="pg-box" style="--c: var(--role-3)" data-revbox hidden><h3>Read model: revenue per customer</h3><span class="pg-mono" data-rev></span></div>
    </div>
    <output class="pg-out" data-out aria-live="polite">Place an order.</output>
  </div>
</PlaygroundShell>
<script>
  interface Order { id: number; customer: string; total: number }
  document.querySelectorAll<HTMLElement>('[data-cqrs]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const MS_PER_S = 1000; const FIRST_ID = 100; const REBUILD_MS = 800; // replay delay shown on Rebuild
    const ORDER_TOTAL = { base: 20, steps: 6, step: 10 }; // order totals $20 to $70 in $10 steps
    let writes: Order[] = []; let projected = 0; let timers: number[] = []; let hasRev = false; let nextId = FIRST_ID;
    const lag = () => Number(q<HTMLInputElement>('[data-lag]').value);
    const say = (t: string, bad = false) => { const o = q('[data-out]'); o.textContent = t; o.classList.toggle('bad', bad); };
    const count = (list: Order[]) => { const m = new Map<string, number>(); list.forEach((o) => m.set(o.customer, (m.get(o.customer) ?? 0) + 1)); return [...m].map(([c, n]) => `${c}: ${n} order${n > 1 ? 's' : ''}`).join('\n') || '(empty)'; };
    const rev = (list: Order[]) => { const m = new Map<string, number>(); list.forEach((o) => m.set(o.customer, (m.get(o.customer) ?? 0) + o.total)); return [...m].map(([c, n]) => `${c}: $${n}`).join('\n') || '(empty)'; };
    function draw() {
      q('[data-lagval]').textContent = `${(lag() / MS_PER_S).toFixed(1)} s`;
      q('[data-write]').textContent = writes.length ? writes.map((o) => `#${o.id} ${o.customer} $${o.total}`).join('\n') : '(no orders)';
      const view = writes.slice(0, projected);
      q('[data-read]').textContent = count(view) + (projected < writes.length ? `\n(behind by ${writes.length - projected})` : '');
      q('[data-revbox]').hidden = !hasRev; q('[data-rev]').textContent = rev(view);
    }
    function place(customer: string) {
      const o: Order = { id: nextId++, customer, total: ORDER_TOTAL.base + Math.floor(Math.random() * ORDER_TOTAL.steps) * ORDER_TOTAL.step }; writes.push(o); draw();
      say(`Command accepted: order #${o.id} saved on the write side. The projector will update the read model in ${(lag() / MS_PER_S).toFixed(1)} s.`);
      timers.push(window.setTimeout(() => { projected = Math.max(projected, writes.indexOf(o) + 1); draw(); }, lag()));
    }
    q('[data-query]').addEventListener('click', () => { const stale = projected < writes.length; say(stale ? `Query answered from the read model, but it is ${writes.length - projected} event(s) behind: STALE (eventual consistency).` : 'Query answered from the read model: up to date.', stale); });
    q('[data-addview]').addEventListener('click', () => { hasRev = true; projected = Math.max(projected, 0); draw(); say(`New projection created and filled by replaying ${projected} past event(s). The write model was not touched.`); });
    q('[data-rebuild]').addEventListener('click', () => { timers.forEach(clearTimeout); timers = []; projected = 0; draw(); say('Read models wiped. Replaying every event...'); timers.push(window.setTimeout(() => { projected = writes.length; draw(); say(`Rebuilt from ${writes.length} event(s). Read models can always be recreated from the write side.`); }, REBUILD_MS)); });
    q('[data-reset]').addEventListener('click', () => { timers.forEach(clearTimeout); timers = []; writes = []; projected = 0; hasRev = false; nextId = FIRST_ID; draw(); say('Place an order.'); });
    root.querySelectorAll<HTMLElement>('[data-order]').forEach((b) => b.addEventListener('click', () => place(b.dataset.order!)));
    q('[data-lag]').addEventListener('input', draw);
    draw();
  });
</script>
