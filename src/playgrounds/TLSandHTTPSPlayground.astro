---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it" hint="A user sends a password from café Wi-Fi. Choose the protocol, the server's certificate and what the attacker on the network does, and see what the browser says and what the attacker learns.">
  <ol class="how">
    <li>Pick <b>HTTP</b> with an <b>eavesdropper</b>: the attacker reads the password in plain text.</li>
    <li>Switch to <b>HTTPS</b> with a valid certificate: the eavesdropper sees only scrambled bytes.</li>
    <li>Make the attacker an <b>active impostor</b>: the browser shows a warning because the certificate does not match. Tick <b>user clicks through the warning</b> to see why that is a bad habit. Also try the expired and self-signed certificates.</li>
  </ol>
  <div class="pg tls" data-tls>
    <div class="pg-row">
      <label>Protocol <select class="pg-in" data-proto><option value="http">HTTP (no TLS)</option><option value="https" selected>HTTPS (TLS)</option></select></label>
      <label>Server certificate <select class="pg-in" data-cert>
        <option value="valid" selected>Valid, for shop.example</option>
        <option value="expired">Expired</option>
        <option value="wrong">Issued for another domain</option>
        <option value="self">Self-signed</option>
      </select></label>
      <label>Attacker on the network <select class="pg-in" data-attacker>
        <option value="none">None</option>
        <option value="passive" selected>Eavesdropper (reads traffic)</option>
        <option value="active">Impostor (intercepts and replaces the server)</option>
      </select></label>
      <label class="tls-check"><input type="checkbox" data-click /> User clicks through any warning</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-browserbox><h3>Browser shows</h3><span class="pg-mono" data-browser></span><span class="pg-note" data-browsernote></span></div>
      <div class="pg-box" data-attackbox><h3>Attacker learns</h3><span class="pg-mono" data-attack></span><span class="pg-note" data-attacknote></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-tls]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    function draw() {
      const proto = q<HTMLSelectElement>('[data-proto]').value; const cert = q<HTMLSelectElement>('[data-cert]').value; const atk = q<HTMLSelectElement>('[data-attacker]').value; const click = q<HTMLInputElement>('[data-click]').checked;
      q<HTMLSelectElement>('[data-cert]').disabled = proto === 'http';
      // What certificate does the browser actually receive?
      const received = proto === 'http' ? 'none' : atk === 'active' ? 'impostor' : cert;
      let browser = ''; let note = ''; let warn = false;
      if (proto === 'http') { browser = 'No padlock: "Not secure"'; note = 'The connection is plain text and nothing is verified.'; }
      else if (received === 'valid') { browser = 'Padlock: secure connection'; note = 'Certificate is trusted, current and for shop.example.'; }
      else { warn = true; browser = 'Warning page: connection not private'; note = { expired: 'The certificate has expired.', wrong: 'The certificate is for a different domain.', self: 'The certificate is not signed by a trusted authority.', impostor: 'The certificate is not for shop.example and not from a trusted authority.' }[received as 'expired']!; }
      const connected = proto === 'http' || !warn || click;
      let attack = ''; let attackNote = ''; let leaked = false;
      if (!connected) { attack = 'Nothing: the user turned back'; attackNote = 'The password was never sent.'; }
      else if (proto === 'http') { if (atk === 'none') { attack = 'Nothing: no attacker present'; } else { attack = 'The username and password in plain text'; leaked = true; attackNote = atk === 'active' ? 'And the attacker could also change the page or the response.' : 'Anyone on the Wi-Fi can read it.'; } }
      else if (received === 'impostor') { attack = 'The username and password in plain text'; leaked = true; attackNote = 'The user clicked through the warning and talked to the impostor.'; }
      else if (atk === 'none') attack = 'Nothing: no attacker present';
      else if (atk === 'passive') { attack = 'Only encrypted bytes'; attackNote = 'Without the session key the data is unreadable and cannot be altered unnoticed.'; }
      else attack = 'Only encrypted bytes';
      if (connected && proto === 'https' && received !== 'impostor' && warn) { attackNote = `The connection is encrypted, but the user ignored a ${received} certificate warning. If an attacker is present, this habit is what lets them in.`; }
      q('[data-browser]').textContent = browser; q('[data-browsernote]').textContent = note;
      q('[data-attack]').textContent = attack; q('[data-attacknote]').textContent = attackNote;
      q<HTMLElement>('[data-browserbox]').style.setProperty('--c', warn || proto === 'http' ? 'var(--bad)' : 'var(--role-2)');
      q<HTMLElement>('[data-attackbox]').style.setProperty('--c', leaked ? 'var(--bad)' : 'var(--role-2)');
      const out = q('[data-verdict]'); out.classList.toggle('bad', leaked);
      out.textContent = leaked ? 'The password leaked.' : 'The password stayed private.';
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .tls-check { display: inline-flex; align-items: center; gap: 6px; }
</style>
