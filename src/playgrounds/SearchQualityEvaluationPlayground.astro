---
import PlaygroundShell from '../components/PlaygroundShell.astro';
import RangeField from '../components/RangeField.astro';
---
<PlaygroundShell title="Simulate it" hint="Six judged queries: three head queries (searched constantly) and three tail queries (rare), each with documents graded 0 to 3. Ranker A is the current ranker, ranker B is a candidate. The grades under each ranker are the grades of its top results, in order. A document with grade 1 or more counts as relevant.">
  <ol class="how">
    <li>Start with the defaults: <b>k</b> 5, <b>Query mix</b> on <b>Every query counts the same</b>, deciding by NDCG. B wins the average, <b>0.66</b> against <b>0.60</b>, but look at the list: A is better on 4 of the 6 queries. B wins on average because of a few large gains.</li>
    <li>Set <b>Query mix</b> to <b>Weighted by real traffic</b>: the head queries are most of the searches, and now A wins, <b>0.82</b> against <b>0.70</b>. Set <b>Query mix</b> to <b>Head queries only</b>: A leads <b>0.97</b> to <b>0.71</b>. Set <b>Query mix</b> to <b>Tail queries only</b>: B leads <b>0.63</b> to <b>0.25</b>. Same rankers, same judgments, opposite winners.</li>
    <li>Set <b>Query mix</b> back to <b>Every query counts the same</b> and <b>Leave out query</b> to <b>gift for dad who likes coffee</b>, the query where A finds nothing relevant and B finds a perfect list. Without it A wins, <b>0.72</b> against <b>0.60</b>. One query decided the whole comparison.</li>
    <li>Set <b>Leave out query</b> to <b>None</b> and <b>k</b> to <b>3</b>: the average NDCG falls to <b>0.55</b> for A and <b>0.51</b> for B, so A leads again. The choice of k alone flipped the winner. A handful of judged queries cannot settle this; hundreds can, and an online A/B test confirms what the offline metric suggests.</li>
  </ol>
  <div class="pg qe" data-qe>
    <div class="pg-row">
      <RangeField label="k" name="k" min="1" max="5" step="1" value="5" readout="5" />
      <label>Query mix <select class="pg-in" data-mix><option value="equal" selected>Every query counts the same</option><option value="traffic">Weighted by real traffic</option><option value="head">Head queries only</option><option value="tail">Tail queries only</option></select></label>
      <label>Leave out query <select class="pg-in" data-drop><option value="-1" selected>None</option></select></label>
      <label>Decide by <select class="pg-in" data-metric><option value="ndcg" selected>NDCG</option><option value="p">Precision</option><option value="r">Recall</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-wbox><h3>Winner on average</h3><span class="pg-mono" data-win></span><span class="pg-note" data-winnote></span></div>
      <div class="pg-box" data-abox style="--c: var(--border)"><h3>Average, ranker A</h3><span class="pg-mono" data-avga></span><span class="pg-note" data-avgnote></span></div>
      <div class="pg-box" data-bbox style="--c: var(--border)"><h3>Average, ranker B</h3><span class="pg-mono" data-avgb></span><span class="pg-note" data-avgnote2></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Per query</h3>
      <ol class="qe-list" data-list></ol>
      <span class="pg-note" data-listnote></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  interface Q { text: string; head: boolean; weight: number; grades: Record<string, number>; a: string[]; b: string[] }
  const QUERIES: Q[] = [
    { text: 'iphone case', head: true, weight: 40, grades: { d1: 3, d2: 3, d3: 2, d4: 2, d5: 1, d6: 1, d7: 0, d8: 0 },
      a: ['d1', 'd2', 'd3', 'd7', 'd4'], b: ['d1', 'd3', 'd7', 'd8', 'd2'] },
    { text: 'laptop', head: true, weight: 25, grades: { d1: 3, d2: 2, d3: 2, d4: 1, d5: 1, d6: 0, d7: 0 },
      a: ['d1', 'd2', 'd3', 'd4', 'd6'], b: ['d2', 'd6', 'd1', 'd7', 'd3'] },
    { text: 'headphones', head: true, weight: 15, grades: { d1: 3, d2: 3, d3: 2, d4: 1, d5: 0, d6: 0, d7: 0 },
      a: ['d1', 'd2', 'd5', 'd3', 'd4'], b: ['d5', 'd2', 'd6', 'd1', 'd7'] },
    { text: 'waterproof case for iphone 12 mini', head: false, weight: 7, grades: { d1: 3, d2: 2, d3: 2, d4: 1, d5: 0, d6: 0, d7: 0 },
      a: ['d5', 'd6', 'd4', 'd7', 'd1'], b: ['d2', 'd5', 'd6', 'd1', 'd4'] },
    { text: 'quiet mechanical keyboard office', head: false, weight: 7, grades: { d1: 3, d2: 3, d3: 1, d4: 1, d5: 0, d6: 0 },
      a: ['d3', 'd5', 'd1', 'd6', 'd4'], b: ['d3', 'd5', 'd6', 'd1', 'd4'] },
    { text: 'gift for dad who likes coffee', head: false, weight: 6, grades: { d1: 3, d2: 2, d3: 2, d4: 1, d5: 0, d6: 0, d7: 0, d8: 0, d9: 0 },
      a: ['d5', 'd6', 'd7', 'd8', 'd9'], b: ['d1', 'd2', 'd3', 'd4', 'd5'] },
  ];
  type Key = 'p' | 'r' | 'ndcg';
  interface M { p: number; r: number; ndcg: number }
  const hundredths = (x: number) => Math.floor(x * 100 + 0.5);
  const dcg = (grades: number[]) => grades.reduce((s, g, i) => s + (2 ** g - 1) / Math.log2(i + 2), 0);
  // The same model as the code samples: a document is relevant at grade 1 or more.
  function metrics(q: Q, ranking: string[], k: number): M {
    const got = ranking.slice(0, k).map((d) => q.grades[d] ?? 0);
    const relevantTotal = Object.values(q.grades).filter((g) => g > 0).length;
    const hits = got.filter((g) => g > 0).length;
    const ideal = Object.values(q.grades).sort((x, y) => y - x).slice(0, k);
    return { p: hundredths(hits / k), r: hundredths(hits / relevantTotal), ndcg: hundredths(dcg(got) / dcg(ideal)) };
  }
  const average = (values: number[], weights: number[]) => {
    const w = weights.reduce((s, x) => s + x, 0);
    return w === 0 ? 0 : Math.floor((2 * values.reduce((s, v, i) => s + v * weights[i], 0) + w) / (2 * w));
  };
  const f2 = (h: number) => (h / 100).toFixed(2);
  const NAMES: Record<Key, string> = { p: 'precision', r: 'recall', ndcg: 'NDCG' };

  document.querySelectorAll<HTMLElement>('[data-qe]').forEach((root) => {
    const q = query(root);
    const drop = q<HTMLSelectElement>('[data-drop]');
    QUERIES.forEach((x, i) => { const o = document.createElement('option'); o.value = String(i); o.textContent = x.text; drop.appendChild(o); });
    function draw() {
      const k = Number(q<HTMLInputElement>('[data-k]').value);
      q('[data-kval]').textContent = String(k);
      const mix = q<HTMLSelectElement>('[data-mix]').value;
      const dropped = Number(drop.value);
      const key = q<HTMLSelectElement>('[data-metric]').value as Key;
      const weights = QUERIES.map((x, i) => (i === dropped ? 0 : mix === 'equal' ? 1 : mix === 'traffic' ? x.weight : mix === 'head' ? (x.head ? x.weight : 0) : (x.head ? 0 : x.weight)));
      const ms = QUERIES.map((x) => ({ a: metrics(x, x.a, k), b: metrics(x, x.b, k) }));
      const a = average(ms.map((m) => m.a[key]), weights), b = average(ms.map((m) => m.b[key]), weights);
      const label = `${NAMES[key]}@${k}`;
      let aWins = 0, bWins = 0, ties = 0;
      ms.forEach((m, i) => { if (weights[i] === 0) return; if (m.a[key] > m.b[key]) aWins++; else if (m.b[key] > m.a[key]) bWins++; else ties++; });
      q('[data-win]').textContent = a === b ? 'tie' : `ranker ${a > b ? 'A' : 'B'}`;
      q('[data-winnote]').textContent = `by ${f2(Math.abs(a - b))} on average ${label}. Per query: A is better on ${aWins}, B on ${bWins}${ties ? `, ${ties} tied` : ''}.`;
      q<HTMLElement>('[data-wbox]').style.setProperty('--c', a === b ? 'var(--border)' : 'var(--accent)');
      q('[data-avga]').textContent = f2(a);
      q('[data-avgnote]').textContent = `average ${label}, ${mix === 'equal' ? 'every counted query weighs the same' : mix === 'traffic' ? 'weighted by traffic share' : mix === 'head' ? 'head queries only' : 'tail queries only'}`;
      q('[data-avgb]').textContent = f2(b);
      q('[data-avgnote2]').textContent = dropped >= 0 ? `without "${QUERIES[dropped].text}"` : 'all six judged queries';
      const list = q('[data-list]'); list.textContent = '';
      QUERIES.forEach((x, i) => {
        const li = document.createElement('li');
        li.className = 'qe-row' + (weights[i] === 0 ? ' off' : '');
        const title = document.createElement('div'); title.className = 'qe-title';
        const name = document.createElement('b'); name.textContent = `"${x.text}"`;
        const tag = document.createElement('span'); tag.className = 'pg-note';
        tag.textContent = ` ${x.head ? 'head' : 'tail'} query, ${x.weight}% of traffic${weights[i] === 0 ? ', not counted' : ''}`;
        title.append(name, tag);
        li.appendChild(title);
        for (const [who, ranking, m] of [['A', x.a, ms[i].a], ['B', x.b, ms[i].b]] as const) {
          const row = document.createElement('div'); row.className = 'pg-mono qe-line';
          const grades = ranking.slice(0, k).map((d) => x.grades[d] ?? 0).join(' ');
          row.textContent = `${who}: grades ${grades.padEnd(9)}  precision ${f2(m.p)}  recall ${f2(m.r)}  NDCG ${f2(m.ndcg)}`;
          li.appendChild(row);
        }
        list.appendChild(li);
      });
      q('[data-listnote]').textContent = `Metrics are computed at k = ${k}. The ideal list for each query puts its grade-3 documents first.`;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .qe-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .playground .qe-row { padding: 6px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); display: grid; gap: 2px; }
  .playground .qe-row.off { border-style: dashed; background: var(--surface-2); }
  .playground .qe-line { white-space: pre-wrap; }
</style>
