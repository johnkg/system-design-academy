---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Version v4 of the app is released on day 0. Each day a share of the willing users moves to it (16% on day 1, a point less each day, never below 1%), and 8% of users never update. Before that, 10% of users were on v1, 20% on v2 and 70% on v3. One server change goes live on the day you choose, for 1,000,000 active users. Assumptions: v1 rejects responses with an unknown field, v1 to v3 read the old name of a renamed field, v2 and v3 read a field that is later removed.">
  <ol class="how">
    <li>Start with the defaults: the change goes live on day <b>14</b> and renames a field, with no minimum version. The app versions in use are v4 <b>68.5%</b>, v3 <b>22.0%</b>, v2 <b>6.2%</b> and v1 <b>3.1%</b>. Every client older than v4 still reads the old name, so <b>314,414</b> users (<b>31.4%</b>) are broken. Set <b>Day the old behaviour is removed</b> to <b>7</b> and it is <b>430,505</b> (<b>43.0%</b>).</li>
    <li>Set <b>Day the old behaviour is removed</b> to <b>90</b>: three months after the release, still <b>15.3%</b> of users are broken, because the users who never update (8%) and the slow tail never move. Waiting for adoption does not make a breaking change safe.</li>
    <li>Set <b>Change type</b> to <b>Additive field</b> and <b>Day the old behaviour is removed</b> to <b>30</b>: only <b>26,401</b> users (<b>2.6%</b>) break, all on v1, which rejects a response with a field it does not know. Add a field, and make clients ignore fields they do not know.</li>
    <li>Set <b>Change type</b> to <b>Renamed field</b>, keep <b>Day the old behaviour is removed</b> at <b>30</b>, then set <b>Forced-upgrade threshold</b> to <b>Minimum version v3</b>: <b>79,204</b> users on v1 and v2 are sent to an update screen instead of a crash, and the broken users fall to <b>184,811</b>. Then tick <b>Server adapts to the app-version header</b>: the server keeps sending old clients the shape they know, and <b>0</b> are broken.</li>
  </ol>
  <div class="pg oa" data-oa>
    <div class="pg-row">
      <label>Day the old behaviour is removed <input class="pg-in" type="number" min="0" max="90" step="1" value="14" data-day /></label>
      <label>Change type <select class="pg-in" data-change><option value="renamed" selected>Renamed field</option><option value="removed">Removed field</option><option value="additive">Additive field</option></select></label>
      <label>Forced-upgrade threshold <select class="pg-in" data-min><option value="1" selected>No minimum version</option><option value="2">Minimum version v2</option><option value="3">Minimum version v3</option><option value="4">Minimum version v4</option></select></label>
      <label><input type="checkbox" data-adapt /> Server adapts to the app-version header</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Users broken by the change</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Forced to upgrade</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Share of users on each version that day</h3>
      <div class="oa-vers" data-vers></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Adoption over 90 days</h3>
      <div class="oa-chart" data-chart role="img" aria-label="For each day after the release, the share of users on each of the four app versions"></div>
      <span class="pg-note" data-n3></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const USERS = 1000000; const NEVER_PPM = 80000; const BASE = [100000, 200000, 700000]; const NAMES = ['v1', 'v2', 'v3', 'v4']; const STRICT_PARSER = 1; const DAYS = 90;
  type Change = 'additive' | 'renamed' | 'removed';

  const makeRng = (seed: number) => { let s = seed; return () => { s = (s * 48271) % 2147483647; return s; }; };
  // The same model as the code samples. remaining[d] is the part per million of willing users still on an old version.
  const REMAINING = (() => {
    const next = makeRng(5); const remaining = [1000000];
    for (let d = 1; d <= DAYS; d++) { const pct = Math.max(1, 16 - d) + (next() % 2); remaining.push(Math.floor((remaining[d - 1] * (100 - pct)) / 100)); }
    return remaining;
  })();
  const percent = (users: number) => { const tenths = Math.floor((users * 1000) / USERS); return `${Math.floor(tenths / 10)}.${tenths % 10}%`; };
  function versions(day: number): number[] {
    const keep = NEVER_PPM + Math.floor(((1000000 - NEVER_PPM) * REMAINING[day]) / 1000000);
    const old = BASE.map((u) => Math.floor((u * keep) / 1000000));
    return [...old, USERS - old.reduce((a, b) => a + b, 0)];
  }
  function simulate(change: Change, day: number, minVersion: number, adapt: boolean) {
    const users = versions(day);
    const affected = change === 'additive' ? [STRICT_PARSER] : change === 'renamed' ? [1, 2, 3] : [2, 3];
    const forced = users.filter((_, i) => i + 1 < minVersion).reduce((a, b) => a + b, 0);
    const broken = adapt ? 0 : affected.filter((v) => v >= minVersion).reduce((a, v) => a + users[v - 1], 0);
    return { users, broken, forced, affected };
  }

  const COLOR = ['var(--bad)', '#d97706', '#ca8a04', 'var(--good)'];
  document.querySelectorAll<HTMLElement>('[data-oa]').forEach((root) => {
    const q = query(root);
    const vers = q('[data-vers]'); const chart = q('[data-chart]');
    const rows = NAMES.map((name, i) => {
      const row = document.createElement('div'); row.className = 'oa-row';
      const label = document.createElement('span'); label.className = 'oa-label'; label.textContent = name === 'v4' ? 'v4 (new)' : name;
      const track = document.createElement('span'); track.className = 'oa-track';
      const bar = document.createElement('span'); bar.className = 'oa-bar'; bar.style.background = COLOR[i]; track.appendChild(bar);
      const val = document.createElement('span'); val.className = 'oa-val pg-mono';
      row.append(label, track, val); vers.appendChild(row);
      return { bar, val };
    });
    const cols: HTMLElement[][] = [];
    for (let d = 0; d <= DAYS; d++) {
      const col = document.createElement('div'); col.className = 'oa-col';
      const parts = NAMES.map((_, i) => { const p = document.createElement('div'); p.style.background = COLOR[3 - i]; col.appendChild(p); return p; });
      chart.appendChild(col); cols.push([col, ...parts]);
    }
    const num = (sel: string, lo: number, hi: number, dflt: number) => { const el = q<HTMLInputElement>(sel); const v = Number(el.value); return Number.isFinite(v) && el.value !== '' ? Math.min(hi, Math.max(lo, Math.round(v))) : dflt; };
    function draw() {
      const day = num('[data-day]', 0, DAYS, 14); const minV = Number(q<HTMLSelectElement>('[data-min]').value);
      const change = q<HTMLSelectElement>('[data-change]').value as Change; const adapt = q<HTMLInputElement>('[data-adapt]').checked;
      const r = simulate(change, day, minV, adapt);
      q('[data-o1]').textContent = `${formatThousands(r.broken)} of ${formatThousands(USERS)} (${percent(r.broken)})`;
      q('[data-n1]').textContent = adapt ? 'the server reads the version header and sends each client the shape it knows' : `${r.affected.filter((v) => v >= minV).map((v) => NAMES[v - 1]).join(', ') || 'no version'} ${change === 'additive' ? 'rejects the unknown field' : change === 'renamed' ? 'cannot find the field under its old name' : 'expects a field that is gone'}`;
      q<HTMLElement>('[data-b1]').style.setProperty('--c', r.broken === 0 ? 'var(--good)' : 'var(--bad)');
      q('[data-o2]').textContent = `${formatThousands(r.forced)} users (${percent(r.forced)})`;
      q('[data-n2]').textContent = minV === 1 ? 'no minimum version: nobody is sent to an update screen' : `versions below ${NAMES[minV - 1]} see an update screen instead of the app, including users who never update; they must update to continue`;
      q<HTMLElement>('[data-b2]').style.setProperty('--c', 'var(--border)');
      r.users.forEach((u, i) => { rows[i].bar.style.width = `${Math.max(0.4, (u / USERS) * 100)}%`; rows[i].val.textContent = `${percent(u)} (${formatThousands(u)})`; });
      for (let d = 0; d <= DAYS; d++) {
        const u = versions(d);
        cols[d].slice(1).forEach((part, i) => { part.style.height = `${(u[3 - i] / USERS) * 100}%`; });
        cols[d][0].classList.toggle('oa-now', d === day); cols[d][0].title = `Day ${d}: v4 ${percent(u[3])}`;
      }
      q('[data-n3]').textContent = `Each column is a day, day 0 on the left. Green: v4. Red: v1, the oldest. The outlined column is day ${day}. The 8% who never update stay on their version for the whole period.`;
    }
    root.addEventListener('change', draw);
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .playground .oa-row { display: flex; align-items: center; gap: 8px; margin: 4px 0; }
  .playground .oa-label { width: 64px; font-size: 13px; flex: none; }
  .playground .oa-track { flex: 1; height: 14px; background: color-mix(in srgb, var(--border) 50%, transparent); border-radius: 3px; overflow: hidden; display: block; }
  .playground .oa-bar { display: block; height: 100%; border-radius: 3px; }
  .playground .oa-val { font-size: 12px; min-width: 0; text-align: right; flex: none; }
  .playground .oa-chart { display: flex; align-items: stretch; gap: 1px; height: 90px; }
  .playground .oa-col { flex: 1; display: flex; flex-direction: column; min-width: 1px; outline: 2px solid transparent; }
  .playground .oa-col > div { width: 100%; }
  .playground .oa-now { outline: 2px solid var(--text, #000); }
</style>
