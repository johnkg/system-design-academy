---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Same shop data, two models. Pick a task and see how much work each one does.">
  <ol class="how">
    <li>Look at the two <b>data layouts</b> below: the same order, stored two ways.</li>
    <li>Pick a <b>task</b> and compare the bars. Neither model wins every task.</li>
    <li>Drag the <b>number of orders</b> to see which costs grow with your data (try the revenue and new field tasks).</li>
  </ol>
  <div class="pg" data-sqlnosql>
    <div class="pg-grid sn-layouts">
      <div class="pg-box" style="--c: var(--role-2)"><h3>Relational</h3><pre class="pg-code" data-sqlshape></pre></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Document</h3><pre class="pg-code" data-docshape></pre></div>
    </div>
    <label class="pg-row">Orders in the system <input type="range" min="100" max="100000" step="100" value="10000" data-n /> <b data-nval>10,000</b></label>
    <div class="pg-row" role="group" aria-label="Task" data-tasks></div>
    <div class="sn-bars">
      <div class="sn-row"><span>Relational</span><div class="sn-track"><div class="sn-fill" data-sqlfill style="background: var(--role-2)"></div></div><b data-sqlops></b></div>
      <div class="sn-row"><span>Document</span><div class="sn-track"><div class="sn-fill" data-docfill style="background: var(--role-3)"></div></div><b data-docops></b></div>
    </div>
    <output class="pg-out" data-out aria-live="polite"></output>
  </div>
</PlaygroundShell>
<script>
  const ORDERS_PER_CUSTOMER = 10; const ITEMS_PER_ORDER = 3;
  interface Result { sql: number; doc: number; unit: string; sqlNote: string; docNote: string }
  const tasks: { id: string; label: string; run: (n: number) => Result }[] = [
    { id: 'one', label: 'Show one order with customer and items', run: () => ({ sql: 3, doc: 1, unit: 'lookups', sqlNote: 'Joins orders, customers and order_items.', docNote: 'One document holds everything for the page.' }) },
    { id: 'addr', label: 'Customer changes address', run: () => ({ sql: 1, doc: ORDERS_PER_CUSTOMER, unit: 'writes', sqlNote: 'The address is stored once, in the customers table.', docNote: `The address is copied into each of this customer's ${ORDERS_PER_CUSTOMER} orders, and every copy must be updated.` }) },
    { id: 'rev', label: 'Revenue per customer, all time', run: (n) => ({ sql: n * ITEMS_PER_ORDER, doc: n, unit: 'rows or documents read (a document is far bigger than a row)', sqlNote: 'One GROUP BY query; the optimiser and indexes do the work, reading narrow rows.', docNote: 'Needs an aggregation pipeline or application code, and reads whole documents.' }) },
    { id: 'shard', label: 'Fetch one order when data is spread over 10 machines', run: () => ({ sql: 3, doc: 1, unit: 'machines touched', sqlNote: 'Related rows may live on different machines, so the join crosses the network.', docNote: 'The whole order lives on one machine, so one machine answers.' }) },
    { id: 'field', label: 'Add a new field (gift message) to orders', run: (n) => ({ sql: n, doc: 0, unit: 'existing records changed', sqlNote: 'A schema migration: the new column is added to the whole table (some databases do this cheaply, many do not).', docNote: 'Nothing to migrate. New documents simply include the field.' }) },
  ];
  document.querySelectorAll<HTMLElement>('[data-sqlnosql]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let cur = tasks[0];
    q('[data-sqlshape]').textContent = 'customers: id, name, address\norders:    id, customer_id, date\nitems:     order_id, product, qty\n\neach fact stored once';
    q('[data-docshape]').textContent = '{ "order": 1042,\n  "customer": { "name": "Ada",\n    "address": "..." },\n  "items": [ {"product": ...}, ... ] }\n\ncustomer copied into every order';
    function draw() {
      const n = Number(q<HTMLInputElement>('[data-n]').value); q('[data-nval]').textContent = n.toLocaleString();
      const r = cur.run(n); const max = Math.max(r.sql, r.doc, 1);
      q('[data-sqlfill]').style.width = `${Math.max(r.sql ? 2 : 0, (r.sql / max) * 100)}%`; q('[data-docfill]').style.width = `${Math.max(r.doc ? 2 : 0, (r.doc / max) * 100)}%`;
      q('[data-sqlops]').textContent = `${r.sql.toLocaleString()}`; q('[data-docops]').textContent = `${r.doc.toLocaleString()}`;
      q('[data-out]').textContent = `Task: ${cur.label} (measured in ${r.unit})\nRelational: ${r.sqlNote}\nDocument: ${r.docNote}`;
    }
    tasks.forEach((t) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = t.label; b.setAttribute('aria-pressed', String(t === cur)); b.addEventListener('click', () => { cur = t; q('[data-tasks]').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); draw(); }); q('[data-tasks]').appendChild(b); });
    q('[data-n]').addEventListener('input', draw); draw();
  });
</script>
<style is:global>
  .playground .sn-layouts { grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .playground .sn-bars { display: grid; gap: 8px; }
  .playground .sn-row { display: grid; grid-template-columns: 92px 1fr 80px; gap: 8px; align-items: center; font-size: .9rem; }
  .playground .sn-track { height: 16px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .playground .sn-fill { height: 100%; width: 0; border-radius: 99px; transition: width .3s; }
  .playground .sn-row b { text-align: right; font-family: var(--font-mono); }
</style>
