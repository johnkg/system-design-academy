---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A client calls a partner API that fails some of the time. Compare calling it directly with calling it through an ambassador that retries and can open a circuit.">
  <ol class="how">
    <li>Start with the defaults: <b>Failure rate</b> at <b>30</b>, <b>Retries</b> at <b>2</b>, <b>Circuit breaker</b> <b>Off</b> and <b>Design</b> <b>Direct calls</b>. <b>70</b> percent of requests succeed, using <b>1</b> call to the partner each.</li>
    <li>Set <b>Design</b> to <b>Ambassador</b>: <b>97.3</b> percent succeed, using <b>1.39</b> calls each. Retries recover most failures, for a little extra traffic.</li>
    <li>Set <b>Failure rate</b> to <b>100</b>, so the partner is down: <b>0</b> percent succeed, and every request sends <b>3</b> calls. That is the retry storm.</li>
    <li>Set <b>Circuit breaker</b> to <b>On</b>: the ambassador stops calling the partner, and requests send <b>0</b> calls and fail at once.</li>
  </ol>
  <div class="pg amb" data-amb>
    <div class="pg-row">
      <label>Failure rate <input class="pg-in" type="range" min="0" max="100" step="10" value="30" data-f /> <b data-fv></b> %</label>
      <label>Retries <input class="pg-in" type="range" min="0" max="4" step="1" value="2" data-r /> <b data-rv></b></label>
      <label>Circuit breaker <select class="pg-in" data-breaker><option value="0" selected>Off</option><option value="1">On</option></select></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Direct calls</option><option value="1">Ambassador</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Requests that succeed</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Calls sent to the partner per request</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Where the policy lives</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // Expected values for a request that is tried up to 1 + retries times; the circuit breaker is modelled as opening when the partner is down.
  type Tone = 'good' | 'bad' | 'mid';
  const trim = (n: number, digits: number) => String(Number(n.toFixed(digits)));
  document.querySelectorAll<HTMLElement>('[data-amb]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const f = Number(q<HTMLInputElement>('[data-f]').value) / 100, retries = Number(q<HTMLInputElement>('[data-r]').value);
      const breaker = q<HTMLSelectElement>('[data-breaker]').value === '1', ambassador = q<HTMLSelectElement>('[data-design]').value === '1';
      q('[data-fv]').textContent = String(Math.round(f * 100)); q('[data-rv]').textContent = String(retries);
      const attempts = ambassador ? 1 + retries : 1;
      const success = 100 * (1 - f ** attempts);
      const open = ambassador && breaker && f >= 1;
      let calls = 0; for (let k = 0; k < attempts; k++) calls += f ** k;
      if (open) calls = 0;
      setBox(1, `${trim(success, 1)} %`, ambassador ? `each request is tried up to ${attempts} times` : 'each request is tried once', success >= 95 ? 'good' : success < 50 ? 'bad' : 'mid');
      setBox(2, trim(calls, 2), open ? 'the circuit is open: the partner is left alone' : ambassador && calls >= 2 ? 'retries multiply the load on a partner that is struggling' : 'about one call for each request', calls >= 2 ? 'bad' : 'good');
      setBox(3, ambassador ? 'One ambassador' : 'Every client', ambassador ? 'timeouts, retries and the breaker are written once' : 'each client decides for itself, and they differ', ambassador ? 'good' : 'mid');
      q('[data-verdict]').textContent = ambassador
        ? breaker ? 'Retries recover most failures. With the breaker on, a partner that is down is not called at all, so it can recover.' : 'Retries recover most failures. Without a circuit breaker, a down partner receives several times its usual traffic.'
        : 'Each failure reaches the user, and each client is on its own for policy.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
