---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it" hint="Log in, call endpoints, then try to cheat: edit the token, let it expire, or call something you are not allowed to. The signature here is a toy hash for illustration, not real cryptography.">
  <ol class="how">
    <li>Log in as <b>alice</b> and call <b>GET /orders/alice-1</b>: allowed. Call <b>GET /orders/bob-1</b>: <b>403</b>, because you are known but it is not your order.</li>
    <li>Press <b>Edit token: make me admin</b>, then call <b>GET /admin/users</b>: <b>401</b>, since the signature no longer matches the claims.</li>
    <li>Press <b>Wait 20 minutes</b> and call anything: <b>401</b>, the token has expired. Log in as <b>bob</b> to see an admin succeed.</li>
  </ol>
  <div class="pg aa" data-aa>
    <div class="pg-row">
      <label>User <select class="pg-in" data-user><option value="alice" selected>alice (customer)</option><option value="bob">bob (admin)</option></select></label>
      <button class="btn pg-primary" type="button" data-login>Log in</button>
      <button class="btn" type="button" data-tamper>Edit token: make me admin</button>
      <button class="btn" type="button" data-wait>Wait 20 minutes</button>
      <button class="btn" type="button" data-clear>Remove token</button>
    </div>
    <div class="pg-row">
      <button class="btn" type="button" data-call="own">GET /orders/alice-1</button>
      <button class="btn" type="button" data-call="other">GET /orders/bob-1</button>
      <button class="btn" type="button" data-call="admin">GET /admin/users</button>
    </div>
    <div class="pg-grid" aria-live="polite">
      <div class="pg-box" style="--c: var(--role-1)"><h3>Token held by the client</h3><span class="pg-mono" data-token></span></div>
      <div class="pg-box" data-resbox><h3>Last response</h3><span class="pg-mono" data-res>No call yet</span><span class="pg-note" data-why></span></div>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="Calls so far"></ol>
  </div>
</PlaygroundShell>
<script>
  const SECRET = 'server-secret';
  const hash = (text: string) => { let h = 2166136261; for (const c of text + SECRET) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619) >>> 0; } return h.toString(16).padStart(8, '0'); };
  interface Token { claims: { sub: string; role: string; exp: number }; sig: string }
  document.querySelectorAll<HTMLElement>('[data-aa]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let token: Token | null = null; let now = 0; const log: string[] = [];
    const LOG = 8; const rows: HTMLElement[] = [];
    for (let i = 0; i < LOG; i++) { const li = document.createElement('li'); li.hidden = true; q('[data-log]').appendChild(li); rows.push(li); }
    function call(kind: string) {
      const label = kind === 'own' ? 'GET /orders/alice-1' : kind === 'other' ? 'GET /orders/bob-1' : 'GET /admin/users';
      let status = '200 OK'; let why = '';
      if (!token) { status = '401 Unauthorized'; why = 'No token: the server does not know who you are.'; }
      else if (token.sig !== hash(JSON.stringify(token.claims))) { status = '401 Unauthorized'; why = 'The signature does not match the claims, so the token was altered.'; }
      else if (token.claims.exp <= now) { status = '401 Unauthorized'; why = 'The token has expired.'; }
      else {
        const { sub, role } = token.claims;
        if (kind === 'admin' && role !== 'admin') { status = '403 Forbidden'; why = `Authenticated as ${sub}, but only admins may list users.`; }
        else if (kind === 'other' && role !== 'admin' && sub !== 'bob') { status = '403 Forbidden'; why = `Authenticated as ${sub}, but order bob-1 belongs to bob.`; }
        else if (kind === 'own' && role !== 'admin' && sub !== 'alice') { status = '403 Forbidden'; why = `Authenticated as ${sub}, but order alice-1 belongs to alice.`; }
        else why = `Authenticated as ${sub} (${role}) and allowed.`;
      }
      q('[data-res]').textContent = status; q('[data-why]').textContent = why;
      q<HTMLElement>('[data-resbox]').style.setProperty('--c', status.startsWith('200') ? 'var(--role-2)' : 'var(--bad)');
      log.unshift(`${label}: ${status}`); if (log.length > LOG) log.pop(); draw();
    }
    function draw() {
      q('[data-token]').textContent = token ? `sub: ${token.claims.sub}, role: ${token.claims.role}, expires in ${Math.max(0, token.claims.exp - now)} min, signature: ${token.sig}` : 'none';
      rows.forEach((li, i) => { li.hidden = log[i] === undefined; if (log[i] !== undefined) { li.textContent = log[i]; li.style.color = log[i].includes('200') ? '' : 'var(--bad-text)'; } });
    }
    q('[data-login]').addEventListener('click', () => { const sub = q<HTMLSelectElement>('[data-user]').value; const claims = { sub, role: sub === 'bob' ? 'admin' : 'customer', exp: now + 15 }; token = { claims, sig: hash(JSON.stringify(claims)) }; draw(); });
    q('[data-tamper]').addEventListener('click', () => { if (token) { token = { claims: { ...token.claims, role: 'admin' }, sig: token.sig }; draw(); } });
    q('[data-wait]').addEventListener('click', () => { now += 20; draw(); });
    q('[data-clear]').addEventListener('click', () => { token = null; draw(); });
    root.querySelectorAll<HTMLElement>('[data-call]').forEach((b) => b.addEventListener('click', () => call(b.dataset.call!)));
    draw();
  });
</script>
