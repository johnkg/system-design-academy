---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Play with a live NewsChannel. It runs the same pattern as the code samples.">
  <ol class="how">
    <li><b>Subscribe or unsubscribe</b> subscribers with the buttons on the cards.</li>
    <li><b>Publish</b> a headline and watch who receives it.</li>
    <li><b>Add a new subscriber</b>. The channel code does not change, which is the point.</li>
  </ol>

  <div class="demo" data-demo>
    <div class="channel">
      <strong>NewsChannel</strong>
      <code data-list class="list"></code>
      <form data-form>
        <label class="sr" for="headline">Headline</label>
        <input id="headline" name="headline" value="Observer pattern explained" autocomplete="off" />
        <button class="btn primary" type="submit">Publish</button>
      </form>
      <p class="msg" data-msg aria-live="polite">Press Publish to send a headline.</p>
    </div>
    <div class="cards" data-cards></div>
    <div class="layer" data-layer aria-hidden="true"></div>
  </div>

  <div class="actions">
    <button class="btn" type="button" data-add>+ Add a new subscriber type</button>
    <span class="note" data-note></span>
  </div>
</PlaygroundShell>
<script>
  // The pattern in miniature: the channel only knows the Observer interface.
  interface Observer { name: string; update(headline: string): void }
  class NewsChannel {
    private subscribers = new Set<Observer>();
    subscribe(o: Observer) { this.subscribers.add(o); }
    unsubscribe(o: Observer) { this.subscribers.delete(o); }
    names() { return [...this.subscribers].map((o) => o.name); }
    publish(headline: string) { this.subscribers.forEach((o) => o.update(headline)); }
  }

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const TRAVEL = 700;
  const INBOX_MAX = 3; // headlines kept in each subscriber's inbox

  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((root) => {
    const channel = new NewsChannel();
    const cards = root.querySelector<HTMLElement>('[data-cards]')!;
    const layer = root.querySelector<HTMLElement>('[data-layer]')!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const msg = root.querySelector<HTMLElement>('[data-msg]')!;
    const channelBox = root.querySelector<HTMLElement>('.channel')!;
    const addBtn = root.parentElement!.querySelector<HTMLButtonElement>('[data-add]')!;
    const note = root.parentElement!.querySelector<HTMLElement>('[data-note]')!;
    const extra = ['Push', 'Slack', 'Pager'];
    let msgTimer: number | undefined;

    const refreshList = () => (list.textContent = `subscribers: [${channel.names().join(', ')}]`);
    const say = (text: string) => { msg.textContent = text; };

    function point(el: HTMLElement, edge: 'top' | 'bottom') {
      const s = root.getBoundingClientRect(), r = el.getBoundingClientRect();
      return { x: r.left - s.left + r.width / 2, y: (edge === 'top' ? r.top : r.bottom) - s.top };
    }

    function addCard(name: string, subscribed: boolean, isNew = false) {
      const card = document.createElement('div');
      card.className = 'card sub' + (isNew ? ' fresh' : '');
      card.innerHTML = `<h3></h3><span class="status"></span><button class="btn" type="button"></button><ul class="inbox" aria-label="Received headlines"><li class="empty">Nothing yet</li></ul>`;
      card.querySelector('h3')!.textContent = name;
      const status = card.querySelector<HTMLElement>('.status')!;
      const toggle = card.querySelector<HTMLButtonElement>('button')!;
      const inbox = card.querySelector<HTMLUListElement>('.inbox')!;

      const observer: Observer = {
        name,
        update(headline) {
          const deliver = () => {
            inbox.querySelector('.empty')?.remove();
            const li = document.createElement('li');
            li.textContent = headline;
            li.className = 'got';
            inbox.prepend(li);
            while (inbox.children.length > INBOX_MAX) inbox.lastElementChild!.remove();
            card.classList.remove('hit'); void card.offsetWidth; card.classList.add('hit');
          };
          if (reduceMotion.matches) return deliver();
          const from = point(channelBox, 'bottom'), to = point(card, 'top');
          const dot = document.createElement('i');
          dot.className = 'dot';
          layer.appendChild(dot);
          const at = (p: { x: number; y: number }, o: number, k: number) => ({ transform: `translate(${p.x}px, ${p.y}px) translate(-50%, -50%)`, opacity: o, offset: k });
          const anim = dot.animate([at(from, 0, 0), at(from, 1, 0.1), at(to, 1, 0.9), at(to, 0, 1)], { duration: TRAVEL, easing: 'cubic-bezier(.45,0,.25,1)', fill: 'forwards' });
          anim.onfinish = () => { dot.remove(); deliver(); };
        },
      };

      const render = () => {
        const on = channel.names().includes(name);
        card.classList.toggle('on', on);
        status.textContent = on ? 'listening' : 'not listening';
        toggle.textContent = on ? 'Unsubscribe' : 'Subscribe';
        toggle.setAttribute('aria-pressed', String(on));
        refreshList();
      };
      toggle.addEventListener('click', () => {
        channel.names().includes(name) ? channel.unsubscribe(observer) : channel.subscribe(observer);
        render();
      });
      if (subscribed) channel.subscribe(observer);
      cards.appendChild(card);
      render();
    }

    root.querySelector('form')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const headline = (root.querySelector<HTMLInputElement>('input[name=headline]')!.value || '(empty)').trim();
      const who = channel.names();
      window.clearTimeout(msgTimer);
      if (!who.length) {
        say('Nobody is subscribed, so nobody was notified.');
        return;
      }
      channel.publish(headline);
      say(`publish("${headline}") called update() on: ${who.join(', ')}`);
    });

    addCard('Email', true);
    addCard('SMS', false);

    addBtn.addEventListener('click', () => {
      const name = extra.shift();
      if (!name) return;
      addCard(name, false, true);
      note.textContent = `${name} added. NewsChannel was not edited: it treats ${name} as another Observer.`;
      if (!extra.length) addBtn.disabled = true;
    });
  });
</script>
<style is:global>
  .playground .how { margin: 0 0 14px; padding-left: 1.3rem; color: var(--muted); font-size: .95rem; }
  .playground .how b { color: var(--text); }
  .playground .demo { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  .playground .channel { justify-self: center; width: min(100%, 520px); text-align: center; padding: 12px; border: 2px solid var(--role-subject); border-radius: 12px; background: color-mix(in srgb, var(--role-subject) 8%, var(--surface)); }
  .playground .list { display: block; margin: 4px 0 10px; font-size: .8rem; color: var(--muted); overflow-wrap: anywhere; }
  .playground form { display: flex; gap: 8px; flex-wrap: wrap; }
  .playground input[name=headline] { flex: 1 1 200px; min-width: 0; font: inherit; padding: 6px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); }
  .playground .primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 600; }
  .playground .primary:hover { background: var(--accent); filter: brightness(1.1); }
  .playground .msg { margin: 10px 0 0; min-height: 1.4em; font: .8rem ui-monospace, monospace; color: var(--muted); overflow-wrap: anywhere; }
  .playground .cards { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr)); }
  .playground .sub { padding: 10px; border: 2px dashed var(--border); opacity: .8; transition: opacity .3s, border-color .3s, background .3s, box-shadow .3s; display: grid; gap: 6px; align-content: start; }
  .playground .sub.on { opacity: 1; border: 2px solid var(--role-concrete); background: color-mix(in srgb, var(--role-concrete) 8%, var(--surface)); }
  .playground .sub.fresh { animation: obs-pop .5s ease-out; }
  .playground .sub.hit { animation: obs-hit .6s ease-out; }
  .playground .sub h3 { margin: 0; }
  .playground .status { font-size: .75rem; color: var(--muted); }
  .playground .sub.on .status { color: var(--role-concrete); font-weight: 600; }
  .playground .inbox { margin: 0; padding: 0; list-style: none; font-size: .8rem; display: grid; gap: 3px; min-height: 3.6em; }
  .playground .inbox li { padding: 2px 6px; border-radius: 6px; background: var(--surface-2); overflow-wrap: anywhere; }
  .playground .inbox li.empty { background: none; color: var(--muted); padding-left: 0; }
  .playground .inbox li.got:first-child { animation: obs-fresh-msg .6s ease-out; }
  .playground .layer { position: absolute; inset: 0; pointer-events: none; }
  .playground .layer .dot { position: absolute; left: 0; top: 0; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 30%, transparent), 0 0 14px var(--accent); opacity: 0; }
  .playground .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 14px; }
  .playground .note { color: var(--muted); font-size: .85rem; }
  .playground .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @keyframes obs-pop { from { transform: scale(.85); opacity: 0; } }
  @keyframes obs-hit { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--role-concrete) 60%, transparent); } 100% { box-shadow: 0 0 0 12px transparent; } }
  @keyframes obs-fresh-msg { from { background: color-mix(in srgb, var(--role-concrete) 40%, transparent); } }

</style>
