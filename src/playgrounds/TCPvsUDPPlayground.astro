---
import PlaygroundShell from '../components/PlaygroundShell.astro';
import RangeField from '../components/RangeField.astro';
---
<PlaygroundShell title="Send 40 packets" hint="The same 40 packets (one every 20 ms) cross a network that drops some of them. Each square is a packet: green arrived in time, amber arrived late, red never arrived.">
  <ol class="how">
    <li>At <b>0% loss</b> both protocols look identical. Raise the <b>loss</b> to 10% and a <b>live call</b> over TCP gets many amber (late) packets: the stream stalls behind each retransmission.</li>
    <li>Over <b>UDP</b> a few packets are simply missing but the rest arrive on time. For a call that is better, for a <b>file download</b> any red square means a corrupt file.</li>
    <li>Raise the <b>round trip time</b> and see TCP's stalls grow: each retransmission costs about two round trips.</li>
  </ol>
  <div class="pg tu" data-tu>
    <div class="pg-row">
      <RangeField label="Network loss" name="loss" min="0" max="20" value="8" />
      <RangeField label="Round trip time" name="rtt" min="20" max="300" step="10" value="100" />
      <label>The data is <select class="pg-in" data-kind><option value="call" selected>A live call (late data is useless after 150 ms)</option><option value="file">A file download (every byte needed)</option></select></label>
    </div>
    <div class="tu-block"><h3>TCP</h3><div class="tu-cells" role="img" data-tcp aria-label="TCP packets"></div><p class="pg-mono" data-tcptxt></p></div>
    <div class="tu-block"><h3>UDP</h3><div class="tu-cells" role="img" data-udp aria-label="UDP packets"></div><p class="pg-mono" data-udptxt></p></div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const N = 40; const GAP = 20; const DEADLINE = 150;
  const SEED = 42; const RETRANSMIT_RTTS = 2; // a lost TCP packet costs a timeout plus a resend, about two round trips
  // mulberry32 PRNG
  function prng(seed: number) { let s = seed >>> 0; return () => { s = (s + 0x6d2b79f5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
  const rnd = prng(SEED); const draws = Array.from({ length: N }, () => [rnd(), rnd()]);
  document.querySelectorAll<HTMLElement>('[data-tu]').forEach((root) => {
    const q = query(root);
    const mk = (p: HTMLElement) => Array.from({ length: N }, () => { const i = document.createElement('i'); p.appendChild(i); return i; });
    const tcpCells = mk(q('[data-tcp]')); const udpCells = mk(q('[data-udp]'));
    function draw() {
      const loss = Number(q<HTMLInputElement>('[data-loss]').value) / 100; const rtt = Number(q<HTMLInputElement>('[data-rtt]').value); const kind = q<HTMLSelectElement>('[data-kind]').value;
      q('[data-lossval]').textContent = `${Math.round(loss * 100)}%`; q('[data-rttval]').textContent = `${rtt} ms`;
      let prev = 0; const tcp: number[] = []; const udp: (number | null)[] = [];
      for (let i = 0; i < N; i++) {
        const sent = i * GAP; const lost1 = draws[i][0] < loss; const lost2 = lost1 && draws[i][1] < loss;
        const arrival = sent + rtt / 2 + (lost1 ? RETRANSMIT_RTTS * rtt : 0) + (lost2 ? RETRANSMIT_RTTS * rtt : 0);
        prev = Math.max(prev, arrival); tcp.push(prev - sent);
        udp.push(lost1 ? null : rtt / 2);
      }
      const cls = (d: number | null) => (d === null ? 'lost' : d <= DEADLINE ? 'ok' : 'late');
      tcpCells.forEach((c, i) => (c.className = kind === 'call' ? cls(tcp[i]) : 'ok')); udpCells.forEach((c, i) => (c.className = cls(udp[i] === null ? null : kind === 'call' ? udp[i] : 0)));
      const onTime = (a: (number | null)[]) => a.filter((d) => d !== null && d <= DEADLINE).length;
      const tcpOn = onTime(tcp); const udpOn = onTime(udp); const udpLost = udp.filter((d) => d === null).length; const stall = Math.max(...tcp) ;
      q('[data-tcptxt]').textContent = kind === 'call' ? `${tcpOn} of ${N} on time · none lost · worst delay ${Math.round(stall)} ms` : `all ${N} delivered, complete in ${Math.round((N - 1) * GAP + stall)} ms`;
      q('[data-udptxt]').textContent = kind === 'call' ? `${udpOn} of ${N} on time · ${udpLost} lost · worst delay ${Math.round(rtt / 2)} ms` : `${N - udpLost} of ${N} delivered, ${udpLost} missing: the file is ${udpLost ? 'corrupt' : 'complete'}`;
      const out = q('[data-verdict]');
      const udpBetter = kind === 'call' && udpOn > tcpOn; const bad = kind === 'file' && udpLost > 0;
      out.classList.toggle('bad', bad || udpBetter);
      out.textContent = kind === 'call' ? (udpBetter ? `UDP shows ${udpOn - tcpOn} more packets on time: waiting for retransmissions is worse than skipping.` : 'No loss problem to see here: raise the loss.') : (udpLost ? 'UDP lost data. A file needs TCP, or your own retransmission on top of UDP.' : 'No packets were lost, so UDP got lucky. Raise the loss.');
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw); draw();
  });
</script>
<style is:global>
  .playground .tu-block h3 { margin: 0 0 4px; }
  .playground .tu-cells { display: grid; grid-template-columns: repeat(20, 1fr); gap: 2px; }
  .playground .tu-cells i { aspect-ratio: 1; border-radius: 3px; background: var(--surface-2); }
  .playground .tu-cells i.ok { background: var(--role-2); }
  .playground .tu-cells i.late { background: var(--role-3); }
  .playground .tu-cells i.lost { background: var(--bad); }
</style>
