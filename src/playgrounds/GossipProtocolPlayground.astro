---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Spread a rumour" hint="Node 1 learns something. Each round, every informed node tells a few random nodes. Each square is a node: filled means informed, dashed means crashed.">
  <ol class="how">
    <li>Press <b>Next round</b> repeatedly: the informed count roughly doubles each round, so 100 nodes are reached in about 7 to 10 rounds.</li>
    <li>Change the <b>fanout</b> to 1: it still works, only slower. Raise the <b>message loss</b>: it still completes, a few rounds later, because missed nodes hear it again.</li>
    <li>Increase the <b>number of nodes</b> to 100: rounds grow only slowly, which is why gossip scales. <b>Crash nodes</b> to see that the rest still converge.</li>
  </ol>
  <div class="pg gs" data-gs>
    <div class="pg-row">
      <label>Nodes <input type="range" min="10" max="100" step="10" value="50" data-n /> <b data-nval></b></label>
      <label>Fanout <input type="range" min="1" max="4" value="2" data-fan /> <b data-fanval></b></label>
      <label>Messages lost <input type="range" min="0" max="50" step="5" value="10" data-loss /> <b data-lossval></b></label>
      <label>Crashed nodes <input type="range" min="0" max="40" step="5" value="0" data-crash /> <b data-crashval></b></label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-next>Next round</button>
      <button class="btn" type="button" data-all>Run to the end</button>
      <button class="btn" type="button" data-reset>Start over</button>
    </div>
    <div class="gs-grid" role="img" aria-label="Nodes" data-grid></div>
    <p class="pg-out" data-msg aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  function prng(seed: number) { let s = seed >>> 0; return () => { s = (s + 0x6d2b79f5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
  document.querySelectorAll<HTMLElement>('[data-gs]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    let informed: boolean[] = []; let dead: boolean[] = []; let round = 0; let rnd = prng(7); let history: number[] = [];
    const cells = Array.from({ length: 100 }, () => { const i = document.createElement('i'); q('[data-grid]').appendChild(i); return i; });
    function reset() {
      const n = val('[data-n]'); rnd = prng(7); round = 0;
      dead = Array(n).fill(false); const crash = Math.round((n * val('[data-crash]')) / 100); let c = 0; for (let i = n - 1; i > 0 && c < crash; i--, c++) dead[i] = true;
      informed = Array(n).fill(false); informed[0] = true; history = [1]; draw();
    }
    function step() {
      const n = informed.length; const fan = val('[data-fan]'); const loss = val('[data-loss]') / 100; const before = [...informed];
      before.forEach((on, i) => { if (!on || dead[i]) return; for (let k = 0; k < fan; k++) { let t = Math.floor(rnd() * (n - 1)); if (t >= i) t++; if (rnd() >= loss && !dead[t]) informed[t] = true; } });
      round++; history.push(informed.filter(Boolean).length); draw();
    }
    const alive = () => dead.filter((d) => !d).length;
    function draw() {
      const n = informed.length;
      q('[data-nval]').textContent = String(val('[data-n]')); q('[data-fanval]').textContent = String(val('[data-fan]')); q('[data-lossval]').textContent = `${val('[data-loss]')}%`; q('[data-crashval]').textContent = `${val('[data-crash]')}%`;
      cells.forEach((c, i) => { c.hidden = i >= n; c.className = dead[i] ? 'dead' : informed[i] ? 'on' : ''; });
      const count = informed.filter(Boolean).length; const done = count >= alive();
      q('[data-grid]').setAttribute('aria-label', `${count} of ${alive()} live nodes informed after ${round} rounds`);
      q('[data-msg]').textContent = `Round ${round}: ${count} of ${alive()} live nodes know${done ? ` — everyone reached after ${round} rounds (about log2 of ${alive()} = ${Math.log2(alive()).toFixed(1)})` : ''}. ${history.length > 1 ? `Per round: ${history.join(' → ')}` : ''}`;
    }
    q('[data-next]').addEventListener('click', () => { if (informed.filter(Boolean).length < alive()) step(); });
    q('[data-all]').addEventListener('click', () => { let guard = 0; while (informed.filter(Boolean).length < alive() && guard++ < 60) step(); });
    q('[data-reset]').addEventListener('click', reset);
    root.addEventListener('input', reset); reset();
  });
</script>
<style is:global>
  .playground .gs-grid { display: grid; grid-template-columns: repeat(10, 1fr); gap: 3px; max-width: 420px; }
  .playground .gs-grid i { aspect-ratio: 1; border-radius: 4px; border: 2px solid var(--border); background: var(--surface); }
  .playground .gs-grid i[hidden] { display: none; }
  .playground .gs-grid i.on { background: var(--role-2); border-color: var(--role-2); }
  .playground .gs-grid i.dead { border-style: dashed; background: var(--surface-2); }
</style>
