---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Press the same three buttons in different states and see different results.">
  <ol class="how">
    <li>Press <b>Publish</b> repeatedly and watch the state change.</li>
    <li>Try <b>Edit</b> and <b>Reject</b> in every state. The same button, different behaviour.</li>
    <li>Press <b>+ Add Archived state</b>: a new class, existing states unchanged except for one transition.</li>
  </ol>
  <div class="pg" data-statepg>
    <div class="st-flow" data-nodes></div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-act="edit">Edit</button>
      <button class="btn pg-primary" type="button" data-act="publish">Publish</button>
      <button class="btn pg-primary" type="button" data-act="reject">Reject</button>
      <button class="btn" type="button" data-add>+ Add Archived state</button>
    </div>
    <output class="pg-out" data-out aria-live="polite">Document is in Draft.</output>
    <ol class="pg-log" data-log></ol>
  </div>
</PlaygroundShell>
<script>
  type Act = 'edit' | 'publish' | 'reject';
  interface S { name: string; handle(act: Act, d: Doc): { msg: string; ok: boolean } }
  class Doc { state: S; constructor(s: S) { this.state = s; } do(a: Act) { return this.state.handle(a, this); } }
  const draft: S = { name: 'Draft', handle: (a, d) => a === 'edit' ? { msg: 'Editing the draft', ok: true } : a === 'publish' ? (d.state = review, { msg: 'Sent to review', ok: true }) : { msg: 'A draft has nothing to reject', ok: false } };
  const review: S = { name: 'Review', handle: (a, d) => a === 'edit' ? { msg: 'Cannot edit while in review', ok: false } : a === 'publish' ? (d.state = published, { msg: 'Approved and published', ok: true }) : (d.state = draft, { msg: 'Sent back to draft', ok: true }) };
  const published: S = { name: 'Published', handle: (a, d) => a === 'edit' ? { msg: 'Cannot edit a published document', ok: false } : a === 'publish' ? { msg: 'Already published', ok: false } : (d.state = draft, { msg: 'Unpublished: back to draft', ok: true }) };
  const archived: S = { name: 'Archived', handle: (a, d) => a === 'reject' ? (d.state = draft, { msg: 'Restored to draft', ok: true }) : { msg: 'Archived documents are read-only', ok: false } };
  document.querySelectorAll<HTMLElement>('[data-statepg]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const doc = new Doc(draft); const states = [draft, review, published];
    function nodes() { const n = q('[data-nodes]'); n.innerHTML = ''; states.forEach((s, i) => { const d = document.createElement('div'); d.className = 'pg-box' + (doc.state === s ? ' lit' : ' off'); d.style.setProperty('--c', 'var(--role-3)'); d.innerHTML = `<h3>${s.name}</h3>`; n.appendChild(d); if (i < states.length - 1) { const a = document.createElement('span'); a.className = 'st-arrow'; a.textContent = '→'; n.appendChild(a); } }); }
    root.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) => b.addEventListener('click', () => {
      const from = doc.state.name; const r = doc.do(b.dataset.act as Act); const o = q('[data-out]'); o.textContent = `${from}.${b.dataset.act}(): ${r.msg}`; o.classList.toggle('bad', !r.ok);
      const li = document.createElement('li'); li.textContent = `${from} → ${doc.state.name}: ${r.msg}`; q('[data-log]').prepend(li); nodes();
    }));
    q('[data-add]').addEventListener('click', (e) => { states.push(archived); published.handle = (a, d) => a === 'edit' ? { msg: 'Cannot edit a published document', ok: false } : a === 'publish' ? (d.state = archived, { msg: 'Archived', ok: true }) : (d.state = draft, { msg: 'Unpublished: back to draft', ok: true }); (e.currentTarget as HTMLButtonElement).disabled = true; q('[data-out]').textContent = 'Archived added. Only Published changed: publish() now archives.'; nodes(); });
    nodes();
  });
</script>
<style is:global>
  .playground .st-flow { display: flex; flex-wrap: wrap; gap: 8px; align-items: stretch; }
  .playground .st-flow .pg-box { flex: 1 1 110px; text-align: center; }
  .playground .st-arrow { align-self: center; color: var(--muted); }
</style>
