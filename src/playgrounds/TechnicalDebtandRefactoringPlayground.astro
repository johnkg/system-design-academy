---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A team with 40 points of work per sprint in code that carries 30 points of debt. In hot code a feature costs 10 points plus 1 for every 10 points of debt, and every rushed feature adds 2 more. Choose how the team deals with the debt, how long it runs, and where the debt sits.">
  <ol class="how">
    <li>Start with <b>Strategy</b> at <b>Ignore the debt</b>, <b>Sprints</b> at <b>24</b>, <b>Tests around the messy code</b> ticked and <b>Where the debt is</b> at <b>Hot code</b>: the team delivers <b>45</b> features, the debt has grown to <b>120</b> and one feature now costs <b>22</b> points.</li>
    <li>Set <b>Strategy</b> to <b>Small steps every sprint</b>: <b>64</b> features, debt down to <b>14</b>, a feature costs <b>11</b>, and it stays ahead of ignoring from <b>sprint 11</b>. Untick <b>Tests around the messy code</b>: regressions eat the gain, so it is <b>57</b> features, 8 regressions, and it pulls ahead only from <b>sprint 14</b>.</li>
    <li>Set <b>Strategy</b> to <b>Rewrite, 6 sprints</b> (with the tests box ticked again): <b>42</b> features and ahead only from <b>sprint 28</b>. Set <b>Sprints</b> to <b>6</b> and it has delivered 0 features.</li>
    <li>Set <b>Sprints</b> to <b>24</b>, <b>Where the debt is</b> to <b>Cold code</b> and <b>Strategy</b> back to <b>Ignore the debt</b>: a feature always costs 10 points and the team delivers <b>96</b> features. Every repayment plan delivers less: read the table for <b>72</b> from small steps and from the 6-sprint rewrite.</li>
  </ol>
  <div class="pg td" data-td>
    <div class="pg-row">
      <label>Strategy <select class="pg-in" data-strategy>
        <option value="0" selected>Ignore the debt</option>
        <option value="1">Small steps every sprint</option>
        <option value="2">Rewrite, 3 sprints</option>
        <option value="3">Rewrite, 6 sprints</option>
        <option value="4">Rewrite, 12 sprints</option>
      </select></label>
      <label>Sprints <select class="pg-in" data-sprints>
        <option value="6">6</option>
        <option value="12">12</option>
        <option value="24" selected>24</option>
      </select></label>
      <label><input type="checkbox" data-tests checked /> Tests around the messy code</label>
      <label>Where the debt is <select class="pg-in" data-hot>
        <option value="1" selected>Hot code</option>
        <option value="0">Cold code</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Features delivered</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Points for one feature at the end</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Debt at the end</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Regressions from refactoring</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Stays ahead of ignoring from</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="Features delivered by every strategy, for the chosen settings"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  // The same model as the code samples.
  const CAP = 40, START_DEBT = 30, NEW_DEBT = 2, REFACTOR_COST = 8, REFACTOR_GAIN = 6, REGRESSION_COST = 12, REWRITE_DEBT = 5, BASE_COST = 10;
  interface Strategy { name: string; kind: 'ignore' | 'small' | 'rewrite'; rewrite: number }
  const STRATEGIES: Strategy[] = [
    { name: 'Ignore the debt', kind: 'ignore', rewrite: 0 },
    { name: 'Small steps every sprint', kind: 'small', rewrite: 0 },
    { name: 'Rewrite, 3 sprints', kind: 'rewrite', rewrite: 3 },
    { name: 'Rewrite, 6 sprints', kind: 'rewrite', rewrite: 6 },
    { name: 'Rewrite, 12 sprints', kind: 'rewrite', rewrite: 12 },
  ];

  function simulate(st: Strategy, sprints: number, tests: boolean, hot: boolean) {
    let debt = START_DEBT, features = 0, regressions = 0;
    const cost = () => BASE_COST + (hot ? Math.floor(debt / 10) : 0);
    const cumulative: number[] = [];
    for (let s = 1; s <= sprints; s++) {
      let cap = CAP;
      if (st.kind === 'rewrite' && s <= st.rewrite) { cap = 0; if (s === st.rewrite) debt = REWRITE_DEBT; }
      if (st.kind === 'small') {
        cap -= REFACTOR_COST; debt = Math.max(0, debt - REFACTOR_GAIN);
        if (!tests && s % 3 === 0) { cap -= REGRESSION_COST; regressions++; }
      }
      while (cap >= cost()) { cap -= cost(); features++; debt += NEW_DEBT; }
      cumulative.push(features);
    }
    return { features, debt, cost: cost(), regressions, cumulative };
  }

  function overtakes(st: Strategy, tests: boolean, hot: boolean): number {
    const a = simulate(st, 60, tests, hot).cumulative, base = simulate(STRATEGIES[0], 60, tests, hot).cumulative;
    let from = -1;
    for (let i = 59; i >= 0; i--) { if (a[i] > base[i]) from = i + 1; else break; }
    return from;
  }

  document.querySelectorAll<HTMLElement>('[data-td]').forEach((root) => {
    const q = query(root);
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const k = Number(q<HTMLSelectElement>('[data-strategy]').value);
      const sprints = Number(q<HTMLSelectElement>('[data-sprints]').value);
      const tests = q<HTMLInputElement>('[data-tests]').checked;
      const hot = q<HTMLSelectElement>('[data-hot]').value === '1';
      const st = STRATEGIES[k];
      const r = simulate(st, sprints, tests, hot);
      const best = Math.max(...STRATEGIES.map((s) => simulate(s, sprints, tests, hot).features));
      set(1, String(r.features), r.features === best ? 'the most of any strategy at these settings' : `the best strategy here delivers ${best}`);
      box(1, r.features === best);
      set(2, `${r.cost} points`, hot ? `${BASE_COST} when the code is clean: the difference is the interest` : 'cold code is never changed by features, so debt adds no cost');
      box(2, r.cost <= 12);
      set(3, String(r.debt), hot ? 'points of debt left in the code the team keeps changing' : 'points of debt, in code nobody touches');
      box(3, hot ? r.debt <= 30 : true);
      set(4, String(r.regressions), r.regressions ? `each one cost ${REGRESSION_COST} points to find and fix, because nothing showed the behaviour had changed` : st.kind === 'small' ? 'tests showed that every step kept behaviour' : 'no refactoring steps were taken');
      box(4, r.regressions === 0);
      if (k === 0) { set(5, 'n/a', 'this is the baseline the others are compared with'); box(5, true); }
      else {
        const o = overtakes(st, tests, hot);
        set(5, o < 0 ? 'never' : `sprint ${o}`, o < 0 ? 'ignoring the debt delivers more, at every horizon' : 'before that the repayment costs more than it has saved');
        box(5, o >= 0 && o <= 12);
      }
      const log = q('[data-log]'); log.textContent = '';
      for (const s of STRATEGIES) {
        const cells = [6, 12, 24].map((n) => simulate(s, n, tests, hot).features);
        const li = document.createElement('li');
        li.textContent = `${s.name}: features after 6, 12, 24 sprints: ${cells.join(', ')}`;
        log.appendChild(li);
      }
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
