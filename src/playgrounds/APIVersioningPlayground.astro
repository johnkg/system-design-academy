---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it" hint="Replace the 'name' field with firstName and lastName. Pick a strategy, deploy, then migrate clients and retire the old shape, and see who breaks.">
  <ol class="how">
    <li>With <b>Change in place</b>, press <b>Deploy the change</b>: the old mobile app and the partner break immediately.</li>
    <li>Reset and pick <b>Additive change</b>: everything keeps working. Press <b>Retire the old field</b> before clients migrate and the old ones break, so migrate them first.</li>
    <li>Try <b>New URL version</b>: both versions run side by side, and <b>things to maintain</b> goes up until you retire v1.</li>
  </ol>
  <div class="pg ver" data-ver>
    <div class="pg-row">
      <label>Strategy <select class="pg-in" data-strategy>
        <option value="inplace" selected>Change in place</option>
        <option value="additive">Additive change (keep 'name')</option>
        <option value="url">New URL version (/v2)</option>
      </select></label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-deploy>Deploy the change</button>
      <button class="btn" type="button" data-retire>Retire the old field or version</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="pg-grid" data-clients></div>
    <p class="pg-mono" data-stats></p>
    <p class="pg-out" data-msg aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  const clients = [
    { id: 'web', name: 'Web app (you deploy it)' },
    { id: 'mobile', name: 'Old mobile app (cannot be forced to update)' },
    { id: 'partner', name: 'Partner integration' },
  ];
  document.querySelectorAll<HTMLElement>('[data-ver]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const strategy = () => q<HTMLSelectElement>('[data-strategy]').value;
    let deployed = false; let retired = false; let migrated: Record<string, boolean> = {};
    const cards = clients.map((c) => {
      const box = document.createElement('div'); box.className = 'pg-box';
      box.innerHTML = '<h3></h3><span class="pg-mono"></span><button class="btn" type="button"></button>';
      box.querySelector('h3')!.textContent = c.name; q('[data-clients]').appendChild(box);
      const btn = box.querySelector<HTMLButtonElement>('button')!; btn.textContent = 'Update this client to the new fields';
      btn.addEventListener('click', () => { migrated[c.id] = true; draw(`${c.name} now reads the new fields.`); });
      return { box, status: box.querySelector<HTMLElement>('span')!, btn, id: c.id };
    });
    function ok(id: string) {
      if (migrated[id]) return deployed; // new fields exist only once deployed
      if (strategy() === 'inplace') return !deployed;
      return !retired; // old field or v1 stays until retired
    }
    function draw(msg = '') {
      const s = strategy();
      cards.forEach((c) => {
        const good = ok(c.id);
        c.box.style.setProperty('--c', good ? 'var(--role-2)' : 'var(--bad)');
        c.status.textContent = `${migrated[c.id] ? 'uses new fields' : 'uses old "name"'}: ${good ? 'working' : 'BROKEN'}`;
        c.btn.setAttribute('aria-disabled', String(!!migrated[c.id]));
      });
      const versions = s === 'inplace' ? 1 : deployed && !retired ? 2 : 1;
      q('[data-stats]').textContent = `contract versions you must maintain: ${versions}${s === 'additive' && deployed && !retired ? ' (old field deprecated but still served)' : ''}`;
      q('[data-retire]').setAttribute('aria-disabled', String(s === 'inplace' || !deployed || retired));
      q('[data-deploy]').setAttribute('aria-disabled', String(deployed));
      const broken = cards.filter((c) => !ok(c.id)).length;
      const out = q('[data-msg]'); out.classList.toggle('bad', broken > 0);
      const status = broken ? `${broken} client${broken > 1 ? 's' : ''} broken.` : 'Everything works.';
      out.textContent = msg ? `${msg} ${status}` : status;
    }
    function reset() { deployed = retired = false; migrated = {}; draw(); }
    q('[data-deploy]').addEventListener('click', () => { if (!deployed) { deployed = true; draw(strategy() === 'inplace' ? 'Deployed. The old shape is gone.' : strategy() === 'additive' ? 'Deployed. New fields added, old field kept.' : 'Deployed. /v2 is live and /v1 still runs.'); } });
    q('[data-retire]').addEventListener('click', () => { if (strategy() !== 'inplace' && deployed && !retired) { retired = true; draw(strategy() === 'additive' ? 'Old field removed.' : '/v1 retired.'); } });
    q('[data-reset]').addEventListener('click', reset);
    q('[data-strategy]').addEventListener('change', reset);
    reset();
  });
</script>
