---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="A tiny editor where every action is a command object.">
  <ol class="how">
    <li><b>Insert</b> some words and press <b>UPPERCASE</b>.</li>
    <li>Press <b>Undo</b> and <b>Redo</b>. Watch the history stacks.</li>
    <li>Undo twice, then run a new command: the <b>redo stack clears</b>.</li>
  </ol>
  <div class="pg" data-command>
    <div class="pg-row">
      <input class="pg-in" data-text value="Hello" aria-label="Text to insert" />
      <button class="btn pg-primary" type="button" data-insert>Insert</button>
      <button class="btn pg-primary" type="button" data-upper>UPPERCASE</button>
      <button class="btn" type="button" data-undo>Undo</button>
      <button class="btn" type="button" data-redo>Redo</button>
    </div>
    <output class="pg-out cm-doc" data-doc></output>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-1)"><h3>done (undo stack)</h3><ol class="pg-log" data-done tabindex="0" aria-label="Done (undo stack)"></ol></div>
      <div class="pg-box" style="--c: var(--role-4)"><h3>undone (redo stack)</h3><ol class="pg-log" data-undone tabindex="0" aria-label="Undone (redo stack)"></ol></div>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  interface Command { label: string; execute(): void; undo(): void }
  class Doc { text = ''; }
  class Insert implements Command {
    constructor(private d: Doc, private t: string) {} get label() { return `Insert "${this.t}"`; }
    execute() { this.d.text += this.t; } undo() { this.d.text = this.d.text.slice(0, this.d.text.length - this.t.length); }
  }
  class Upper implements Command {
    private before = ''; constructor(private d: Doc) {} get label() { return 'Uppercase'; }
    execute() { this.before = this.d.text; this.d.text = this.d.text.toUpperCase(); } undo() { this.d.text = this.before; }
  }
  class History {
    done: Command[] = []; undone: Command[] = [];
    run(c: Command) { c.execute(); this.done.push(c); this.undone = []; }
    undo() { const c = this.done.pop(); if (c) { c.undo(); this.undone.push(c); } }
    redo() { const c = this.undone.pop(); if (c) { c.execute(); this.done.push(c); } }
  }
  document.querySelectorAll<HTMLElement>('[data-command]').forEach((root) => {
    const q = query(root);
    const doc = new Doc(), h = new History();
    const list = (el: HTMLElement, items: Command[]) => { el.innerHTML = items.length ? items.map((c) => `<li>${c.label}</li>`).reverse().join('') : '<li class="pg-note">empty</li>'; };
    function draw() { q('[data-doc]').textContent = doc.text || '(empty document)'; list(q('[data-done]'), h.done); list(q('[data-undone]'), h.undone); q<HTMLButtonElement>('[data-undo]').disabled = !h.done.length; q<HTMLButtonElement>('[data-redo]').disabled = !h.undone.length; }
    q('[data-insert]').addEventListener('click', () => { const t = q<HTMLInputElement>('[data-text]').value; if (t) { h.run(new Insert(doc, t)); draw(); } });
    q('[data-upper]').addEventListener('click', () => { h.run(new Upper(doc)); draw(); });
    q('[data-undo]').addEventListener('click', () => { h.undo(); draw(); });
    q('[data-redo]').addEventListener('click', () => { h.redo(); draw(); });
    draw();
  });
</script>
<style is:global>
  .playground .cm-doc { font-size: 1.1rem; min-height: 2.4em; }
</style>
