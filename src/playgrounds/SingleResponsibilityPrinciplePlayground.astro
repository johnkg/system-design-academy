---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A payroll report that calculates pay, formats it and saves it, built three ways. Pick a design and a change request to see which classes have to be edited, what has to be tested again, and whose code is sitting next to the change.">
  <ol class="how">
    <li>Start with <b>One class does everything</b> and the request <b>Tax rule changes</b>: <b>1</b> class is edited, but it holds <b>5</b> other behaviours, among them the output format and the storage code that belong to <b>2</b> other teams, and all <b>6</b> behaviours have to be checked again.</li>
    <li>Set <b>Design</b> to <b>Split by reason to change</b>: still <b>1</b> class is edited, but it now holds only the other <b>2</b> finance rules, and no other team's code is in it (<b>0</b> teams at risk). Try <b>New storage</b> to see the same for the storage team: <b>0</b> bystander behaviours.</li>
    <li>Set <b>Design</b> to <b>Over-split: a class per step</b>: one reason to change is now spread over several classes, so <b>Tax rule changes</b> edits <b>3</b> classes. Following one report run means reading <b>16</b> classes, and the five requests together edit <b>17</b> classes, against <b>6</b> for the split by reason to change.</li>
  </ol>
  <div class="pg srp" data-srp>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design>
        <option value="0" selected>One class does everything</option>
        <option value="1">Split by reason to change</option>
        <option value="2">Over-split: a class per step</option>
      </select></label>
      <label>Change request <select class="pg-in" data-req>
        <option value="0" selected>Tax rule changes</option>
        <option value="1">New output format</option>
        <option value="2">New storage</option>
        <option value="3">Overtime rule changes</option>
        <option value="4">Add a bonus column</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Classes edited</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Classes to test again</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Behaviours to re-verify</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Bystander behaviours in the edited code</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Other teams' code in the edited classes</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Classes to read to follow one run</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The same five requests, three designs</h3>
      <div class="srp-scroll" tabindex="0" role="region" aria-label="Totals for the three designs"><table class="srp-table" data-table>
        <thead><tr><th scope="col">Design</th><th scope="col">Classes</th><th scope="col">Classes edited</th><th scope="col">Retests</th><th scope="col">Bystander behaviours</th><th scope="col">Other-team exposures</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <span class="pg-note">Totals over the five requests. Bystander behaviours are other reasons to change that live inside a class you had to edit.</span>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="Classes edited per request, for the chosen design"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type Cls = [string, string[], string[]]; // name, what it does (each item is a reason to change), who it calls
  const ACTOR: Record<string, string> = { overtime: 'finance', tax: 'finance', bonus: 'finance', format: 'operations', storage: 'IT', flow: '' };
  const DESIGNS: { name: string; classes: Cls[] }[] = [
    { name: 'One class does everything', classes: [
      ['Cli', [], ['PayrollReport']],
      ['PayrollReport', ['overtime', 'tax', 'bonus', 'format', 'storage', 'flow'], []],
    ] },
    { name: 'Split by reason to change', classes: [
      ['Cli', [], ['PayrollReport']],
      ['PayrollReport', ['flow'], ['PayCalculator', 'ReportFormatter', 'ReportStore']],
      ['PayCalculator', ['overtime', 'tax', 'bonus'], []],
      ['ReportFormatter', ['format'], []],
      ['ReportStore', ['storage'], []],
    ] },
    { name: 'Over-split: a class per step', classes: [
      ['Cli', [], ['ReportRunner']],
      ['ReportRunner', ['flow'], ['OvertimeCalculator', 'TaxCalculator', 'BonusCalculator', 'HeaderFormatter', 'RowFormatter', 'FileWriter']],
      ['OvertimeCalculator', ['overtime'], ['OvertimeRule', 'OvertimeRateTable']],
      ['OvertimeRule', ['overtime'], []],
      ['OvertimeRateTable', ['overtime'], []],
      ['TaxCalculator', ['tax'], ['TaxRule', 'TaxBracketTable']],
      ['TaxRule', ['tax'], []],
      ['TaxBracketTable', ['tax'], []],
      ['BonusCalculator', ['bonus'], ['BonusRule']],
      ['BonusRule', ['bonus'], []],
      ['HeaderFormatter', ['format'], ['ColumnLayout']],
      ['RowFormatter', ['format'], ['ColumnLayout']],
      ['ColumnLayout', ['format'], []],
      ['FileWriter', ['storage'], ['FilePathResolver', 'Serializer']],
      ['FilePathResolver', ['storage'], []],
      ['Serializer', ['storage'], []],
    ] },
  ];
  const REQUESTS = [
    { text: 'Tax rule changes', touches: ['tax'] },
    { text: 'New output format', touches: ['format'] },
    { text: 'New storage', touches: ['storage'] },
    { text: 'Overtime rule changes', touches: ['overtime'] },
    { text: 'Add a bonus column', touches: ['bonus', 'format'] },
  ];

  // The same model as the code samples.
  function depth(classes: Cls[], name: string): number {
    const c = classes.find((x) => x[0] === name)!;
    let best = 0;
    for (const u of c[2]) best = Math.max(best, depth(classes, u));
    return best + 1;
  }
  function analyse(classes: Cls[], touches: string[]) {
    const touched = classes.filter((c) => c[1].some((r) => touches.includes(r)));
    const retest = new Set(touched.map((c) => c[0]));
    let grew = true;
    while (grew) { // anything that calls a retested class must be retested too
      grew = false;
      for (const c of classes) if (!retest.has(c[0]) && c[2].some((u) => retest.has(u))) { retest.add(c[0]); grew = true; }
    }
    let reverified = 0, bystanders = 0;
    const teams = new Set<string>();
    for (const c of classes) if (retest.has(c[0])) reverified += c[1].length;
    for (const c of touched) for (const r of c[1]) if (!touches.includes(r)) {
      bystanders++;
      if (ACTOR[r] && !touches.some((t) => ACTOR[t] === ACTOR[r])) teams.add(ACTOR[r]);
    }
    return { touched: touched.map((c) => c[0]), retest: retest.size, reverified, bystanders, teams: teams.size };
  }

  document.querySelectorAll<HTMLElement>('[data-srp]').forEach((root) => {
    const q = query(root);
    const tbody = q('[data-table] tbody');
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const di = Number(q<HTMLSelectElement>('[data-design]').value);
      const ri = Number(q<HTMLSelectElement>('[data-req]').value);
      const d = DESIGNS[di];
      const a = analyse(d.classes, REQUESTS[ri].touches);
      set(1, String(a.touched.length), a.touched.join(', '));
      box(1, a.touched.length <= 1);
      set(2, String(a.retest), 'the edited classes plus everything that calls them');
      box(2, a.retest <= 3);
      set(3, String(a.reverified), 'behaviours living in the classes to test again');
      box(3, a.reverified <= 4);
      set(4, String(a.bystanders), a.bystanders === 0 ? 'nothing unrelated shares code with the change' : 'other reasons to change that share code with this one, so this edit can break them');
      box(4, a.bystanders === 0);
      set(5, String(a.teams), a.teams === 0 ? 'only the team that asked is affected by the edit' : 'finance, operations or IT code sitting in a class this request edits');
      box(5, a.teams === 0);
      const places = d.classes.length;
      set(6, String(places), `longest call chain ${depth(d.classes, 'Cli')} deep, counting the command-line entry point`);
      box(6, places <= 6);
      tbody.textContent = '';
      DESIGNS.forEach((x, i) => {
        let t = 0, r = 0, b = 0, o = 0;
        for (const req of REQUESTS) { const s = analyse(x.classes, req.touches); t += s.touched.length; r += s.retest; b += s.bystanders; o += s.teams; }
        const tr = document.createElement('tr');
        if (i === di) tr.className = 'sel';
        [x.name, String(x.classes.length), String(t), String(r), String(b), String(o)].forEach((text, k) => {
          const cell = document.createElement(k === 0 ? 'th' : 'td'); if (k === 0) cell.setAttribute('scope', 'row'); cell.textContent = text; tr.appendChild(cell);
        });
        tbody.appendChild(tr);
      });
      const log = q('[data-log]'); log.textContent = '';
      REQUESTS.forEach((req) => {
        const s = analyse(d.classes, req.touches);
        const li = document.createElement('li'); li.textContent = `${req.text}: edit ${s.touched.join(', ')}`; log.appendChild(li);
      });
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .srp-scroll { overflow-x: auto; }
  .playground .srp-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .srp-table th, .playground .srp-table td { padding: 5px 8px; border-bottom: 1px solid var(--border); text-align: left; }
  .playground .srp-table tr.sel { background: var(--accent-soft); font-weight: 600; }
</style>
