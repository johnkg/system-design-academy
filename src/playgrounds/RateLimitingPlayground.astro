---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A client sends requests to an API behind a token bucket. Change the bucket and the client's speed and watch what gets through.">
  <ol class="how">
    <li>With the bucket refilling <b>3 tokens/s</b> and the client sending <b>6 requests/s</b>, half are rejected once the starting tokens run out. The allowed rate settles at the refill rate.</li>
    <li>Press <b>Burst of 15</b> with a full bucket: only as many requests as there are tokens get through at once. A larger <b>capacity</b> tolerates bigger bursts.</li>
    <li>Set the client to <b>2 requests/s</b>, below the refill rate: nothing is rejected and the bucket stays full.</li>
  </ol>
  <div class="pg rl" data-rl>
    <div class="pg-row">
      <label>Bucket capacity <input type="range" min="1" max="20" value="10" data-cap /> <b data-capval>10</b></label>
      <label>Refill per second <input type="range" min="1" max="10" value="3" data-refill /> <b data-refillval>3</b></label>
      <label>Client requests per second <input type="range" min="0" max="20" value="6" data-rate /> <b data-rateval>6</b></label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-burst>Burst of 15 requests</button>
      <button class="btn" type="button" data-play>Pause</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="rl-bar" role="img" aria-label="Bucket is full" data-bar><div class="rl-fill" data-fill></div></div>
    <p class="pg-mono" data-stats></p>
    <p class="sr" aria-live="polite" data-status></p>
    <ol class="pg-log" data-log tabindex="0" aria-label="Most recent requests"></ol>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-rl]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    let tokens = 10; let last = performance.now(); let allowed = 0; let rejected = 0; let id = 0;
    let tickTimer: number | undefined; let sendTimer: number | undefined; let onScreen = true;
    let running = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const LOG = 8; const rows: HTMLElement[] = [];
    for (let i = 0; i < LOG; i++) { const li = document.createElement('li'); li.hidden = true; q('[data-log]').appendChild(li); rows.push(li); }
    const history: { text: string; ok: boolean }[] = [];

    function refill() {
      const now = performance.now();
      tokens = Math.min(val('[data-cap]'), tokens + ((now - last) / 1000) * val('[data-refill]'));
      last = now;
    }
    function request() {
      refill(); id++;
      const ok = tokens >= 1;
      if (ok) { tokens -= 1; allowed++; } else { rejected++; }
      const wait = ok ? 0 : Math.ceil(((1 - tokens) / val('[data-refill]')) * 10) / 10;
      history.unshift({ ok, text: ok ? `#${id} allowed` : `#${id} 429 Too Many Requests, Retry-After ${wait} s` });
      if (history.length > LOG) history.pop();
    }
    function draw() {
      refill();
      const cap = val('[data-cap]');
      q('[data-capval]').textContent = String(cap); q('[data-refillval]').textContent = String(val('[data-refill]')); q('[data-rateval]').textContent = String(val('[data-rate]'));
      tokens = Math.min(tokens, cap);
      q('[data-fill]').style.width = `${(tokens / cap) * 100}%`;
      q('[data-bar]').setAttribute('aria-label', `Bucket holds ${Math.floor(tokens)} of ${cap} tokens`);
      const total = allowed + rejected;
      q('[data-stats]').textContent = `tokens: ${tokens.toFixed(1)} / ${cap} · allowed: ${allowed} · rejected (429): ${rejected}${total ? ` (${Math.round((rejected / total) * 100)}%)` : ''}`;
      rows.forEach((li, i) => { const h = history[i]; li.hidden = !h; if (h) { li.textContent = h.text; li.style.color = h.ok ? '' : 'var(--bad-text)'; } });
    }
    function reset() { tokens = val('[data-cap]'); last = performance.now(); allowed = rejected = id = 0; history.length = 0; draw(); }
    function clock() {
      window.clearInterval(tickTimer); window.clearInterval(sendTimer); tickTimer = sendTimer = undefined;
      if (!running || !onScreen || document.hidden) return;
      last = performance.now();
      tickTimer = window.setInterval(draw, 100);
      const rate = val('[data-rate]'); if (rate > 0) sendTimer = window.setInterval(() => { request(); draw(); }, 1000 / rate);
    }
    q('[data-burst]').addEventListener('click', () => {
      const a0 = allowed; const r0 = rejected; for (let i = 0; i < 15; i++) request(); draw();
      q('[data-status]').textContent = `Burst of 15: ${allowed - a0} allowed, ${rejected - r0} rejected with 429.`;
    });
    const playLabel = () => { q('[data-play]').textContent = running ? 'Pause' : 'Play'; };
    q('[data-play]').addEventListener('click', () => {
      running = !running; playLabel(); clock();
      q('[data-status]').textContent = running ? 'Running.' : `Paused. ${q('[data-stats]').textContent}`;
    });
    q('[data-reset]').addEventListener('click', reset);
    q('[data-rate]').addEventListener('input', () => { clock(); draw(); });
    q('[data-cap]').addEventListener('input', draw); q('[data-refill]').addEventListener('input', draw);
    new IntersectionObserver(([en]) => { onScreen = en.isIntersecting; clock(); }).observe(root);
    document.addEventListener('visibilitychange', clock);
    playLabel(); reset(); clock();
  });
</script>
<style is:global>
  .playground .rl-bar { height: 20px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .playground .rl-fill { height: 100%; width: 100%; border-radius: 99px; background: var(--accent); transition: width .1s linear; }
</style>
