---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Find the failures" hint="Task: find every ERROR for user 42 in these 15 log lines. Search the same logs as plain text, then as structured events.">
  <ol class="how">
    <li>In <b>Plain text</b> mode the search is <b>42</b>. It matches times, ports and other users' ids, and it also returns the harmless lines.</li>
    <li>Try <b>ERROR.*user 42</b>: this works here, but you must know how every service words its messages, and a line worded differently is silently missed.</li>
    <li>Switch to <b>Structured events</b> and set <b>level</b> to <b>error</b> and <b>user_id</b> to <b>42</b>: exactly the right lines, nothing missed.</li>
  </ol>
  <div class="pg sl" data-sl>
    <div class="pg-row">
      <label>Logs are written as <select class="pg-in" data-mode><option value="text" selected>Plain text</option><option value="json">Structured events</option></select></label>
    </div>
    <div class="pg-row" data-textctl>
      <label>Search pattern (regular expression) <input class="pg-in" data-pattern value="42" /></label>
    </div>
    <div class="pg-row" data-jsonctl hidden>
      <label>level <select class="pg-in" data-level><option value="">any</option><option value="error">error</option><option value="warn">warn</option><option value="info">info</option></select></label>
      <label>user_id <select class="pg-in" data-user><option value="">any</option><option value="42">42</option><option value="7">7</option><option value="142">142</option></select></label>
    </div>
    <ol class="sl-lines" data-lines tabindex="0" aria-label="Log lines, scrolls sideways"></ol>
    <p class="pg-out" data-verdict aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  interface Ev { ts: string; level: string; service: string; event: string; user_id?: number; extra?: string; text: string }
  const events: Ev[] = [
    { ts: '14:02:11', level: 'info', service: 'gateway', event: 'request_received', user_id: 42, text: 'Request received from user 42 for /pay' },
    { ts: '14:02:11', level: 'info', service: 'payments', event: 'charge_started', user_id: 42, text: 'Starting charge for user 42, order 9001' },
    { ts: '14:02:12', level: 'error', service: 'payments', event: 'payment_failed', user_id: 42, text: 'Payment failed for user 42: card declined' },
    { ts: '14:02:12', level: 'warn', service: 'gateway', event: 'retry_scheduled', user_id: 42, text: 'Retry scheduled for user 42, attempt 1' },
    { ts: '14:03:40', level: 'info', service: 'gateway', event: 'request_received', user_id: 7, text: 'Request received from user 7 for /pay' },
    { ts: '14:03:41', level: 'error', service: 'payments', event: 'payment_failed', user_id: 7, text: 'Payment failed for user 7: timeout' },
    { ts: '14:05:02', level: 'error', service: 'inventory', event: 'stock_error', user_id: 142, text: 'Stock lookup failed for user 142, sku 3' },
    { ts: '14:05:30', level: 'info', service: 'orders', event: 'order_created', user_id: 420, text: 'Order 42 created for user 420' },
    { ts: '14:12:42', level: 'info', service: 'scheduler', event: 'job_done', text: 'Nightly job done, 12 rows' },
    { ts: '14:15:00', level: 'info', service: 'gateway', event: 'listening', text: 'Listening on port 4242' },
    { ts: '14:20:09', level: 'error', service: 'payments', event: 'payment_failed', user_id: 42, text: 'Payment failed for user 42: insufficient funds' },
    { ts: '14:21:00', level: 'debug', service: 'orders', event: 'cache_hit', user_id: 42, text: 'cache hit for key order:42 (user 42)' },
    { ts: '14:30:00', level: 'error', service: 'gateway', event: 'upstream_timeout', user_id: 88, text: 'Upstream timeout for user 88' },
    { ts: '14:31:01', level: 'info', service: 'payments', event: 'charge_started', user_id: 42, text: 'Starting charge for user 42, order 9004' },
    { ts: '14:42:33', level: 'info', service: 'scheduler', event: 'job_started', text: 'Nightly job started' },
  ];
  const TARGET_USER = 42; // the question: which errors did user 42 hit?
  const wanted = (e: Ev) => e.level === 'error' && e.user_id === TARGET_USER;
  const asText = (e: Ev) => `${e.ts} ${e.level.toUpperCase().padEnd(5)} ${e.service} ${e.text}`;
  const asJson = (e: Ev) => JSON.stringify({ ts: e.ts, level: e.level, service: e.service, event: e.event, ...(e.user_id !== undefined ? { user_id: e.user_id } : {}) });
  document.querySelectorAll<HTMLElement>('[data-sl]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const lis = events.map(() => { const li = document.createElement('li'); q('[data-lines]').appendChild(li); return li; });
    function draw() {
      const json = q<HTMLSelectElement>('[data-mode]').value === 'json';
      q('[data-textctl]').hidden = json; q('[data-jsonctl]').hidden = !json;
      let re: RegExp | null = null; let bad = false;
      if (!json) { try { re = new RegExp(q<HTMLInputElement>('[data-pattern]').value, 'i'); } catch { bad = true; } }
      const level = q<HTMLSelectElement>('[data-level]').value; const user = q<HTMLSelectElement>('[data-user]').value;
      let matched = 0; let right = 0; let missed = 0;
      events.forEach((e, i) => {
        const line = json ? asJson(e) : asText(e);
        const hit = json ? (!level || e.level === level) && (!user || String(e.user_id) === user) && (!!level || !!user) : !!re && q<HTMLInputElement>('[data-pattern]').value !== '' && re.test(line);
        lis[i].textContent = `${hit ? '▶ ' : '  '}${line}`; lis[i].className = hit ? 'hit' : '';
        if (hit) { matched++; if (wanted(e)) right++; } else if (wanted(e)) missed++;
      });
      const out = q('[data-verdict]'); const perfect = right === 2 && matched === 2;
      out.classList.toggle('bad', !perfect);
      out.textContent = bad ? 'That is not a valid pattern.' : `Matched ${matched} lines: ${right} of the 2 you wanted, ${matched - right} you did not want, ${missed} missed.${perfect ? ' Exactly right.' : ''}`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .sl-lines { margin: 0; padding: 0; list-style: none; font: .8rem var(--font-mono); display: grid; gap: 2px; overflow-x: auto; }
  .playground .sl-lines li { white-space: pre; padding: 2px 6px; border-radius: 4px; }
  .playground .sl-lines li.hit { background: var(--accent-soft); font-weight: 700; }
</style>
