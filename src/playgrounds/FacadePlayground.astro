---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Start a movie the hard way, then the easy way.">
  <ol class="how">
    <li><b>Manual mode:</b> press the four steps yourself. Try playing before the projector is on.</li>
    <li><b>Facade mode:</b> press one button and watch the recipe run in the right order.</li>
  </ol>
  <div class="pg" data-facade>
    <div class="pg-row" role="group" aria-label="Mode">
      <button class="btn" type="button" data-mode="manual" aria-pressed="true">Manual (4 components)</button>
      <button class="btn" type="button" data-mode="facade" aria-pressed="false">Facade (1 call)</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="pg-row" data-controls></div>
    <div class="pg-grid" data-panels></div>
    <output class="pg-out" data-out aria-live="polite">Ready.</output>
  </div>
</PlaygroundShell>
<script>
  class Lights { level = 100; dim(l: number) { this.level = l; } on() { this.level = 100; } }
  class Projector { isOn = false; on() { this.isOn = true; } off() { this.isOn = false; } }
  class Amp { volume = 0; setVolume(v: number) { this.volume = v; } }
  class Player { playing = ''; play(m: string, projector: Projector) { if (!projector.isOn) throw new Error('Projector is off: sound but no picture!'); this.playing = m; } stop() { this.playing = ''; } }
  document.querySelectorAll<HTMLElement>('[data-facade]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let lights: Lights, projector: Projector, amp: Amp, player: Player;
    let facadeMode = false;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : ms));
    const log: string[] = [];
    const say = (t: string, bad = false) => { const o = q('[data-out]'); o.textContent = t; o.classList.toggle('bad', bad); };
    function fresh() { lights = new Lights(); projector = new Projector(); amp = new Amp(); player = new Player(); log.length = 0; say('Ready.'); draw(); }
    function panel(title: string, value: string, on: boolean, id: string) { return `<div class="pg-box ${on ? '' : 'off'}" data-p="${id}" style="--c: var(--role-3)"><h3>${title}</h3><span class="pg-mono">${value}</span></div>`; }
    function draw(lit = '') {
      q('[data-panels]').innerHTML = panel('Lights', lights.level === 100 ? 'on (100%)' : `dimmed ${lights.level}%`, lights.level < 100, 'l') + panel('Projector', projector.isOn ? 'on' : 'off', projector.isOn, 'p') + panel('Amplifier', `volume ${amp.volume}`, amp.volume > 0, 'a') + panel('Player', player.playing ? `playing ${player.playing}` : 'stopped', !!player.playing, 'y');
      if (lit) q(`[data-p=${lit}]`).classList.add('lit');
      const c = q('[data-controls]'); c.innerHTML = '';
      const DIM_LEVEL = 10, VOLUME = 5; // the settings a movie night uses
      const STEP_MS = 450; // pause between the facade's calls so each one is visible
      const add = (label: string, fn: () => void, primary = false) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn' + (primary ? ' pg-primary' : ''); b.textContent = label; b.addEventListener('click', () => { try { fn(); } catch (e) { say((e as Error).message, true); draw(); return; } }); c.appendChild(b); };
      if (facadeMode) {
        add('watchMovie("Dune")', async () => {
          const steps: [string, () => void, string][] = [[`lights.dim(${DIM_LEVEL})`, () => lights.dim(DIM_LEVEL), 'l'], ['projector.on()', () => projector.on(), 'p'], [`amp.setVolume(${VOLUME})`, () => amp.setVolume(VOLUME), 'a'], ['player.play("Dune")', () => player.play('Dune', projector), 'y']];
          for (const [t, f, id] of steps) { f(); say('facade → ' + t); draw(id); await wait(STEP_MS); }
          say('Movie started with one call. Order was right every time.'); draw();
        }, true);
        add('endMovie()', () => { player.stop(); projector.off(); lights.on(); say('Facade shut everything down in order.'); draw(); }, true);
      } else {
        add(`1. lights.dim(${DIM_LEVEL})`, () => { lights.dim(DIM_LEVEL); say('Lights dimmed.'); draw('l'); });
        add('2. projector.on()', () => { projector.on(); say('Projector on.'); draw('p'); });
        add(`3. amp.setVolume(${VOLUME})`, () => { amp.setVolume(VOLUME); say('Volume set.'); draw('a'); });
        add('4. player.play("Dune")', () => { player.play('Dune', projector); say('Playing.'); draw('y'); });
      }
    }
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => { facadeMode = b.dataset.mode === 'facade'; root.querySelectorAll('[data-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b))); fresh(); }));
    q('[data-reset]').addEventListener('click', fresh);
    fresh();
  });
</script>
