---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Build a tree. Every node answers getSize() the same way.">
  <ol class="how">
    <li><b>Click a folder</b> to select it.</li>
    <li>Add a <b>file</b> or a <b>folder</b> inside it, or <b>remove</b> the selected item.</li>
    <li>Watch every size recompute. The root's total comes from one <b>getSize()</b> call.</li>
  </ol>
  <div class="pg" data-composite>
    <div class="pg-row">
      <input class="pg-in" data-size type="number" min="1" value="10" aria-label="File size" style="width:90px" />
      <button class="btn" type="button" data-add-file>+ File</button>
      <button class="btn" type="button" data-add-folder>+ Folder</button>
      <button class="btn" type="button" data-remove>Remove selected</button>
    </div>
    <div class="co-tree" data-tree role="tree"></div>
    <output class="pg-out" data-out></output>
  </div>
</PlaygroundShell>
<script>
  interface Item { getSize(): number; name: string }
  class File implements Item { constructor(public name: string, public size: number) {} getSize() { return this.size; } }
  class Folder implements Item {
    children: Item[] = [];
    constructor(public name: string) {}
    getSize(): number { return this.children.reduce((s, c) => s + c.getSize(), 0); }
  }
  document.querySelectorAll<HTMLElement>('[data-composite]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const top = new Folder('project');
    const src = new Folder('src'); src.children.push(new File('app.js', 40));
    top.children.push(new File('readme.md', 10), src);
    const parent = new Map<Item, Folder>([[src, top]]);
    top.children.forEach((c) => parent.set(c, top)); src.children.forEach((c) => parent.set(c, src));
    let sel: Item = top; let n = 1;
    function node(item: Item, depth: number): HTMLElement {
      const wrap = document.createElement('div');
      const row = document.createElement('button'); row.type = 'button'; row.className = 'co-row' + (item === sel ? ' sel' : '');
      row.style.paddingLeft = `${8 + depth * 18}px`; row.setAttribute('role', 'treeitem');
      row.innerHTML = `<span>${item instanceof Folder ? '📁' : '📄'} ${item.name}</span><b>${item.getSize()}</b>`;
      row.addEventListener('click', () => { sel = item; draw(); });
      wrap.appendChild(row);
      if (item instanceof Folder) item.children.forEach((c) => wrap.appendChild(node(c, depth + 1)));
      return wrap;
    }
    function draw() {
      q('[data-tree]').replaceChildren(node(top, 0));
      q('[data-out]').textContent = `top.getSize() = ${top.getSize()}   (selected: ${sel.name}${sel instanceof Folder ? '/' : ''} = ${sel.getSize()})`;
    }
    const target = () => (sel instanceof Folder ? sel : parent.get(sel)!);
    q('[data-add-file]').addEventListener('click', () => { const f = new File(`file${n++}.txt`, Number(q<HTMLInputElement>('[data-size]').value) || 1); target().children.push(f); parent.set(f, target()); draw(); });
    q('[data-add-folder]').addEventListener('click', () => { const f = new Folder(`folder${n++}`); target().children.push(f); parent.set(f, target()); draw(); });
    q('[data-remove]').addEventListener('click', () => { if (sel === top) return; const p = parent.get(sel)!; p.children = p.children.filter((c) => c !== sel); sel = p; draw(); });
    draw();
  });
</script>
<style is:global>
  .playground .co-tree { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  .playground .co-row { display: flex; justify-content: space-between; width: 100%; font: inherit; padding: 6px 12px; background: var(--surface); color: var(--text); border: 0; border-bottom: 1px solid var(--border); cursor: pointer; text-align: left; }
  .playground .co-row:hover { background: var(--surface-2); }
  .playground .co-row.sel { background: var(--accent-soft); font-weight: 600; }
  .playground .co-row b { color: var(--accent); font-family: ui-monospace, monospace; }
</style>
