---
import PlaygroundShell from '../components/PlaygroundShell.astro';
const TEXTS = [10, 100, 1000, 10000, 100000];
const PATS = [5, 10, 20, 50];
const NS = [10, 15, 20, 25, 30, 40, 50];
---
<PlaygroundShell title="Simulate it" hint="Two experiments. First, search for a pattern of a's ending in b inside a text of a's, naive against KMP. Second, run three regexes on a string of a's with or without a b at the end, with a backtracking matcher and a set-based one. All numbers are steps, and time is an assumption of 1 ns per step.">
  <ol class="how">
    <li>Under <b>Substring search</b> set <b>Text length</b> to <b>1,000</b> and <b>Pattern length</b> to <b>10</b>: the naive search makes <b>9,910</b> comparisons and KMP makes <b>2,008</b>.</li>
    <li>Under <b>Regex matching</b> set <b>Pattern</b> to <b>^(a+)+$</b>, <b>Input</b> to <b>a's then a b (near miss)</b> and <b>Length n</b> to <b>20</b>: backtracking needs <b>2,097,151</b> steps and the set-based matcher <b>41</b>. Set <b>Length n</b> to <b>30</b>: <b>2,147,483,647</b> steps, <b>2.1</b> seconds.</li>
    <li>Set <b>Length n</b> to <b>50</b>: <b>2,251,799,813,685,247</b> steps, about <b>26.1</b> days, while the set-based matcher takes <b>101</b>. Set <b>Input</b> to <b>only a's (matches)</b>: the same pattern needs just <b>52</b> steps, which is why testing with matching inputs never shows the problem.</li>
    <li>Set <b>Input</b> back to the near miss and <b>Length n</b> to <b>20</b>. Set <b>Pattern</b> to <b>^a+$</b>: <b>21</b> steps. Set <b>Pattern</b> to <b>^(a|aa)+$</b>: <b>75,022</b> steps, less than the nested pattern but still growing by about 1.6 times per extra character.</li>
  </ol>
  <div class="pg sm" data-sm>
    <h3 class="sm-h">Substring search</h3>
    <div class="pg-row">
      <label>Text length <select class="pg-in" data-text>{TEXTS.map((n) => <option value={n} selected={n === 1000}>{n.toLocaleString('en-US')}</option>)}</select></label>
      <label>Pattern length <select class="pg-in" data-pat>{PATS.map((n) => <option value={n} selected={n === 10}>{n}</option>)}</select></label>
    </div>
    <p class="pg-note">The text is all a's. The pattern is a's followed by one b, so every attempt of the naive search gets to the last character before it fails.</p>
    <div class="sm-scroll" tabindex="0" role="region" aria-label="Substring search comparisons">
      <table class="sm-table">
        <thead><tr><th scope="col">Algorithm</th><th scope="col">Comparisons</th><th scope="col">Time at 1 ns per step</th><th scope="col">Comparisons, log scale</th></tr></thead>
        <tbody data-rows1></tbody>
      </table>
    </div>
    <p class="pg-out" data-verdict1 role="status"></p>
    <h3 class="sm-h">Regex matching</h3>
    <div class="pg-row">
      <label>Pattern <select class="pg-in" data-regex>
        <option value="nested" selected>^(a+)+$</option>
        <option value="ambig">^(a|aa)+$</option>
        <option value="simple">^a+$</option>
      </select></label>
      <label>Input <select class="pg-in" data-input>
        <option value="miss" selected>a's then a b (near miss)</option>
        <option value="hit">only a's (matches)</option>
      </select></label>
      <label>Length n <select class="pg-in" data-n>{NS.map((n) => <option value={n} selected={n === 20}>{n}</option>)}</select></label>
    </div>
    <div class="sm-scroll" tabindex="0" role="region" aria-label="Regex matching steps">
      <table class="sm-table">
        <thead><tr><th scope="col">Matcher</th><th scope="col">Steps</th><th scope="col">Time at 1 ns per step</th><th scope="col">How counted</th><th scope="col">Steps, log scale</th></tr></thead>
        <tbody data-rows2></tbody>
      </table>
    </div>
    <p class="pg-out" data-verdict2 role="status"></p>
    <p class="pg-note">Assumptions: one step is one attempt to match one character, and takes 1 ns, with no caches or allocation. Real engines differ in how they count and in speed, so read the table as the shape of the growth. For n up to 20, and for every input that matches, the backtracking matcher of the code sample is run here. Above 20 on a near miss, the steps come from the rule that the code sample checks against the matcher for n up to 20: 2^(n+1) - 1 for the nested pattern, and previous + the one before + 3 for the alternation. The bar is the number of digits of the step count (full bar: 16 digits or more).</p>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands, formatOneDecimalBelow100 } from '../playground';

  // The same model as the code samples.
  let steps = 0;
  function naiveSearch(text: string, pat: string): number {
    steps = 0;
    for (let s = 0; s <= text.length - pat.length; s++) {
      let j = 0;
      for (; j < pat.length; j++) { steps++; if (text[s + j] !== pat[j]) break; }
      if (j === pat.length) return s;
    }
    return -1;
  }
  function kmpSearch(text: string, pat: string): number {
    steps = 0;
    const fail = new Array<number>(pat.length).fill(0);
    let k = 0;
    for (let i = 1; i < pat.length; i++) {
      while (k > 0 && pat[i] !== pat[k]) { steps++; k = fail[k - 1]; }
      steps++;
      if (pat[i] === pat[k]) k++;
      fail[i] = k;
    }
    k = 0;
    for (let i = 0; i < text.length; i++) {
      while (k > 0 && text[i] !== pat[k]) { steps++; k = fail[k - 1]; }
      steps++;
      if (text[i] === pat[k]) k++;
      if (k === pat.length) return i - k + 1;
    }
    return -1;
  }

  type Node = ['lit', string] | ['seq', Node[]] | ['alt', Node[]] | ['plus', Node];
  function bt(node: Node, s: string, i: number, k: (j: number) => boolean): boolean {
    if (node[0] === 'lit') { steps++; return i < s.length && s[i] === node[1] && k(i + 1); }
    if (node[0] === 'seq') {
      const parts = node[1];
      const run = (idx: number, j: number): boolean => (idx === parts.length ? k(j) : bt(parts[idx], s, j, (j2) => run(idx + 1, j2)));
      return run(0, i);
    }
    if (node[0] === 'alt') {
      for (const option of node[1]) if (bt(option, s, i, k)) return true;
      return false;
    }
    return bt(node[1], s, i, (j) => bt(node, s, j, k) || k(j));
  }
  function matchBacktracking(pat: Node, s: string): boolean {
    steps = 0;
    return bt(pat, s, 0, (j) => j === s.length);
  }
  function ends(node: Node, s: string, starts: Set<number>): Set<number> {
    if (node[0] === 'lit') {
      const out = new Set<number>();
      for (const i of starts) { steps++; if (i < s.length && s[i] === node[1]) out.add(i + 1); }
      return out;
    }
    if (node[0] === 'seq') {
      let cur = new Set(starts);
      for (const part of node[1]) cur = ends(part, s, cur);
      return cur;
    }
    if (node[0] === 'alt') {
      const out = new Set<number>();
      for (const option of node[1]) for (const e of ends(option, s, starts)) out.add(e);
      return out;
    }
    const seen = new Set<number>(), out = new Set<number>();
    let frontier = new Set(starts);
    while (frontier.size > 0) {
      const nxt = ends(node[1], s, new Set([...frontier].filter((x) => !seen.has(x))));
      for (const x of frontier) seen.add(x);
      for (const x of nxt) out.add(x);
      frontier = new Set([...nxt].filter((x) => !seen.has(x)));
    }
    return out;
  }
  function matchSets(pat: Node, s: string): boolean {
    steps = 0;
    return ends(pat, s, new Set([0])).has(s.length);
  }

  const A: Node = ['lit', 'a'];
  const PATTERNS: Record<string, Node> = {
    nested: ['plus', ['plus', A]],
    ambig: ['plus', ['alt', [A, ['seq', [A, A]]]]],
    simple: ['plus', A],
  };
  const near = (n: number) => 'a'.repeat(n) + 'b';

  // Backtracking steps: run the matcher where that is cheap, use the checked rules for large near misses.
  function backtrackingSteps(id: string, n: number, isNear: boolean): { steps: number; how: string } {
    const pat = PATTERNS[id];
    if (!isNear || id === 'simple' || n <= 20) {
      matchBacktracking(pat, isNear ? near(n) : 'a'.repeat(n));
      return { steps, how: 'run on the matcher' };
    }
    if (id === 'nested') return { steps: 2 ** (n + 1) - 1, how: 'rule: 2^(n+1) - 1' };
    matchBacktracking(pat, near(19)); let a = steps;
    matchBacktracking(pat, near(20)); let b = steps;
    for (let i = 0; i < n - 20; i++) { const t = a + b + 3; a = b; b = t; }
    return { steps: b, how: 'rule: previous + the one before + 3' };
  }

  function timeText(count: number): string {
    const s = count / 1e9;
    if (s < 1e-6) return `${formatOneDecimalBelow100(s * 1e9)} ns`;
    if (s < 1e-3) return `${formatOneDecimalBelow100(s * 1e6)} µs`;
    if (s < 1) return `${formatOneDecimalBelow100(s * 1e3)} ms`;
    if (s < 60) return `${formatOneDecimalBelow100(s)} seconds`;
    if (s < 3600) return `${formatOneDecimalBelow100(s / 60)} minutes`;
    if (s < 86400) return `${formatOneDecimalBelow100(s / 3600)} hours`;
    if (s < 365.25 * 86400) return `${formatOneDecimalBelow100(s / 86400)} days`;
    return `${formatOneDecimalBelow100(s / (365.25 * 86400))} years`;
  }
  const colorOf = (count: number) => (count <= 1e9 ? 'var(--good)' : count <= 86400e9 ? 'var(--signal)' : 'var(--bad)');
  function addRow(tbody: HTMLElement, cells: string[], count: number) {
    const tr = document.createElement('tr');
    cells.forEach((text) => { const td = document.createElement('td'); td.textContent = text; tr.appendChild(td); });
    const bar = document.createElement('td');
    const fill = document.createElement('span'); fill.className = 'sm-bar';
    fill.style.width = `${Math.min(100, Math.max(2, String(count).length * (100 / 16)))}%`; fill.style.background = colorOf(count);
    bar.appendChild(fill); tr.appendChild(bar);
    tbody.appendChild(tr);
  }

  document.querySelectorAll<HTMLElement>('[data-sm]').forEach((root) => {
    const q = query(root);
    const val = (s: string) => q<HTMLSelectElement>(s).value;
    function draw() {
      // Substring search.
      const tl = Number(val('[data-text]')), pl = Number(val('[data-pat]'));
      const text = 'a'.repeat(tl), pat = 'a'.repeat(pl - 1) + 'b';
      naiveSearch(text, pat); const naive = steps;
      kmpSearch(text, pat); const kmp = steps;
      const r1 = q('[data-rows1]'); r1.textContent = '';
      addRow(r1, ['Naive search', formatThousands(naive), timeText(naive)], naive);
      addRow(r1, ['KMP', formatThousands(kmp), timeText(kmp)], kmp);
      q('[data-verdict1]').textContent = naive > kmp
        ? `Naive makes ${formatOneDecimalBelow100(naive / kmp)} times as many comparisons as KMP here.`
        : `At this size naive and KMP are close: ${formatThousands(naive)} against ${formatThousands(kmp)} comparisons.`;
      // Regex matching.
      const id = val('[data-regex]'), isNear = val('[data-input]') === 'miss', n = Number(val('[data-n]'));
      const back = backtrackingSteps(id, n, isNear);
      const pattern = PATTERNS[id];
      const ok = matchSets(pattern, isNear ? near(n) : 'a'.repeat(n));
      const setSteps = steps;
      const r2 = q('[data-rows2]'); r2.textContent = '';
      addRow(r2, ['Backtracking', formatThousands(back.steps), timeText(back.steps), back.how], back.steps);
      addRow(r2, ['Set-based', formatThousands(setSteps), timeText(setSteps), 'run on the matcher'], setSteps);
      const verdict = q('[data-verdict2]');
      const word = ok ? 'The input matches' : 'The input does not match';
      verdict.textContent = back.steps > 1e9
        ? `${word}. Backtracking needs ${formatThousands(back.steps)} steps, about ${timeText(back.steps)}: not acceptable for a request. The set-based matcher needs ${formatThousands(setSteps)}.`
        : back.steps > setSteps
          ? `${word}. Backtracking needs ${formatThousands(back.steps)} steps against ${formatThousands(setSteps)}, and it grows quickly with n.`
          : `${word}. Backtracking needs ${formatThousands(back.steps)} steps and the set-based matcher ${formatThousands(setSteps)}: both are fine at this size.`;
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .sm-h { margin: 14px 0 4px; font-size: 1rem; }
  .playground .sm-scroll { overflow-x: auto; }
  .playground .sm-table { border-collapse: collapse; width: 100%; font-size: .88rem; }
  .playground .sm-table th, .playground .sm-table td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border); }
  .playground .sm-table td:nth-child(2), .playground .sm-table td:nth-child(3) { font-family: var(--font-mono); overflow-wrap: anywhere; min-width: 7rem; }
  .playground .sm-table td:last-child { min-width: 110px; width: 24%; }
  .playground .sm-bar { display: block; height: 12px; border-radius: 3px; }
</style>
