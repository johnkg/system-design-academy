---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Break the instances" hint="Three instances behind a load balancer. Cause failures, advance time in 10-second steps, and see what the orchestrator and load balancer do with different check designs.">
  <ol class="how">
    <li>Press <b>Instance 2 deadlocks</b> and advance time three steps: liveness fails three times, the orchestrator <b>restarts</b> it, and it rejoins after two more steps, once its start-up is done. Meanwhile it received no traffic.</li>
    <li>Press <b>Database goes down</b> with <b>readiness checks the database</b> ticked and advance once: <b>all three</b> instances leave the pool and the service has a total outage.</li>
    <li>Untick it and repeat: the instances stay in the pool and keep serving what they can. Now tick <b>liveness checks the database</b> too, and advance several steps: healthy instances are restarted for no reason.</li>
  </ol>
  <div class="pg hc" data-hc>
    <div class="pg-row">
      <label class="hc-check"><input type="checkbox" data-readydb /> Readiness checks the database</label>
      <label class="hc-check"><input type="checkbox" data-livedb /> Liveness checks the database</label>
    </div>
    <div class="pg-row">
      <button class="btn" type="button" data-stuck>Instance 2 deadlocks</button>
      <button class="btn" type="button" data-warm>Instance 3 is redeployed (slow start)</button>
      <button class="btn" type="button" data-db aria-pressed="false">Database goes down</button>
      <button class="btn pg-primary" type="button" data-tick>Advance 10 seconds</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="pg-grid" data-cards></div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-mono" data-clock></p>
  </div>
</PlaygroundShell>
<script>
  const TICK_S = 10; // seconds per check
  const LIVENESS_FAILS = 3; // failed liveness checks before a restart
  const WARMUP = { restart: 2, slowStart: 4 }; // checks an instance spends starting up
  interface Inst { stuck: boolean; warming: number; liveFails: number; restarts: number }
  document.querySelectorAll<HTMLElement>('[data-hc]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const on = (s: string) => q<HTMLInputElement>(s).checked;
    let inst: Inst[] = []; let dbUp = true; let t = 0;
    const cards = [0, 1, 2].map((i) => { const b = document.createElement('div'); b.className = 'pg-box'; b.innerHTML = '<h3></h3><span class="pg-mono"></span><span class="pg-note"></span>'; b.querySelector('h3')!.textContent = `Instance ${i + 1}`; q('[data-cards]').appendChild(b); return { b, a: b.querySelector<HTMLElement>('.pg-mono')!, n: b.querySelector<HTMLElement>('.pg-note')! }; });
    const ready = (i: Inst) => !i.stuck && i.warming === 0 && (!on('[data-readydb]') || dbUp);
    function reset() { inst = [0, 1, 2].map(() => ({ stuck: false, warming: 0, liveFails: 0, restarts: 0 })); dbUp = true; t = 0; const b = q('[data-db]'); b.setAttribute('aria-pressed', 'false'); b.textContent = 'Database goes down'; draw(); }
    function tick() {
      t += TICK_S;
      inst.forEach((i) => {
        if (i.warming > 0) { i.warming--; return; }
        const liveOk = !i.stuck && (!on('[data-livedb]') || dbUp);
        if (liveOk) { i.liveFails = 0; return; }
        i.liveFails++;
        if (i.liveFails >= LIVENESS_FAILS) { i.stuck = false; i.warming = WARMUP.restart; i.liveFails = 0; i.restarts++; }
      });
      draw();
    }
    function draw() {
      inst.forEach((i, k) => {
        const c = cards[k]; const r = ready(i);
        const status = i.stuck ? 'STUCK (not answering)' : i.warming > 0 ? 'starting up' : 'running';
        c.a.textContent = `${status}${i.liveFails ? `, liveness failed ${i.liveFails}/${LIVENESS_FAILS}` : ''}`;
        c.n.textContent = `${r ? 'In the load balancer: receiving traffic' : 'Removed from the load balancer'} · restarts: ${i.restarts}`;
        c.b.style.setProperty('--c', r ? 'var(--role-2)' : 'var(--bad)'); c.b.classList.toggle('off', !r);
      });
      const n = inst.filter(ready).length; const out = q('[data-verdict]');
      const msg = n === 0 ? (dbUp ? 'No instance can take traffic right now: users see errors.' : 'TOTAL OUTAGE: the database blip removed every instance, so even requests that do not need the database fail.') : !dbUp ? `${n} of 3 instances still serving. Requests that need the database fail fast, everything else works.` : `${n} of 3 instances receiving traffic. Service is healthy.`;
      out.textContent = msg; out.classList.toggle('bad', n === 0 || !dbUp);
      q('[data-clock]').textContent = `t + ${t} s · database ${dbUp ? 'up' : 'DOWN'}`;
    }
    q('[data-stuck]').addEventListener('click', () => { inst[1].stuck = true; draw(); });
    q('[data-warm]').addEventListener('click', () => { inst[2].warming = WARMUP.slowStart; inst[2].liveFails = 0; draw(); });
    q('[data-db]').addEventListener('click', (e) => { dbUp = !dbUp; const b = e.currentTarget as HTMLElement; b.setAttribute('aria-pressed', String(!dbUp)); b.textContent = dbUp ? 'Database goes down' : 'Database comes back'; draw(); });
    q('[data-tick]').addEventListener('click', tick);
    q('[data-reset]').addEventListener('click', reset);
    root.addEventListener('change', draw);
    reset();
  });
</script>
<style is:global>
  .playground .hc-check { display: inline-flex; align-items: center; gap: 6px; }
</style>
