---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A column in the database is renamed. Choose how many domain classes and how many places read it, then compare domain objects that read rows themselves with a mapper.">
  <ol class="how">
    <li>Start with the defaults: <b>Domain classes</b> at <b>3</b>, <b>Places that read the column</b> at <b>5</b> and <b>Design</b> <b>Rows inside domain objects</b>. A column rename means editing <b>5</b> places, there are <b>0</b> extra classes, and domain tests need a database.</li>
    <li>Set <b>Design</b> to <b>Data mapper</b>: only <b>1</b> place changes, the domain tests need no database, and the price is <b>3</b> extra mapper classes.</li>
    <li>Set <b>Domain classes</b> to <b>10</b>: the mappers cost <b>10</b> extra classes. For a simple tool this is more code than the pattern earns.</li>
    <li>Set <b>Places that read the column</b> to <b>1</b> with <b>Design</b> on <b>Rows inside domain objects</b>: <b>1</b> place changes, the same as with a mapper, so the pattern gains nothing here.</li>
  </ol>
  <div class="pg dmap" data-dmap>
    <div class="pg-row">
      <label>Domain classes <input class="pg-in" type="range" min="1" max="10" step="1" value="3" data-e /> <b data-ev></b></label>
      <label>Places that read the column <input class="pg-in" type="range" min="1" max="10" step="1" value="5" data-r /> <b data-rv></b></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Rows inside domain objects</option><option value="1">Data mapper</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Places edited for a column rename</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Extra classes to write</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Domain tests need a database</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // The same model as the code samples: domain objects that read rows themselves, or one mapper that knows the columns.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-dmap]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const entities = Number(q<HTMLInputElement>('[data-e]').value), reads = Number(q<HTMLInputElement>('[data-r]').value);
      const mapper = q<HTMLSelectElement>('[data-design]').value === '1';
      q('[data-ev]').textContent = String(entities); q('[data-rv]').textContent = String(reads);
      const edited = mapper ? 1 : reads;
      setBox(1, String(edited), mapper ? 'the mapper, which is the only place that knows the column' : 'every place that reads the column from a row', edited === 1 ? 'good' : 'bad');
      setBox(2, String(mapper ? entities : 0), mapper ? 'one mapper for each domain class' : 'the domain classes do their own mapping', mapper ? 'mid' : 'good');
      setBox(3, mapper ? 'No' : 'Yes', mapper ? 'tests build plain objects, or use a fake mapper' : 'a domain object cannot be built without a row', mapper ? 'good' : 'bad');
      q('[data-verdict]').textContent = mapper
        ? 'The domain stays plain and a schema change stays in the mapper. The price is one more class per entity, which a simple CRUD tool may not need.'
        : 'Fewer classes, but the schema leaks into the domain. It hurts when columns change or the domain has real rules.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
