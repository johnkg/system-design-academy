---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="1,000 requests to a service. Most take about 100 ms, but a share are slow. See what the average, the percentiles and your users experience.">
  <ol class="how">
    <li>Set the <b>slow requests</b> to <b>0%</b>: mean, p50 and p99 sit close together (about 100 to 145 ms). Now raise it to <b>2%</b> and watch the mean only reach about 160 ms while the <b>p99</b> jumps to nearly 3 seconds.</li>
    <li>Raise <b>calls per page load</b>: one page makes many calls, so the share of users who hit at least one slow call is far higher than the share of slow requests.</li>
    <li>Look at the histogram: the slow requests form a small, separate bar that an average smooths away.</li>
  </ol>
  <div class="pg met" data-met>
    <div class="pg-row">
      <label>Slow requests <input type="range" min="0" max="10" step="0.5" value="1" data-slow /> <b data-slowval></b></label>
      <label>Calls per page load <input type="range" min="1" max="50" value="10" data-calls /> <b data-callsval></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-2)"><h3>Mean (average)</h3><span class="pg-mono" data-mean></span></div>
      <div class="pg-box" style="--c: var(--role-1)"><h3>p50 (typical)</h3><span class="pg-mono" data-p50></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>p95</h3><span class="pg-mono" data-p95></span></div>
      <div class="pg-box" data-p99box><h3>p99</h3><span class="pg-mono" data-p99></span></div>
    </div>
    <div class="pg-box" data-userbox aria-live="polite"><h3>Users who see a slow page</h3><span class="pg-mono" data-users></span><span class="pg-note" data-usernote></span></div>
    <p class="pg-note">Latency histogram (number of requests per range):</p>
    <div class="met-hist" role="img" aria-label="Latency histogram" data-hist></div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const N = 1000; const bounds = [50, 100, 150, 250, 500, 1000, 2000, 4000];
  const SEED = 2024;
  const FAST = { mean: 100, sd: 18, min: 40 }; // normal requests: about 100 +- 18 ms, never under 40 ms
  const SLOW = { min: 1500, span: 2200 }; // slow requests: 1500..3700 ms
  const EPS = 1e-9; // keeps log() finite
  const P99_BAD_MS = 1000, USERS_BAD_PCT = 5;
  // mulberry32 seeded PRNG
  function prng(seed: number) { let s = seed >>> 0; return () => { s = (s + 0x6d2b79f5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
  const rnd = prng(SEED);
  // Fixed random draws, so moving the slider only changes which requests count as slow
  const draws = Array.from({ length: N }, () => ({ pick: rnd(), a: rnd(), b: rnd() }));
  const fast = draws.map((d) => Math.max(FAST.min, Math.round(FAST.mean + FAST.sd * Math.sqrt(-2 * Math.log(d.a || EPS)) * Math.cos(2 * Math.PI * d.b)))); // Box-Muller
  const slowVal = draws.map((d) => Math.round(SLOW.min + d.a * SLOW.span));
  const pct = (sorted: number[], p: number) => sorted[Math.max(1, Math.ceil((p / 100) * sorted.length)) - 1];
  document.querySelectorAll<HTMLElement>('[data-met]').forEach((root) => {
    const q = query(root);
    const bars = bounds.map((b, i) => { const wrap = document.createElement('div'); wrap.className = 'met-col'; wrap.innerHTML = '<span class="met-n pg-mono"></span><div class="met-bar"><i></i></div><span class="met-l"></span>'; wrap.querySelector('.met-l')!.textContent = i === 0 ? `<${b}` : `${bounds[i - 1]}-${b}`; q('[data-hist]').appendChild(wrap); return { fill: wrap.querySelector<HTMLElement>('i')!, n: wrap.querySelector<HTMLElement>('.met-n')! }; });
    function draw() {
      const slow = Number(q<HTMLInputElement>('[data-slow]').value); const calls = Number(q<HTMLInputElement>('[data-calls]').value);
      q('[data-slowval]').textContent = `${slow}%`; q('[data-callsval]').textContent = String(calls);
      const values = draws.map((d, i) => (d.pick < slow / 100 ? slowVal[i] : fast[i]));
      const sorted = [...values].sort((a, b) => a - b); const mean = values.reduce((a, b) => a + b, 0) / N;
      q('[data-mean]').textContent = `${Math.round(mean)} ms`; q('[data-p50]').textContent = `${pct(sorted, 50)} ms`; q('[data-p95]').textContent = `${pct(sorted, 95)} ms`;
      const p99 = pct(sorted, 99); q('[data-p99]').textContent = `${p99} ms`; q<HTMLElement>('[data-p99box]').style.setProperty('--c', p99 > P99_BAD_MS ? 'var(--bad)' : 'var(--role-2)');
      const share = (1 - (1 - values.filter((v) => v >= SLOW.min).length / N) ** calls) * 100;
      q('[data-users]').textContent = `${share.toFixed(1)}%`; q<HTMLElement>('[data-userbox]').style.setProperty('--c', share > USERS_BAD_PCT ? 'var(--bad)' : 'var(--role-2)');
      q('[data-usernote]').textContent = `A page load makes ${calls} calls, and any slow call makes the page feel slow.`;
      const counts = bounds.map(() => 0); values.forEach((v) => { counts[Math.max(0, bounds.findIndex((b) => v <= b))]++; });
      const max = Math.max(...counts); bars.forEach((b, i) => { b.fill.style.height = `${(counts[i] / max) * 100}%`; b.n.textContent = String(counts[i]); });
      q('[data-hist]').setAttribute('aria-label', `Latency histogram: ${bounds.map((b, i) => `${counts[i]} requests up to ${b} ms`).join(', ')}`);
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .playground .met-hist { display: flex; gap: 6px; align-items: flex-end; height: 130px; }
  .playground .met-col { flex: 1 1 0; min-width: 0; display: grid; grid-template-rows: auto 1fr auto; gap: 2px; height: 100%; text-align: center; }
  .playground .met-bar { display: flex; align-items: flex-end; background: var(--surface-2); border-radius: 4px; }
  .playground .met-bar i { display: block; width: 100%; background: var(--accent); border-radius: 4px; min-height: 0; transition: height .15s; }
  .playground .met-l { font-size: .68rem; color: var(--muted); }
  .playground .met-n { font-size: .72rem; }
</style>
