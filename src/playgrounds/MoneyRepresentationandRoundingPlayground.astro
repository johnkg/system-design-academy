---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A cart of six lines with tax. The same cart is totalled in binary floating point and in integer cents, with the rounding point, rounding mode and tax rate you choose, then an amount is split between people and converted to another currency. Everything is calculated exactly as in the code samples.">
  <ol class="how">
    <li>Start with the defaults: prices held as <b>Binary float</b> dollars, tax rounded <b>Per line</b>, <b>Half up</b>, at a <b>Tax rate</b> of <b>10%</b>. The float total is <b>19589</b> cents, but the same cart in integers gives <b>19590</b>, so the float version is 1 cent short. The table shows where: the Pen line has an exact tax of <b>211.5</b>, a tie, and float arithmetic rounds it down to 211 instead of up to 212. Now set <b>Representation</b> to <b>Integer cents</b> and the gap disappears.</li>
    <li>Set <b>Rounding mode</b> to <b>Half even</b>: the two tie lines (258.5 and 211.5) round to 258 and 212 instead of 259 and 212, and the total becomes <b>19589</b> cents. Truncating gives <b>19586</b>. The three modes are all defensible, but each gives a different total, so the rule must be written down.</li>
    <li>Set <b>Rounding point</b> to <b>On the total</b>: the tax is rounded once, on the subtotal of <b>17808</b> cents, and the half up total is <b>19589</b> cents instead of <b>19590</b>. The tax per line added up and the tax on the whole cart are different numbers, and an invoice must say which one it uses.</li>
    <li>In the split box, set <b>Amount to split (cents)</b> to <b>10000</b> and <b>People</b> to <b>3</b>: giving everyone 3333 adds up to <b>9999</b>, one cent lost, while the allocated split is <b>3334 + 3333 + 3333</b>. Set <b>People</b> to <b>6</b> and the naive split invents <b>10002</b> cents. Last, set <b>Convert the subtotal to</b> <b>JPY</b>: converting each line and adding gives <b>26579</b>, converting the subtotal once gives <b>26578</b>.</li>
  </ol>
  <div class="pg mr" data-mr>
    <div class="pg-row">
      <label>Representation <select class="pg-in" data-rep><option value="float" selected>Binary float</option><option value="int">Integer cents</option></select></label>
      <label>Rounding point <select class="pg-in" data-point><option value="line" selected>Per line</option><option value="total">On the total</option></select></label>
      <label>Rounding mode <select class="pg-in" data-mode><option value="up" selected>Half up</option><option value="even">Half even</option><option value="trunc">Truncate</option></select></label>
      <label>Tax rate <select class="pg-in" data-rate><option value="500">5%</option><option value="750">7.5%</option><option value="825">8.25%</option><option value="1000" selected>10%</option><option value="2000">20%</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Your total</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Same cart in integer cents</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Your total against integers</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Rounding point</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Rounding mode</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Floats at work</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The six lines, in cents</h3>
      <div class="mr-scroll" tabindex="0" role="region" aria-label="The six lines, in cents"><table class="mr-table" data-lines></table></div>
      <span class="pg-note" data-n7></span>
    </div>
    <div class="pg-row">
      <label>Amount to split (cents) <input class="pg-in" type="number" min="1" max="1000000" step="1" value="10000" data-amount /></label>
      <label>People <input class="pg-in" type="number" min="1" max="20" step="1" value="3" data-people /></label>
      <label>Convert the subtotal to <select class="pg-in" data-cur><option value="EUR" selected>EUR</option><option value="JPY">JPY</option><option value="KWD">KWD</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b8><h3>Naive split</h3><span class="pg-mono" data-o8></span><span class="pg-note" data-n8></span></div>
      <div class="pg-box" data-b9><h3>Allocated split</h3><span class="pg-mono" data-o9></span><span class="pg-note" data-n9></span></div>
      <div class="pg-box" data-b10><h3>Convert each line, then add</h3><span class="pg-mono" data-o10></span><span class="pg-note" data-n10></span></div>
      <div class="pg-box" data-b11><h3>Add, then convert once</h3><span class="pg-mono" data-o11></span><span class="pg-note" data-n11></span></div>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  type Mode = 'up' | 'even' | 'trunc';
  type Point = 'line' | 'total';
  // The same model as the code samples: 6 lines of [name, price in cents, quantity].
  const LINES: [string, number, number][] = [['Notebook', 1410, 3], ['Headphones', 2585, 1], ['Desk lamp', 2507, 1], ['Backpack', 3009, 1], ['Pen', 705, 3], ['Mug', 1681, 2]];
  const SUBTOTAL = LINES.reduce((s, [, p, q]) => s + p * q, 0);
  const RATES: Record<string, { exp: number; rateE4: number }> = { EUR: { exp: 2, rateE4: 9137 }, JPY: { exp: 0, rateE4: 1492500 }, KWD: { exp: 3, rateE4: 3074 } };
  const MODE_NAME: Record<Mode, string> = { up: 'half up', even: 'half even', trunc: 'truncated' };

  function divRound(num: number, den: number, mode: Mode): number {
    const q = (num - (num % den)) / den;
    const r = num - q * den;
    if (mode === 'trunc') return q;
    if (2 * r > den) return q + 1;
    if (2 * r < den) return q;
    return mode === 'up' ? q + 1 : (q % 2 === 0 ? q : q + 1);
  }
  function floatRound(dollars: number, mode: Mode): number {
    const x = dollars * 100;
    const f = Math.floor(x);
    const d = x - f;
    let cents: number;
    if (mode === 'trunc') cents = f;
    else if (d > 0.5) cents = f + 1;
    else if (d < 0.5) cents = f;
    else cents = mode === 'up' ? f + 1 : (f % 2 === 0 ? f : f + 1);
    return cents / 100;
  }
  function integerCart(bp: number, point: Point, mode: Mode) {
    let subtotal = 0, tax = 0;
    for (const [, price, qty] of LINES) {
      subtotal += price * qty;
      if (point === 'line') tax += divRound(price * qty * bp, 10000, mode);
    }
    if (point === 'total') tax = divRound(subtotal * bp, 10000, mode);
    return { tax, total: subtotal + tax };
  }
  function floatCart(bp: number, point: Point, mode: Mode) {
    const rate = bp / 10000;
    let subtotal = 0, tax = 0;
    for (const [, price, qty] of LINES) {
      const net = (price / 100) * qty;
      subtotal += net;
      if (point === 'line') tax += floatRound(net * rate, mode);
    }
    if (point === 'total') tax = floatRound(subtotal * rate, mode);
    return { tax: Math.round(tax * 100), total: Math.round((subtotal + tax) * 100) };
  }
  function allocate(amount: number, weights: number[]): number[] {
    const sum = weights.reduce((a, b) => a + b, 0);
    const parts = weights.map((w) => Math.floor((amount * w) / sum));
    const rem = weights.map((w) => (amount * w) % sum);
    let left = amount - parts.reduce((a, b) => a + b, 0);
    const order = weights.map((_, i) => i).sort((a, b) => rem[b] - rem[a] || a - b);
    for (const i of order) { if (left === 0) break; parts[i] += 1; left -= 1; }
    return parts;
  }
  const convert = (minor: number, fromExp: number, toExp: number, rateE4: number, mode: Mode) => divRound(minor * rateE4 * 10 ** toExp, 10 ** fromExp * 10000, mode);
  function show(minor: number, exp: number): string {
    if (exp === 0) return String(minor);
    const p = 10 ** exp;
    return `${Math.floor(minor / p)}.${String(minor % p).padStart(exp, '0')}`;
  }
  const signed = (n: number) => (n > 0 ? `+${n}` : String(n));
  const cents = (n: number) => `${n} cents`;

  document.querySelectorAll<HTMLElement>('[data-mr]').forEach((root) => {
    const q = query(root);
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    const sel = (s: string) => q<HTMLSelectElement>(s).value;

    function draw() {
      const rep = sel('[data-rep]'), point = sel('[data-point]') as Point, mode = sel('[data-mode]') as Mode, bp = Number(sel('[data-rate]'));
      const ref = integerCart(bp, point, mode), fl = floatCart(bp, point, mode);
      const mine = rep === 'float' ? fl : ref;
      const diff = mine.total - ref.total;

      set(1, cents(mine.total), `tax ${mine.tax} on a subtotal of ${SUBTOTAL}, ${rep === 'float' ? 'dollars held as binary floats' : 'whole cents, no fractions'}`);
      box(1, diff === 0);
      set(2, cents(ref.total), `tax ${ref.tax}, rounded per ${point === 'line' ? 'line' : 'cart'}, ${MODE_NAME[mode]}`);
      box(2, true);
      set(3, diff === 0 ? '0 cents' : `${signed(diff)} cent${Math.abs(diff) === 1 ? '' : 's'}`, diff === 0 ? 'no difference at these settings' : 'a float that is off by a cent on one tie is a reconciliation break on every such order');
      box(3, diff === 0);

      const perLine = integerCart(bp, 'line', mode).total, once = integerCart(bp, 'total', mode).total;
      set(4, `per line ${perLine}, on the total ${once}`, perLine === once ? 'same total at this rate: the lines happen to round the same way' : `${Math.abs(perLine - once)} cent apart, in integers, with the same mode`);
      box(4, perLine === once);
      const m = (k: Mode) => integerCart(bp, point, k).total;
      set(5, `half up ${m('up')}, half even ${m('even')}, truncate ${m('trunc')}`, 'integer totals, with the rounding point you chose');
      box(5, m('up') === m('even') && m('up') === m('trunc'));

      const a = 0.1, b = 0.2;
      let ten = 0; for (let i = 0; i < 10; i++) ten += a;
      set(6, `0.1 + 0.2 = ${a + b}\nten times 0.1 = ${ten}`, 'neither is the value you wrote, because 0.1 has no exact binary form');
      box(6, false);

      // The table of lines.
      const table = q<HTMLTableElement>('[data-lines]');
      table.textContent = '';
      const head = table.insertRow();
      for (const h of ['Line', 'Net', 'Exact tax', 'Integer, per line', 'Float, per line']) { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); }
      let ties = 0;
      for (const [name, price, qty] of LINES) {
        const net = price * qty;
        const exactNum = net * bp;
        const tie = exactNum % 10000 === 5000;
        if (tie) ties++;
        const rInt = divRound(exactNum, 10000, mode);
        const rFl = Math.round(floatRound((net / 100) * (bp / 10000), mode) * 100);
        const row = table.insertRow();
        const vals = [`${name} (${qty} x ${price})`, String(net), `${Number((exactNum / 10000).toFixed(4))}${tie ? ' (tie)' : ''}`, String(rInt), String(rFl)];
        vals.forEach((v, i) => { const td = row.insertCell(); td.textContent = v; if (i === 4 && rFl !== rInt) td.className = 'mr-bad'; });
      }
      q('[data-n7]').textContent = `${ties} line${ties === 1 ? ' is' : 's are'} an exact tie at this rate, where the rounding mode decides. A red float cell differs from the integer one.`;

      // Splitting.
      const amount = Math.max(1, Math.floor(Number(q<HTMLInputElement>('[data-amount]').value) || 1));
      const people = Math.min(20, Math.max(1, Math.floor(Number(q<HTMLInputElement>('[data-people]').value) || 1)));
      const each = divRound(amount, people, 'up');
      const naive = each * people;
      const parts = allocate(amount, Array(people).fill(1));
      set(8, `${each} each, adds up to ${naive}`, naive === amount ? 'adds up exactly: the amount divides evenly' : `${signed(naive - amount)} cent${Math.abs(naive - amount) === 1 ? '' : 's'}: money lost or invented`);
      box(8, naive === amount);
      set(9, `${parts.join(' + ')} = ${parts.reduce((x, y) => x + y, 0)}`, 'the leftover cents go to the largest remainders, so the parts always add up');
      box(9, true);

      // Currency conversion.
      const cur = RATES[sel('[data-cur]')];
      const name = sel('[data-cur]');
      const eachLine = LINES.reduce((s, [, p, qty]) => s + convert(p * qty, 2, cur.exp, cur.rateE4, 'up'), 0);
      const oneShot = convert(SUBTOTAL, 2, cur.exp, cur.rateE4, 'up');
      const fmt = (n: number) => (cur.exp === 0 ? `${n} ${name}` : `${n} (${show(n, cur.exp)} ${name})`);
      set(10, fmt(eachLine), 'illustrative rate, rounded half up after every line');
      set(11, fmt(oneShot), eachLine === oneShot ? 'the same here: rounding errors cancelled out' : `${Math.abs(eachLine - oneShot)} minor unit apart: round once, at the end`);
      box(10, eachLine === oneShot);
      box(11, true);
    }
    root.addEventListener('change', draw);
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .playground .mr { display: grid; gap: 12px; }
  .playground .mr-scroll { overflow-x: auto; }
  .playground .mr-table { border-collapse: collapse; font: .82rem var(--font-mono); width: 100%; }
  .playground .mr-table th, .playground .mr-table td { text-align: left; padding: 4px 10px 4px 0; white-space: nowrap; }
  .playground .mr-table th { color: var(--muted); font-weight: 600; }
  .playground .mr-table .mr-bad { color: var(--bad-text); font-weight: 700; }
  .playground .mr [data-o6] { white-space: pre-wrap; }
</style>
