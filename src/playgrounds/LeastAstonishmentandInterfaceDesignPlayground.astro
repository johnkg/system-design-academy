---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A helper library with up to four hazards is used by 20 callers. Some read only names, some also the signature, a few the documentation. Choose the interface design and the team, and count mistaken calls and the damage they do. The reading mix and damage weights are assumptions of the model.">
  <ol class="how">
    <li>Start with <b>Design</b> <b>Invites misuse</b>, <b>Team</b> <b>Mixed team</b> and all four hazards ticked: <b>56</b> mistaken calls and <b>168</b> points of damage. The damage line shows the surprising default alone is <b>80</b> of them.</li>
    <li>Set <b>Team</b> to <b>Hurried team</b>: <b>73</b> mistaken calls and <b>206</b> points. Set <b>Team</b> to <b>Careful team</b>: <b>15</b> and <b>50</b>. The same interface is safe only for people who read the most.</li>
    <li>Set <b>Team</b> to <b>Mixed team</b> and <b>Design</b> to <b>Least astonishing</b>: <b>0</b> mistaken calls and a call of <b>2</b> arguments, because the name, type or default now shows each hazard.</li>
    <li>Break it: set <b>Design</b> to <b>Over-explicit</b>. Every call now needs <b>14</b> arguments, and <b>16</b> calls are still mistaken, with <b>64</b> points of damage, because skimmers paste the dangerous settings from an example.</li>
  </ol>
  <div class="pg lad" data-lad>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design><option value="inviting" selected>Invites misuse</option><option value="least">Least astonishing</option><option value="over">Over-explicit</option></select></label>
      <label>Team <select class="pg-in" data-team><option value="careful">Careful team</option><option value="mixed" selected>Mixed team</option><option value="hurried">Hurried team</option></select></label>
    </div>
    <div class="pg-row">
      <label><input type="checkbox" data-h0 checked /> Boolean flag parameters</label>
      <label><input type="checkbox" data-h1 checked /> Surprising default</label>
      <label><input type="checkbox" data-h2 checked /> Hidden side effect</label>
      <label><input type="checkbox" data-h3 checked /> Misleading name</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Mistaken calls</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Damage points</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Arguments per call</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Hazards the name or type shows</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>All three designs with this team and these hazards</h3>
      <div class="lad-scroll" tabindex="0" role="region" aria-label="Mistaken calls, damage and arguments per design"><table class="lad-table" data-table></table></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type Design = 'inviting' | 'least' | 'over';
  type Team = 'careful' | 'mixed' | 'hurried';

  // The same model as the code samples. 20 callers per team as counts at attention level 0 (names only), 1 (signature), 2 (documentation).
  // A hazard is noticed only by a caller who reads at least `need` levels deep. inviting: callers below `need` are surprised.
  // least astonishing: the name, type or default shows the hazard (need 0). over-explicit: nobody is surprised by a default, but callers
  // who only read names paste the dangerous settings (weight 3 or more) from the nearest example.
  const TEAMS: Record<Team, number[]> = { careful: [0, 5, 15], mixed: [8, 8, 4], hurried: [16, 3, 1] };
  const HAZARDS: [string, number, number][] = [['flags', 1, 1], ['default', 2, 5], ['side effect', 2, 3], ['name', 2, 2]]; // [label, need, damage if it bites]
  const sum = (xs: number[]) => xs.reduce((a, b) => a + b, 0);
  const astonished = (design: Design, team: Team, need: number, weight: number) => {
    const counts = TEAMS[team];
    if (design === 'inviting') return sum(counts.slice(0, need));
    if (design === 'least') return 0;
    return weight >= 3 ? counts[0] : 0;
  };
  const words = (design: Design, flags: boolean, present: number) => (design === 'inviting' ? 2 + (flags ? 2 : 0) : design === 'least' ? 2 : 2 + 3 * present);
  const NAMES: Record<Design, string> = { inviting: 'Invites misuse', least: 'Least astonishing', over: 'Over-explicit' };
  const ALL: Design[] = ['inviting', 'least', 'over'];
  const HAZARD_NAMES = ['Boolean flag parameters', 'Surprising default', 'Hidden side effect', 'Misleading name'];

  document.querySelectorAll<HTMLElement>('[data-lad]').forEach((root) => {
    const q = query(root);
    const setBox = (n: number, value: string, note: string, good: boolean | null) => {
      q(`[data-o${n}]`).textContent = value; q(`[data-n${n}]`).textContent = note;
      q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good === null ? 'var(--border)' : good ? 'var(--good)' : 'var(--bad)');
    };
    function result(design: Design, team: Team, on: boolean[]) {
      const present = on.filter(Boolean).length;
      let mistaken = 0, damage = 0;
      HAZARDS.forEach(([, need, weight], i) => { if (!on[i]) return; const a = astonished(design, team, need, weight); mistaken += a; damage += a * weight; });
      return { mistaken, damage, args: words(design, on[0], present), visible: design === 'inviting' ? 0 : present, present };
    }
    function draw() {
      const design = q<HTMLSelectElement>('[data-design]').value as Design, team = q<HTMLSelectElement>('[data-team]').value as Team;
      const on = [0, 1, 2, 3].map((i) => q<HTMLInputElement>(`[data-h${i}]`).checked);
      const r = result(design, team, on);
      setBox(1, `${r.mistaken}`, `calls that did something other than the caller meant, out of ${r.present} hazards x 20 callers`, r.mistaken === 0);
      setBox(2, `${r.damage}`, 'points: wrong output 1, ghost records 3, mutated input 2, data loss 5', r.damage === 0 ? true : r.damage > 100 ? false : null);
      setBox(3, `${r.args}`, design === 'over' ? 'every option and confirmation must be written out' : design === 'least' ? 'the common case is short; options are named when needed' : on[0] ? 'the object and the target, plus two positional booleans' : 'the object and the target', design === 'over' ? false : null);
      setBox(4, `${r.visible} of ${r.present}`, design === 'inviting' ? 'each hazard is found only by reading the signature or the docs' : 'visible in the call itself: a safe default, a precise name, named options', r.visible === r.present);
      const table = q('[data-table]'); table.textContent = '';
      const head = table.insertRow(); ['Design', 'Mistaken calls', 'Damage', 'Arguments'].forEach((h) => { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); });
      ALL.forEach((d) => {
        const x = result(d, team, on), row = table.insertRow(); if (d === design) row.className = 'on';
        [NAMES[d], `${x.mistaken}`, `${x.damage}`, `${x.args}`].forEach((v) => { row.insertCell().textContent = v; });
      });
      const parts = HAZARDS.map(([label, need, weight], i) => (on[i] ? `${label} ${astonished(design, team, need, weight) * weight}` : null)).filter(Boolean);
      q('[data-verdict]').textContent = `${NAMES[design]}, ${team} team. Damage by hazard: ${parts.length ? parts.join(', ') : 'none selected'}. ${HAZARD_NAMES.filter((_, i) => on[i]).length} of 4 hazards are present.`;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .lad-scroll { overflow-x: auto; }
  .playground .lad-table { border-collapse: collapse; font: .82rem var(--font-mono); min-width: 100%; }
  .playground .lad-table th, .playground .lad-table td { padding: 4px 8px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
  .playground .lad-table th:first-child, .playground .lad-table td:first-child { text-align: left; }
  .playground .lad-table tr.on td { font-weight: 700; background: var(--accent-soft); }
</style>
