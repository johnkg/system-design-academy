---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="What if it leaks?" hint="Choose where a secret lives and what goes wrong, and see what is exposed and how hard recovery is.">
  <ol class="how">
    <li>Start with <b>Hard-coded in the source code</b> and <b>The repository is shared</b>: the secret is exposed, for good, and recovery means changing it everywhere and rewriting history.</li>
    <li>Switch to <b>Environment variable</b> and then <b>Secrets manager</b> for the same incident, and compare exposure and recovery effort.</li>
    <li>Try <b>An employee leaves</b> and <b>Suspected leak, rotate now</b> to see how a rotation-ready setup turns a crisis into routine work.</li>
  </ol>
  <div class="pg sm" data-sm>
    <div class="pg-row">
      <label>The secret lives in <select class="pg-in" data-where>
        <option value="code" selected>Hard-coded in the source code</option>
        <option value="env">An environment variable on each server</option>
        <option value="vault">A secrets manager with short-lived credentials</option>
      </select></label>
      <label>What happens <select class="pg-in" data-event>
        <option value="repo" selected>The repository is shared or leaked</option>
        <option value="server">One server is compromised</option>
        <option value="leaver">An employee leaves</option>
        <option value="rotate">Suspected leak, rotate now</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-exposedbox><h3>Exposed</h3><span class="pg-mono" data-exposed></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>To recover you must</h3><span class="pg-mono" data-recover></span></div>
      <div class="pg-box" style="--c: var(--role-1)"><h3>You can tell who used it</h3><span class="pg-mono" data-audit></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  type Row = { exposed: string; recover: string; bad: boolean };
  const table: Record<string, Record<string, Row>> = {
    code: {
      repo: { exposed: 'The secret, to everyone who ever cloned the repository, including its full history', recover: 'Change the secret everywhere it is used, redeploy every service, and treat the old value as public forever', bad: true },
      server: { exposed: 'The secret, and every other secret in the same codebase', recover: 'Change every secret and redeploy, since they are all baked into the build', bad: true },
      leaver: { exposed: 'Anyone who ever had source access still knows it', recover: 'Change the secret and redeploy everything', bad: true },
      rotate: { exposed: 'Not applicable until it is changed', recover: 'Edit code, review, build and redeploy every service at once, with downtime risk', bad: true },
    },
    env: {
      repo: { exposed: 'Nothing, the repository holds no secret', recover: 'Nothing to do for this incident', bad: false },
      server: { exposed: 'The secrets on that server, readable by any process or by anyone who can list its environment', recover: 'Change the secrets that server held, update each server by hand or script, and restart', bad: true },
      leaver: { exposed: 'Anyone who could log in to servers or read deployment configuration', recover: 'Change the secret and update every server', bad: true },
      rotate: { exposed: 'Not applicable until it is changed', recover: 'Update the value on every server and restart services, with no record of who read it', bad: true },
    },
    vault: {
      repo: { exposed: 'Nothing, the repository holds no secret', recover: 'Nothing to do for this incident', bad: false },
      server: { exposed: 'Only that service\'s own credential, which is scoped to it and expires within the hour', recover: 'Revoke that identity, the credential then stops working, and issue a clean one', bad: false },
      leaver: { exposed: 'Nothing, since people never held the secret. Their access to the manager is removed', recover: 'Remove the person\'s access to the secrets manager', bad: false },
      rotate: { exposed: 'Not applicable: the new value is created automatically', recover: 'Press rotate. Applications fetch the new value and keep running', bad: false },
    },
  };
  const audit: Record<string, string> = { code: 'No', env: 'No: reading an environment variable leaves no record', vault: 'Yes: every read is logged with the identity that made it' };
  document.querySelectorAll<HTMLElement>('[data-sm]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    function draw() {
      const where = q<HTMLSelectElement>('[data-where]').value; const row = table[where][q<HTMLSelectElement>('[data-event]').value];
      q('[data-exposed]').textContent = row.exposed; q('[data-recover]').textContent = row.recover; q('[data-audit]').textContent = audit[where];
      q<HTMLElement>('[data-exposedbox]').style.setProperty('--c', row.bad ? 'var(--bad)' : 'var(--role-2)');
      const out = q('[data-verdict]'); out.classList.toggle('bad', row.bad);
      out.textContent = row.bad ? 'This setup turns the incident into a painful, slow clean-up.' : 'This setup contains the incident and makes recovery quick.';
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
