---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Send a request down the chain and edit the chain while it runs.">
  <ol class="how">
    <li>Choose an <b>amount</b> and press <b>Send request</b>. Watch it walk the chain.</li>
    <li>Untick an approver to <b>take them out of the chain</b>. The request flows past them.</li>
    <li>Press <b>+ Add VP ($5,000)</b>. A new link, with no change to the others.</li>
  </ol>
  <div class="pg" data-chain>
    <div class="pg-row">
      <label>Amount $ <input class="pg-in" data-amount type="number" min="1" value="5000" style="width:110px" /></label>
      <button class="btn pg-primary" type="button" data-send>Send request</button>
      <button class="btn" type="button" data-addvp>+ Add VP ($5,000)</button>
    </div>
    <div class="ch-chain" data-links></div>
    <output class="pg-out" data-out aria-live="polite">Press Send request.</output>
  </div>
</PlaygroundShell>
<script>
  import { query, wait } from '../playground';
  class Approver {
    next: Approver | null = null;
    constructor(public name: string, public limit: number, public enabled = true) {}
    setNext(n: Approver) { this.next = n; return n; }
    // Returns the trail of handlers visited plus the result.
    approve(amount: number, trail: string[] = []): { trail: string[]; by?: string } {
      trail.push(this.name);
      if (amount <= this.limit) return { trail, by: this.name };
      return this.next ? this.next.approve(amount, trail) : { trail };
    }
  }
  const STEP_MS = 550; // pause on each handler in the animation
  document.querySelectorAll<HTMLElement>('[data-chain]').forEach((root) => {
    const q = query(root);
    const all = [new Approver('Manager', 1000), new Approver('Director', 10000), new Approver('CEO', Infinity)];
    let run = 0;
    const rebuild = () => { const on = all.filter((a) => a.enabled); on.forEach((a, i) => (a.next = on[i + 1] ?? null)); return on[0]; };
    function draw(lit = '', done = '') {
      const w = q('[data-links]'); w.innerHTML = '';
      all.forEach((a, i) => {
        const d = document.createElement('label'); d.className = 'pg-box' + (a.enabled ? '' : ' off') + (lit === a.name ? ' lit' : ''); d.style.setProperty('--c', done === a.name ? 'var(--good)' : 'var(--role-2)');
        d.innerHTML = `<h3><input type="checkbox" ${a.enabled ? 'checked' : ''} aria-label="Include ${a.name}" /> ${a.name}</h3><span class="pg-mono">limit ${a.limit === Infinity ? '∞' : '$' + a.limit.toLocaleString()}</span>`;
        d.querySelector('input')!.addEventListener('change', (e) => { a.enabled = (e.target as HTMLInputElement).checked; draw(); });
        w.appendChild(d); if (i < all.length - 1) { const ar = document.createElement('span'); ar.className = 'ch-arrow'; ar.textContent = '→'; w.appendChild(ar); }
      });
    }
    q('[data-send]').addEventListener('click', async () => {
      const id = ++run; const amount = Number(q<HTMLInputElement>('[data-amount]').value) || 0; const head = rebuild(); const out = q('[data-out]'); out.classList.remove('bad');
      if (!head) { out.textContent = 'The chain is empty.'; out.classList.add('bad'); return; }
      const res = head.approve(amount);
      for (const n of res.trail) { if (id !== run) return; draw(n); out.textContent = `${n} looks at $${amount}...`; await wait(STEP_MS); }
      if (id !== run) return;
      draw('', res.by ?? '');
      out.textContent = res.by ? `${res.by} approves $${amount.toLocaleString()}` : `No one can approve $${amount.toLocaleString()} (request fell off the end)`;
      if (!res.by) out.classList.add('bad');
    });
    q('[data-addvp]').addEventListener('click', (e) => { all.splice(1, 0, new Approver('VP', 5000)); (e.currentTarget as HTMLButtonElement).disabled = true; draw(); });
    draw();
  });
</script>
<style is:global>
  .playground .ch-chain { display: flex; flex-wrap: wrap; gap: 8px; align-items: stretch; }
  .playground .ch-chain .pg-box { flex: 1 1 150px; cursor: pointer; }
  .playground .ch-arrow { align-self: center; color: var(--muted); }
</style>
