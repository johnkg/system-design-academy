---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A device family with five clients: a print dialog, scan-to-email, a fax desk, a copy shortcut and a health monitor. Two devices exist today: a basic printer and an office machine. Pick how the interfaces are cut and which change arrives.">
  <ol class="how">
    <li>Start with <b>One fat interface</b> and <b>Add a method: staple</b>: the basic printer must write <b>1</b> new stub, and all <b>5</b> existing clients are affected even though none of them calls staple, because they all depend on the one interface.</li>
    <li>Set <b>Change</b> to <b>New device type: LabelPrinter</b>: the new printer can only print and report status, so it must write <b>7</b> stubs, and the code base now holds <b>12</b> stub methods. The clients see <b>35</b> methods they never call.</li>
    <li>Set <b>Design</b> to <b>Role interfaces by client need</b>: the same device writes <b>2</b> stubs (the roles are cut by client need, and it can do only half of two of them). Set <b>Change</b> to <b>Add a method: staple</b> and <b>0</b> clients are affected. Then set <b>Design</b> to <b>One method per interface</b>: <b>0</b> stubs, but <b>9</b> interfaces to understand, against <b>5</b> for the roles.</li>
  </ol>
  <div class="pg isp" data-isp>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design>
        <option value="fat" selected>One fat interface</option>
        <option value="role">Role interfaces by client need</option>
        <option value="per-method">One method per interface</option>
      </select></label>
      <label>Change <select class="pg-in" data-change>
        <option value="0" selected>Add a method: staple</option>
        <option value="1">New device type: LabelPrinter</option>
        <option value="2">Change print() to take a new parameter</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>New stub methods written</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Existing clients affected</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Devices edited</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Stub methods in the code base</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Unused methods visible to clients</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Interfaces to understand</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The same three changes, three designs</h3>
      <div class="isp-scroll" tabindex="0" role="region" aria-label="Totals for the three designs"><table class="isp-table" data-table>
        <thead><tr><th scope="col">Design</th><th scope="col">Interfaces</th><th scope="col">Stub methods</th><th scope="col">Unused methods seen</th><th scope="col">Client hits</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <span class="pg-note">State after all three changes. Client hits add up the existing clients affected by each change.</span>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="Interfaces in the chosen design, after the chosen change"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type Item = [string, string[]];
  const ROLE_OF: Record<string, string> = { print: 'Printing', setPaper: 'Printing', scan: 'Scanning', scanToEmail: 'Scanning', fax: 'Faxing', faxStatus: 'Faxing', status: 'Admin', reset: 'Admin', staple: 'Finishing' };
  const CLIENTS: Item[] = [
    ['PrintDialog', ['print', 'setPaper']], ['ScanToEmail', ['scan', 'scanToEmail']], ['FaxDesk', ['fax', 'faxStatus']],
    ['CopyShortcut', ['scan', 'print']], ['HealthMonitor', ['status', 'reset']],
  ];
  const START_METHODS = ['print', 'setPaper', 'scan', 'scanToEmail', 'fax', 'faxStatus', 'status', 'reset'];
  const MODES: Record<string, string> = { fat: 'One fat interface', role: 'Role interfaces by client need', 'per-method': 'One method per interface' };

  // The same model as the code samples.
  function interfaces(mode: string, methods: string[]): Item[] {
    if (mode === 'fat') return [['Device', methods.slice()]];
    if (mode === 'per-method') return methods.map((m): Item => ['I' + m[0].toUpperCase() + m.slice(1), [m]]);
    const out: Item[] = [];
    for (const m of methods) {
      let r = out.find((x) => x[0] === ROLE_OF[m]);
      if (!r) { r = [ROLE_OF[m], []]; out.push(r); }
      r[1].push(m);
    }
    return out;
  }
  const overlaps = (a: Item, b: Item) => a[1].some((m) => b[1].includes(m));
  const stubsOf = (d: Item, ifaces: Item[]) => ifaces.filter((i) => overlaps(d, i)).reduce((n, i) => n + i[1].filter((m) => !d[1].includes(m)).length, 0);
  const totalStubs = (devices: Item[], ifaces: Item[]) => devices.reduce((n, d) => n + stubsOf(d, ifaces), 0);
  const noise = (ifaces: Item[]) => CLIENTS.reduce((n, c) => n + ifaces.filter((i) => overlaps(c, i)).reduce((k, i) => k + i[1].filter((m) => !c[1].includes(m)).length, 0), 0);
  const find = (ifaces: Item[], name: string) => ifaces.find((o) => o[0] === name);

  interface Step { newStubs: number; hit: string[]; devicesEdited: number; stubs: number; noise: number; ifaces: Item[] }
  function run(mode: string): Step[] {
    let methods = START_METHODS.slice();
    let devices: Item[] = [['BasicPrinter', ['print', 'setPaper', 'status', 'reset']], ['OfficeMachine', START_METHODS.slice()]];
    let ifaces = interfaces(mode, methods);
    const steps: Step[] = [];
    // A: a new method, staple.
    const beforeA = ifaces, stubsBefore = totalStubs(devices, ifaces);
    methods = methods.concat(['staple']); devices[1][1].push('staple');
    ifaces = interfaces(mode, methods);
    const changed = ifaces.filter((i) => !find(beforeA, i[0]) || find(beforeA, i[0])![1].length !== i[1].length);
    steps.push({
      newStubs: totalStubs(devices, ifaces) - stubsBefore,
      hit: CLIENTS.filter((c) => changed.some((i) => find(beforeA, i[0]) && overlaps(c, find(beforeA, i[0])!))).map((c) => c[0]),
      devicesEdited: devices.filter((d) => changed.some((i) => overlaps(d, i))).length,
      stubs: totalStubs(devices, ifaces), noise: noise(ifaces), ifaces,
    });
    // B: a new device type.
    const label: Item = ['LabelPrinter', ['print', 'status']];
    devices = devices.concat([label]);
    steps.push({ newStubs: stubsOf(label, ifaces), hit: [], devicesEdited: 1, stubs: totalStubs(devices, ifaces), noise: noise(ifaces), ifaces });
    // C: print() changes.
    const printIface = ifaces.find((i) => i[1].includes('print'))!;
    steps.push({
      newStubs: 0, hit: CLIENTS.filter((c) => overlaps(c, printIface)).map((c) => c[0]),
      devicesEdited: devices.filter((d) => overlaps(d, printIface)).length, stubs: totalStubs(devices, ifaces), noise: noise(ifaces), ifaces,
    });
    return steps;
  }

  document.querySelectorAll<HTMLElement>('[data-isp]').forEach((root) => {
    const q = query(root);
    const tbody = q('[data-table] tbody');
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const mode = q<HTMLSelectElement>('[data-design]').value;
      const ci = Number(q<HTMLSelectElement>('[data-change]').value);
      const s = run(mode)[ci];
      set(1, String(s.newStubs), s.newStubs === 0 ? 'no device is forced to implement a method it cannot do' : 'methods that throw or do nothing, written only to satisfy an interface');
      box(1, s.newStubs === 0);
      set(2, String(s.hit.length), s.hit.length === 0 ? 'no existing client recompiles or retests' : s.hit.join(', '));
      box(2, s.hit.length <= 2);
      set(3, String(s.devicesEdited), 'devices that implement an interface that changed, or the new device');
      box(3, s.devicesEdited <= 1);
      set(4, String(s.stubs), 'in all devices, after this change and the ones before it');
      box(4, s.stubs <= 2);
      set(5, String(s.noise), 'methods clients can see through their interfaces but never call');
      box(5, s.noise <= 2);
      set(6, String(s.ifaces.length), `${MODES[mode]}, ${ci === 0 ? 'with staple added' : 'with staple in'}`);
      box(6, s.ifaces.length <= 6);
      tbody.textContent = '';
      for (const m of Object.keys(MODES)) {
        const all = run(m), last = all[2];
        const hits = all.reduce((n, x) => n + x.hit.length, 0);
        const tr = document.createElement('tr'); if (m === mode) tr.className = 'sel';
        [MODES[m], String(last.ifaces.length), String(last.stubs), String(last.noise), String(hits)].forEach((text, k) => {
          const cell = document.createElement(k === 0 ? 'th' : 'td'); if (k === 0) cell.setAttribute('scope', 'row'); cell.textContent = text; tr.appendChild(cell);
        });
        tbody.appendChild(tr);
      }
      const log = q('[data-log]'); log.textContent = '';
      for (const i of s.ifaces) { const li = document.createElement('li'); li.textContent = `${i[0]}: ${i[1].join(', ')}`; log.appendChild(li); }
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .isp-scroll { overflow-x: auto; }
  .playground .isp-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .isp-table th, .playground .isp-table td { padding: 5px 8px; border-bottom: 1px solid var(--border); text-align: left; }
  .playground .isp-table tr.sel { background: var(--accent-soft); font-weight: 600; }
</style>
