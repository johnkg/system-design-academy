---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A client function is written against a base type's contract. Pick a substitute and the client runs its checks on it, live: the language accepts every subtype, but only some of them keep the promises the client relies on.">
  <ol class="how">
    <li>Start with <b>Bag contract: ListBag (honest)</b>: the writer client runs 5 checks and <b>5/5 checks pass</b>. That is what a good substitute looks like.</li>
    <li>Set <b>Substitute</b> to <b>Bag contract: DedupBag</b>: it compiles and runs, but adding 5 twice gives a size of 1, so only <b>3/5 checks pass</b> (a weakened postcondition). Try <b>PositiveBag</b> for a strengthened precondition (<b>4/5</b>) and <b>ReadOnlyBag</b> for the extreme: add throws, and <b>0/5</b> pass.</li>
    <li>Set <b>Substitute</b> to <b>Rectangle contract: InheritedSquare</b>: setting the height also changes the width, so the area is 16 instead of 20 and only <b>1/3 checks pass</b>. Then try <b>ReadOnlyView</b> or <b>SquareShape</b>, built by composition: they never claim to be a Bag or a Rectangle, so the client that needs the wider contract cannot be given one, and the clients that need less pass in full.</li>
  </ol>
  <div class="pg lsp" data-lsp>
    <div class="pg-row">
      <label>Substitute <select class="pg-in" data-sub></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Checks passed</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Contract rule broken</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>How it was built</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Contract in force</h3>
      <span class="pg-note" data-contract></span>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="What each check of the client found"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  // The same model as the code samples: real classes, and a client whose checks run against them.
  abstract class Bag {
    abstract add(x: number): void; abstract remove(x: number): void; abstract contains(x: number): boolean; abstract size(): number;
  }
  class ListBag extends Bag {
    items: number[];
    constructor(items: number[]) { super(); this.items = items.slice(); }
    add(x: number) { this.items.push(x); }
    remove(x: number) { const i = this.items.indexOf(x); if (i >= 0) this.items.splice(i, 1); }
    contains(x: number) { return this.items.includes(x); }
    size() { return this.items.length; }
  }
  class DedupBag extends ListBag { add(x: number) { if (!this.items.includes(x)) super.add(x); } }
  class PositiveBag extends ListBag { add(x: number) { if (x <= 0) throw new Error('only positive numbers'); super.add(x); } }
  class ReadOnlyBag extends ListBag { add(_x: number) { throw new Error('read-only: add is not allowed'); } }
  class ReadOnlyView {
    items: number[];
    constructor(items: number[]) { this.items = items.slice(); }
    contains(x: number) { return this.items.includes(x); }
    size() { return this.items.length; }
  }
  class Rectangle {
    constructor(protected w: number, protected h: number) {}
    setWidth(w: number) { this.w = w; }
    setHeight(h: number) { this.h = h; }
    width() { return this.w; }
    area() { return this.w * this.h; }
  }
  class InheritedSquare extends Rectangle {
    constructor(s: number) { super(s, s); }
    setWidth(w: number) { this.w = w; this.h = w; }
    setHeight(h: number) { this.w = h; this.h = h; }
  }
  class SquareShape { constructor(private s: number) {} area() { return this.s * this.s; } }

  const attempt = (fn: () => string | null) => { try { return fn(); } catch (e) { return `threw '${(e as Error).message}'`; } };
  const expectEq = (got: unknown, want: unknown) => (String(got) === String(want) ? null : `got ${got}, expected ${want}`);
  type Check = [string, (o: any) => string | null];
  const WRITER: Check[] = [
    ['C1 add accepts any integer, even -1', (b) => { b.add(-1); return null; }],
    ['C2 after add(5), contains(5)', (b) => { b.add(5); return expectEq(b.contains(5), true); }],
    ['C3 two adds of 5 make size 2', (b) => { b.add(5); b.add(5); return expectEq(b.size(), 2); }],
    ['C4 add(5) then remove(5) leaves it empty', (b) => { b.add(5); b.remove(5); return expectEq(`${b.size()} ${b.contains(5)}`, '0 false'); }],
    ['C5 size is adds minus removes (3 adds, 1 remove)', (b) => { b.add(1); b.add(1); b.add(2); b.remove(1); return expectEq(b.size(), 2); }],
  ];
  const READER: Check[] = [
    ['R1 contains what it was built with', (r) => expectEq(`${r.contains(3)} ${r.contains(9)}`, 'true false')],
    ['R2 size is the number of items', (r) => expectEq(r.size(), 2)],
  ];
  const RECT: Check[] = [
    ['Q1 setWidth(5), setHeight(4): area is 20', (r) => { r.setWidth(5); r.setHeight(4); return expectEq(r.area(), 20); }],
    ['Q2 setHeight(4) leaves the width at 5', (r) => { r.setWidth(5); r.setHeight(4); return expectEq(r.width(), 5); }],
    ['Q3 setWidth(3) reads back as 3', (r) => { r.setWidth(3); return expectEq(r.width(), 3); }],
  ];
  const SHAPE: Check[] = [['S1 a shape with sides of 3 has area 9', (s) => expectEq(s.area(), 9)]];

  interface Client { title: string; checks: Check[]; make: () => object; needs?: [Function, string] }
  interface Sub { group: string; label: string; contract: string; broken: string; why: string; built: string; builtNote: string; clients: Client[] }
  const bagWriter = (make: () => object): Client => ({ title: 'Writer client (needs a Bag)', checks: WRITER, make, needs: [Bag, 'Bag'] });
  const SUBS: Sub[] = [
    { group: 'Bag contract', label: 'ListBag (honest)', contract: 'add accepts any integer; after add(x), contains(x) is true and size grew by 1; remove takes one x out; size is adds minus removes.',
      broken: 'none', why: 'it keeps every promise the base type makes', built: 'Implements Bag directly', builtNote: 'nothing to fix', clients: [bagWriter(() => new ListBag([]))] },
    { group: 'Bag contract', label: 'DedupBag', contract: 'add accepts any integer; after add(x), contains(x) is true and size grew by 1; remove takes one x out; size is adds minus removes.',
      broken: 'postcondition weakened', why: 'add of a value already held no longer grows the size', built: 'Inherits ListBag to reuse its code', builtNote: 'if it is a set, make it a Set type with its own contract', clients: [bagWriter(() => new DedupBag([]))] },
    { group: 'Bag contract', label: 'PositiveBag', contract: 'add accepts any integer; after add(x), contains(x) is true and size grew by 1; remove takes one x out; size is adds minus removes.',
      broken: 'precondition strengthened', why: 'add rejects values the base type accepts', built: 'Inherits ListBag to reuse its code', builtNote: 'make the restriction part of the contract of a separate type', clients: [bagWriter(() => new PositiveBag([]))] },
    { group: 'Bag contract', label: 'ReadOnlyBag', contract: 'add accepts any integer; after add(x), contains(x) is true and size grew by 1; remove takes one x out; size is adds minus removes.',
      broken: 'precondition strengthened to never', why: 'add always throws, so no write check can pass', built: 'Inherits ListBag, then switches the writes off', builtNote: 'use ReadOnlyView: reading only, no add to break',
      clients: [bagWriter(() => new ReadOnlyBag([])), { title: 'Reader client (needs only reading)', checks: READER, make: () => new ReadOnlyBag([3, 4]) }] },
    { group: 'Bag contract', label: 'ReadOnlyView', contract: 'add accepts any integer; after add(x), contains(x) is true and size grew by 1; remove takes one x out; size is adds minus removes.',
      broken: 'none: it makes no promise about writing', why: 'it does not claim to be a Bag, so the writer client never receives it', built: 'Composition: holds a list, offers only reading', builtNote: 'the fix by composition',
      clients: [bagWriter(() => new ReadOnlyView([])), { title: 'Reader client (needs only reading)', checks: READER, make: () => new ReadOnlyView([3, 4]) }] },
    { group: 'Rectangle contract', label: 'Rectangle (honest)', contract: 'setWidth and setHeight change only their own side; area is width times height.',
      broken: 'none', why: 'it keeps every promise the base type makes', built: 'Implements Rectangle directly', builtNote: 'nothing to fix', clients: [{ title: 'Client of Rectangle', checks: RECT, make: () => new Rectangle(1, 1), needs: [Rectangle, 'Rectangle'] }] },
    { group: 'Rectangle contract', label: 'InheritedSquare', contract: 'setWidth and setHeight change only their own side; area is width times height.',
      broken: 'postcondition weakened', why: 'the setters change both sides, so a client that sets width then height gets the wrong area', built: 'Inherits Rectangle because a square is a rectangle', builtNote: 'a square is a rectangle in geometry, but its mutable behaviour differs',
      clients: [{ title: 'Client of Rectangle', checks: RECT, make: () => new InheritedSquare(1), needs: [Rectangle, 'Rectangle'] }, { title: 'Client that only asks for the area', checks: SHAPE, make: () => new InheritedSquare(3) }] },
    { group: 'Rectangle contract', label: 'SquareShape', contract: 'setWidth and setHeight change only their own side; area is width times height.',
      broken: 'none: it makes no promise about setters', why: 'it does not claim to be a Rectangle, so the Rectangle client never receives it', built: 'Composition: a side and an area', builtNote: 'the fix by composition',
      clients: [{ title: 'Client of Rectangle', checks: RECT, make: () => new SquareShape(1), needs: [Rectangle, 'Rectangle'] }, { title: 'Client that only asks for the area', checks: SHAPE, make: () => new SquareShape(3) }] },
  ];

  document.querySelectorAll<HTMLElement>('[data-lsp]').forEach((root) => {
    const q = query(root);
    const sel = q<HTMLSelectElement>('[data-sub]');
    const groups: Record<string, HTMLOptGroupElement> = {};
    SUBS.forEach((s, i) => {
      if (!groups[s.group]) { const g = document.createElement('optgroup'); g.label = s.group; sel.appendChild(g); groups[s.group] = g; }
      const o = document.createElement('option'); o.value = String(i); o.textContent = `${s.group}: ${s.label}`; groups[s.group].appendChild(o);
    });
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const s = SUBS[Number(sel.value)];
      const log = q('[data-log]'); log.textContent = '';
      const add = (text: string) => { const li = document.createElement('li'); li.textContent = text; log.appendChild(li); };
      const results: string[] = [];
      for (const c of s.clients) {
        add(`-- ${c.title}`);
        if (c.needs && !(c.make() instanceof (c.needs[0] as any))) { add(`rejected: not a ${c.needs[1]}, so this client cannot be given one`); results.push('rejected'); continue; }
        let pass = 0;
        for (const [label, check] of c.checks) {
          const why = attempt(() => check(c.make()));
          if (why === null) pass++;
          add(`${label}: ${why === null ? 'pass' : `FAIL, ${why}`}`);
        }
        add(`${pass}/${c.checks.length} checks pass`);
        results.push(`${pass}/${c.checks.length} checks pass`);
      }
      const first = s.clients[0];
      set(1, results[0] === 'rejected' ? 'not accepted' : results[0], results[0] === 'rejected'
        ? `the ${first.title.toLowerCase()} cannot be given this type; the clients that need less run: ${results.slice(1).join(', ')}`
        : results.length > 1 ? `${first.title}. ${s.clients[1].title}: ${results[1]}` : first.title);
      box(1, results.every((r) => r === 'rejected' || r.split('/')[0] === r.split('/')[1].split(' ')[0]));
      set(2, s.broken, s.why);
      box(2, s.broken.startsWith('none'));
      set(3, s.built, s.builtNote);
      box(3, s.built.startsWith('Composition') || s.built.startsWith('Implements'));
      q('[data-contract]').textContent = s.contract;
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
