---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Mix any remote with any device. Count the classes you would have needed.">
  <ol class="how">
    <li>Choose a <b>remote</b> and a <b>device</b>. They are independent.</li>
    <li>Press the remote's buttons and watch the device respond.</li>
    <li>Press <b>+ Add Speaker</b>. It works with both remotes at once, with no remote changes.</li>
  </ol>
  <div class="pg" data-bridge>
    <div class="pg-row"><span>Remote:</span><span class="pg-row" role="group" aria-label="Remote" data-remotes></span></div>
    <div class="pg-row"><span>Device:</span><span class="pg-row" role="group" aria-label="Device" data-devices></span></div>
    <div class="pg-row" data-buttons></div>
    <div class="pg-box" style="--c: var(--role-4)" data-panel></div>
    <p class="pg-note" data-count></p>
    <div class="pg-row"><button class="btn" type="button" data-add>+ Add Speaker</button></div>
  </div>
</PlaygroundShell>
<script>
  class Device { on = false; constructor(public name: string, public volume: number) {} }
  class Remote {
    constructor(public device: Device) {}
    togglePower() { this.device.on = !this.device.on; }
    volumeUp() { this.device.volume = Math.min(100, this.device.volume + 10); }
    volumeDown() { this.device.volume = Math.max(0, this.device.volume - 10); }
  }
  class AdvancedRemote extends Remote { mute() { this.device.volume = 0; } }
  document.querySelectorAll<HTMLElement>('[data-bridge]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const devices = [new Device('TV', 30), new Device('Radio', 10)];
    let kind: 'Basic' | 'Advanced' = 'Basic';
    let cur = devices[0];
    const remote = () => (kind === 'Basic' ? new Remote(cur) : new AdvancedRemote(cur));
    function chips() {
      const mk = (host: HTMLElement, items: string[], active: string, on: (v: string) => void) => {
        host.innerHTML = ''; items.forEach((i) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = i; b.setAttribute('aria-pressed', String(i === active)); b.addEventListener('click', () => on(i)); host.appendChild(b); });
      };
      mk(q('[data-remotes]'), ['Basic', 'Advanced'], kind, (v) => { kind = v as 'Basic' | 'Advanced'; draw(); });
      mk(q('[data-devices]'), devices.map((d) => d.name), cur.name, (v) => { cur = devices.find((d) => d.name === v)!; draw(); });
    }
    function draw() {
      chips();
      const r = remote(); const row = q('[data-buttons]'); row.innerHTML = '';
      const add = (label: string, fn: () => void) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn pg-primary'; b.textContent = label; b.addEventListener('click', () => { fn(); draw(); }); row.appendChild(b); };
      add('Power', () => r.togglePower()); add('Vol +', () => r.volumeUp()); add('Vol −', () => r.volumeDown());
      if (r instanceof AdvancedRemote) add('Mute', () => (r as AdvancedRemote).mute());
      q('[data-panel]').innerHTML = `<h3>${cur.name} <span class="pg-note">(driven by ${kind}Remote)</span></h3><span class="pg-mono">${cur.on ? 'ON' : 'off'} · volume ${cur.volume} ${'▮'.repeat(Math.round(cur.volume / 10))}</span>`;
      const withBridge = 2 + devices.length, without = 2 * devices.length;
      q('[data-count]').textContent = `Classes with Bridge: 2 remotes + ${devices.length} devices = ${withBridge}. Without it: ${without} pair classes.`;
    }
    q('[data-add]').addEventListener('click', (e) => { devices.push(new Device('Speaker', 20)); cur = devices[2]; (e.currentTarget as HTMLButtonElement).disabled = true; draw(); });
    draw();
  });
</script>
