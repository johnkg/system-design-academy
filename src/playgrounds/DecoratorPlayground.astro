---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Build a drink by wrapping layers. Each layer is a real decorator object.">
  <ol class="how">
    <li>Press add-ons to <b>wrap</b> the drink in another layer. You can repeat one (double mocha).</li>
    <li>Watch the <b>nested layers</b>, the code expression and the running price.</li>
    <li><b>Unwrap</b> removes the outermost layer.</li>
  </ol>
  <div data-decorator-demo class="d-demo">
    <div class="d-row" data-buttons></div>
    <div class="d-stage" data-stage aria-label="Layers of the drink"></div>
    <pre class="d-code" data-code></pre>
    <div class="d-summary" aria-live="polite"><span data-desc></span><b data-cost></b></div>
    <div class="d-row"><button class="btn" type="button" data-undo>Unwrap last</button><button class="btn" type="button" data-reset>Start over</button></div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  interface Beverage { description(): string; cost(): number }
  class Espresso implements Beverage { description() { return 'Espresso'; } cost() { return 2; } }
  class AddOn implements Beverage {
    constructor(public readonly inner: Beverage, public readonly label: string, private price: number) {}
    description() { return `${this.inner.description()}, ${this.label.toLowerCase()}`; }
    cost() { return this.inner.cost() + this.price; }
  }
  const catalog = [
    { name: 'Milk', price: 0.5 }, { name: 'Mocha', price: 0.7 }, { name: 'Whip', price: 0.4 }, { name: 'Caramel', price: 0.6 },
  ];

  document.querySelectorAll<HTMLElement>('[data-decorator-demo]').forEach((root) => {
    const q = query(root);
    let drink: Beverage = new Espresso();
    const stack: AddOn[] = []; // so we can unwrap

    function layers(b: Beverage): HTMLElement {
      const box = document.createElement('div');
      if (b instanceof AddOn) {
        box.className = 'd-layer';
        const tag = document.createElement('span');
        tag.textContent = `${b.label} (+$${(b.cost() - b.inner.cost()).toFixed(2)})`;
        box.append(tag, layers(b.inner));
      } else {
        box.className = 'd-core';
        box.textContent = '☕ Espresso ($2.00)';
      }
      return box;
    }
    function render(grew = false) {
      const stage = q('[data-stage]');
      stage.replaceChildren(layers(drink));
      if (grew) stage.firstElementChild!.classList.add('d-new');
      q('[data-code]').textContent = stack.reduce((expr, a) => `new ${a.label}(${expr})`, 'new Espresso()');
      q('[data-desc]').textContent = drink.description();
      q('[data-cost]').textContent = `$${drink.cost().toFixed(2)}`;
      q<HTMLButtonElement>('[data-undo]').disabled = stack.length === 0;
    }
    const buttons = q('[data-buttons]');
    catalog.forEach((c) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'btn'; b.textContent = `+ ${c.name} ($${c.price.toFixed(2)})`;
      b.addEventListener('click', () => { const a = new AddOn(drink, c.name, c.price); stack.push(a); drink = a; render(true); });
      buttons.appendChild(b);
    });
    q('[data-undo]').addEventListener('click', () => { const a = stack.pop(); if (a) { drink = a.inner; render(); } });
    q('[data-reset]').addEventListener('click', () => { stack.length = 0; drink = new Espresso(); render(); });
    render();
  });
</script>
<style is:global>
  .playground .d-demo { display: grid; gap: 12px; }
  .playground .d-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .playground .d-stage { display: grid; }
  .playground .d-layer { border: 2px solid var(--role-3); border-radius: 12px; padding: 8px 10px 10px; background: color-mix(in srgb, var(--role-3) 8%, var(--surface)); display: grid; gap: 6px; }
  .playground .d-layer > span { font-size: .8rem; font-weight: 600; color: var(--text); }
  .playground .d-layer .d-layer { border-color: var(--role-4); background: color-mix(in srgb, var(--role-4) 8%, var(--surface)); }
  .playground .d-layer .d-layer > span { color: var(--text); }
  .playground .d-layer .d-layer .d-layer { border-color: var(--role-1); background: color-mix(in srgb, var(--role-1) 8%, var(--surface)); }
  .playground .d-layer .d-layer .d-layer > span { color: var(--text); }
  .playground .d-layer .d-layer .d-layer .d-layer { border-color: var(--role-2); background: color-mix(in srgb, var(--role-2) 8%, var(--surface)); }
  .playground .d-layer .d-layer .d-layer .d-layer > span { color: var(--text); }
  .playground .d-core { border: 2px solid var(--role-2); border-radius: 10px; padding: 10px; background: var(--surface); font-weight: 600; text-align: center; }
  .playground .d-new { animation: d-pop .45s ease-out; }
  .playground .d-code { margin: 0; padding: 10px 12px; border-radius: 8px; background: var(--surface-2); font: .82rem var(--font-mono); overflow-x: auto; white-space: pre-wrap; overflow-wrap: anywhere; }
  .playground .d-summary { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; padding: 10px 12px; border-radius: 10px; background: var(--accent-soft); }
  .playground .d-summary b { font-size: 1.4rem; color: var(--accent); }
  @keyframes d-pop { from { transform: scale(.92); opacity: .4; } }
</style>
