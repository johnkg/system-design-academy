---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A checkout makes several writes and one of them can fail. Choose whether each write is saved at once or collected in a unit of work, then see what is left behind.">
  <ol class="how">
    <li>Start with the defaults: <b>Writes</b> at <b>4</b>, <b>Fails at write</b> at <b>3</b> and <b>Design</b> <b>Write immediately</b>. After the failure <b>2</b> records stay changed, a half-finished checkout, and <b>4</b> transactions were opened.</li>
    <li>Set <b>Design</b> to <b>Unit of work</b>: <b>0</b> records stay changed and only <b>1</b> transaction is opened.</li>
    <li>Set <b>Fails at write</b> to <b>8</b>. Nothing fails, because there are only <b>4</b> writes, and both designs save all <b>4</b> records.</li>
  </ol>
  <div class="pg uow" data-uow>
    <div class="pg-row">
      <label>Writes <input class="pg-in" type="range" min="2" max="8" step="1" value="4" data-w /> <b data-wv></b></label>
      <label>Fails at write <input class="pg-in" type="range" min="1" max="8" step="1" value="3" data-f /> <b data-fv></b></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Write immediately</option><option value="1">Unit of work</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Records changed afterwards</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Transactions opened</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Half-finished state</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // The same model as the code samples: a failed write either leaves the earlier writes behind or is rolled back with them.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-uow]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const writes = Number(q<HTMLInputElement>('[data-w]').value), failAt = Number(q<HTMLInputElement>('[data-f]').value);
      const unit = q<HTMLSelectElement>('[data-design]').value === '1';
      q('[data-wv]').textContent = String(writes); q('[data-fv]').textContent = String(failAt);
      const fails = failAt <= writes;
      const changed = fails ? (unit ? 0 : failAt - 1) : writes;
      const transactions = unit ? 1 : writes;
      const half = fails && changed > 0;
      setBox(1, String(changed), fails ? (unit ? 'the failure undid every write' : `writes 1 to ${failAt - 1} were already saved`) : 'no failure, so every write was saved', half ? 'bad' : 'good');
      setBox(2, String(transactions), unit ? 'one transaction for the whole action' : 'each write is its own transaction', unit ? 'good' : 'bad');
      setBox(3, half ? 'Yes' : 'No', half ? 'some changes are saved and the rest are missing' : 'the data is either all changed or all unchanged', half ? 'bad' : 'good');
      q('[data-verdict]').textContent = unit
        ? 'The unit of work remembers the changes and saves them together in commit(). A failed write restores the earlier state.'
        : 'Each change is saved the moment it is made, so a later failure leaves the earlier changes behind.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
