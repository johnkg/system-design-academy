---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A bank account stored only as events. The balance is always computed by replaying them.">
  <ol class="how">
    <li>Press <b>Deposit</b> and <b>Withdraw</b> a few times. Each action appends an event. Try <b>Withdraw 500</b>: it is rejected and nothing is recorded.</li>
    <li>Drag the <b>time travel</b> slider to see the balance at any earlier point.</li>
    <li>Press <b>Undo last</b>: history is not edited, a reversing event is appended. Compare the <b>replay cost</b> with and without snapshots.</li>
  </ol>
  <div class="pg" data-es>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-dep>Deposit 50</button>
      <button class="btn pg-primary" type="button" data-wd>Withdraw 30</button>
      <button class="btn" type="button" data-wd500>Withdraw 500</button>
      <button class="btn" type="button" data-undo>Undo last</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-3)"><h3>Event store (append-only)</h3><ol class="pg-log es-log" data-events aria-label="Events"></ol></div>
      <div class="pg-box" style="--c: var(--role-2)"><h3>Derived state</h3>
        <span class="pg-mono" data-now></span>
        <label>Time travel: state after event <b data-v></b> <input type="range" min="0" max="0" value="0" data-time /></label>
        <span class="pg-mono" data-then></span>
        <span class="pg-row" role="group" aria-label="Snapshot interval" data-snaps></span>
        <span class="pg-mono" data-cost></span>
      </div>
    </div>
    <output class="pg-out" data-out aria-live="polite">Start with a deposit.</output>
  </div>
</PlaygroundShell>
<script>
  interface Ev { type: 'Deposited' | 'Withdrawn'; amount: number; reversal?: boolean }
  document.querySelectorAll<HTMLElement>('[data-es]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let events: Ev[] = []; let snapEvery = 0;
    const fold = (list: Ev[]) => list.reduce((b, e) => b + (e.type === 'Deposited' ? e.amount : -e.amount), 0);
    const say = (t: string, bad = false) => { const o = q('[data-out]'); o.textContent = t; o.classList.toggle('bad', bad); };
    function draw() {
      const n = events.length; const t = q<HTMLInputElement>('[data-time]');
      const keep = Math.min(Number(t.value), n); t.max = String(n); t.value = String(t.dataset.follow === '1' || keep > n ? n : keep);
      const at = Number(t.value);
      q('[data-events]').innerHTML = n ? events.map((e, i) => `<li class="${i < at ? '' : 'es-future'}">${i + 1}. ${e.type} ${e.amount}${e.reversal ? ' (reversal)' : ''}</li>`).join('') : '<li class="pg-note">no events yet</li>';
      q('[data-now]').textContent = `current balance = ${fold(events)} (replay of ${n} events)`;
      q('[data-v]').textContent = String(at); q('[data-then]').textContent = `balance after event ${at} = ${fold(events.slice(0, at))}`;
      const base = snapEvery ? Math.floor(n / snapEvery) * snapEvery : 0;
      q('[data-cost]').textContent = `events replayed to load now: ${n - base}${snapEvery ? ` (snapshot at event ${base || '—'})` : ' (no snapshots)'}`;
      q('[data-snaps]').querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(Number((b as HTMLElement).dataset.k) === snapEvery)));
      q<HTMLElement>('[data-undo]').setAttribute('aria-disabled', String(!events.some((e) => !e.reversal)));
    }
    function add(ev: Ev, msg: string) { const t = q<HTMLInputElement>('[data-time]'); t.dataset.follow = '1'; events.push(ev); draw(); t.dataset.follow = '0'; say(msg); }
    q('[data-dep]').addEventListener('click', () => add({ type: 'Deposited', amount: 50 }, 'Event appended: Deposited 50.'));
    q('[data-wd]').addEventListener('click', () => { if (fold(events) < 30) { say('Rejected: insufficient funds. No event was recorded.', true); return; } add({ type: 'Withdrawn', amount: 30 }, 'Event appended: Withdrawn 30.'); });
    q('[data-wd500]').addEventListener('click', () => { if (fold(events) < 500) { say('Rejected: insufficient funds (balance is ' + fold(events) + '). The command broke a rule, so no event was recorded.', true); return; } add({ type: 'Withdrawn', amount: 500 }, 'Event appended.'); });
    q('[data-undo]').addEventListener('click', () => {
      const idx = events.map((e) => !e.reversal).lastIndexOf(true); if (idx < 0) return; const last = events[idx];
      add({ type: last.type === 'Deposited' ? 'Withdrawn' : 'Deposited', amount: last.amount, reversal: true }, `History is never edited. A reversing event was appended to cancel event ${idx + 1}.`);
    });
    q('[data-reset]').addEventListener('click', () => { events = []; q<HTMLInputElement>('[data-time]').value = '0'; draw(); say('Start with a deposit.'); });
    q('[data-time]').addEventListener('input', draw);
    [0, 3, 5].forEach((k) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.dataset.k = String(k); b.textContent = k ? `Snapshot every ${k}` : 'No snapshots'; b.addEventListener('click', () => { snapEvery = k; draw(); }); q('[data-snaps]').appendChild(b); });
    draw();
  });
</script>
<style is:global>
  .playground .es-log { max-height: 240px; }
  .playground .es-log .es-future { color: var(--muted); text-decoration: line-through; }
</style>
