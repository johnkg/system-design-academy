---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Two replicas, a network you can cut, and a choice: stay consistent or stay available.">
  <ol class="how">
    <li>Choose <b>AP</b> or <b>CP</b>, then press <b>Cut the network</b>.</li>
    <li>Try to <b>write</b> on each node and <b>read</b> from each node. See what the system gives up.</li>
    <li>In AP, write on both sides, then <b>Heal the network</b> and see which write is lost.</li>
  </ol>
  <div class="pg" data-cap>
    <div class="pg-row">
      <span role="group" aria-label="Behaviour during a partition" class="pg-row">
        <button class="btn" type="button" data-mode="ap" aria-pressed="true">AP: stay available</button>
        <button class="btn" type="button" data-mode="cp" aria-pressed="false">CP: stay consistent</button>
      </span>
      <button class="btn pg-primary" type="button" data-cut>Cut the network</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="cp-link" data-link></div>
    <div class="pg-grid" data-nodes></div>
    <div class="pg-row" data-actions></div>
    <output class="pg-out" data-out aria-live="polite">Both nodes hold x = 1.</output>
  </div>
</PlaygroundShell>
<script>
  interface Node { name: string; value: number; ts: number }
  document.querySelectorAll<HTMLElement>('[data-cap]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let a: Node, b: Node; let partition = false; let cp = false; let clock = 1; let counter = 1;
    let lastWrite: { node: string; value: number; ts: number }[] = [];
    const cards: { box: HTMLElement; title: HTMLElement; body: HTMLElement }[] = [];
    const say = (t: string, bad = false) => { const o = q('[data-out]'); o.textContent = t; o.classList.toggle('bad', bad); };
    const nodes = () => [a, b];

    function reset() { a = { name: 'Node A', value: 1, ts: 1 }; b = { name: 'Node B', value: 1, ts: 1 }; partition = false; clock = 1; counter = 1; lastWrite = []; draw(); say('Both nodes hold x = 1.'); }
    function draw() {
      nodes().forEach((n, i) => { const c = cards[i]; c.title.textContent = n.name; c.body.textContent = `x = ${n.value}  (write #${n.ts})`; c.box.style.setProperty('--c', a.value !== b.value ? 'var(--role-4)' : 'var(--role-3)'); });
      q('[data-link]').textContent = partition ? 'Network: PARTITIONED. The nodes cannot talk to each other.' : 'Network: healthy. The nodes replicate to each other.';
      q('[data-link]').classList.toggle('cut', partition);
      q('[data-cut]').textContent = partition ? 'Heal the network' : 'Cut the network';
    }
    function write(i: number) {
      const n = nodes()[i]; const other = nodes()[1 - i]; const v = ++counter;
      if (!partition) { clock++; n.value = other.value = v; n.ts = other.ts = clock; lastWrite = []; say(`${n.name} accepted x = ${v} and replicated it. Both nodes agree.`); }
      else if (cp) { counter--; say(`${n.name} REFUSED the write (error 503): it cannot confirm the other node has it. Consistent, but not available.`, true); }
      else { clock++; n.value = v; n.ts = clock; lastWrite.push({ node: n.name, value: v, ts: clock }); say(`${n.name} accepted x = ${v} locally. The other node does not know yet: the copies now disagree.`); }
      draw();
    }
    function read(i: number) {
      const n = nodes()[i];
      if (partition && cp) { say(`${n.name} REFUSED the read (error 503): it cannot confirm its data is current. Consistent, but not available.`, true); return; }
      const newest = Math.max(...nodes().map((x) => x.ts)); const stale = n.ts < newest;
      say(`${n.name} answered x = ${n.value}${stale ? ' (STALE: the other node holds a newer write)' : ''}.`, stale);
    }
    function toggle() {
      if (!partition) { partition = true; draw(); say('The network is cut. Now every request is a CAP decision.'); return; }
      partition = false;
      if (a.value !== b.value) {
        const winner = a.ts >= b.ts ? a : b; const loser = winner === a ? b : a;
        say(`Healed. The nodes disagreed (${a.name}: x=${a.value}, ${b.name}: x=${b.value}). Last-write-wins keeps x = ${winner.value} and discards ${loser.name}'s x = ${loser.value}: that write is LOST.`, true);
        a.value = b.value = winner.value; a.ts = b.ts = winner.ts;
      } else { say('Healed. The nodes were already in agreement.'); }
      lastWrite = []; draw();
    }
    [0, 1].forEach(() => { const box = document.createElement('div'); box.className = 'pg-box'; box.innerHTML = '<h3></h3><span class="pg-mono"></span>'; q('[data-nodes]').appendChild(box); cards.push({ box, title: box.querySelector('h3')!, body: box.querySelector('span')! }); });
    [['Write on A', () => write(0)], ['Write on B', () => write(1)], ['Read from A', () => read(0)], ['Read from B', () => read(1)]].forEach(([label, fn]) => { const bt = document.createElement('button'); bt.type = 'button'; bt.className = 'btn'; bt.textContent = label as string; bt.addEventListener('click', fn as () => void); q('[data-actions]').appendChild(bt); });
    q('[data-cut]').addEventListener('click', toggle); q('[data-reset]').addEventListener('click', reset);
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((bt) => bt.addEventListener('click', () => { cp = bt.dataset.mode === 'cp'; root.querySelectorAll('[data-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === bt))); reset(); }));
    reset();
  });
</script>
<style is:global>
  .playground .cp-link { padding: 8px 12px; border-radius: 8px; background: color-mix(in srgb, var(--good) 14%, var(--surface)); font-size: .9rem; }
  .playground .cp-link.cut { background: color-mix(in srgb, var(--bad) 16%, var(--surface)); }
</style>
