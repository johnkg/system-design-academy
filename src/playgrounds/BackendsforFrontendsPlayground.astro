---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Several clients show an order. Compare one general API for all of them with a small backend for each client.">
  <ol class="how">
    <li>Start with the defaults: <b>Clients</b> at <b>3</b>, <b>Fields in a full order</b> at <b>12</b>, <b>Fields a phone needs</b> at <b>3</b> and <b>Design</b> <b>One general API</b>. The phone downloads <b>9</b> fields it never shows, <b>3</b> teams must agree to change the API, and there is <b>1</b> backend to run.</li>
    <li>Set <b>Design</b> to <b>A backend per client</b>: <b>0</b> unused fields, <b>1</b> team to agree with, and <b>3</b> backends to run and keep secure.</li>
    <li>Set <b>Clients</b> to <b>6</b>: <b>6</b> backends to run. The price of the pattern grows with every client.</li>
    <li>Set <b>Clients</b> to <b>2</b> and <b>Design</b> to <b>One general API</b>: only <b>2</b> teams must agree. The phone still downloads <b>9</b> unused fields, which matters little when the two clients need nearly the same data.</li>
  </ol>
  <div class="pg bff" data-bff>
    <div class="pg-row">
      <label>Clients <input class="pg-in" type="range" min="2" max="6" step="1" value="3" data-n /> <b data-nv></b></label>
      <label>Fields in a full order <input class="pg-in" type="range" min="4" max="40" step="1" value="12" data-full /> <b data-fullv></b></label>
      <label>Fields a phone needs <input class="pg-in" type="range" min="2" max="12" step="1" value="3" data-phone /> <b data-phonev></b></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>One general API</option><option value="1">A backend per client</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Unused fields the phone downloads</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Teams that must agree to change it</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Backends to run</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // One response for every client, or one small backend for each.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-bff]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    const num = (sel: string) => Number(q<HTMLInputElement>(sel).value);
    function draw() {
      const clients = num('[data-n]'), full = num('[data-full]'), phone = Math.min(num('[data-phone]'), full);
      const bff = q<HTMLSelectElement>('[data-design]').value === '1';
      q('[data-nv]').textContent = String(clients); q('[data-fullv]').textContent = String(full); q('[data-phonev]').textContent = String(phone);
      const unused = bff ? 0 : full - phone, teams = bff ? 1 : clients, backends = bff ? clients : 1;
      setBox(1, String(unused), bff ? 'each backend returns just what its client shows' : `the phone shows ${phone} of the ${full} fields`, unused === 0 ? 'good' : 'bad');
      setBox(2, String(teams), bff ? 'the client team changes its own backend' : 'every client team has a say in the shared response', teams === 1 ? 'good' : 'bad');
      setBox(3, String(backends), bff ? 'each one to build, deploy, secure and monitor' : 'one backend for everybody', backends === 1 ? 'good' : 'mid');
      q('[data-verdict]').textContent = bff
        ? 'Each client gets the data it needs and moves at its own speed. The price is one more backend for every client, and business rules must stay in the shared services.'
        : 'One backend is cheap to run. But the phone pays for fields it never shows, and every change has to be negotiated.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
