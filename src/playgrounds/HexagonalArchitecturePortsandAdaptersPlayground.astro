---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="An order service with three use cases, built four ways. Pick a design and a change to see which files are edited, how much unrelated behaviour sits in them, which tests run again and how much infrastructure the rule tests need.">
  <ol class="how">
    <li>Set <b>Design</b> to <b>Direct calls</b> and <b>Change</b> to <b>Switch payment vendor</b>: <b>3</b> files are edited, with <b>6</b> unrelated behaviours beside the change, and <b>3</b> infrastructure files are needed to test the rule. Set <b>Design</b> to <b>Ports and adapters</b>: only <b>2</b> files are edited, with <b>0</b> unrelated behaviours, and <b>0</b> infrastructure files are needed.</li>
    <li>Set <b>Design</b> to <b>Ports shaped like the vendor</b>: the same vendor switch edits <b>5</b> files, because the port and the use cases read the vendor's own terms.</li>
    <li>Set <b>Design</b> to <b>Everything behind a port</b> and <b>Change</b> to <b>Add a field to an order</b>: <b>7</b> files are edited, in a design of <b>16</b> files.</li>
    <li>Read the table of all four changes. Files edited: <b>12</b> for direct calls, <b>9</b> for ports and adapters, <b>12</b> for vendor-shaped ports, <b>13</b> for everything behind a port. Unrelated behaviour: <b>24</b>, <b>2</b>, <b>7</b> and <b>3</b>. Tests run again: <b>17</b>, <b>18</b>, <b>25</b> and <b>22</b>.</li>
  </ol>
  <div class="pg arc" data-arc>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design>
        <option value="0" selected>Direct calls</option>
        <option value="1">Ports and adapters</option>
        <option value="2">Ports shaped like the vendor</option>
        <option value="3">Everything behind a port</option>
      </select></label>
      <label>Change <select class="pg-in" data-req>
        <option value="0">Swap the database engine</option>
        <option value="1" selected>Switch payment vendor</option>
        <option value="2">Change the free-shipping rule</option>
        <option value="3">Add a field to an order</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Files edited</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Unrelated behaviours in edited files</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Files to test again</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Infrastructure files needed to test the rule</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Files in the design</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The same four changes, four designs</h3>
      <div class="arc-scroll" tabindex="0" role="region" aria-label="Totals for the four designs"><table class="arc-table" data-table>
        <thead><tr><th scope="col">Design</th><th scope="col">Files</th><th scope="col">Files edited</th><th scope="col">Unrelated behaviours</th><th scope="col">Tests run again</th><th scope="col">Infrastructure for rule tests</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <span class="pg-note">Totals over the four changes. Unrelated behaviours are other concerns that live inside a file you had to edit. A file is tested again when it is edited or imports an edited file.</span>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="Files edited per change, for the chosen design"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type File = { name: string; holds: string[]; copies: string[]; imports: string[] };
  const f = (name: string, holds: string[], copies: string[], imports: string[]): File => ({ name, holds, copies, imports });
  const MAIN = ['HttpAdapter', 'SqlAdapter', 'VendorAdapter', 'MailAdapter', 'PlaceOrder', 'CancelOrder', 'OrderReport'];
  const USE = ['PlaceOrder', 'CancelOrder', 'OrderReport'];
  const DESIGNS: { name: string; files: File[] }[] = [
    { name: 'Direct calls', files: [
      f('HttpHandler', ['entry'], ['shape'], USE),
      f('PlaceOrder', ['rule', 'db', 'vendor', 'mail'], ['shape'], ['SqlStore', 'VendorClient', 'MailClient']),
      f('CancelOrder', ['rule', 'db', 'vendor', 'mail'], [], ['SqlStore', 'VendorClient', 'MailClient']),
      f('OrderReport', ['db'], [], ['SqlStore']),
      f('SqlStore', ['db'], ['shape'], []),
      f('VendorClient', ['vendor'], [], []),
      f('MailClient', ['mail'], [], []),
    ] },
    { name: 'Ports and adapters', files: [
      f('HttpAdapter', ['entry'], ['shape'], USE),
      f('PlaceOrder', ['rule'], [], ['Ports', 'Order']),
      f('CancelOrder', ['rule'], [], ['Ports', 'Order']),
      f('OrderReport', [], [], ['Ports']),
      f('Order', [], ['shape'], []),
      f('Ports', ['port'], [], ['Order']),
      f('SqlAdapter', ['db'], ['shape'], ['Ports', 'Order']),
      f('VendorAdapter', ['vendor'], [], ['Ports']),
      f('MailAdapter', ['mail'], [], ['Ports']),
      f('Main', ['wiring'], [], MAIN),
    ] },
    { name: 'Ports shaped like the vendor', files: [
      f('HttpAdapter', ['entry'], ['shape'], USE),
      f('PlaceOrder', ['rule', 'vendor'], [], ['Ports', 'Order']),
      f('CancelOrder', ['rule', 'vendor'], [], ['Ports', 'Order']),
      f('OrderReport', [], [], ['Ports']),
      f('Order', [], ['shape'], []),
      f('Ports', ['port', 'vendor'], [], ['Order']),
      f('SqlAdapter', ['db'], ['shape'], ['Ports', 'Order']),
      f('VendorAdapter', ['vendor'], [], ['Ports']),
      f('MailAdapter', ['mail'], [], ['Ports']),
      f('Main', ['wiring'], [], MAIN),
    ] },
    { name: 'Everything behind a port', files: [
      f('HttpAdapter', ['entry'], ['shape'], ['RequestMapper']),
      f('RequestMapper', [], ['shape'], USE),
      f('PlaceOrder', ['rule'], ['shape'], ['Ports', 'Order']),
      f('CancelOrder', ['rule'], [], ['Ports', 'Order']),
      f('OrderReport', [], [], ['Ports']),
      f('Order', [], ['shape'], []),
      f('Ports', ['port'], [], ['Order']),
      f('ClockPort', [], [], []),
      f('IdPort', [], [], []),
      f('LoggerPort', [], [], []),
      f('PersistenceMapper', [], ['shape'], ['Order', 'PersistenceModel']),
      f('PersistenceModel', [], ['shape'], []),
      f('SqlAdapter', ['db'], ['shape'], ['Ports', 'PersistenceMapper', 'PersistenceModel']),
      f('VendorAdapter', ['vendor'], [], ['Ports']),
      f('MailAdapter', ['mail'], [], ['Ports']),
      f('Main', ['wiring'], [], MAIN),
    ] },
  ];
  const CHANGES: { text: string; touches: string[] }[] = [
    { text: 'Swap the database engine', touches: ['db', 'wiring'] },
    { text: 'Switch payment vendor', touches: ['vendor', 'wiring'] },
    { text: 'Change the free-shipping rule', touches: ['rule'] },
    { text: 'Add a field to an order', touches: ['shape'] },
  ];

  // The same model as the code samples.
  function analyse(files: File[], touches: string[]) {
    const hit = (ts: string[]) => ts.some((t) => touches.includes(t));
    const edited = files.filter((x) => hit(x.holds) || hit(x.copies));
    let bystanders = 0;
    for (const x of edited) for (const t of x.holds) if (!touches.includes(t)) bystanders++;
    const retest = new Set(edited.map((x) => x.name));
    let grew = true;
    while (grew) { // anything that imports a retested file must be retested too
      grew = false;
      for (const x of files) if (!retest.has(x.name) && x.imports.some((c) => retest.has(c))) { retest.add(x.name); grew = true; }
    }
    return { edited: edited.map((x) => x.name), bystanders, retest: retest.size };
  }
  function infraNeeded(files: File[]) {
    const byName = new Map(files.map((x) => [x.name, x]));
    const seen = new Set(['PlaceOrder']);
    const todo = ['PlaceOrder'];
    while (todo.length) for (const i of byName.get(todo.pop()!)!.imports) if (!seen.has(i)) { seen.add(i); todo.push(i); }
    const isInfra = (x: File) => x.holds.some((t) => ['db', 'vendor', 'mail'].includes(t)) && !x.holds.includes('port') && !x.holds.includes('rule');
    return [...seen].filter((n) => isInfra(byName.get(n)!)).length;
  }

  document.querySelectorAll<HTMLElement>('[data-arc]').forEach((root) => {
    const q = query(root);
    const tbody = q('[data-table] tbody');
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const di = Number(q<HTMLSelectElement>('[data-design]').value);
      const ri = Number(q<HTMLSelectElement>('[data-req]').value);
      const d = DESIGNS[di];
      const a = analyse(d.files, CHANGES[ri].touches);
      const infra = infraNeeded(d.files);
      set(1, String(a.edited.length), a.edited.join(', '));
      box(1, a.edited.length <= 2);
      set(2, String(a.bystanders), a.bystanders === 0 ? 'nothing unrelated shares a file with the change' : 'other concerns in the edited files, which this edit can break');
      box(2, a.bystanders <= 1);
      set(3, String(a.retest), 'the edited files plus every file that imports them');
      box(3, a.retest <= 4);
      set(4, String(infra), infra === 0 ? 'the rules run against fakes of the ports' : 'the rules cannot run without these real clients');
      box(4, infra === 0);
      set(5, String(d.files.length), 'every file is something to read, name and keep in step');
      box(5, d.files.length <= 10);
      tbody.textContent = '';
      DESIGNS.forEach((x, i) => {
        let te = 0, tb = 0, tr = 0;
        for (const c of CHANGES) { const s = analyse(x.files, c.touches); te += s.edited.length; tb += s.bystanders; tr += s.retest; }
        const row = document.createElement('tr');
        if (i === di) row.className = 'sel';
        [x.name, String(x.files.length), String(te), String(tb), String(tr), String(infraNeeded(x.files))].forEach((text, k) => {
          const cell = document.createElement(k === 0 ? 'th' : 'td'); if (k === 0) cell.setAttribute('scope', 'row'); cell.textContent = text; row.appendChild(cell);
        });
        tbody.appendChild(row);
      });
      const log = q('[data-log]'); log.textContent = '';
      CHANGES.forEach((c) => {
        const s = analyse(d.files, c.touches);
        const li = document.createElement('li'); li.textContent = `${c.text}: edit ${s.edited.join(', ')}`; log.appendChild(li);
      });
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .arc-scroll { overflow-x: auto; }
  .playground .arc-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .arc-table th, .playground .arc-table td { padding: 5px 8px; border-bottom: 1px solid var(--border); text-align: left; }
  .playground .arc-table tr.sel { background: var(--accent-soft); font-weight: 600; }
</style>
