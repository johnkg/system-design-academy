---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Plant a forest and compare memory with and without sharing.">
  <ol class="how">
    <li>Drag the <b>tree count</b> slider.</li>
    <li>Switch between <b>Flyweight</b> and <b>No sharing</b> and read the memory meter.</li>
    <li>The picture is identical. Only the objects behind it change.</li>
  </ol>
  <div class="pg" data-fly>
    <div class="pg-row">
      <label>Trees <input type="range" min="10" max="5000" step="10" value="1000" data-n /> <b data-nval>1000</b></label>
      <span role="group" aria-label="Mode" class="pg-row">
        <button class="btn" type="button" data-mode="fly" aria-pressed="true">Flyweight</button>
        <button class="btn" type="button" data-mode="plain" aria-pressed="false">No sharing</button>
      </span>
    </div>
    <canvas class="fl-canvas" width="640" height="200" data-canvas aria-label="Forest drawing"></canvas>
    <div class="fl-meter"><div class="fl-bar" data-bar></div></div>
    <p class="pg-mono" data-stats aria-live="polite"></p>
    <p class="pg-note">Model: a species texture is about 2 KB; a tree's own data (x, y, pointer) is about 24 bytes.</p>
  </div>
</PlaygroundShell>
<script>
  const SPECIES = [{ name: 'Oak', color: '#2e8b57' }, { name: 'Pine', color: '#14532d' }, { name: 'Birch', color: '#9acd32' }];
  const TEX = 2048, OWN = 24;
  document.querySelectorAll<HTMLElement>('[data-fly]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let fly = true;
    function rand(seed: number) { return () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296; }
    function draw() {
      const n = Number(q<HTMLInputElement>('[data-n]').value); q('[data-nval]').textContent = String(n);
      const cv = q<HTMLCanvasElement>('[data-canvas]'); const c = cv.getContext('2d')!; c.clearRect(0, 0, cv.width, cv.height);
      const r = rand(7); const cache = new Map<string, number>(); let textures = 0;
      for (let i = 0; i < n; i++) {
        const sp = SPECIES[Math.floor(r() * SPECIES.length)]; const x = r() * cv.width, y = 20 + r() * 170;
        if (fly) { if (!cache.has(sp.name)) { cache.set(sp.name, 1); textures++; } } else textures++;
        c.fillStyle = sp.color; c.beginPath(); c.arc(x, y, 3, 0, 7); c.fill();
      }
      const bytes = textures * TEX + n * OWN; const worst = n * (TEX + OWN);
      q('[data-bar]').style.width = `${Math.max(1.5, (bytes / worst) * 100)}%`;
      q('[data-stats]').textContent = `${n} trees · ${textures} texture objects · ~${(bytes / 1024).toFixed(1)} KB` + (fly ? '' : '  (every tree owns a copy)');
    }
    q('[data-n]').addEventListener('input', draw);
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => { fly = b.dataset.mode === 'fly'; root.querySelectorAll('[data-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b))); draw(); }));
    draw();
  });
</script>
<style is:global>
  .playground .fl-canvas { width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--border); background: color-mix(in srgb, var(--role-3) 10%, var(--surface)); }
  .playground .fl-meter { height: 14px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .playground .fl-bar { height: 100%; background: var(--accent); border-radius: 99px; transition: width .4s ease; }
</style>
