---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Compare the techniques" hint="Choose how many users you have, how often each gets an update, and the polling interval. See what each technique costs. Figures are modelled.">
  <ol class="how">
    <li>With <b>100,000 users</b> and an update every minute each, polling every 2 seconds makes tens of thousands of requests a second, almost all empty, and still delivers updates up to 2 seconds late.</li>
    <li>Long polling, server-sent events and WebSockets deliver in about the time of one network trip, and cost <b>open connections</b> instead of requests.</li>
    <li>Raise the <b>polling interval</b>: requests fall, but updates arrive later. There is no setting that gives both low cost and low delay.</li>
  </ol>
  <div class="pg rt" data-rt>
    <div class="pg-row">
      <label>Users (thousands) <input type="range" min="1" max="1000" value="100" data-users /> <b data-usersval></b></label>
      <label>Updates per user per minute <input type="range" min="0.1" max="10" step="0.1" value="1" data-rate /> <b data-rateval></b></label>
      <label>Polling interval (s) <input type="range" min="1" max="30" value="2" data-interval /> <b data-intervalval></b></label>
    </div>
    <div class="tablewrap" tabindex="0" role="region" aria-label="Cost of each real-time technique, scrolls sideways on narrow screens">
      <table class="rt-table">
        <caption class="sr">Cost of each real-time technique</caption>
        <thead><tr><th scope="col">Technique</th><th scope="col">Requests per second</th><th scope="col">Open connections</th><th scope="col">Average delay</th><th scope="col">Direction</th></tr></thead>
        <tbody data-rows></tbody>
      </table>
    </div>
    <p class="pg-note" data-note aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  import { query, fmt } from '../playground';
  const THOUSAND = 1000; const SEC_PER_MIN = 60; const LONG_POLL_S = 30; // long polls are re-opened every 30 s when idle
  document.querySelectorAll<HTMLElement>('[data-rt]').forEach((root) => {
    const q = query(root);
    const names = ['Short polling', 'Long polling', 'Server-sent events', 'WebSocket'];
    const cells = names.map((n) => { const tr = document.createElement('tr'); tr.innerHTML = '<th scope="row"></th><td></td><td></td><td></td><td></td>'; tr.querySelector('th')!.textContent = n; q('[data-rows]').appendChild(tr); return [...tr.querySelectorAll('td')]; });
    function draw() {
      const U = Number(q<HTMLInputElement>('[data-users]').value) * THOUSAND; const u = Number(q<HTMLInputElement>('[data-rate]').value); const I = Number(q<HTMLInputElement>('[data-interval]').value);
      q('[data-usersval]').textContent = fmt(U / THOUSAND); q('[data-rateval]').textContent = u.toFixed(1); q('[data-intervalval]').textContent = `${I} s`;
      const updatesPerSec = (U * u) / SEC_PER_MIN; const polls = U / I;
      const rows = [
        [fmt(polls), '0', `${(I / 2).toFixed(1)} s`, 'client asks'],
        [fmt(updatesPerSec + U / LONG_POLL_S), fmt(U), '~0.15 s', 'client asks'],
        ['~0 (reconnects only)', fmt(U), '~0.05 s', 'server pushes'],
        ['~0 (reconnects only)', fmt(U), '~0.05 s', 'both ways'],
      ];
      rows.forEach((r, i) => r.forEach((v, k) => (cells[i][k].textContent = v)));
      const empty = Math.max(0, 1 - updatesPerSec / polls) * 100;
      q('[data-note]').textContent = `With short polling, ${empty.toFixed(1)}% of requests find nothing new. Long polling still needs a request per update plus a re-request, and holds a connection per user. Connections cost memory (roughly tens of KB each), so size servers by connections.`;
    }
    root.addEventListener('input', draw); draw();
  });
</script>
<style is:global>
  .playground .tablewrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; margin: 10px 0; }
  .playground .rt-table { width: 100%; border-collapse: collapse; font-size: .9rem; min-width: 560px; }
  .playground .rt-table th, .playground .rt-table td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--border); }
  .playground .rt-table tbody tr:last-child > * { border-bottom: 0; }
  .playground .rt-table thead th { background: var(--surface-2); }
</style>
