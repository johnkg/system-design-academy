---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Uploads are announced through a queue whose messages are limited to 0.25 MB. Compare putting the payload in the message with sending a ticket, and see what the extra storage costs.">
  <ol class="how">
    <li>Start with the defaults: <b>Messages a second</b> at <b>10</b>, <b>Payload</b> <b>20 MB</b>, <b>Consumer crashes</b> at <b>1</b> and <b>Design</b> <b>Payload inside the message</b>. The queue would carry <b>200</b> MB a second, and rejects every message because the limit is <b>0.25</b> MB.</li>
    <li>Set <b>Design</b> to <b>Claim check</b>: the queue carries <b>0.01</b> MB a second and accepts every message. The price is <b>2</b> extra storage calls for each message, and <b>360</b> orphaned blobs an hour.</li>
    <li>Set <b>Consumer crashes</b> to <b>0</b>: <b>0</b> orphaned blobs. In this model every crash after fetching leaves its payload behind. That is true when the message was already acknowledged or is not redelivered; with redelivery, a retry would fetch and delete it.</li>
    <li>Set <b>Payload</b> to <b>0.1 MB</b> with <b>Design</b> on <b>Payload inside the message</b>: it fits the limit, so the extra storage calls of the claim check would buy nothing.</li>
  </ol>
  <div class="pg cc" data-cc>
    <div class="pg-row">
      <label>Messages a second <input class="pg-in" type="range" min="1" max="100" step="1" value="10" data-m /> <b data-mv></b></label>
      <label>Payload <select class="pg-in" data-payload><option value="0.1">0.1 MB</option><option value="0.2">0.2 MB</option><option value="5">5 MB</option><option value="20" selected>20 MB</option></select></label>
      <label>Consumer crashes <input class="pg-in" type="range" min="0" max="10" step="1" value="1" data-c /> <b data-cv></b> %</label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Payload inside the message</option><option value="1">Claim check</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Data the queue carries a second</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Messages the queue accepts</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Extra storage calls per message</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Orphaned blobs an hour</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // A ticket is about a kilobyte. The queue limit is 0.25 MB. A consumer that crashes after fetching leaves its blob behind.
  const TICKET_MB = 0.001, QUEUE_LIMIT_MB = 0.25;
  type Tone = 'good' | 'bad' | 'mid';
  const trim = (n: number) => String(Number(n.toFixed(3)));
  document.querySelectorAll<HTMLElement>('[data-cc]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const perSecond = Number(q<HTMLInputElement>('[data-m]').value), payload = Number(q<HTMLSelectElement>('[data-payload]').value);
      const crash = Number(q<HTMLInputElement>('[data-c]').value);
      const claim = q<HTMLSelectElement>('[data-design]').value === '1';
      q('[data-mv]').textContent = String(perSecond); q('[data-cv]').textContent = String(crash);
      const size = claim ? TICKET_MB : payload;
      const accepted = size <= QUEUE_LIMIT_MB;
      const orphans = claim ? Math.round(perSecond * 3600 * crash / 100) : 0;
      setBox(1, `${trim(perSecond * size)} MB`, claim ? 'only tickets of about 0.001 MB' : `each message holds the whole ${payload} MB payload`, claim || perSecond * size < 5 ? 'good' : 'bad');
      setBox(2, accepted ? 'All' : 'None', accepted ? `each message is ${trim(size)} MB, under the 0.25 MB limit` : `each message is ${trim(size)} MB, over the 0.25 MB limit`, accepted ? 'good' : 'bad');
      setBox(3, claim ? '2' : '0', claim ? 'one put by the producer and one get by the consumer' : 'the data travels in the message itself', claim ? 'mid' : 'good');
      setBox(4, String(orphans), claim ? 'payloads whose consumer crashed before deleting them: needs an expiry rule' : 'there is no separate storage to clean up', orphans === 0 ? 'good' : 'bad');
      q('[data-verdict]').textContent = claim
        ? payload <= QUEUE_LIMIT_MB ? 'This payload would have fitted in the message, so the claim check only adds two storage calls and something to clean up.' : 'The queue stays small and fast. The price is two storage calls per message and a clean-up job for blobs that nobody deleted.'
        : accepted ? 'Small payloads fit in the message, and this is the simplest design.' : 'The payload is bigger than a message may be, so the queue refuses it.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
