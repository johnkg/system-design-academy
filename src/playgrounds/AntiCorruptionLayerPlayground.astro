---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Billing features read data from a legacy CRM, and the CRM's format changes from time to time. Compare reading its records directly with going through a translating layer. The model assumes each CRM change affects every feature that reads the CRM.">
  <ol class="how">
    <li>Start with the defaults: <b>Billing features</b> at <b>5</b>, <b>CRM changes a year</b> at <b>2</b> and <b>Design</b> <b>Read the CRM directly</b>. <b>5</b> files mention the CRM's field names, and a year of changes means <b>10</b> edits.</li>
    <li>Set <b>Design</b> to <b>Anti-corruption layer</b>: <b>1</b> file knows the CRM, and a year of changes means <b>2</b> edits. The price is <b>1</b> extra layer to build, test and run.</li>
    <li>Set <b>Billing features</b> to <b>10</b> with <b>Design</b> on <b>Read the CRM directly</b>: <b>20</b> edits a year. The more code depends on the CRM, the more the layer saves.</li>
    <li>Set <b>Billing features</b> to <b>1</b> and <b>CRM changes a year</b> to <b>0</b>: <b>0</b> edits, so there is nothing for a layer to save.</li>
  </ol>
  <div class="pg acl" data-acl>
    <div class="pg-row">
      <label>Billing features <input class="pg-in" type="range" min="1" max="10" step="1" value="5" data-f /> <b data-fv></b></label>
      <label>CRM changes a year <input class="pg-in" type="range" min="0" max="6" step="1" value="2" data-c /> <b data-cv></b></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Read the CRM directly</option><option value="1">Anti-corruption layer</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Files that mention CRM field names</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Edits caused by CRM changes in a year</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Extra layers to build and run</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // Every billing feature reads CRM fields itself, or only the layer does.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-acl]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const features = Number(q<HTMLInputElement>('[data-f]').value), changes = Number(q<HTMLInputElement>('[data-c]').value);
      const layer = q<HTMLSelectElement>('[data-design]').value === '1';
      q('[data-fv]').textContent = String(features); q('[data-cv]').textContent = String(changes);
      const files = layer ? 1 : features, edits = changes * files;
      setBox(1, String(files), layer ? 'only the layer, which translates the records' : 'every feature that reads a CRM record', files === 1 ? 'good' : 'bad');
      setBox(2, String(edits), layer ? 'each CRM change is made once, in the layer' : 'each CRM change reaches every feature that uses the field', edits === 0 ? 'good' : layer ? 'good' : 'bad');
      setBox(3, layer ? '1' : '0', layer ? 'a gateway and a translator, with their own tests' : 'nothing extra, but the CRM model is in the whole code base', layer ? 'mid' : 'mid');
      q('[data-verdict]').textContent = layer
        ? 'Billing keeps its own clean model. The layer costs one more piece to maintain, and it pays when the legacy side changes or is replaced.'
        : edits === 0 ? 'The CRM never changes and only one feature uses it, so a layer would save nothing.' : 'The CRM model leaks into billing, so each CRM change reaches many files.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
