---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Plug different payment services into the same checkout. See what the adapter fixes.">
  <ol class="how">
    <li>Enter an <b>amount</b> in dollars.</li>
    <li>Choose what Checkout is given, then press <b>Pay</b>.</li>
    <li>Compare <b>Legacy bank directly</b> (breaks) with <b>Legacy bank + Adapter</b> (works).</li>
  </ol>
  <div data-adapter-demo class="a-demo">
    <div role="group" aria-label="Gateway given to Checkout" class="a-row" data-choices></div>
    <form class="a-row" data-form>
      <label class="sr" for="amount">Amount in dollars</label>
      <span class="a-dollar">$</span>
      <input id="amount" name="amount" type="number" min="0" step="0.01" value="25" />
      <button class="btn a-primary" type="submit">Pay</button>
    </form>
    <div class="a-flow" aria-live="polite">
      <div class="a-col"><small>Checkout calls</small><code data-call>pay(25.00)</code></div>
      <span aria-hidden="true">→</span>
      <div class="a-col" data-mid><small data-midlabel>gateway</small><code data-mid-text>?</code></div>
      <span aria-hidden="true">→</span>
      <div class="a-col"><small>Service receives</small><code data-recv>?</code></div>
    </div>
    <output class="a-out" data-out>Press Pay.</output>
  </div>
</PlaygroundShell>
<script>
  // The legacy service, unchanged. Notice the different method name and units.
  class LegacyBankApi {
    makePayment(cents: number, currency: string) { return { ok: true, ref: `LB-${cents}${currency}` }; }
  }
  class CardGateway { pay(d: number) { return `Card charged $${d.toFixed(2)}`; } }
  class LegacyBankAdapter {
    constructor(private bank: LegacyBankApi) {}
    pay(d: number) {
      const cents = Math.round(d * 100);
      const r = this.bank.makePayment(cents, 'USD');
      return r.ok ? `Paid $${d.toFixed(2)} (ref ${r.ref})` : 'Payment failed';
    }
  }
  // Checkout only knows gateway.pay(dollars).
  const checkout = (gateway: { pay(d: number): string }, amount: number) => gateway.pay(amount);

  const options = [
    { id: 'card', label: 'CardGateway', make: () => new CardGateway(), mid: 'no translation needed', recv: (d: number) => `charge $${d.toFixed(2)}` },
    { id: 'raw', label: 'Legacy bank directly', make: () => new LegacyBankApi(), mid: 'nothing in between', recv: () => 'pay() does not exist' },
    { id: 'adapter', label: 'Legacy bank + Adapter', make: () => new LegacyBankAdapter(new LegacyBankApi()), mid: 'LegacyBankAdapter', recv: (d: number) => `makePayment(${Math.round(d * 100)}, 'USD')` },
  ];

  document.querySelectorAll<HTMLElement>('[data-adapter-demo]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let current = options[0];
    const amountInput = q<HTMLInputElement>('input[name=amount]');
    const fmt = (d: number) => d.toFixed(2);

    function preview() {
      const d = Number(amountInput.value) || 0;
      q('[data-call]').textContent = `pay(${fmt(d)})`;
      q('[data-midlabel]').textContent = current.id === 'adapter' ? 'adapter translates' : 'gateway';
      q('[data-mid-text]').textContent = current.mid;
      q('[data-recv]').textContent = current.recv(d);
    }
    function renderChoices() {
      const wrap = q('[data-choices]');
      wrap.innerHTML = '';
      options.forEach((o) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn'; b.textContent = o.label;
        b.setAttribute('aria-pressed', String(o === current));
        b.addEventListener('click', () => { current = o; renderChoices(); preview(); q('[data-out]').textContent = 'Press Pay.'; q('[data-out]').classList.remove('bad'); });
        wrap.appendChild(b);
      });
    }
    q('[data-form]').addEventListener('submit', (e) => {
      e.preventDefault();
      const d = Number(amountInput.value) || 0;
      const out = q('[data-out]');
      preview();
      try {
        out.textContent = checkout(current.make() as { pay(d: number): string }, d);
        out.classList.remove('bad');
      } catch (err) {
        out.textContent = `${(err as Error).name}: ${(err as Error).message.replace(/^.*\.pay/, 'gateway.pay')}`;
        out.classList.add('bad');
      }
    });
    amountInput.addEventListener('input', preview);
    renderChoices(); preview();
  });
</script>
<style is:global>
  .playground .a-demo { display: grid; gap: 12px; }
  .playground .a-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .playground .a-demo input[name=amount] { width: 120px; font: inherit; padding: 6px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); }
  .playground .a-primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 600; }
  .playground .a-primary:hover { background: var(--accent); filter: brightness(1.1); }
  .playground .a-flow { display: flex; gap: 8px; flex-wrap: wrap; align-items: stretch; }
  .playground .a-col { flex: 1 1 170px; border: 2px dashed var(--border); border-radius: 10px; padding: 8px 10px; display: grid; gap: 4px; align-content: start; }
  .playground .a-col small { color: var(--muted); font-size: .72rem; }
  .playground .a-col code { font: .82rem var(--font-mono); overflow-wrap: anywhere; }
  .playground .a-flow > span { align-self: center; color: var(--muted); }
  .playground .a-out { font: .95rem var(--font-mono); min-height: 1.5em; padding: 8px 12px; border-radius: 8px; background: var(--accent-soft); }
  .playground .a-out.bad { background: color-mix(in srgb, var(--bad) 14%, var(--surface)); color: var(--bad-text); }
</style>
