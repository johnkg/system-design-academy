---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="An attacker has stolen the user table and guesses offline. Pick how passwords were stored and how strong the password is, and see how long cracking takes. Speeds are illustrative, not benchmarks.">
  <ol class="how">
    <li>With <b>plain fast hash</b>, note that alice and bob (same password) have <b>identical</b> stored values. Even an 8-letter password falls in seconds.</li>
    <li>Switch to <b>salted fast hash</b>: the stored values differ, so the attacker must work per account, but each guess is still very cheap.</li>
    <li>Choose <b>salted slow hash</b> and raise the <b>cost</b>: each +1 halves the guess rate. A common password like <b>123456</b> still falls within minutes, which is why password rules and login rate limits matter too.</li>
  </ol>
  <div class="pg ph" data-ph>
    <div class="pg-row">
      <label>Stored as <select class="pg-in" data-method>
        <option value="fast" selected>Plain fast hash (SHA-256, no salt)</option>
        <option value="salted">Salted fast hash</option>
        <option value="slow">Salted slow hash (Argon2, scrypt, bcrypt, PBKDF2)</option>
      </select></label>
      <label>Password <select class="pg-in" data-pw>
        <option value="common" selected>123456 (on every common-password list)</option>
        <option value="lower8">8 random lowercase letters</option>
        <option value="words4">4 random words (passphrase)</option>
        <option value="mixed10">10 random letters and digits</option>
      </select></label>
      <label>Slow-hash cost <input type="range" min="8" max="16" value="12" data-cost /> <b data-costval></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-1)"><h3>Stored in the database</h3><span class="pg-mono" data-stored></span><span class="pg-note" data-same></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Attacker's speed</h3><span class="pg-mono" data-speed></span></div>
      <div class="pg-box" data-verdictbox><h3>Time to crack one account</h3><span class="pg-mono" data-time></span><span class="pg-note" data-note></span></div>
    </div>
  </div>
</PlaygroundShell>
<script>
  const space: Record<string, number> = { common: 1e6, lower8: 26 ** 8, words4: 7776 ** 4, mixed10: 62 ** 10 };
  const fnv = (text: string) => { let h = 2166136261; for (const c of text) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619) >>> 0; } return h.toString(16).padStart(8, '0'); };
  function human(sec: number) {
    if (sec < 1) return 'under a second';
    const units: [string, number][] = [['years', 31557600], ['days', 86400], ['hours', 3600], ['minutes', 60], ['seconds', 1]];
    for (const [u, s] of units) if (sec >= s) { const v = sec / s; return u === 'years' && v >= 1e6 ? `${(v / 1e6).toFixed(1)} million years` : `${v >= 100 ? Math.round(v).toLocaleString('en-US') : v.toFixed(1)} ${u}`; }
    return `${sec} seconds`;
  }
  document.querySelectorAll<HTMLElement>('[data-ph]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    function draw() {
      const method = q<HTMLSelectElement>('[data-method]').value; const pw = q<HTMLSelectElement>('[data-pw]').value; const cost = Number(q<HTMLInputElement>('[data-cost]').value);
      q('[data-costval]').textContent = String(cost); q<HTMLInputElement>('[data-cost]').disabled = method !== 'slow';
      const secret = { common: '123456', lower8: 'qzjwpkme', words4: 'correct horse battery staple', mixed10: 'k3Vr9xQe2Z' }[pw]!;
      const a = method === 'fast' ? fnv(secret) : `${fnv('a1' + secret)}`; const b = method === 'fast' ? fnv(secret) : `${fnv('b2' + secret)}`;
      q('[data-stored]').textContent = `alice: ${a}  bob: ${b}`;
      q('[data-same]').textContent = a === b ? 'Identical: both accounts fall to one guess' : 'Different: each account must be attacked separately';
      const speed = method === 'slow' ? 2e6 / 2 ** (cost - 4) : 1e10;
      q('[data-speed]').textContent = `${speed >= 1e6 ? `${(speed / 1e9).toFixed(0)} billion` : Math.round(speed).toLocaleString('en-US')} guesses per second`;
      const sec = space[pw] / speed / 2; // on average half the space is searched
      q('[data-time]').textContent = human(sec);
      const bad = sec < 86400 * 30;
      q<HTMLElement>('[data-verdictbox]').style.setProperty('--c', bad ? 'var(--bad)' : 'var(--role-2)');
      q<HTMLElement>('[data-note]').style.color = bad ? 'var(--bad-text)' : '';
      q('[data-note]').textContent = bad ? 'Cracked within a month' : 'Out of practical reach';
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
