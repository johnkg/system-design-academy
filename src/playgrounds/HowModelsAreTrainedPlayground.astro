---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Train one weight w on the loss (w - 3) squared, starting from 0, with plain gradient descent. Choose the learning rate and the number of steps, and watch whether training settles, bounces or blows up.">
  <ol class="how">
    <li>Start with the defaults: <b>Learning rate</b> <b>0.1</b> and <b>Steps</b> <b>20</b>. The weight reaches <b>2.9654</b> and the loss falls to <b>0.0012</b>: it is <b>converging</b>, smoothly from one side.</li>
    <li>Set <b>Learning rate</b> to <b>0.7</b>: the weight reaches <b>3.0000</b> and the loss <b>0.0000</b>, but it overshoots the target on every step before it settles: <b>converging with overshoot</b>.</li>
    <li>Set <b>Learning rate</b> to <b>1</b>: after <b>20</b> steps the weight is back at <b>0.0000</b> and the loss is <b>9.0000</b>, exactly where it began. It jumps from one side of the target to the other and never settles: <b>bouncing</b>.</li>
    <li>Set <b>Learning rate</b> to <b>1.1</b>: the weight is <b>-112.0128</b> and the loss <b>13227.9441</b>. Every step lands further away: <b>diverging</b>.</li>
  </ol>
  <div class="pg trn" data-trn>
    <div class="pg-row">
      <label>Learning rate <input class="pg-in" type="range" min="0.01" max="1.2" step="0.01" value="0.1" data-lr /> <b data-lrv></b></label>
      <label>Steps <input class="pg-in" type="range" min="1" max="50" step="1" value="20" data-s /> <b data-sv></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Weight after the steps</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Loss after the steps</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>What happened</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // The same loop as the code sample: gradient = 2 (w - 3), w = w - rate x gradient. The error is multiplied by (1 - 2 x rate) each step.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-trn]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const rate = Number(q<HTMLInputElement>('[data-lr]').value), steps = Number(q<HTMLInputElement>('[data-s]').value);
      q('[data-lrv]').textContent = String(rate); q('[data-sv]').textContent = String(steps);
      let w = 0;
      for (let i = 0; i < steps; i++) w = w - rate * 2 * (w - 3);
      const loss = (w - 3) ** 2;
      const factor = 1 - 2 * rate; // how much of the error is left after one step
      const kind = Math.abs(factor) > 1 + 1e-9 ? 'diverging' : Math.abs(Math.abs(factor) - 1) <= 1e-9 ? 'bouncing' : factor < 0 ? 'converging with overshoot' : 'converging';
      setBox(1, w.toFixed(4), 'the target is 3', kind.startsWith('converging') ? 'good' : 'bad');
      setBox(2, loss.toFixed(4), `after ${steps} steps, from a starting loss of 9.0000`, kind.startsWith('converging') ? 'good' : 'bad');
      setBox(3, kind, `each step leaves ${Math.abs(factor).toFixed(2)} of the error${factor < 0 ? ', on the other side of the target' : ''}`, kind.startsWith('converging') ? 'good' : 'bad');
      q('[data-verdict]').textContent = kind === 'diverging' ? 'The step is too big: each update jumps past the target and lands further away, so the loss grows. Lower the learning rate.'
        : kind === 'bouncing' ? 'The step is exactly big enough to jump from one side of the target to the other, so the loss never falls.'
        : 'The loss falls. A larger rate gets there in fewer steps, until it is large enough to overshoot.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
