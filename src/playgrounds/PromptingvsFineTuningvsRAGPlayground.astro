---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Say what your assistant needs, and get a recommended order of steps from simple rules. The rules are the ones in the code sample: start with the cheapest lever, and add the next one only for a need it addresses.">
  <ol class="how">
    <li>Start with nothing needed: <b>1</b> step. Start with prompting, since a clear prompt with a few examples is always the first thing to try.</li>
    <li>Set <b>Fresh or changing facts</b> to <b>Yes</b>: <b>2</b> steps, because retrieval joins the prompt. Documents that change belong in retrieval, not in the model's weights.</li>
    <li>Set <b>A strict output format</b> to <b>Yes</b> as well: <b>3</b> steps, with structured output added to the list.</li>
    <li>Set <b>A particular writing style</b> and <b>High volume at low latency</b> to <b>Yes</b> too: <b>5</b> steps, and fine-tuning appears twice, once for style and once to replace a long prompt with a smaller tuned model.</li>
  </ol>
  <div class="pg pfr" data-pfr>
    <div class="pg-row">
      <label>Fresh or changing facts <select class="pg-in" data-fresh><option value="0" selected>No</option><option value="1">Yes</option></select></label>
      <label>Private documents <select class="pg-in" data-docs><option value="0" selected>No</option><option value="1">Yes</option></select></label>
      <label>A strict output format <select class="pg-in" data-format><option value="0" selected>No</option><option value="1">Yes</option></select></label>
      <label>A particular writing style <select class="pg-in" data-style><option value="0" selected>No</option><option value="1">Yes</option></select></label>
      <label>High volume at low latency <select class="pg-in" data-volume><option value="0" selected>No</option><option value="1">Yes</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Steps recommended</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" style="--c: var(--border)"><h3>In order</h3><ol class="pfr-list" data-list></ol></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // The same rules as the code sample.
  const RULES: [(on: Record<string, boolean>) => boolean, string][] = [
    [() => true, 'prompting: write clear instructions and a few examples'],
    [(n) => n.fresh || n.docs, 'retrieval: fetch the documents at question time'],
    [(n) => n.format, 'structured output: ask for a schema and validate the result'],
    [(n) => n.style, 'fine-tuning: consider it if prompting cannot hold the style'],
    [(n) => n.volume, 'fine-tuning: a smaller tuned model can replace a long prompt'],
  ];
  document.querySelectorAll<HTMLElement>('[data-pfr]').forEach((root) => {
    const q = query(root);
    function draw() {
      const on = {
        fresh: q<HTMLSelectElement>('[data-fresh]').value === '1', docs: q<HTMLSelectElement>('[data-docs]').value === '1',
        format: q<HTMLSelectElement>('[data-format]').value === '1', style: q<HTMLSelectElement>('[data-style]').value === '1',
        volume: q<HTMLSelectElement>('[data-volume]').value === '1',
      };
      const steps = RULES.filter(([applies]) => applies(on)).map(([, text]) => text);
      q('[data-o1]').textContent = String(steps.length);
      q('[data-n1]').textContent = steps.length === 1 ? 'only the cheapest lever for now' : 'each step addresses one of the needs you set';
      q<HTMLElement>('[data-b1]').style.setProperty('--c', 'var(--border)');
      const list = q('[data-list]'); list.textContent = '';
      for (const s of steps) { const li = document.createElement('li'); li.textContent = s; list.appendChild(li); }
      q('[data-verdict]').textContent = 'Move to the next step only when a measured gap remains. Keep a small test set, so that each step shows whether it helped.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .pfr-list { margin: 0; padding-left: 1.3rem; font: .82rem var(--font-mono); overflow-wrap: anywhere; display: grid; gap: 4px; }
</style>
