---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="200 payments, recorded by you and by the payment provider, with breaks injected from a fixed seed: a payment booked a day late, missing on one side, delivered twice, reported net of the fee, with a different status, or without its reference id. Choose how hard the data is broken and how matching decides that two rows are the same payment. Amounts are in cents.">
  <ol class="how">
    <li>Start with the defaults: <b>Break rate (%)</b> at <b>10</b> and <b>Matching rule</b> on <b>Exact id only</b>. <b>27</b> breaks were injected, and <b>188</b> payments match, but the matched box says <b>10</b> of them still differ in date, amount or status. <b>9</b> of your rows and <b>11</b> provider rows have no partner, and the totals are <b>7752</b> cents apart. Matching by id alone finds the pairs, but does not say that they agree.</li>
    <li>Set <b>Matching rule</b> to <b>Id and date within the window</b> and <b>Date window (days)</b> to <b>0</b>: the 4 payments the provider booked a day late (paid just before midnight) are rejected, so matched falls to <b>184</b>, with <b>13</b> unmatched rows on your side and <b>15</b> on the provider's. Set <b>Date window (days)</b> back to <b>1</b> and they match again, with the date difference left in the table.</li>
    <li>Set <b>Matching rule</b> to <b>Id, then fuzzy by amount and date</b>: the 3 provider rows that lost their reference id are paired by amount and date, matched rises to <b>191</b>, and the unexplained money falls from <b>25028</b> to <b>15034</b> cents. Look at <b>False matches</b>: it shows <b>1</b>, a pair of different payments that only looked alike, and it hides the error behind it.</li>
    <li>Set <b>Break rate (%)</b> to <b>0</b>: all <b>200</b> payments match and the table is empty. Set it to <b>30</b>: <b>62</b> breaks are injected, and the money difference grows to <b>20321</b> cents. The same data, broken more, is a longer exception queue, not a different kind of problem.</li>
  </ol>
  <div class="pg rc" data-rc>
    <div class="pg-row">
      <label>Break rate (%) <input type="range" min="0" max="30" step="1" value="10" data-rate /> <b data-rate-v></b></label>
      <label>Matching rule <select class="pg-in" data-rule>
        <option value="id" selected>Exact id only</option>
        <option value="fee">Id and amount within the fee</option>
        <option value="window">Id and date within the window</option>
        <option value="fuzzy">Id, then fuzzy by amount and date</option>
      </select></label>
      <label>Date window (days) <input type="range" min="0" max="3" step="1" value="1" data-window /> <b data-window-v></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Breaks injected</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Matched</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Unmatched, your side</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Unmatched, provider side</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>False matches</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Money difference</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
      <div class="pg-box" data-b7><h3>Money still unexplained</h3><span class="pg-mono" data-o7></span><span class="pg-note" data-n7></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The first mismatches, by class</h3>
      <div class="rc-scroll" tabindex="0" role="region" aria-label="The first mismatches, by class"><table class="rc-table" data-table></table></div>
      <span class="pg-note" data-n8></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const SEED = 20261128; const COUNT = 200; const PRICES = [499, 999, 1999, 4900]; const DAYS = 7;
  const CLASSES = ['timing shift', 'missing at provider', 'missing in our records', 'duplicate', 'amount off by fee', 'status differs', 'no reference id'];
  type Rule = 'id' | 'fee' | 'window' | 'fuzzy';
  interface Row { id: string; trueId?: string; amount: number; day: number; status: string }
  const feeOf = (amount: number) => Math.floor((amount * 290 + 5000) / 10000) + 30;

  // The same model as the code samples: a seeded generator, injected breaks, then matching by a rule.
  function makeRng(seed: number) { let s = seed; return (n: number) => { s = (s * 48271) % 2147483647; return s % n; }; }
  function generate(ratePct: number) {
    const r = makeRng(SEED);
    const ours: Row[] = [], provider: Row[] = [], injected = CLASSES.map(() => 0);
    for (let i = 1; i <= COUNT; i++) {
      const id = 'T' + String(i).padStart(4, '0');
      const amount = PRICES[r(PRICES.length)], day = 1 + r(DAYS), status = r(100) < 15 ? 'refunded' : 'captured';
      const broken = r(100) < ratePct, cls = r(CLASSES.length);
      const row: Row = { id, trueId: id, amount, day, status };
      const kind = broken ? cls : -1;
      if (broken) injected[cls]++;
      if (kind !== 2) ours.push({ id, amount, day, status });
      if (kind === 1) continue;
      if (kind === 0) row.day = day + 1;
      if (kind === 4) row.amount = amount - feeOf(amount);
      if (kind === 5) row.status = status === 'captured' ? 'refunded' : 'captured';
      if (kind === 6) row.id = '';
      provider.push(row);
      if (kind === 3) provider.push({ ...row });
    }
    return { ours, provider, injected };
  }
  const feeOk = (o: Row, p: Row) => p.amount <= o.amount && o.amount - p.amount <= feeOf(o.amount);

  function reconcile(data: ReturnType<typeof generate>, rule: Rule, n: number) {
    const byId = new Map(data.ours.map((o) => [o.id, o]));
    const matchedOurs = new Set<string>(); const pairs: [Row, Row][] = []; const unmatchedP: Row[] = []; const deferred: Row[] = [];
    for (const p of data.provider) {
      if (p.id === '') { deferred.push(p); continue; }
      const o = byId.get(p.id);
      if (!o || matchedOurs.has(o.id)) { unmatchedP.push(p); continue; }
      const ok = rule === 'fee' ? feeOk(o, p) : rule === 'window' ? Math.abs(p.day - o.day) <= n : true;
      if (ok) { matchedOurs.add(o.id); pairs.push([o, p]); } else unmatchedP.push(p);
    }
    for (const p of deferred) {
      if (rule !== 'fuzzy') { unmatchedP.push(p); continue; }
      let best: Row | null = null;
      for (const o of data.ours) {
        if (matchedOurs.has(o.id) || o.amount !== p.amount || Math.abs(o.day - p.day) > n) continue;
        if (!best || Math.abs(o.day - p.day) < Math.abs(best.day - p.day)) best = o;
      }
      if (best) { matchedOurs.add(best.id); pairs.push([best, p]); } else unmatchedP.push(p);
    }
    const unmatchedO = data.ours.filter((o) => !matchedOurs.has(o.id));
    const exceptions: Record<string, string[]> = {};
    const add = (cls: string, text: string) => { (exceptions[cls] ||= []).push(text); };
    const usedP = new Set<Row>();
    for (const o of unmatchedO) {
      const p = unmatchedP.find((x) => x.id === o.id && !usedP.has(x));
      if (p) { usedP.add(p); add('same id, rejected by the rule', o.id); } else add('missing at provider', o.id);
    }
    for (const p of unmatchedP) {
      if (usedP.has(p)) continue;
      if (p.id === '') add('no reference id', `${p.amount} on day ${p.day}`);
      else if (matchedOurs.has(p.id)) add('duplicate', p.id);
      else add('missing in our records', p.id);
    }
    for (const [o, p] of pairs) {
      if (o.day !== p.day) add('date differs', o.id);
      if (o.amount !== p.amount && !(rule === 'fee' && p.amount < o.amount && o.amount - p.amount <= feeOf(o.amount))) add('amount differs', o.id);
      if (o.status !== p.status) add('status differs', o.id);
    }
    const correct = pairs.filter(([o, p]) => o.id === p.trueId).length;
    const sum = (rows: Row[]) => rows.reduce((s, x) => s + x.amount, 0);
    let unexplained = sum(unmatchedO) + sum(unmatchedP);
    for (const [o, p] of pairs) if (!(rule === 'fee' && feeOk(o, p))) unexplained += Math.abs(o.amount - p.amount);
    return { matched: pairs.length, correct, falseMatches: pairs.length - correct, unmatchedO: unmatchedO.length, unmatchedP: unmatchedP.length,
      difference: sum(data.ours) - sum(data.provider), unexplained, exceptions };
  }

  document.querySelectorAll<HTMLElement>('[data-rc]').forEach((root) => {
    const q = query(root);
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
    function draw() {
      const rate = Number(q<HTMLInputElement>('[data-rate]').value), n = Number(q<HTMLInputElement>('[data-window]').value);
      const rule = q<HTMLSelectElement>('[data-rule]').value as Rule;
      q('[data-rate-v]').textContent = `${rate}%`; q('[data-window-v]').textContent = `${n} ${n === 1 ? 'day' : 'days'}`;
      const data = generate(rate), x = reconcile(data, rule, n);
      const injected = data.injected.reduce((a, b) => a + b, 0);
      set(1, String(injected), `in ${data.ours.length} of your rows and ${data.provider.length} of the provider's`);
      box(1, injected === 0);
      const ex = x.exceptions;
      const hidden = (ex['date differs']?.length ?? 0) + (ex['amount differs']?.length ?? 0) + (ex['status differs']?.length ?? 0);
      set(2, String(x.matched), `${x.correct} correct, ${hidden} still differ in date, amount or status`);
      box(2, hidden === 0 && x.falseMatches === 0);
      set(3, String(x.unmatchedO), 'rows only you have, or that the rule rejected');
      box(3, x.unmatchedO === 0);
      set(4, String(x.unmatchedP), 'rows only the provider has, duplicates and rows with no id');
      box(4, x.unmatchedP === 0);
      set(5, String(x.falseMatches), x.falseMatches === 0 ? 'every pair is the same payment' : 'two different payments paired because amount and date looked alike');
      box(5, x.falseMatches === 0);
      set(6, `${x.difference} cents`, 'your total minus the provider total, before any matching');
      box(6, x.difference === 0);
      set(7, `${x.unexplained} cents`, 'unmatched amounts plus amount differences inside matched pairs');
      box(7, x.unexplained === 0);
      const table = q<HTMLTableElement>('[data-table]'); table.textContent = '';
      const head = table.insertRow();
      for (const h of ['Class', 'Count', 'First three']) { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); }
      const names = Object.keys(ex).sort();
      for (const c of names) {
        const row = table.insertRow();
        [c, String(ex[c].length), ex[c].slice(0, 3).join(', ')].forEach((v) => { row.insertCell().textContent = v; });
      }
      q('[data-n8]').textContent = names.length === 0 ? 'Nothing to review: every row matches and agrees.' : `${plural(names.reduce((s, c) => s + ex[c].length, 0), 'exception', 'exceptions')} to repair or send to review.`;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .rc { display: grid; gap: 12px; }
  .playground .rc-scroll { overflow-x: auto; }
  .playground .rc-table { border-collapse: collapse; font: .82rem var(--font-mono); width: 100%; }
  .playground .rc-table th, .playground .rc-table td { text-align: left; padding: 4px 10px 4px 0; vertical-align: top; }
  .playground .rc-table th { color: var(--muted); font-weight: 600; }
</style>
