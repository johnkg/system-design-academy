---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it" hint="A payment API charges $50 per request. Choose how the client uses idempotency keys, then trigger the situations that cause duplicate requests.">
  <ol class="how">
    <li>Leave <b>No key</b> selected and press <b>Pay, response gets lost</b>. The charge went through, the app timed out and retried, and the customer paid twice.</li>
    <li>Switch to <b>Same key on every retry</b> and repeat. The retry is recognised and replayed, so the total stays $50.</li>
    <li>Try <b>Double-click Pay</b> with each setting, and <b>New key on every retry</b>, which looks safe but protects nothing.</li>
  </ol>
  <div class="pg idem" data-idem>
    <div class="pg-row">
      <label>Client sends <select class="pg-in" data-mode>
        <option value="none">No key</option>
        <option value="new">New key on every retry (mistake)</option>
        <option value="same">Same key on every retry</option>
      </select></label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-lost>Pay $50, response gets lost</button>
      <button class="btn" type="button" data-double>Double-click Pay</button>
      <button class="btn" type="button" data-normal>Pay $50 normally</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-1)"><h3>Customer meant to pay</h3><span class="pg-mono" data-intended>$0</span></div>
      <div class="pg-box" data-chargedbox aria-live="polite"><h3>Actually charged</h3><span class="pg-mono" data-charged>$0</span><span class="pg-note" data-verdict></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Keys the server remembers</h3><span class="pg-mono" data-keys>none</span></div>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="What happened"></ol>
  </div>
</PlaygroundShell>
<script>
  const CHARGE = 50; // dollars per payment
  document.querySelectorAll<HTMLElement>('[data-idem]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const mode = () => q<HTMLSelectElement>('[data-mode]').value;
    let charges: number[] = []; let intended = 0; let seen = new Set<string>(); let keyN = 0; let log: string[] = [];
    const LOG = 12;
    const rows: HTMLElement[] = [];
    for (let i = 0; i < LOG; i++) { const li = document.createElement('li'); li.hidden = true; q('[data-log]').appendChild(li); rows.push(li); }

    function server(key: string | null, label: string) {
      if (key && seen.has(key)) { log.push(`${label}: server saw key ${key} before, returns the saved result (no new charge)`); return; }
      charges.push(CHARGE); if (key) seen.add(key);
      log.push(`${label}: server charges $${CHARGE}${key ? ` and saves key ${key}` : ' (no key to check)'}`);
    }
    const newKey = () => (mode() === 'none' ? null : `key-${++keyN}`);
    function pay(scenario: 'lost' | 'double' | 'normal') {
      intended += CHARGE; const first = newKey();
      if (scenario === 'normal') { log.push('Pay clicked'); server(first, 'request'); }
      if (scenario === 'lost') {
        log.push('Pay clicked'); server(first, 'request');
        log.push('response lost: the app sees a timeout and retries');
        server(mode() === 'new' ? newKey() : first, 'retry');
      }
      if (scenario === 'double') {
        log.push('Pay clicked twice, but the customer meant one payment');
        server(first, 'click 1'); server(mode() === 'new' ? newKey() : first, 'click 2');
      }
      if (log.length > LOG) log = log.slice(-LOG);
      draw();
    }
    function draw() {
      const total = charges.reduce((a, b) => a + b, 0);
      q('[data-intended]').textContent = `$${intended}`; q('[data-charged]').textContent = `$${total}`;
      const bad = total > intended; const box = q('[data-chargedbox]');
      box.style.setProperty('--c', bad ? 'var(--bad)' : 'var(--role-2)');
      q<HTMLElement>('[data-verdict]').style.color = bad ? 'var(--bad-text)' : ''; q('[data-verdict]').textContent = !charges.length ? '' : bad ? `Overcharged by $${total - intended}` : 'Exactly what was meant';
      q('[data-keys]').textContent = seen.size ? [...seen].join(', ') : 'none';
      rows.forEach((li, i) => { const t = log[i]; li.hidden = t === undefined; if (t !== undefined) li.textContent = t; });
    }
    function reset() { charges = []; intended = 0; seen = new Set(); keyN = 0; log = []; draw(); }
    q('[data-lost]').addEventListener('click', () => pay('lost'));
    q('[data-double]').addEventListener('click', () => pay('double'));
    q('[data-normal]').addEventListener('click', () => pay('normal'));
    q('[data-reset]').addEventListener('click', reset);
    q('[data-mode]').addEventListener('change', reset);
    reset();
  });
</script>
