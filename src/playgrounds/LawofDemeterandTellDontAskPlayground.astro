---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A small codebase: 12 call sites read data through an order, a customer, an address and a country. Pick how the code is written and which change arrives, and count the edits, the places they land in, and the methods the design adds.">
  <ol class="how">
    <li>Start with <b>Design</b> <b>Train-wreck calls</b> and <b>Change request</b> <b>Customer gets several addresses</b>: <b>9</b> edits spread over <b>7</b> places. Set <b>Design</b> to <b>Tell, don't ask</b>: <b>4</b> edits, all in <b>1</b> place, because callers no longer know the structure.</li>
    <li>Set <b>Change request</b> to <b>Tax rule changes</b>. Train-wreck calls need <b>2</b> edits, tell needs <b>1</b>. Set <b>Design</b> to <b>Forward everything</b>: <b>2</b> edits again, because callers still fetch the rate and decide.</li>
    <li>Break it: set <b>Change request</b> to <b>Country gets a currency</b>. Train-wreck calls need <b>1</b> edit, but tell and forwarding need <b>5</b>, a hop in every class on the way. Forwarding everything also leaves the order with <b>8</b> methods and <b>18</b> that only forward.</li>
    <li>The table sums the four changes: <b>18</b> edits in <b>16</b> places for train-wreck calls, <b>14</b> in <b>8</b> for tell, <b>17</b> in <b>9</b> for forwarding everything.</li>
  </ol>
  <div class="pg dem" data-dem>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design><option value="train" selected>Train-wreck calls</option><option value="tell">Tell, don't ask</option><option value="forward">Forward everything</option></select></label>
      <label>Change request <select class="pg-in" data-change><option value="0" selected>Customer gets several addresses</option><option value="1">Address keeps its country as a code</option><option value="2">Tax rule changes</option><option value="3">Country gets a currency</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Edits needed</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Places touched</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Methods the order exposes</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Methods that only forward</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Edits / places for each change, and in total</h3>
      <div class="dem-scroll" tabindex="0" role="region" aria-label="Edits and places per design and change request"><table class="dem-table" data-table></table></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type Design = 'train' | 'tell' | 'forward';
  type Kind = 'shape' | 'rule' | 'new';
  type Unit = { where: string; links: Set<number>; logic: Set<number> };

  // The same model as the code samples. Classes form a chain; each piece of data lives in one class (its owner).
  const CLASSES = ['Order', 'Customer', 'Address', 'Country'];
  const OWNER = [1, 1, 2, 2, 3, 3, 3, 3]; // name, tier, street, city, country name, tax rate, zone, code
  const SITES: [string, number][] = [['email', 0], ['invoice', 0], ['loyalty', 1], ['shipping', 2], ['shipping', 3], ['invoice', 4],
    ['report', 4], ['checkout', 5], ['quote', 5], ['shipping', 6], ['fraud', 7], ['export', 2]]; // [module, data it reads]
  const TELL: [string, number[], number][] = [['greeting', [0], 1], ['standing', [1], 1], ['label', [2, 3, 4], 2],
    ['tax', [5], 3], ['zone', [6], 3], ['risk', [7], 3]]; // [method, data it reads, class where it lives]
  const CHANGES: [string, Kind, number][] = [['Customer gets several addresses', 'shape', 2], ['Address keeps its country as a code', 'shape', 3],
    ['Tax rule changes', 'rule', 5], ['Country gets a currency', 'new', 3]];
  const NAMES: Record<Design, string> = { train: 'Train-wreck calls', tell: "Tell, don't ask", forward: 'Forward everything' };
  const DESIGNS: Design[] = ['train', 'tell', 'forward'];
  const range = (a: number, b: number) => Array.from({ length: Math.max(0, b - a) }, (_, i) => a + i);
  const sum = (xs: number[]) => xs.reduce((a, b) => a + b, 0);

  // A unit is one piece of code that can need editing: where it is, the links of the chain it crosses, the data whose rule it holds.
  function units(design: Design): Unit[] {
    const u: Unit[] = [];
    if (design === 'train') {
      for (const [m, op] of SITES) u.push({ where: m, links: new Set(range(1, OWNER[op] + 1)), logic: new Set([op]) });
    } else if (design === 'forward') {
      for (const [m, op] of SITES) u.push({ where: m, links: new Set(), logic: new Set([op]) });
      for (let op = 0; op < 8; op++) for (let c = 0; c <= OWNER[op]; c++) u.push({ where: CLASSES[c], links: c < OWNER[op] ? new Set([c + 1]) : new Set(), logic: new Set() });
    } else {
      for (const [m] of SITES) u.push({ where: m, links: new Set(), logic: new Set() });
      for (const [, reads, home] of TELL) {
        const top = Math.max(...reads.map((o) => OWNER[o]));
        for (let c = 0; c <= home; c++) u.push({ where: CLASSES[c], links: c < home ? new Set([c + 1]) : new Set(range(home + 1, top + 1)), logic: c === home ? new Set(reads) : new Set() });
      }
    }
    return u;
  }
  function edited(design: Design, kind: Kind, arg: number): string[] {
    if (kind === 'new') return ['checkout', ...(design === 'train' ? [] : CLASSES.slice(0, arg + 1))];
    if (kind === 'shape') return units(design).filter((x) => x.links.has(arg)).map((x) => x.where);
    return units(design).filter((x) => x.logic.has(arg)).map((x) => x.where);
  }
  const FORWARDERS: Record<Design, number> = { train: 0, tell: sum(TELL.map((t) => t[2])), forward: sum(OWNER) };
  const ORDER_METHODS: Record<Design, number> = { train: 0, tell: TELL.length, forward: OWNER.length };
  const cost = (design: Design, i: number) => { const e = edited(design, CHANGES[i][1], CHANGES[i][2]); return { edits: e.length, places: new Set(e).size }; };

  document.querySelectorAll<HTMLElement>('[data-dem]').forEach((root) => {
    const q = query(root);
    const setBox = (n: number, value: string, note: string, good: boolean | null) => {
      q(`[data-o${n}]`).textContent = value; q(`[data-n${n}]`).textContent = note;
      q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good === null ? 'var(--border)' : good ? 'var(--good)' : 'var(--bad)');
    };
    function draw() {
      const design = q<HTMLSelectElement>('[data-design]').value as Design, ci = Number(q<HTMLSelectElement>('[data-change]').value);
      const r = cost(design, ci), best = Math.min(...DESIGNS.map((d) => cost(d, ci).edits)), bestPlaces = Math.min(...DESIGNS.map((d) => cost(d, ci).places));
      const kind = CHANGES[ci][1];
      setBox(1, `${r.edits}`, kind === 'rule' ? (design === 'tell' ? 'the rule has one home' : 'the rule is copied at each caller: a missed copy is a silent wrong answer') : kind === 'new' ? (design === 'train' ? 'one new call site' : 'a new call site and a hop in every class on the way down') : 'call sites or hops that mention the changed link', r.edits === best);
      setBox(2, `${r.places}`, design === 'train' ? 'modules whose tests must be re-run' : 'classes and call sites whose tests must be re-run', r.places === bestPlaces);
      setBox(3, `${ORDER_METHODS[design]}`, design === 'train' ? 'callers navigate the chain themselves' : design === 'tell' ? 'one per behaviour: greeting, label, tax...' : 'one per piece of data: 8 getters', design === 'forward' ? false : null);
      setBox(4, `${FORWARDERS[design]}`, design === 'train' ? 'no hops at all' : 'one-line methods that only pass a call down a level', design === 'forward' ? false : design === 'train' ? true : null);
      const table = q('[data-table]'); table.textContent = '';
      const head = table.insertRow(); ['Design', ...CHANGES.map((c) => c[0]), 'Total'].forEach((h) => { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); });
      DESIGNS.forEach((d) => {
        const row = table.insertRow(); if (d === design) row.className = 'on';
        const cs = CHANGES.map((_, i) => cost(d, i));
        [NAMES[d], ...cs.map((c) => `${c.edits} / ${c.places}`), `${sum(cs.map((c) => c.edits))} / ${sum(cs.map((c) => c.places))}`].forEach((v) => { row.insertCell().textContent = v; });
      });
      q('[data-verdict]').textContent = `Each cell is edits / places. ${NAMES[design]}, ${CHANGES[ci][0].toLowerCase()}: ${r.edits} edits in ${r.places} places. Telling wins when behaviour changes or the structure moves; it costs more when a new field has to be passed through every class.`;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .dem-scroll { overflow-x: auto; }
  .playground .dem-table { border-collapse: collapse; font: .82rem var(--font-mono); min-width: 100%; }
  .playground .dem-table th, .playground .dem-table td { padding: 4px 8px; border-bottom: 1px solid var(--border); text-align: right; vertical-align: bottom; }
  .playground .dem-table th { white-space: normal; min-width: 7rem; }
  .playground .dem-table td { white-space: nowrap; }
  .playground .dem-table th:first-child, .playground .dem-table td:first-child { text-align: left; }
  .playground .dem-table tr.on td { font-weight: 700; background: var(--accent-soft); }
</style>
