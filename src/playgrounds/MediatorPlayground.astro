---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="A chat room where all traffic goes through the mediator.">
  <ol class="how">
    <li>Pick a <b>sender</b>, a <b>recipient</b> (everyone or one person) and press <b>Send</b>.</li>
    <li>Tick <b>Room filters swearing</b>. The rule lives in the room; no user changes.</li>
    <li>Press <b>+ Add Dee</b>: one register() call, and nobody else is edited.</li>
  </ol>
  <div class="pg" data-mediator>
    <div class="pg-row">
      <label>From <select class="pg-in" data-from></select></label>
      <label>To <select class="pg-in" data-to></select></label>
      <input class="pg-in" data-msg value="Hello there" aria-label="Message" style="flex:1 1 160px" />
      <button class="btn pg-primary" type="button" data-send>Send</button>
    </div>
    <div class="pg-row"><label><input type="checkbox" data-filter /> Room filters swearing (try “darn”)</label><button class="btn" type="button" data-add>+ Add Dee</button></div>
    <div class="pg-grid" data-inboxes></div>
    <p class="pg-note" data-info aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  class ChatRoom {
    users = new Map<string, User>(); filter = false; delivered = 0;
    register(u: User) { this.users.set(u.name, u); u.room = this; }
    send(from: User, msg: string, to: string | null) {
      if (this.filter && /darn|heck/i.test(msg)) return 'Room blocked the message (filter rule lives in the mediator).';
      const who = to ? [this.users.get(to)!] : [...this.users.values()].filter((u) => u !== from);
      who.forEach((u) => { u.receive(from.name, msg); this.delivered++; }); return `Room delivered to ${who.map((u) => u.name).join(', ')}.`;
    }
  }
  class User { room!: ChatRoom; inbox: string[] = []; constructor(public name: string) {} send(msg: string, to: string | null) { return this.room.send(this, msg, to); } receive(from: string, msg: string) { this.inbox.unshift(`${from}: ${msg}`); } }
  document.querySelectorAll<HTMLElement>('[data-mediator]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const room = new ChatRoom(); ['Ada', 'Bob', 'Cy'].forEach((n) => room.register(new User(n)));
    function opts() { const names = [...room.users.keys()]; q<HTMLSelectElement>('[data-from]').innerHTML = names.map((n) => `<option>${n}</option>`).join(''); q<HTMLSelectElement>('[data-to]').innerHTML = '<option value="">Everyone</option>' + names.map((n) => `<option>${n}</option>`).join(''); }
    function draw() { const g = q('[data-inboxes]'); g.innerHTML = ''; room.users.forEach((u) => { const d = document.createElement('div'); d.className = 'pg-box'; d.style.setProperty('--c', 'var(--role-3)'); d.innerHTML = `<h3>${u.name}</h3><ol class="pg-log" tabindex="0" aria-label="${u.name} inbox">${u.inbox.slice(0, 4).map((m) => `<li>${m}</li>`).join('') || '<li class="pg-note">no messages</li>'}</ol>`; g.appendChild(d); }); }
    q('[data-send]').addEventListener('click', () => {
      const from = room.users.get(q<HTMLSelectElement>('[data-from]').value)!; const to = q<HTMLSelectElement>('[data-to]').value || null; room.filter = q<HTMLInputElement>('[data-filter]').checked;
      if (to === from.name) { q('[data-info]').textContent = 'Pick a different recipient.'; return; }
      q('[data-info]').textContent = from.send(q<HTMLInputElement>('[data-msg]').value, to); draw();
    });
    q('[data-add]').addEventListener('click', (e) => { room.register(new User('Dee')); (e.currentTarget as HTMLButtonElement).disabled = true; opts(); draw(); q('[data-info]').textContent = 'Dee registered with the room. No other user was edited.'; });
    opts(); draw();
  });
</script>
