---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Eight systems that make up a typical checkout. Choose how the customer's card number is collected, and where you store or log things. The page counts how many of your systems end up handling card numbers, what a database breach would give an attacker, and how heavy the audit work is, in general terms.">
  <ol class="how">
    <li>Start with the defaults: <b>Card form design</b> is the card form on your page posting to your own server, and nothing is stored or logged. Card numbers still pass through <b>4 of 8</b> systems, so the audit is <b>heavy</b>. Tick <b>Store the card number or token in your database</b>: it becomes <b>5 of 8</b>, and a database breach exposes full card numbers. Tick <b>Also store the security code (CVV)</b> and the breach gives attackers everything needed to buy things.</li>
    <li>Now tick <b>Log full request bodies</b>, <b>Back up the database nightly</b> and <b>Copy the database to an analytics warehouse</b>: card numbers now sit at rest in <b>4 places</b> and all <b>8 of 8</b> systems are in scope. Nobody planned to keep card numbers in the logs, but a logged request body does.</li>
    <li>Set <b>Card form design</b> to <b>Provider hosted fields on your page</b>: the number goes from the browser straight to the provider, your servers only see a token, and only the checkout page remains: <b>1 of 8</b>, audit <b>light</b>. The same ticked boxes now store and log tokens, which are useless to an attacker.</li>
    <li>Set <b>Card form design</b> to <b>Full redirect to the provider's page</b>: <b>0 of 8</b> of your systems handle card numbers and the audit is the <b>lightest</b>. The price is less control over the look and flow of checkout.</li>
  </ol>
  <div class="pg tp" data-tp>
    <div class="pg-row">
      <label>Card form design <select class="pg-in" data-design>
        <option value="form" selected>Card form on your page, posting to your server</option>
        <option value="hosted">Provider hosted fields on your page</option>
        <option value="redirect">Full redirect to the provider's page</option>
      </select></label>
    </div>
    <div class="pg-row">
      <label><input type="checkbox" data-store /> Store the card number or token in your database</label>
      <label><input type="checkbox" data-cvv /> Also store the security code (CVV)</label>
      <label><input type="checkbox" data-log /> Log full request bodies</label>
      <label><input type="checkbox" data-backup /> Back up the database nightly</label>
      <label><input type="checkbox" data-warehouse /> Copy the database to an analytics warehouse</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Your systems in scope</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Audit effort</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>A database breach exposes</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Card numbers at rest</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Where the number travels</h3>
      <span class="pg-mono" data-path></span>
    </div>
    <div class="pg-grid" data-tiles></div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const COMPONENTS = ['Checkout page', 'Web server', 'App API', 'Payment service', 'Database', 'Log pipeline', 'Backups', 'Analytics warehouse'];
  type Design = 'form' | 'hosted' | 'redirect';
  interface Opts { store: boolean; cvv: boolean; logBodies: boolean; backups: boolean; warehouse: boolean }

  // The same rule set as the code samples.
  function analyze(design: Design, o: Opts) {
    const inScope = COMPONENTS.map(() => false);
    const atRest: string[] = [];
    if (design === 'form') {
      inScope[0] = inScope[1] = inScope[2] = inScope[3] = true;
      if (o.store) { inScope[4] = true; atRest.push(COMPONENTS[4]); }
      if (o.logBodies) { inScope[5] = true; atRest.push(COMPONENTS[5]); }
      if (o.store && o.backups) { inScope[6] = true; atRest.push(COMPONENTS[6]); }
      if (o.store && o.warehouse) { inScope[7] = true; atRest.push(COMPONENTS[7]); }
    } else if (design === 'hosted') {
      inScope[0] = true;
    }
    const count = inScope.filter(Boolean).length;
    const serverSide = inScope.slice(1).some(Boolean);
    const audit = serverSide ? 'heavy' : count > 0 ? 'light' : 'lightest';
    return { inScope, count, atRest, audit };
  }

  const WHY: Record<Design, string[]> = {
    form: ['the number is typed into your page', 'the number arrives in your request', 'the number is processed in your code', 'your code forwards the number to the provider', '', '', '', ''],
    hosted: ['serves the code around the provider\'s fields, so it can still affect the form', 'sees a token only', 'sees a token only', 'sends the token to the provider', 'holds a token at most', 'logs hold a token at most', 'hold a token at most', 'holds a token at most'],
    redirect: ['only sends the customer away', 'sees a token only', 'sees a token only', 'uses the token', 'holds a token at most', 'logs hold a token at most', 'hold a token at most', 'holds a token at most'],
  };
  const FORM_REST_IN = ['stores the card numbers', 'request bodies with the numbers are logged', 'backups contain the stored numbers', 'the analytics copy holds the numbers'];
  const FORM_REST_OUT = ['no number is stored here', 'bodies are not logged', 'nothing to back up, or nothing card-related in it', 'nothing card-related is copied'];
  const PATH: Record<Design, string> = {
    form: 'Browser -> your web server -> your API -> your payment service -> provider. Your own code sees the number at every hop.',
    hosted: 'Browser (provider fields) -> provider. Your servers receive a token and the last 4 digits, never the number.',
    redirect: 'Browser -> provider\'s own page -> provider. Your servers receive a token and the last 4 digits, never the number.',
  };

  document.querySelectorAll<HTMLElement>('[data-tp]').forEach((root) => {
    const q = query(root);
    const tiles = q('[data-tiles]');
    const els = COMPONENTS.map((name) => {
      const el = document.createElement('div'); el.className = 'pg-box';
      el.innerHTML = '<h4></h4><span class="pg-mono"></span><span class="pg-note"></span>';
      el.querySelector('h4')!.textContent = name; tiles.appendChild(el); return el;
    });
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    const on = (s: string) => q<HTMLInputElement>(s).checked;

    function draw() {
      const design = q<HTMLSelectElement>('[data-design]').value as Design;
      const o: Opts = { store: on('[data-store]'), cvv: on('[data-cvv]'), logBodies: on('[data-log]'), backups: on('[data-backup]'), warehouse: on('[data-warehouse]') };
      const r = analyze(design, o);
      set(1, `${r.count} of ${COMPONENTS.length}`, r.count === 0 ? 'none of your systems handles a card number' : COMPONENTS.filter((_, i) => r.inScope[i]).join(', '));
      box(1, r.count <= 1);
      set(2, r.audit, r.audit === 'heavy' ? 'every in-scope system needs the full set of security controls and evidence' : r.audit === 'light' ? 'a short questionnaire about one page, typically' : 'almost nothing of yours is in scope, typically');
      box(2, r.audit !== 'heavy');
      let breach: string, note: string, bad = false;
      if (design === 'form' && o.store) { breach = o.cvv ? 'full card numbers and security codes' : 'full card numbers'; note = o.cvv ? 'number plus code is enough to make purchases; the code must never be stored after authorization' : 'every stored customer card is usable by an attacker'; bad = true; }
      else if (design === 'form') { breach = 'no card data'; note = 'nothing card-related is stored, but see the other places below'; }
      else if (o.store) { breach = 'tokens, last 4, brand, expiry'; note = 'useless outside your provider account'; }
      else { breach = 'no card data'; note = 'nothing card-related is stored'; }
      set(3, breach, note); box(3, !bad);
      const n = r.atRest.length;
      set(4, `${n} ${n === 1 ? 'place' : 'places'}`, n === 0 ? 'no full card numbers are kept anywhere you run' : r.atRest.join(', '));
      box(4, n === 0);
      q('[data-path]').textContent = PATH[design];
      els.forEach((el, i) => {
        const s = r.inScope[i];
        el.style.setProperty('--c', s ? 'var(--bad)' : 'var(--good)');
        (el.querySelector('.pg-mono') as HTMLElement).textContent = s ? 'in scope' : 'out of scope';
        (el.querySelector('.pg-note') as HTMLElement).textContent = design === 'form' && i >= 4 ? (s ? FORM_REST_IN[i - 4] : FORM_REST_OUT[i - 4]) : WHY[design][i];
      });
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .tp { display: grid; gap: 12px; }
</style>
