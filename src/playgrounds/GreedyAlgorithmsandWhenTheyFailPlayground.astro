---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Run a greedy rule next to the true optimum on four problems and see how far apart they are, and what the optimum costs. Everything is deterministic (fixed generators), and cost is counted in comparisons and checks, never timed.">
  <ol class="how">
    <li>Set <b>Problem</b> to <b>Interval scheduling (most jobs)</b>, <b>Jobs</b> to <b>1,000</b> and <b>Rule</b> to <b>Earliest finish time</b>: <b>241</b> jobs, the proven optimum. Change <b>Rule</b> to <b>Earliest start time</b>: <b>153</b>. Change it to <b>Shortest job first</b>: <b>237</b>, close and still wrong.</li>
    <li>Set <b>Problem</b> to <b>Weighted interval scheduling</b> with <b>Jobs</b> at <b>1,000</b> and <b>Rule</b> on <b>Earliest finish (ignores weights)</b>: total weight <b>2,460</b>. <b>Heaviest first</b> gets <b>2,689</b>. Only <b>Dynamic programming (optimal)</b> reaches <b>3,084</b>, because the right choice depends on later jobs.</li>
    <li>Set <b>Problem</b> to <b>Coin change</b>, <b>Coin set</b> to <b>1, 3, 4</b>: greedy is wrong for <b>249</b> of the first <b>1,000</b> amounts. Switch <b>Coin set</b> to <b>1, 5, 10, 25</b> and set <b>Amount</b> to <b>100000</b>: greedy needs <b>4</b> steps and the table method <b>400,000</b>, which is why greedy is tempting.</li>
    <li>Set <b>Problem</b> to <b>Knapsack (value per weight)</b> and <b>Items</b> to <b>80</b>: greedy reaches value <b>1,256</b> against an optimum of <b>1,263</b>. With <b>Items</b> at <b>10</b> it is <b>80</b> against <b>89</b>: a heuristic, usually close, with no promise.</li>
  </ol>
  <div class="pg gr" data-gr>
    <div class="pg-row">
      <label>Problem <select class="pg-in" data-problem><option value="interval" selected>Interval scheduling (most jobs)</option><option value="weighted">Weighted interval scheduling</option><option value="coin">Coin change</option><option value="knap">Knapsack (value per weight)</option></select></label>
      <label data-w="size">Jobs <select class="pg-in" data-size><option value="10">10</option><option value="100">100</option><option value="1000" selected>1,000</option></select></label>
      <label data-w="items">Items <select class="pg-in" data-items><option value="10">10</option><option value="20">20</option><option value="40">40</option><option value="80" selected>80</option></select></label>
      <label data-w="rule">Rule <select class="pg-in" data-rule></select></label>
      <label data-w="coins">Coin set <select class="pg-in" data-coins><option value="1,5,10,25" selected>1, 5, 10, 25</option><option value="1,3,4">1, 3, 4</option><option value="1,7,10">1, 7, 10</option><option value="1,5,12">1, 5, 12</option><option value="1,5,10,20,25">1, 5, 10, 20, 25</option></select></label>
      <label data-w="amount">Amount <input class="pg-in" type="number" data-amount value="63" min="1" max="100000" step="1" style="width: 7em" /></label>
    </div>
    <span class="pg-note" data-note></span>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3 data-h1>Greedy result</h3><span class="pg-mono gr-big" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Optimum</h3><span class="pg-mono gr-big" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Gap</h3><span class="pg-mono gr-big" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Operations</h3><span class="pg-mono gr-big" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3 data-h5>Result against the optimum</h3>
      <div class="gr-bars" data-bars></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const M = 2147483647;
  const rngFrom = (seed: number) => { let s = seed; return () => { s = (s * 48271) % M; return s; }; };
  type Job = [number, number];

  // Merge sort over indices by key, counting key comparisons: the same model as the code samples.
  function sortBy(keys: number[], counter: { n: number }): number[] {
    const merge = (idx: number[]): number[] => {
      if (idx.length <= 1) return idx;
      const mid = Math.floor(idx.length / 2);
      const left = merge(idx.slice(0, mid)), right = merge(idx.slice(mid));
      const out: number[] = []; let i = 0, j = 0;
      while (i < left.length && j < right.length) { counter.n++; if (keys[left[i]] <= keys[right[j]]) out.push(left[i++]); else out.push(right[j++]); }
      return out.concat(left.slice(i), right.slice(j));
    };
    return merge(keys.map((_, i) => i));
  }
  function makeJobs(n: number): Job[] {
    const next = rngFrom(777); const jobs: Job[] = [];
    for (let i = 0; i < n; i++) { const s = next() % (4 * n); const len = 1 + (next() % 40); jobs.push([s, s + len]); }
    return jobs;
  }
  const overlap = (a: Job, b: Job) => a[0] < b[1] && b[0] < a[1];
  function schedule(jobs: Job[], rule: string): [number, number] {
    const keys = jobs.map(([s, e]) => (rule === 'finish' ? e : rule === 'start' ? s : e - s));
    const counter = { n: 0 }; const order = sortBy(keys, counter); const chosen: number[] = []; let lastEnd = -1;
    for (const i of order) {
      if (rule === 'shortest') {
        let ok = true;
        for (const j of chosen) { counter.n++; if (overlap(jobs[i], jobs[j])) { ok = false; break; } }
        if (ok) chosen.push(i);
      } else { counter.n++; if (jobs[i][0] >= lastEnd) { chosen.push(i); lastEnd = jobs[i][1]; } }
    }
    return [chosen.length, counter.n];
  }
  function weighted(n: number) {
    const jobs = makeJobs(n); const next = rngFrom(999); const w: number[] = [];
    for (let i = 0; i < n; i++) w.push(1 + (next() % 20));
    const counter = { n: 0 }; const order = sortBy(jobs.map(([, e]) => e), counter);
    let last = -1, totalA = 0;
    for (const i of order) if (jobs[i][0] >= last) { totalA += w[i]; last = jobs[i][1]; }
    const opsB = { n: 0 }; const orderB = sortBy(w.map((x) => 1000 - x), opsB); const chosen: number[] = []; let totalB = 0;
    for (const i of orderB) {
      let ok = true;
      for (const j of chosen) { opsB.n++; if (overlap(jobs[i], jobs[j])) { ok = false; break; } }
      if (ok) { chosen.push(i); totalB += w[i]; }
    }
    let opsDp = counter.n; const ends = order.map((i) => jobs[i][1]); const best = new Array<number>(n + 1).fill(0);
    for (let k = 1; k <= n; k++) {
      const s = jobs[order[k - 1]][0]; let lo = 0, hi = k - 1;
      while (lo < hi) { opsDp++; const mid = Math.floor((lo + hi) / 2); if (ends[mid] <= s) lo = mid + 1; else hi = mid; }
      opsDp++; best[k] = Math.max(best[k - 1], w[order[k - 1]] + best[lo]);
    }
    return { a: totalA, opsA: counter.n + order.length, b: totalB, opsB: opsB.n, opt: best[n], opsDp };
  }
  function greedyCoins(coins: number[], amount: number): [number, number] {
    let used = 0, ops = 0;
    for (const c of [...coins].sort((a, b) => b - a)) { ops++; used += Math.floor(amount / c); amount %= c; }
    return [amount === 0 ? used : -1, ops];
  }
  function bestCoins(coins: number[], upto: number): { table: number[]; ops: number } {
    const table = [0]; let ops = 0;
    for (let a = 1; a <= upto; a++) {
      let best = 1e9;
      for (const c of coins) { ops++; if (c <= a && table[a - c] + 1 < best) best = table[a - c] + 1; }
      table.push(best);
    }
    return { table, ops };
  }
  function knapsack(n: number) {
    const items: [number, number][] = [];
    for (let i = 0; i < n; i++) items.push([5 + ((i * 7) % 23), 10 + ((i * 11) % 37)]);
    const cap = Math.floor(items.reduce((s, [w]) => s + w, 0) / 3); let ops = 0;
    const order = items.map((_, i) => i);
    for (let i = 1; i < n; i++) {
      let j = i;
      while (j > 0) { ops++; const a = items[order[j - 1]], b = items[order[j]]; if (a[1] * b[0] < b[1] * a[0]) { [order[j - 1], order[j]] = [order[j], order[j - 1]]; j--; } else break; }
    }
    let room = cap, total = 0;
    for (const i of order) { ops++; if (items[i][0] <= room) { room -= items[i][0]; total += items[i][1]; } }
    const best = new Array<number>(cap + 1).fill(0); let dpOps = 0;
    for (const [w, v] of items) for (let c = cap; c >= w; c--) { dpOps++; best[c] = Math.max(best[c], best[c - w] + v); }
    return { cap, total, opt: best[cap], ops, dpOps };
  }

  const RULES: Record<string, [string, string][]> = {
    interval: [['finish', 'Earliest finish time'], ['start', 'Earliest start time'], ['shortest', 'Shortest job first']],
    weighted: [['finish', 'Earliest finish (ignores weights)'], ['heavy', 'Heaviest first'], ['dp', 'Dynamic programming (optimal)']],
  };

  document.querySelectorAll<HTMLElement>('[data-gr]').forEach((root) => {
    const q = query(root);
    const colour = (n: number, c: string) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', c);
    const ruleSel = q<HTMLSelectElement>('[data-rule]');
    let lastProblem = '';
    function bars(rows: [string, number, string][], max: number) {
      const el = q('[data-bars]'); el.textContent = '';
      for (const [name, v, unit] of rows) {
        const row = document.createElement('div'); row.className = 'gr-bar';
        const nm = document.createElement('span'); nm.textContent = name;
        const track = document.createElement('span'); track.className = 'gr-track';
        const fill = document.createElement('span'); fill.className = 'gr-fill'; fill.style.width = `${Math.max(2, (v / Math.max(1, max)) * 100)}%`;
        track.appendChild(fill);
        const num = document.createElement('span'); num.className = 'pg-mono'; num.textContent = `${formatThousands(v)} ${unit}`;
        row.append(nm, track, num); el.appendChild(row);
      }
    }
    function draw() {
      const problem = q<HTMLSelectElement>('[data-problem]').value;
      if (problem !== lastProblem) {
        lastProblem = problem;
        // The Rule list only changes for the two scheduling problems; coin change and knapsack keep the last list (the control is hidden).
        if (RULES[problem]) {
          ruleSel.textContent = '';
          for (const [v, l] of RULES[problem]) { const o = document.createElement('option'); o.value = v; o.textContent = l; ruleSel.appendChild(o); }
        }
      }
      const show = (key: string, on: boolean) => { q(`[data-w="${key}"]`).hidden = !on; };
      show('size', problem === 'interval' || problem === 'weighted'); show('rule', problem === 'interval' || problem === 'weighted');
      show('items', problem === 'knap'); show('coins', problem === 'coin'); show('amount', problem === 'coin');
      q('[data-h1]').textContent = problem === 'coin' ? 'Greedy coins used' : problem === 'knap' ? 'Greedy value' : problem === 'weighted' ? 'Total weight with this rule' : 'Jobs scheduled by this rule';
      const good = 'var(--good)', bad = 'var(--bad)', neutral = 'var(--border)';
      if (problem === 'interval') {
        const n = Number(q<HTMLSelectElement>('[data-size]').value); const rule = ruleSel.value; const jobs = makeJobs(n);
        const [got, ops] = schedule(jobs, rule); const [opt, optOps] = schedule(jobs, 'finish');
        q('[data-note]').textContent = `${formatThousands(n)} jobs with start times in 0 to ${formatThousands(4 * n - 1)} and lengths 1 to 40. A job may start exactly when another ends. The goal is the most jobs with no overlap.`;
        q('[data-o1]').textContent = formatThousands(got); q('[data-n1]').textContent = rule === 'finish' ? 'sorted by finish time, take whatever still fits' : rule === 'start' ? 'sorted by start time: an early start can block many short jobs' : 'short jobs can still sit in the middle of two good ones';
        q('[data-o2]').textContent = formatThousands(opt); q('[data-n2]').textContent = 'earliest finish first is provably optimal for this goal (exchange argument)';
        q('[data-o3]').textContent = got === opt ? 'none' : `${formatThousands(opt - got)} jobs short`; q('[data-n3]').textContent = got === opt ? 'the rule finds the optimum' : 'a plausible rule, a smaller schedule';
        q('[data-o4]').textContent = formatThousands(ops); q('[data-n4]').textContent = `sorting comparisons plus candidate checks (earliest finish: ${formatThousands(optOps)})`;
        colour(1, got === opt ? good : bad); colour(2, good); colour(3, got === opt ? good : bad); colour(4, neutral);
        bars([['This rule', got, 'jobs'], ['Optimum', opt, 'jobs']], opt);
        q('[data-verdict]').textContent = got === opt ? 'This rule is optimal, and a short proof says why.' : `The rule schedules ${Math.round((100 * got) / opt)}% of the best possible number of jobs.`;
      } else if (problem === 'weighted') {
        const n = Number(q<HTMLSelectElement>('[data-size]').value); const rule = ruleSel.value; const r = weighted(n);
        const got = rule === 'finish' ? r.a : rule === 'heavy' ? r.b : r.opt; const ops = rule === 'finish' ? r.opsA : rule === 'heavy' ? r.opsB : r.opsDp;
        q('[data-note]').textContent = `The same ${formatThousands(n)} jobs, each with a weight from 1 to 20. The goal is the largest total weight with no overlap.`;
        q('[data-o1]').textContent = formatThousands(got); q('[data-n1]').textContent = rule === 'finish' ? 'optimal for counting jobs, blind to weights' : rule === 'heavy' ? 'takes heavy jobs that may block several good ones' : 'tries both choices for every job, remembering the best total so far';
        q('[data-o2]').textContent = formatThousands(r.opt); q('[data-n2]').textContent = 'dynamic programming over jobs sorted by finish time';
        q('[data-o3]').textContent = got === r.opt ? 'none' : `${formatThousands(r.opt - got)} weight short`; q('[data-n3]').textContent = got === r.opt ? 'this rule is optimal here' : 'no single sorting rule is right once jobs have different values';
        q('[data-o4]').textContent = formatThousands(ops); q('[data-n4]').textContent = rule === 'dp' ? 'one sort plus a binary search per job: still cheap' : 'sorting comparisons plus checks';
        colour(1, got === r.opt ? good : bad); colour(2, good); colour(3, got === r.opt ? good : bad); colour(4, neutral);
        bars([['This rule', got, 'weight'], ['Optimum', r.opt, 'weight']], r.opt);
        q('[data-verdict]').textContent = got === r.opt ? 'Dynamic programming reaches the optimum.' : `The rule collects ${Math.round((100 * got) / r.opt)}% of the best possible weight.`;
      } else if (problem === 'coin') {
        const coins = q<HTMLSelectElement>('[data-coins]').value.split(',').map(Number);
        const amtInput = q<HTMLInputElement>('[data-amount]'); const amount = Math.max(1, Math.min(100000, Math.round(Number(amtInput.value) || 1)));
        const [g, gOps] = greedyCoins(coins, amount); const { table, ops: dpOps } = bestCoins(coins, amount); const opt = table[amount];
        const check = bestCoins(coins, 1000).table; const bad1000: number[] = [];
        for (let a = 1; a <= 1000; a++) if (greedyCoins(coins, a)[0] !== check[a]) bad1000.push(a);
        q('[data-note]').textContent = `Fewest coins that add up to ${formatThousands(amount)}, with coins ${coins.join(', ')}. Over the amounts 1 to 1,000, greedy is wrong for ${formatThousands(bad1000.length)}${bad1000.length ? `, first at ${bad1000[0]}` : ''}.`;
        q('[data-o1]').textContent = formatThousands(g); q('[data-n1]').textContent = 'take the largest coin that fits, repeatedly';
        q('[data-o2]').textContent = formatThousands(opt); q('[data-n2]').textContent = 'a table of the best answer for every smaller amount';
        q('[data-o3]').textContent = g === opt ? 'none' : `${formatThousands(g - opt)} coin${g - opt === 1 ? '' : 's'} too many`; q('[data-n3]').textContent = g === opt ? 'greedy happens to be optimal for this amount' : 'a smaller coin pair beats the large coin greedy grabbed first';
        q('[data-o4]').textContent = `${formatThousands(gOps)} against ${formatThousands(dpOps)}`; q('[data-n4]').textContent = 'steps for greedy against the table method';
        colour(1, g === opt ? good : bad); colour(2, good); colour(3, g === opt ? good : bad); colour(4, neutral);
        bars([['Greedy', g, 'coins'], ['Optimum', opt, 'coins']], Math.max(g, opt));
        q('[data-verdict]').textContent = bad1000.length === 0 ? 'No amount up to 1,000 breaks greedy for this set (it is not proof for all amounts, but this set is known to be safe).' : `Greedy fails for ${formatThousands(bad1000.length)} of the first 1,000 amounts with this set: cheap, but only sometimes right.`;
      } else {
        const n = Number(q<HTMLSelectElement>('[data-items]').value); const k = knapsack(n);
        q('[data-note]').textContent = `${n} items with weights 5 to 27 and values 10 to 46; the bag holds a third of the total weight (${formatThousands(k.cap)}). Items cannot be split.`;
        q('[data-o1]').textContent = formatThousands(k.total); q('[data-n1]').textContent = 'take items by value per weight while they fit';
        q('[data-o2]').textContent = formatThousands(k.opt); q('[data-n2]').textContent = 'table over capacities, one row per item';
        q('[data-o3]').textContent = k.total === k.opt ? 'none' : `${formatThousands(k.opt - k.total)} value short`; q('[data-n3]').textContent = k.total === k.opt ? 'greedy matched the optimum here' : 'a heuristic: usually close, with no guarantee';
        q('[data-o4]').textContent = `${formatThousands(k.ops)} against ${formatThousands(k.dpOps)}`; q('[data-n4]').textContent = 'steps for greedy against the table method';
        colour(1, k.total === k.opt ? good : bad); colour(2, good); colour(3, k.total === k.opt ? good : bad); colour(4, neutral);
        bars([['Greedy', k.total, 'value'], ['Optimum', k.opt, 'value']], k.opt);
        q('[data-verdict]').textContent = `Greedy gets ${Math.floor((1000 * k.total) / k.opt) / 10}% of the optimum here. If the items could be split, taking them by value per weight would be exactly optimal.`;
      }
    }
    root.addEventListener('change', draw);
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .playground .gr-big { font-size: 1.15rem; font-weight: 600; }
  .playground .gr-bars { display: grid; gap: 6px; }
  .playground .gr-bar { display: grid; grid-template-columns: 6rem 1fr; gap: 2px 8px; align-items: center; }
  .playground .gr-bar .pg-mono { grid-column: 2; }
  .playground .gr-track { display: block; height: 12px; border-radius: 6px; background: var(--surface-2); overflow: hidden; }
  .playground .gr-fill { display: block; height: 100%; background: var(--accent); border-radius: 6px; }
</style>
