---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Fetch the data for a screen with each style and compare requests, round trips, data received and time. Numbers are modelled, not measured.">
  <ol class="how">
    <li>Start with <b>Order history</b> on <b>REST</b>: 5 requests in 2 rounds, because the item calls cannot start until the order ids arrive. Raise the <b>network delay</b> and watch the time grow with each round.</li>
    <li>Switch to <b>GraphQL</b>: 1 request, 1 round, and almost no unused data.</li>
    <li>Try <b>Profile card</b>, which needs very little. REST now over-fetches whole objects, while gRPC sends the same data in a smaller binary form.</li>
  </ol>
  <div class="pg as" data-as>
    <div class="pg-row">
      <label>Screen <select class="pg-in" data-screen><option value="history" selected>Order history (user + 3 orders + items)</option><option value="card">Profile card (name + latest order status)</option></select></label>
      <label>Style <select class="pg-in" data-style><option value="rest" selected>REST</option><option value="graphql">GraphQL</option><option value="grpc">gRPC</option></select></label>
      <label>Network delay per round trip <input type="range" min="50" max="400" step="10" value="150" data-latency /> <b data-latencyval></b></label>
    </div>
    <div class="pg-grid" aria-live="polite">
      <div class="pg-box" style="--c: var(--role-1)"><h3>Requests</h3><span class="pg-mono" data-req></span><span class="pg-note" data-rounds></span></div>
      <div class="pg-box" style="--c: var(--role-2)"><h3>Data received</h3><span class="pg-mono" data-kb></span><span class="pg-note" data-waste></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Time to show the screen</h3><span class="pg-mono" data-time></span></div>
    </div>
    <p class="pg-note" data-note></p>
    <p class="pg-note">Model: each request in a round runs in parallel, a round costs the network delay, and data costs 4 ms per KB. REST sends whole objects (user 2 KB, orders list 4.5 KB or 1.5 KB for one, each order's items 1 KB). GraphQL returns only requested fields plus a small query. gRPC returns the same data as REST in compact binary, about 40% of the size (for the order history, with the items inside the orders, so 2 calls).</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const MS_PER_KB = 4; // transfer time per KB on a mobile link
  interface Result { requests: number; rounds: number; kb: number; needed: number; note: string }
  const table: Record<string, Record<string, Result>> = {
    history: {
      rest: { requests: 5, rounds: 2, kb: 9.5, needed: 1.5, note: 'Items cannot be requested until the order ids are known, so a second round is unavoidable. A purpose-built endpoint could fix this, but then it only suits this one screen.' },
      graphql: { requests: 1, rounds: 1, kb: 1.9, needed: 1.5, note: 'One query names exactly the fields. The server joins the data. Caching this response in the browser or a CDN is harder than for REST.' },
      grpc: { requests: 2, rounds: 1, kb: 3.8, needed: 1.5, note: 'Orders carry their items inside the message, so two calls in one round. Fast and compact, but a browser cannot call gRPC directly without a proxy.' },
    },
    card: {
      rest: { requests: 2, rounds: 1, kb: 3.5, needed: 0.2, note: 'Two parallel calls bring back whole user and order objects when only a name and a status were needed.' },
      graphql: { requests: 1, rounds: 1, kb: 0.5, needed: 0.2, note: 'The query and response are tiny, exactly what the card shows.' },
      grpc: { requests: 2, rounds: 1, kb: 1.4, needed: 0.2, note: 'Same two calls as REST but in compact binary, so it is smaller, though whole messages still arrive.' },
    },
  };
  document.querySelectorAll<HTMLElement>('[data-as]').forEach((root) => {
    const q = query(root);
    function draw() {
      const latency = Number(q<HTMLInputElement>('[data-latency]').value);
      const r = table[q<HTMLSelectElement>('[data-screen]').value][q<HTMLSelectElement>('[data-style]').value];
      q('[data-latencyval]').textContent = `${latency} ms`;
      q('[data-req]').textContent = String(r.requests); q('[data-rounds]').textContent = `${r.rounds} round${r.rounds > 1 ? 's' : ''} of network delay`;
      q('[data-kb]').textContent = `${r.kb} KB`; q('[data-waste]').textContent = `${Math.round((1 - r.needed / r.kb) * 100)}% of it not shown on the screen`;
      q('[data-time]').textContent = `${Math.round(r.rounds * latency + r.kb * MS_PER_KB)} ms`;
      q('[data-note]').textContent = r.note;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
