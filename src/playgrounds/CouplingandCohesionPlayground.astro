---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="One checkout feature with seven modules, built four ways. Each dependency has a coupling kind, from data (loosest) to content (tightest). Pick a design and a change request and see which modules must change, which must be re-tested, and how the coupling score is built from the graph.">
  <ol class="how">
    <li>Start with the defaults: <b>Design</b> <b>Shared global state</b> and <b>Change</b> <b>Add a currency field to the price structure</b>. The graph has <b>14</b> dependencies and a coupling score of <b>56</b>; <b>3</b> other modules must change and <b>5</b> modules are re-tested.</li>
    <li>Set <b>Design</b> to <b>Reaching into internals</b>: the score is <b>70</b>. Set <b>Change</b> to <b>Rewrite how stock is reserved (internal)</b>: <b>2</b> other modules must change, where the shared-state design needs <b>0</b> because its modules never saw the internals.</li>
    <li>Set <b>Design</b> to <b>Narrow interfaces</b>: <b>6</b> dependencies, a score of <b>10</b>, and no other module must change. Set <b>Design</b> to <b>One big module</b>: the score is 0, yet every change re-tests <b>7</b> responsibilities.</li>
  </ol>
  <div class="pg cc" data-cc>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design><option value="0" selected>Shared global state</option><option value="1">Reaching into internals</option><option value="2">Narrow interfaces</option><option value="3">One big module</option></select></label>
      <label>Change <select class="pg-in" data-change><option value="0" selected>Add a currency field to the price structure</option><option value="1">Rewrite how stock is reserved (internal)</option><option value="2">Change the signature of the charge call</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Other modules that must change</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Modules re-tested</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Responsibilities re-tested</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Coupling score</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Modules: red must change, amber is re-tested only</h3>
      <div class="cc-chips" data-chips></div>
      <span class="pg-note" data-verdict></span>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The same change in all four designs</h3>
      <div class="cc-scroll" tabindex="0" role="region" aria-label="The same change in all four designs, as a table"><table class="cc-table" data-table></table></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Dependencies in this design</h3>
      <span class="pg-note" data-deps-note>Each line is a depends on b, with its kind and weight: data 1, stamp 2, control 3, common 4, content 5. The score is the sum.</span>
      <ol class="pg-log" data-deps tabindex="0" aria-label="The dependencies of this design"></ol>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  interface Mod { name: string; has: string[] }
  interface Edge { a: string; b: string; kind: keyof typeof WEIGHT }
  const WEIGHT = { data: 1, stamp: 2, control: 3, common: 4, content: 5 } as const;

  // The same model as the code samples. A change reaches a dependent only through an edge at least this tight; a module that
  // has to change absorbs the change and does not pass it on.
  const THRESHOLD: Record<number, number> = { 1: 5, 2: 2, 3: 1 };
  const NAMES = ['Checkout', 'Cart', 'Pricing', 'Inventory', 'Billing', 'Notifications', 'Reports'];
  const mods: Mod[] = NAMES.map((n) => ({ name: n, has: [n] }));
  const FLOW: [string, string][] = [['Checkout', 'Cart'], ['Checkout', 'Pricing'], ['Checkout', 'Inventory'], ['Checkout', 'Billing'], ['Checkout', 'Notifications'],
    ['Pricing', 'Cart'], ['Inventory', 'Cart'], ['Billing', 'Pricing'], ['Notifications', 'Billing'], ['Notifications', 'Cart'],
    ['Reports', 'Cart'], ['Reports', 'Pricing'], ['Reports', 'Inventory'], ['Reports', 'Billing']];
  const DESIGNS: [string, Mod[], Edge[], string][] = [
    ['Shared global state', mods, FLOW.map(([a, b]) => ({ a, b, kind: 'common' as const })), 'Modules never call each other: they read and write one shared structure. Nothing looks coupled in the call graph.'],
    ['Reaching into internals', mods, FLOW.map(([a, b]) => ({ a, b, kind: 'content' as const })), 'Modules call each other, but read and write each other\'s private fields and internal helpers instead of a public operation, so they depend on how the others are built.'],
    ['Narrow interfaces', mods, ([['Checkout', 'Cart', 'data'], ['Checkout', 'Pricing', 'stamp'], ['Checkout', 'Inventory', 'data'], ['Checkout', 'Billing', 'data'], ['Checkout', 'Notifications', 'control'], ['Reports', 'Checkout', 'stamp']] as [string, string, Edge['kind']][]).map(([a, b, kind]) => ({ a, b, kind })), 'Checkout orchestrates and passes plain values or one small object. The other modules do not know each other.'],
    ['One big module', [{ name: 'Monolith', has: NAMES }], [], 'All seven responsibilities in one module: no dependencies between modules, and the lowest cohesion.'],
  ];
  const CHANGES: [string, string, number][] = [['Add a currency field to the price structure', 'Pricing', 2], ['Rewrite how stock is reserved (internal)', 'Inventory', 1], ['Change the signature of the charge call', 'Billing', 3]];

  function blast(ms: Mod[], edges: Edge[], resp: string, level: number) {
    const home = ms.find((m) => m.has.includes(resp))!.name;
    const change = [home];
    for (const e of edges) if (e.b === home && WEIGHT[e.kind] >= THRESHOLD[level] && !change.includes(e.a)) change.push(e.a);
    const retest = [...change];
    for (const e of edges) if (change.includes(e.b) && !retest.includes(e.a)) retest.push(e.a);
    return { change, retest, resp: retest.reduce((s, n) => s + ms.find((m) => m.name === n)!.has.length, 0) };
  }

  document.querySelectorAll<HTMLElement>('[data-cc]').forEach((root) => {
    const q = query(root);
    const setBox = (n: number, value: number, note: string, tone: 'good' | 'bad' | 'mid') => {
      q(`[data-o${n}]`).textContent = String(value); q(`[data-n${n}]`).textContent = note;
      q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const di = Number(q<HTMLSelectElement>('[data-design]').value), ci = Number(q<HTMLSelectElement>('[data-change]').value);
      const [dname, ms, edges, dnote] = DESIGNS[di], [, resp, level] = CHANGES[ci];
      const r = blast(ms, edges, resp, level), score = edges.reduce((s, e) => s + WEIGHT[e.kind], 0), all = DESIGNS.map(([, m, e]) => blast(m, e, resp, level));
      const others = r.change.length - 1;
      setBox(1, others, others ? r.change.slice(1).join(', ') : 'none: the change stays inside the module', others === 0 ? 'good' : others >= 3 ? 'bad' : 'mid');
      setBox(2, r.retest.length, r.retest.join(', '), 'mid');
      setBox(3, r.resp, 'behaviours covered by the modules to re-test: the cost of low cohesion', r.resp >= 7 ? 'bad' : r.resp <= 3 ? 'good' : 'mid');
      setBox(4, score, `${edges.length} dependencies, each weighted by its kind`, score <= 10 ? 'good' : score >= 56 ? 'bad' : 'mid');
      const chips = q('[data-chips]'); chips.textContent = '';
      for (const m of ms) {
        const c = document.createElement('span'); c.className = 'cc-chip';
        const state = r.change.includes(m.name) ? (m.name === ms.find((x) => x.has.includes(resp))!.name ? 'home' : 'change') : r.retest.includes(m.name) ? 'retest' : 'none';
        c.dataset.state = state; c.textContent = m.has.length > 1 ? `${m.name} (${m.has.length} responsibilities)` : m.name;
        c.title = { home: 'where the change is made', change: 'must change', retest: 're-tested only', none: 'not affected' }[state] as string;
        chips.appendChild(c);
      }
      q('[data-verdict]').textContent = `${dname}: ${dnote}`;
      const table = q('[data-table]'); table.textContent = '';
      const head = table.insertRow(); ['Design', 'Dependencies', 'Score', 'Other modules change', 'Modules re-tested', 'Responsibilities re-tested'].forEach((h) => { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); });
      DESIGNS.forEach(([name, , e], i) => {
        const row = table.insertRow(); if (i === di) row.className = 'on';
        [name, e.length, e.reduce((s, x) => s + WEIGHT[x.kind], 0), all[i].change.length - 1, all[i].retest.length, all[i].resp].forEach((v) => { row.insertCell().textContent = String(v); });
      });
      const list = q('[data-deps]'); list.textContent = '';
      if (!edges.length) { const li = document.createElement('li'); li.textContent = 'none between modules (the dependencies are all inside the one module)'; list.appendChild(li); }
      for (const e of edges) { const li = document.createElement('li'); li.textContent = `${e.a} -> ${e.b}: ${e.kind} (${WEIGHT[e.kind]})`; list.appendChild(li); }
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .cc-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .playground .cc-chip { padding: 4px 10px; border-radius: 999px; border: 2px solid var(--border); font: .82rem var(--font-mono); background: var(--surface); }
  .playground .cc-chip[data-state="home"], .playground .cc-chip[data-state="change"] { border-color: var(--bad); background: color-mix(in srgb, var(--bad) 12%, var(--surface)); }
  .playground .cc-chip[data-state="retest"] { border-color: var(--warn, #b7791f); background: color-mix(in srgb, var(--warn, #b7791f) 14%, var(--surface)); }
  .playground .cc-chip[data-state="none"] { color: var(--muted); border-style: dashed; }
  .playground .cc-scroll { overflow-x: auto; }
  .playground .cc-table { border-collapse: collapse; font: .82rem var(--font-mono); min-width: 100%; }
  .playground .cc-table th, .playground .cc-table td { padding: 4px 8px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
  .playground .cc-table th:first-child, .playground .cc-table td:first-child { text-align: left; }
  .playground .cc-table tr.on td { font-weight: 700; background: var(--accent-soft); }
</style>
