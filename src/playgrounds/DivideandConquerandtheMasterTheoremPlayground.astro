---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Three views of divide and conquer. Merge sort counts comparisons and element copies for real, on fixed data. The recurrence view adds up the cost of every level of the recursion tree. The parallel view compares total work with the longest chain of dependent steps. Nothing is timed.">
  <ol class="how">
    <li>Set <b>View</b> to <b>Merge sort: where to split</b>, <b>Elements</b> to <b>1,000</b> and <b>Split</b> to <b>Half</b>: <b>18,717</b> operations at a recursion depth of <b>11</b>. Choose <b>25% / 75%</b>: <b>23,121</b>. Choose <b>10% / 90%</b>: <b>38,125</b>. Choose <b>One element off</b>: <b>757,941</b> at depth <b>1,000</b>, worse than <b>No splitting (insertion sort)</b>, which needs <b>513,893</b>.</li>
    <li>Set <b>View</b> to <b>Recurrence: which level dominates</b>, <b>Problem</b> to <b>Merge sort</b> and <b>Size</b> to <b>1,024</b>: <b>11,264</b> in total, with every level costing <b>1,024</b>. Choose <b>Combine costs n squared</b>: <b>2,096,128</b>, of which the top level alone is <b>1,048,576</b>, so the splitting bought nothing.</li>
    <li>Still at <b>Size</b> <b>1,024</b>, choose <b>Eight sub-problems, combine n squared (matrix multiply)</b>: <b>2,146,435,072</b>. Choose <b>Seven sub-problems, combine n squared (Strassen)</b>: <b>657,710,813</b>. One fewer sub-problem changes the exponent, not just a constant.</li>
    <li>Set <b>View</b> to <b>Parallel merge sort</b>, <b>Size</b> to <b>1,048,576</b>, <b>Workers</b> to <b>64</b> and <b>Merge</b> to <b>Sequential merge</b>: at least <b>2,097,151</b> steps, because the top merge runs alone, so the time is set by the span and not by the workers. Switch <b>Merge</b> to <b>Parallel merge (model)</b>: at least <b>344,064</b> steps.</li>
  </ol>
  <div class="pg dc" data-dc>
    <div class="pg-row">
      <label>View <select class="pg-in" data-view><option value="sort" selected>Merge sort: where to split</option><option value="rec">Recurrence: which level dominates</option><option value="par">Parallel merge sort</option></select></label>
      <label data-w="n">Elements <select class="pg-in" data-n><option value="100">100</option><option value="1000" selected>1,000</option><option value="2000">2,000</option></select></label>
      <label data-w="split">Split <select class="pg-in" data-split><option value="50" selected>Half</option><option value="25">25% / 75%</option><option value="10">10% / 90%</option><option value="0">One element off</option><option value="ins">No splitting (insertion sort)</option></select></label>
      <label data-w="problem">Problem <select class="pg-in" data-problem><option value="0" selected>Merge sort</option><option value="1">Binary search</option><option value="2">Tree sum</option><option value="3">Four sub-problems, combine n</option><option value="4">Combine costs n squared</option><option value="5">Eight sub-problems, combine n squared (matrix multiply)</option><option value="6">Seven sub-problems, combine n squared (Strassen)</option></select></label>
      <label data-w="k">Size <select class="pg-in" data-k></select></label>
      <label data-w="workers">Workers <select class="pg-in" data-workers><option value="1">1</option><option value="4">4</option><option value="16">16</option><option value="64" selected>64</option><option value="1024">1,024</option></select></label>
      <label data-w="merge">Merge <select class="pg-in" data-merge><option value="seq" selected>Sequential merge</option><option value="par">Parallel merge (model)</option></select></label>
    </div>
    <span class="pg-note" data-note></span>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3 data-h1></h3><span class="pg-mono dc-big" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3 data-h2></h3><span class="pg-mono dc-big" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3 data-h3></h3><span class="pg-mono dc-big" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3 data-h4></h3><span class="pg-mono dc-big" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3 data-h5></h3>
      <div class="dc-bars" data-bars></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const M = 2147483647;
  const rngFrom = (seed: number) => { let s = seed; return () => { s = (s * 48271) % M; return s; }; };

  // The same model as the code samples.
  function makeData(n: number): number[] { const next = rngFrom(31337); const d: number[] = []; for (let i = 0; i < n; i++) d.push(next() % 100000); return d; }
  const ceilLog2 = (n: number) => { let k = 0; while (2 ** k < n) k++; return k; };
  function mergeSort(a: number[], pct: number) {
    const st = { cmp: 0, copy: 0, depth: 0 };
    const sort = (xs: number[], depth: number): number[] => {
      st.depth = Math.max(st.depth, depth);
      const n = xs.length; if (n <= 1) return xs;
      const leftN = pct === 0 ? 1 : Math.max(1, Math.min(n - 1, Math.floor((n * pct) / 100)));
      const left = sort(xs.slice(0, leftN), depth + 1), right = sort(xs.slice(leftN), depth + 1);
      const out: number[] = []; let i = 0, j = 0;
      while (i < left.length && j < right.length) { st.cmp++; if (left[i] <= right[j]) out.push(left[i++]); else out.push(right[j++]); }
      while (i < left.length) out.push(left[i++]);
      while (j < right.length) out.push(right[j++]);
      st.copy += n; return out;
    };
    sort([...a], 1);
    return st;
  }
  function insertionSort(a: number[]) {
    const xs = [...a]; let cmp = 0, moves = 0;
    for (let i = 1; i < xs.length; i++) { const v = xs[i]; let j = i - 1; while (j >= 0) { cmp++; if (xs[j] > v) { xs[j + 1] = xs[j]; moves++; j--; } else break; } xs[j + 1] = v; }
    return { cmp, moves };
  }
  type Case = { name: string; a: number; b: number; kind: '1' | 'n' | 'n2' };
  const CASES: Case[] = [
    { name: 'Merge sort', a: 2, b: 2, kind: 'n' }, { name: 'Binary search', a: 1, b: 2, kind: '1' }, { name: 'Tree sum', a: 2, b: 2, kind: '1' },
    { name: 'Four sub-problems, combine n', a: 4, b: 2, kind: 'n' }, { name: 'Combine costs n squared', a: 2, b: 2, kind: 'n2' },
    { name: 'Matrix multiply, eight sub-problems', a: 8, b: 2, kind: 'n2' }, { name: 'Strassen, seven sub-problems', a: 7, b: 2, kind: 'n2' },
  ];
  const fOf = (kind: string, m: number) => (kind === '1' ? 1 : kind === 'n' ? m : m * m);
  const F_EXP: Record<string, number> = { '1': 0, n: 1, n2: 2 };
  function levelsOf(c: Case, k: number): number[] {
    const n = c.b ** k; const lv: number[] = [];
    for (let i = 0; i < k; i++) lv.push(c.a ** i * fOf(c.kind, n / c.b ** i));
    lv.push(c.a ** k); // the leaves, one unit each
    return lv;
  }
  function verdict(c: Case): string {
    const bc = c.b ** F_EXP[c.kind];
    return c.a > bc ? 'leaves dominate' : c.a === bc ? 'every level costs the same' : 'root dominates';
  }
  const work = (k: number) => levelsOf(CASES[0], k).reduce((s, x) => s + x, 0);
  const spanSeq = (k: number) => 2 ** (k + 1) - 1;
  const spanPar = (k: number) => { let s = 1; for (let j = 1; j <= k; j++) s += j * j; return s; };

  document.querySelectorAll<HTMLElement>('[data-dc]').forEach((root) => {
    const q = query(root);
    const colour = (n: number, c: string) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', c);
    const kSel = q<HTMLSelectElement>('[data-k]');
    let lastView = '';
    const heads = (h: string[]) => h.forEach((t, i) => (q(`[data-h${i + 1}]`).textContent = t));
    function bars(rows: [string, number, string][], log: boolean) {
      const el = q('[data-bars]'); el.textContent = '';
      const top = Math.max(...rows.map((r) => r[1])); const digits = Math.max(2, Math.ceil(Math.log10(top + 1)));
      for (const [name, v, unit] of rows) {
        const row = document.createElement('div'); row.className = 'dc-bar';
        const nm = document.createElement('span'); nm.textContent = name;
        const track = document.createElement('span'); track.className = 'dc-track';
        const f = document.createElement('span'); f.className = 'dc-fill';
        f.style.width = `${Math.max(2, log ? (Math.log10(Math.max(1, v)) / digits) * 100 : (v / Math.max(1, top)) * 100)}%`;
        track.appendChild(f);
        const num = document.createElement('span'); num.className = 'pg-mono'; num.textContent = `${formatThousands(v)} ${unit}`;
        row.append(nm, track, num); el.appendChild(row);
      }
    }
    function fillK(view: string) {
      const ks = view === 'par' ? [10, 16, 20] : [4, 6, 8, 10, 12, 14, 16];
      kSel.textContent = '';
      for (const k of ks) { const o = document.createElement('option'); o.value = String(k); o.textContent = formatThousands(2 ** k); kSel.appendChild(o); }
      kSel.value = String(view === 'par' ? 20 : 10);
    }
    function draw() {
      const view = q<HTMLSelectElement>('[data-view]').value;
      if (view !== lastView) { lastView = view; fillK(view); }
      const show = (key: string, on: boolean) => { q(`[data-w="${key}"]`).hidden = !on; };
      show('n', view === 'sort'); show('split', view === 'sort'); show('problem', view === 'rec'); show('k', view !== 'sort'); show('workers', view === 'par'); show('merge', view === 'par');
      const good = 'var(--good)', bad = 'var(--bad)', neutral = 'var(--border)';
      if (view === 'sort') {
        const n = Number(q<HTMLSelectElement>('[data-n]').value); const split = q<HTMLSelectElement>('[data-split]').value;
        const base = n * ceilLog2(n);
        heads(['Total operations', 'Comparisons / copies', 'Recursion depth', 'Against n x log2 n']);
        q('[data-h5]').textContent = 'Operations by split, log scale';
        const data = makeData(n);
        let total: number, a: number, b: number, depth: number;
        if (split === 'ins') { const r = insertionSort(data); a = r.cmp; b = r.moves; total = a + b; depth = 1; }
        else { const st = mergeSort(data, Number(split)); a = st.cmp; b = st.copy; total = a + b; depth = st.depth; }
        q('[data-note]').textContent = `Sorting ${formatThousands(n)} numbers made by a fixed generator. Operations are comparisons plus element copies (insertion sort: comparisons plus moves). The reference n x ceil(log2 n) is ${formatThousands(base)}.`;
        q('[data-o1]').textContent = formatThousands(total); q('[data-n1]').textContent = 'counted, not timed';
        q('[data-o2]').textContent = `${formatThousands(a)} / ${formatThousands(b)}`; q('[data-n2]').textContent = split === 'ins' ? 'comparisons and moves' : 'comparisons while merging, and one copy per element per merge';
        q('[data-o3]').textContent = split === 'ins' ? 'none' : formatThousands(depth); q('[data-n3]').textContent = split === 'ins' ? 'a loop, no recursion' : depth > 200 ? 'each level of recursion holds a stack frame: this is deep enough to threaten the stack' : 'levels of nested splitting';
        q('[data-o4]').textContent = `${(Math.round((total / base) * 10) / 10).toString()} times`; q('[data-n4]').textContent = total / base < 3 ? 'about two operations per element per level: still n log n' : 'far above n log n: the split is not dividing the problem';
        colour(1, total / base < 3 ? good : bad); colour(2, neutral); colour(3, depth > 200 ? bad : neutral); colour(4, total / base < 3 ? good : bad);
        const rows: [string, number, string][] = [];
        for (const [label, s] of [['Half', '50'], ['25% / 75%', '25'], ['10% / 90%', '10'], ['One element off', '0']] as [string, string][]) { const st = mergeSort(data, Number(s)); rows.push([label, st.cmp + st.copy, 'ops']); }
        const ins = insertionSort(data); rows.push(['Insertion sort', ins.cmp + ins.moves, 'ops']);
        bars(rows, true);
        q('[data-verdict]').textContent = 'Splitting at any fixed fraction keeps the depth logarithmic, so the cost stays n log n with a bigger constant. Splitting off a fixed number of elements makes the depth proportional to n, and the cost n squared.';
      } else if (view === 'rec') {
        const c = CASES[Number(q<HTMLSelectElement>('[data-problem]').value)]; const k = Number(kSel.value); const n = 2 ** k;
        const lv = levelsOf(c, k); const total = lv.reduce((s, x) => s + x, 0);
        heads(['Total work', 'Top level alone', 'Bottom level alone', 'Which level dominates']);
        q('[data-h5]').textContent = 'Work at each level of the recursion tree, log scale';
        const fText = c.kind === '1' ? '1' : c.kind === 'n' ? 'n' : 'n squared';
        q('[data-note]').textContent = `T(n) = ${c.a} T(n / ${c.b}) + ${fText}, for n = ${formatThousands(n)} (${k + 1} levels), and one unit of work for each leaf.`;
        q('[data-o1]').textContent = formatThousands(total); q('[data-n1]').textContent = 'sum over all levels';
        q('[data-o2]').textContent = formatThousands(lv[0]); q('[data-n2]').textContent = 'splitting into sub-problems and combining the answers at the root';
        q('[data-o3]').textContent = formatThousands(lv[k]); q('[data-n3]').textContent = `${formatThousands(c.a ** k)} leaves, one unit each`;
        const v = verdict(c); q('[data-o4]').textContent = v;
        q('[data-n4]').textContent = v === 'leaves dominate' ? 'the total grows like the number of leaves: n to the power log base b of a' : v === 'root dominates' ? 'the top combine step costs about as much as everything below it: splitting is not what helps' : 'about the same cost on each of the log n levels: n log n here';
        colour(1, neutral); colour(2, v === 'root dominates' ? bad : neutral); colour(3, neutral); colour(4, v === 'root dominates' ? bad : good);
        bars(lv.map((x, i) => [i === 0 ? 'Level 0 (top)' : i === k ? `Level ${i} (leaves)` : `Level ${i}`, x, 'units'] as [string, number, string]), true);
        q('[data-verdict]').textContent = 'The master theorem is this comparison done for you: compare the number of leaves with f(n) and the largest wins, or they tie and you multiply by the number of levels. It needs equal-sized splits and a polynomial gap.';
      } else {
        const k = Number(kSel.value); const p = Number(q<HTMLSelectElement>('[data-workers]').value); const merge = q<HTMLSelectElement>('[data-merge]').value;
        const w = work(k), span = merge === 'seq' ? spanSeq(k) : spanPar(k); const wp = Math.ceil(w / p); const best = Math.max(wp, span);
        heads(['Total work', 'Span (longest chain)', 'Best possible time', 'Parallelism available']);
        q('[data-h5]').textContent = 'Time with p workers against the span';
        q('[data-note]').textContent = `Merge sort of ${formatThousands(2 ** k)} elements: both halves are sorted at the same time, then merged. The span is the length of the longest chain of steps that must run one after another.`;
        q('[data-o1]').textContent = formatThousands(w); q('[data-n1]').textContent = 'all comparisons and copies, whatever the number of workers';
        q('[data-o2]').textContent = formatThousands(span); q('[data-n2]').textContent = merge === 'seq' ? 'the final merge is one sequential pass over every element' : 'model: merging m items has span (log2 m) squared, using a merge that is itself split among workers';
        q('[data-o3]').textContent = `at least ${formatThousands(best)} steps`; q('[data-n3]').textContent = `the larger of work / workers (${formatThousands(wp)}) and the span`;
        q('[data-o4]').textContent = formatThousands(Math.floor(w / span)); q('[data-n4]').textContent = 'work divided by span: more workers than this sit idle';
        const limited = wp < span;
        colour(1, neutral); colour(2, limited ? bad : neutral); colour(3, limited ? bad : good); colour(4, neutral);
        bars([['Work / workers', wp, 'steps'], ['Span', span, 'steps']], true);
        q('[data-verdict]').textContent = limited ? `With ${formatThousands(p)} workers the time is limited by the span, not by the workers: adding more changes nothing until the merge itself is parallelised.` : `With ${formatThousands(p)} workers the work per worker is still the larger term, so more workers still help.`;
      }
    }
    root.addEventListener('change', draw);
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .playground .dc-big { font-size: 1.15rem; font-weight: 600; }
  .playground .dc-bars { display: grid; gap: 6px; }
  .playground .dc-bar { display: grid; grid-template-columns: 9rem 1fr; gap: 2px 8px; align-items: center; }
  .playground .dc-bar .pg-mono { grid-column: 2; }
  .playground .dc-track { display: block; height: 12px; border-radius: 6px; background: var(--surface-2); overflow: hidden; }
  .playground .dc-fill { display: block; height: 100%; background: var(--accent); border-radius: 6px; }
  @media (max-width: 560px) { .playground .dc-bar { grid-template-columns: 1fr; } .playground .dc-bar .pg-mono { grid-column: 1; } }
</style>
