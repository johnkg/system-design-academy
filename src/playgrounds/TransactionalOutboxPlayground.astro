---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Place orders while things go wrong. Compare writing the database and the broker separately with using an outbox.">
  <ol class="how">
    <li>In <b>Dual write</b> mode tick <b>App crashes after saving</b> and place an order: the order exists but no event was published.</li>
    <li>Switch to <b>Outbox</b> and repeat. The event waits in the outbox, and <b>Run relay</b> publishes it later.</li>
    <li>In Outbox mode, tick <b>Broker is down</b>, place orders, then untick it and run the relay. Also try <b>Relay crashes after publishing</b> to see duplicates.</li>
  </ol>
  <div class="pg" data-outbox>
    <div class="pg-row" role="group" aria-label="Approach" data-modes></div>
    <div class="pg-row">
      <label><input type="checkbox" data-crash /> App crashes after saving</label>
      <label><input type="checkbox" data-down /> Broker is down</label>
      <label data-relaycrashwrap><input type="checkbox" data-relaycrash /> Relay crashes after publishing</label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-place>Place order</button>
      <button class="btn" type="button" data-relay>Run relay</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-2)"><h3>Database: orders</h3><span class="pg-mono" data-orders></span></div>
      <div class="pg-box" style="--c: var(--role-4)" data-outbox-box><h3>Database: outbox</h3><span class="pg-mono" data-outboxrows></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Broker: events delivered</h3><span class="pg-mono" data-broker></span></div>
    </div>
    <output class="pg-out" data-out aria-live="polite">Place an order.</output>
  </div>
</PlaygroundShell>
<script>
  interface Row { id: number; sent: boolean }
  document.querySelectorAll<HTMLElement>('[data-outbox]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let orders: number[] = []; let outbox: Row[] = []; let broker: number[] = []; let nextId = 1; let useOutbox = false;
    const on = (s: string) => q<HTMLInputElement>(s).checked;
    const say = (t: string, bad = false) => { const o = q('[data-out]'); o.textContent = t; o.classList.toggle('bad', bad); };
    function draw() {
      q('[data-orders]').textContent = orders.length ? orders.map((o) => `order ${o}`).join('\n') : '(none)';
      q('[data-outboxrows]').textContent = outbox.length ? outbox.map((r) => `event ${r.id}: ${r.sent ? 'sent' : 'PENDING'}`).join('\n') : '(none)';
      const seen = new Set<number>(); q('[data-broker]').textContent = broker.length ? broker.map((e) => { const d = seen.has(e); seen.add(e); return `event ${e}${d ? ' (DUPLICATE)' : ''}`; }).join('\n') : '(none)';
      q('[data-outbox-box]').hidden = !useOutbox; q('[data-relaycrashwrap]').hidden = !useOutbox; q<HTMLElement>('[data-relay]').hidden = !useOutbox;
    }
    function place() {
      const id = nextId++; orders.push(id);
      if (useOutbox) { outbox.push({ id, sent: false }); draw(); say(`Order ${id} and its outbox row were saved in ONE transaction${on('[data-crash]') ? ' (the app then crashed, but nothing is lost: the event is safely in the outbox)' : ''}. Press Run relay to publish.`); return; }
      if (on('[data-crash]')) { draw(); say(`Order ${id} saved, then the app crashed before publishing. The event is LOST: other services never learn of order ${id}.`, true); return; }
      if (on('[data-down]')) { draw(); say(`Order ${id} saved, but the broker is down so publishing failed. The event is LOST.`, true); return; }
      broker.push(id); draw(); say(`Order ${id} saved and published. (Worked this time: it only breaks when something fails between the two writes.)`);
    }
    function relay() {
      const pending = outbox.filter((r) => !r.sent);
      if (!pending.length) { say('Nothing pending in the outbox.'); return; }
      if (on('[data-down]')) { say(`Broker is down: ${pending.length} event(s) wait safely in the outbox. Nothing is lost.`); return; }
      if (on('[data-relaycrash]')) {
        const r = pending[0]; broker.push(r.id); draw();
        say(`Relay published event ${r.id} but crashed before marking it as sent. It is still PENDING, so the next run publishes it AGAIN: consumers must ignore duplicates.`, true); return;
      }
      pending.forEach((r) => { broker.push(r.id); r.sent = true; }); draw();
      say(`Relay published ${pending.length} event(s) and marked them sent.`);
    }
    [['Dual write (two separate writes)', false], ['Transactional outbox', true]].forEach(([l, v]) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = l as string; b.setAttribute('aria-pressed', String(v === useOutbox)); b.addEventListener('click', () => { useOutbox = v as boolean; q('[data-modes]').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); reset(); }); q('[data-modes]').appendChild(b); });
    function reset() { orders = []; outbox = []; broker = []; nextId = 1; draw(); say('Place an order.'); }
    q('[data-place]').addEventListener('click', place); q('[data-relay]').addEventListener('click', relay); q('[data-reset]').addEventListener('click', reset);
    reset();
  });
</script>
