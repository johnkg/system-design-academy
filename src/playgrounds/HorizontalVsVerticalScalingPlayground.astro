---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="One traffic slider, two ways to cope. Compare capacity, cost and what happens when a machine fails.">
  <ol class="how">
    <li>Drag <b>traffic</b> up. Watch each side fill up and, past capacity, start dropping requests.</li>
    <li>On the left pick a bigger <b>machine</b>. On the right add <b>servers</b> or turn on autoscaling.</li>
    <li>Press <b>Fail a machine</b> on each side. One side goes dark. The other loses only a slice of capacity.</li>
  </ol>
  <div class="pg" data-scale>
    <label class="pg-row">Traffic <input type="range" min="0" max="2000" step="10" value="250" data-load /> <b data-loadval>250</b> requests/s</label>
    <div class="pg-grid sc-grid">
      <section class="pg-box" style="--c: var(--role-4)" aria-labelledby="sc-v">
        <h3 id="sc-v">Scale up (vertical): one machine</h3>
        <div class="pg-row" role="group" aria-label="Machine size" data-sizes></div>
        <div class="sc-meter"><div class="sc-fill" data-vfill></div></div>
        <span class="pg-mono" data-vstat></span>
        <button class="btn" type="button" data-vfail>Fail the machine</button>
      </section>
      <section class="pg-box" style="--c: var(--role-3)" aria-labelledby="sc-h">
        <h3 id="sc-h">Scale out (horizontal): many small servers</h3>
        <div class="pg-row">
          <button class="btn" type="button" data-less aria-label="Remove a server">−</button>
          <b data-count></b>
          <button class="btn" type="button" data-more aria-label="Add a server">+</button>
          <label><input type="checkbox" data-auto /> Autoscale (target 60%)</label>
        </div>
        <div class="sc-meter"><div class="sc-fill" data-hfill></div></div>
        <span class="pg-mono" data-hstat></span>
        <button class="btn" type="button" data-hfail>Fail a machine</button>
      </section>
    </div>
    <p class="pg-note">Model: a small server handles 100 requests/s and costs $50/month. Bigger machines cost disproportionately more: M handles 250 for $140, L 600 for $400, XL 1,200 for $1,000. XL is the largest size available.</p>
  </div>
</PlaygroundShell>
<script>
  const sizes = [{ n: 'S', cap: 100, cost: 50 }, { n: 'M', cap: 250, cost: 140 }, { n: 'L', cap: 600, cost: 400 }, { n: 'XL', cap: 1200, cost: 1000 }];
  const SMALL = { cap: 100, cost: 50 };
  document.querySelectorAll<HTMLElement>('[data-scale]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let size = 0; let vDown = false; let servers = 1; let failed = 0;
    const load = () => Number(q<HTMLInputElement>('[data-load]').value);

    function status(cap: number, cost: number, down: boolean) {
      const L = load();
      if (down || cap <= 0) return { pct: 0, text: `DOWN: all ${L} req/s fail · cost $${cost}/month`, bad: true };
      const served = Math.min(L, cap); const dropped = L - served; const util = Math.round((L / cap) * 100);
      return { pct: Math.min(100, util), bad: dropped > 0, text: `${util}% utilised · capacity ${cap} req/s${dropped ? ` · dropping ${dropped} req/s` : ''} · cost $${cost}/month` };
    }
    function draw() {
      q('[data-loadval]').textContent = String(load());
      if (q<HTMLInputElement>('[data-auto]').checked) {
        const need = Math.max(1, Math.ceil(load() / (SMALL.cap * 0.6)));
        servers = Math.min(40, need + failed);
      }
      const v = status(sizes[size].cap, sizes[size].cost, vDown);
      q('[data-vfill]').style.width = `${v.pct}%`; q('[data-vfill]').style.background = v.bad ? 'var(--bad)' : 'var(--accent)';
      q('[data-vstat]').textContent = v.text; q('[data-vfail]').textContent = vDown ? 'Repair the machine' : 'Fail the machine';
      const alive = Math.max(0, servers - failed);
      const h = status(alive * SMALL.cap, servers * SMALL.cost, false);
      q('[data-hfill]').style.width = `${h.pct}%`; q('[data-hfill]').style.background = h.bad ? 'var(--bad)' : 'var(--accent)';
      q('[data-hstat]').textContent = `${alive} of ${servers} servers up · ` + h.text; q('[data-count]').textContent = `${servers} servers`;
      q('[data-hfail]').textContent = failed ? 'Repair a machine' : 'Fail a machine';
      q('[data-sizes]').querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-pressed', String(i === size)));
    }
    sizes.forEach((s, i) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = s.n; b.setAttribute('aria-label', `Machine size ${s.n}, ${s.cap} requests per second, $${s.cost} per month`); b.addEventListener('click', () => { size = i; draw(); }); q('[data-sizes]').appendChild(b); });
    q('[data-load]').addEventListener('input', draw);
    q('[data-vfail]').addEventListener('click', () => { vDown = !vDown; draw(); });
    q('[data-more]').addEventListener('click', () => { servers = Math.min(40, servers + 1); q<HTMLInputElement>('[data-auto]').checked = false; draw(); });
    q('[data-less]').addEventListener('click', () => { servers = Math.max(1, servers - 1); failed = Math.min(failed, servers); q<HTMLInputElement>('[data-auto]').checked = false; draw(); });
    q('[data-hfail]').addEventListener('click', () => { failed = failed ? 0 : 1; draw(); });
    q('[data-auto]').addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .sc-meter { height: 16px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .playground .sc-fill { height: 100%; width: 0; border-radius: 99px; transition: width .2s, background .2s; }
  .playground .sc-grid { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
</style>
