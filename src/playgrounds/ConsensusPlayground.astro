---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Five nodes keep a replicated log. An entry is committed (✔) once a majority, 3 of 5, has stored it. Crash nodes and write values to see what is safe.">
  <ol class="how">
    <li>Press <b>Write next value</b> a few times: each entry reaches all five nodes and commits (✔).</li>
    <li>Crash <b>3 followers</b> (nodes 2, 3, 4) and write: the entry reaches only 2 of 5 nodes and stays <b>uncommitted</b>. Recover a node and it commits.</li>
    <li>Press <b>Reset</b> and write once (committed). Crash nodes 2, 3 and 4 and write again: that entry is stored only on nodes 1 and 5. Now crash <b>node 1 and node 5</b>, recover nodes 2, 3 and 4, and press <b>Elect a new leader</b>: the committed entry survives, but the uncommitted one is <b>discarded</b>. Had node 5 been up, it could have been elected and kept it.</li>
  </ol>
  <div class="pg cs" data-cs>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-write>Write next value</button>
      <button class="btn" type="button" data-elect>Elect a new leader</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="pg-row" data-toggles></div>
    <div class="cs-nodes" data-nodes></div>
    <p class="pg-out" data-msg aria-live="polite">The leader is node 1.</p>
  </div>
</PlaygroundShell>
<script>
  const N = 5; const MAJ = 3;
  document.querySelectorAll<HTMLElement>('[data-cs]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let up: boolean[] = []; let logs: string[][] = []; let leader = 0; let commit = 0; let seq = 0;
    const rows = Array.from({ length: N }, (_, i) => { const r = document.createElement('div'); r.className = 'cs-row'; r.innerHTML = '<span class="cs-name"></span><div class="cs-log"></div>'; q('[data-nodes]').appendChild(r); return { r, name: r.querySelector<HTMLElement>('.cs-name')!, log: r.querySelector<HTMLElement>('.cs-log')! }; });
    const toggles = Array.from({ length: N }, (_, i) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.setAttribute('aria-pressed', 'false'); q('[data-toggles]').appendChild(b); b.addEventListener('click', () => { up[i] = !up[i]; if (up[i]) recover(i); draw(i === leader && !up[i] ? 'The leader crashed: no node can accept writes until a new leader is elected.' : up[i] ? `Node ${i + 1} is back and catches up from the leader.` : `Node ${i + 1} crashed.`); }); return b; });
    const holders = (idx: number) => logs.filter((l, i) => up[i] && l.length >= idx).length;
    function recompute() { for (let idx = logs[leader].length; idx > commit; idx--) if (holders(idx) >= MAJ) { commit = idx; break; } }
    function recover(i: number) { if (up[leader] && i !== leader) logs[i] = [...logs[leader]]; recompute(); }
    function reset() { up = Array(N).fill(true); logs = Array.from({ length: N }, () => []); leader = 0; commit = 0; seq = 0; draw('The leader is node 1.'); }
    function write() {
      if (!up[leader]) { draw('There is no leader to accept the write. Elect a new one first.'); return; }
      seq++; const value = `x=${seq}`; logs[leader].push(value);
      logs.forEach((l, i) => { if (i !== leader && up[i]) logs[i] = [...logs[leader]]; });
      const idx = logs[leader].length; const n = holders(idx); recompute();
      draw(n >= MAJ ? `${value} is stored on ${n} of ${N} nodes: a majority, so it is COMMITTED.` : `${value} is stored on only ${n} of ${N} nodes: no majority, so it is NOT committed. The client gets no confirmation.`);
    }
    function elect() {
      const alive = up.map((u, i) => (u ? i : -1)).filter((i) => i >= 0);
      if (up[leader]) { draw('The leader is healthy: no election needed.'); return; }
      if (alive.length < MAJ) { draw(`Only ${alive.length} nodes are up: no majority, so no leader can be elected and the cluster cannot accept writes.`); return; }
      const best = alive.reduce((a, b) => (logs[b].length > logs[a].length ? b : a));
      leader = best;
      const oldLen = Math.max(...logs.map((l) => l.length));
      alive.forEach((i) => { logs[i] = [...logs[leader]]; }); recompute();
      const discarded = oldLen - logs[leader].length;
      draw(`Node ${leader + 1} is elected: it has the most complete log among the nodes that are up.${discarded > 0 ? ` ${discarded} uncommitted entr${discarded > 1 ? 'ies were' : 'y was'} discarded (never committed, so no client was ever promised it).` : ' Every committed entry is present.'}`);
    }
    function draw(msg: string) {
      rows.forEach((r, i) => {
        r.name.textContent = `Node ${i + 1}${i === leader ? ' (leader)' : ''}${up[i] ? '' : ' (down)'}`; r.r.classList.toggle('down', !up[i]);
        r.log.replaceChildren(); logs[i].forEach((v, k) => { const b = document.createElement('b'); b.textContent = `${v}${k < commit ? ' ✔' : ''}`; if (k < commit) b.className = 'c'; r.log.appendChild(b); });
        if (!logs[i].length) { const s = document.createElement('span'); s.className = 'cs-empty'; s.textContent = 'empty'; r.log.appendChild(s); }
      });
      toggles.forEach((b, i) => { b.textContent = up[i] ? `Crash node ${i + 1}` : `Recover node ${i + 1}`; b.setAttribute('aria-pressed', String(!up[i])); });
      const o = q('[data-msg]'); o.textContent = msg; o.classList.toggle('bad', /NOT committed|no leader|no majority|No leader/i.test(msg));
    }
    q('[data-write]').addEventListener('click', write); q('[data-elect]').addEventListener('click', elect); q('[data-reset]').addEventListener('click', reset);
    reset();
  });
</script>
<style is:global>
  .playground .cs-nodes { display: grid; gap: 6px; }
  .playground .cs-row { display: grid; grid-template-columns: 150px 1fr; gap: 8px; align-items: center; }
  .playground .cs-row.down .cs-name { font-style: italic; text-decoration: line-through; }
  .playground .cs-name { font-size: .88rem; font-weight: 600; }
  .playground .cs-log { display: flex; gap: 4px; flex-wrap: wrap; min-height: 28px; align-items: center; }
  .playground .cs-log b { font: .8rem ui-monospace, monospace; padding: 3px 7px; border-radius: 6px; border: 1px dashed var(--border); background: var(--surface); }
  .playground .cs-log b.c { border: 1px solid var(--role-2); background: color-mix(in srgb, var(--role-2) 18%, var(--surface)); }
  .playground .cs-empty { color: var(--muted); font-size: .8rem; }
  @media (max-width: 560px) { .playground .cs-row { grid-template-columns: 1fr; gap: 2px; } }
</style>
