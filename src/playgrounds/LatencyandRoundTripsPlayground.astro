---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Time to first byte" hint="Count the round trips before the page starts, and see what distance, protocol and a nearby edge change. The server itself always takes 20 ms. Figures are modelled.">
  <ol class="how">
    <li>Start with a user on <b>the other side of the world</b> and a first visit over TLS 1.2: four round trips plus a DNS lookup, so the user waits about a second although the server took 20 ms.</li>
    <li>Switch to <b>TLS 1.3</b>, then <b>HTTP/3</b>, and then tick <b>returning visitor</b>: each change removes round trips.</li>
    <li>Tick <b>Serve from a nearby edge</b>: every round trip becomes 10 ms, which beats any protocol improvement.</li>
  </ol>
  <div class="pg lat" data-lat>
    <div class="pg-row">
      <label>User is <select class="pg-in" data-dist><option value="5">In the same city (5 ms)</option><option value="25">In the same country (25 ms)</option><option value="120">On another continent (120 ms)</option><option value="250" selected>On the other side of the world (250 ms)</option></select></label>
      <label>Protocol <select class="pg-in" data-proto><option value="tls12" selected>HTTP/2, TLS 1.2</option><option value="tls13">HTTP/2, TLS 1.3</option><option value="h3">HTTP/3 (QUIC)</option></select></label>
    </div>
    <div class="pg-row">
      <label class="lat-check"><input type="checkbox" data-return /> Returning visitor (session resumption)</label>
      <label class="lat-check"><input type="checkbox" data-dns /> DNS answer already cached</label>
      <label class="lat-check"><input type="checkbox" data-edge /> Serve from a nearby edge (10 ms)</label>
    </div>
    <div class="lat-rows" role="img" aria-label="Timeline" data-rows></div>
    <p class="pg-out" data-total aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const EDGE_RTT_MS = 10; const DNS_MS = 40; const SERVER_MS = 20; // edge round trip, uncached DNS lookup, server think time
  const BAR_MIN_PCT = 0.6; const SLOW_MS = 500;
  document.querySelectorAll<HTMLElement>('[data-lat]').forEach((root) => {
    const q = query(root);
    const on = (s: string) => q<HTMLInputElement>(s).checked;
    const labels = ['DNS lookup', 'TCP handshake', 'TLS handshake', 'QUIC handshake (transport + TLS)', 'Request and first byte'];
    const rows = labels.map((l) => { const r = document.createElement('div'); r.className = 'lat-row'; r.innerHTML = '<span class="lat-name"></span><div class="lat-track"><i></i></div><span class="pg-mono lat-ms"></span>'; r.querySelector('.lat-name')!.textContent = l; q('[data-rows]').appendChild(r); return { r, bar: r.querySelector<HTMLElement>('i')!, ms: r.querySelector<HTMLElement>('.lat-ms')! }; });
    function draw() {
      const rttOrigin = Number(q<HTMLSelectElement>('[data-dist]').value); const rtt = on('[data-edge]') ? EDGE_RTT_MS : rttOrigin; const proto = q<HTMLSelectElement>('[data-proto]').value; const ret = on('[data-return]');
      const dns = on('[data-dns]') ? 0 : DNS_MS;
      let tcp = 0; let tls = 0; let quic = 0;
      if (proto === 'h3') quic = ret ? 0 : 1; else { tcp = 1; tls = proto === 'tls12' ? (ret ? 1 : 2) : (ret ? 0 : 1); }
      const request = 1; const server = SERVER_MS;
      const times = [dns, tcp * rtt, tls * rtt, quic * rtt, request * rtt + server];
      const total = times.reduce((a, b) => a + b, 0); let acc = 0;
      rows.forEach((r, i) => { r.r.hidden = (i === 1 || i === 2) ? proto === 'h3' : i === 3 ? proto !== 'h3' : false; r.bar.style.left = `${(acc / total) * 100}%`; r.bar.style.width = `${Math.max(BAR_MIN_PCT, (times[i] / total) * 100)}%`; r.ms.textContent = `${Math.round(times[i])} ms`; acc += times[i]; });
      q('[data-rows]').setAttribute('aria-label', `Time to first byte ${Math.round(total)} ms`);
      const trips = tcp + tls + quic + request;
      const out = q('[data-total]'); out.classList.toggle('bad', total > SLOW_MS);
      out.textContent = `About ${Math.round(total)} ms until the first byte arrives: ${trips} round trip${trips === 1 ? '' : 's'} at ${rtt} ms${dns ? ` plus a ${DNS_MS} ms DNS lookup` : ''}, plus ${server} ms of server time.`;
    }
    root.addEventListener('change', draw); draw();
  });
</script>
<style is:global>
  .playground .lat-check { display: inline-flex; align-items: center; gap: 6px; }
  .playground .lat-rows { display: grid; gap: 6px; }
  .playground .lat-row { display: grid; grid-template-columns: 210px 1fr 64px; gap: 8px; align-items: center; font-size: .88rem; }
  .playground .lat-row[hidden] { display: none; }
  .playground .lat-track { position: relative; height: 18px; background: var(--surface-2); border-radius: 4px; }
  .playground .lat-track i { position: absolute; top: 2px; bottom: 2px; background: var(--accent); border-radius: 3px; transition: left .15s, width .15s; }
  .playground .lat-ms { text-align: right; }
  @media (max-width: 560px) { .playground .lat-row { grid-template-columns: 1fr; gap: 2px; } .playground .lat-ms { text-align: left; } }
</style>
