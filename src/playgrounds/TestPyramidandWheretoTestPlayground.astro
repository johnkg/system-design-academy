---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="One shop app with 8 known bugs. Choose how many unit, integration and end-to-end tests to write and see which bugs each mix catches, what a run costs and how often it goes red without a bug. Cost is in assumed units: 1 per unit test, 20 per integration test, 150 per end-to-end test.">
  <ol class="how">
    <li>Start with the defaults, <b>60</b> unit tests, <b>12</b> integration tests and <b>3</b> end-to-end tests, the classic pyramid: <b>8 of 8</b> bugs caught for a suite cost of <b>750</b>, and <b>13</b> of 50 runs go red by themselves.</li>
    <li>Set <b>Unit tests</b> to <b>200</b>, <b>Integration tests</b> to <b>0</b> and <b>End-to-end tests</b> to <b>0</b>: all 200 tests pass in a quick, calm suite (cost <b>200</b>), but only <b>3 of 8</b> bugs are caught. The bugs that live between components or in the user journeys are out of reach of a unit test.</li>
    <li>Set <b>Unit tests</b> to <b>5</b>, <b>Integration tests</b> to <b>5</b> and <b>End-to-end tests</b> to <b>60</b>, the ice-cream cone: still <b>8 of 8</b> caught, but the suite now costs <b>9,105</b> and <b>47</b> of 50 runs go red with nothing wrong, so a red build means little.</li>
  </ol>
  <div class="pg tp" data-tp>
    <div class="pg-row">
      <label>Unit tests <select class="pg-in" data-unit>
        <option value="0">0</option><option value="5">5</option><option value="20">20</option><option value="60" selected>60</option><option value="200">200</option>
      </select></label>
      <label>Integration tests <select class="pg-in" data-int>
        <option value="0">0</option><option value="5">5</option><option value="12" selected>12</option><option value="30">30</option>
      </select></label>
      <label>End-to-end tests <select class="pg-in" data-e2e>
        <option value="0">0</option><option value="3" selected>3</option><option value="5">5</option><option value="12">12</option><option value="60">60</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Bugs caught</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Bugs that ship</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Suite cost</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Runs that go red with no bug</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Which test finds each bug first</h3>
      <div class="tp-scroll" tabindex="0" role="region" aria-label="Each bug and the cheapest kind of test that finds it"><table class="tp-table" data-table>
        <thead><tr><th scope="col">Bug</th><th scope="col">Found by</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <span class="pg-note">The cheapest kind that reaches the bug is listed. A bug marked "ships" is not reached by any test in this mix.</span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const KINDS = ['unit tests', 'integration tests', 'end-to-end tests'];
  const COST = [1, 20, 150];
  const FLAKE = [0, 10, 50];
  const RUNS = 50;
  const BUGS: [string, number[]][] = [
    ['Percentage discount rounds down', [1, 3, 8]],
    ['Tax wrong at the exact threshold', [2, 5, 0]],
    ['Coupons stack in the wrong order', [3, 6, 10]],
    ['Order saved with swapped columns', [0, 1, 4]],
    ['API sends cents where dollars expected', [0, 2, 5]],
    ['Payment timeout set too short', [0, 3, 0]],
    ['Pay button wired to the wrong handler', [0, 0, 1]],
    ['Session lost after login redirect', [0, 0, 2]],
  ];

  // The same model as the code samples.
  function seeded(seed: number) {
    let s = seed;
    return (n: number) => { s = (s * 48271) % 2147483647; return s % n; };
  }
  function evaluate(counts: number[]) {
    const found = BUGS.map(([, need]) => KINDS.findIndex((_, i) => need[i] > 0 && counts[i] >= need[i]));
    const cost = counts.reduce((sum, n, i) => sum + n * COST[i], 0);
    const rand = seeded(42);
    let red = 0;
    for (let r = 0; r < RUNS; r++) {
      let flaked = false;
      counts.forEach((n, i) => { for (let t = 0; t < n; t++) if (rand(1000) < FLAKE[i]) flaked = true; });
      if (flaked) red++;
    }
    return { found, cost, red };
  }

  document.querySelectorAll<HTMLElement>('[data-tp]').forEach((root) => {
    const q = query(root);
    const tbody = q('[data-table] tbody');
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const counts = ['[data-unit]', '[data-int]', '[data-e2e]'].map((s) => Number(q<HTMLSelectElement>(s).value));
      const { found, cost, red } = evaluate(counts);
      const caught = found.filter((f) => f >= 0).length;
      set(1, `${caught} of ${BUGS.length}`, `with ${counts.reduce((a, b) => a + b, 0)} tests in total`);
      box(1, caught === BUGS.length);
      set(2, String(BUGS.length - caught), caught === BUGS.length ? 'nothing in the list gets past this suite' : 'these reach users: the suite is green and the bug is live');
      box(2, caught === BUGS.length);
      set(3, formatThousands(cost), 'assumed units to run the whole suite once');
      box(3, cost <= 2000);
      set(4, `${red} of ${RUNS}`, 'runs where at least one test failed by itself (1 in 100 for an integration test, 1 in 20 for an end-to-end test)');
      box(4, red <= 15);
      tbody.textContent = '';
      BUGS.forEach(([name], i) => {
        const tr = document.createElement('tr');
        const th = document.createElement('th'); th.setAttribute('scope', 'row'); th.textContent = name;
        const td = document.createElement('td'); td.textContent = found[i] >= 0 ? KINDS[found[i]] : 'ships';
        if (found[i] < 0) tr.className = 'sel';
        tr.append(th, td); tbody.appendChild(tr);
      });
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .tp-scroll { overflow-x: auto; }
  .playground .tp-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .tp-table th, .playground .tp-table td { padding: 5px 8px; border-bottom: 1px solid var(--border); text-align: left; }
  .playground .tp-table tr.sel { background: var(--accent-soft); font-weight: 600; }
</style>
