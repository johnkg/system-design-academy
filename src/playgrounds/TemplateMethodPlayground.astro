---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Run the recipe for different drinks. Shared steps come from the base class; coloured steps are overridden.">
  <ol class="how">
    <li>Choose a <b>drink</b> and press <b>prepare()</b>.</li>
    <li>Toggle the <b>hook</b> to skip the optional step.</li>
    <li>Press <b>+ Add HotChocolate</b>: only two methods to write; the order is inherited.</li>
  </ol>
  <div class="pg" data-template>
    <div class="pg-row" role="group" aria-label="Drink" data-drinks></div>
    <label class="pg-row"><input type="checkbox" data-hook checked /> wantsCondiments() hook returns true</label>
    <ol class="tm-steps" data-steps></ol>
    <div class="pg-row"><button class="btn pg-primary" type="button" data-run>prepare()</button></div>
    <p class="pg-note" data-note aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  interface Drink { name: string; brew: string; extra: string }
  const drinks: Drink[] = [{ name: 'Tea', brew: 'Steeping the tea bag', extra: 'Adding lemon' }, { name: 'Coffee', brew: 'Dripping coffee through the filter', extra: 'Adding sugar and milk' }];
  const MAX_DRINKS = 3; // the add button offers one extra subclass
  const STEP_MS = 600; // animation pause per template step
  const wait = (ms: number) => new Promise((r) => setTimeout(r, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : ms));
  document.querySelectorAll<HTMLElement>('[data-template]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let cur = drinks[0]; let run = 0;
    function steps(hook: boolean) { return [
      { t: 'boilWater()', d: 'Boiling water', own: false }, { t: 'brew()', d: cur.brew, own: true }, { t: 'pour()', d: 'Pouring into cup', own: false },
      { t: 'addCondiments()', d: hook ? cur.extra : 'skipped by the hook', own: true, skipped: !hook } ]; }
    function draw(active = -1) {
      const hook = q<HTMLInputElement>('[data-hook]').checked;
      q('[data-steps]').innerHTML = steps(hook).map((s, i) => `<li class="tm-step ${s.own ? 'own' : 'shared'} ${i === active ? 'on' : ''} ${(s as { skipped?: boolean }).skipped ? 'skip' : ''}"><b>${i + 1}. ${s.t}</b><span>${s.d}</span><em>${s.own ? `overridden by ${cur.name}` : 'shared (base class)'}</em></li>`).join('');
      const b = q('[data-drinks]'); b.innerHTML = '';
      drinks.forEach((d) => { const x = document.createElement('button'); x.type = 'button'; x.className = 'btn'; x.textContent = d.name; x.setAttribute('aria-pressed', String(d === cur)); x.addEventListener('click', () => { cur = d; draw(); }); b.appendChild(x); });
      if (drinks.length < MAX_DRINKS) { const a = document.createElement('button'); a.type = 'button'; a.className = 'btn'; a.textContent = '+ Add HotChocolate'; a.addEventListener('click', () => { drinks.push({ name: 'HotChocolate', brew: 'Stirring in cocoa powder', extra: 'Adding marshmallows' }); cur = drinks[2]; q('[data-note]').textContent = 'HotChocolate overrides brew() and addCondiments() only. The order is inherited.'; draw(); }); b.appendChild(a); }
    }
    q('[data-run]').addEventListener('click', async () => { const id = ++run; const hook = q<HTMLInputElement>('[data-hook]').checked; for (let i = 0; i < steps(hook).length; i++) { if (id !== run) return; draw(i); await wait(STEP_MS); } draw(); });
    q('[data-hook]').addEventListener('change', () => draw());
    draw();
  });
</script>
<style is:global>
  .playground .tm-steps { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .playground .tm-step { display: grid; grid-template-columns: 170px 1fr auto; gap: 8px; align-items: baseline; padding: 8px 12px; border-radius: 8px; border: 2px solid var(--border); background: var(--surface); transition: background .3s, border-color .3s; }
  .playground .tm-step.own { border-color: var(--role-4); } .playground .tm-step.shared { border-color: var(--role-2); }
  .playground .tm-step.on { background: var(--accent-soft); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent); }
  .playground .tm-step.skip span { text-decoration: line-through; color: var(--muted); }
  .playground .tm-step b { font: .85rem ui-monospace, monospace; } .playground .tm-step em { font-size: .72rem; color: var(--muted); }
  @media (max-width: 520px) { .playground .tm-step { grid-template-columns: 1fr; } }
</style>
