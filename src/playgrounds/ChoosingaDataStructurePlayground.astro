---
import PlaygroundShell from '../components/PlaygroundShell.astro';
const SIZES = [10, 100, 1000, 10000, 100000];
const MIXES = [
  ['Lookup-heavy: 1,000 lookups, 10 inserts', 1000, 10, 0, 0],
  ['Insert-heavy: 10 lookups, 1,000 inserts', 10, 1000, 0, 0],
  ['Range reports: 20 lookups, 5 inserts, 500 ranges', 20, 5, 500, 0],
  ['Priority queue: 500 inserts, 500 smallest', 0, 500, 0, 500],
  ['Mixed: 200 of each operation', 200, 200, 200, 200],
] as const;
---
<PlaygroundShell title="Simulate it" hint="Six structures hold the same keys and run the same workload. The page runs real code with a step counter: a step is one element visited, compared, written or shifted. Pick a workload and the number of items and see which structure needs the fewest steps.">
  <ol class="how">
    <li>Keep <b>Items</b> at <b>1,000</b> and set <b>Workload</b> to <b>Lookup-heavy</b>: <b>hash map</b> needs <b>2,010</b> steps, <b>balanced tree</b> <b>9,087</b>, <b>sorted array</b> <b>11,483</b> and <b>unsorted array</b> <b>500,510</b>.</li>
    <li>Set <b>Workload</b> to <b>Insert-heavy</b>: the <b>hash map</b> needs <b>1,089</b> steps and the <b>sorted array</b> <b>741,857</b>, because every insert shifts the elements after it.</li>
    <li>Set <b>Workload</b> to <b>Priority queue</b>: <b>binary heap</b> <b>1,875</b>, <b>balanced tree</b> <b>9,982</b>, <b>sorted array</b> <b>307,586</b>, and <b>hash map</b> <b>2,001,000</b>, since it has to visit everything to find the smallest.</li>
    <li>Set <b>Workload</b> to <b>Range reports</b>: <b>balanced tree</b> needs <b>10,141</b> steps and <b>sorted array</b> <b>11,011</b>. Now set <b>Pointer step costs</b> to <b>4 array steps</b>: the tree's weighted cost becomes <b>40,564</b> and the sorted array wins. Counted steps are not time.</li>
  </ol>
  <div class="pg ds" data-ds>
    <div class="pg-row">
      <label>Workload <select class="pg-in" data-mix>{MIXES.map(([t], i) => <option value={i}>{t.split(':')[0]}</option>)}</select></label>
      <label>Items <select class="pg-in" data-n>{SIZES.map((n) => <option value={n} selected={n === 1000}>{n.toLocaleString('en-US')}</option>)}</select></label>
      <label>Pointer step costs <select class="pg-in" data-w>
        <option value="1" selected>1 array step</option>
        <option value="2">2 array steps</option>
        <option value="4">4 array steps</option>
        <option value="8">8 array steps</option>
      </select></label>
    </div>
    <p class="pg-note" data-mixnote></p>
    <div class="ds-scroll" tabindex="0" role="region" aria-label="Steps for each data structure">
      <table class="ds-table">
        <thead><tr><th scope="col">Structure</th><th scope="col">Lookups</th><th scope="col">Inserts</th><th scope="col">Ranges</th><th scope="col">Smallest</th><th scope="col">Total steps</th><th scope="col">Times the fewest</th><th scope="col">Total, log scale</th></tr></thead>
        <tbody data-rows></tbody>
      </table>
    </div>
    <p class="pg-out" data-verdict role="status"></p>
    <p class="pg-note">Steps are counted, not timed. The linked list and the tree follow pointers, which on real hardware is typically slower per step than walking an array, because arrays sit together in memory and the processor reads ahead. <b>Pointer step costs</b> multiplies the totals of the linked list and the tree to show how an assumed penalty can change the winner. It is an assumption, not a measurement. Each insert into the sorted array is counted as the number of elements shifted, though a real array moves them with one fast bulk copy. The hash map is sized once for the data and resizing is not counted. Range queries return about 10 keys. The bar is the number of digits of the total (full bar: 8 digits or more).</p>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands, formatOneDecimalBelow100 } from '../playground';

  // The same model as the code samples.
  let ops = 0;
  const SPACE = 1000003;
  const key = (i: number) => (i * 7919 + 13) % SPACE;
  interface Struct { lookup(k: number): number; insert(k: number): void; range(lo: number, hi: number): number; smallest(): number }

  class UnsortedArray implements Struct {
    a: number[];
    constructor(keys: number[]) { this.a = keys.slice(); }
    lookup(k: number) { for (const x of this.a) { ops++; if (x === k) return 1; } return 0; }
    insert(k: number) { ops++; this.a.push(k); }
    range(lo: number, hi: number) { let f = 0; for (const x of this.a) { ops++; if (lo <= x && x < hi) f++; } return f; }
    smallest() { let best = this.a[0]; for (const x of this.a) { ops++; best = Math.min(best, x); } return best; }
  }
  class SortedArray implements Struct {
    s: number[];
    constructor(keys: number[]) { this.s = keys.slice().sort((x, y) => x - y); }
    lowerBound(k: number) {
      let lo = 0, hi = this.s.length;
      while (lo < hi) { ops++; const mid = Math.floor((lo + hi) / 2); if (this.s[mid] < k) lo = mid + 1; else hi = mid; }
      return lo;
    }
    lookup(k: number) { const i = this.lowerBound(k); ops++; return i < this.s.length && this.s[i] === k ? 1 : 0; }
    insert(k: number) { const i = this.lowerBound(k); ops += 1 + this.s.length - i; this.s.splice(i, 0, k); }
    range(lo: number, hi: number) {
      let i = this.lowerBound(lo), f = 0;
      while (i < this.s.length) { ops++; if (this.s[i] >= hi) break; f++; i++; }
      return f;
    }
    smallest() { ops++; return this.s[0]; }
  }
  class ListNode { constructor(public k: number, public next: ListNode | null) {} }
  class LinkedList implements Struct {
    head: ListNode | null = null;
    constructor(keys: number[]) { for (const k of keys) this.head = new ListNode(k, this.head); }
    lookup(k: number) { for (let n = this.head; n; n = n.next) { ops++; if (n.k === k) return 1; } return 0; }
    insert(k: number) { ops++; this.head = new ListNode(k, this.head); }
    range(lo: number, hi: number) { let f = 0; for (let n = this.head; n; n = n.next) { ops++; if (lo <= n.k && n.k < hi) f++; } return f; }
    smallest() { let best = this.head!.k; for (let n = this.head; n; n = n.next) { ops++; best = Math.min(best, n.k); } return best; }
  }
  class HashMap implements Struct {
    t: number[][]; count = 0;
    constructor(keys: number[], public b: number) {
      this.t = Array.from({ length: b }, () => []);
      for (const k of keys) { this.t[k % b].push(k); this.count++; }
    }
    lookup(k: number) { ops++; for (const x of this.t[k % this.b]) { ops++; if (x === k) return 1; } return 0; }
    insert(k: number) { ops++; const chain = this.t[k % this.b]; for (let i = 0; i < chain.length; i++) ops++; chain.push(k); this.count++; }
    range(lo: number, hi: number) { ops += this.b + this.count; let f = 0; for (const c of this.t) for (const x of c) if (lo <= x && x < hi) f++; return f; }
    smallest() { ops += this.b + this.count; let best = Infinity; for (const c of this.t) for (const x of c) best = Math.min(best, x); return best; }
  }
  class AvlNode { l: AvlNode | null = null; r: AvlNode | null = null; h = 1; constructor(public k: number) {} }
  const height = (n: AvlNode | null) => (n ? n.h : 0);
  const update = (n: AvlNode) => { n.h = 1 + Math.max(height(n.l), height(n.r)); };
  function rotRight(y: AvlNode) { ops++; const x = y.l!; y.l = x.r; x.r = y; update(y); update(x); return x; }
  function rotLeft(x: AvlNode) { ops++; const y = x.r!; x.r = y.l; y.l = x; update(x); update(y); return y; }
  function avlInsert(n: AvlNode | null, k: number): AvlNode {
    ops++;
    if (n === null) return new AvlNode(k);
    if (k < n.k) n.l = avlInsert(n.l, k); else n.r = avlInsert(n.r, k);
    update(n);
    const bal = height(n.l) - height(n.r);
    if (bal > 1) { if (height(n.l!.l) < height(n.l!.r)) n.l = rotLeft(n.l!); return rotRight(n); }
    if (bal < -1) { if (height(n.r!.r) < height(n.r!.l)) n.r = rotRight(n.r!); return rotLeft(n); }
    return n;
  }
  class BalancedTree implements Struct {
    root: AvlNode | null = null;
    constructor(keys: number[]) { for (const k of keys) this.root = avlInsert(this.root, k); }
    lookup(k: number) { for (let n = this.root; n;) { ops++; if (k === n.k) return 1; n = k < n.k ? n.l : n.r; } return 0; }
    insert(k: number) { this.root = avlInsert(this.root, k); }
    range(lo: number, hi: number) {
      let f = 0;
      const walk = (n: AvlNode | null) => {
        if (n === null) return;
        ops++;
        if (lo < n.k) walk(n.l);
        if (lo <= n.k && n.k < hi) f++;
        if (n.k < hi) walk(n.r);
      };
      walk(this.root);
      return f;
    }
    smallest() { let n = this.root!; while (n.l) { ops++; n = n.l; } ops++; return n.k; }
  }
  class MinHeap implements Struct {
    h: number[] = [];
    constructor(keys: number[]) { for (const k of keys) this.insert(k); }
    lookup(k: number) { for (const x of this.h) { ops++; if (x === k) return 1; } return 0; }
    insert(k: number) {
      ops++;
      this.h.push(k);
      let i = this.h.length - 1;
      while (i > 0) {
        const p = Math.floor((i - 1) / 2);
        ops++;
        if (this.h[p] > this.h[i]) { [this.h[p], this.h[i]] = [this.h[i], this.h[p]]; i = p; } else break;
      }
    }
    range(lo: number, hi: number) { let f = 0; for (const x of this.h) { ops++; if (lo <= x && x < hi) f++; } return f; }
    smallest() { ops++; return this.h[0]; }
  }
  const STRUCTURES: { name: string; make: (keys: number[], buckets: number) => Struct; pointer: boolean }[] = [
    { name: 'unsorted array', make: (k) => new UnsortedArray(k), pointer: false },
    { name: 'sorted array', make: (k) => new SortedArray(k), pointer: false },
    { name: 'linked list', make: (k) => new LinkedList(k), pointer: true },
    { name: 'hash map', make: (k, b) => new HashMap(k, b), pointer: false },
    { name: 'balanced tree', make: (k) => new BalancedTree(k), pointer: true },
    { name: 'binary heap', make: (k) => new MinHeap(k), pointer: false },
  ];
  const MIXES: [number, number, number, number, string][] = [
    [1000, 10, 0, 0, '1,000 lookups and 10 inserts'],
    [10, 1000, 0, 0, '10 lookups and 1,000 inserts'],
    [20, 5, 500, 0, '20 lookups, 5 inserts and 500 range queries'],
    [0, 500, 0, 500, '500 inserts and 500 reads of the smallest key'],
    [200, 200, 200, 200, '200 lookups, 200 inserts, 200 range queries and 200 reads of the smallest key'],
  ];
  function run(make: (keys: number[], buckets: number) => Struct, n: number, lookups: number, inserts: number, ranges: number, smallests: number) {
    const keys: number[] = [];
    for (let i = 0; i < n; i++) keys.push(key(i));
    const s = make(keys, 2 * (n + inserts) + 1);
    ops = 0;
    for (let t = 0; t < lookups; t++) s.lookup(key((t * 37 + 11) % n));
    const lk = ops; ops = 0;
    const width = Math.floor((10 * SPACE) / n);
    for (let t = 0; t < ranges; t++) { const lo = (t * 104729) % SPACE; s.range(lo, lo + width); }
    const rg = ops; ops = 0;
    for (let t = 0; t < smallests; t++) s.smallest();
    const sm = ops; ops = 0;
    for (let t = 0; t < inserts; t++) s.insert(key(n + t));
    return { lk, ins: ops, rg, sm };
  }
  const digits = (x: number) => String(Math.round(x)).length;

  document.querySelectorAll<HTMLElement>('[data-ds]').forEach((root) => {
    const q = query(root);
    const val = (s: string) => Number(q<HTMLSelectElement>(s).value);
    const rows = q('[data-rows]');
    function draw() {
      const [l, i, r, m, text] = MIXES[val('[data-mix]')];
      const n = val('[data-n]'), w = val('[data-w]');
      q('[data-mixnote]').textContent = `Workload: ${text}, on ${formatThousands(n)} items. Ranges return about 10 keys each.`;
      const res = STRUCTURES.map((s) => {
        const c = run(s.make, n, l, i, r, m);
        const total = (c.lk + c.ins + c.rg + c.sm) * (s.pointer ? w : 1);
        return { name: s.name, c, total };
      });
      const best = Math.min(...res.map((x) => x.total));
      rows.textContent = '';
      for (const x of res) {
        const tr = document.createElement('tr');
        if (x.total === best) tr.className = 'win';
        const ratio = x.total / best;
        [x.name, formatThousands(x.c.lk), formatThousands(x.c.ins), formatThousands(x.c.rg), formatThousands(x.c.sm), formatThousands(x.total), x.total === best ? 'fewest' : formatOneDecimalBelow100(ratio)].forEach((t, k) => {
          const cell = document.createElement(k === 0 ? 'th' : 'td'); if (k === 0) cell.setAttribute('scope', 'row'); cell.textContent = t; tr.appendChild(cell);
        });
        const bar = document.createElement('td');
        const fill = document.createElement('span'); fill.className = 'ds-bar';
        fill.style.width = `${Math.min(100, Math.max(3, digits(x.total) * 12.5))}%`;
        fill.style.background = x.total === best ? 'var(--good)' : ratio > 100 ? 'var(--bad)' : 'var(--signal)';
        bar.appendChild(fill); tr.appendChild(bar);
        rows.appendChild(tr);
      }
      const winners = res.filter((x) => x.total === best).map((x) => x.name).join(' and ');
      const worst = res.reduce((a, b) => (b.total > a.total ? b : a));
      q('[data-verdict]').textContent = `Fewest steps: ${winners}, with ${formatThousands(best)}. The most: ${worst.name}, with ${formatThousands(worst.total)}${worst.total > best ? `, ${formatOneDecimalBelow100(worst.total / best)} times as many` : ''}.`;
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .ds-scroll { overflow-x: auto; }
  .playground .ds-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .ds-table th, .playground .ds-table td { text-align: left; padding: 5px 8px; border-bottom: 1px solid var(--border); white-space: nowrap; }
  .playground .ds-table td { font-family: var(--font-mono); }
  .playground .ds-table tr.win { background: var(--accent-soft); font-weight: 600; }
  .playground .ds-table td:last-child { min-width: 90px; width: 14%; }
  .playground .ds-bar { display: block; height: 12px; border-radius: 3px; }
</style>
