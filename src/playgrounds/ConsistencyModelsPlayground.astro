---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Post a comment, then refresh. See what each consistency model lets you see.">
  <ol class="how">
    <li>Start with <b>Eventual</b>: press <b>Post a comment</b>, then <b>Refresh</b> several times quickly. Read the log for surprises.</li>
    <li>Switch to <b>Read-your-writes</b> and <b>Monotonic reads</b> and repeat. Each removes one kind of surprise.</li>
    <li>Switch to <b>Strong</b>: no surprises, but every read is slower.</li>
  </ol>
  <div class="pg" data-cons>
    <div class="pg-row" role="group" aria-label="Consistency model" data-models></div>
    <div class="pg-grid" data-nodes></div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-post>Post a comment</button>
      <button class="btn" type="button" data-refresh>Refresh</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <ol class="pg-log cs-log" data-log aria-label="What you saw"></ol>
    <output class="pg-out" data-out aria-live="polite">Post a comment, then refresh.</output>
  </div>
</PlaygroundShell>
<script>
  type Model = 'eventual' | 'ryw' | 'mono' | 'strong';
  interface Node { name: string; v: number; lag: number; ms: number }
  document.querySelectorAll<HTMLElement>('[data-cons]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const models: { id: Model; label: string }[] = [{ id: 'eventual', label: 'Eventual' }, { id: 'ryw', label: 'Read-your-writes' }, { id: 'mono', label: 'Monotonic reads' }, { id: 'strong', label: 'Strong' }];
    let model: Model = 'eventual'; let nodes: Node[] = []; let myLast = 2; let lastSeen = 0; let reads = 0; let timers: number[] = [];
    const cards: { box: HTMLElement; h: HTMLElement; b: HTMLElement }[] = [];
    function fresh() { nodes = [{ name: 'Primary', v: 2, lag: 0, ms: 80 }, { name: 'Replica 1', v: 2, lag: 600, ms: 10 }, { name: 'Replica 2', v: 2, lag: 2200, ms: 10 }]; }
    function reset() { timers.forEach(clearTimeout); timers = []; fresh(); myLast = 2; lastSeen = 0; reads = 0; q('[data-log]').innerHTML = ''; draw(); q('[data-out]').classList.remove('bad'); q('[data-out]').textContent = 'Post a comment, then refresh.'; }
    function draw() { const top = nodes[0].v; nodes.forEach((n, i) => { cards[i].box.style.setProperty('--c', n.v < top ? 'var(--role-4)' : 'var(--role-3)'); cards[i].h.textContent = n.name; cards[i].b.textContent = `${n.v} comments${n.v < top ? ` (behind by ${top - n.v})` : ''} · read takes ${n.ms} ms`; }); }
    function post() {
      const v = nodes[0].v + 1; nodes[0].v = v; myLast = v; draw();
      nodes.slice(1).forEach((n) => timers.push(window.setTimeout(() => { n.v = Math.max(n.v, v); draw(); }, n.lag)));
      q('[data-out]').classList.remove('bad'); q('[data-out]').textContent = `Comment ${v} saved on the primary. Replica 1 gets it in ${nodes[1].lag} ms, Replica 2 in ${nodes[2].lag} ms.`;
    }
    function refresh() {
      reads++; const rep = nodes.slice(1); let from: Node;
      if (model === 'strong') from = nodes[0];
      else if (model === 'eventual') from = rep[Math.floor(Math.random() * rep.length)];
      else if (model === 'ryw') { const ok = rep.filter((n) => n.v >= myLast); from = ok.length ? ok[Math.floor(Math.random() * ok.length)] : nodes[0]; }
      else { const ok = nodes.filter((n) => n.v >= lastSeen); const rr = ok.filter((n) => n !== nodes[0]); from = (rr.length ? rr : ok)[Math.floor(Math.random() * (rr.length ? rr : ok).length)]; }
      const saw = from.v; const flags: string[] = [];
      if (saw < myLast) flags.push('missed your own comment!'); if (saw < lastSeen) flags.push('went backwards!');
      lastSeen = Math.max(lastSeen, saw);
      const li = document.createElement('li'); li.className = flags.length ? 'cs-bad' : ''; li.textContent = `Refresh ${reads}: saw ${saw} comments from ${from.name} in ${from.ms} ms${flags.length ? ' ⚠ ' + flags.join(' ') : ''}`;
      q('[data-log]').prepend(li); q('[data-out]').textContent = flags.length ? `Surprise: ${flags.join(' and ')}` : `Saw ${saw} comments from ${from.name}. Nothing surprising.`; q('[data-out]').classList.toggle('bad', flags.length > 0);
    }
    [0, 1, 2].forEach(() => { const box = document.createElement('div'); box.className = 'pg-box'; box.innerHTML = '<h3></h3><span class="pg-mono"></span>'; q('[data-nodes]').appendChild(box); cards.push({ box, h: box.querySelector('h3')!, b: box.querySelector('span')! }); });
    models.forEach((m) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = m.label; b.setAttribute('aria-pressed', String(m.id === model)); b.addEventListener('click', () => { model = m.id; q('[data-models]').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); reset(); }); q('[data-models]').appendChild(b); });
    q('[data-post]').addEventListener('click', post); q('[data-refresh]').addEventListener('click', refresh); q('[data-reset]').addEventListener('click', reset);
    reset();
  });
</script>
<style is:global>
  .playground .cs-log { max-height: 190px; }
  .playground .cs-log .cs-bad { color: var(--bad-text); font-weight: 600; }
</style>
