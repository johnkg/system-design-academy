---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="An order service reserves stock and charges a payment gateway. It is tested with different kinds of test double, then hit with 6 real bugs and 2 harmless refactors. Cost is in assumed units per suite run.">
  <ol class="how">
    <li>Set <b>Test style</b> to <b>Stubs, assert the result</b>: the suite is cheap (cost <b>2</b>) and always green, and <b>0 of 6</b> bugs are caught. All <b>6</b> are green but wrong in production.</li>
    <li>Set <b>Test style</b> to <b>Strict mocks, assert the calls</b>: <b>5 of 6</b> bugs are caught, but <b>2 of 2</b> harmless refactors now break the tests, because the tests pin down how the service works and not what it does. Set <b>Test style</b> to <b>Mock everything, calculator too</b> and it is worse: only <b>4 of 6</b> caught and still <b>2 of 2</b> refactors break.</li>
    <li>Set <b>Test style</b> to <b>Fakes, assert the state</b>: <b>5 of 6</b> caught, and <b>0 of 2</b> refactors break the tests. The one bug that gets through is the missing idempotency key, which the fake does not know the real gateway requires.</li>
    <li>Tick <b>Add a contract test against the real sandbox</b>: <b>6 of 6</b> bugs are caught, at a cost of <b>86</b>.</li>
  </ol>
  <div class="pg td" data-td>
    <div class="pg-row">
      <label>Test style <select class="pg-in" data-style>
        <option value="0" selected>Stubs, assert the result</option>
        <option value="1">Strict mocks, assert the calls</option>
        <option value="2">Mock everything, calculator too</option>
        <option value="3">Fakes, assert the state</option>
      </select></label>
      <label><input type="checkbox" data-contract /> Add a contract test against the real sandbox</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Bugs caught</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Green but wrong in production</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Harmless refactors that break tests</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Suite cost</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>What the suite says about each change</h3>
      <div class="td-scroll" tabindex="0" role="region" aria-label="Each change to the service and what the chosen suite reports"><table class="td-table" data-table>
        <thead><tr><th scope="col">Change to the service</th><th scope="col">Suite result</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <span class="pg-note">A bug the suite misses is green but wrong in production. A refactor that fails the suite was harmless: the behaviour did not change, only the way the service does it.</span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type Cfg = Record<string, number>;
  const ORDER: [string, number, number][] = [['pen', 150, 4], ['book', 1999, 1]];
  const STOCK: Record<string, number> = { pen: 10, book: 5 };
  const CONFIGS: [string, Cfg, string][] = [
    ['Healthy service', {}, 'ok'],
    ['Charges dollars, not cents', { dollars: 1 }, 'bug'],
    ['Stock not released after a decline', { noRelease: 1 }, 'bug'],
    ['Charges once per line, not once per order', { perLine: 1 }, 'bug'],
    ['Charge arguments in the wrong order', { swap: 1 }, 'bug'],
    ['No idempotency key sent', { noKey: 1 }, 'bug'],
    ['Line totals added twice in the calculator', { twice: 1 }, 'bug'],
    ['Refactor: an extra stock lookup', { extraLookup: 1 }, 'refactor'],
    ['Refactor: one reserve call for the whole order', { batch: 1 }, 'refactor'],
  ];
  const STYLES: [string, number, string, boolean, string][] = [
    ['Stubs, assert the result', 2, 'stub', false, 'result'],
    ['Strict mocks, assert the calls', 4, 'mock', false, 'calls'],
    ['Mock everything, calculator too', 4, 'mock', true, 'calls'],
    ['Fakes, assert the state', 6, 'fake', false, 'state'],
  ];
  const CONTRACT_COST = 80; // two tests at 40 units each, against the real sandbox

  // The same model as the code samples.
  class Gateway {
    calls: string[] = []; charged: number[] = [];
    constructor(public kind: string, public decline: boolean) {}
    charge(cur: unknown, amt: unknown, key: string): boolean {
      this.calls.push(`${cur}:${amt}`);
      if (this.kind === 'stub' || this.kind === 'mock') return !this.decline;
      if (cur !== 'USD') return false;
      if (!Number.isInteger(amt) || (amt as number) <= 0) return false;
      if (this.kind === 'real' && !key) return false;
      if ((amt as number) > (this.decline ? 1000 : 100000)) return false;
      this.charged.push(amt as number);
      return true;
    }
  }
  class Inventory {
    stock: Record<string, number> = { ...STOCK }; calls: string[] = [];
    reserve(sku: string, qty: number) { this.calls.push(`reserve ${sku} ${qty}`); if (this.stock[sku] < qty) return false; this.stock[sku] -= qty; return true; }
    reserveAll(list: [string, number][]) { this.calls.push('reserveAll'); for (const [sku, qty] of list) this.stock[sku] -= qty; }
    release(sku: string, qty: number) { this.calls.push(`release ${sku} ${qty}`); this.stock[sku] += qty; }
    lookup(sku: string) { this.calls.push(`stock ${sku}`); return this.stock[sku]; }
  }
  const calculator = (twice: boolean) => ORDER.reduce((s, [, p, q]) => s + p * q, 0) * (twice ? 2 : 1);
  function place(gw: Gateway, inv: Inventory, mockCalc: boolean, cfg: Cfg): string {
    const total = mockCalc ? 2599 : calculator(!!cfg.twice);
    const amount = cfg.dollars ? Math.floor(total / 100) : total;
    if (cfg.extraLookup) for (const [sku] of ORDER) inv.lookup(sku);
    if (cfg.batch) inv.reserveAll(ORDER.map(([sku, , qty]) => [sku, qty]));
    else for (const [sku, , qty] of ORDER) inv.reserve(sku, qty);
    const key = cfg.noKey ? '' : 'order-1';
    const charges = cfg.perLine ? ORDER.map(([, p, q]) => p * q) : [amount];
    for (const a of charges) {
      const ok = cfg.swap ? gw.charge(a, 'USD', key) : gw.charge('USD', a, key);
      if (!ok) {
        if (!cfg.noRelease) for (const [sku, , qty] of ORDER) inv.release(sku, qty);
        return 'declined';
      }
    }
    return 'ok';
  }
  function runTest(style: (typeof STYLES)[number], gwKind: string, cfg: Cfg, declines: boolean): boolean {
    const gw = new Gateway(gwKind, declines), inv = new Inventory();
    const result = place(gw, inv, style[3], cfg);
    if (result !== (declines ? 'declined' : 'ok')) return false;
    if (style[4] === 'result') return true;
    if (style[4] === 'calls') {
      const want = ['reserve pen 4', 'reserve book 1'].concat(declines ? ['release pen 4', 'release book 1'] : []);
      return gw.calls.join() === 'USD:2599' && inv.calls.join() === want.join();
    }
    const stockOk = declines ? inv.stock.pen === 10 && inv.stock.book === 5 : inv.stock.pen === 6 && inv.stock.book === 4;
    return gw.charged.join() === (declines ? '' : '2599') && stockOk;
  }
  const fails = (style: (typeof STYLES)[number], contract: boolean, cfg: Cfg) =>
    [false, true].some((d) => !runTest(style, style[2], cfg, d)) || (contract && [false, true].some((d) => !runTest(style, 'real', cfg, d)));

  document.querySelectorAll<HTMLElement>('[data-td]').forEach((root) => {
    const q = query(root);
    const tbody = q('[data-table] tbody');
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const style = STYLES[Number(q<HTMLSelectElement>('[data-style]').value)];
      const contract = q<HTMLInputElement>('[data-contract]').checked;
      const bugs = CONFIGS.filter((c) => c[2] === 'bug'), refactors = CONFIGS.filter((c) => c[2] === 'refactor');
      const caught = bugs.filter((c) => fails(style, contract, c[1])).length;
      const broken = refactors.filter((c) => fails(style, contract, c[1])).length;
      const healthy = !fails(style, contract, CONFIGS[0][1]);
      set(1, `${caught} of ${bugs.length}`, 'real bugs that turn the suite red');
      box(1, caught === bugs.length);
      set(2, String(bugs.length - caught), 'bugs the suite lets through: the build is green and production is not');
      box(2, caught === bugs.length);
      set(3, `${broken} of ${refactors.length}`, 'changes that keep the behaviour but fail the tests');
      box(3, broken === 0);
      set(4, String(style[1] + (contract ? CONTRACT_COST : 0)), healthy ? 'assumed units; the healthy service passes' : 'the healthy service fails: broken test');
      box(4, true);
      tbody.textContent = '';
      CONFIGS.forEach(([name, cfg, kind]) => {
        const red = fails(style, contract, cfg);
        const text = kind === 'ok' ? (red ? 'fails' : 'passes') : kind === 'bug' ? (red ? 'caught' : 'green but wrong in production') : (red ? 'fails (harmless change)' : 'passes');
        const bad = (kind === 'bug' && !red) || (kind === 'refactor' && red);
        const tr = document.createElement('tr');
        if (bad) tr.className = 'sel';
        const th = document.createElement('th'); th.setAttribute('scope', 'row'); th.textContent = name;
        const td = document.createElement('td'); td.textContent = text;
        tr.append(th, td); tbody.appendChild(tr);
      });
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .td-scroll { overflow-x: auto; }
  .playground .td-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .td-table th, .playground .td-table td { padding: 5px 8px; border-bottom: 1px solid var(--border); text-align: left; }
  .playground .td-table tr.sel { background: var(--accent-soft); font-weight: 600; }
</style>
