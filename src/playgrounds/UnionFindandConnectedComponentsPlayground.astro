---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Answer 'are these two elements connected?' for a stream of edges and count pointer operations (following, linking or rewriting a parent pointer). Nothing is timed. The edges come from a fixed rule, so the same settings always give the same numbers. Graph traversal is included because it is the simpler tool when the graph does not change.">
  <ol class="how">
    <li>Set <b>Elements</b> to <b>1,000</b>, <b>Workload</b> to <b>Chain: ask after every edge</b> and <b>Method</b> to <b>Plain union-find</b>: <b>500,499</b> operations, because every question walks the whole chain again. Switch <b>Method</b> to <b>Union by rank and path compression</b>: <b>3,993</b>.</li>
    <li>Stay on the chain and set <b>Method</b> to <b>Graph traversal</b>: <b>1,499,499</b> operations, three times worse than the plain structure, because a traversal has to start over after every new edge.</li>
    <li>Set <b>Workload</b> to <b>Random edges, then questions</b> with <b>Method</b> on <b>Plain union-find</b>: <b>109,799</b> operations and a deepest path of <b>87</b> pointers. Switch to <b>Union by rank and path compression</b>: <b>4,777</b>. Now set <b>Method</b> to <b>Graph traversal</b>: <b>5,000</b>, one pass over a graph that no longer changes, finding the same <b>167</b> components.</li>
  </ol>
  <div class="pg uf" data-uf>
    <div class="pg-row">
      <label>Elements <select class="pg-in" data-n><option value="10">10</option><option value="100">100</option><option value="1000" selected>1,000</option></select></label>
      <label>Workload <select class="pg-in" data-workload><option value="chain" selected>Chain: ask after every edge</option><option value="random">Random edges, then questions</option></select></label>
      <label>Method <select class="pg-in" data-method><option value="naive" selected>Plain union-find</option><option value="rank">Union by rank</option><option value="compression">Path compression</option><option value="both">Union by rank and path compression</option><option value="traversal">Graph traversal</option></select></label>
    </div>
    <span class="pg-note" data-note></span>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Pointer operations</h3><span class="pg-mono uf-big" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Deepest path to a root</h3><span class="pg-mono uf-big" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Components found</h3><span class="pg-mono uf-big" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Against the best method here</h3><span class="pg-mono uf-big" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Operations by method, log scale</h3>
      <div class="uf-bars" data-bars></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const NS_PER_OP = 10; // assumption for the rough time guide: 10 ns per operation
  const M = 2147483647;
  const rngFrom = (seed: number) => { let s = seed; return () => { s = (s * 48271) % M; return s; }; };

  // The same model as the code samples.
  class DSU {
    parent: number[]; rank: number[]; ops = 0;
    constructor(n: number, public useRank: boolean, public useCompress: boolean) { this.parent = Array.from({ length: n }, (_, i) => i); this.rank = new Array(n).fill(0); }
    find(x: number): number {
      let r = x;
      while (this.parent[r] !== r) { r = this.parent[r]; this.ops++; }
      if (this.useCompress) while (this.parent[x] !== r) { const nxt = this.parent[x]; this.parent[x] = r; this.ops++; x = nxt; }
      return r;
    }
    union(a: number, b: number) {
      let ra = this.find(a), rb = this.find(b);
      if (ra === rb) return;
      if (this.useRank && this.rank[ra] > this.rank[rb]) [ra, rb] = [rb, ra];
      this.parent[ra] = rb; this.ops++;
      if (this.useRank && this.rank[ra] === this.rank[rb]) this.rank[rb]++;
    }
    depth(): number {
      let best = 0;
      for (let i = 0; i < this.parent.length; i++) { let x = i, d = 0; while (this.parent[x] !== x) { x = this.parent[x]; d++; } best = Math.max(best, d); }
      return best;
    }
  }
  const FLAGS: Record<string, [boolean, boolean]> = { naive: [false, false], rank: [true, false], compression: [false, true], both: [true, true] };
  type Result = { ops: number; depth: number; comps: number };

  function randomWorkload(n: number) {
    const next = rngFrom(12345);
    const edges: [number, number][] = [], queries: [number, number][] = [];
    for (let i = 0; i < n; i++) { const a = next() % n; const b = next() % n; edges.push([a, b]); }
    for (let i = 0; i < n; i++) { const a = next() % n; const b = next() % n; queries.push([a, b]); }
    return { edges, queries };
  }
  function traversalStatic(n: number, edges: [number, number][], queries: [number, number][]): Result {
    let ops = 0; const adj: number[][] = Array.from({ length: n }, () => []);
    for (const [a, b] of edges) { adj[a].push(b); adj[b].push(a); ops++; }
    const label = new Array<number>(n).fill(-1); let comps = 0;
    for (let s = 0; s < n; s++) {
      ops++; if (label[s] >= 0) continue;
      label[s] = comps; const stack = [s];
      while (stack.length) { const x = stack.pop()!; for (const y of adj[x]) { ops++; if (label[y] < 0) { label[y] = comps; stack.push(y); } } }
      comps++;
    }
    ops += queries.length;
    return { ops, depth: 0, comps };
  }
  function runRandom(n: number): Record<string, Result> {
    const { edges, queries } = randomWorkload(n);
    const out: Record<string, Result> = {};
    for (const [name, [rank, comp]] of Object.entries(FLAGS)) {
      const d = new DSU(n, rank, comp);
      for (const [a, b] of edges) d.union(a, b);
      const depth = d.depth();
      for (const [a, b] of queries) d.find(a) === d.find(b);
      let comps = 0; for (let x = 0; x < n; x++) if (d.parent[x] === x) comps++;
      out[name] = { ops: d.ops, depth, comps };
    }
    out.traversal = traversalStatic(n, edges, queries);
    return out;
  }
  function runChain(n: number): Record<string, Result> {
    const out: Record<string, Result> = {};
    for (const [name, [rank, comp]] of Object.entries(FLAGS)) {
      const d = new DSU(n, rank, comp);
      let maxDepth = 0;
      for (let i = 0; i < n - 1; i++) { d.union(i, i + 1); d.find(0) === d.find(i + 1); if (i === n - 2) maxDepth = d.depth(); }
      out[name] = { ops: d.ops, depth: maxDepth, comps: 1 };
    }
    let ops = 0; const adj: number[][] = Array.from({ length: n }, () => []);
    for (let i = 0; i < n - 1; i++) {
      adj[i].push(i + 1); adj[i + 1].push(i); ops++;
      const seen = new Array<boolean>(n).fill(false); seen[0] = true; const stack = [0];
      while (stack.length) {
        const x = stack.pop()!; ops++;
        if (x === i + 1) break;
        for (const y of adj[x]) { ops++; if (!seen[y]) { seen[y] = true; stack.push(y); } }
      }
    }
    out.traversal = { ops, depth: 0, comps: 1 };
    return out;
  }
  function duration(ops: number): string {
    const s = (ops * NS_PER_OP) / 1e9;
    if (s < 0.001) return 'well under a millisecond';
    if (s < 1) return `about ${Math.max(1, Math.round(s * 1000))} milliseconds`;
    return `about ${Math.round(s)} seconds`;
  }
  const NAMES: Record<string, string> = { naive: 'Plain', rank: 'Rank', compression: 'Compression', both: 'Both', traversal: 'Traversal' };

  document.querySelectorAll<HTMLElement>('[data-uf]').forEach((root) => {
    const q = query(root);
    const colour = (n: number, c: string) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', c);
    function draw() {
      const n = Number(q<HTMLSelectElement>('[data-n]').value);
      const workload = q<HTMLSelectElement>('[data-workload]').value;
      const method = q<HTMLSelectElement>('[data-method]').value;
      const res = workload === 'chain' ? runChain(n) : runRandom(n);
      const r = res[method];
      q('[data-note]').textContent = workload === 'chain'
        ? `${formatThousands(n - 1)} edges join element i to i + 1; after each edge the question is whether element 0 is connected to the newest element.`
        : `${formatThousands(n)} random edges, then ${formatThousands(n)} random questions about pairs of elements.`;
      q('[data-o1]').textContent = formatThousands(r.ops);
      q('[data-n1]').textContent = method === 'traversal'
        ? (workload === 'chain' ? 're-run from the start after every edge, because the graph changed' : 'one pass labels every component of the finished graph, then each question is a comparison')
        : 'every read or write of a parent pointer, in the edges and the questions';
      const best = Math.min(...Object.values(res).map((x) => x.ops));
      colour(1, r.ops > 20 * best ? 'var(--bad)' : r.ops === best ? 'var(--good)' : 'var(--border)');
      if (method === 'traversal') {
        q('[data-o2]').textContent = 'not used';
        q('[data-n2]').textContent = 'a traversal keeps no trees of pointers';
        colour(2, 'var(--border)');
      } else {
        q('[data-o2]').textContent = formatThousands(r.depth);
        q('[data-n2]').textContent = workload === 'chain'
          ? (r.depth >= n - 2 ? 'the trees became a single long chain' : 'trees stay shallow')
          : 'longest walk from any element to its root once all edges are in, before the questions flatten it';
        colour(2, r.depth > 40 ? 'var(--bad)' : 'var(--good)');
      }
      q('[data-o3]').textContent = workload === 'chain' ? '1' : formatThousands(r.comps);
      q('[data-n3]').textContent = workload === 'chain' ? 'every element ends up in one component' : (method === 'traversal' ? 'the same count as union-find finds' : 'counted as the elements that are their own root');
      colour(3, 'var(--border)');
      const ratio = r.ops / best;
      q('[data-o4]').textContent = ratio === 1 ? 'the best here' : `${ratio >= 10 ? formatThousands(Math.round(ratio)) : (Math.round(ratio * 10) / 10).toString()} times the best`;
      q('[data-n4]').textContent = `the cheapest method for these settings needs ${formatThousands(best)} operations`;
      colour(4, ratio === 1 ? 'var(--good)' : ratio > 20 ? 'var(--bad)' : 'var(--border)');

      const rows: [string, number][] = Object.keys(NAMES).map((k) => [NAMES[k], res[k].ops]);
      const barsEl = q('[data-bars]'); barsEl.textContent = '';
      const top = Math.max(...rows.map((x) => x[1]));
      const digits = Math.max(2, Math.ceil(Math.log10(top + 1)));
      for (const [name, v] of rows) {
        const row = document.createElement('div'); row.className = 'uf-bar';
        const nm = document.createElement('span'); nm.textContent = name;
        const track = document.createElement('span'); track.className = 'uf-track';
        const fill = document.createElement('span'); fill.className = 'uf-fill'; fill.style.width = `${Math.max(2, (Math.log10(Math.max(1, v)) / digits) * 100)}%`;
        track.appendChild(fill);
        const num = document.createElement('span'); num.className = 'pg-mono'; num.textContent = `${formatThousands(v)} operations`;
        row.append(nm, track, num); barsEl.appendChild(row);
      }
      q('[data-verdict]').textContent = `The selected method needs ${duration(r.ops)} at 10 ns an operation (an assumption). Bar length is the number of digits, so each tick right is ten times more work.`;
    }
    root.addEventListener('change', draw);
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .playground .uf-big { font-size: 1.15rem; font-weight: 600; }
  .playground .uf-bars { display: grid; gap: 6px; }
  .playground .uf-bar { display: grid; grid-template-columns: 6.5rem 1fr; gap: 2px 8px; align-items: center; }
  .playground .uf-bar .pg-mono { grid-column: 2; }
  .playground .uf-track { display: block; height: 12px; border-radius: 6px; background: var(--surface-2); overflow: hidden; }
  .playground .uf-fill { display: block; height: 100%; background: var(--accent); border-radius: 6px; }
</style>
