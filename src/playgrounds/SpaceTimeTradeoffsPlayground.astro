---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Answer range-sum queries over an array of n numbers, each query asking for the sum of half the array. Three techniques, counted in steps and memory cells (never timed). One cell is assumed to take 8 bytes, typical for a 64-bit number in a compact array; objects and pointers cost more.">
  <ol class="how">
    <li>Set <b>Items n</b> to <b>1,000</b>, <b>Queries</b> to <b>1,000</b> and <b>Technique</b> to <b>Recompute every query</b>: <b>500</b> steps per query and <b>500,000</b> in total, with no extra memory. Set <b>Technique</b> to <b>Prefix-sum table</b>: one build pass of <b>1,000</b> steps, then 1 step per query, <b>2,000</b> in total, for <b>1,001</b> memory cells. The precomputation pays off from <b>3</b> queries.</li>
    <li>Set <b>Technique</b> to <b>Full n x n table</b>: every answer is stored, so the total is <b>1,001,000</b> steps, twice the cost of recomputing, and it holds <b>1,000,000</b> cells. It only beats recomputing from <b>2,005</b> queries, and never beats the prefix table, whose queries cost the same.</li>
    <li>Set <b>Items n</b> to <b>100,000</b> and <b>Memory budget</b> to <b>16 GB</b>: the full table needs <b>10,000,000,000</b> cells, about <b>80 GB</b>, and turns red. The prefix table needs only <b>100,001</b> cells and <b>101,000</b> steps for the 1,000 queries.</li>
    <li>Set <b>Items n</b> back to <b>1,000</b> and <b>Queries</b> to <b>2</b>: recomputing costs <b>1,000</b> steps and the prefix table <b>1,002</b>. With too few queries the build is a loss. Set <b>Queries</b> to <b>100,000</b>: <b>50,000,000</b> steps against <b>101,000</b>.</li>
  </ol>
  <div class="pg st" data-st>
    <div class="pg-row">
      <label>Items n <select class="pg-in" data-n><option value="100">100</option><option value="1000" selected>1,000</option><option value="10000">10,000</option><option value="100000">100,000</option><option value="1000000">1,000,000</option></select></label>
      <label>Queries <input class="pg-in" type="number" data-q value="1000" min="1" max="1000000000" step="1" style="width: 9em" /></label>
      <label>Technique <select class="pg-in" data-tech><option value="recompute" selected>Recompute every query</option><option value="prefix">Prefix-sum table</option><option value="table">Full n x n table</option></select></label>
      <label>Memory budget <select class="pg-in" data-budget><option value="1000000">1 MB</option><option value="100000000">100 MB</option><option value="1000000000">1 GB</option><option value="16000000000" selected>16 GB</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Build steps</h3><span class="pg-mono st-big" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Steps per query</h3><span class="pg-mono st-big" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Total steps</h3><span class="pg-mono st-big" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Memory cells</h3><span class="pg-mono st-big" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Pays off from</h3><span class="pg-mono st-big" data-o5></span><span class="pg-note" data-n5></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>All three techniques at these settings</h3>
      <div class="st-scroll" tabindex="0" role="region" aria-label="Comparison of the three techniques"><table class="st-table"><thead><tr><th>Technique</th><th>Build</th><th>Per query</th><th>Total steps</th><th>Memory cells</th><th>Memory</th></tr></thead><tbody data-rows></tbody></table></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands, formatOneDecimalBelow100 } from '../playground';
  const BYTES_PER_CELL = 8;
  type Tech = 'recompute' | 'prefix' | 'table';
  const NAMES: Record<Tech, string> = { recompute: 'Recompute every query', prefix: 'Prefix-sum table', table: 'Full n x n table' };

  // The same model as the code samples.
  function costs(t: Tech, n: number) {
    const half = Math.floor(n / 2);
    if (t === 'recompute') return { build: 0, perQuery: half, cells: 0 };
    if (t === 'prefix') return { build: n, perQuery: 1, cells: n + 1 };
    return { build: n * n, perQuery: 1, cells: n * n };
  }
  const total = (t: Tech, n: number, q: number) => { const c = costs(t, n); return c.build + q * c.perQuery; };
  function breakEven(t: Tech, n: number): number {
    const c = costs(t, n), r = costs('recompute', n);
    if (c.perQuery >= r.perQuery) return 0;
    let q = Math.floor(c.build / (r.perQuery - c.perQuery)) + 1;
    while (total(t, n, q) >= total('recompute', n, q)) q++;
    return q;
  }
  function bytes(b: number): string {
    if (b === 0) return '0 B';
    const units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB']; let i = 0, v = b;
    while (v >= 1000 && i < units.length - 1) { v /= 1000; i++; }
    return `${formatOneDecimalBelow100(v)} ${units[i]}`;
  }
  function duration(steps: number): string {
    const s = steps / 1e9;
    if (s < 1) return 'under a second';
    if (s < 120) return `about ${Math.round(s)} seconds`;
    if (s < 7200) return `about ${Math.round(s / 60)} minutes`;
    if (s < 172800) return `about ${Math.round(s / 3600)} hours`;
    return `about ${formatThousands(Math.round(s / 86400))} days`;
  }

  document.querySelectorAll<HTMLElement>('[data-st]').forEach((root) => {
    const q = query(root);
    const colour = (i: number, c: string) => q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', c);
    function draw() {
      const n = Number(q<HTMLSelectElement>('[data-n]').value);
      const queries = Math.max(1, Math.min(1e9, Math.round(Number(q<HTMLInputElement>('[data-q]').value) || 1)));
      const t = q<HTMLSelectElement>('[data-tech]').value as Tech;
      const budget = Number(q<HTMLSelectElement>('[data-budget]').value);
      const c = costs(t, n), tot = total(t, n, queries), mem = c.cells * BYTES_PER_CELL;
      const over = mem > budget;
      q('[data-o1]').textContent = formatThousands(c.build);
      q('[data-n1]').textContent = t === 'recompute' ? 'nothing is prepared' : t === 'prefix' ? 'one pass of running totals' : 'one cell for every pair of positions, n x n';
      colour(1, 'var(--border)');
      q('[data-o2]').textContent = formatThousands(c.perQuery);
      q('[data-n2]').textContent = t === 'recompute' ? 'adds up half the array again for every query' : t === 'prefix' ? 'one subtraction of two stored totals' : 'one lookup';
      colour(2, c.perQuery > 1 ? 'var(--bad)' : 'var(--good)');
      q('[data-o3]').textContent = formatThousands(tot);
      q('[data-n3]').textContent = `build + ${formatThousands(queries)} queries x ${formatThousands(c.perQuery)}: ${duration(tot)} at one step per nanosecond (an assumption)`;
      colour(3, 'var(--border)');
      q('[data-o4]').textContent = formatThousands(c.cells);
      q('[data-n4]').textContent = `${bytes(mem)} at ${BYTES_PER_CELL} bytes a cell${over ? `: over the ${bytes(budget)} budget` : ''}`;
      colour(4, over ? 'var(--bad)' : 'var(--good)');
      const be = t === 'recompute' ? 0 : breakEven(t, n);
      q('[data-o5]').textContent = t === 'recompute' ? 'the baseline' : be === 0 ? 'never' : `${formatThousands(be)} queries`;
      q('[data-n5]').textContent = t === 'recompute' ? 'the other two are compared with this one' : 'the number of queries from which the build cost is repaid, against recomputing every time';
      colour(5, t === 'recompute' ? 'var(--border)' : queries >= be && be > 0 ? 'var(--good)' : 'var(--bad)');

      const rows = q('[data-rows]'); rows.textContent = '';
      for (const k of ['recompute', 'prefix', 'table'] as Tech[]) {
        const ck = costs(k, n), mk = ck.cells * BYTES_PER_CELL;
        const tr = document.createElement('tr');
        if (mk > budget) tr.className = 'st-over';
        const cells = [NAMES[k] + (k === t ? ' (selected)' : ''), formatThousands(ck.build), formatThousands(ck.perQuery), formatThousands(total(k, n, queries)), formatThousands(ck.cells), mk > budget ? `${bytes(mk)}: over budget` : bytes(mk)];
        cells.forEach((text, i) => { const td = document.createElement('td'); td.textContent = text; if (i > 0) td.className = 'pg-mono'; tr.appendChild(td); });
        rows.appendChild(tr);
      }
      const best = (['recompute', 'prefix', 'table'] as Tech[]).filter((k) => costs(k, n).cells * BYTES_PER_CELL <= budget).sort((a, b) => total(a, n, queries) - total(b, n, queries))[0];
      q('[data-verdict]').textContent = `Fewest total steps within the ${bytes(budget)} budget: ${NAMES[best]} (${formatThousands(total(best, n, queries))} steps). Build cost, memory and the number of queries together decide, not any one of them.`;
    }
    root.addEventListener('change', draw);
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .playground .st-big { font-size: 1.15rem; font-weight: 600; }
  .playground .st-scroll { overflow-x: auto; }
  .playground .st-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .st-table th, .playground .st-table td { text-align: left; padding: 4px 8px; border-bottom: 1px solid var(--border); white-space: nowrap; }
  .playground .st-table tr.st-over td { background: color-mix(in srgb, var(--bad) 14%, var(--surface)); color: var(--bad-text); }
</style>
