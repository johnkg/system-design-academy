---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Count the nodes a recursive search visits on N-queens and on subset sum, with and without pruning, and with different ordering. A node is one call of the search. Nothing is timed; the time shown assumes 10 ns a node (100 million a second) as a rough guide.">
  <ol class="how">
    <li>Set <b>Problem</b> to <b>N-queens: find all solutions</b>, <b>Size</b> to <b>8</b> and <b>Approach</b> to <b>Try every board</b>: <b>19,173,961</b> nodes. Switch <b>Approach</b> to <b>Never reuse a column</b>: <b>109,601</b>. Switch to <b>Prune as soon as a queen is attacked</b>: <b>2,057</b> nodes, for the same <b>92</b> solutions.</li>
    <li>Set <b>Problem</b> to <b>N-queens: find the first solution</b>, <b>Size</b> to <b>24</b> and <b>Approach</b> to <b>Columns left to right</b>: <b>411,609</b> nodes. Switch to <b>Middle columns first</b>: <b>65</b>. The order changes where the first answer sits, not how much work finding every answer takes.</li>
    <li>Set <b>Problem</b> to <b>Subset sum: count subsets</b>, <b>Size</b> to <b>20</b> and <b>Approach</b> to <b>No pruning</b>: <b>2,097,151</b> nodes. <b>Pruned, given order</b> needs <b>726,739</b>; <b>Pruned, largest items first</b> needs <b>109,147</b>, for the same <b>6,722</b> subsets.</li>
    <li>Set <b>Problem</b> to <b>Subset sum: items that defeat pruning</b> with <b>Size</b> <b>20</b> and <b>Approach</b> on <b>Pruned, largest items first</b>: <b>705,431</b> nodes, a third of the unpruned <b>2,097,151</b>, and still roughly doubling with every extra item.</li>
  </ol>
  <div class="pg bt" data-bt>
    <div class="pg-row">
      <label>Problem <select class="pg-in" data-problem><option value="qall" selected>N-queens: find all solutions</option><option value="qfirst">N-queens: find the first solution</option><option value="sub">Subset sum: count subsets</option><option value="bad">Subset sum: items that defeat pruning</option></select></label>
      <label>Size <select class="pg-in" data-size></select></label>
      <label>Approach <select class="pg-in" data-approach></select></label>
    </div>
    <span class="pg-note" data-note></span>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Nodes visited</h3><span class="pg-mono bt-big" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Answers found</h3><span class="pg-mono bt-big" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Against no pruning</h3><span class="pg-mono bt-big" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>One size up</h3><span class="pg-mono bt-big" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Nodes by approach, log scale</h3>
      <div class="bt-bars" data-bars></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const NS_PER_NODE = 10; // assumption for the rough time guide
  const M = 2147483647;
  const rngFrom = (seed: number) => { let s = seed; return () => { s = (s * 48271) % M; return s; }; };

  // The same model as the code samples.
  function columnOrder(n: number, middleFirst: boolean): number[] {
    const cols = Array.from({ length: n }, (_, i) => i);
    if (middleFirst) cols.sort((a, b) => Math.abs(2 * a - (n - 1)) - Math.abs(2 * b - (n - 1)) || a - b);
    return cols;
  }
  function queensPruned(n: number, middleFirst: boolean, firstOnly: boolean): { solutions: number; nodes: number } {
    const order = columnOrder(n, middleFirst);
    const colUsed = new Array<boolean>(n).fill(false), d1 = new Array<boolean>(2 * n).fill(false), d2 = new Array<boolean>(2 * n).fill(false);
    let nodes = 0, solutions = 0;
    const place = (row: number): boolean => {
      nodes++;
      if (row === n) { solutions++; return firstOnly; }
      for (const c of order) {
        if (colUsed[c] || d1[row + c] || d2[row - c + n]) continue;
        colUsed[c] = d1[row + c] = d2[row - c + n] = true;
        const stop = place(row + 1);
        colUsed[c] = d1[row + c] = d2[row - c + n] = false;
        if (stop) return true;
      }
      return false;
    };
    place(0);
    return { solutions, nodes };
  }
  // Nodes of the two unpruned trees, by formula (they match a real count: 341 for n = 4, 109,601 for n = 8 with no repeated column).
  function everyBoard(n: number): number { let total = 0, p = 1; for (let k = 0; k <= n; k++) { total += p; p *= n; } return total; }
  function noRepeat(n: number): number { let total = 0, term = 1; for (let k = 0; k <= n; k++) { total += term; term *= n - k; } return total; }

  function makeItems(n: number): number[] { const next = rngFrom(4242); const items: number[] = []; for (let i = 0; i < n; i++) items.push(1 + (next() % 50)); return items; }
  function subsetPlain(items: number[], target: number) {
    let nodes = 0, count = 0;
    const go = (i: number, total: number) => { nodes++; if (i === items.length) { if (total === target) count++; return; } go(i + 1, total); go(i + 1, total + items[i]); };
    go(0, 0); return { count, nodes };
  }
  function subsetPruned(items: number[], target: number, descending: boolean) {
    const seq = descending ? [...items].sort((a, b) => b - a) : [...items];
    const suffix = new Array<number>(seq.length + 1).fill(0);
    for (let i = seq.length - 1; i >= 0; i--) suffix[i] = suffix[i + 1] + seq[i];
    let nodes = 0, count = 0;
    const go = (i: number, total: number) => { nodes++; if (total > target || total + suffix[i] < target) return; if (i === seq.length) { count++; return; } go(i + 1, total + seq[i]); go(i + 1, total); };
    go(0, 0); return { count, nodes };
  }
  function subsetInput(kind: string, n: number): { items: number[]; target: number } {
    if (kind === 'bad') return { items: new Array<number>(n).fill(2), target: n % 2 === 0 ? n + 1 : n };
    const items = makeItems(n); return { items, target: Math.floor(items.reduce((a, b) => a + b, 0) / 2) };
  }

  const SIZES: Record<string, number[]> = { qall: [4, 5, 6, 7, 8, 9, 10, 11], qfirst: [8, 12, 16, 20, 24], sub: [10, 16, 20], bad: [16, 20] };
  const APPROACHES: Record<string, [string, string][]> = {
    qall: [['board', 'Try every board'], ['perm', 'Never reuse a column'], ['prune', 'Prune as soon as a queen is attacked']],
    qfirst: [['ltr', 'Columns left to right'], ['mid', 'Middle columns first']],
    sub: [['plain', 'No pruning'], ['given', 'Pruned, given order'], ['desc', 'Pruned, largest items first']],
    bad: [['plain', 'No pruning'], ['given', 'Pruned, given order'], ['desc', 'Pruned, largest items first']],
  };
  function duration(nodes: number): string {
    const s = (nodes * NS_PER_NODE) / 1e9;
    if (s < 0.001) return 'well under a millisecond';
    if (s < 1) return `about ${Math.max(1, Math.round(s * 1000))} milliseconds`;
    if (s < 120) return `about ${Math.round(s)} seconds`;
    if (s < 7200) return `about ${Math.round(s / 60)} minutes`;
    if (s < 172800) return `about ${Math.round(s / 3600)} hours`;
    return `about ${formatThousands(Math.round(s / 86400))} days`;
  }

  document.querySelectorAll<HTMLElement>('[data-bt]').forEach((root) => {
    const q = query(root);
    const colour = (n: number, c: string) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', c);
    const sizeSel = q<HTMLSelectElement>('[data-size]'), approachSel = q<HTMLSelectElement>('[data-approach]');
    let lastProblem = '';
    const fill = (sel: HTMLSelectElement, entries: [string, string][], keep: string) => {
      sel.textContent = '';
      for (const [v, l] of entries) { const o = document.createElement('option'); o.value = v; o.textContent = l; sel.appendChild(o); }
      if (entries.some(([v]) => v === keep)) sel.value = keep;
    };

    // Every variant for one problem and size: { key: [nodes, answers] }
    function runAll(problem: string, n: number): Record<string, [number, number]> {
      if (problem === 'qall') {
        const p = queensPruned(n, false, false);
        return { board: [everyBoard(n), p.solutions], perm: [noRepeat(n), p.solutions], prune: [p.nodes, p.solutions] };
      }
      if (problem === 'qfirst') {
        const a = queensPruned(n, false, true), b = queensPruned(n, true, true);
        return { ltr: [a.nodes, a.solutions], mid: [b.nodes, b.solutions] };
      }
      const { items, target } = subsetInput(problem, n);
      const a = subsetPlain(items, target), b = subsetPruned(items, target, false), c = subsetPruned(items, target, true);
      return { plain: [a.nodes, a.count], given: [b.nodes, b.count], desc: [c.nodes, c.count] };
    }

    function draw() {
      const problem = q<HTMLSelectElement>('[data-problem]').value;
      if (problem !== lastProblem) {
        lastProblem = problem;
        fill(sizeSel, SIZES[problem].map((s) => [String(s), formatThousands(s)] as [string, string]), problem === 'qall' ? '8' : problem === 'qfirst' ? '24' : '20');
        fill(approachSel, APPROACHES[problem], problem === 'qall' ? 'board' : problem === 'qfirst' ? 'ltr' : 'plain');
      }
      const n = Number(sizeSel.value), approach = approachSel.value;
      const all = runAll(problem, n);
      const [nodes, answers] = all[approach];
      const keys = APPROACHES[problem].map(([k]) => k);
      const baseline = all[keys[0]][0];
      q('[data-note]').textContent = problem === 'qall' ? `Place ${n} queens on a ${n} by ${n} board, one per row, so that none attacks another. Count every solution.`
        : problem === 'qfirst' ? `Place ${n} queens as above, but stop at the first solution. The only difference between the two approaches is the order in which columns are tried.`
        : problem === 'sub' ? `Count the subsets of ${n} numbers (1 to 50) that add up to half of their total.`
        : `${n} items that are all equal to 2, and a target of ${n % 2 === 0 ? n + 1 : n}, which no subset can reach. The bounds rarely rule anything out early.`;
      q('[data-o1]').textContent = formatThousands(nodes);
      q('[data-n1]').textContent = (approach === 'board' || approach === 'perm') ? 'counted by formula; it matches an actual run for small sizes' : 'one node is one call of the recursive search';
      colour(1, nodes === baseline && keys.length > 2 ? 'var(--bad)' : 'var(--good)');
      q('[data-o2]').textContent = formatThousands(answers);
      q('[data-n2]').textContent = problem === 'qfirst' ? 'the search stops at the first one' : 'every variant finds the same answers';
      colour(2, 'var(--border)');
      if (keys.indexOf(approach) === 0) {
        q('[data-o3]').textContent = 'the baseline'; q('[data-n3]').textContent = problem === 'qfirst' ? 'a fixed left-to-right order' : 'the whole search tree';
        colour(3, 'var(--border)');
      } else {
        const r = baseline / Math.max(1, nodes);
        q('[data-o3]').textContent = `${r >= 10 ? formatThousands(Math.round(r)) : (Math.round(r * 10) / 10).toString()} times fewer`;
        q('[data-n3]').textContent = `${formatThousands(Math.round((100 * nodes) / baseline * 100) / 100)}% of the first approach's ${formatThousands(baseline)} nodes`;
        colour(3, 'var(--good)');
      }
      // growth: the same approach at the next size in the list
      const sizes = SIZES[problem]; const idx = sizes.indexOf(n);
      if (idx < sizes.length - 1 && problem !== 'qfirst') {
        const next = runAll(problem, sizes[idx + 1])[approach][0];
        q('[data-o4]').textContent = `${(Math.round((next / nodes) * 10) / 10).toString()} times`;
        q('[data-n4]').textContent = `nodes at size ${formatThousands(sizes[idx + 1])} against size ${formatThousands(n)}: pruned search is smaller, not polynomial`;
        colour(4, 'var(--border)');
      } else {
        q('[data-o4]').textContent = problem === 'qfirst' ? 'not steady' : 'largest size here';
        q('[data-n4]').textContent = problem === 'qfirst' ? 'the first solution can come after a few nodes or a few hundred thousand, by luck of the order' : 'pick a smaller size to see growth to the next one';
        colour(4, 'var(--border)');
      }
      const barsEl = q('[data-bars]'); barsEl.textContent = '';
      const top = Math.max(...keys.map((k) => all[k][0]));
      const digits = Math.max(2, Math.ceil(Math.log10(top + 1)));
      for (const [k, label] of APPROACHES[problem]) {
        const v = all[k][0];
        const row = document.createElement('div'); row.className = 'bt-bar';
        const nm = document.createElement('span'); nm.textContent = label;
        const track = document.createElement('span'); track.className = 'bt-track';
        const f = document.createElement('span'); f.className = 'bt-fill'; f.style.width = `${Math.max(2, (Math.log10(Math.max(1, v)) / digits) * 100)}%`;
        track.appendChild(f);
        const num = document.createElement('span'); num.className = 'pg-mono'; num.textContent = `${formatThousands(v)} nodes`;
        row.append(nm, track, num); barsEl.appendChild(row);
      }
      q('[data-verdict]').textContent = `This approach: ${duration(nodes)} at 10 ns a node (an assumption); the first approach: ${duration(baseline)}. Bar length is the number of digits, so each tick right is ten times more work.`;
    }
    root.addEventListener('change', draw);
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .playground .bt-big { font-size: 1.15rem; font-weight: 600; }
  .playground .bt-bars { display: grid; gap: 6px; }
  .playground .bt-bar { display: grid; grid-template-columns: 13rem 1fr; gap: 2px 8px; align-items: center; }
  .playground .bt-bar .pg-mono { grid-column: 2; }
  .playground .bt-track { display: block; height: 12px; border-radius: 6px; background: var(--surface-2); overflow: hidden; }
  .playground .bt-fill { display: block; height: 100%; background: var(--accent); border-radius: 6px; }
  @media (max-width: 560px) { .playground .bt-bar { grid-template-columns: 1fr; } .playground .bt-bar .pg-mono { grid-column: 1; } }
</style>
