---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Several callers submit a request at the same moment, and each request takes a while to run. Compare callers that run it behind a lock with an active object that queues them.">
  <ol class="how">
    <li>Start with the defaults: <b>Callers</b> at <b>6</b>, <b>Time per request</b> at <b>50</b> ms and <b>Design</b> <b>Callers call it behind a lock</b>. The last caller is stuck for <b>300</b> ms and the last result is ready after <b>300</b> ms. Nothing is queued.</li>
    <li>Set <b>Design</b> to <b>Active object</b>: callers are stuck for <b>0</b> ms and carry on straight away, but the last result still takes <b>300</b> ms, because one worker runs one request at a time. <b>5</b> requests wait in the queue.</li>
    <li>Set <b>Callers</b> to <b>20</b>: the last result takes <b>1000</b> ms and <b>19</b> requests wait. The queue grows with the number of callers, so it needs a limit.</li>
  </ol>
  <div class="pg aob" data-aob>
    <div class="pg-row">
      <label>Callers <input class="pg-in" type="range" min="2" max="20" step="1" value="6" data-n /> <b data-nv></b></label>
      <label>Time per request <input class="pg-in" type="range" min="10" max="100" step="10" value="50" data-t /> <b data-tv></b> ms</label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Callers call it behind a lock</option><option value="1">Active object</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Longest time a caller is stuck</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Time until the last result</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Requests waiting in the queue</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // All callers submit at time 0 and every request takes the same time. One worker (or one lock holder) runs one request at a time.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-aob]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const n = Number(q<HTMLInputElement>('[data-n]').value), t = Number(q<HTMLInputElement>('[data-t]').value);
      const active = q<HTMLSelectElement>('[data-design]').value === '1';
      q('[data-nv]').textContent = String(n); q('[data-tv]').textContent = String(t);
      setBox(1, `${active ? 0 : n * t} ms`, active ? 'submitting returns a future at once, and the caller goes on with other work' : 'the last caller waits for all the others, then runs its own request', active ? 'good' : 'bad');
      setBox(2, `${n * t} ms`, 'one request runs at a time in both designs, so the work takes the same total time', 'mid');
      setBox(3, String(active ? n - 1 : 0), active ? 'requests that are waiting for the worker, and the queue needs a limit' : 'callers wait on the lock themselves, so nothing is queued', active ? 'mid' : 'good');
      q('[data-verdict]').textContent = active
        ? 'The servant needs no locks and no caller is blocked, but the work is no faster: one worker still runs one request at a time.'
        : 'Callers block on the lock, and the servant needs a lock for every piece of shared state.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
