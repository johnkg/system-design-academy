---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A model uses many features. Some are written twice, once for training and once for serving, and each second copy has some chance of differing in a way that matters. You set the chance, so the numbers are not measurements: they show how quickly small chances add up.">
  <ol class="how">
    <li>Start with the defaults: <b>Features</b> <b>50</b>, <b>Computed in two places</b> <b>40</b>, <b>Chance a second copy differs</b> <b>5</b> and <b>Design</b> <b>Two implementations</b>. <b>20</b> features are written twice, <b>1</b> of them is expected to differ, and the chance that at least one differs is <b>64.2</b> percent.</li>
    <li>Set <b>Design</b> to <b>One shared definition</b>: <b>0</b> features are written twice, <b>0</b> are expected to differ, and the chance is <b>0.0</b> percent.</li>
    <li>Set <b>Design</b> back to <b>Two implementations</b>, <b>Features</b> to <b>200</b> and <b>Computed in two places</b> to <b>100</b>: all <b>200</b> are written twice, <b>10</b> are expected to differ, and at least one differs in <b>100.0</b> percent of cases.</li>
    <li>Set <b>Features</b> to <b>50</b>, <b>Computed in two places</b> to <b>40</b> and <b>Chance a second copy differs</b> to <b>1</b>: <b>20</b> features are written twice, <b>0.2</b> are expected to differ, and the chance of at least one is <b>18.2</b> percent. Even rare differences add up over many features.</li>
  </ol>
  <div class="pg tss" data-tss>
    <div class="pg-row">
      <label>Features <input class="pg-in" type="range" min="10" max="200" step="10" value="50" data-f /> <b data-fv></b></label>
      <label>Computed in two places <input class="pg-in" type="range" min="0" max="100" step="10" value="40" data-s /> <b data-sv></b> %</label>
      <label>Chance a second copy differs <input class="pg-in" type="range" min="0" max="20" step="1" value="5" data-c /> <b data-cv></b> %</label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Two implementations</option><option value="1">One shared definition</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Features written twice</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Features expected to differ</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Chance that at least one differs</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // twice = features x share. Expected differing = twice x chance. At least one differs = 1 - (1 - chance)^twice.
  type Tone = 'good' | 'bad' | 'mid';
  const trim = (n: number) => String(Number(n.toFixed(2)));
  document.querySelectorAll<HTMLElement>('[data-tss]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const features = Number(q<HTMLInputElement>('[data-f]').value), share = Number(q<HTMLInputElement>('[data-s]').value) / 100;
      const chance = Number(q<HTMLInputElement>('[data-c]').value) / 100, shared = q<HTMLSelectElement>('[data-design]').value === '1';
      q('[data-fv]').textContent = String(features); q('[data-sv]').textContent = String(Math.round(share * 100)); q('[data-cv]').textContent = String(Math.round(chance * 100));
      const twice = shared ? 0 : Math.round(features * share), expected = twice * chance, atLeastOne = 1 - (1 - chance) ** twice;
      setBox(1, String(twice), shared ? 'each feature has one definition, used by both paths' : `${Math.round(share * 100)} percent of ${features} features`, twice === 0 ? 'good' : 'mid');
      setBox(2, trim(expected), 'each second copy has the chance you set of differing', expected === 0 ? 'good' : expected >= 1 ? 'bad' : 'mid');
      setBox(3, `${(100 * atLeastOne).toFixed(1)} %`, 'one differing feature is enough to make live results worse than offline ones', atLeastOne === 0 ? 'good' : atLeastOne > 0.5 ? 'bad' : 'mid');
      q('[data-verdict]').textContent = shared ? 'With one shared definition the two paths cannot disagree about how a feature is computed.' : 'Each rewritten feature is another chance to disagree, and the chances add up quickly. Detect it by logging served features, and prevent it with one definition.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
