---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Type a postfix formula. See the expression tree, then evaluate it with different variables.">
  <ol class="how">
    <li>Type a formula in <b>postfix</b> (operands first): <code>x 3 * 2 +</code> means x×3+2.</li>
    <li>Look at the <b>tree</b> that parsing builds, and the result.</li>
    <li>Change <b>x</b> and <b>y</b>. The same tree is evaluated again; nothing is re-parsed.</li>
  </ol>
  <div class="pg" data-interp>
    <div class="pg-row">
      <input class="pg-in" data-src value="x 3 * 2 +" aria-label="Postfix formula" style="flex:1 1 200px" />
      <label>x <input class="pg-in" data-x type="number" value="4" style="width:70px" /></label>
      <label>y <input class="pg-in" data-y type="number" value="7" style="width:70px" /></label>
    </div>
    <div class="pg-row"><button class="btn" type="button" data-ex="x 3 * 2 +">x 3 * 2 +</button><button class="btn" type="button" data-ex="x y + 2 *">x y + 2 *</button><button class="btn" type="button" data-ex="x y - 3 /">x y - 3 / (new ops)</button></div>
    <div class="in-tree" data-tree></div>
    <output class="pg-out" data-out></output>
  </div>
</PlaygroundShell>
<script>
  type Ctx = Record<string, number>;
  interface Expr { interpret(c: Ctx): number; show(): string; kids: Expr[] }
  class Num implements Expr { kids = []; constructor(public v: number) {} interpret() { return this.v; } show() { return `Number ${this.v}`; } }
  class Var implements Expr { kids = []; constructor(public n: string) {} interpret(c: Ctx) { if (!(this.n in c)) throw new Error(`Unknown variable "${this.n}"`); return c[this.n]; } show() { return `Variable ${this.n}`; } }
  class Op implements Expr {
    kids: Expr[]; constructor(public sym: string, l: Expr, r: Expr, private f: (a: number, b: number) => number) { this.kids = [l, r]; }
    interpret(c: Ctx) { return this.f(this.kids[0].interpret(c), this.kids[1].interpret(c)); } show() { return `${this.sym === '+' ? 'Add' : this.sym === '*' ? 'Multiply' : this.sym === '-' ? 'Subtract' : 'Divide'} (${this.sym})`; }
  }
  const ops: Record<string, (a: number, b: number) => number> = { '+': (a, b) => a + b, '*': (a, b) => a * b, '-': (a, b) => a - b, '/': (a, b) => a / b };
  function parse(src: string): Expr {
    const st: Expr[] = [];
    for (const t of src.trim().split(/\s+/).filter(Boolean)) {
      if (t in ops) { const r = st.pop(), l = st.pop(); if (!l || !r) throw new Error(`Operator "${t}" needs two operands`); st.push(new Op(t, l, r, ops[t])); }
      else if (/^-?\d+(\.\d+)?$/.test(t)) st.push(new Num(Number(t))); else if (/^[a-z]+$/i.test(t)) st.push(new Var(t)); else throw new Error(`Cannot read "${t}"`);
    }
    if (st.length !== 1) throw new Error(st.length ? 'Too many operands left over' : 'Empty formula');
    return st[0];
  }
  function html(e: Expr, level = 0): string { return `<div class="in-node" style="margin-left:${level ? 18 : 0}px"><span>${e.show()}</span>${e.kids.map((k) => html(k, level + 1)).join('')}</div>`; }
  document.querySelectorAll<HTMLElement>('[data-interp]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    function run() {
      const out = q('[data-out]'); out.classList.remove('bad');
      try { const tree = parse(q<HTMLInputElement>('[data-src]').value); q('[data-tree]').innerHTML = html(tree);
        const ctx = { x: Number(q<HTMLInputElement>('[data-x]').value), y: Number(q<HTMLInputElement>('[data-y]').value) };
        out.textContent = `interpret({x: ${ctx.x}, y: ${ctx.y}}) = ${tree.interpret(ctx)}`; }
      catch (e) { q('[data-tree]').innerHTML = ''; out.textContent = (e as Error).message; out.classList.add('bad'); }
    }
    root.querySelectorAll('input').forEach((i) => i.addEventListener('input', run));
    root.querySelectorAll<HTMLButtonElement>('[data-ex]').forEach((b) => b.addEventListener('click', () => { q<HTMLInputElement>('[data-src]').value = b.dataset.ex!; run(); }));
    run();
  });
</script>
<style is:global>
  .playground .in-tree { padding: 10px 14px; border: 1px solid var(--border); border-radius: 10px; font: .85rem var(--font-mono); background: var(--surface); }
  .playground .in-node > span { display: inline-block; padding: 1px 8px; margin: 2px 0; border-radius: 6px; background: var(--accent-soft); }
  .playground .in-node { border-left: 2px solid var(--border); padding-left: 6px; }
</style>
