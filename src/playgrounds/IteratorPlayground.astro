---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Two iterators walk the same playlist, each with its own position.">
  <ol class="how">
    <li>Press <b>next()</b> on Iterator A, and then on Iterator B. Their positions are <b>independent</b>.</li>
    <li>Make B a <b>Reverse</b> iterator to see another traversal order over the same data.</li>
    <li>Add a song. The playlist storage grew; the clients did not change.</li>
  </ol>
  <div class="pg" data-iter>
    <div class="pg-row"><input class="pg-in" data-song value="Bridge" aria-label="Song title" /><button class="btn" type="button" data-add>Add song</button></div>
    <div class="pg-grid" data-walkers></div>
    <p class="sr" aria-live="polite" data-status></p>
    <p class="pg-note">Playlist: <span class="pg-mono" data-list></span></p>
  </div>
</PlaygroundShell>
<script>
  interface It { hasNext(): boolean; next(): string; pos(): number }
  class Forward implements It { i = 0; constructor(private s: string[]) {} hasNext() { return this.i < this.s.length; } next() { return this.s[this.i++]; } pos() { return this.i; } }
  class Reverse implements It { i: number; constructor(private s: string[]) { this.i = s.length - 1; } hasNext() { return this.i >= 0; } next() { return this.s[this.i--]; } pos() { return this.s.length - 1 - this.i; } }
  class Playlist { songs = ['Intro', 'Verse', 'Chorus']; create(kind: 'forward' | 'reverse'): It { return kind === 'forward' ? new Forward(this.songs) : new Reverse(this.songs); } }
  document.querySelectorAll<HTMLElement>('[data-iter]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const pl = new Playlist();
    const walkers = [{ id: 'A', kind: 'forward' as const, it: pl.create('forward'), got: [] as string[] }, { id: 'B', kind: 'forward' as const, it: pl.create('forward'), got: [] as string[] }];
    function draw() {
      q('[data-list]').textContent = `[${pl.songs.join(', ')}]`;
      const g = q('[data-walkers]'); g.innerHTML = '';
      walkers.forEach((w) => {
        const d = document.createElement('div'); d.className = 'pg-box'; d.style.setProperty('--c', 'var(--role-3)');
        d.innerHTML = `<h3>Iterator ${w.id} <span class="pg-note">(${w.kind})</span></h3><span class="pg-mono">hasNext() = ${w.it.hasNext()}</span><span class="pg-mono">position ${w.it.pos()} of ${pl.songs.length}</span><span class="pg-mono">got: ${w.got.length ? w.got.join(' → ') : '—'}</span>`;
        const row = document.createElement('div'); row.className = 'pg-row';
        const n = document.createElement('button'); n.type = 'button'; n.className = 'btn pg-primary'; n.textContent = 'next()'; n.disabled = !w.it.hasNext(); n.addEventListener('click', () => { const s = w.it.next(); w.got.push(s); draw(); q('[data-status]').textContent = `Iterator ${w.id} got ${s}, position ${w.it.pos()} of ${pl.songs.length}`; });
        const r = document.createElement('button'); r.type = 'button'; r.className = 'btn'; r.textContent = 'Reset'; r.addEventListener('click', () => { w.it = pl.create(w.kind); w.got = []; draw(); q('[data-status]').textContent = `Iterator ${w.id} reset`; });
        const k = document.createElement('button'); k.type = 'button'; k.className = 'btn'; k.textContent = w.kind === 'forward' ? 'Make reverse' : 'Make forward'; k.addEventListener('click', () => { w.kind = w.kind === 'forward' ? 'reverse' : 'forward'; w.it = pl.create(w.kind); w.got = []; draw(); q('[data-status]').textContent = `Iterator ${w.id} is now ${w.kind}`; });
        row.append(n, r, k); d.appendChild(row); g.appendChild(d);
      });
    }
    q('[data-add]').addEventListener('click', () => { const s = q<HTMLInputElement>('[data-song]').value.trim(); if (s) { pl.songs.push(s); draw(); q('[data-status]').textContent = `Added ${s}. Playlist has ${pl.songs.length} songs`; } });
    draw();
  });
</script>
