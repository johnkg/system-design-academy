---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A server holds many mostly idle connections on a machine with 4 cores, and each event needs 2 ms of CPU. Compare a thread for every connection with a reactor, and see what one blocking handler does.">
  <ol class="how">
    <li>Start with the defaults: <b>Connections</b> at <b>1000</b>, <b>Reactor loops</b> at <b>1</b>, <b>Blocking handler</b> at <b>200</b> ms and <b>Design</b> <b>Thread per connection</b>. That means <b>1000</b> threads, <b>0</b> connections held up by a blocking handler, and up to <b>2000</b> events a second.</li>
    <li>Set <b>Design</b> to <b>Reactor</b>: <b>1</b> thread, but a blocking handler holds up <b>1000</b> connections for 200 ms, and throughput is <b>500</b> events a second, because one loop uses one core.</li>
    <li>Set <b>Reactor loops</b> to <b>4</b>, one for each core: <b>4</b> threads, <b>250</b> connections held up, and <b>2000</b> events a second.</li>
    <li>Set <b>Blocking handler</b> to <b>0</b>: <b>0</b> connections are held up. Handlers that never block are what makes a reactor work.</li>
  </ol>
  <div class="pg rct" data-rct>
    <div class="pg-row">
      <label>Connections <input class="pg-in" type="range" min="10" max="2000" step="10" value="1000" data-n /> <b data-nv></b></label>
      <label>Reactor loops <input class="pg-in" type="range" min="1" max="4" step="1" value="1" data-l /> <b data-lv></b></label>
      <label>Blocking handler <input class="pg-in" type="range" min="0" max="500" step="50" value="200" data-b /> <b data-bv></b> ms</label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Thread per connection</option><option value="1">Reactor</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Threads</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Connections held up by one blocking handler</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Peak events a second</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // 4 cores, 2 ms of CPU per event. A thread per connection can use every core; a reactor uses one core per loop.
  const CORES = 4, EVENT_MS = 2;
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-rct]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const n = Number(q<HTMLInputElement>('[data-n]').value), loops = Number(q<HTMLInputElement>('[data-l]').value);
      const block = Number(q<HTMLInputElement>('[data-b]').value), reactor = q<HTMLSelectElement>('[data-design]').value === '1';
      q('[data-nv]').textContent = String(n); q('[data-lv]').textContent = String(loops); q('[data-bv]').textContent = String(block);
      const threads = reactor ? loops : n;
      const held = !reactor || block === 0 ? 0 : Math.ceil(n / loops);
      const perSecond = Math.min(reactor ? loops : n, CORES) * (1000 / EVENT_MS);
      setBox(1, String(threads), reactor ? 'one thread for each loop, however many connections there are' : 'one thread for every connection, busy or idle', threads <= 8 ? 'good' : 'bad');
      setBox(2, String(held), held > 0 ? `each waits ${block} ms while the handler blocks its loop` : reactor ? 'no handler blocks, so nobody waits' : 'each connection has a thread, so a blocked one holds up only itself', held > 0 ? 'bad' : 'good');
      setBox(3, String(perSecond), reactor ? `${Math.min(loops, CORES)} of the ${CORES} cores are busy` : `all ${CORES} cores can be used, but the threads cost memory and scheduling`, perSecond >= CORES * 500 ? 'good' : 'mid');
      q('[data-verdict]').textContent = reactor
        ? 'One thread serves every connection, but a handler that blocks holds up the connections on its loop, and one loop uses one core.'
        : 'Threads use every core and isolate a slow connection, but the cost of thousands of threads is not counted here, and it grows with every idle connection.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
