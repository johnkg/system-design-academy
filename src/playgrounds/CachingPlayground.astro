---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Request keys and watch what the cache keeps, what it evicts, and the hit rate.">
  <ol class="how">
    <li>Pick a <b>size</b> and an <b>eviction policy</b>. Click keys to request them: green is a hit, orange is a miss.</li>
    <li>Press <b>Run 100 requests</b>: a few popular keys get most of the traffic, like real life.</li>
    <li>Try a tiny cache, then a bigger one, and switch policies. See how the <b>hit rate</b> changes.</li>
  </ol>
  <div class="pg" data-cache>
    <div class="pg-row">
      <label>Cache size <input type="range" min="1" max="8" value="4" data-size /> <b data-sizeval>4</b></label>
      <span class="pg-row" role="group" aria-label="Eviction policy" data-policies></span>
    </div>
    <div class="pg-row" role="group" aria-label="Request a key" data-keys></div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-run>Run 100 requests</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="ca-slots" data-slots aria-label="Cache contents"></div>
    <div class="ca-meter"><div class="ca-fill" data-fill></div></div>
    <output class="pg-out" data-out>Click a key to request it.</output>
  </div>
</PlaygroundShell>
<script>
  type Policy = 'lru' | 'lfu' | 'fifo';
  interface Entry { key: string; inserted: number; used: number; uses: number }
  const KEYS = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
  // Skewed traffic: earlier keys are requested much more often (roughly Zipf).
  const weights = KEYS.map((_, i) => 1 / (i + 1));
  const total = weights.reduce((a, b) => a + b, 0);
  function skewed(): string { let r = Math.random() * total; for (let i = 0; i < KEYS.length; i++) { r -= weights[i]; if (r <= 0) return KEYS[i]; } return KEYS[0]; }

  document.querySelectorAll<HTMLElement>('[data-cache]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let policy: Policy = 'lru'; let tick = 0; let hits = 0; let misses = 0;
    let entries: Entry[] = [];
    const size = () => Number(q<HTMLInputElement>('[data-size]').value);

    function victim(): Entry {
      const by = (f: (e: Entry) => number) => entries.reduce((a, b) => (f(b) < f(a) ? b : a));
      return policy === 'lru' ? by((e) => e.used) : policy === 'lfu' ? by((e) => e.uses * 1000 + e.used) : by((e) => e.inserted);
    }
    function request(key: string): string {
      tick++;
      const e = entries.find((x) => x.key === key);
      if (e) { hits++; e.used = tick; e.uses++; return `HIT ${key}`; }
      misses++;
      let note = '';
      while (entries.length >= size()) { const v = victim(); entries = entries.filter((x) => x !== v); note = `, evicted ${v.key}`; }
      entries.push({ key, inserted: tick, used: tick, uses: 1 });
      return `MISS ${key} (loaded from database${note})`;
    }
    function draw(msg?: string) {
      const slots = q('[data-slots]'); slots.innerHTML = '';
      for (let i = 0; i < size(); i++) {
        const e = entries[i]; const d = document.createElement('div'); d.className = 'ca-slot' + (e ? ' full' : '');
        d.innerHTML = e ? `<b>${e.key}</b><small>used ${e.uses}×</small>` : '<small>empty</small>'; slots.appendChild(d);
      }
      const n = hits + misses; const rate = n ? Math.round((hits / n) * 100) : 0;
      q('[data-fill]').style.width = `${rate}%`;
      const o = q('[data-out]'); o.classList.remove('bad');
      o.textContent = `${msg ? msg + '\n' : ''}requests ${n} · hits ${hits} · misses ${misses} · hit rate ${rate}%`;
    }
    // Controls are built once.
    ['lru', 'lfu', 'fifo'].forEach((p) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = p.toUpperCase(); b.dataset.p = p; b.setAttribute('aria-pressed', String(p === policy)); b.addEventListener('click', () => { policy = p as Policy; q('[data-policies]').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.p === policy))); reset(); }); q('[data-policies]').appendChild(b); });
    KEYS.forEach((k) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = k; b.addEventListener('click', () => draw(request(k))); q('[data-keys]').appendChild(b); });
    function reset() { entries = []; tick = 0; hits = 0; misses = 0; draw('Cache emptied.'); }
    q('[data-run]').addEventListener('click', () => { for (let i = 0; i < 100; i++) request(skewed()); draw('Ran 100 requests with skewed traffic (A is most popular).'); });
    q('[data-reset]').addEventListener('click', reset);
    q<HTMLInputElement>('[data-size]').addEventListener('input', () => { q('[data-sizeval]').textContent = String(size()); while (entries.length > size()) entries = entries.filter((x) => x !== victim()); draw(); });
    draw('Cache is empty.');
  });
</script>
<style is:global>
  .playground .ca-slots { display: flex; flex-wrap: wrap; gap: 8px; }
  .playground .ca-slot { width: 74px; height: 62px; display: grid; place-items: center; align-content: center; border: 2px dashed var(--border); border-radius: 10px; background: var(--surface); }
  .playground .ca-slot.full { border-style: solid; border-color: var(--role-3); background: color-mix(in srgb, var(--role-3) 10%, var(--surface)); }
  .playground .ca-slot b { font-size: 1.2rem; }
  .playground .ca-slot small { color: var(--muted); font-size: .72rem; }
  .playground .ca-meter { height: 14px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .playground .ca-fill { height: 100%; background: var(--role-3); border-radius: 99px; transition: width .3s; width: 0; }
</style>
