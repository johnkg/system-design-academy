---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="40 users are spread across shards. Change the shard count or the strategy and see how many keys have to move.">
  <ol class="how">
    <li>Pick <b>Hash</b> or <b>Range</b> sharding. Each chip is a user, placed on the shard that owns it.</li>
    <li>Press <b>Add shard</b>. Chips that change shard are highlighted, and the message counts them.</li>
    <li>Press <b>Sign up 20 new users</b> with Range sharding: the newest ids all land on the last shard, a hot spot.</li>
  </ol>
  <div class="pg" data-shard>
    <div class="pg-row">
      <span role="group" aria-label="Sharding strategy" class="pg-row">
        <button class="btn" type="button" data-strat="hash" aria-pressed="true">Hash (mod N)</button>
        <button class="btn" type="button" data-strat="range" aria-pressed="false">Range</button>
      </span>
      <button class="btn pg-primary" type="button" data-add>Add shard</button>
      <button class="btn" type="button" data-remove>Remove shard</button>
      <button class="btn" type="button" data-signup>Sign up 20 new users</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="sh-cols" data-cols></div>
    <output class="pg-out" data-out aria-live="polite">Each chip is a user id.</output>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type Strategy = 'hash' | 'range';
  const START_SHARDS = 3, MAX_SHARDS = 6;
  const SIGNUP_BATCH = 20, MAX_USERS = 120;
  const HOT = 1.6; // a shard with 1.6x the average is hot
  // FNV-1a 32-bit hash
  function fnv(text: string) { let h = 2166136261; for (const ch of text) { h ^= ch.charCodeAt(0); h = Math.imul(h, 16777619) >>> 0; } return h >>> 0; }
  const BASE = 40; // the range boundaries were designed for the original 40 users
  document.querySelectorAll<HTMLElement>('[data-shard]').forEach((root) => {
    const q = query(root);
    let strat: Strategy = 'hash'; let n = START_SHARDS; let users = BASE;
    let previous = new Map<number, number>();
    const assign = (id: number, N: number, s: Strategy) => (s === 'hash' ? fnv(`user:${id}`) % N : Math.min(N - 1, Math.floor((id - 1) / (BASE / N))));
    function layout(N = n, s = strat) { const m = new Map<number, number>(); for (let id = 1; id <= users; id++) m.set(id, assign(id, N, s)); return m; }

    function draw(msg: string, movedSet = new Set<number>()) {
      const cur = layout(); const cols = q('[data-cols]'); cols.innerHTML = '';
      const per: number[][] = Array.from({ length: n }, () => []);
      cur.forEach((sh, id) => per[sh].push(id));
      const avg = users / n;
      per.forEach((ids, i) => {
        const hot = ids.length > avg * HOT && n > 1;
        const col = document.createElement('div'); col.className = 'pg-box'; col.style.setProperty('--c', hot ? 'var(--bad)' : 'var(--role-3)');
        col.innerHTML = `<h3>Shard ${i + 1}</h3><span class="pg-mono">${ids.length} users${hot ? ' (hot spot)' : ''}</span><div class="sh-chips"></div>`;
        const chips = col.querySelector('.sh-chips')!;
        ids.forEach((id) => { const c = document.createElement('span'); c.className = 'sh-chip' + (movedSet.has(id) ? ' moved' : ''); c.textContent = String(id); chips.appendChild(c); });
        cols.appendChild(col);
      });
      q('[data-out]').textContent = msg; previous = cur;
      q<HTMLButtonElement>('[data-remove]').setAttribute('aria-disabled', String(n <= 1));
      q<HTMLButtonElement>('[data-add]').setAttribute('aria-disabled', String(n >= MAX_SHARDS));
    }
    function reshard(newN: number, newS: Strategy, what: string) {
      const next = layout(newN, newS); const moved = new Set<number>();
      next.forEach((sh, id) => { if (previous.get(id) !== sh) moved.add(id); });
      n = newN; strat = newS;
      draw(`${what}: ${moved.size} of ${users} users (${Math.round((moved.size / users) * 100)}%) moved to a different shard.`, moved);
    }
    q('[data-add]').addEventListener('click', () => { if (n < MAX_SHARDS) reshard(n + 1, strat, `Added a shard (${n + 1} total)`); });
    q('[data-remove]').addEventListener('click', () => { if (n > 1) reshard(n - 1, strat, `Removed a shard (${n - 1} total)`); });
    q('[data-signup]').addEventListener('click', () => { if (users + SIGNUP_BATCH > MAX_USERS) { draw('That is plenty of users for this demo. Press Reset.'); return; } users += SIGNUP_BATCH; const first = users - SIGNUP_BATCH + 1; draw(`Signed up ${SIGNUP_BATCH} new users (ids ${first} to ${users}).`, new Set(Array.from({ length: SIGNUP_BATCH }, (_, i) => first + i))); });
    q('[data-reset]').addEventListener('click', () => { n = START_SHARDS; users = BASE; previous = layout(); draw(`Reset to ${START_SHARDS} shards and ${BASE} users.`); });
    root.querySelectorAll<HTMLButtonElement>('[data-strat]').forEach((b) => b.addEventListener('click', () => { const s = b.dataset.strat as Strategy; if (s === strat) return; root.querySelectorAll('[data-strat]').forEach((o) => o.setAttribute('aria-pressed', String(o === b))); reshard(n, s, `Switched to ${s} sharding`); }));
    previous = layout(); draw('Each chip is a user id. Hash sharding spreads them evenly.');
  });
</script>
<style is:global>
  .playground .sh-cols { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(min(120px, 100%), 1fr)); }
  .playground .sh-chips { display: flex; flex-wrap: wrap; gap: 4px; }
  .playground .sh-chip { min-width: 26px; padding: 1px 5px; text-align: center; font: .75rem var(--font-mono); border-radius: 6px; background: var(--surface-2); border: 1px solid var(--border); }
  .playground .sh-chip.moved { background: var(--role-4); border-color: var(--role-4); color: #1b1d24; font-weight: 700; }
</style>
