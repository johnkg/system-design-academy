---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Four teams of one shop each mean something different by customer. Pick how the model is cut and a change to see which files and teams it touches, then pick an aggregate boundary to see which business rules one transaction can still enforce.">
  <ol class="how">
    <li>Set <b>Model</b> to <b>One shared model</b> and <b>Change</b> to <b>Sales adds a loyalty tier</b>: <b>2</b> files are edited, but <b>5</b> files in <b>5</b> teams are tested again. Set <b>Model</b> to <b>Contexts with translation</b>: <b>3</b> files are edited and only <b>3</b> files in <b>1</b> team are tested again.</li>
    <li>Set <b>Model</b> to <b>Contexts reusing upstream types</b>: the same change edits <b>5</b> files in <b>4</b> teams. Set <b>Model</b> to <b>A context per entity</b>: it edits <b>7</b> files, in a design of <b>17</b> files.</li>
    <li>Read the table of all four changes. Files edited: <b>8</b> for the shared model, <b>12</b> with translation, <b>12</b> reusing upstream types, <b>26</b> for a context per entity. Tests run again: <b>20</b>, <b>12</b>, <b>12</b> and <b>38</b>.</li>
    <li>Set <b>Aggregate boundary</b> to <b>One big aggregate</b>: <b>5</b> of <b>5</b> rules hold in one transaction, but a write locks <b>5</b> entities. Set it to <b>Order with its lines</b>: <b>2</b> of <b>5</b> rules, <b>3</b> eventual, <b>2</b> entities locked.</li>
  </ol>
  <div class="pg arc" data-arc>
    <div class="pg-row">
      <label>Model <select class="pg-in" data-design>
        <option value="0" selected>One shared model</option>
        <option value="1">Contexts with translation</option>
        <option value="2">Contexts reusing upstream types</option>
        <option value="3">A context per entity</option>
      </select></label>
      <label>Change <select class="pg-in" data-req>
        <option value="0" selected>Sales adds a loyalty tier</option>
        <option value="1">Shipping allows several addresses</option>
        <option value="2">Billing separates payer from user</option>
        <option value="3">Support calls the customer a requester</option>
      </select></label>
      <label>Aggregate boundary <select class="pg-in" data-agg>
        <option value="0">One big aggregate</option>
        <option value="1" selected>Order with its lines</option>
        <option value="2">Every entity alone</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Files edited</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Teams that edit</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Files to test again</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Teams whose tests run again</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Files in the design</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b6><h3>Rules enforced in one transaction</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
      <div class="pg-box" data-b7><h3>Rules that are only eventually true</h3><span class="pg-mono" data-o7></span><span class="pg-note" data-n7></span></div>
      <div class="pg-box" data-b8><h3>Entities locked by the biggest write</h3><span class="pg-mono" data-o8></span><span class="pg-note" data-n8></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The same four changes, four models</h3>
      <div class="arc-scroll" tabindex="0" role="region" aria-label="Totals for the four models"><table class="arc-table" data-table>
        <thead><tr><th scope="col">Model</th><th scope="col">Files</th><th scope="col">Files edited</th><th scope="col">Team-edits</th><th scope="col">Tests run again</th><th scope="col">Team-retests</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <span class="pg-note">Totals over the four changes. A file is tested again when it is edited or imports an edited file. A team-edit is one team with at least one edited file in one change.</span>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="Files edited per change, for the chosen model"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  type File = { name: string; team: string; holds: string[]; copies: string[]; imports: string[] };
  const f = (name: string, team: string, holds: string[], copies: string[], imports: string[]): File => ({ name, team, holds, copies, imports });
  const ctx = (name: string, holds: string[], copies: string[]): File[] => [
    f(`${name}Model`, name.toLowerCase(), holds, copies, []),
    f(`${name}Acl`, name.toLowerCase(), [], holds.concat(copies), [`${name}Model`, 'PublishedLanguage']),
  ];
  const DESIGNS: { name: string; files: File[] }[] = [
    { name: 'One shared model', files: [
      f('CustomerModel', 'shared', ['loyalty.data', 'address.data', 'payer.data', 'requester.data'], [], []),
      f('SalesApp', 'sales', ['loyalty.rule'], [], ['CustomerModel']),
      f('ShippingApp', 'shipping', ['address.rule'], [], ['CustomerModel']),
      f('BillingApp', 'billing', ['payer.rule'], [], ['CustomerModel']),
      f('SupportApp', 'support', ['requester.rule'], [], ['CustomerModel']),
    ] },
    { name: 'Contexts with translation', files: [
      f('PublishedLanguage', 'shared', [], [], []),
      ...ctx('Sales', ['loyalty.data'], []),
      ...ctx('Shipping', ['address.data'], []),
      ...ctx('Billing', ['payer.data'], []),
      ...ctx('Support', ['requester.data'], []),
      f('SalesApp', 'sales', ['loyalty.rule'], [], ['SalesModel']),
      f('ShippingApp', 'shipping', ['address.rule'], [], ['ShippingModel']),
      f('BillingApp', 'billing', ['payer.rule'], [], ['BillingModel']),
      f('SupportApp', 'support', ['requester.rule'], [], ['SupportModel']),
    ] },
    { name: 'Contexts reusing upstream types', files: [
      f('SalesModel', 'sales', ['loyalty.data'], [], []),
      f('ShippingModel', 'shipping', ['address.data'], [], []),
      f('BillingModel', 'billing', ['payer.data'], [], []),
      f('SupportModel', 'support', ['requester.data'], [], []),
      f('SalesApp', 'sales', ['loyalty.rule'], [], ['SalesModel']),
      f('ShippingApp', 'shipping', ['address.rule'], ['loyalty.data'], ['ShippingModel', 'SalesModel']),
      f('BillingApp', 'billing', ['payer.rule'], ['loyalty.data'], ['BillingModel', 'SalesModel']),
      f('SupportApp', 'support', ['requester.rule'], ['loyalty.data', 'address.data'], ['SupportModel', 'SalesModel', 'ShippingModel']),
    ] },
    { name: 'A context per entity', files: [
      f('PublishedLanguage', 'shared', [], [], []),
      ...ctx('Loyalty', ['loyalty.data'], []),
      ...ctx('Customer', [], ['loyalty.data', 'address.data', 'payer.data', 'requester.data']),
      ...ctx('Address', ['address.data'], []),
      ...ctx('Payment', ['payer.data'], []),
      ...ctx('Ticket', ['requester.data'], []),
      ...ctx('Order', [], ['loyalty.data', 'address.data', 'payer.data']),
      f('SalesApp', 'sales', ['loyalty.rule'], [], ['LoyaltyModel', 'CustomerModel', 'OrderModel']),
      f('ShippingApp', 'shipping', ['address.rule'], [], ['AddressModel', 'CustomerModel', 'OrderModel']),
      f('BillingApp', 'billing', ['payer.rule'], [], ['PaymentModel', 'CustomerModel', 'OrderModel']),
      f('SupportApp', 'support', ['requester.rule'], [], ['TicketModel', 'CustomerModel']),
    ] },
  ];
  const CHANGES: { text: string; touches: string[] }[] = [
    { text: 'Sales adds a loyalty tier', touches: ['loyalty.data', 'loyalty.rule'] },
    { text: 'Shipping allows several addresses', touches: ['address.data', 'address.rule'] },
    { text: 'Billing separates payer from user', touches: ['payer.data', 'payer.rule'] },
    { text: 'Support calls the customer a requester', touches: ['requester.data', 'requester.rule'] },
  ];
  const INVARIANTS: { text: string; entities: string[] }[] = [
    { text: 'order total equals the sum of its lines', entities: ['Order', 'Line'] },
    { text: 'a line quantity stays above zero', entities: ['Line'] },
    { text: 'stock never goes below zero', entities: ['Line', 'Stock'] },
    { text: 'an order ships only when paid', entities: ['Order', 'Payment'] },
    { text: 'open orders stay under the credit limit', entities: ['Customer', 'Order'] },
  ];
  const AGGREGATES: { name: string; groups: string[][] }[] = [
    { name: 'One big aggregate', groups: [['Customer', 'Order', 'Line', 'Payment', 'Stock']] },
    { name: 'Order with its lines', groups: [['Order', 'Line'], ['Customer'], ['Payment'], ['Stock']] },
    { name: 'Every entity alone', groups: [['Customer'], ['Order'], ['Line'], ['Payment'], ['Stock']] },
  ];

  // The same model as the code samples.
  function analyse(files: File[], touches: string[]) {
    const hit = (ts: string[]) => ts.some((t) => touches.includes(t));
    const edited = files.filter((x) => hit(x.holds) || hit(x.copies));
    const retest = new Set(edited.map((x) => x.name));
    let grew = true;
    while (grew) { // anything that imports a retested file must be retested too
      grew = false;
      for (const x of files) if (!retest.has(x.name) && x.imports.some((c) => retest.has(c))) { retest.add(x.name); grew = true; }
    }
    const teamsOf = (names: Set<string>) => new Set(files.filter((x) => names.has(x.name)).map((x) => x.team)).size;
    return { edited: edited.map((x) => x.name), teams: teamsOf(new Set(edited.map((x) => x.name))), retest: retest.size, retestTeams: teamsOf(retest) };
  }

  document.querySelectorAll<HTMLElement>('[data-arc]').forEach((root) => {
    const q = query(root);
    const tbody = q('[data-table] tbody');
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const di = Number(q<HTMLSelectElement>('[data-design]').value);
      const ri = Number(q<HTMLSelectElement>('[data-req]').value);
      const ai = Number(q<HTMLSelectElement>('[data-agg]').value);
      const d = DESIGNS[di];
      const a = analyse(d.files, CHANGES[ri].touches);
      set(1, String(a.edited.length), a.edited.join(', '));
      box(1, a.edited.length <= 3);
      set(2, String(a.teams), 'teams that own an edited file (the shared model counts as a team)');
      box(2, a.teams <= 2);
      set(3, String(a.retest), 'the edited files plus every file that imports them');
      box(3, a.retest <= 3);
      set(4, String(a.retestTeams), 'teams that have to watch their tests for a change that is not theirs');
      box(4, a.retestTeams <= 2);
      set(5, String(d.files.length), 'every file is something to read, name and keep in step');
      box(5, d.files.length <= 13);
      const ag = AGGREGATES[ai];
      const atomic = INVARIANTS.filter((inv) => ag.groups.some((g) => inv.entities.every((e) => g.includes(e))));
      const biggest = Math.max(...ag.groups.map((g) => g.length));
      set(6, `${atomic.length} of ${INVARIANTS.length}`, atomic.map((x) => x.text).join('; '));
      box(6, atomic.length >= 3);
      set(7, String(INVARIANTS.length - atomic.length), INVARIANTS.length === atomic.length ? 'every rule can be checked in one transaction' : 'these need events, a process or a repair step to become true');
      box(7, INVARIANTS.length - atomic.length <= 2);
      set(8, String(biggest), biggest > 2 ? 'every write locks all of them, so writers queue' : 'a write locks only the entities of one small aggregate');
      box(8, biggest <= 2);
      tbody.textContent = '';
      DESIGNS.forEach((x, i) => {
        let te = 0, tt = 0, tr = 0, tq = 0;
        for (const c of CHANGES) { const s = analyse(x.files, c.touches); te += s.edited.length; tt += s.teams; tr += s.retest; tq += s.retestTeams; }
        const row = document.createElement('tr');
        if (i === di) row.className = 'sel';
        [x.name, String(x.files.length), String(te), String(tt), String(tr), String(tq)].forEach((text, k) => {
          const cell = document.createElement(k === 0 ? 'th' : 'td'); if (k === 0) cell.setAttribute('scope', 'row'); cell.textContent = text; row.appendChild(cell);
        });
        tbody.appendChild(row);
      });
      const log = q('[data-log]'); log.textContent = '';
      CHANGES.forEach((c) => {
        const s = analyse(d.files, c.touches);
        const li = document.createElement('li'); li.textContent = `${c.text}: edit ${s.edited.join(', ')}`; log.appendChild(li);
      });
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .arc-scroll { overflow-x: auto; }
  .playground .arc-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .arc-table th, .playground .arc-table td { padding: 5px 8px; border-bottom: 1px solid var(--border); text-align: left; }
  .playground .arc-table tr.sel { background: var(--accent-soft); font-weight: 600; }
</style>
