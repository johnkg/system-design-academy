---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Spend the budget" hint="A 30-day window. Pick an objective, then add incidents and watch the error budget drain and the policy kick in.">
  <ol class="how">
    <li>At <b>99.9%</b> the budget is about 43 minutes. Press <b>Bad deploy (20 min)</b> and <b>Provider blip (5 min)</b>: roughly half the budget is gone.</li>
    <li>Add a <b>Regional outage (60 min)</b>: the budget is spent and the policy says <b>freeze releases</b>. Switch to <b>99%</b> and the same incidents use only about a fifth of the budget: a looser objective buys freedom to ship.</li>
    <li>Move <b>day of the window</b> early and see the <b>burn rate</b> climb: spending half the budget on day 3 is far worse than on day 25.</li>
  </ol>
  <div class="pg slo" data-slo>
    <div class="pg-row">
      <label>Objective <select class="pg-in" data-target><option value="0.99">99% (432 min per 30 days)</option><option value="0.999" selected>99.9% (43 min)</option><option value="0.9999">99.99% (4.3 min)</option></select></label>
      <label>Day of the window <input type="range" min="1" max="30" value="15" data-day /> <b data-dayval></b></label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-add="20">Bad deploy (20 min)</button>
      <button class="btn" type="button" data-add="5">Provider blip (5 min)</button>
      <button class="btn" type="button" data-add="12">Slow day (12 min equivalent)</button>
      <button class="btn" type="button" data-add="60">Regional outage (60 min)</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <div class="slo-bar" role="img" aria-label="Error budget remaining" data-bar><div class="slo-fill" data-fill></div></div>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--role-1)"><h3>Budget</h3><span class="pg-mono" data-budget></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Spent</h3><span class="pg-mono" data-spent></span></div>
      <div class="pg-box" data-burnbox><h3>Burn rate</h3><span class="pg-mono" data-burn></span><span class="pg-note">1.0x spends the budget exactly by day 30</span></div>
    </div>
    <p class="pg-out" data-policy aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const WINDOW_DAYS = 30; const MIN_PER_DAY = 1440; // 30-day SLO window
  const BURN_FAST = 2; const LOW_BUDGET = 0.25; // burn above 2x is red; under a quarter of the budget left is low
  document.querySelectorAll<HTMLElement>('[data-slo]').forEach((root) => {
    const q = query(root);
    let spent = 0;
    function draw() {
      const target = Number(q<HTMLSelectElement>('[data-target]').value); const day = Number(q<HTMLInputElement>('[data-day]').value);
      q('[data-dayval]').textContent = `day ${day}`;
      const budget = (1 - target) * WINDOW_DAYS * MIN_PER_DAY; const left = budget - spent; const frac = Math.max(0, left / budget);
      q('[data-budget]').textContent = `${budget >= 100 ? Math.round(budget) : budget.toFixed(1)} minutes`; q('[data-spent]').textContent = `${spent} minutes (${Math.round((spent / budget) * 100)}%)`;
      const burn = (spent / budget) / (day / WINDOW_DAYS); q('[data-burn]').textContent = `${burn.toFixed(1)}x`;
      q<HTMLElement>('[data-burnbox]').style.setProperty('--c', burn > BURN_FAST ? 'var(--bad)' : burn > 1 ? 'var(--role-3)' : 'var(--role-2)');
      const fill = q('[data-fill]'); fill.style.width = `${frac * 100}%`; fill.classList.toggle('low', frac < LOW_BUDGET); fill.classList.toggle('out', frac === 0);
      q('[data-bar]').setAttribute('aria-label', `${Math.round(frac * 100)}% of the error budget remains`);
      const out = q('[data-policy]'); const bad = frac === 0 || burn > BURN_FAST; out.classList.toggle('bad', bad);
      out.textContent = frac === 0 ? 'Budget spent. Policy: freeze feature releases and work on reliability until the service is back within its objective.' : burn > BURN_FAST ? `Burning ${burn.toFixed(1)}x too fast. At this rate the budget runs out before the window ends: slow down risky changes.` : left > 0 && spent === 0 ? 'Full budget. Ship, take risks, learn.' : `${Math.round(frac * 100)}% of the budget left. On track: keep shipping, with care.`;
    }
    root.querySelectorAll<HTMLElement>('[data-add]').forEach((b) => b.addEventListener('click', () => { spent += Number(b.dataset.add); draw(); }));
    q('[data-reset]').addEventListener('click', () => { spent = 0; draw(); });
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .slo-bar { height: 22px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .playground .slo-fill { height: 100%; border-radius: 99px; background: var(--role-2); transition: width .2s, background .2s; }
  .playground .slo-fill.low { background: var(--role-3); }
  .playground .slo-fill.out { background: var(--bad); }
</style>
