---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Swap the factory and watch the whole family change together.">
  <ol class="how">
    <li>Pick a <b>factory</b>. The form is rebuilt using only that factory.</li>
    <li>Turn on <b>Build widgets separately</b> to see the mismatch the pattern prevents.</li>
  </ol>
  <div class="pg" data-af>
    <div class="pg-row" role="group" aria-label="Factory" data-factories></div>
    <label class="pg-row"><input type="checkbox" data-mix /> Build widgets separately (no factory)</label>
    <div class="pg-row" data-mixrow hidden>
      <label>Button <select class="pg-in" data-bsel><option>light</option><option>dark</option></select></label>
      <label>Checkbox <select class="pg-in" data-csel><option>dark</option><option>light</option></select></label>
    </div>
    <div class="af-preview" data-preview></div>
    <pre class="pg-code" data-code></pre>
    <p class="pg-note" data-note aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  const factories = [{ id: 'light', label: 'LightFactory' }, { id: 'dark', label: 'DarkFactory' }, { id: 'neon', label: 'NeonFactory (new)' }];
  document.querySelectorAll<HTMLElement>('[data-af]').forEach((root) => {
    const q = query(root);
    let current = 'light';
    const avail = [factories[0], factories[1]];
    function chips() {
      const w = q('[data-factories]'); w.innerHTML = '';
      avail.forEach((f) => {
        const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = f.label;
        b.setAttribute('aria-pressed', String(f.id === current)); b.addEventListener('click', () => { current = f.id; chips(); draw(); }); w.appendChild(b);
      });
      if (avail.length < factories.length) {
        const add = document.createElement('button'); add.type = 'button'; add.className = 'btn'; add.textContent = '+ Add a theme';
        add.addEventListener('click', () => { avail.push(factories[2]); current = 'neon'; chips(); draw(); }); w.appendChild(add);
      }
    }
    function draw() {
      const mix = q<HTMLInputElement>('[data-mix]').checked;
      q('[data-mixrow]').hidden = !mix;
      const bTheme = mix ? q<HTMLSelectElement>('[data-bsel]').value : current;
      const cTheme = mix ? q<HTMLSelectElement>('[data-csel]').value : current;
      const mismatch = bTheme !== cTheme;
      q('[data-preview]').innerHTML = `<div class="af-form af-${bTheme === cTheme ? bTheme : 'mixed'}"><label class="af-cb af-${cTheme}"><span class="af-box"></span> Remember me</label><button class="af-btn af-${bTheme}" type="button">Sign in</button></div>`;
      q('[data-code]').textContent = mix
        ? `new ${bTheme[0].toUpperCase()}${bTheme.slice(1)}Button()\nnew ${cTheme[0].toUpperCase()}${cTheme.slice(1)}Checkbox()`
        : `const factory = new ${factories.find((f) => f.id === current)!.label.split(' ')[0]}();\nfactory.createButton();\nfactory.createCheckbox();`;
      q('[data-note]').textContent = mismatch ? 'Mismatched families: nothing stopped this. A factory would have.' : mix ? 'Matching, but only by luck.' : 'One factory, so the family always matches.';
      q('[data-preview]').classList.remove('pg-pop'); void (q('[data-preview]') as HTMLElement).offsetWidth; q('[data-preview]').classList.add('pg-pop');
    }
    root.querySelectorAll('[data-mix],[data-bsel],[data-csel]').forEach((e) => e.addEventListener('change', draw));
    chips(); draw();
  });
</script>
<style is:global>
  .playground .af-form { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; padding: 16px; border-radius: 10px; border: 1px solid var(--border); }
  .playground .af-form.af-light { background: #fff; color: #222; } .playground .af-form.af-dark { background: #20232a; color: #eee; }
  .playground .af-form.af-neon { background: #0b0b1a; color: #7cfff0; } .playground .af-form.af-mixed { background: repeating-linear-gradient(45deg, #fff 0 12px, #20232a 12px 24px); }
  .playground .af-cb { display: flex; gap: 8px; align-items: center; padding: 4px 8px; border-radius: 6px; }
  .playground .af-cb.af-light { background: #fff; color: #222; } .playground .af-cb.af-dark { background: #20232a; color: #eee; } .playground .af-cb.af-neon { background: #0b0b1a; color: #7cfff0; }
  .playground .af-box { width: 16px; height: 16px; border: 2px solid currentColor; border-radius: 4px; }
  .playground .af-btn { font: inherit; padding: 6px 16px; border-radius: 8px; border: 2px solid; cursor: default; }
  .playground .af-btn.af-light { background: #f1f3f9; color: #222; border-color: #ccd; } .playground .af-btn.af-dark { background: #3a3f4b; color: #eee; border-color: #555; }
  .playground .af-btn.af-neon { background: #120a2b; color: #ff4fd8; border-color: #ff4fd8; box-shadow: 0 0 10px #ff4fd8; }
</style>
