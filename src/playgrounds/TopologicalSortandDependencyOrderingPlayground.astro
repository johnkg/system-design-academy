---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Order a build of n tasks three ways and count operations (a task visit or a dependency visit). Nothing is timed. The task graph is generated by a fixed rule, so the same settings always give the same numbers; an optional 3-task cycle shows what each method does with an impossible build.">
  <ol class="how">
    <li>Set <b>Tasks</b> to <b>1,000</b> and <b>Method</b> to <b>Scan for the next ready task</b>: <b>757,544</b> operations. Switch <b>Method</b> to <b>Kahn (count unfinished dependencies)</b>: <b>5,046</b>. Switch to <b>Depth-first search</b>: <b>3,523</b>. The graph has <b>1,523</b> dependencies; the scan pays for rescanning the list every time.</li>
    <li>Tick <b>Add a 3-task cycle</b> with <b>Method</b> on <b>Kahn (count unfinished dependencies)</b>: <b>535</b> of <b>1,000</b> tasks get ordered and <b>465</b> are stuck, though only 3 tasks form the cycle: everything that depends on them is stuck too. Switch to <b>Depth-first search</b>: it reports the cycle after <b>3,524</b> operations.</li>
    <li>Untick the cycle and set <b>Workers</b> to <b>4</b>: the build takes <b>400</b> time steps instead of <b>1,000</b> with one worker. Set <b>Workers</b> to <b>16</b> and then to <b>Unlimited</b>: <b>394</b> steps both times, because the longest chain of dependencies has <b>394</b> levels and no extra worker can shorten it.</li>
  </ol>
  <div class="pg ts" data-ts>
    <div class="pg-row">
      <label>Tasks <select class="pg-in" data-n><option value="10">10</option><option value="100">100</option><option value="500">500</option><option value="1000" selected>1,000</option><option value="2000">2,000</option></select></label>
      <label>Method <select class="pg-in" data-method><option value="scan" selected>Scan for the next ready task</option><option value="kahn">Kahn (count unfinished dependencies)</option><option value="dfs">Depth-first search</option></select></label>
      <label>Workers <select class="pg-in" data-workers><option value="1" selected>1</option><option value="4">4</option><option value="16">16</option><option value="0">Unlimited</option></select></label>
      <label><input type="checkbox" data-cycle /> Add a 3-task cycle</label>
    </div>
    <span class="pg-note" data-graphnote></span>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Operations</h3><span class="pg-mono ts-big" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Tasks ordered</h3><span class="pg-mono ts-big" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Longest chain (levels)</h3><span class="pg-mono ts-big" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Build time in steps</h3><span class="pg-mono ts-big" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Operations by method, log scale</h3>
      <div class="ts-bars" data-bars></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const NS_PER_OP = 10; // assumption for the rough time guide: 10 ns per operation

  // The same model as the code samples.
  const label = (i: number, n: number) => (i * 37 + 11) % n;
  function build(n: number, withCycle: boolean): number[][] {
    const deps: number[][] = Array.from({ length: n }, () => []);
    for (let i = 0; i < n; i++) {
      const d: number[] = [];
      if (i % 4 !== 0) d.push(label(i - 1, n));
      for (let j = Math.max(0, i - 8); j < i - 1; j++) if ((i * 7 + j * 13) % 9 === 0) d.push(label(j, n));
      deps[label(i, n)] = d;
    }
    if (withCycle) {
      const a = 4 * Math.floor(n / 8) + 1;
      deps[label(a, n)].push(label(a + 2, n));
    }
    return deps;
  }
  const countEdges = (deps: number[][]) => deps.reduce((s, d) => s + d.length, 0);

  function scanSort(deps: number[][]) {
    const n = deps.length; let ops = 0;
    const done = new Array<boolean>(n).fill(false); const order: number[] = [];
    while (order.length < n) {
      let picked = -1;
      for (let t = 0; t < n; t++) {
        ops++;
        if (done[t]) continue;
        let ready = true;
        for (const d of deps[t]) { ops++; if (!done[d]) { ready = false; break; } }
        if (ready) { picked = t; break; }
      }
      if (picked < 0) break;
      done[picked] = true; order.push(picked);
    }
    return { order, ops };
  }
  function kahnSort(deps: number[][]) {
    const n = deps.length; let ops = 0;
    const dependents: number[][] = Array.from({ length: n }, () => []); const indeg = new Array<number>(n).fill(0);
    for (let t = 0; t < n; t++) for (const d of deps[t]) { ops++; dependents[d].push(t); indeg[t]++; }
    const queue: number[] = [];
    for (let t = 0; t < n; t++) { ops++; if (indeg[t] === 0) queue.push(t); }
    let head = 0; const order: number[] = [];
    while (head < queue.length) {
      const t = queue[head++]; ops++; order.push(t);
      for (const u of dependents[t]) { ops++; indeg[u]--; if (indeg[u] === 0) queue.push(u); }
    }
    return { order, ops };
  }
  function dfsSort(deps: number[][]) {
    const n = deps.length; const colour = new Array<number>(n).fill(0); const order: number[] = [];
    let ops = 0, cycleAt = -1;
    const visit = (t: number) => {
      ops++; colour[t] = 1;
      for (const d of deps[t]) { ops++; if (colour[d] === 1) { if (cycleAt < 0) cycleAt = d; } else if (colour[d] === 0) visit(d); }
      colour[t] = 2; order.push(t);
    };
    for (let t = 0; t < n; t++) { ops++; if (colour[t] === 0) visit(t); }
    return { order, ops, cycleAt };
  }
  function levels(deps: number[][]): number {
    const { order } = kahnSort(deps); const lv = new Array<number>(deps.length).fill(0); let top = 0;
    for (const t of order) { let best = 0; for (const d of deps[t]) best = Math.max(best, lv[d]); lv[t] = 1 + best; top = Math.max(top, lv[t]); }
    return top;
  }
  function makespan(deps: number[][], w: number): number {
    const n = deps.length;
    const dependents: number[][] = Array.from({ length: n }, () => []); const indeg = deps.map((d) => d.length);
    for (let t = 0; t < n; t++) for (const d of deps[t]) dependents[d].push(t);
    let ready: number[] = []; for (let t = 0; t < n; t++) if (indeg[t] === 0) ready.push(t);
    let steps = 0, finished = 0;
    while (finished < n) {
      const batch = ready.slice(0, w); ready = ready.slice(w); steps++; finished += batch.length;
      for (const t of batch) for (const u of dependents[t]) { indeg[u]--; if (indeg[u] === 0) ready.push(u); }
      ready.sort((a, b) => a - b);
    }
    return steps;
  }
  function duration(ops: number): string {
    const s = (ops * NS_PER_OP) / 1e9;
    if (s < 0.001) return 'well under a millisecond';
    if (s < 1) return `about ${Math.max(1, Math.round(s * 1000))} milliseconds`;
    return `about ${Math.round(s)} seconds`;
  }

  document.querySelectorAll<HTMLElement>('[data-ts]').forEach((root) => {
    const q = query(root);
    const colour = (n: number, c: string) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', c);
    function draw() {
      const n = Number(q<HTMLSelectElement>('[data-n]').value);
      const method = q<HTMLSelectElement>('[data-method]').value;
      const workers = Number(q<HTMLSelectElement>('[data-workers]').value);
      const cycle = q<HTMLInputElement>('[data-cycle]').checked;
      const deps = build(n, cycle);
      q('[data-graphnote]').textContent = `Ordering ${formatThousands(n)} tasks with ${formatThousands(countEdges(deps))} dependencies${cycle ? ', one of them closing a 3-task cycle' : ''}.`;
      const scan = scanSort(deps), kahn = kahnSort(deps), dfs = dfsSort(deps);
      const pick = method === 'scan' ? scan : method === 'kahn' ? kahn : dfs;
      q('[data-o1]').textContent = formatThousands(pick.ops);
      q('[data-n1]').textContent = method === 'scan' ? 'every pick rescans the task list from the start' : method === 'kahn' ? 'each task and each dependency is touched a fixed number of times' : 'each task and each dependency is visited once';
      colour(1, method === 'scan' ? 'var(--bad)' : 'var(--good)');

      const ordered = method === 'dfs' && cycle ? 0 : pick.order.length;
      const stuck = n - ordered;
      if (method === 'dfs') {
        q('[data-o2]').textContent = cycle ? 'cycle found' : `${formatThousands(n)} of ${formatThousands(n)}`;
        q('[data-n2]').textContent = cycle ? 'a task was reached again while still on the current path: no valid order exists, so none is returned' : 'every task comes after everything it depends on';
        colour(2, cycle ? 'var(--bad)' : 'var(--good)');
      } else {
        q('[data-o2]').textContent = `${formatThousands(ordered)} of ${formatThousands(n)}`;
        q('[data-n2]').textContent = cycle ? `${formatThousands(stuck)} tasks are stuck: the 3 in the cycle plus every task that depends on them, directly or not` : 'every task comes after everything it depends on';
        colour(2, cycle ? 'var(--bad)' : 'var(--good)');
      }

      const clean = build(n, false);
      const lv = levels(clean);
      q('[data-o3]').textContent = formatThousands(lv);
      q('[data-n3]').textContent = 'the critical path: tasks in a chain must run one after another, whatever the number of workers';
      colour(3, 'var(--border)');
      const w = workers === 0 ? n : workers;
      const span = makespan(clean, w);
      q('[data-o4]').textContent = formatThousands(span);
      q('[data-n4]').textContent = span === lv ? 'at the floor set by the longest chain: more workers would not help' : `${formatThousands(w)} worker${w === 1 ? '' : 's'}, one step per task; the floor is ${formatThousands(lv)}`;
      colour(4, span === lv ? 'var(--good)' : 'var(--border)');

      const rows: [string, number][] = [['Scan', scan.ops], ['Kahn', kahn.ops], ['DFS', dfs.ops]];
      const barsEl = q('[data-bars]'); barsEl.textContent = '';
      const top = Math.max(...rows.map((r) => r[1]));
      const digits = Math.max(2, Math.ceil(Math.log10(top + 1)));
      for (const [name, v] of rows) {
        const row = document.createElement('div'); row.className = 'ts-bar';
        const nm = document.createElement('span'); nm.textContent = name;
        const track = document.createElement('span'); track.className = 'ts-track';
        const fill = document.createElement('span'); fill.className = 'ts-fill'; fill.style.width = `${Math.max(2, (Math.log10(Math.max(1, v)) / digits) * 100)}%`;
        track.appendChild(fill);
        const num = document.createElement('span'); num.className = 'pg-mono'; num.textContent = `${formatThousands(v)} operations`;
        row.append(nm, track, num); barsEl.appendChild(row);
      }
      q('[data-verdict]').textContent = `Scan costs ${formatThousands(Math.round(scan.ops / kahn.ops))} times as much as Kahn here (${duration(scan.ops)} against ${duration(kahn.ops)} at 10 ns an operation, an assumption). Bar length is the number of digits, so each tick right is ten times more work.`;
    }
    root.addEventListener('change', draw);
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .playground .ts-big { font-size: 1.15rem; font-weight: 600; }
  .playground .ts-bars { display: grid; gap: 6px; }
  .playground .ts-bar { display: grid; grid-template-columns: 4rem 1fr; gap: 2px 8px; align-items: center; }
  .playground .ts-bar .pg-mono { grid-column: 2; }
  .playground .ts-track { display: block; height: 12px; border-radius: 6px; background: var(--surface-2); overflow: hidden; }
  .playground .ts-fill { display: block; height: 100%; background: var(--accent); border-radius: 6px; }
</style>
