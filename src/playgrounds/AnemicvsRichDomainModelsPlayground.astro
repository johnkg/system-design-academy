---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="An Order with four rules (no shipping unpaid, no shipping empty, no items after shipping, discount at most 50%). Five code paths each try all four forbidden changes: three go through the OrderService and two (an admin tool and a CSV import) write fields directly. Pick where the rules live and what happens.">
  <ol class="how">
    <li>Start with <b>Design</b> at <b>Anemic: fields plus a service</b> and <b>Situation</b> at <b>Five paths try the forbidden changes</b>: <b>8 of 20</b> forbidden changes get in, through the support admin tool and the CSV import job. The service was right; it was optional.</li>
    <li>Set <b>Situation</b> to <b>A new rule arrives</b>: the new rule is written in <b>3</b> places. Set <b>Design</b> to <b>Rich where rules exist</b>: <b>1</b> place, because the rule lives in the Order.</li>
    <li>Set <b>Situation</b> back to <b>Five paths try the forbidden changes</b>: with the rich Order it is <b>0 of 20</b>. Now set <b>Design</b> to <b>Rich everywhere</b>: still 0 of 20, but testing one rule needs <b>2</b> collaborators (a database and a mailer) because the entity saves and emails itself.</li>
    <li>Set <b>Situation</b> to <b>A plain Country table</b>: <b>Rich everywhere</b> writes <b>8</b> methods for a table with no rules and protects nothing more, where the other two designs write <b>2</b>. For simple CRUD, plain data is fine.</li>
  </ol>
  <div class="pg arm" data-arm>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design>
        <option value="0" selected>Anemic: fields plus a service</option>
        <option value="1">Rich where rules exist</option>
        <option value="2">Rich everywhere</option>
      </select></label>
      <label>Situation <select class="pg-in" data-sit>
        <option value="1" selected>Five paths try the forbidden changes</option>
        <option value="2">A new rule arrives</option>
        <option value="3">A plain Country table</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3 data-h1></h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3 data-h2></h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3 data-h3></h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <ol class="pg-log" data-log tabindex="0" aria-label="What each code path managed to do"></ol>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  // The same model as the code samples.
  const FORBIDDEN = ['ship an unpaid order', 'ship an empty order', 'add an item to a shipped order', 'give an 80% discount'];
  const CALLERS = [
    { name: 'Checkout service', direct: false }, { name: 'REST controller', direct: false }, { name: 'Support admin tool', direct: true },
    { name: 'CSV import job', direct: true }, { name: 'Nightly job', direct: false },
  ];
  class AnemicOrder { items: string[] = []; paid = false; shipped = false; discount = 0; }
  class OrderService {
    addItem(o: AnemicOrder, i: string) { if (o.shipped) throw new Error('shipped'); o.items.push(i); }
    pay(o: AnemicOrder) { o.paid = true; }
    ship(o: AnemicOrder) { if (!o.paid) throw new Error('unpaid'); if (o.items.length === 0) throw new Error('empty'); o.shipped = true; }
    applyDiscount(o: AnemicOrder, p: number) { if (p > 50) throw new Error('too high'); o.discount = p; }
  }
  class RichOrder {
    #items: string[] = []; #paid = false; #shipped = false; #discount = 0;
    addItem(i: string) { if (this.#shipped) throw new Error('shipped'); this.#items.push(i); }
    pay() { this.#paid = true; }
    ship() { if (!this.#paid) throw new Error('unpaid'); if (this.#items.length === 0) throw new Error('empty'); this.#shipped = true; }
    applyDiscount(p: number) { if (p > 50) throw new Error('too high'); this.#discount = p; }
  }
  class EverywhereOrder extends RichOrder {
    constructor(private db: { write(): void }, private mailer: { send(): void }) { super(); if (!db || !mailer) throw new Error('needs a database and a mailer'); }
    save() { this.db.write(); } emailReceipt() { this.mailer.send(); } renderInvoice() { return 'html'; }
  }
  const svc = new OrderService();
  function anemicOrder(k: number) { const o = new AnemicOrder(); if (k !== 1) svc.addItem(o, 'a'); if (k !== 0) svc.pay(o); if (k === 2) svc.ship(o); return o; }
  function richOrder(k: number, make: () => RichOrder) { const o = make(); if (k !== 1) o.addItem('a'); if (k !== 0) o.pay(); if (k === 2) o.ship(); return o; }
  function attempt(design: number, caller: { direct: boolean }, k: number): boolean {
    try {
      if (design === 0) {
        const o = anemicOrder(k);
        if (!caller.direct) { if (k < 2) svc.ship(o); else if (k === 2) svc.addItem(o, 'b'); else svc.applyDiscount(o, 80); }
        else if (k < 2) o.shipped = true; else if (k === 2) o.items.push('b'); else o.discount = 80;
      } else {
        const o = richOrder(k, design === 1 ? () => new RichOrder() : () => new EverywhereOrder({ write() {} }, { send() {} }));
        if (k < 2) o.ship(); else if (k === 2) o.addItem('b'); else o.applyDiscount(80);
      }
      return true;
    } catch { return false; }
  }
  const DESIGNS = [
    { name: 'Anemic: fields plus a service', where: () => ['OrderService', ...CALLERS.filter((c) => c.direct).map((c) => c.name)], methods: 2, needs: 0,
      note: 'Country (2 fields) and a repository with find and save', rule: 'enforced by whoever calls the service' },
    { name: 'Rich where rules exist', where: () => ['Order'], methods: 2, needs: 0,
      note: 'Country (2 fields) and a repository with find and save: nothing to protect, so nothing added', rule: 'enforced by the Order itself' },
    { name: 'Rich everywhere', where: () => ['Order'], methods: 8, needs: 2,
      note: 'Country with validate, rename, equals, display, save and load on top of find and save', rule: 'enforced by the Order, which also saves and emails itself' },
  ];

  document.querySelectorAll<HTMLElement>('[data-arm]').forEach((root) => {
    const q = query(root);
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, head: string, out: string, note: string) => { q(`[data-h${n}]`).textContent = head; q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const d = Number(q<HTMLSelectElement>('[data-design]').value);
      const sit = Number(q<HTMLSelectElement>('[data-sit]').value);
      const D = DESIGNS[d];
      const log = q('[data-log]'); log.textContent = '';
      const add = (t: string) => { const li = document.createElement('li'); li.textContent = t; log.appendChild(li); };
      if (sit === 1) {
        let accepted = 0; const through: string[] = [];
        for (const c of CALLERS) {
          let n = 0;
          for (let k = 0; k < FORBIDDEN.length; k++) if (attempt(d, c, k)) { n++; accepted++; }
          if (n) through.push(c.name);
          add(`${c.name} (${c.direct ? 'writes fields directly' : 'uses the service or the order methods'}): ${n} of ${FORBIDDEN.length} forbidden changes got in`);
        }
        set(1, 'Forbidden changes accepted', `${accepted} of ${CALLERS.length * FORBIDDEN.length}`, accepted ? 'invalid orders can now exist in the system' : 'no path can reach a forbidden state');
        box(1, accepted === 0);
        set(2, 'Paths that got through', through.length ? through.join(', ') : 'none', D.rule);
        box(2, through.length === 0);
        set(3, 'Collaborators needed to test one rule', String(D.needs), D.needs ? 'a database and a mailer, because the entity saves and emails itself' : 'none: the rule can be tested on the object or service alone');
        box(3, D.needs === 0);
      } else if (sit === 2) {
        const where = D.where();
        set(1, 'Places to write "no discount on a shipped order"', String(where.length), where.length > 1 ? 'the service and every path that bypasses it' : 'one method, next to the data it guards');
        box(1, where.length === 1);
        set(2, 'Where', where.join(', '), 'each place must stay in step with the others');
        box(2, where.length === 1);
        set(3, 'Collaborators needed to test one rule', String(D.needs), D.needs ? 'a database and a mailer' : 'none');
        box(3, D.needs === 0);
        where.forEach((w) => add(`write the rule in ${w}`));
      } else {
        set(1, 'Methods written for Country', String(D.methods), D.note);
        box(1, D.methods <= 2);
        set(2, 'Rules protected', '0', 'a code and a name have no invariant to keep, so no design adds protection');
        box(2, true);
        set(3, 'Verdict', D.methods <= 2 ? 'plain data' : 'ceremony', D.methods <= 2 ? 'fine for simple CRUD: nothing to guard' : 'behaviour without a rule to keep is only more code');
        box(3, D.methods <= 2);
      }
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
