---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Several services read orders, and a page lists open orders for many customers. Choose how data access is written, then see what it costs to change the store and to build the page.">
  <ol class="how">
    <li>Start with the defaults: <b>Services</b> at <b>4</b>, <b>Customers on the page</b> at <b>20</b> and <b>Design</b> <b>SQL inside each service</b>. Switching the store means editing <b>4</b> places, the page runs <b>20</b> queries, and the unit tests need a database.</li>
    <li>Set <b>Design</b> to <b>Repository, one call per customer</b>: only <b>1</b> place changes and the tests need no database, but the page still runs <b>20</b> queries. A collection-like call hides its cost.</li>
    <li>Set <b>Design</b> to <b>Repository with a batch method</b>: the page runs <b>1</b> query, and the store is still hidden behind <b>1</b> place.</li>
    <li>Set <b>Services</b> to <b>8</b> and <b>Customers on the page</b> to <b>50</b>, with <b>Design</b> on <b>SQL inside each service</b>: <b>8</b> places change and the page runs <b>50</b> queries.</li>
  </ol>
  <div class="pg repo" data-repo>
    <div class="pg-row">
      <label>Services <input class="pg-in" type="range" min="1" max="8" step="1" value="4" data-s /> <b data-sv></b></label>
      <label>Customers on the page <input class="pg-in" type="range" min="1" max="50" step="1" value="20" data-n /> <b data-nv></b></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>SQL inside each service</option><option value="1">Repository, one call per customer</option><option value="2">Repository with a batch method</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Places edited to change the store</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Queries to build the page</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Unit tests need a database</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // The same model as the code samples: services call either their own SQL or a repository interface.
  type Tone = 'good' | 'bad' | 'mid';
  interface Design { name: string; places: (s: number) => number; queries: (n: number) => number; needsDb: boolean; verdict: string }
  const DESIGNS: Design[] = [
    { name: 'SQL inside each service', places: (s) => s, queries: (n) => n, needsDb: true,
      verdict: 'Every service owns a copy of the query, so a new store or a new column is edited once per service, and a test cannot run without a database.' },
    { name: 'Repository, one call per customer', places: () => 1, queries: (n) => n, needsDb: false,
      verdict: 'The store is hidden and tests use an in-memory repository. But findOpenFor(customer) in a loop still sends one query per customer.' },
    { name: 'Repository with a batch method', places: () => 1, queries: () => 1, needsDb: false,
      verdict: 'A method shaped for the page, findOpenForAll(customers), keeps the storage hidden and answers in one query.' },
  ];

  document.querySelectorAll<HTMLElement>('[data-repo]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const s = Number(q<HTMLInputElement>('[data-s]').value), n = Number(q<HTMLInputElement>('[data-n]').value);
      const d = DESIGNS[Number(q<HTMLSelectElement>('[data-design]').value)];
      q('[data-sv]').textContent = String(s); q('[data-nv]').textContent = String(n);
      const places = d.places(s), queries = d.queries(n);
      setBox(1, String(places), places === 1 ? 'the one repository class' : 'one copy of the query in each service', places === 1 ? 'good' : 'bad');
      setBox(2, String(queries), queries === 1 ? 'one query for the whole page' : 'one query for each customer', queries === 1 ? 'good' : 'bad');
      setBox(3, d.needsDb ? 'Yes' : 'No', d.needsDb ? 'the service builds its own SQL' : 'the tests pass an in-memory repository', d.needsDb ? 'bad' : 'good');
      q('[data-verdict]').textContent = d.verdict;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
