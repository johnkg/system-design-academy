---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A page asks for 11 resources it needs, and an injection flaw has added 4 attacker scripts. Pick a policy and see, resource by resource, what the browser would allow. This is a model of the main CSP rules, not a browser: real CSP has more directives and edge cases.">
  <ol class="how">
    <li>Start with <b>Policy</b> set to <b>No policy</b>: all <b>11</b> needed resources load, and <b>4</b> injected scripts run. Switch to <b>Allow-list + unsafe-inline</b>: the script from evil.example is blocked, but <b>3</b> of 4 still run, because inline code is allowed and one injected script comes through an allowed CDN.</li>
    <li>Switch to <b>Allow-list only</b>: only <b>1</b> injected script runs, but just <b>7</b> of 11 needed resources load: the page's own inline code and a runtime-loaded library are blocked too.</li>
    <li>Switch to <b>Nonce + strict-dynamic</b>: <b>10</b> of 11 load and <b>0</b> injected scripts run. Now tick <b>Same nonce on every response</b>: the attacker copies it and <b>3</b> of 4 run again.</li>
    <li>Untick it, set <b>Policy</b> to <b>Allow-list only</b> and tick <b>Report-only</b>: all <b>11</b> needed resources load again, while <b>7</b> violations are reported. With <b>Deny everything</b> the same mode reports <b>15</b> violations and breaks nothing.</li>
  </ol>
  <div class="pg csp" data-csp>
    <div class="pg-row">
      <label>Policy <select class="pg-in" data-policy>
        <option value="none" selected>No policy</option>
        <option value="allow-list + unsafe-inline">Allow-list + unsafe-inline</option>
        <option value="allow-list only">Allow-list only</option>
        <option value="hashes + allow-list">Hashes + allow-list</option>
        <option value="nonce + strict-dynamic">Nonce + strict-dynamic</option>
        <option value="default-src 'none'">Deny everything (default-src 'none')</option>
      </select></label>
      <label><input type="checkbox" data-ro /> Report-only</label>
      <label><input type="checkbox" data-leak /> Same nonce on every response</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Needed resources that load</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Injected scripts that run</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Violations reported</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Every resource on the page</h3>
      <ul class="csp-list" data-list></ul>
    </div>
    <div class="pg-row">
      <span>Other headers:</span>
      <label><input type="checkbox" data-h="hsts" /> HSTS</label>
      <label><input type="checkbox" data-h="frame-ancestors" /> frame-ancestors</label>
      <label><input type="checkbox" data-h="nosniff" /> nosniff</label>
      <label><input type="checkbox" data-h="samesite" /> SameSite=Lax cookie</label>
    </div>
    <div class="pg-box" data-b4><h3>Header attacks stopped</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  // The same model as the code samples: per-directive source lists, nonces, hashes, strict-dynamic, report-only.
  interface Res { id: string; kind: string; from: string; nonce?: string; hash?: string; injected?: boolean; trusted?: boolean }
  const SELF = 'self';
  const RESOURCES: Res[] = [
    { id: 'app.js', kind: 'script', from: SELF, nonce: 'good' },
    { id: 'lib.js (cdn.example)', kind: 'script', from: 'cdn.example', nonce: 'good' },
    { id: 'track.js (analytics.vendor)', kind: 'script', from: 'analytics.vendor', nonce: 'good' },
    { id: 'inline bootstrap script', kind: 'script', from: 'inline', nonce: 'good', hash: 'h1' },
    { id: 'inline onclick handler', kind: 'handler', from: 'inline' },
    { id: 'site.css', kind: 'style', from: SELF },
    { id: 'inline style block', kind: 'style', from: 'inline', nonce: 'good', hash: 'h2' },
    { id: 'hero.png (img.cdn)', kind: 'img', from: 'img.cdn' },
    { id: 'payment iframe (pay.example)', kind: 'frame', from: 'pay.example' },
    { id: 'fetch to api.shop.example', kind: 'connect', from: 'api.shop.example' },
    { id: 'chart.js loaded by app.js', kind: 'script', from: 'unpkg.example', trusted: true },
    { id: 'injected inline script', kind: 'script', from: 'inline', injected: true },
    { id: 'injected img onerror handler', kind: 'handler', from: 'inline', injected: true },
    { id: 'injected script from evil.example', kind: 'script', from: 'evil.example', injected: true },
    { id: 'injected script via cdn.example', kind: 'script', from: 'cdn.example', injected: true },
  ];
  const BASE: Record<string, string[]> = { 'img-src': ['self', 'img.cdn'], 'frame-src': ['pay.example'], 'connect-src': ['self', 'api.shop.example'] };
  const POLICIES: Record<string, Record<string, string[]> | null> = {
    none: null,
    'allow-list + unsafe-inline': { ...BASE, 'script-src': ['self', 'cdn.example', 'analytics.vendor', 'unsafe-inline'], 'style-src': ['self', 'unsafe-inline'] },
    'allow-list only': { ...BASE, 'script-src': ['self', 'cdn.example', 'analytics.vendor'], 'style-src': ['self'] },
    'hashes + allow-list': { ...BASE, 'script-src': ['self', 'cdn.example', 'analytics.vendor', 'hash:h1'], 'style-src': ['self', 'hash:h2'] },
    'nonce + strict-dynamic': { ...BASE, 'script-src': ['nonce:good', 'strict-dynamic'], 'style-src': ['self', 'nonce:good'] },
    "default-src 'none'": { 'default-src': [] },
  };
  const DIRECTIVE: Record<string, string> = { script: 'script-src', handler: 'script-src', style: 'style-src', img: 'img-src', frame: 'frame-src', connect: 'connect-src' };

  function allows(policy: Record<string, string[]> | null, r: Res, nonceLeaked: boolean): boolean {
    if (!policy) return true;
    const src = policy[DIRECTIVE[r.kind]] ?? policy['default-src'];
    if (!src) return true;
    const nonce = r.injected ? (nonceLeaked ? 'good' : undefined) : r.nonce;
    const hasNonceOrHash = src.some((s) => s.startsWith('nonce:') || s.startsWith('hash:'));
    if (r.from === 'inline') {
      if (r.kind === 'handler') return src.includes('unsafe-inline') && !hasNonceOrHash;
      if (nonce && src.includes('nonce:' + nonce)) return true;
      if (r.hash && !r.injected && src.includes('hash:' + r.hash)) return true;
      return src.includes('unsafe-inline') && !hasNonceOrHash;
    }
    if (src.includes('strict-dynamic') && r.kind === 'script') return Boolean(r.trusted || (nonce && src.includes('nonce:' + nonce)));
    if (nonce && src.includes('nonce:' + nonce)) return true;
    return src.includes(r.from === SELF ? 'self' : r.from);
  }

  const ATTACKS: [string, string][] = [
    ['hsts', 'a return visit over http, with the redirect to https stripped, is stopped by HSTS once the site has been seen (a very first visit is covered only if the domain is preloaded)'],
    ['frame-ancestors', 'framing the page to trick clicks is stopped by frame-ancestors'],
    ['nosniff', 'an uploaded text file run as a script is stopped by nosniff'],
    ['samesite', 'a cross-site form post with the session cookie is stopped by SameSite=Lax'],
  ];

  document.querySelectorAll<HTMLElement>('[data-csp]').forEach((root) => {
    const q = query(root);
    const list = q('[data-list]');
    const items = RESOURCES.map((r) => { const li = document.createElement('li'); li.className = 'csp-item'; list.appendChild(li); return li; });
    const color = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    function draw() {
      const policy = POLICIES[q<HTMLSelectElement>('[data-policy]').value];
      const ro = q<HTMLInputElement>('[data-ro]').checked;
      const leaked = q<HTMLInputElement>('[data-leak]').checked;
      let legit = 0, ran = 0, violations = 0;
      RESOURCES.forEach((r, i) => {
        const ok = allows(policy, r, leaked);
        if (!ok) violations++;
        const loads = ok || ro;
        if (r.injected) { if (loads && r.kind !== 'img') ran++; } else if (loads) legit++;
        const tag = loads ? (ok ? 'runs' : 'runs, reported') : 'blocked';
        items[i].textContent = `${r.injected ? 'ATTACKER ' : ''}${r.id}: ${tag}`;
        items[i].style.setProperty('--c', r.injected ? (loads ? 'var(--bad)' : 'var(--good)') : (loads ? 'var(--good)' : 'var(--bad)'));
      });
      q('[data-o1]').textContent = `${legit} of 11`;
      q('[data-n1]').textContent = legit === 11 ? 'nothing the page needs is blocked' : 'the rest are blocked: this is what a strict policy breaks';
      color(1, legit >= 10);
      q('[data-o2]').textContent = `${ran} of 4`;
      q('[data-n2]').textContent = ran === 0 ? 'the injected markup does nothing' : 'injected code runs in the page, with the user\'s session';
      color(2, ran === 0);
      q('[data-o3]').textContent = `${violations}`;
      q('[data-n3]').textContent = ro ? 'report-only: these were logged, nothing was blocked' : 'sent to the report endpoint, if one is configured';
      color(3, true);
      const set = Array.from(root.querySelectorAll<HTMLInputElement>('[data-h]')).filter((c) => c.checked).map((c) => c.dataset.h);
      const stopped = ATTACKS.filter(([k]) => set.includes(k));
      q('[data-o4]').textContent = `${stopped.length} of 4`;
      q('[data-n4]').textContent = stopped.length ? stopped.map(([, t]) => t).join('; ') : 'none ticked: all four attacks work';
      color(4, stopped.length === 4);
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .csp-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .playground .csp-item { font: .8rem var(--font-mono); padding: 3px 8px; border-left: 4px solid var(--c, var(--border)); background: color-mix(in srgb, var(--c, var(--border)) 8%, var(--surface)); overflow-wrap: anywhere; }
</style>
