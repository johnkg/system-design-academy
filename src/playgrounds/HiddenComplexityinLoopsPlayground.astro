---
import PlaygroundShell from '../components/PlaygroundShell.astro';
const SIZES = [10, 100, 1000, 10000, 50000, 100000, 1000000, 10000000];
---
<PlaygroundShell title="Simulate it" hint="Four loops that read as one pass, each in its naive and its fixed form. The step counts come from the same model as the code samples. Time is an assumption of one nanosecond per step, nothing is timed on your machine.">
  <ol class="how">
    <li>Start with <b>Task</b> "Find duplicates", <b>Version</b> "Naive (list)" and <b>Number of items n</b> at <b>50,000</b>: the loop looks like one pass but takes <b>1,250,025,000</b> steps, and the fixed version takes <b>100,000</b>. That is <b>12,500</b> times fewer. The naive version crosses a billion steps at n = <b>44,721</b>.</li>
    <li>Set <b>Task</b> to "Build a string" and <b>Number of items n</b> to <b>1,000,000</b>: copying the growing string every time is <b>2,000,002,000,000</b> character copies, <b>33.3</b> minutes, against <b>5,000,000</b> for collecting the pieces and joining once.</li>
    <li>Set <b>Task</b> to "Drain from the front" and <b>Number of items n</b> to <b>10,000,000</b>: removing from the front of an array 10,000,000 times is <b>50,000,005,000,000</b> element moves, about <b>13.9</b> hours. A queue does it in 10,000,000 steps, 10 ms.</li>
    <li>Set <b>Number of items n</b> back to <b>100</b>: the naive version is only <b>5,050</b> steps, so the quadratic loop is harmless there. The problem is not that the code is wrong, it is that it stays invisible until n grows.</li>
  </ol>
  <div class="pg hc" data-hc>
    <div class="pg-row">
      <label>Task <select class="pg-in" data-task><option value="dup" selected>Find duplicates</option><option value="str">Build a string</option><option value="drain">Drain from the front</option><option value="look">Lookup per row</option></select></label>
      <label>Version <select class="pg-in" data-ver><option value="naive" selected>Naive (list)</option><option value="fixed">Fixed</option></select></label>
      <label>Number of items n <select class="pg-in" data-n>{SIZES.map((n) => <option value={n} selected={n === 50000}>{n.toLocaleString('en-US')}</option>)}</select></label>
    </div>
    <p class="pg-note" data-what></p>
    <div class="pg-grid">
      <div class="pg-box" data-boxc><h3>Chosen version</h3><span class="pg-mono" data-oc></span><span class="pg-note" data-nc></span></div>
      <div class="pg-box" data-boxn><h3>Naive steps</h3><span class="pg-mono" data-on></span><span class="pg-note" data-nn></span></div>
      <div class="pg-box" data-boxf><h3>Fixed steps</h3><span class="pg-mono" data-of></span><span class="pg-note" data-nf></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Ratio</h3><span class="pg-mono" data-or></span><span class="pg-note">naive steps divided by fixed steps</span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Steps on a log scale</h3>
      <div class="hc-bars" data-bars></div>
      <span class="pg-note">Each bar is the number of digits of the step count (full bar: 15 digits).</span>
    </div>
    <p class="pg-out" data-verdict role="status"></p>
    <p class="pg-note">Assumptions: one step is one comparison, one element moved, one hash operation or one character copied, at 1 ns each; real costs differ (a hash lookup is dearer than a comparison, memmove is quicker than a loop). Pieces are 4 characters. Lookup per row means a scan of another list for each row, rows in table order. Runtimes may optimise some naive cases, such as string concatenation, so the naive string builder is the worst case "in many languages, typically".</p>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands, formatOneDecimalBelow100 } from '../playground';
  const PIECE = 4;
  const BILLION = 1_000_000_000;
  const NS = 1e9;
  const MAX_N = 4e9; // search ceiling for "the n where a version reaches a billion steps"
  interface Task { name: string; what: string; naive: (n: number) => number; fixed: (n: number) => number }
  // The same closed forms the code samples check against their explicit loops.
  const TASKS: Record<string, Task> = {
    dup: { name: 'Find duplicates', what: 'For each of n ids: `if id in seen` on a list scans the ids seen so far (naive), or a set answers in one hash lookup plus one insert (fixed).', naive: (n) => (n * (n - 1)) / 2 + n, fixed: (n) => 2 * n },
    str: { name: 'Build a string', what: 'Join n pieces of 4 characters: `s = s + piece` copies the growing string each time (naive, in many languages typically), or collect the pieces and join once (fixed).', naive: (n) => (PIECE * n * (n + 1)) / 2, fixed: (n) => n * (PIECE + 1) },
    drain: { name: 'Drain from the front', what: 'Take n items from the front of an array: each removal shifts everything after it (naive), or a queue takes the front in one step (fixed).', naive: (n) => (n * (n + 1)) / 2, fixed: (n) => n },
    look: { name: 'Lookup per row', what: 'Match n rows to a table of n entries: scan the table for each row (naive), or build a dictionary once and look each row up (fixed).', naive: (n) => (n * (n + 1)) / 2, fixed: (n) => 2 * n },
  };
  function secondsText(steps: number): string {
    const s = steps / NS;
    if (s < 1e-6) return `${formatOneDecimalBelow100(s * 1e9)} ns`;
    if (s < 1e-3) return `${formatOneDecimalBelow100(s * 1e6)} µs`;
    if (s < 1) return `${formatOneDecimalBelow100(s * 1e3)} ms`;
    if (s < 60) return `${formatOneDecimalBelow100(s)} s`;
    if (s < 3600) return `${formatOneDecimalBelow100(s / 60)} minutes`;
    if (s < 86400) return `${formatOneDecimalBelow100(s / 3600)} hours`;
    return `${formatOneDecimalBelow100(s / 86400)} days`;
  }
  // Smallest n at which f reaches a billion steps (f grows with n).
  function reachBillion(f: (n: number) => number): number | null {
    if (f(MAX_N) < BILLION) return null;
    let lo = 1, hi = MAX_N;
    while (lo < hi) { const mid = Math.floor((lo + hi) / 2); if (f(mid) >= BILLION) hi = mid; else lo = mid + 1; }
    return lo;
  }
  const digits = (x: number) => String(Math.floor(x)).length;

  document.querySelectorAll<HTMLElement>('[data-hc]').forEach((root) => {
    const q = query(root);
    const val = (s: string) => q<HTMLSelectElement>(s).value;
    const bars = q('[data-bars]');
    function draw() {
      const t = TASKS[val('[data-task]')];
      const n = Number(val('[data-n]'));
      const chosen = val('[data-ver]') as 'naive' | 'fixed';
      const naive = t.naive(n), fixed = t.fixed(n);
      const mine = chosen === 'naive' ? naive : fixed;
      q('[data-what]').textContent = t.what;
      q('[data-oc]').textContent = formatThousands(mine);
      q('[data-nc]').textContent = `${chosen === 'naive' ? 'naive' : 'fixed'}: about ${secondsText(mine)} at 1 ns per step`;
      q('[data-on]').textContent = formatThousands(naive);
      q('[data-nn]').textContent = `about ${secondsText(naive)}`;
      q('[data-of]').textContent = formatThousands(fixed);
      q('[data-nf]').textContent = `about ${secondsText(fixed)}`;
      q('[data-or]').textContent = `${formatOneDecimalBelow100(naive / fixed)}x`;
      const good = 'var(--good)', bad = 'var(--bad)';
      q<HTMLElement>('[data-boxc]').style.setProperty('--c', mine <= BILLION ? good : bad);
      q<HTMLElement>('[data-boxn]').style.setProperty('--c', naive <= BILLION ? good : bad);
      q<HTMLElement>('[data-boxf]').style.setProperty('--c', fixed <= BILLION ? good : bad);
      bars.textContent = '';
      for (const [label, v, color] of [['Naive', naive, bad], ['Fixed', fixed, good]] as [string, number, string][]) {
        const row = document.createElement('div'); row.className = 'hc-row';
        const name = document.createElement('span'); name.textContent = label;
        const bar = document.createElement('span'); bar.className = 'hc-bar'; bar.style.width = `${Math.min(100, (digits(v) / 15) * 100)}%`; bar.style.background = color;
        row.append(name, bar); bars.appendChild(row);
      }
      const nb = reachBillion(t.naive), fb = reachBillion(t.fixed);
      const nbText = nb === null ? 'never within 4 billion items' : formatThousands(nb);
      const fbText = fb === null ? 'never within 4 billion items' : formatThousands(fb);
      q('[data-verdict]').textContent = `${t.name}, n = ${formatThousands(n)}: the naive version is ${formatThousands(naive)} steps (${secondsText(naive)}), the fixed one ${formatThousands(fixed)} (${secondsText(fixed)}). The naive version passes 1 billion steps at n = ${nbText}; the fixed one only at n = ${fbText}.`;
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .hc-bars { display: grid; gap: 6px; }
  .playground .hc-row { display: grid; grid-template-columns: 4.5rem 1fr; gap: 8px; align-items: center; font-size: .85rem; }
  .playground .hc-bar { display: block; height: 14px; border-radius: 3px; }
</style>
