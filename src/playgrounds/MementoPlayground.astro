---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it yourself" hint="Fight, level up, save checkpoints, and go back.">
  <ol class="how">
    <li>Press <b>Save checkpoint</b> at a good moment.</li>
    <li><b>Fight</b> (lose health) and <b>Level up</b> a few times.</li>
    <li><b>Load last</b> to rewind, or click any saved checkpoint to restore that one.</li>
  </ol>
  <div class="pg" data-memento>
    <div class="pg-box" style="--c: var(--role-1)" data-stats aria-live="polite"></div>
    <div class="pg-row">
      <button class="btn" type="button" data-fight>Fight (−30 HP)</button>
      <button class="btn" type="button" data-level>Level up</button>
      <button class="btn pg-primary" type="button" data-save>Save checkpoint</button>
      <button class="btn pg-primary" type="button" data-load>Load last</button>
    </div>
    <div class="pg-row" data-saves></div>
    <p class="pg-note" data-note>The manager only holds opaque snapshots; it never reads the numbers inside them.</p>
  </div>
</PlaygroundShell>
<script>
  class Snapshot { #s: { hp: number; level: number }; label: string; constructor(s: { hp: number; level: number }, label: string) { this.#s = Object.freeze({ ...s }); this.label = label; } static read(x: Snapshot) { return x.#s; } }
  class Player {
    #hp = 100; #level = 1;
    fight() { this.#hp = Math.max(0, this.#hp - 30); } levelUp() { this.#level++; }
    get view() { return { hp: this.#hp, level: this.#level }; }
    save(n: number) { return new Snapshot({ hp: this.#hp, level: this.#level }, `Checkpoint ${n}`); }
    restore(s: Snapshot) { const { hp, level } = Snapshot.read(s); this.#hp = hp; this.#level = level; }
  }
  document.querySelectorAll<HTMLElement>('[data-memento]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const p = new Player(); const stack: Snapshot[] = []; let n = 0;
    function draw() {
      const v = p.view; q('[data-stats]').innerHTML = `<h3>Player</h3><span class="pg-mono">HP ${v.hp}/100 ${'█'.repeat(Math.round(v.hp / 10))}${'░'.repeat(10 - Math.round(v.hp / 10))} · level ${v.level}</span>`;
      const s = q('[data-saves]'); s.innerHTML = '<span class="pg-note">Saved:</span>';
      stack.forEach((sn) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = sn.label; b.title = 'Restore this checkpoint'; b.addEventListener('click', () => { p.restore(sn); draw(); }); s.appendChild(b); });
      if (!stack.length) s.innerHTML += '<span class="pg-note">none yet</span>';
      q<HTMLButtonElement>('[data-load]').disabled = !stack.length;
    }
    q('[data-fight]').addEventListener('click', () => { p.fight(); draw(); });
    q('[data-level]').addEventListener('click', () => { p.levelUp(); draw(); });
    q('[data-save]').addEventListener('click', () => { stack.push(p.save(++n)); draw(); });
    q('[data-load]').addEventListener('click', () => { const sn = stack.pop(); if (sn) { p.restore(sn); draw(); } });
    draw();
  });
</script>
