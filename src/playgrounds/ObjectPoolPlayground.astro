---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A burst of requests each needs a database connection for 100 ms. Compare opening one per request with a pool, and see what a leak does.">
  <ol class="how">
    <li>Start with the defaults: <b>Pool size</b> at <b>3</b>, <b>Concurrent requests</b> at <b>8</b>, <b>Server allows</b> at <b>5</b>, <b>Time to create one</b> at <b>50</b>, <b>Leaked objects</b> at <b>0</b> and <b>Design</b> <b>No pool</b>. <b>8</b> objects are open, the server refuses <b>3</b> requests, and the rest finish after <b>150</b> ms.</li>
    <li>Set <b>Design</b> to <b>Pool</b>: only <b>3</b> objects are open, <b>0</b> requests are refused, and the burst takes <b>350</b> ms, because requests wait their turn.</li>
    <li>Set <b>Leaked objects</b> to <b>2</b>: the pool has only 1 usable object left and the burst takes <b>850</b> ms. At <b>3</b> leaked objects the burst never finishes.</li>
  </ol>
  <div class="pg opool" data-opool>
    <div class="pg-row">
      <label>Pool size <input class="pg-in" type="range" min="1" max="10" step="1" value="3" data-p /> <b data-pv></b></label>
      <label>Concurrent requests <input class="pg-in" type="range" min="1" max="40" step="1" value="8" data-r /> <b data-rv></b></label>
      <label>Server allows <input class="pg-in" type="range" min="1" max="20" step="1" value="5" data-l /> <b data-lv></b></label>
      <label>Time to create one <input class="pg-in" type="range" min="10" max="200" step="10" value="50" data-c /> <b data-cv></b> ms</label>
      <label>Leaked objects <input class="pg-in" type="range" min="0" max="5" step="1" value="0" data-k /> <b data-kv></b></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>No pool</option><option value="1">Pool</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Objects open at the peak</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Requests the server refuses</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Time until the burst is done</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // A burst model: each request holds an object for USE_MS. Without a pool every request opens one; with a pool they take turns.
  const USE_MS = 100;
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-opool]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    const num = (sel: string) => Number(q<HTMLInputElement>(sel).value);
    function draw() {
      const size = num('[data-p]'), requests = num('[data-r]'), limit = num('[data-l]'), cost = num('[data-c]'), leaked = num('[data-k]');
      const pool = q<HTMLSelectElement>('[data-design]').value === '1';
      for (const [k, v] of [['pv', size], ['rv', requests], ['lv', limit], ['cv', cost], ['kv', leaked]] as const) q(`[data-${k}]`).textContent = String(v);
      const open = pool ? Math.min(size, requests) : requests;
      const refused = Math.max(0, open - limit);
      const served = requests - refused;
      const usable = Math.max(0, Math.min(open - refused, size) - (pool ? leaked : 0));
      const stuck = pool && usable === 0;
      const time = !pool ? cost + USE_MS : stuck ? Infinity : cost + Math.ceil(requests / usable) * USE_MS;
      setBox(1, String(open), pool ? 'the pool never opens more than its size' : 'one object for every request', open > limit ? 'bad' : 'good');
      setBox(2, String(refused), refused > 0 ? `the server allows ${limit} at once, so ${served} requests are served` : 'every request gets an object', refused > 0 ? 'bad' : 'good');
      setBox(3, stuck ? 'never' : `${time} ms`, stuck ? 'every object leaked, so every request waits forever' : pool ? `${Math.ceil(requests / Math.max(usable, 1))} turns of ${USE_MS} ms after the first objects are created` : `creating ${cost} ms plus one ${USE_MS} ms use`, stuck ? 'bad' : 'mid');
      q('[data-verdict]').textContent = pool
        ? 'The pool caps the objects and makes extra requests wait. That keeps the server healthy, and it costs waiting time. Leaked objects shrink the pool.'
        : 'Each request is quick because nothing waits, but a burst opens more objects than the server allows, and the extra requests fail.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
