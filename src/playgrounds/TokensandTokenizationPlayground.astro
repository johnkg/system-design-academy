---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A real byte-pair encoder runs in your browser on a short paragraph about a support team. Choose how many merges it may learn, and see what that does to the number of tokens and to the size of the vocabulary.">
  <ol class="how">
    <li>Start with the defaults: <b>Merges</b> at <b>0</b>. Every letter and every end-of-word marker is its own token: <b>286</b> tokens for <b>50</b> words, or <b>5.7</b> tokens a word, from a vocabulary of <b>20</b> pieces. The embedding table is <b>10240</b> numbers and the attention scores take <b>81796</b> entries.</li>
    <li>Set <b>Merges</b> to <b>10</b>: <b>193</b> tokens, <b>3.9</b> a word, a vocabulary of <b>30</b> and an embedding table of <b>15360</b> numbers.</li>
    <li>Set <b>Merges</b> to <b>60</b>: <b>66</b> tokens, <b>1.3</b> a word, a vocabulary of <b>80</b>, an embedding table of <b>40960</b> numbers, and only <b>4356</b> attention scores.</li>
    <li>Type <b>xylophone</b> in <b>Try a word</b>: its letters were never merged in this paragraph, so it breaks into many small pieces, where the common word ticket takes few.</li>
  </ol>
  <div class="pg tok" data-tok>
    <div class="pg-row">
      <label>Merges <input class="pg-in" type="range" min="0" max="60" step="5" value="0" data-m /> <b data-mv></b></label>
      <label>Try a word <input class="pg-in" type="text" value="ticket" data-word maxlength="20" autocomplete="off" /></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Tokens in the paragraph</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Vocabulary size</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Embedding table (width 512)</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Attention scores (tokens squared)</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Your word as tokens</h3>
      <span class="pg-mono" data-pieces></span>
      <span class="pg-note" data-piecenote></span>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // A real byte-pair encoder. Words never merge across a space, and "_" marks the end of a word, as in the code sample.
  const TEXT = 'the support team reads the new support ticket and the support team answers the ticket. when the ticket is not solved the support team sends the ticket to the engineering team, and the engineering team solves the ticket. the team closes the ticket when the customer answers the new message.';
  const WIDTH = 512; // embedding width used for the table size
  const counts = new Map<string, number>();
  for (const w of TEXT.replace(/[.,]/g, '').split(/\s+/)) counts.set(w, (counts.get(w) ?? 0) + 1);
  const WORDS = [...counts].map(([w, c]) => ({ symbols: [...w, '_'], count: c }));
  const CHARS = new Set(WORDS.flatMap((w) => w.symbols));
  const WORD_TOTAL = [...counts.values()].reduce((a, b) => a + b, 0);
  const SEP = '\u0001';

  const applyMerge = (symbols: string[], a: string, b: string) => {
    const out: string[] = [];
    for (let i = 0; i < symbols.length; i++) {
      if (i < symbols.length - 1 && symbols[i] === a && symbols[i + 1] === b) { out.push(a + b); i++; } else out.push(symbols[i]);
    }
    return out;
  };
  // Learn all possible merges once (up to 60); a slider value just uses a prefix of them.
  const MERGES: { a: string; b: string }[] = [];
  const history: { symbols: string[]; count: number }[][] = [];
  {
    let ws = WORDS.map((w) => ({ symbols: [...w.symbols], count: w.count }));
    history.push(ws);
    for (let n = 0; n < 60; n++) {
      const pairs = new Map<string, number>();
      for (const w of ws) for (let i = 0; i < w.symbols.length - 1; i++) { const k = w.symbols[i] + SEP + w.symbols[i + 1]; pairs.set(k, (pairs.get(k) ?? 0) + w.count); }
      let best = '', bestCount = 0;
      for (const [k, c] of pairs) if (c > bestCount) { best = k; bestCount = c; }
      if (!best) break;
      const [a, b] = best.split(SEP);
      MERGES.push({ a, b });
      ws = ws.map((w) => ({ symbols: applyMerge(w.symbols, a, b), count: w.count }));
      history.push(ws);
    }
  }
  const encode = (word: string, merges: number) => {
    let s = [...word, '_'];
    for (const { a, b } of MERGES.slice(0, merges)) s = applyMerge(s, a, b);
    return s;
  };

  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-tok]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const m = Math.min(Number(q<HTMLInputElement>('[data-m]').value), MERGES.length);
      q('[data-mv]').textContent = String(m);
      const tokens = history[m].reduce((s, w) => s + w.symbols.length * w.count, 0);
      const vocab = CHARS.size + m;
      setBox(1, String(tokens), `${(tokens / WORD_TOTAL).toFixed(1)} tokens a word, for ${WORD_TOTAL} words`, m === 0 ? 'bad' : 'mid');
      setBox(2, String(vocab), `${CHARS.size} letters and markers, plus ${m} merged pieces`, 'mid');
      setBox(3, String(vocab * WIDTH), `${vocab} rows of ${WIDTH} numbers: a bigger vocabulary means a bigger table`, 'mid');
      setBox(4, String(tokens * tokens), 'every token is compared with every other, so fewer tokens means far less work', m === 0 ? 'bad' : 'good');
      const word = q<HTMLInputElement>('[data-word]').value.toLowerCase().replace(/[^a-z]/g, '');
      const pieces = word ? encode(word, m) : [];
      q('[data-pieces]').textContent = pieces.length ? pieces.join('  |  ') : '(type a word)';
      q('[data-piecenote]').textContent = pieces.length ? `${pieces.length} tokens for ${word.length} letters` : '';
      q('[data-verdict]').textContent = 'More merges make the text shorter for the model and the vocabulary bigger. Real tokenizers stop at a vocabulary of tens of thousands of pieces, learned from far more text than this paragraph.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
