---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="LoRA adapts d x d matrices with two thin matrices of rank r. Choose the width, the rank, the number of layers and how many matrices in each layer are adapted. Training state is counted at 16 bytes per trainable weight, as in the ZeRO accounting for mixed-precision Adam. The frozen base model needs memory on top of this.">
  <ol class="how">
    <li>Start with the defaults: <b>Model width</b> <b>4096</b>, <b>Rank</b> <b>8</b>, <b>Layers</b> <b>32</b> and <b>Matrices adapted per layer</b> <b>2</b>. LoRA trains <b>4194304</b> weights, <b>0.391</b> percent of the adapted matrices. Its training state is <b>64</b> MiB, where fully tuning the same matrices would need <b>16</b> GiB.</li>
    <li>Set <b>Rank</b> to <b>64</b>: <b>33554432</b> trainable weights, <b>3.125</b> percent, and a training state of <b>512</b> MiB. A bigger rank can learn more and costs more.</li>
    <li>Set <b>Rank</b> back to <b>8</b> and <b>Model width</b> to <b>8192</b>: <b>8388608</b> trainable weights, only <b>0.195</b> percent, and a training state of <b>128</b> MiB. Full tuning of the same matrices would need <b>64</b> GiB.</li>
  </ol>
  <div class="pg ftl" data-ftl>
    <div class="pg-row">
      <label>Model width <select class="pg-in" data-d><option value="1024">1024</option><option value="2048">2048</option><option value="4096" selected>4096</option><option value="8192">8192</option></select></label>
      <label>Rank <input class="pg-in" type="range" min="1" max="128" step="1" value="8" data-r /> <b data-rv></b></label>
      <label>Layers <select class="pg-in" data-l><option value="16">16</option><option value="32" selected>32</option><option value="80">80</option></select></label>
      <label>Matrices adapted per layer <input class="pg-in" type="range" min="1" max="4" step="1" value="2" data-m /> <b data-mv></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Trainable weights with LoRA</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Share of the adapted matrices</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Training state with LoRA</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Training state, full tuning of the same matrices</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // LoRA weights per matrix = 2 x d x r. Full tuning of the same matrices = d x d each. Training state = 16 bytes per trainable weight.
  const BYTES_PER_WEIGHT = 16;
  type Tone = 'good' | 'bad' | 'mid';
  const trim = (n: number) => String(Number(n.toFixed(2)));
  const size = (b: number) => (b >= 2 ** 30 ? `${trim(b / 2 ** 30)} GiB` : `${trim(b / 2 ** 20)} MiB`);
  document.querySelectorAll<HTMLElement>('[data-ftl]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const d = Number(q<HTMLSelectElement>('[data-d]').value), r = Number(q<HTMLInputElement>('[data-r]').value);
      const layers = Number(q<HTMLSelectElement>('[data-l]').value), m = Number(q<HTMLInputElement>('[data-m]').value);
      q('[data-rv]').textContent = String(r); q('[data-mv]').textContent = String(m);
      const matrices = layers * m, lora = matrices * 2 * d * r, full = matrices * d * d;
      setBox(1, String(lora), `${matrices} matrices, each with 2 x ${d} x ${r} weights`, 'good');
      setBox(2, `${((100 * lora) / full).toFixed(3)} percent`, `2 x r / d = ${(2 * r)} / ${d}`, 'good');
      setBox(3, size(lora * BYTES_PER_WEIGHT), '16 bytes per trainable weight', 'good');
      setBox(4, size(full * BYTES_PER_WEIGHT), `if all ${full} weights of those matrices were trained`, 'bad');
      q('[data-verdict]').textContent = 'The frozen base model still has to be in memory, in 16-bit or 4-bit form, and activations need memory as well. The saving is in the training state, which is what makes a single GPU enough.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
