---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try it" hint="A feed of 5 posts per page, newest first. Load pages while the feed changes, with offset or cursor pagination.">
  <ol class="how">
    <li>With <b>Offset</b>, press <b>Next page</b> twice: pages are clean. Reset, then press <b>New post arrives</b> between page 1 and 2: the next page shows a <b>duplicate</b>.</li>
    <li>Reset and press <b>Delete newest post</b> between pages: with offset an item is <b>skipped</b> and never shown.</li>
    <li>Switch to <b>Cursor</b> and repeat both: no duplicates, no gaps, and the rows scanned per page stay at 5.</li>
  </ol>
  <div class="pg pgn" data-pgn>
    <div class="pg-row">
      <label>Method <select class="pg-in" data-mode><option value="offset" selected>Offset (page number)</option><option value="cursor">Cursor (after last id)</option></select></label>
    </div>
    <div class="pg-row">
      <button class="btn pg-primary" type="button" data-next>Next page</button>
      <button class="btn" type="button" data-add>New post arrives</button>
      <button class="btn" type="button" data-del>Delete newest post</button>
      <button class="btn" type="button" data-reset>Reset</button>
    </div>
    <ol class="pgn-pages" data-pages aria-label="Pages loaded so far"></ol>
    <p class="pg-mono" data-stats aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  const SIZE = 5; const START = 40;
  document.querySelectorAll<HTMLElement>('[data-pgn]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let posts: number[] = []; let nextId = 0; let page = 0; let cursor: number | null = null; let seen = new Set<number>();
    let dups = 0; let skipped = 0; let scanned = 0; let prevMin: number | null = null;
    const mode = () => q<HTMLSelectElement>('[data-mode]').value;
    function reset() {
      posts = Array.from({ length: START }, (_, i) => START - i); nextId = START + 1; page = 0; cursor = null; seen = new Set(); dups = skipped = scanned = 0; prevMin = null;
      q('[data-pages]').replaceChildren(); draw();
    }
    function next() {
      let ids: number[];
      if (mode() === 'offset') { ids = posts.slice(page * SIZE, page * SIZE + SIZE); scanned += page * SIZE + ids.length; }
      else { ids = posts.filter((p) => cursor === null || p < cursor).slice(0, SIZE); scanned += ids.length; }
      if (!ids.length) return;
      const li = document.createElement('li'); const marks: string[] = [];
      if (prevMin !== null) { const gap = posts.filter((p) => p < prevMin! && p > Math.max(...ids)).length; if (gap) { skipped += gap; marks.push(`${gap} skipped`); } }
      ids.forEach((id) => { if (seen.has(id)) { dups++; marks.push(`${id} is a duplicate`); } seen.add(id); });
      li.textContent = `Page ${page + 1}: posts ${ids.join(', ')}${marks.length ? ` (${marks.join('; ')})` : ''}`;
      if (marks.length) li.classList.add('flag');
      q('[data-pages]').appendChild(li);
      page++; cursor = ids[ids.length - 1]; prevMin = Math.min(...ids); draw();
    }
    function draw() {
      q('[data-stats]').textContent = `duplicates shown: ${dups} · items skipped: ${skipped} · rows the database scanned: ${scanned} · newest post: ${posts[0]}`;
    }
    q('[data-next]').addEventListener('click', next);
    q('[data-add]').addEventListener('click', () => { posts.unshift(nextId++); draw(); });
    q('[data-del]').addEventListener('click', () => { if (posts.length) posts.shift(); draw(); });
    q('[data-reset]').addEventListener('click', reset);
    q('[data-mode]').addEventListener('change', reset);
    reset();
  });
</script>
<style is:global>
  .playground .pgn-pages { margin: 0; padding-left: 1.2rem; display: grid; gap: 4px; font: .88rem var(--font-mono); }
  .playground .pgn-pages li.flag { color: var(--bad-text); font-weight: 600; }
</style>
