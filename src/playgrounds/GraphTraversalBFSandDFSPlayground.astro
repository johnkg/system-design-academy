---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Breadth-first and depth-first search run on five graph shapes from node 0, with every edge check and the size of the waiting list counted, never timed. The graphs come from fixed formulas, so the numbers never change. Python's default recursion limit is 1,000 frames; other languages and engines differ, so the limit here is a setting.">
  <ol class="how">
    <li>Set <b>Graph</b> to <b>Chain</b>, <b>Nodes</b> to <b>10,000</b> and <b>Recursion limit</b> to <b>1,000 frames</b>: both searches make <b>19,998</b> edge checks, the BFS queue never holds more than <b>1</b> node, but a recursive DFS needs a depth of <b>10,000</b> and would fail. Set <b>Graph</b> to <b>Binary tree</b>: the queue peaks at <b>5,000</b> and the DFS depth is only <b>14</b>. Set <b>Graph</b> to <b>Star</b>: the queue peaks at <b>9,999</b>.</li>
    <li>Set <b>Graph</b> to <b>Grid</b>: BFS reaches the far corner by a path of <b>198</b> edges, the fewest possible, after visiting <b>10,000</b> nodes. DFS gets there sooner, after <b>9,901</b> nodes, but by a path of <b>9,900</b> edges: DFS finds a path, not the shortest one.</li>
    <li>Set <b>Visited set</b> to <b>No</b>: the search gives up at <b>100,000</b> steps and was still going, because on an undirected graph it bounces between neighbours forever. In the box <b>Why the visited set matters</b>, set <b>Diamond levels</b> to <b>20</b>: <b>2,097,151</b> node entries without a visited set against <b>41</b> with one, even though no cycle exists.</li>
  </ol>
  <div class="pg gt" data-gt>
    <div class="pg-row">
      <label>Graph <select class="pg-in" data-shape><option value="chain" selected>Chain</option><option value="tree">Binary tree</option><option value="star">Star</option><option value="grid">Grid</option><option value="random">Ring with random chords</option></select></label>
      <label>Nodes <select class="pg-in" data-n><option value="100">100</option><option value="400">400</option><option value="2500">2,500</option><option value="10000" selected>10,000</option></select></label>
      <label>Recursion limit <select class="pg-in" data-limit><option value="1000" selected>1,000 frames</option><option value="10000">10,000 frames</option><option value="0">None: explicit stack</option></select></label>
      <label>Visited set <select class="pg-in" data-visited><option value="yes" selected>Yes</option><option value="no">No</option></select></label>
    </div>
    <p class="pg-note" data-shapenote></p>
    <div class="pg-grid">
      <div class="pg-box" style="--c: var(--border)"><h3>Breadth-first (queue)</h3><span class="pg-mono gt-big" data-b1></span><span class="pg-note" data-b1n></span></div>
      <div class="pg-box" data-db><h3>Depth-first (recursive)</h3><span class="pg-mono gt-big" data-d1></span><span class="pg-note" data-d1n></span></div>
      <div class="pg-box" style="--c: var(--border)"><h3>Depth-first, push all neighbours</h3><span class="pg-mono gt-big" data-p1></span><span class="pg-note">peak stack size: a node can be on the stack several times</span></div>
      <div class="pg-box" data-vb><h3>Run without a visited set?</h3><span class="pg-mono gt-big" data-v1></span><span class="pg-note" data-v1n></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>The way to the far node</h3>
      <div class="pg-grid">
        <div class="pg-box" style="--c: var(--good)"><h3>BFS</h3><span class="pg-mono gt-big" data-s1></span><span class="pg-note" data-s1n></span></div>
        <div class="pg-box" data-sb2><h3>DFS</h3><span class="pg-mono gt-big" data-s2></span><span class="pg-note" data-s2n></span></div>
      </div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Memory shape, log scale</h3>
      <div class="gt-bars" data-bars></div>
      <span class="pg-note" data-verdict></span>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Why the visited set matters</h3>
      <p class="pg-note">A directed chain of diamonds: both nodes of one level point to both nodes of the next. There is no cycle, yet a search without a visited set reaches the same node by every possible path.</p>
      <div class="pg-row"><label>Diamond levels <select class="pg-in" data-levels><option value="5">5</option><option value="10">10</option><option value="15">15</option><option value="20" selected>20</option></select></label></div>
      <div class="pg-grid">
        <div class="pg-box" style="--c: var(--bad)"><h3>Without a visited set</h3><span class="pg-mono gt-big" data-w1></span></div>
        <div class="pg-box" style="--c: var(--good)"><h3>With a visited set</h3><span class="pg-mono gt-big" data-w2></span></div>
      </div>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';

  // The same model as the code samples, ported to TypeScript.
  const CAP = 100000;
  function build(shape: string, n: number): number[][] {
    if (shape === 'grid') { let w = 0; while ((w + 1) * (w + 1) <= n) w++; n = w * w; }
    const adj: number[][] = Array.from({ length: n }, () => []);
    const edge = (a: number, b: number) => { if (a !== b && !adj[a].includes(b)) { adj[a].push(b); adj[b].push(a); } };
    if (shape === 'chain') for (let v = 0; v < n - 1; v++) edge(v, v + 1);
    else if (shape === 'tree') for (let v = 1; v < n; v++) edge(Math.floor((v - 1) / 2), v);
    else if (shape === 'star') for (let v = 1; v < n; v++) edge(0, v);
    else if (shape === 'grid') {
      const w = Math.round(Math.sqrt(n));
      for (let v = 0; v < n; v++) { if (v % w < w - 1) edge(v, v + 1); if (Math.floor(v / w) < w - 1) edge(v, v + w); }
    } else for (let v = 0; v < n; v++) { edge(v, (v + 1) % n); edge(v, (v * 7919 + 13) % n); }
    return adj;
  }
  function bfs(adj: number[][], start: number, target: number): [number, number, number, number] {
    const seen = new Array<boolean>(adj.length).fill(false), dist = new Array<number>(adj.length).fill(0);
    const queue = [start]; let head = 0, nodes = 0, edges = 0, widest = 0; seen[start] = true;
    while (head < queue.length) {
      const v = queue[head++]; nodes++;
      if (v === target) return [nodes, edges, widest, dist[v]];
      for (const w of adj[v]) { edges++; if (!seen[w]) { seen[w] = true; dist[w] = dist[v] + 1; queue.push(w); } }
      widest = Math.max(widest, queue.length - head);
    }
    return [nodes, edges, widest, -1];
  }
  function dfs(adj: number[][], start: number, target: number): [number, number, number, number] {
    const seen = new Array<boolean>(adj.length).fill(false);
    const stack: [number, number][] = [[start, 0]]; seen[start] = true;
    let nodes = 1, edges = 0, deepest = 1;
    if (start === target) return [nodes, edges, deepest, 0];
    while (stack.length > 0) {
      const top = stack[stack.length - 1], v = top[0];
      if (top[1] === adj[v].length) { stack.pop(); continue; }
      const w = adj[v][top[1]++]; edges++;
      if (!seen[w]) {
        seen[w] = true; nodes++; stack.push([w, 0]); deepest = Math.max(deepest, stack.length);
        if (w === target) return [nodes, edges, deepest, stack.length - 1];
      }
    }
    return [nodes, edges, deepest, -1];
  }
  function dfsPushAll(adj: number[][], start: number): number {
    const seen = new Array<boolean>(adj.length).fill(false), stack = [start]; let widest = 1;
    while (stack.length > 0) {
      const v = stack.pop()!; if (seen[v]) continue; seen[v] = true;
      for (const w of adj[v]) if (!seen[w]) stack.push(w);
      widest = Math.max(widest, stack.length);
    }
    return widest;
  }
  function walkWithoutVisited(adj: number[][], start: number): [number, boolean] {
    let steps = 0; const stack: [number, number][] = [[start, 0]];
    while (stack.length > 0) {
      steps++; if (steps >= CAP) return [steps, true];
      const top = stack[stack.length - 1], v = top[0];
      if (top[1] === adj[v].length) { stack.pop(); continue; }
      stack.push([adj[v][top[1]++], 0]);
    }
    return [steps, false];
  }
  function diamondWalk(levels: number, useVisited: boolean): number {
    let entries = 0; const seen = new Set<number>(); const stack: [number, number][] = [[0, 0]];
    while (stack.length > 0) {
      const [level, side] = stack.pop()!;
      if (useVisited) { const key = level * 2 + side; if (seen.has(key)) continue; seen.add(key); }
      entries++;
      if (level < levels) { stack.push([level + 1, 0]); stack.push([level + 1, 1]); }
    }
    return entries;
  }
  const NOTES: Record<string, string> = {
    chain: 'A line of nodes, each joined to the next: as narrow and as deep as a graph gets.',
    tree: 'A complete binary tree: half of the nodes are leaves on the last level, so it is wide but shallow.',
    star: 'One hub joined to every other node: the widest and shallowest shape.',
    grid: 'A square grid with four neighbours per node; the far corner is the opposite one.',
    random: 'A ring with one pseudo-random chord per node: a few hops reach far, and the far node is the one halfway round the ring.',
  };

  document.querySelectorAll<HTMLElement>('[data-gt]').forEach((root) => {
    const q = query(root);
    const colour = (id: string, c: string) => q<HTMLElement>(id).style.setProperty('--c', c);
    const sel = (s: string) => q<HTMLSelectElement>(s).value;
    function draw() {
      const shape = sel('[data-shape]'), limit = Number(sel('[data-limit]')), visited = sel('[data-visited]') === 'yes';
      const adj = build(shape, Number(sel('[data-n]'))), n = adj.length;
      q('[data-shapenote]').textContent = `${NOTES[shape]} Nodes: ${formatThousands(n)}.`;
      const [bn, be, queue] = bfs(adj, 0, -1), [dn, de, depth] = dfs(adj, 0, -1);
      q('[data-b1]').textContent = `queue peaks at ${formatThousands(queue)}`;
      q('[data-b1n]').textContent = `${formatThousands(bn)} nodes visited, ${formatThousands(be)} edge checks`;
      q('[data-d1]').textContent = `depth ${formatThousands(depth)}`;
      const tooDeep = limit > 0 && depth > limit;
      q('[data-d1n]').textContent = `${formatThousands(dn)} nodes visited, ${formatThousands(de)} edge checks. ${limit === 0 ? 'An explicit stack has no frame limit: it only needs memory.' : tooDeep ? `A recursive version would fail: ${formatThousands(depth)} frames is over the limit of ${formatThousands(limit)}.` : `Within the limit of ${formatThousands(limit)} frames.`}`;
      colour('[data-db]', tooDeep ? 'var(--bad)' : 'var(--good)');
      q('[data-p1]').textContent = formatThousands(dfsPushAll(adj, 0));
      if (visited) {
        q('[data-v1]').textContent = 'Not needed: visited set on';
        q('[data-v1n]').textContent = 'every node is entered once, so each edge is checked once per end';
        colour('[data-vb]', 'var(--border)');
      } else {
        const [steps, gaveUp] = walkWithoutVisited(adj, 0);
        q('[data-v1]').textContent = gaveUp ? `gave up at ${formatThousands(steps)} steps` : `finished in ${formatThousands(steps)} steps`;
        q('[data-v1n]').textContent = gaveUp ? 'still going: with no record of where it has been, the walk goes back and forth along an edge forever' : 'finished';
        colour('[data-vb]', gaveUp ? 'var(--bad)' : 'var(--border)');
      }
      const target = shape === 'random' ? Math.floor(n / 2) : n - 1;
      const [sn, , , hops] = bfs(adj, 0, target), [tn, , , length] = dfs(adj, 0, target);
      q('[data-s1]').textContent = `path of ${formatThousands(hops)} edges`;
      q('[data-s1n]').textContent = `found after visiting ${formatThousands(sn)} nodes: the fewest edges possible, since BFS finishes each distance before the next`;
      q('[data-s2]').textContent = `path of ${formatThousands(length)} edges`;
      q('[data-s2n]').textContent = `found after visiting ${formatThousands(tn)} nodes: ${length === hops ? 'the same length here, because this graph has only one path' : 'a path, not the shortest one'}`;
      colour('[data-sb2]', length > hops ? 'var(--bad)' : 'var(--good)');

      const bars = q('[data-bars]'); bars.textContent = '';
      const rows: [string, number][] = [['BFS queue peak', queue], ['DFS recursion depth', depth], ['Nodes (reference)', n]];
      const top = Math.log10(Math.max(...rows.map((r) => r[1]), 10));
      for (const [label, v] of rows) {
        const row = document.createElement('div'); row.className = 'gt-bar';
        const name = document.createElement('span'); name.textContent = label;
        const track = document.createElement('span'); track.className = 'gt-track';
        const fill = document.createElement('span'); fill.className = 'gt-fill'; fill.style.width = `${Math.max(2, (Math.log10(Math.max(1, v)) / top) * 100)}%`;
        track.appendChild(fill);
        const num = document.createElement('span'); num.className = 'pg-mono'; num.textContent = formatThousands(v);
        row.append(name, track, num); bars.appendChild(row);
      }
      q('[data-verdict]').textContent = `BFS memory follows how wide the graph is (its frontier), DFS memory follows how deep it goes. Both visit ${formatThousands(bn)} nodes and make about the same ${formatThousands(be)} edge checks: the work is the same, the memory is not.`;

      const levels = Number(sel('[data-levels]'));
      q('[data-w1]').textContent = `${formatThousands(diamondWalk(levels, false))} node entries`;
      q('[data-w2]').textContent = `${formatThousands(diamondWalk(levels, true))} node entries`;
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .gt-big { font-size: 1.15rem; font-weight: 600; }
  .playground .gt-bars { display: grid; gap: 6px; }
  .playground .gt-bar { display: grid; grid-template-columns: 9.5rem 1fr; gap: 2px 8px; align-items: center; }
  .playground .gt-bar .pg-mono { grid-column: 2; }
  .playground .gt-track { display: block; height: 12px; border-radius: 6px; background: var(--surface-2); overflow: hidden; }
  .playground .gt-fill { display: block; height: 100%; background: var(--accent); border-radius: 6px; }
  @media (max-width: 520px) { .playground .gt-bar { grid-template-columns: 1fr; } .playground .gt-bar .pg-mono { grid-column: 1; } }
</style>
