---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Count the function calls, cache entries and stack depth of one recursive problem solved three ways. Nothing is timed: a call is a call, and the time shown assumes 100 million calls a second (10 ns each) as a rough guide. Sizes are capped so the page stays quick.">
  <ol class="how">
    <li>Pick <b>Problem</b> <b>Fibonacci</b> and <b>Approach</b> <b>Naive recursion</b>, and set <b>Size n</b> to <b>30</b>: <b>2,692,537</b> calls to compute one number, on a stack only <b>30</b> deep. The naive version passes a billion calls at <b>n = 43</b>. Now set <b>Approach</b> to <b>Memoized (top-down cache)</b>: <b>59</b> calls and <b>31</b> cache entries for the same answer.</li>
    <li>Set <b>Problem</b> to <b>Coin change (fewest coins)</b>, <b>Coin set</b> to <b>1, 5, 10, 25</b>, <b>Approach</b> to <b>Naive recursion</b> and <b>Size n</b> to <b>60</b>: <b>156,434,794</b> calls. Switch to memoized: <b>204</b> calls. Now tick <b>Also key the cache on coins used so far</b>: the cache grows to <b>1,086</b> entries and <b>2,890</b> calls, because states that are the same problem no longer share a key.</li>
    <li>Set <b>Problem</b> to <b>Sum of a tree (no overlap)</b>, <b>Approach</b> to <b>Memoized (top-down cache)</b> and <b>Size n</b> to <b>15</b>: <b>65,535</b> calls and <b>65,535</b> cache entries. The naive version needs the same <b>65,535</b> calls, so the cache saves nothing here and only costs memory.</li>
    <li>Set <b>Problem</b> to <b>Coin change (fewest coins)</b>, <b>Coin set</b> to <b>1, 7, 10</b> and <b>Size n</b> to <b>14</b>: greedy picks <b>5</b> coins, the optimum is <b>2</b>. Last, set <b>Problem</b> to <b>Fibonacci</b>, <b>Approach</b> to <b>Memoized (top-down cache)</b> and <b>Size n</b> to <b>2000</b>: the stack is <b>2,000</b> frames deep, over the default <b>1,000</b> limit of Python.</li>
  </ol>
  <div class="pg rm" data-rm>
    <div class="pg-row">
      <label>Problem <select class="pg-in" data-problem><option value="fib" selected>Fibonacci</option><option value="grid">Grid paths (n x n)</option><option value="coin">Coin change (fewest coins)</option><option value="tree">Sum of a tree (no overlap)</option></select></label>
      <label>Approach <select class="pg-in" data-approach><option value="naive" selected>Naive recursion</option><option value="memo">Memoized (top-down cache)</option><option value="bottom">Bottom-up table</option></select></label>
      <label>Size n <input class="pg-in" type="number" data-n value="30" min="1" max="3000" step="1" style="width: 6.5em" /></label>
      <label data-coinwrap>Coin set <select class="pg-in" data-coins><option value="1,5,10,25" selected>1, 5, 10, 25</option><option value="1,3,4">1, 3, 4</option><option value="1,7,10">1, 7, 10</option><option value="1,5,12">1, 5, 12</option></select></label>
      <label data-keywrap><input type="checkbox" data-badkey /> Also key the cache on coins used so far</label>
    </div>
    <span class="pg-note" data-sizenote></span>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Function calls</h3><span class="pg-mono rm-big" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Cache or table entries</h3><span class="pg-mono rm-big" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Max stack depth</h3><span class="pg-mono rm-big" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Naive passes a billion calls at</h3><span class="pg-mono rm-big" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" data-greedybox style="--c: var(--border)"><h3>Greedy against optimal (coin change)</h3><span class="pg-mono rm-big" data-greedy></span><span class="pg-note" data-greedynote></span></div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Work for each approach, log scale</h3>
      <div class="rm-bars" data-bars></div>
      <span class="pg-note" data-verdict></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  const CAP = 1e15; // naive counts above this are shown as "more than ..." (they still fit in 53-bit integers)
  const BILLION = 1e9, NS_PER_CALL = 10, PYTHON_LIMIT = 1000;
  type Problem = { start: (n: number) => number; children: (k: number, n: number) => number[]; cells: (n: number) => number };

  // The same model as the code samples: each problem says which sub-states a state calls.
  const fib = (): Problem => ({ start: (n) => n, children: (k) => (k < 2 ? [] : [k - 1, k - 2]), cells: (n) => n + 1 });
  const grid = (): Problem => ({ start: (n) => n * 1000 + n, children: (k) => (Math.floor(k / 1000) === 0 || k % 1000 === 0 ? [] : [k - 1000, k - 1]), cells: (n) => (n + 1) * (n + 1) });
  const coins = (set: number[]): Problem => ({ start: (n) => n, children: (a) => (a === 0 ? [] : set.filter((c) => c <= a).map((c) => a - c)), cells: (n) => n + 1 });
  const coinsBadKey = (set: number[]): Problem => ({
    start: (n) => n * 1000,
    children: (k) => { const a = Math.floor(k / 1000), u = k % 1000; return a === 0 ? [] : set.filter((c) => c <= a).map((c) => (a - c) * 1000 + u + 1); },
    cells: (n) => n + 1,
  });
  const tree = (): Problem => ({ start: () => 1, children: (i, depth) => (Math.floor(Math.log2(i)) >= depth ? [] : [2 * i, 2 * i + 1]), cells: (d) => 2 ** (d + 1) - 1 });

  // Calls of the naive recursion, counted with a table instead of running 2^n calls. Saturates at CAP.
  function naive(p: Problem, n: number): number {
    const memo = new Map<number, number>();
    const calls = (k: number): number => {
      const hit = memo.get(k); if (hit !== undefined) return hit;
      let total = 1;
      for (const c of p.children(k, n)) total = Math.min(CAP, total + calls(c));
      memo.set(k, total);
      return total;
    };
    return calls(p.start(n));
  }
  function depth(p: Problem, n: number): number {
    const memo = new Map<number, number>();
    const d = (k: number): number => {
      const hit = memo.get(k); if (hit !== undefined) return hit;
      let best = 0;
      for (const c of p.children(k, n)) best = Math.max(best, d(c));
      memo.set(k, best + 1);
      return best + 1;
    };
    return d(p.start(n));
  }
  function memoized(p: Problem, n: number): { calls: number; entries: number } {
    const cache = new Set<number>(); let calls = 0;
    const f = (k: number) => { calls++; if (cache.has(k)) return; for (const c of p.children(k, n)) f(c); cache.add(k); };
    f(p.start(n));
    return { calls, entries: cache.size };
  }
  function billion(p: Problem, limit: number): number {
    for (let n = 1; n <= limit; n++) if (naive(p, n) > BILLION) return n;
    return -1;
  }
  function greedy(set: number[], amount: number): number {
    let left = amount, used = 0;
    for (const c of [...set].sort((a, b) => b - a)) { used += Math.floor(left / c); left %= c; }
    return used;
  }
  function best(set: number[], amount: number): number {
    const t = [0];
    for (let a = 1; a <= amount; a++) { t[a] = Infinity; for (const c of set) if (c <= a) t[a] = Math.min(t[a], t[a - c] + 1); }
    return t[amount];
  }

  const MAX: Record<string, number> = { fib: 3000, grid: 60, coin: 3000, tree: 16 };
  const LIMIT_FOR_BILLION: Record<string, number> = { fib: 100, grid: 60, coin: 600 };
  const NOUN: Record<string, string> = { fib: 'the n-th Fibonacci number', grid: 'paths across an n x n grid, moving up or left', coin: 'the amount to make change for', tree: 'the depth of a complete binary tree' };
  const show = (x: number) => (x >= CAP ? 'more than 1,000,000,000,000,000' : formatThousands(x));
  function duration(calls: number): string {
    const s = (calls * NS_PER_CALL) / 1e9;
    if (calls >= CAP) return 'years: far longer than anyone would wait';
    if (s < 1) return 'under a second';
    if (s < 120) return `about ${Math.round(s)} seconds`;
    if (s < 7200) return `about ${Math.round(s / 60)} minutes`;
    if (s < 172800) return `about ${Math.round(s / 3600)} hours`;
    if (s < 63072000) return `about ${Math.round(s / 86400)} days`;
    return `about ${formatThousands(Math.round(s / 31557600))} years`;
  }

  document.querySelectorAll<HTMLElement>('[data-rm]').forEach((root) => {
    const q = query(root);
    const colour = (n: number, c: string) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', c);
    function draw() {
      const kind = q<HTMLSelectElement>('[data-problem]').value;
      const approach = q<HTMLSelectElement>('[data-approach]').value;
      const set = q<HTMLSelectElement>('[data-coins]').value.split(',').map(Number);
      const nInput = q<HTMLInputElement>('[data-n]');
      const n = Math.max(1, Math.min(MAX[kind], Math.round(Number(nInput.value) || 1)));
      if (String(n) !== nInput.value && document.activeElement !== nInput) nInput.value = String(n);
      nInput.max = String(MAX[kind]);
      q('[data-coinwrap]').hidden = kind !== 'coin';
      q('[data-keywrap]').hidden = !(kind === 'coin' && approach === 'memo');
      const badKey = kind === 'coin' && approach === 'memo' && q<HTMLInputElement>('[data-badkey]').checked;
      q('[data-sizenote]').textContent = `Size n is ${NOUN[kind]}, from 1 to ${formatThousands(MAX[kind])} here.`;
      const p = kind === 'fib' ? fib() : kind === 'grid' ? grid() : kind === 'coin' ? (badKey ? coinsBadKey(set) : coins(set)) : tree();
      const plain = kind === 'coin' ? coins(set) : p;
      const naiveCalls = naive(plain, n);
      const frames = depth(plain, n);

      let calls = 0, entries = 0, stack = 1, callNote = '', entryNote = '';
      if (approach === 'naive') {
        calls = naiveCalls; stack = frames; entries = 0;
        callNote = 'every call recomputes its sub-problems from scratch';
        entryNote = 'nothing is stored';
      } else if (approach === 'memo') {
        const m = memoized(p, n); calls = m.calls; entries = m.entries; stack = frames;
        callNote = kind === 'tree' ? 'every node is visited once anyway: no call was saved' : badKey ? 'the key holds more than the sub-problem, so equal sub-problems miss the cache' : 'a call that finds its answer in the cache returns at once';
        entryNote = kind === 'tree' ? 'one entry per node: all overhead, nothing is ever reused' : 'one entry per distinct state that was computed';
      } else {
        calls = 0; entries = plain.cells(n); stack = 1;
        callNote = `no recursion: a loop fills ${formatThousands(entries)} table cells in order`;
        entryNote = 'the whole table is built, including cells the answer may not need';
      }
      q('[data-o1]').textContent = calls === 0 ? '0' : show(calls);
      q('[data-n1]').textContent = callNote;
      colour(1, approach === 'naive' && naiveCalls > BILLION ? 'var(--bad)' : 'var(--good)');
      q('[data-o2]').textContent = approach === 'naive' ? '0' : show(entries);
      q('[data-n2]').textContent = entryNote;
      colour(2, kind === 'tree' && approach !== 'naive' ? 'var(--bad)' : badKey ? 'var(--bad)' : 'var(--border)');
      q('[data-o3]').textContent = formatThousands(stack);
      q('[data-n3]').textContent = stack > PYTHON_LIMIT ? `over the default ${formatThousands(PYTHON_LIMIT)}-frame limit of Python: it raises RecursionError (JavaScript engines typically stop at some thousands of frames, and the limit varies)` : approach === 'bottom' ? 'a loop does not grow the call stack' : 'one frame per nested call, so this is O(depth) memory, even when the cache saves every other call';
      colour(3, stack > PYTHON_LIMIT ? 'var(--bad)' : 'var(--good)');
      let b = -1;
      if (kind === 'tree') { b = 1; while (2 ** (b + 1) - 1 <= BILLION) b++; } else b = billion(plain, LIMIT_FOR_BILLION[kind]);
      q('[data-o4]').textContent = b < 0 ? 'beyond the search range' : `n = ${b}`;
      q('[data-n4]').textContent = kind === 'tree' ? 'a tree has that many nodes, so any method must visit them: the size is the cost, not the recursion' : 'the first size where the naive recursion makes more than 1,000,000,000 calls';
      colour(4, kind === 'tree' ? 'var(--border)' : 'var(--bad)');

      const gb = q('[data-greedybox]'); gb.hidden = kind !== 'coin';
      if (kind === 'coin') {
        const g = greedy(set, n), o = best(set, n);
        q('[data-greedy]').textContent = `greedy ${g}, optimal ${o}`;
        q('[data-greedynote]').textContent = g === o ? `for coins ${set.join(', ')} and amount ${n}, taking the biggest coin first happens to be optimal` : `for coins ${set.join(', ')} and amount ${n}, greedy uses ${g - o} more coins than the optimum: only a table over all sub-amounts finds it`;
        gb.style.setProperty('--c', g === o ? 'var(--good)' : 'var(--bad)');
      }

      const rows: [string, number][] = [['Naive', naiveCalls], ['Memoized', kind === 'tree' ? memoized(p, n).calls : memoized(p, n).calls], ['Bottom-up', plain.cells(n)]];
      const barsEl = q('[data-bars]'); barsEl.textContent = '';
      for (const [label, v] of rows) {
        const row = document.createElement('div'); row.className = 'rm-bar';
        const name = document.createElement('span'); name.textContent = label;
        const track = document.createElement('span'); track.className = 'rm-track';
        const fill = document.createElement('span'); fill.className = 'rm-fill'; fill.style.width = `${Math.max(2, (Math.log10(Math.max(1, v)) / 15) * 100)}%`;
        track.appendChild(fill);
        const num = document.createElement('span'); num.className = 'pg-mono'; num.textContent = `${show(v)} ${label === 'Bottom-up' ? 'loop steps' : 'calls'}`;
        row.append(name, track, num); barsEl.appendChild(row);
      }
      q('[data-verdict]').textContent = naiveCalls >= CAP
        ? `Naive at n = ${formatThousands(n)} would make more than a quadrillion calls: ${duration(naiveCalls)}.`
        : `Naive at n = ${formatThousands(n)} makes ${formatThousands(naiveCalls)} calls: ${duration(naiveCalls)} at 10 ns a call (an assumption). Bar length is the number of digits, so each tick right is ten times more work.`;
    }
    root.addEventListener('change', draw);
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .playground .rm-big { font-size: 1.15rem; font-weight: 600; }
  .playground .rm-bars { display: grid; gap: 6px; }
  .playground .rm-bar { display: grid; grid-template-columns: 5.5rem 1fr; gap: 2px 8px; align-items: center; }
  .playground .rm-bar .pg-mono { grid-column: 2; }
  .playground .rm-track { display: block; height: 12px; border-radius: 6px; background: var(--surface-2); overflow: hidden; }
  .playground .rm-fill { display: block; height: 100%; background: var(--accent); border-radius: 6px; }
</style>
