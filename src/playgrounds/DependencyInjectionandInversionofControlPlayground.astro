---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="An order service charges a card, sends an email and reads the clock. Pick how it gets those three parts, then run a test against it, forget one fake, or add a fourth dependency to a code base with 4 tests. A 'real effect' is a real charge, email or clock read that a test should never reach.">
  <ol class="how">
    <li>Start with <b>Design</b> at <b>Built inside (new, or a global)</b> and <b>Situation</b> at <b>Test a checkout with fakes</b>: the service builds its own parts, so the test supplies <b>0</b> fakes and reaches <b>3</b> real effects (1 charge, 1 email, 1 clock read). Set <b>Design</b> to <b>Constructor injection</b>: 3 fakes, 0 real effects, and 3 dependencies visible in the signature.</li>
    <li>Set <b>Situation</b> to <b>Test forgets the mailer fake</b>. With <b>Constructor injection</b> the service <b>fails before running: missing mailer</b>, with 0 real effects. Set <b>Design</b> to <b>Service locator</b>: the test <b>ran</b> and <b>1</b> real email was sent, with no warning.</li>
    <li>Set <b>Situation</b> to <b>Add a fourth dependency</b>: the locator edits <b>2</b> files but leaves <b>4</b> tests quietly using the real thing, while <b>Constructor injection</b> edits <b>6</b> files and fails <b>4</b> tests loudly until they are fixed.</li>
    <li>Set <b>Design</b> to <b>Container, everything injected</b>: nine parameters and <b>8</b> files for the fourth dependency. Set <b>Situation</b> back to <b>Test a checkout with fakes</b> and a plain test must supply <b>9</b> fakes. It is safe, but it costs the most to write and to read.</li>
  </ol>
  <div class="pg di" data-di>
    <div class="pg-row">
      <label>Design <select class="pg-in" data-design>
        <option value="0" selected>Built inside (new, or a global)</option>
        <option value="1">Constructor injection</option>
        <option value="2">Service locator</option>
        <option value="3">Container, everything injected</option>
      </select></label>
      <label>Situation <select class="pg-in" data-sit>
        <option value="1" selected>Test a checkout with fakes</option>
        <option value="2">Test forgets the mailer fake</option>
        <option value="3">Add a fourth dependency</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3 data-h1></h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3 data-h2></h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3 data-h3></h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>How the design gets its parts</h3>
      <span class="pg-note" data-design-note></span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';
  // The same model as the code samples.
  const world = { charges: 0, mails: 0, clock: 0 };
  const reset = () => { world.charges = 0; world.mails = 0; world.clock = 0; };
  type Deps = Record<string, any>;
  const real = (): Deps => ({ gateway: { charge() { world.charges++; } }, mailer: { send() { world.mails++; } }, clock: { now() { world.clock++; return 1; } } });
  const fake = (): Deps => ({ gateway: { charge() {} }, mailer: { send() {} }, clock: { now() { return 1; } } });
  const run = (d: Deps) => { d.gateway.charge(50); d.mailer.send('a@example.com'); d.clock.now(); };
  const need = (deps: Deps, names: string[]) => { for (const n of names) if (!deps[n]) throw new Error(`missing ${n}`); };

  const locator: { registry: Deps } = { registry: {} };
  const NINE = ['gateway', 'mailer', 'clock', 'logger', 'ids', 'formatter', 'rounding', 'retry', 'metrics'];
  const without = (skip: string | null): Deps => { const f = fake(); if (skip) delete f[skip]; return f; };
  const nineFakes = (skip: string | null): Deps => { const f = fake(); for (const n of NINE.slice(3)) f[n] = {}; if (skip) delete f[skip]; return f; };

  interface Design { name: string; params: number; note: string; make: (skip: string | null) => { fakes: number; build: () => () => void } }
  const DESIGNS: Design[] = [
    { name: 'Built inside (new, or a global)', params: 0, note: 'The service creates the real gateway, mailer and clock itself. Nothing in a test can replace them, and nothing in the signature mentions them.',
      make: () => ({ fakes: 0, build: () => () => { const r = real(); run(r); } }) },
    { name: 'Constructor injection', params: 3, note: 'The three needs are constructor parameters. The composition root chooses real or fake parts, and a missing one stops the build of the object.',
      make: (skip) => ({ fakes: skip ? 2 : 3, build: () => { const f = without(skip); need(f, ['gateway', 'mailer', 'clock']); return () => run(f); } }) },
    { name: 'Service locator', params: 0, note: 'The service asks a global registry for its parts at the moment it needs them. Tests can replace entries, but nothing says which ones they must replace.',
      make: (skip) => ({ fakes: skip ? 2 : 3, build: () => { locator.registry = real(); Object.assign(locator.registry, without(skip)); if (skip) locator.registry[skip] = real()[skip]; return () => run(locator.registry); } }) },
    { name: 'Container, everything injected', params: 9, note: 'A container builds nine collaborators from registrations, each behind an interface. Safe and replaceable, but every test and every new dependency pays for all of it.',
      make: (skip) => ({ fakes: skip ? 8 : 9, build: () => { const f = nineFakes(skip); need(f, NINE); return () => run(f); } }) },
  ];
  const TESTS = 4;
  const ADD = [
    { files: 1, loud: 0, quiet: TESTS }, { files: 1 + 1 + TESTS, loud: TESTS, quiet: 0 },
    { files: 1 + 1, loud: 0, quiet: TESTS }, { files: 4 + TESTS, loud: TESTS, quiet: 0 },
  ];

  document.querySelectorAll<HTMLElement>('[data-di]').forEach((root) => {
    const q = query(root);
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, head: string, out: string, note: string) => { q(`[data-h${n}]`).textContent = head; q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    const total = () => world.charges + world.mails + world.clock;
    function draw() {
      const i = Number(q<HTMLSelectElement>('[data-design]').value);
      const sit = Number(q<HTMLSelectElement>('[data-sit]').value);
      const d = DESIGNS[i];
      q('[data-design-note]').textContent = d.note;
      if (sit === 1) {
        reset();
        const t = d.make(null); t.build()();
        set(1, 'Real effects reached', String(total()), `charges ${world.charges}, emails ${world.mails}, clock reads ${world.clock}`);
        box(1, total() === 0);
        set(2, 'Fakes the test supplies', String(t.fakes), t.fakes === 0 ? 'none can be supplied: there is no way in' : t.fakes > 3 ? 'six of them replace trivial helpers' : 'a gateway, a mailer and a clock');
        box(2, t.fakes >= 3 && t.fakes <= 3);
        set(3, 'Dependencies visible in the signature', String(d.params), d.params === 0 ? 'a reader must read the body to learn what it needs' : 'a reader sees every need at a glance');
        box(3, d.params > 0 && d.params <= 4);
      } else if (sit === 2) {
        reset();
        let outcome = 'test ran';
        try { d.make('mailer').build()(); } catch (e) { outcome = `failed before running: ${(e as Error).message}`; }
        set(1, 'Outcome', outcome, outcome === 'test ran' ? 'nothing told the author that a fake was missing' : 'the mistake shows at once, before any real effect');
        box(1, outcome !== 'test ran');
        set(2, 'Real effects reached', String(total()), `emails ${world.mails}`);
        box(2, total() === 0);
        set(3, 'Real emails sent', String(world.mails), world.mails ? 'a real customer would get this email from a test' : 'none');
        box(3, world.mails === 0);
      } else {
        const a = ADD[i];
        set(1, 'Files edited', String(a.files), i === 3 ? 'interface, implementation, registration, the service and a fake in each test' : i === 1 ? 'the service, the composition root and each test' : i === 2 ? 'the service and one registration' : 'only the service');
        box(1, a.files <= 2);
        set(2, 'Tests that fail loudly', String(a.loud), a.loud ? 'they stop until each passes the new fake: noisy, but nothing hides' : 'none: nothing forces a test to notice the change');
        box(2, true);
        set(3, 'Tests quietly using the real thing', String(a.quiet), a.quiet ? 'they still pass while reaching the real tax calculator' : 'none');
        box(3, a.quiet === 0);
      }
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
