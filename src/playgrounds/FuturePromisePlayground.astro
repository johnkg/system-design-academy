---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="A page needs several independent lookups, and the last one can fail half way through. Compare awaiting them one after another with starting them all as futures.">
  <ol class="how">
    <li>Start with the defaults: <b>Lookups</b> at <b>3</b>, <b>Time for each lookup</b> at <b>200</b>, <b>One lookup fails</b> <b>No</b> and <b>Design</b> <b>Sequential</b>. The page takes <b>600</b> ms and shows <b>3</b> of 3 results.</li>
    <li>Set <b>Design</b> to <b>Futures: all or nothing</b>: <b>200</b> ms, because the lookups run together.</li>
    <li>Set <b>One lookup fails</b> to <b>Yes</b>: the last lookup fails half way through its time. With <b>Futures: all or nothing</b> the page fails after <b>100</b> ms and shows <b>0</b> of 3 results. With <b>Sequential</b> it fails after <b>500</b> ms, also with <b>0</b>.</li>
    <li>Set <b>Design</b> to <b>Futures: keep what worked</b>: <b>200</b> ms and <b>2</b> of 3 results are shown, because each future is settled on its own.</li>
  </ol>
  <div class="pg fut" data-fut>
    <div class="pg-row">
      <label>Lookups <input class="pg-in" type="range" min="2" max="8" step="1" value="3" data-n /> <b data-nv></b></label>
      <label>Time for each lookup <input class="pg-in" type="range" min="100" max="500" step="50" value="200" data-t /> <b data-tv></b> ms</label>
      <label>One lookup fails <select class="pg-in" data-fail><option value="0" selected>No</option><option value="1">Yes</option></select></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>Sequential</option><option value="1">Futures: all or nothing</option><option value="2">Futures: keep what worked</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Time until the page is decided</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Results shown</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // The last lookup fails half way through its time. Sequential awaits stop at the failure; futures run together.
  type Tone = 'good' | 'bad' | 'mid';
  document.querySelectorAll<HTMLElement>('[data-fut]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const n = Number(q<HTMLInputElement>('[data-n]').value), t = Number(q<HTMLInputElement>('[data-t]').value);
      const fails = q<HTMLSelectElement>('[data-fail]').value === '1', design = Number(q<HTMLSelectElement>('[data-design]').value);
      q('[data-nv]').textContent = String(n); q('[data-tv]').textContent = String(t);
      const failAt = t / 2; // the failing lookup is the last one and fails half way through
      let time: number, shown: number;
      if (design === 0) { time = fails ? (n - 1) * t + failAt : n * t; shown = fails ? 0 : n; }
      else if (design === 1) { time = fails ? failAt : t; shown = fails ? 0 : n; }
      else { time = t; shown = fails ? n - 1 : n; }
      setBox(1, `${time} ms`, design === 0 ? (fails ? `${n - 1} lookups in turn, then the failure` : `${n} lookups, one after another`) : fails && design === 1 ? 'the first failure ends the wait' : 'about as long as the slowest lookup', design === 0 && n > 1 ? 'bad' : 'good');
      setBox(2, `${shown} of ${n}`, shown === n ? 'every panel is shown' : shown === 0 ? 'the page shows an error, although some lookups worked' : 'the failed panel is replaced by a message', shown === n ? 'good' : shown === 0 ? 'bad' : 'mid');
      q('[data-verdict]').textContent = design === 0
        ? 'Each lookup waits for the one before it, so the times add up, and a failure throws away the results that did arrive.'
        : design === 1 ? 'Futures make the lookups run together. Waiting for all or nothing still loses the good results when one fails.'
        : 'Settling each future on its own keeps what worked, and the failed one can be handled by itself.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
