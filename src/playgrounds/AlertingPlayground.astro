---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Tune the alert" hint="One day of error-rate data with 5 brief blips and 2 real incidents (shaded). Pick a rule, tune it, and count the pages, the false alarms and the delay before each incident is noticed.">
  <ol class="how">
    <li>Start with <b>Single minute above threshold</b>: it catches both incidents at once, but also pages for the brief blips (4 false alarms: the 5 blips give 4 because the last one lands soon after the slow incident and is counted as part of it).</li>
    <li>Switch to <b>Sustained for N minutes</b>: false pages vanish. Now raise the threshold to 2% and the slow incident (1.5%) is <b>missed entirely</b>.</li>
    <li>Try <b>Burn rate over 1 hour</b>: no tuning of the threshold, no false pages, and the slow leak is still found, though later.</li>
  </ol>
  <div class="pg al" data-al>
    <div class="pg-row">
      <label>Rule <select class="pg-in" data-rule><option value="single" selected>Single minute above threshold</option><option value="sustained">Sustained for N minutes</option><option value="burn">Burn rate over 1 hour (14x of a 99.9% SLO)</option></select></label>
      <label data-tlabel>Threshold <input type="range" min="0.5" max="5" step="0.5" value="1" data-t /> <b data-tval></b></label>
      <label data-nlabel>Minutes <input type="range" min="1" max="15" value="5" data-n /> <b data-nval></b></label>
    </div>
    <div class="al-chart" role="img" aria-label="Error rate over one day" data-chart>
      <div class="al-bars" data-bars></div>
      <div class="al-marks" data-marks></div>
    </div>
    <p class="pg-note"><span class="al-key bar"></span> error rate (highest minute in each 5) &nbsp; <span class="al-key inc"></span> real incident &nbsp; <span class="al-key page"></span> a page was sent</p>
    <div class="pg-grid" aria-live="polite">
      <div class="pg-box" data-pagebox><h3>Pages sent</h3><span class="pg-mono" data-pages></span><span class="pg-note" data-false></span></div>
      <div class="pg-box" data-catchbox><h3>Real incidents caught</h3><span class="pg-mono" data-caught></span><span class="pg-note" data-delay></span></div>
    </div>
  </div>
</PlaygroundShell>
<script>
  const MIN = 1440; const BUCKET = 5; const BARS = MIN / BUCKET;
  const incidents = [{ name: 'Outage', start: 520, end: 560, rate: 0.06 }, { name: 'Slow leak', start: 1100, end: 1190, rate: 0.015 }];
  const blips = [200, 201, 410, 650, 651, 980, 1200, 1201];
  const BASE_ERR = 0.002, BASE_NOISE = 0.002, BLIP_ERR = 0.05, INC_NOISE = 0.004; // error rates per minute: normal level, its jitter, a one-minute blip, jitter during an incident
  const LEAD_MIN = 5, SLACK_MIN = 30; // a page up to 5 min before and 30 min after an incident counts as about it
  const BURN = { windowMin: 60, factor: 14, budget: 0.001 }; // 1-hour average above 14x the 0.1% error budget
  const DEDUPE_MIN = 10; // firing again within 10 min does not send another page
  const NEVER = -999;
  // mulberry32 PRNG
  function prng(seed: number) { let s = seed >>> 0; return () => { s = (s + 0x6d2b79f5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
  const rnd = prng(99);
  const series = Array.from({ length: MIN }, (_, m) => {
    let e = BASE_ERR + (rnd() - 0.5) * BASE_NOISE;
    if (blips.includes(m)) e = BLIP_ERR;
    for (const i of incidents) if (m >= i.start && m < i.end) e = i.rate + (rnd() - 0.5) * INC_NOISE;
    return e;
  });
  const inIncident = (m: number, slack: number) => incidents.some((i) => m >= i.start - LEAD_MIN && m < i.end + slack);
  document.querySelectorAll<HTMLElement>('[data-al]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const bars = Array.from({ length: BARS }, (_, b) => { const i = document.createElement('i'); const m0 = b * BUCKET; if (incidents.some((x) => m0 + BUCKET > x.start && m0 < x.end)) i.className = 'inc'; const inner = document.createElement('b'); i.appendChild(inner); q('[data-bars]').appendChild(i); return inner; });
    const marks = Array.from({ length: BARS }, () => { const i = document.createElement('i'); q('[data-marks]').appendChild(i); return i; });
    const SCALE = 0.07;
    function draw() {
      const rule = q<HTMLSelectElement>('[data-rule]').value; const T = Number(q<HTMLInputElement>('[data-t]').value) / 100; const N = Number(q<HTMLInputElement>('[data-n]').value);
      q('[data-tval]').textContent = `${(T * 100).toFixed(1)}%`; q('[data-nval]').textContent = String(N);
      q('[data-tlabel]').hidden = rule === 'burn'; q('[data-nlabel]').hidden = rule !== 'sustained';
      const firing = series.map((_, m) => {
        if (rule === 'single') return series[m] > T;
        if (rule === 'sustained') { if (m < N - 1) return false; for (let k = 0; k < N; k++) if (series[m - k] <= T) return false; return true; }
        if (m < BURN.windowMin - 1) return false; let sum = 0; for (let k = 0; k < BURN.windowMin; k++) sum += series[m - k]; return sum / BURN.windowMin > BURN.factor * BURN.budget;
      });
      const pages: number[] = []; let lastFire = NEVER;
      firing.forEach((f, m) => { if (f) { if (m - lastFire > DEDUPE_MIN) pages.push(m); lastFire = m; } });
      const falsePages = pages.filter((m) => !inIncident(m, SLACK_MIN)).length;
      const caught = incidents.map((i) => { const first = firing.findIndex((f, m) => f && m >= i.start - LEAD_MIN && m < i.end + SLACK_MIN); return first === -1 ? null : Math.max(0, first - i.start); });
      bars.forEach((b, i) => { let mx = 0; for (let m = i * BUCKET; m < (i + 1) * BUCKET; m++) mx = Math.max(mx, series[m]); b.style.height = `${Math.min(100, (mx / SCALE) * 100)}%`; });
      marks.forEach((m, i) => m.classList.toggle('page', pages.some((p) => Math.floor(p / BUCKET) === i)));
      q('[data-pages]').textContent = String(pages.length); q('[data-false]').textContent = `${falsePages} false alarm${falsePages === 1 ? '' : 's'}`;
      const got = caught.filter((c) => c !== null).length; q('[data-caught]').textContent = `${got} of ${incidents.length}`;
      q('[data-delay]').textContent = incidents.map((i, k) => `${i.name}: ${caught[k] === null ? 'MISSED' : `noticed after ${caught[k]} min`}`).join(' · ');
      q<HTMLElement>('[data-pagebox]').style.setProperty('--c', falsePages > 0 ? 'var(--bad)' : 'var(--role-2)'); q<HTMLElement>('[data-false]').style.color = falsePages > 0 ? 'var(--bad-text)' : '';
      q<HTMLElement>('[data-catchbox]').style.setProperty('--c', got < incidents.length ? 'var(--bad)' : 'var(--role-2)'); q<HTMLElement>('[data-delay]').style.color = got < incidents.length ? 'var(--bad-text)' : '';
      q('[data-chart]').setAttribute('aria-label', `Error rate over one day with ${incidents.length} real incidents. ${pages.length} pages sent, ${falsePages} false.`);
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .al-chart { display: grid; gap: 2px; }
  .playground .al-bars, .playground .al-marks { display: flex; gap: 0; height: 90px; align-items: stretch; }
  .playground .al-marks { height: 12px; }
  .playground .al-bars i { flex: 1 1 0; min-width: 0; display: flex; align-items: flex-end; background: var(--surface-2); }
  .playground .al-bars i.inc { background: color-mix(in srgb, var(--role-3) 28%, var(--surface)); }
  .playground .al-bars b { display: block; width: 100%; background: var(--accent); min-height: 0; }
  .playground .al-marks i { flex: 1 1 0; min-width: 0; }
  .playground .al-marks i.page { background: var(--bad); }
  .playground .al-key { display: inline-block; width: 12px; height: 12px; border-radius: 3px; vertical-align: -1px; }
  .playground .al-key.bar { background: var(--accent); } .playground .al-key.inc { background: color-mix(in srgb, var(--role-3) 40%, var(--surface)); } .playground .al-key.page { background: var(--bad); }
</style>
