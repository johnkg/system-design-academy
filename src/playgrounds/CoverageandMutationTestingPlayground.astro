---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Four test suites for one small discount function (12 lines), measured two ways: line coverage, and mutation testing, where the code is changed in 10 small ways and a suite must fail on each. A mutation run costs one pass for the original code and one pass per mutant, in test runs.">
  <ol class="how">
    <li>Start with <b>Test suite</b> on <b>Smoke: runs the code, asserts nothing</b> and <b>Mutation operators</b> on <b>All 10 mutants</b>: line coverage is <b>100%</b>, every line runs, yet <b>0%</b> of the mutants are killed. The suite cannot fail, so the coverage number says nothing about what is checked.</li>
    <li>Set <b>Test suite</b> to <b>Happy path: one assertion each</b>: coverage is still <b>100%</b>, but the mutation score jumps to <b>70%</b>. Set it to <b>Edges and combinations</b> for <b>80%</b>, and to <b>60 generated inputs against a reference</b> for <b>90%</b>, at a mutation run cost of <b>660</b> test runs.</li>
    <li>The survivor of the last suite is <b>cap &gt; turned into &gt;=</b>, an equivalent mutant: it changes the code but not what it returns, so no test could ever kill it. That is why a score of 100% is not always reachable.</li>
    <li>Set <b>Mutation operators</b> to <b>Conditions only</b> with the same suite: only 3 mutants are tried, the cost falls to <b>240</b> test runs, and the score reads <b>66%</b>. A cheaper run sees less of the code.</li>
  </ol>
  <div class="pg cm" data-cm>
    <div class="pg-row">
      <label>Test suite <select class="pg-in" data-suite>
        <option value="0" selected>Smoke: runs the code, asserts nothing</option>
        <option value="1">Happy path: one assertion each</option>
        <option value="2">Edges and combinations</option>
        <option value="3">60 generated inputs against a reference</option>
      </select></label>
      <label>Mutation operators <select class="pg-in" data-ops>
        <option value="all" selected>All 10 mutants</option>
        <option value="condition">Conditions only</option>
        <option value="constant">Constants only</option>
        <option value="arithmetic">Arithmetic only</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Line coverage</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Assertions</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Mutation score</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Mutation run cost</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box" style="--c: var(--border)">
      <h3>Each mutant: killed or survived</h3>
      <div class="cm-scroll" tabindex="0" role="region" aria-label="Each mutant and whether the chosen suite kills it"><table class="cm-table" data-table>
        <thead><tr><th scope="col">Change made to the code</th><th scope="col">Result</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <span class="pg-note">Killed: a test failed on the changed code. Survived: every test still passed, so the suite would not notice that change in the real code.</span>
    </div>
  </div>
</PlaygroundShell>
<script>
  import { query, formatThousands } from '../playground';
  type Test = [number, boolean, string, number | null];
  // The same model as the code samples.
  function discount(total: number, member: boolean, coupon: string, m: number, hit: (l: number) => void): number {
    hit(1); let rate = 0;
    hit(2); if (m === 1 ? total > 100 : total >= 100) { hit(3); rate = m === 2 ? 0 : 10; }
    hit(4); if (m === 3 ? !member : member) { hit(5); rate += m === 4 ? -5 : 5; }
    hit(6); if (coupon === 'SAVE5') { hit(7); rate += m === 5 ? 6 : 5; } else if (coupon === 'SAVE10') { hit(8); rate += m === 10 ? 9 : 10; }
    hit(9); if (m === 6 ? rate >= 20 : rate > 20) { hit(10); rate = m === 7 ? 25 : 20; }
    hit(11); const off = m === 8 ? Math.ceil(total * rate / 100) : Math.floor(total * rate / 100);
    hit(12); return m === 9 ? total + off : total - off;
  }
  const LINES = 12;
  const MUTANTS: [string, string][] = [
    ['>= turned into >', 'condition'], ['base rate 10 turned into 0', 'constant'], ['member test negated', 'condition'],
    ['member bonus + turned into -', 'arithmetic'], ['SAVE5 bonus 5 turned into 6', 'constant'], ['cap > turned into >=', 'condition'],
    ['cap value 20 turned into 25', 'constant'], ['floor turned into ceil', 'arithmetic'], ['minus turned into plus', 'arithmetic'],
    ['SAVE10 bonus 10 turned into 9', 'constant'],
  ];
  function seeded(seed: number) {
    let s = seed;
    return (n: number) => { s = (s * 48271) % 2147483647; return s % n; };
  }
  function reference(total: number, member: boolean, coupon: string): number {
    let pct = (total >= 100 ? 10 : 0) + (member ? 5 : 0) + (coupon === 'SAVE5' ? 5 : coupon === 'SAVE10' ? 10 : 0);
    if (pct > 20) pct = 20;
    return total - Math.floor(total * pct / 100);
  }
  const SMOKE: Test[] = [[150, true, 'SAVE10', null], [50, false, '', null], [100, false, 'SAVE5', null]];
  const HAPPY: Test[] = [[150, true, 'SAVE10', 120], [50, false, '', 50], [100, false, 'SAVE5', 85]];
  const EDGES: Test[] = [[100, false, '', 90], [99, false, '', 99], [101, false, '', 91], [200, true, 'SAVE10', 160], [100, true, 'SAVE5', 80], [50, true, '', 48], [120, false, 'SAVE10', 96]];
  const gen = seeded(5), COUPONS = ['', 'SAVE5', 'SAVE10'], GENERATED: Test[] = [];
  for (let i = 0; i < 60; i++) { const t = 95 + gen(11), mem = gen(2) === 1, c = COUPONS[gen(3)]; GENERATED.push([t, mem, c, reference(t, mem, c)]); }
  const SUITES = [SMOKE, HAPPY, EDGES, GENERATED];
  const passes = (tests: Test[], m: number) => tests.every(([t, mem, c, want]) => want === null || discount(t, mem, c, m, () => {}) === want);
  function coverage(tests: Test[]) { const seen = new Set<number>(); tests.forEach(([t, mem, c]) => discount(t, mem, c, 0, (l) => seen.add(l))); return seen.size; }

  document.querySelectorAll<HTMLElement>('[data-cm]').forEach((root) => {
    const q = query(root);
    const tbody = q('[data-table] tbody');
    const box = (n: number, good: boolean) => q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
    const set = (n: number, out: string, note: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; };
    function draw() {
      const tests = SUITES[Number(q<HTMLSelectElement>('[data-suite]').value)];
      const ops = q<HTMLSelectElement>('[data-ops]').value;
      const chosen = MUTANTS.map((m, i) => ({ name: m[0], family: m[1], number: i + 1 })).filter((m) => ops === 'all' || m.family === ops);
      const lines = coverage(tests), asserts = tests.filter((t) => t[3] !== null).length;
      const killed = chosen.map((m) => !passes(tests, m.number));
      const k = killed.filter(Boolean).length;
      const score = Math.floor(100 * k / chosen.length);
      set(1, `${Math.floor(100 * lines / LINES)}%`, `${lines} of ${LINES} lines run by the suite`);
      box(1, true);
      set(2, String(asserts), `in ${tests.length} tests`);
      box(2, asserts === tests.length);
      set(3, `${score}%`, `${k} of ${chosen.length} mutants killed`);
      box(3, score >= 80);
      set(4, formatThousands(tests.length * (chosen.length + 1)), `test runs for the whole mutation pass: ${tests.length} tests x ${chosen.length + 1} (the original plus ${chosen.length} mutants)`);
      box(4, tests.length * (chosen.length + 1) <= 700);
      tbody.textContent = '';
      chosen.forEach((m, i) => {
        const tr = document.createElement('tr');
        if (!killed[i]) tr.className = 'sel';
        const th = document.createElement('th'); th.setAttribute('scope', 'row'); th.textContent = m.name;
        const td = document.createElement('td'); td.textContent = killed[i] ? 'killed' : 'survived';
        tr.append(th, td); tbody.appendChild(tr);
      });
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .cm-scroll { overflow-x: auto; }
  .playground .cm-table { border-collapse: collapse; width: 100%; font-size: .85rem; }
  .playground .cm-table th, .playground .cm-table td { padding: 5px 8px; border-bottom: 1px solid var(--border); text-align: left; }
  .playground .cm-table tr.sel { background: var(--accent-soft); font-weight: 600; }
</style>
