---
import PlaygroundShell from '../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Simulate it" hint="Ten customers and a discount rule. Build the rule from its parts, say how many screens use it, and compare an if-chain in each screen with one specification.">
  <ol class="how">
    <li>Start with the defaults: <b>Active</b> <b>Required</b>, <b>Blocked</b> <b>Excluded</b>, <b>Minimum total</b> at <b>100</b>, <b>Screens using the rule</b> at <b>3</b> and <b>Design</b> <b>If-chain in each screen</b>. <b>4</b> of the 10 customers pass, and a change to the rule means editing <b>3</b> copies.</li>
    <li>Set <b>Design</b> to <b>One specification</b>: the same <b>4</b> pass, and a change is made in <b>1</b> place.</li>
    <li>Set <b>Minimum total</b> to <b>150</b>: <b>2</b> customers pass. Then set <b>Active</b> to <b>Ignored</b>: <b>3</b> pass, because the customer who is not active has a total of 150.</li>
    <li>Set <b>Screens using the rule</b> to <b>6</b> with <b>Design</b> on <b>If-chain in each screen</b>: <b>6</b> copies to edit, against <b>1</b> for the specification.</li>
  </ol>
  <div class="pg spec" data-spec>
    <div class="pg-row">
      <label>Active <select class="pg-in" data-active><option value="1" selected>Required</option><option value="0">Ignored</option></select></label>
      <label>Blocked <select class="pg-in" data-blocked><option value="1" selected>Excluded</option><option value="0">Ignored</option></select></label>
      <label>Minimum total <input class="pg-in" type="range" min="0" max="250" step="10" value="100" data-min /> <b data-minv></b></label>
      <label>Screens using the rule <input class="pg-in" type="range" min="1" max="6" step="1" value="3" data-screens /> <b data-screensv></b></label>
      <label>Design <select class="pg-in" data-design><option value="0" selected>If-chain in each screen</option><option value="1">One specification</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Customers who pass</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Copies to edit when the rule changes</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>The rule</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <span class="pg-note" data-verdict></span>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../playground';

  // The same rule model as the code samples, evaluated over ten sample customers.
  const CUSTOMERS = [
    { name: 'ada', active: true, blocked: false, total: 120 }, { name: 'bob', active: true, blocked: true, total: 200 },
    { name: 'cy', active: false, blocked: false, total: 150 }, { name: 'dee', active: true, blocked: false, total: 60 },
    { name: 'eli', active: true, blocked: false, total: 100 }, { name: 'fay', active: true, blocked: false, total: 180 },
    { name: 'gus', active: false, blocked: true, total: 90 }, { name: 'hal', active: true, blocked: true, total: 40 },
    { name: 'ivy', active: true, blocked: false, total: 99 }, { name: 'jo', active: true, blocked: false, total: 250 },
  ];
  type Tone = 'good' | 'bad' | 'mid';

  document.querySelectorAll<HTMLElement>('[data-spec]').forEach((root) => {
    const q = query(root);
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const needActive = q<HTMLSelectElement>('[data-active]').value === '1', noBlocked = q<HTMLSelectElement>('[data-blocked]').value === '1';
      const min = Number(q<HTMLInputElement>('[data-min]').value), screens = Number(q<HTMLInputElement>('[data-screens]').value);
      const spec = q<HTMLSelectElement>('[data-design]').value === '1';
      q('[data-minv]').textContent = String(min); q('[data-screensv]').textContent = String(screens);
      const passing = CUSTOMERS.filter((c) => (!needActive || c.active) && (!noBlocked || !c.blocked) && c.total >= min).map((c) => c.name);
      const parts = [needActive ? 'active' : '', noBlocked ? 'NOT blocked' : '', `total >= ${min}`].filter(Boolean);
      setBox(1, String(passing.length), `of ${CUSTOMERS.length}: ${passing.join(', ') || 'nobody'}`, 'mid');
      setBox(2, String(spec ? 1 : screens), spec ? 'the one specification' : 'one if-chain in each screen', spec ? 'good' : screens === 1 ? 'mid' : 'bad');
      setBox(3, parts.join(' AND '), spec ? 'built by combining small specifications, and it can describe itself' : 'written out as a long condition in every screen', 'mid');
      q('[data-verdict]').textContent = spec
        ? 'Every screen asks the same object, so they cannot disagree about who qualifies.'
        : screens === 1 ? 'With one screen a plain if is fine. The copies only start to hurt when the rule is shared.' : 'Each screen has its own copy of the condition, and the copies drift apart as the rule changes.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
