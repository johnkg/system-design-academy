---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Memory sets the connections per node, heartbeats set the background load, and a lost zone sets how much handshake capacity you need.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Concurrent connections (millions) <input type="range" min="1" max="50" value="10" data-c /> <b data-cval></b></label>
      <label>Connections per node (thousands) <input type="range" min="10" max="100" step="5" value="50" data-n /> <b data-nval></b></label>
      <label>Memory per connection (KB) <input type="range" min="8" max="64" step="4" value="20" data-kb /> <b data-kbval></b></label>
      <label>Heartbeat interval (seconds) <input type="range" min="10" max="120" step="5" value="30" data-hb /> <b data-hbval></b></label>
      <label>Registry refresh interval (seconds) <input type="range" min="30" max="300" step="10" value="60" data-rf /> <b data-rfval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: nodes normally run at 60% of their connection limit, so that after losing one of three zones the survivors run at 90%. One node can complete about 500 new TLS and WebSocket handshakes per second. A zone holds a third of the nodes. Registry refreshes are sent as one batch per node per interval. Every connection is pinged once per heartbeat interval.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    function draw() {
      const conns = val('[data-c]') * 1e6; const perNode = val('[data-n]') * 1e3; const kb = val('[data-kb]'); const hb = val('[data-hb]'); const rf = val('[data-rf]');
      ['c', 'n', 'kb', 'hb', 'rf'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const nodes = Math.ceil(conns / perNode / 0.6);
      const memNodeGb = (perNode * kb) / 1e6;
      const pings = conns / hb; const refreshes = conns / rf; const batches = nodes / rf;
      const lost = conns / 3; const survivors = nodes * (2 / 3); const capacity = survivors * 500; const secs = lost / capacity;
      const data: [string, string][] = [
        ['Gateway nodes to run (at 60% load)', fmt(nodes)],
        ['Memory per node when full', `${fmt1(memNodeGb)} GB`],
        ['Heartbeat pings per second (fleet)', fmt(pings)],
        ['Registry refreshes per second, one per connection', fmt(refreshes)],
        ['Registry calls per second, one batch per node', fmt1(batches)],
        ['Connections to re-establish after losing a zone', fmt(lost)],
        ['Handshakes per second the survivors can absorb', fmt(capacity)],
        ['Peak reconnect rate if clients retry within 2 s', fmt(lost / 2)],
        ['Seconds to reconnect everyone at full handshake speed', fmt1(secs)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
