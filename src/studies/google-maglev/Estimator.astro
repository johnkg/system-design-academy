---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How many packets a second a link carries, how many CPU cores that takes, how many Maglev machines a peak needs, how evenly Maglev hashing spreads the table, and how many slots must change when backends fail. A teaching model with round numbers, not Google's data.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Link speed (Gbps)" name="g" min="10" max="40" step="30" value="10" />
      <RangeField label="Packet size (bytes)" name="b" min="64" max="1500" step="4" value="100" />
      <RangeField label="Backends behind one VIP" name="n" min="10" max="2000" step="10" value="1000" />
      <RangeField label="Lookup table slots, M (thousands)" name="m" min="10" max="700" step="1" value="66" />
      <RangeField label="Backends failing at once" name="k" min="0" max="50" step="1" value="5" />
      <RangeField label="Nanoseconds to process a packet" name="t" min="100" max="1000" step="10" value="350" />
      <RangeField label="Peak traffic for the cluster (Gbps)" name="p" min="100" max="10000" step="100" value="1000" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Teaching model, not Google's system or data. From the Maglev paper: 10 Gbps is typical, which is 813 thousand packets a second for 1,500-byte packets and 9.06 million for 100-byte packets (this model adds 38 bytes of wire overhead per packet, which reproduces both figures); a packet takes about 350 ns in a packet thread; the default table has 65,537 slots; M should be larger than 100 times the number of backends to keep the imbalance under 1%; and Maglev hashing gives every backend the floor or the ceiling of M divided by N slots. The traffic peak and the failure count are my guesses that you can change. Assumptions: the packet threads share the load evenly, the router spreads packets evenly over the Maglev machines, one spare machine gives N+1 redundancy, and the changed slots when backends fail are at least the failed backends' own slots (the paper measured more).</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const f1 = formatOneDecimalBelow100;
    const pct = (n: number) => `${(Math.round(n * 1000) / 1000).toLocaleString('en-US')}%`;
    function draw() {
      ['g', 'b', 'n', 'm', 'k', 't', 'p'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const gbps = val('[data-g]'); const size = val('[data-b]'); const backends = val('[data-n]'); const slots = val('[data-m]') * 1000;
      const failing = val('[data-k]'); const ns = val('[data-t]'); const peak = val('[data-p]');
      const pps = (gbps * 1e9) / ((size + 38) * 8);
      const perBackend = slots / backends;
      const data: [string, string][] = [
        ['Packets per second at line rate (millions)', f1(pps / 1e6)],
        ['Time to handle each packet, per core, if 1 core did all of it (ns)', f1(1e9 / pps)],
        ['Packet threads (cores) needed at this processing time', f1(Math.ceil((pps * ns) / 1e9))],
        ['Slots per backend (rounded down or up)', `${f1(Math.floor(perBackend))} or ${f1(Math.ceil(perBackend))}`],
        ['Largest difference in slots between two backends', perBackend >= 1 ? '1' : 'some backends get no slot'],
        ['Table size compared with 100 times the backends', slots >= 100 * backends ? 'large enough' : `too small (needs ${f1(100 * backends / 1000)} thousand)`],
        ['Share of the hash space each backend owns', `${f1(100 / backends)}%`],
        ['Slots that must change at least when the failing backends go', f1(failing * perBackend)],
        ['Maglev machines for the peak, plus one spare', f1(Math.ceil(peak / gbps) + 1)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
