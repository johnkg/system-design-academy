---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Vectors are big, and a graph index wants them in memory. How you store them decides how many machines you need.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Vectors (millions) <input type="range" min="1" max="1000" value="100" data-n /> <b data-nval></b></label>
      <label>Dimensions <select class="pg-in" data-d><option value="384">384</option><option value="768" selected>768</option><option value="1536">1,536</option></select></label>
      <label>Stored as <select class="pg-in" data-s>
        <option value="4" selected>32-bit floats (4 bytes per dimension)</option>
        <option value="2">16-bit floats (2 bytes per dimension)</option>
        <option value="1">8-bit integers (1 byte per dimension)</option>
        <option value="pq">product quantization (8 dimensions per byte)</option>
      </select></label>
      <label>Graph links per vector (M) <input type="range" min="8" max="64" step="8" value="16" data-m /> <b data-mval></b></label>
      <label>Replicas of each shard <input type="range" min="1" max="5" value="3" data-r /> <b data-rval></b></label>
      <label>Queries per second <input type="range" min="100" max="50000" step="100" value="5000" data-qps /> <b data-qval></b></label>
      <label>Memory per machine (GB) <input type="range" min="64" max="512" step="64" value="256" data-gb /> <b data-gbval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a graph index stores 2 x M links of 4 bytes for each vector (the bottom layer dominates), only 70% of a machine's memory is used for the index, a shard answers about 2,000 queries per second, every query visits every shard, and an exact scan reads memory at about 20 GB per second on one machine. Product quantization keeps full vectors out of the way, so a reranking copy on disk is not counted.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 8; // one per output line
    const MILLION = 1e6; const BYTES_PER_GB = 1e9; const FLOAT_BYTES = 4;
    const PQ_DIMS_PER_BYTE = 8; // product quantisation stores one byte per 8 dimensions
    const LINK = { perM: 2, bytes: 4 }; // graph keeps 2m neighbour ids of 4 bytes per vector
    const MEM_USE = 0.7; const QPS_PER_REPLICA = 2000; const SCAN_GBPS = 20;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const gb = (n: number) => `${n >= 100 ? fmt(n) : n.toFixed(1)} GB`;
    function draw() {
      const n = val('[data-n]') * MILLION; const d = val('[data-d]'); const stored = q<HTMLSelectElement>('[data-s]').value;
      const m = val('[data-m]'); const rep = val('[data-r]'); const qps = val('[data-qps]'); const mem = val('[data-gb]');
      ['n', 'm', 'r', 'gb'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      q('[data-qval]').textContent = fmt(qps);
      const bytes = stored === 'pq' ? d / PQ_DIMS_PER_BYTE : d * Number(stored);
      const raw = (n * d * FLOAT_BYTES) / BYTES_PER_GB; const vecGb = (n * bytes) / BYTES_PER_GB; const graphGb = (n * LINK.perM * m * LINK.bytes) / BYTES_PER_GB; const total = vecGb + graphGb;
      const shards = Math.max(1, Math.ceil(total / (mem * MEM_USE)));
      const sets = Math.max(rep, Math.ceil(qps / QPS_PER_REPLICA));
      const data: [string, string][] = [
        ['Raw vectors as 32-bit floats', gb(raw)],
        ['Bytes per stored vector', `${fmt(bytes)} bytes`],
        ['Stored vectors', gb(vecGb)],
        ['Graph links', gb(graphGb)],
        ['Index to hold in memory', gb(total)],
        ['Shards (70% of memory used)', fmt(shards)],
        ['Replicas needed (for availability or the query rate)', fmt(sets)],
        ['Machines in total, and one exact scan of the raw data', `${fmt(shards * sets)}, ${fmt(raw / SCAN_GBPS)} s`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
