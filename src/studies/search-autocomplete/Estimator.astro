---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Every keystroke is a request, so the load is several times the number of searches. See what debouncing and caching save.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Daily searchers (millions) <input type="range" min="1" max="1000" value="200" data-dau /> <b data-dauval></b></label>
      <label>Searches per person per day <input type="range" min="1" max="20" value="5" data-sp /> <b data-spval></b></label>
      <label>Characters typed per search <input type="range" min="3" max="30" value="12" data-ch /> <b data-chval></b></label>
      <label>Requests saved by waiting for a pause in typing (%) <input type="range" min="0" max="80" step="5" value="50" data-deb /> <b data-debval></b></label>
      <label>Answered from browser and CDN caches (%) <input type="range" min="0" max="95" step="5" value="70" data-hit /> <b data-hitval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: peak traffic is 3 times the average, there are 50 million distinct queries of 25 characters on average, a trie node costs about 40 bytes, shared prefixes cut the node count by about half, the stored suggestions add about 2 GB, and one server answers about 20,000 lookups per second.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const N_ROWS = 8; // output lines below
    const MILLION = 1e6; const GB = 1e9; const DAY_S = 86400;
    const PEAK_FACTOR = 3; // peak rate over the daily average
    const TRIE = { phrases: 50e6, chars: 25, nodeBytes: 40, shared: 0.5, extraGb: 2 }; // shared prefixes make about half the nodes; extra holds the top-k lists
    const SERVER_RPS = 20000; const MIN_SERVERS = 2;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const dau = val('[data-dau]'); const sp = val('[data-sp]'); const ch = val('[data-ch]'); const deb = val('[data-deb]'); const hit = val('[data-hit]');
      q('[data-dauval]').textContent = String(dau); q('[data-spval]').textContent = String(sp); q('[data-chval]').textContent = String(ch);
      q('[data-debval]').textContent = String(deb); q('[data-hitval]').textContent = String(hit);
      const searches = dau * MILLION * sp; const keys = searches * ch;
      const afterDeb = keys * (1 - deb / 100); const origin = afterDeb * (1 - hit / 100);
      const peak = (n: number) => (n / DAY_S) * PEAK_FACTOR;
      const trieGb = (TRIE.phrases * TRIE.chars * TRIE.nodeBytes) / GB * TRIE.shared + TRIE.extraGb;
      const data: [string, string][] = [
        ['Searches per day', `${fmt(searches / MILLION)} million`],
        ['Keystrokes per day (one request each, naive)', `${fmt(keys / MILLION)} million`],
        ['Requests per second at the peak, naive', fmt(peak(keys))],
        ['After waiting for a pause in typing', fmt(peak(afterDeb))],
        ['Reaching the suggestion servers, after caches', fmt(peak(origin))],
        ['Servers needed for that load', fmt(Math.max(MIN_SERVERS, Math.ceil(peak(origin) / SERVER_RPS)))],
        ['Trie size in memory (rough)', `${trieGb.toFixed(1)} GB`],
        ['Searches written to the log per second at the peak', fmt(peak(searches))],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
