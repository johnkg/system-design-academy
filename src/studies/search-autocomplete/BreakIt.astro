---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Type and see the work" hint="Several thousand generated queries with popularity counts. Type a prefix, and watch how much work three ways of answering it do. All three give the same suggestions.">
  <ol class="how">
    <li>Type <b>c</b> (one letter): scanning looks at every query, and walking the subtree visits thousands of nodes. The stored top 5 needs <b>one step</b>.</li>
    <li>Keep typing <b>ca</b>, <b>car</b>, <b>cars</b>: the first two methods get cheaper as fewer queries match, and the stored lists still need only as many steps as there are letters.</li>
    <li>Type something nobody searches, like <b>zzz</b>: every method returns nothing, but scanning still read every row.</li>
  </ol>
  <div class="pg acb" data-acb>
    <div class="pg-row">
      <label>Typed so far <input class="pg-in" type="text" value="c" maxlength="20" autocomplete="off" spellcheck="false" data-q /></label>
    </div>
    <div class="pg-box" data-sbox><h3>Top suggestions</h3><span class="pg-mono" data-sug></span><span class="pg-note" data-same></span></div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Scan every query</h3><span class="pg-mono" data-w1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Walk the trie, then sort</h3><span class="pg-mono" data-w2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Top 5 stored in each node</h3><span class="pg-mono" data-w3></span><span class="pg-note" data-n3></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: queries are built from about 100 common words (single words, pairs and triples), with popularity falling off quickly down the ranking. Pairs and triples are made up, so some read oddly. It is always the same set. "Work" counts the queries or trie nodes touched to answer. Suggestions are the 5 most popular, with ties broken alphabetically.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-acb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const WORDS = [...new Set('google youtube facebook weather amazon netflix gmail news map translate walmart ebay instagram twitter yahoo food recipe movie music game hotel flights car cat dog cake coffee cheap cooking covid camera calendar canada cheese chicken cars credit card college cricket cruise computer city best buy free near me online today tomorrow how to what is price job jobs school phone iphone android laptop tesla bitcoin pizza restaurant shoes store taylor uber video windows zoom python download email bank insurance rental hosting wedding dresses'.split(' '))];
    type Entry = { query: string; count: number };
    const order = WORDS; // listed from most to least popular
    const queries: Entry[] = [];
    const TOP_K = 5; // suggestions shown
    const ZIPF = { top: 1e6, exp: 0.9 }; // the word at rank i is searched 1e6 / (i + 1)^0.9 times
    const PAIRS_FROM = 30, TRIPLES_FROM = [8, 10]; // two-word queries start with one of the top 30 words; three-word ones with the top 8, then the top 10
    const PAIR_SCALE = 1e7, TRIPLE_SCALE = 1e13; // turn products of word counts back into query counts
    const weight = (i: number) => Math.floor(ZIPF.top / (i + 1) ** ZIPF.exp);
    order.forEach((w, i) => queries.push({ query: w, count: weight(i) }));
    for (let i = 0; i < PAIRS_FROM; i++) for (let j = 0; j < order.length; j++) if (i !== j) queries.push({ query: `${order[i]} ${order[j]}`, count: Math.floor(weight(i) * weight(j) / PAIR_SCALE) + 1 });
    for (let i = 0; i < TRIPLES_FROM[0]; i++) for (let j = 0; j < TRIPLES_FROM[1]; j++) for (let k = 0; k < order.length; k++) if (i !== j && j !== k) queries.push({ query: `${order[i]} ${order[j]} ${order[k]}`, count: Math.floor(weight(i) * weight(j) * weight(k) / TRIPLE_SCALE) + 1 });
    const better = (a: Entry, b: Entry) => b.count - a.count || (a.query < b.query ? -1 : a.query > b.query ? 1 : 0);
    type Node = { kids: Map<string, Node>; top: Entry[]; entries: Entry[] };
    const mk = (): Node => ({ kids: new Map(), top: [], entries: [] });
    const root0 = mk();
    for (const e of queries) {
      let n = root0;
      for (const ch of e.query) { let c = n.kids.get(ch); if (!c) { c = mk(); n.kids.set(ch, c); } n = c; }
      n.entries.push(e);
    }
    // Fill the top lists bottom-up: a node's list is the best 5 of its own queries and its children's lists.
    (function fill(n: Node): Entry[] {
      const all = [...n.entries]; n.kids.forEach((c) => all.push(...fill(c)));
      n.top = all.sort(better).slice(0, TOP_K); return n.top;
    })(root0);
    const nodeCount = (n: Node): number => { let c = 1; n.kids.forEach((k) => (c += nodeCount(k))); return c; };
    function draw() {
      const prefix = q<HTMLInputElement>('[data-q]').value.toLowerCase();
      // 1. Scan every query.
      const scanned = queries.length; const matches = queries.filter((e) => e.query.startsWith(prefix));
      const s1 = matches.sort(better).slice(0, TOP_K).map((e) => e.query);
      // 2. Walk to the node, then visit the whole subtree to collect and sort.
      let n: Node | undefined = root0; let steps = 0;
      for (const ch of prefix) { n = n?.kids.get(ch); steps++; if (!n) break; }
      const subtree = n ? nodeCount(n) : 0;
      const collected: Entry[] = []; (function walk(x: Node) { collected.push(...x.entries); x.kids.forEach(walk); })(n ?? mk());
      const s2 = collected.sort(better).slice(0, TOP_K).map((e) => e.query);
      // 3. Read the stored list.
      const s3 = (n?.top ?? []).map((e) => e.query);
      const same = JSON.stringify(s1) === JSON.stringify(s2) && JSON.stringify(s2) === JSON.stringify(s3);
      const f = (x: number) => x.toLocaleString('en-US');
      q('[data-sug]').textContent = s3.length ? s3.join(' · ') : 'no suggestions';
      q('[data-same]').textContent = same ? `all three methods agree (${f(matches.length)} queries start with this)` : 'the methods disagree';
      q('[data-w1]').textContent = `${f(scanned)} queries read`;
      q('[data-n1]').textContent = `${f(matches.length)} matched and had to be sorted`;
      q('[data-w2]').textContent = `${f(steps + subtree)} nodes visited`;
      q('[data-n2]').textContent = `${steps} to reach the prefix, then ${f(subtree)} below it, ${f(collected.length)} queries sorted`;
      q('[data-w3]').textContent = `${steps} step${steps === 1 ? '' : 's'}`;
      q('[data-n3]').textContent = prefix ? `follow ${steps} link${steps === 1 ? '' : 's'}, read the list that is waiting` : 'read the list at the root';
      const out = q('[data-verdict]');
      out.classList.toggle('bad', !same);
      out.textContent = same ? `Stored lists answer in ${steps} step${steps === 1 ? '' : 's'}. Scanning does ${f(scanned)} comparisons for the same answer, ${f(Math.round(scanned / Math.max(steps, 1)))} times more.` : 'Something is wrong: the methods returned different lists.';
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
