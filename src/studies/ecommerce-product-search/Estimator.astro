---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Write load decides how many shards you need, read load decides how many copies, and putting price and stock in the document multiplies the write load by the rate at which they change.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Listings (millions)" name="l" min="5" max="200" step="5" value="50" />
      <RangeField label="Searches per second at peak (thousands)" name="q" min="1" max="100" value="20" />
      <RangeField label="Price and stock changes per minute (thousands)" name="u" min="50" max="1000" step="50" value="300" />
      <RangeField label="New listings and text edits per minute (thousands)" name="n" min="1" max="50" value="6" />
      <RangeField label="Flash-sale multiplier for price and stock changes" name="x" min="1" max="10" value="3" />
      <RangeField label="Whole documents one shard writes per second" name="w" min="200" max="3000" step="100" value="1400" />
      <RangeField label="Index size per listing (KB)" name="k" min="1" max="20" value="4" />
      <RangeField label="Candidates re-ranked per search" name="c" min="20" max="500" step="10" value="200" />
      <RangeField label="Replicas per shard" name="r" min="0" max="4" value="2" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: every change to a listing re-indexes its whole document, because an index built from immutable segments typically rewrites the document even for a partial update. A shard is kept at 70% of its write rate and holds about 30 GB. Every search reads one copy of every shard. With price and stock on the side, the index only sees new listings and text edits. The side store keeps one small record per listing (price, stock, version, about 64 bytes) in memory and answers about 500,000 reads a second per node.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatWholeNumber } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const MILLION = 1e6, THOUSAND = 1e3, MIN_S = 60, KB_PER_GB = 1e6;
    const SHARD_GB = 30, HEADROOM = 0.7, SIDE_READS_PER_NODE = 500000;
    const N_ROWS = 10;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const l = val('[data-l]') * MILLION, qps = val('[data-q]') * THOUSAND, u = val('[data-u]') * THOUSAND, n = val('[data-n]') * THOUSAND;
      const x = val('[data-x]'), w = val('[data-w]'), k = val('[data-k]'), c = val('[data-c]'), r = val('[data-r]');
      ['l', 'q', 'u', 'n', 'x', 'w', 'k', 'c', 'r'].forEach((id) => (q(`[data-${id}val]`).textContent = String(val(`[data-${id}]`))));
      const whole = (u + n) / MIN_S, sale = (u * x + n) / MIN_S, side = n / MIN_S;
      const indexGb = (l * k) / KB_PER_GB;
      const shardsBySize = Math.max(1, Math.ceil(indexGb / SHARD_GB));
      const shardsForSale = Math.ceil(sale / (w * HEADROOM));
      const shards = Math.max(shardsBySize, shardsForSale);
      const data: [string, string][] = [
        ['Index writes per second if every change re-indexes a whole document', formatWholeNumber(whole)],
        ['The same during a flash sale', formatWholeNumber(sale)],
        ['Index writes per second with price and stock on the side', formatWholeNumber(side)],
        ['Index size', `${formatWholeNumber(indexGb)} GB`],
        ['Shards needed for the size', formatWholeNumber(shardsBySize)],
        ['Shards needed to survive the flash sale with whole documents', formatWholeNumber(shardsForSale)],
        ['Shard copies in the cluster, with the larger of the two', formatWholeNumber(shards * (1 + r))],
        ['Searches each shard copy answers per second', formatWholeNumber(qps / (1 + r))],
        ['Side-store lookups per second', formatWholeNumber(qps * c)],
        ['Side-store nodes for those lookups', formatWholeNumber(Math.ceil((qps * c) / SIDE_READS_PER_NODE))],
      ];
      rows.forEach((row, i) => { row.dt.textContent = data[i][0]; row.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
