---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Spans multiply fast: every request becomes dozens of spans, so sampling and retention decide the bill, and the instrumentation itself must cost almost nothing.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Requests per second entering the system <input type="range" min="100" max="20000" step="100" value="1200" data-rps /> <b data-rpsval></b></label>
      <label>Spans per request (all services) <input type="range" min="5" max="100" value="20" data-sp /> <b data-spval></b></label>
      <label>Bytes stored per span <input type="range" min="200" max="2000" step="100" value="500" data-by /> <b data-byval></b></label>
      <label>Traces kept after sampling (%) <input type="range" min="1" max="100" value="3" data-keep /> <b data-keepval></b></label>
      <label>Hot tier retention (days) <input type="range" min="1" max="14" value="3" data-hot /> <b data-hotval></b></label>
      <label>Cold tier retention (days) <input type="range" min="7" max="90" value="30" data-cold /> <b data-coldval></b></label>
      <label>Tail sampler wait (seconds) <input type="range" min="1" max="60" value="10" data-wait /> <b data-waitval></b></label>
      <label>CPU per request in one service (ms) <input type="range" min="1" max="50" value="5" data-cpu /> <b data-cpuval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a span costs about 10 microseconds of CPU in the app to create, fill in and batch for export, and a request passes through 6 services, so each service makes about a sixth of the spans. Hot-tier storage is indexed and takes 1.5 times the span bytes. Cold storage is compressed objects looked up by trace id, at about half the span bytes. Hot costs 0.10 dollars per GB-month and cold 0.02. One 2-vCPU collector handles about 40,000 spans per second, and the tail sampler holds about 2 KB of memory per buffered span. Tail sampling needs all spans, so the collectors receive 100% of the spans even though only the kept share is stored.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 12 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const size = (b: number) => (b >= 1e12 ? `${(b / 1e12).toFixed(1)} TB` : b >= 1e9 ? `${(b / 1e9).toFixed(1)} GB` : `${(b / 1e6).toFixed(0)} MB`);
    function draw() {
      const rps = val('[data-rps]'); const sp = val('[data-sp]'); const by = val('[data-by]'); const keep = val('[data-keep]') / 100; const hot = val('[data-hot]'); const cold = val('[data-cold]'); const wait = val('[data-wait]'); const cpu = val('[data-cpu]');
      ['rps', 'sp', 'by', 'keep', 'hot', 'cold', 'wait', 'cpu'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const spansPerSec = rps * sp; const rawDay = spansPerSec * 86400 * by; const keptDay = rawDay * keep;
      const hotBytes = keptDay * hot * 1.5; const coldBytes = keptDay * cold * 0.5;
      const cost = (hotBytes / 1e9) * 0.1 + (coldBytes / 1e9) * 0.02;
      const overhead = ((sp / 6) * 0.01) / cpu * 100;
      const collectors = Math.ceil(spansPerSec / 40000);
      const bufferedTraces = rps * wait; const memBytes = bufferedTraces * sp * 2000;
      const data: [string, string][] = [
        ['Spans produced per second', fmt(spansPerSec)],
        ['Span data per day if everything were stored', size(rawDay)],
        ['Span data stored per day after sampling', size(keptDay)],
        ['Hot tier (indexed, fast search)', size(hotBytes)],
        ['Cold tier (by trace id only)', size(coldBytes)],
        ['Storage cost per month', `${fmt(cost)} dollars`],
        ['Collectors needed (2 vCPU each)', fmt(collectors)],
        ['Export traffic from apps to collectors', `${((spansPerSec * by) / 1e6).toFixed(1)} MB/s`],
        ['Traces held while waiting to decide', fmt(bufferedTraces)],
        ['Tail sampler memory', size(memBytes)],
        ['Spans per service per request', (sp / 6).toFixed(1)],
        ['CPU overhead of instrumentation in each service', `${overhead.toFixed(2)}%`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
