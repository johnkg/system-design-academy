---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Renewals usually dominate the load on the lock group, and a short lease costs more heartbeats but frees a crashed holder's lock sooner.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Locks held at once (thousands) <input type="range" min="1" max="100" value="20" data-h /> <b data-hval></b></label>
      <label>Average time a lock is held (seconds) <input type="range" min="1" max="300" value="30" data-t /> <b data-tval></b></label>
      <label>Lease length (seconds) <input type="range" min="2" max="60" value="10" data-l /> <b data-lval></b></label>
      <label>Renewals per lease <input type="range" min="2" max="6" value="3" data-r /> <b data-rval></b></label>
      <label>Locks with waiters (%) <input type="range" min="0" max="50" value="10" data-c /> <b data-cval></b></label>
      <label>Waiters on such a lock <input type="range" min="1" max="500" value="20" data-w /> <b data-wval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: every acquire, release and renewal is one write committed by the consensus group (etcd keeps lease renewals off the log, so this is an upper bound), the group commits about 10,000 writes per second with 3 or 5 servers on SSDs, and a holder is renewed at equal intervals. A woken waiter costs one read and one write attempt, counted here as one wake-up.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const CAPACITY = 10000;
    function draw() {
      ['h', 't', 'l', 'r', 'c', 'w'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const held = val('[data-h]') * 1000; const hold = val('[data-t]'); const lease = val('[data-l]'); const renews = val('[data-r]');
      const contended = val('[data-c]') / 100; const waiters = val('[data-w]');
      const acquires = held / hold;
      const renewals = (held * renews) / lease;
      const writes = acquires * 2 + renewals;
      const releasesWithWaiters = acquires * contended;
      const data: [string, string][] = [
        ['Acquisitions per second (and the same number of releases)', fmt(acquires)],
        ['Renewals per second', fmt(renewals)],
        ['Writes per second for the lock group', fmt(writes)],
        ['Share of the group\'s 10,000 writes per second', `${fmt((writes / CAPACITY) * 100)} %`],
        ['Pause that is always survived (worst case)', `${(lease - lease / renews).toFixed(1)} s`],
        ['Longest wait for a lock after its holder crashes', `${fmt(lease)} s`],
        ['Wake-ups per second if all waiters watch the lock', fmt(releasesWithWaiters * waiters)],
        ['Wake-ups per second if each waiter watches the one before', fmt(releasesWithWaiters)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
