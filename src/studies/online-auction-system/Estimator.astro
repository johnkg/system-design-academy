---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Average load is small. The hard numbers come from one hot auction in its last minute: every bid is pushed to every watcher.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Live auctions (millions) <input type="range" min="1" max="100" value="20" data-l /> <b data-lval></b></label>
      <label>Bids per auction, on average <input type="range" min="1" max="50" value="12" data-bpa /> <b data-bpaval></b></label>
      <label>Bids placed in an auction's last 5 minutes (%) <input type="range" min="5" max="80" value="30" data-sh /> <b data-shval></b></label>
      <label>Bids per second on one hot auction <input type="range" min="1" max="500" value="40" data-k /> <b data-kval></b></label>
      <label>Watchers of the hot auction (thousands) <input type="range" min="1" max="500" value="50" data-w /> <b data-wval></b></label>
      <label>Open auction pages at once (millions) <input type="range" min="1" max="20" value="2" data-v /> <b data-vval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: an auction runs 7 days (604,800 seconds), a bid record takes 200 bytes with its index entries, a push gateway holds 100,000 connections, and pushes to watchers are batched every 250 ms (at most 4 per second per watcher).</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 8; // one per output line
    const MILLION = 1e6; const THOUSAND = 1000; const DAY_S = 86400; const MS_PER_S = 1000; const BYTES_PER_GB = 1e9;
    const AUCTION_DAYS = 7; const BID_BYTES = 200; const BATCH_MS = 250; const PAGES_PER_GATEWAY = 100000;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const l = val('[data-l]') * MILLION; const bpa = val('[data-bpa]'); const share = val('[data-sh]') / 100; const k = val('[data-k]'); const w = val('[data-w]') * THOUSAND; const v = val('[data-v]') * MILLION;
      ['l', 'bpa', 'sh', 'k', 'w', 'v'].forEach((x) => (q(`[data-${x}val]`).textContent = String(val(`[data-${x}]`))));
      const DURATION = AUCTION_DAYS * DAY_S;
      const bidsPerSec = (l * bpa) / DURATION; const endingBids = bidsPerSec * share; const closes = l / DURATION;
      const gbPerDay = (bidsPerSec * DAY_S * BID_BYTES) / BYTES_PER_GB;
      const data: [string, string][] = [
        ['Bids per second, averaged over the week', fmt(bidsPerSec)],
        ['Bids per second that land in an auction\'s last 5 minutes', fmt(endingBids)],
        ['Auctions to close per second', fmt(closes)],
        ['Bid history added per day', `${gbPerDay.toFixed(1)} GB`],
        ['Writes per second on the hot auction\'s row', fmt(k)],
        ['Pushes per second if every bid goes to every watcher', fmt(k * w)],
        [`Pushes per second with ${BATCH_MS} ms batching`, fmt(Math.min(k, MS_PER_S / BATCH_MS) * w)],
        ['Push gateways for the open pages', fmt(Math.ceil(v / PAGES_PER_GATEWAY))],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
