---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The data fits in memory easily. What limits a coordination service is the write rate through one leader and the cost of every watch.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Client processes (thousands) <input type="range" min="1" max="100" value="5" data-c /> <b data-cval></b></label>
      <label>Keys per client <input type="range" min="1" max="100" value="20" data-k /> <b data-kval></b></label>
      <label>Value size (bytes) <input type="range" min="50" max="10000" step="50" value="200" data-v /> <b data-vval></b></label>
      <label>Writes per client per hour <input type="range" min="1" max="600" value="30" data-w /> <b data-wval></b></label>
      <label>Watchers per changed key <input type="range" min="1" max="1000" value="50" data-wa /> <b data-waval></b></label>
      <label>Voting servers <select class="pg-in" data-n><option value="3">3</option><option value="5" selected>5</option><option value="7">7</option></select></label>
      <label>Round trip between servers (ms) <input type="range" min="1" max="20" value="1" data-rtt /> <b data-rttval></b></label>
      <label>Disk flush time (ms) <input type="range" min="1" max="20" value="2" data-fs /> <b data-fsval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: each key costs about 300 bytes of overhead on top of its value (path, version, owner, bookkeeping), a commit takes one round trip to the followers plus one disk flush, the leader groups about 20 writes into each flush and round trip, session heartbeats are not written to the log, and each notification is about 100 bytes.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const clients = val('[data-c]') * 1000; const keys = val('[data-k]'); const bytes = val('[data-v]'); const perHour = val('[data-w]');
      const watchers = val('[data-wa]'); const n = val('[data-n]'); const rtt = val('[data-rtt]'); const flush = val('[data-fs]');
      ['c', 'k', 'v', 'w', 'wa', 'rtt', 'fs'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const totalKeys = clients * keys; const memMb = (totalKeys * (bytes + 300)) / 1e6;
      const writes = (clients * perHour) / 3600; const commitMs = rtt + flush;
      const capacity = (1000 / commitMs) * 20; const util = (writes / capacity) * 100;
      const notifs = writes * watchers; const quorum = Math.floor(n / 2) + 1;
      const data: [string, string][] = [
        ['Keys stored', fmt(totalKeys)],
        ['Memory for the whole tree, on every server', memMb >= 1000 ? `${(memMb / 1000).toFixed(1)} GB` : `${fmt(memMb)} MB`],
        ['Writes per second', fmt(writes)],
        ['Time for one commit', `${commitMs} ms`],
        ['Write capacity of the leader', `${fmt(capacity)} per second`],
        ['Leader busy with writes', `${util < 1 ? '<1' : fmt(util)} %${util > 70 ? ' (too close to the limit)' : ''}`],
        ['Notifications sent per second', fmt(notifs)],
        ['Servers that must store a write', `${quorum} of ${n}`],
        ['Failures survived', `${n - quorum}`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
