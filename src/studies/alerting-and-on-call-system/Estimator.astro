---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Rule count and evaluation interval set the query load. The wait before firing sets the detection delay. Grouping and inhibition decide whether an outage is a few pages or thousands.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Alert rules (thousands) <input type="range" min="1" max="100" value="10" data-r /> <b data-rval></b></label>
      <label>Evaluation interval (seconds) <input type="range" min="15" max="120" step="15" value="30" data-i /> <b data-ival></b></label>
      <label>Series read by each rule <input type="range" min="100" max="10000" step="100" value="2000" data-s /> <b data-sval></b></label>
      <label>Rule waits before firing (minutes) <input type="range" min="0" max="15" value="5" data-f /> <b data-fval></b></label>
      <label>Instances (pods and hosts) <input type="range" min="500" max="20000" step="500" value="5000" data-n /> <b data-nval></b></label>
      <label>Instances alerting in a big outage (%) <input type="range" min="5" max="100" step="5" value="40" data-p /> <b data-pval></b></label>
      <label>Alerts per alerting instance <input type="range" min="1" max="6" value="3" data-a /> <b data-aval></b></label>
      <label>Distinct groups (service and alert name) <input type="range" min="5" max="200" step="5" value="60" data-g /> <b data-gval></b></label>
      <label>Alerts hidden by inhibition (%) <input type="range" min="0" max="99" value="90" data-h /> <b data-hval></b></label>
      <label>Outage length (minutes) <input type="range" min="10" max="240" step="10" value="60" data-d /> <b data-dval></b></label>
      <label>Reminder interval (minutes) <input type="range" min="5" max="240" step="5" value="30" data-rem /> <b data-remval></b></label>
      <label>Pages per 12-hour on-call shift <input type="range" min="0" max="30" value="8" data-ps /> <b data-psval></b></label>
      <label>Pages nobody needed to act on (%) <input type="range" min="0" max="100" step="5" value="40" data-w /> <b data-wval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a group waits 30 seconds before its first notification and delivery takes 10 seconds; the alerts that inhibition does not hide are in groups that each send one notification, repeated at the reminder interval while the outage lasts; an on-call week is 14 shifts of 12 hours; the guideline is at most 2 pages per shift.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 10; // one per output line
    const THOUSAND = 1000; const SEC_PER_MIN = 60;
    const DELAY_S = { scrape: 30, notify: 10 }; // worst-case scrape age and notification send time
    const SHIFTS_PER_WEEK = 14; const PAGES_PER_SHIFT_OK = 2; const GOAL_S = 300; // detection goal: 5 minutes
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      ['r', 'i', 's', 'f', 'n', 'p', 'a', 'g', 'h', 'd', 'rem', 'ps', 'w'].forEach((k) => (q(`[data-${k}val]`).textContent = fmt(val(`[data-${k}]`))));
      const rules = val('[data-r]') * THOUSAND; const interval = val('[data-i]'); const series = val('[data-s]'); const wait = val('[data-f]');
      const evalsPerSec = rules / interval; const readsPerSec = evalsPerSec * series;
      const delaySec = interval + wait * SEC_PER_MIN + DELAY_S.scrape + DELAY_S.notify;
      const raw = Math.round(val('[data-n]') * (val('[data-p]') / 100) * val('[data-a]'));
      const groups = Math.ceil((val('[data-g]') * (100 - val('[data-h]'))) / 100);
      const notes = groups * Math.ceil(val('[data-d]') / val('[data-rem]'));
      const cut = raw > 0 ? (100 * (raw - notes)) / raw : 0;
      const week = val('[data-ps]') * SHIFTS_PER_WEEK; const wasted = week * (val('[data-w]') / 100); const over = Math.max(0, val('[data-ps]') - PAGES_PER_SHIFT_OK) * SHIFTS_PER_WEEK;
      const data: [string, string][] = [
        ['Rule evaluations per second', fmt(evalsPerSec)],
        ['Series read per second by the evaluator', fmt(readsPerSec)],
        ['Worst-case time from fault to first notification', `${(delaySec / SEC_PER_MIN).toFixed(1)} minutes`],
        ['Raw alerts firing in the big outage', fmt(raw)],
        ['Notifications with dedupe, grouping and inhibition', fmt(notes)],
        ['Reduction compared with one notification per alert', `${cut.toFixed(1)}%`],
        [`Pages per on-call week (${SHIFTS_PER_WEEK} shifts)`, fmt(week)],
        ['Pages nobody needed to act on, per week', fmt(wasted)],
        [`Pages per week above the guideline of ${PAGES_PER_SHIFT_OK} per shift`, fmt(over)],
        [`Meets the ${GOAL_S / SEC_PER_MIN}-minute detection goal?`, delaySec <= GOAL_S ? 'yes' : `no, over by ${fmt(delaySec - GOAL_S)} seconds`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
