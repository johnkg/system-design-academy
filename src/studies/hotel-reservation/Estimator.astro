---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Bookings are rare and searches are many. The inventory table is small, and the real work is the peak of searches and the rows of the hottest nights.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Hotels (thousands) <input type="range" min="1" max="100" value="20" data-h /> <b data-hval></b></label>
      <label>Rooms per hotel <input type="range" min="20" max="1000" step="10" value="150" data-r /> <b data-rval></b></label>
      <label>Average occupancy (%) <input type="range" min="30" max="95" value="70" data-o /> <b data-oval></b></label>
      <label>Average stay (nights) <input type="range" min="1" max="7" value="2" data-s /> <b data-sval></b></label>
      <label>Searches per booking <input type="range" min="10" max="500" step="10" value="100" data-l /> <b data-lval></b></label>
      <label>Search cache hit rate (%) <input type="range" min="0" max="99" value="95" data-c /> <b data-cval></b></label>
      <label>Hold time (minutes) <input type="range" min="2" max="30" value="10" data-m /> <b data-mval></b></label>
      <label>Peak is how many times the average <input type="range" min="1" max="10" value="4" data-k /> <b data-kval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 6 room types per hotel, a 365-night booking horizon, an inventory row of about 100 bytes with its index, and 2 holds started for every booking that is paid, because half of the guests who start paying leave. Every night of a stay is one row update.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const hotels = val('[data-h]') * 1000; const rooms = val('[data-r]'); const occ = val('[data-o]') / 100; const stay = val('[data-s]');
      const l2b = val('[data-l]'); const hit = val('[data-c]') / 100; const hold = val('[data-m]') * 60; const peak = val('[data-k]');
      ['h', 'r', 'o', 's', 'l', 'c', 'm', 'k'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const totalRooms = hotels * rooms;
      const bookingsDay = (totalRooms * occ) / stay;
      const bookingsPeak = (bookingsDay / 86400) * peak;
      const rowUpdates = bookingsPeak * stay;
      const searches = bookingsPeak * l2b;
      const dbReads = searches * (1 - hit);
      const invRows = hotels * 6 * 365;
      const holdsActive = bookingsPeak * 2 * hold;
      const data: [string, string][] = [
        ['Rooms in the chain', fmt(totalRooms)],
        ['Bookings per day', fmt(bookingsDay)],
        ['Bookings per second at the peak', fmt(bookingsPeak)],
        ['Inventory row updates per second at the peak', fmt(rowUpdates)],
        ['Searches per second at the peak', fmt(searches)],
        ['Search reads reaching the database with the cache', fmt(dbReads)],
        ['Inventory rows (hotels x 6 types x 365 nights)', fmt(invRows)],
        ['Inventory size', `${fmt((invRows * 100) / 1e9)} GB`],
        ['Holds active at the peak', fmt(holdsActive)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
