---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Bookings are rare and searches are many. The inventory table is small, and the real work is the peak of searches and the rows of the hottest nights.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Hotels (thousands)" name="h" min="1" max="100" value="20" />
      <RangeField label="Rooms per hotel" name="r" min="20" max="1000" step="10" value="150" />
      <RangeField label="Average occupancy (%)" name="o" min="30" max="95" value="70" />
      <RangeField label="Average stay (nights)" name="s" min="1" max="7" value="2" />
      <RangeField label="Searches per booking" name="l" min="10" max="500" step="10" value="100" />
      <RangeField label="Search cache hit rate (%)" name="c" min="0" max="99" value="95" />
      <RangeField label="Hold time (minutes)" name="m" min="2" max="30" value="10" />
      <RangeField label="Peak is how many times the average" name="k" min="1" max="10" value="4" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 6 room types per hotel, a 365-night booking horizon, an inventory row of about 100 bytes with its index, and 2 holds started for every booking that is paid, because half of the guests who start paying leave. Every night of a stay is one row update.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const THOUSAND = 1000, MIN_S = 60, DAY_S = 86400, GB = 1e9;
    const ROOM_TYPES = 6, NIGHTS = 365; // inventory rows per hotel: one per room type per night for a year
    const ROW_BYTES = 100;
    const HOLDS_PER_BOOKING = 2; // abandoned checkouts hold rooms too
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const hotels = val('[data-h]') * THOUSAND; const rooms = val('[data-r]'); const occ = val('[data-o]') / 100; const stay = val('[data-s]');
      const l2b = val('[data-l]'); const hit = val('[data-c]') / 100; const hold = val('[data-m]') * MIN_S; const peak = val('[data-k]');
      ['h', 'r', 'o', 's', 'l', 'c', 'm', 'k'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const totalRooms = hotels * rooms;
      const bookingsDay = (totalRooms * occ) / stay;
      const bookingsPeak = (bookingsDay / DAY_S) * peak;
      const rowUpdates = bookingsPeak * stay;
      const searches = bookingsPeak * l2b;
      const dbReads = searches * (1 - hit);
      const invRows = hotels * ROOM_TYPES * NIGHTS;
      const holdsActive = bookingsPeak * HOLDS_PER_BOOKING * hold;
      const data: [string, string][] = [
        ['Rooms in the chain', fmt(totalRooms)],
        ['Bookings per day', fmt(bookingsDay)],
        ['Bookings per second at the peak', fmt(bookingsPeak)],
        ['Inventory row updates per second at the peak', fmt(rowUpdates)],
        ['Searches per second at the peak', fmt(searches)],
        ['Search reads reaching the database with the cache', fmt(dbReads)],
        [`Inventory rows (hotels x ${ROOM_TYPES} types x ${NIGHTS} nights)`, fmt(invRows)],
        ['Inventory size', `${fmt((invRows * ROW_BYTES) / GB)} GB`],
        ['Holds active at the peak', fmt(holdsActive)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
