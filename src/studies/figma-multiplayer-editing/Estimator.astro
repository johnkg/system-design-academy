---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="One busy file, then the whole fleet. See what the journal batch window and the checkpoint interval do to the work you can lose and to the data you write.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>People dragging or typing right now <input type="range" min="1" max="50" value="5" data-e /> <b data-eval></b></label>
      <label>People only watching the file <input type="range" min="0" max="200" step="5" value="20" data-v /> <b data-vval></b></label>
      <label>Journal batch window (ms) <input type="range" min="100" max="2000" step="100" value="500" data-b /> <b data-bval></b></label>
      <label>Checkpoint interval (s) <input type="range" min="30" max="120" step="10" value="60" data-i /> <b data-ival></b></label>
      <label>Size of the whole file (MB) <input type="range" min="1" max="200" value="20" data-m /> <b data-mval></b></label>
      <label>Size of one change (bytes) <input type="range" min="20" max="1000" step="20" value="100" data-c /> <b data-cval></b></label>
      <label>Files open on the servers (thousands) <input type="range" min="10" max="500" step="10" value="100" data-f /> <b data-fval></b></label>
      <label>A redeploy closes them all within (s) <input type="range" min="5" max="300" step="5" value="30" data-r /> <b data-rval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Figma's posts report these facts: browsers send updates every 33 ms (30 a second), checkpoints are written every 30 to 60 seconds, and the journal aims to lose under 1 second of work. The file size, change size, number of open files, redeploy window and the number of people are round numbers chosen for teaching, not Figma data. The model counts only the editors' updates (30 a second each while they are changing something), sends each to everyone else, and ignores acknowledgements, write time, compression and message overhead.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const OUT_ROWS = 10; // lines in the result list
    const UPDATES_PER_S = 30; // one update every 33 ms while a person is changing something
    const KB = 1000, MB = 1e6;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const editors = val('[data-e]'); const viewers = val('[data-v]'); const batch = val('[data-b]'); const interval = val('[data-i]');
      const size = val('[data-m]') * MB; const change = val('[data-c]'); const files = val('[data-f]') * 1000; const close = val('[data-r]');
      ['e', 'v', 'b', 'i', 'm', 'c', 'f', 'r'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const updates = editors * UPDATES_PER_S;
      const data: [string, string][] = [
        ['Updates reaching the file\'s server per second', fmt(updates)],
        ['Updates the server sends out per second', fmt(updates * (editors + viewers - 1))],
        ['Journal writes per second for this file', fmt(1000 / batch)],
        ['Changes in each journal write', fmt((updates * batch) / 1000)],
        ['Most work lost in a crash, checkpoints only', `${interval} s`],
        ['Most work lost in a crash, with a journal', `${batch} ms`],
        ['Data per second if each batch window wrote the whole file', `${fmt((size * 1000) / batch / MB)} MB/s`],
        ['Data per second writing only the changes', `${fmt((updates * change) / KB)} KB/s`],
        ['Checkpoints per second across the servers, steady state', fmt(files / interval)],
        ['Checkpoints per second if a redeploy closes every file and each must checkpoint first', fmt(files / close)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
