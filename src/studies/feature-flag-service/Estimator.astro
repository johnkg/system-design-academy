---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Flag checks are free because they run in memory, so the costs are keeping thousands of copies of the ruleset fresh and storing the exposure events.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>SDK instances (servers) <input type="range" min="100" max="50000" step="100" value="5000" data-i /> <b data-ival></b></label>
      <label>Flags in the ruleset <input type="range" min="50" max="5000" step="50" value="500" data-f /> <b data-fval></b></label>
      <label>Size of one flag with its rules (KB) <input type="range" min="1" max="10" value="2" data-kb /> <b data-kbval></b></label>
      <label>Poll interval (seconds) <input type="range" min="5" max="300" step="5" value="30" data-p /> <b data-pval></b></label>
      <label>CDN cache lifetime (seconds) <input type="range" min="1" max="300" value="30" data-t /> <b data-tval></b></label>
      <label>Flag checks per second per instance <input type="range" min="100" max="5000" step="100" value="1000" data-e /> <b data-eval></b></label>
      <label>Checks logged as exposure events (per 1,000) <input type="range" min="1" max="20" value="1" data-x /> <b data-xval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 50 CDN edge locations, a 304 response to an unchanged poll is about 300 bytes, one streaming node holds about 50,000 connections (and the service runs at least 2), an exposure event (logged once per user and flag, so a small share of all checks) is about 100 bytes, and the exposure log is kept in a columnar store at roughly the same size on disk.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 11 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const one = (n: number) => (n < 10 ? n.toFixed(1) : fmt(n));
    function draw() {
      const inst = val('[data-i]'); const flags = val('[data-f]'); const kb = val('[data-kb]'); const p = val('[data-p]'); const t = val('[data-t]'); const e = val('[data-e]'); const x = val('[data-x]') / 1000;
      ['i', 'f', 'kb', 'p', 't', 'e', 'x'].forEach((k) => (q(`[data-${k}val]`).textContent = fmt(val(`[data-${k}]`))));
      const EDGES = 50;
      const sizeMb = (flags * kb) / 1000; const polls = inst / p; const full = polls * sizeMb; const notModified = polls * 0.3;
      const cdnOrigin = Math.min(EDGES / t, polls); const nodes = Math.max(2, Math.ceil(inst / 50000));
      const checks = inst * e; const events = checks * x; const gbDay = (events * 100 * 86400) / 1e9;
      const data: [string, string][] = [
        ['Ruleset size', `${one(sizeMb)} MB`],
        ['Polls per second to the flag service, no CDN', fmt(polls)],
        ['Download per second if every poll fetched the whole ruleset', `${one(full)} MB (${fmt(full * 8)} Mbit/s)`],
        ['Download per second when unchanged polls get a 304', `${one(notModified)} KB`],
        ['Requests per second reaching the service behind a CDN', one(cdnOrigin)],
        ['Worst time for a change to arrive, polling / polling through a CDN', `${fmt(p)} s / ${fmt(p + t)} s`],
        ['Streaming: open connections, and nodes to hold them', `${fmt(inst)}, ${fmt(nodes)} nodes`],
        ['Streaming: data sent when one flag changes (the changed flag only / the whole ruleset)', `${one((inst * kb) / 1000)} MB / ${one(inst * sizeMb)} MB`],
        ['Flag checks per second across the fleet', `${one(checks / 1e6)} million, in memory, no network`],
        ['Exposure events per second', fmt(events)],
        ['Exposure log per day', `${one(gbDay)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
