---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Heartbeats scale with the fleet and the interval. Polling scales with the callers. Watches scale only with the number of changes.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Service instances (thousands)" name="n" min="1" max="100" value="20" />
      <RangeField label="Heartbeat interval (seconds)" name="hb" min="5" max="60" step="5" value="10" />
      <RangeField label="Lease = this many heartbeats" name="k" min="2" max="6" value="3" />
      <RangeField label="Replacements per instance per day" name="r" min="1" max="12" value="3" />
      <RangeField label="Caller processes (thousands)" name="c" min="1" max="50" value="5" />
      <RangeField label="Share of the fleet a caller needs (%)" name="s" min="1" max="100" value="10" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: an entry is about 500 bytes (address, port, zone, version, metadata), a replacement is one deregister plus one register, polling callers refresh their whole needed list every 30 seconds, watching callers receive only the events for the instances they need, and the self-preservation threshold is 85 percent of the expected renewals.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 10; // one per output line
    const THOUSAND = 1000; const SEC_PER_MIN = 60; const DAY_S = 86400;
    const CHANGES_PER_REPLACEMENT = 2; const INSTANCE_BYTES = 500; const EVENT_BYTES = 500;
    const POLL_S = 30; const SELF_PRESERVE = 0.85; // self-preservation when renewals fall below 85% of expected
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n).toLocaleString('en-US') : n.toFixed(n >= 10 ? 1 : 2));
    const bytes = (n: number) => (n >= 1e9 ? `${(n / 1e9).toFixed(1)} GB` : n >= 1e6 ? `${(n / 1e6).toFixed(1)} MB` : `${(n / 1e3).toFixed(1)} KB`);
    function draw() {
      const n = val('[data-n]') * THOUSAND; const hb = val('[data-hb]'); const k = val('[data-k]'); const r = val('[data-r]'); const c = val('[data-c]') * THOUSAND; const share = val('[data-s]') / 100;
      ['n', 'hb', 'k', 'r', 'c', 's'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const beats = n / hb; const lease = hb * k; const expectedMin = (n * SEC_PER_MIN) / hb;
      const changes = (n * r * CHANGES_PER_REPLACEMENT) / DAY_S; // each replacement is a deregister and a register
      const snap = n * share * INSTANCE_BYTES; const pollReq = c / POLL_S; const pollBytes = pollReq * snap;
      const events = changes * share * c; const watchBytes = events * EVENT_BYTES;
      const data: [string, string][] = [
        ['Heartbeats per second', fmt(beats)],
        ['Lease length (a crash is noticed within)', `${lease} s`],
        ['Renewals expected per minute', fmt(expectedMin)],
        ['Self-preservation starts below (per minute)', fmt(expectedMin * SELF_PRESERVE)],
        ['Registry changes per second', fmt(changes)],
        ['Size of the list one caller needs', bytes(snap)],
        [`Polling every ${POLL_S} s: registry bandwidth`, `${bytes(pollBytes)}/s`],
        ['Watching: events per second to all callers', fmt(events)],
        ['Watching: registry bandwidth', `${bytes(watchBytes)}/s`],
        ['Watching uses this share of the polling bandwidth', `${((watchBytes / pollBytes) * 100).toFixed(2)} %`],
      ];
      rows.forEach((row, i) => { row.dt.textContent = data[i][0]; row.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
