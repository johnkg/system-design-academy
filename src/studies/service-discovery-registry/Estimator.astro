---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Heartbeats scale with the fleet and the interval. Polling scales with the callers. Watches scale only with the number of changes.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Service instances (thousands) <input type="range" min="1" max="100" value="20" data-n /> <b data-nval></b></label>
      <label>Heartbeat interval (seconds) <input type="range" min="5" max="60" step="5" value="10" data-hb /> <b data-hbval></b></label>
      <label>Lease = this many heartbeats <input type="range" min="2" max="6" value="3" data-k /> <b data-kval></b></label>
      <label>Replacements per instance per day <input type="range" min="1" max="12" value="3" data-r /> <b data-rval></b></label>
      <label>Caller processes (thousands) <input type="range" min="1" max="50" value="5" data-c /> <b data-cval></b></label>
      <label>Share of the fleet a caller needs (%) <input type="range" min="1" max="100" value="10" data-s /> <b data-sval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: an entry is about 500 bytes (address, port, zone, version, metadata), a replacement is one deregister plus one register, polling callers refresh their whole needed list every 30 seconds, watching callers receive only the events for the instances they need, and the self-preservation threshold is 85 percent of the expected renewals.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 10 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n).toLocaleString('en-US') : n.toFixed(n >= 10 ? 1 : 2));
    const bytes = (n: number) => (n >= 1e9 ? `${(n / 1e9).toFixed(1)} GB` : n >= 1e6 ? `${(n / 1e6).toFixed(1)} MB` : `${(n / 1e3).toFixed(1)} KB`);
    function draw() {
      const n = val('[data-n]') * 1000; const hb = val('[data-hb]'); const k = val('[data-k]'); const r = val('[data-r]'); const c = val('[data-c]') * 1000; const share = val('[data-s]') / 100;
      ['n', 'hb', 'k', 'r', 'c', 's'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const beats = n / hb; const lease = hb * k; const expectedMin = (n * 60) / hb;
      const changes = (n * r * 2) / 86400; // each replacement is a deregister and a register
      const snap = n * share * 500; const pollReq = c / 30; const pollBytes = pollReq * snap;
      const events = changes * share * c; const watchBytes = events * 500;
      const data: [string, string][] = [
        ['Heartbeats per second', fmt(beats)],
        ['Lease length (a crash is noticed within)', `${lease} s`],
        ['Renewals expected per minute', fmt(expectedMin)],
        ['Self-preservation starts below (per minute)', fmt(expectedMin * 0.85)],
        ['Registry changes per second', fmt(changes)],
        ['Size of the list one caller needs', bytes(snap)],
        ['Polling every 30 s: registry bandwidth', `${bytes(pollBytes)}/s`],
        ['Watching: events per second to all callers', fmt(events)],
        ['Watching: registry bandwidth', `${bytes(watchBytes)}/s`],
        ['Watching uses this share of the polling bandwidth', `${((watchBytes / pollBytes) * 100).toFixed(2)} %`],
      ];
      rows.forEach((row, i) => { row.dt.textContent = data[i][0]; row.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
