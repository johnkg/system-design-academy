---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Concurrency is arrival rate times duration. It sets how many sandboxes, how much memory and how many hosts you need, and the bill is just the memory-seconds you actually used.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Peak requests per second <input type="range" min="10" max="20000" step="10" value="5000" data-r /> <b data-rval></b></label>
      <label>Average run time (ms) <input type="range" min="10" max="3000" step="10" value="120" data-d /> <b data-dval></b></label>
      <label>Memory per function (MB) <input type="range" min="128" max="4096" step="128" value="512" data-mb /> <b data-mbval></b></label>
      <label>Requests that hit a cold start (%) <input type="range" min="0" max="20" step="1" value="1" data-cs /> <b data-csval></b></label>
      <label>Cold start time (ms) <input type="range" min="50" max="3000" step="50" value="400" data-init /> <b data-initval></b></label>
      <label>Average load as a share of the peak (%) <input type="range" min="1" max="100" value="30" data-avg /> <b data-avgval></b></label>
      <label>Memory per worker host (GB) <input type="range" min="64" max="512" step="64" value="256" data-host /> <b data-hostval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: one request per sandbox, so concurrency = requests per second times run time (Little's law). The fleet keeps 20% headroom for the autoscaler, and a host uses 75% of its memory for sandboxes. A month is 30 days. Prices are in the range of the public ones: $0.0000166667 per GB-second of run time, $0.20 per million requests, and $0.0000041667 per GB-second for each provisioned instance that is kept ready. Free tiers are ignored.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 11 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const money = (n: number) => `$${n.toLocaleString('en-US', { maximumFractionDigits: 0 })}`;
    function draw() {
      const rps = val('[data-r]'); const ms = val('[data-d]'); const mb = val('[data-mb]'); const cold = val('[data-cs]') / 100; const init = val('[data-init]'); const avg = val('[data-avg]') / 100; const host = val('[data-host]');
      ['r', 'd', 'mb', 'cs', 'init', 'avg', 'host'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const gb = mb / 1024; const month = 30 * 86400;
      const concurrency = (rps * ms) / 1000; const ready = Math.ceil(concurrency * 1.2);
      const memGb = ready * gb; const hosts = Math.max(1, Math.ceil(memGb / (host * 0.75)));
      const starts = rps * cold; const extra = cold * init;
      const inv = rps * avg * month; const gbs = inv * (ms / 1000) * gb;
      const runCost = gbs * 0.0000166667 + (inv / 1e6) * 0.2;
      const provN = Math.ceil(concurrency * avg); const provCost = provN * gb * month * 0.0000041667;
      const data: [string, string][] = [
        ['Sandboxes busy at the peak', fmt(concurrency)],
        ['Sandboxes to keep ready (20% headroom)', fmt(ready)],
        ['Memory for sandboxes', `${fmt(memGb)} GB`],
        ['Worker hosts needed', fmt(hosts)],
        ['New sandboxes started per second at a cold rate of this size', fmt(starts)],
        ['Average extra latency per request from cold starts', `${extra.toFixed(1)} ms`],
        ['Requests per month at the average load', `${(inv / 1e9).toFixed(2)} billion`],
        ['Billed GB-seconds per month', `${(gbs / 1e6).toFixed(1)} million`],
        ['Cost per month, pay per use', money(runCost)],
        ['Provisioned instances to cover the average load', fmt(provN)],
        ['Extra fee for keeping those provisioned instances ready', `${money(provCost)} per month`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
