---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Concurrency is arrival rate times duration. It sets how many sandboxes, how much memory and how many hosts you need, and the bill is the memory-seconds you actually used.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Peak requests per second" name="r" min="10" max="20000" step="10" value="5000" />
      <RangeField label="Average run time (ms)" name="d" min="10" max="3000" step="10" value="120" />
      <RangeField label="Memory per function (MB)" name="mb" min="128" max="4096" step="128" value="512" />
      <RangeField label="Requests that hit a cold start (%)" name="cs" min="0" max="20" step="1" value="1" />
      <RangeField label="Cold start time (ms)" name="init" min="50" max="3000" step="50" value="400" />
      <RangeField label="Average load as a share of the peak (%)" name="avg" min="1" max="100" value="30" />
      <RangeField label="Memory per worker host (GB)" name="host" min="64" max="512" step="64" value="256" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: one request per sandbox, so concurrency = requests per second times run time (Little's law). The fleet keeps 20% headroom for the autoscaler, and a host uses 75% of its memory for sandboxes. A month is 30 days. Prices are in the range of the public ones: $0.0000166667 per GB-second of run time, $0.20 per million requests, and $0.0000041667 per GB-second for each provisioned instance that is kept ready. Free tiers are ignored.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 11; // lines in the result list
    const MB_PER_GB = 1024, DAY_S = 86400, MONTH_DAYS = 30, MS_PER_S = 1000, MILLION = 1e6, BILLION = 1e9;
    const READY_HEADROOM = 1.2; // keep 20% more sandboxes ready than are busy
    const HOST_FILL = 0.75; // pack hosts to 75% of their memory
    const PRICE = { gbSecond: 0.0000166667, perMillion: 0.2, provisionedGbSecond: 0.0000041667 }; // dollars
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const money = (n: number) => `$${n.toLocaleString('en-US', { maximumFractionDigits: 0 })}`;
    function draw() {
      const rps = val('[data-r]'); const ms = val('[data-d]'); const mb = val('[data-mb]'); const cold = val('[data-cs]') / 100; const init = val('[data-init]'); const avg = val('[data-avg]') / 100; const host = val('[data-host]');
      ['r', 'd', 'mb', 'cs', 'init', 'avg', 'host'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const gb = mb / MB_PER_GB; const month = MONTH_DAYS * DAY_S;
      const concurrency = (rps * ms) / MS_PER_S; const ready = Math.ceil(concurrency * READY_HEADROOM);
      const memGb = ready * gb; const hosts = Math.max(1, Math.ceil(memGb / (host * HOST_FILL)));
      const starts = rps * cold; const extra = cold * init;
      const inv = rps * avg * month; const gbs = inv * (ms / MS_PER_S) * gb;
      const runCost = gbs * PRICE.gbSecond + (inv / MILLION) * PRICE.perMillion;
      const provN = Math.ceil(concurrency * avg); const provCost = provN * gb * month * PRICE.provisionedGbSecond;
      const data: [string, string][] = [
        ['Sandboxes busy at the peak', fmt(concurrency)],
        ['Sandboxes to keep ready (20% headroom)', fmt(ready)],
        ['Memory for sandboxes', `${fmt(memGb)} GB`],
        ['Worker hosts needed', fmt(hosts)],
        ['New sandboxes started per second at a cold rate of this size', fmt(starts)],
        ['Average extra latency per request from cold starts', `${extra.toFixed(1)} ms`],
        ['Requests per month at the average load', `${(inv / BILLION).toFixed(2)} billion`],
        ['Billed GB-seconds per month', `${(gbs / MILLION).toFixed(1)} million`],
        ['Cost per month, pay per use', money(runCost)],
        ['Provisioned instances to cover the average load', fmt(provN)],
        ['Extra fee for keeping those provisioned instances ready', `${money(provCost)} per month`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
