---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Every case costs a candidate call and a judge call. The model API limit sets the time, the number of cases sets the cost, and the share of cases that differ between versions sets how small a change you can detect.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Cases in the dataset" name="n" min="100" max="10000" step="100" value="2000" />
      <RangeField label="Repeats per case" name="r" min="1" max="5" value="1" />
      <RangeField label="Candidate tokens in" name="ti" min="200" max="4000" step="100" value="800" />
      <RangeField label="Candidate tokens out" name="to" min="50" max="1500" step="50" value="300" />
      <RangeField label="Price per million tokens in ($)" name="pi" min="0.2" max="10" step="0.2" value="1" />
      <RangeField label="Price per million tokens out ($)" name="po" min="1" max="50" step="1" value="5" />
      <RangeField label="Cases that go to the judge (%)" name="j" min="0" max="100" step="10" value="100" />
      <RangeField label="Team's rate limit (requests per minute)" name="rpm" min="100" max="5000" step="100" value="1000" />
      <RangeField label="Evaluation runs per day" name="runs" min="10" max="2000" step="10" value="600" />
      <RangeField label="Cases that differ between versions (%)" name="d" min="2" max="30" value="10" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: only the candidate is run, because the baseline comes from the cache. The judge prompt holds the question, the answer and a 400-token rubric, and it answers in 100 tokens. A call takes about 6 seconds, and the platform runs at the rate limit. Pass rates are about 70%, runs are 30 days a month, and the interval is the 95% normal approximation, 1.96 standard errors.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 10; // output lines below
    const MILLION = 1e6; const S_PER_MIN = 60; const DAYS_PER_MONTH = 30; // prices are per million tokens
    const JUDGE_PROMPT_TOK = 400; const JUDGE_OUT_TOK = 100; // judge instructions added to each graded answer; judge verdict length
    const CALL_S = 6; // seconds one call is in flight
    const Z95 = 1.96; const BASE_PASS = 0.7; const BASE_FAIL = 0.3; // unpaired comparison assumes a 70% pass rate
    const MIN_DETECT = 0.02; // change the sample-size row is computed for
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    function draw() {
      const n = val('[data-n]'), r = val('[data-r]'), ti = val('[data-ti]'), to = val('[data-to]'), pi = val('[data-pi]'), po = val('[data-po]');
      const j = val('[data-j]') / 100, rpm = val('[data-rpm]'), runs = val('[data-runs]'), d = val('[data-d]') / 100;
      ['n', 'r', 'ti', 'to', 'pi', 'po', 'j', 'rpm', 'runs', 'd'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const cand = n * r; const judge = cand * j; const calls = cand + judge;
      const tokIn = cand * ti + judge * (ti + to + JUDGE_PROMPT_TOK); const tokOut = cand * to + judge * JUDGE_OUT_TOK;
      const cost = (tokIn * pi + tokOut * po) / MILLION;
      const minutes = calls / rpm; const workers = Math.ceil((calls / (minutes * S_PER_MIN)) * CALL_S);
      const sePaired = Math.sqrt(d / (n)); const seUnpaired = Math.sqrt((2 * BASE_PASS * BASE_FAIL) / n);
      const data: [string, string][] = [
        ['Candidate calls per run', fmt(cand)],
        ['Judge calls per run', fmt(judge)],
        ['Tokens per run (in and out)', `${(tokIn / MILLION).toFixed(1)} M in, ${(tokOut / MILLION).toFixed(1)} M out`],
        ['Cost of one run', '$' + cost.toFixed(2)],
        ['Cost per month at this many runs', usd(cost * runs * DAYS_PER_MONTH)],
        ['Time of one run at the rate limit', minutes < 90 ? `${minutes.toFixed(1)} minutes` : `${(minutes / 60).toFixed(1)} hours`],
        ['Workers needed to keep the limit busy', fmt(workers)],
        ['Change detectable with paired cases (95%)', `±${(Z95 * sePaired * 100).toFixed(1)} points`],
        ['Same change if the two pass rates are compared separately', `±${(Z95 * seUnpaired * 100).toFixed(1)} points`],
        [`Cases needed to detect a ${MIN_DETECT * 100}-point change, paired`, fmt(Math.ceil(((Z95 * Math.sqrt(d)) / MIN_DETECT) ** 2))],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
