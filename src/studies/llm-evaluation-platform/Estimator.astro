---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Every case costs a candidate call and a judge call. The model API limit sets the time, the number of cases sets the cost, and the share of cases that differ between versions sets how small a change you can detect.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Cases in the dataset <input type="range" min="100" max="10000" step="100" value="2000" data-n /> <b data-nval></b></label>
      <label>Repeats per case <input type="range" min="1" max="5" value="1" data-r /> <b data-rval></b></label>
      <label>Candidate tokens in <input type="range" min="200" max="4000" step="100" value="800" data-ti /> <b data-tival></b></label>
      <label>Candidate tokens out <input type="range" min="50" max="1500" step="50" value="300" data-to /> <b data-toval></b></label>
      <label>Price per million tokens in ($) <input type="range" min="0.2" max="10" step="0.2" value="1" data-pi /> <b data-pival></b></label>
      <label>Price per million tokens out ($) <input type="range" min="1" max="50" step="1" value="5" data-po /> <b data-poval></b></label>
      <label>Cases that go to the judge (%) <input type="range" min="0" max="100" step="10" value="100" data-j /> <b data-jval></b></label>
      <label>Team's rate limit (requests per minute) <input type="range" min="100" max="5000" step="100" value="1000" data-rpm /> <b data-rpmval></b></label>
      <label>Evaluation runs per day <input type="range" min="10" max="2000" step="10" value="600" data-runs /> <b data-runsval></b></label>
      <label>Cases that differ between versions (%) <input type="range" min="2" max="30" value="10" data-d /> <b data-dval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: only the candidate is run, because the baseline comes from the cache. The judge prompt holds the question, the answer and a 400-token rubric, and it answers in 100 tokens. A call takes about 6 seconds, and the platform runs at the rate limit. Pass rates are about 70%, runs are 30 days a month, and the interval is the 95% normal approximation, 1.96 standard errors.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 10 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    function draw() {
      const n = val('[data-n]'), r = val('[data-r]'), ti = val('[data-ti]'), to = val('[data-to]'), pi = val('[data-pi]'), po = val('[data-po]');
      const j = val('[data-j]') / 100, rpm = val('[data-rpm]'), runs = val('[data-runs]'), d = val('[data-d]') / 100;
      ['n', 'r', 'ti', 'to', 'pi', 'po', 'j', 'rpm', 'runs', 'd'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const cand = n * r; const judge = cand * j; const calls = cand + judge;
      const tokIn = cand * ti + judge * (ti + to + 400); const tokOut = cand * to + judge * 100;
      const cost = (tokIn * pi + tokOut * po) / 1e6;
      const minutes = calls / rpm; const workers = Math.ceil((calls / (minutes * 60)) * 6);
      const sePaired = Math.sqrt(d / (n)); const seUnpaired = Math.sqrt((2 * 0.7 * 0.3) / n);
      const data: [string, string][] = [
        ['Candidate calls per run', fmt(cand)],
        ['Judge calls per run', fmt(judge)],
        ['Tokens per run (in and out)', `${(tokIn / 1e6).toFixed(1)} M in, ${(tokOut / 1e6).toFixed(1)} M out`],
        ['Cost of one run', '$' + cost.toFixed(2)],
        ['Cost per month at this many runs', usd(cost * runs * 30)],
        ['Time of one run at the rate limit', minutes < 90 ? `${minutes.toFixed(1)} minutes` : `${(minutes / 60).toFixed(1)} hours`],
        ['Workers needed to keep the limit busy', fmt(workers)],
        ['Change detectable with paired cases (95%)', `±${(1.96 * sePaired * 100).toFixed(1)} points`],
        ['Same change if the two pass rates are compared separately', `±${(1.96 * seUnpaired * 100).toFixed(1)} points`],
        ['Cases needed to detect a 2-point change, paired', fmt(Math.ceil(((1.96 * Math.sqrt(d)) / 0.02) ** 2))],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
