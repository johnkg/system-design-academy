---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Does the gate catch a regression?" hint="A prompt change is compared with the baseline on a test set, 400 times over with different random cases. Change how the two versions are compared and how the gate decides, and see how often the wrong call is made.">
  <ol class="how">
    <li>Default: the new prompt is truly <b>2 points worse</b>, the test set has <b>100 cases</b>, and the gate is <b>naive</b> (ship if the new pass rate is not lower). It ships the regression in about <b>1 run in 4</b>, because noise at this size is bigger than the effect.</li>
    <li>Switch the rule to <b>confidence-interval gate</b> with separate pass rates: no regression ships, but nothing else can ship either, as the interval is far too wide. Switch to <b>paired</b>: the interval narrows to about a third, and a regression ships only rarely.</li>
    <li>Set the truth to <b>no real change</b> with the naive gate: it ships about <b>6 runs in 10</b>, a coin flip dressed as a decision. Raise the cases to 2,000 with the paired CI gate and nearly every harmless change ships, as the interval is now narrow enough to prove it.</li>
  </ol>
  <div class="pg evb" data-evb>
    <div class="pg-row">
      <label>The new prompt is really <select class="pg-in" data-truth>
        <option value="worse" selected>2 points worse</option>
        <option value="same">no different</option>
        <option value="better">2 points better</option>
      </select></label>
      <label>Cases in the test set <input type="range" min="100" max="2000" step="100" value="100" data-n /> <b data-nval></b></label>
      <label>Compare by <select class="pg-in" data-method>
        <option value="unpaired" selected>two separate pass rates</option>
        <option value="paired">paired, case by case</option>
      </select></label>
      <label>Gate rule <select class="pg-in" data-rule>
        <option value="naive" selected>naive: ship if the new pass rate is not lower</option>
        <option value="ci">interval: ship if the lower end is above minus 2 points</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Gate says ship</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Wrong calls</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Typical 95% interval</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: each case has a hardness, the baseline passes the easiest 70%, and the new prompt passes a case if hardness plus a random shift of up to 100 points (out of 1,000) is under its own threshold, so a hard case tends to be hard for both. Intervals use 1.96 standard errors, from the paired fixed and broken counts or from the two separate pass rates. A wrong call is shipping a worse prompt, or blocking a better one. Blocking a prompt that is no different costs only time, so it is not counted as wrong.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-evb]').forEach((root) => {
    const q = query(root);
    const TRIALS = 400;
    const SEED = 7;
    const PM = 1000; // case outcomes drawn per mille
    const BASE_PASS = 700; // the current prompt passes 70% of cases
    const NEW_PASS = { better: 720, worse: 680, same: 700 }; // the candidate's pass rate, per mille
    const NOISE = 200; // the candidate's draw sits within +-100 of the current one's (the outcomes are correlated)
    const Z95 = 1.96; // two-sided 95% normal quantile
    const MARGIN = 0.02; // a regression under 2 points is acceptable
    const WRONG_BAD = 0.05, WIDE_POINTS = 6, SAFE_SHIP = 0.8; // over 5% wrong decisions; interval over 6 points; under 80% shipped
    let pending = 0;
    function simulate(truth: string, n: number, method: string, rule: string) {
      // linear congruential generator (Numerical Recipes constants), integer in 0..m-1
      let seed = SEED; const rnd = (m: number) => { seed = (seed * 1664525 + 1013904223) % 4294967296; return Math.floor(seed / 65536) % m; };
      const thr = truth === 'better' ? NEW_PASS.better : truth === 'worse' ? NEW_PASS.worse : NEW_PASS.same;
      let ship = 0; let wrong = 0; let width = 0;
      for (let t = 0; t < TRIALS; t++) {
        let b = 0; let c = 0; let fixed = 0; let broken = 0;
        for (let i = 0; i < n; i++) {
          const u = rnd(PM); const x = u < BASE_PASS ? 1 : 0; const y = u + rnd(NOISE) - NOISE / 2 < thr ? 1 : 0;
          b += x; c += y; if (y > x) fixed++; if (x > y) broken++;
        }
        const diff = (c - b) / n; const p1 = b / n; const p2 = c / n;
        const se = method === 'paired' ? Math.sqrt(Math.max(fixed + broken - (fixed - broken) ** 2 / n, 0)) / n : Math.sqrt((p1 * (1 - p1) + p2 * (1 - p2)) / n);
        width += 2 * Z95 * se;
        const ok = rule === 'naive' ? diff >= 0 : diff - Z95 * se > -MARGIN;
        if (ok) ship++;
        if ((ok && truth === 'worse') || (!ok && truth === 'better')) wrong++;
      }
      return { ship, wrong, width: (width / TRIALS) * 100 };
    }
    function draw() {
      pending = 0;
      const truth = q<HTMLSelectElement>('[data-truth]').value; const n = Number(q<HTMLInputElement>('[data-n]').value);
      const method = q<HTMLSelectElement>('[data-method]').value; const rule = q<HTMLSelectElement>('[data-rule]').value;
      q('[data-nval]').textContent = String(n);
      const r = simulate(truth, n, method, rule);
      const pct = (x: number) => `${Math.round((x / TRIALS) * 100)}%`;
      q('[data-o1]').textContent = `${r.ship} of ${TRIALS}`; q('[data-n1]').textContent = `${pct(r.ship)} of the comparisons pass the gate`;
      q('[data-o2]').textContent = `${r.wrong} of ${TRIALS}`;
      q('[data-n2]').textContent = truth === 'worse' ? 'a worse prompt was shipped' : truth === 'better' ? 'a better prompt was blocked' : 'none possible, the prompts are equal';
      q('[data-o3]').textContent = `${r.width.toFixed(1)} points wide`; q('[data-n3]').textContent = `at ${n} cases, ${method === 'paired' ? 'paired' : 'separate pass rates'}`;
      q<HTMLElement>('[data-b1]').style.setProperty('--c', 'var(--accent)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', r.wrong > TRIALS * WRONG_BAD ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', r.width > WIDE_POINTS ? 'var(--bad)' : 'var(--accent)');
      const out = q('[data-verdict]'); const bad = r.wrong > TRIALS * WRONG_BAD; out.classList.toggle('bad', bad);
      if (truth === 'same') out.textContent = rule === 'naive' ? `The prompts are equal, yet ${pct(r.ship)} ship: a naive gate is a coin flip, and the team would believe it found a win or a loss. An interval gate ships only when it can show there is no meaningful regression.` : `The prompts are equal, and ${pct(r.ship)} ship. ${r.ship < TRIALS * SAFE_SHIP ? 'The interval is too wide to prove it is safe, so the gate blocks harmless changes. More cases or a paired comparison would fix that.' : 'The interval is narrow enough to show there is no regression of more than 2 points.'}`;
      else if (truth === 'worse') out.textContent = bad ? `A real 2-point regression shipped in ${r.wrong} of ${TRIALS} comparisons (${pct(r.wrong)}). The noise at ${n} cases (an interval ${r.width.toFixed(1)} points wide) is bigger than the effect, so the gate cannot see it.` : `A real 2-point regression shipped in only ${r.wrong} of ${TRIALS} comparisons (${pct(r.wrong)}). ${rule === 'ci' ? 'The gate needs the whole interval above minus 2 points, which a true minus 2 rarely reaches.' : 'At this size the naive gate sees the drop most of the time.'}`;
      else out.textContent = bad ? `A better prompt was blocked in ${r.wrong} of ${TRIALS} comparisons (${pct(r.wrong)}). The interval is ${r.width.toFixed(1)} points wide, so the gate cannot prove the gain is safe. More cases, or a paired comparison, narrow it.` : `A better prompt was blocked in only ${r.wrong} of ${TRIALS} comparisons. The interval is ${r.width.toFixed(1)} points wide, narrow enough to see a gain of 2 points.`;
    }
    function schedule() { if (pending) return; pending = requestAnimationFrame(draw); }
    root.addEventListener('input', schedule); root.addEventListener('change', schedule);
    draw();
  });
</script>
