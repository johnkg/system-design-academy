---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Every step of a workflow is several events, so the write rate and the storage are a multiple of the number of workflows. Long lives multiply the open workflows, and the history cap decides when to continue as new.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Workflows started per day (millions)" name="w" min="1" max="200" value="20" />
      <RangeField label="Activities per workflow" name="a" min="1" max="60" value="8" />
      <RangeField label="Average life of a workflow (hours)" name="l" min="1" max="2160" value="48" />
      <RangeField label="Peak rate compared with the average (times)" name="pk" min="1" max="10" value="3" />
      <RangeField label="Average event size (KB)" name="kb" min="0.5" max="10" step="0.5" value="1" />
      <RangeField label="Days a closed history is kept" name="ret" min="1" max="30" value="7" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each activity writes 6 events (activity scheduled, started and completed, and the three events of the decision task that follows), plus 2 for the start and the finish. One database node sustains about 5,000 event appends per second, data is stored on 3 replicas, the history cap is 51,200 events as in Temporal, and the number of shards is fixed at 16,384. Retries do not add events, and timers and signals add only a few more.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 9; // output lines below
    const MILLION = 1e6; const BYTES_PER_KB = 1000; const DAY_S = 86400; const DAY_H = 24;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmtBytes = (b: number) => (b >= 1e12 ? `${(b / 1e12).toFixed(1)} TB` : b >= 1e9 ? `${(b / 1e9).toFixed(1)} GB` : `${(b / 1e6).toFixed(1)} MB`);
    const EVENTS_PER_ACTIVITY = 6; const FIXED_EVENTS = 2; const NODE_APPENDS = 5000; const REPLICAS = 3; const CAP = 51200; const SHARDS = 16384;
    function draw() {
      const w = val('[data-w]') * MILLION; const acts = val('[data-a]'); const hours = val('[data-l]'); const peak = val('[data-pk]'); const kb = val('[data-kb]'); const ret = val('[data-ret]');
      ['w', 'a', 'l', 'pk', 'kb', 'ret'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const events = acts * EVENTS_PER_ACTIVITY + FIXED_EVENTS; const bytesPer = events * kb * BYTES_PER_KB;
      const appendsAvg = (w * events) / DAY_S; const appendsPeak = appendsAvg * peak; const nodes = Math.ceil(appendsPeak / NODE_APPENDS);
      const open = (w * hours) / DAY_H; const kept = w * (hours / DAY_H + ret); const store = kept * bytesPer * REPLICAS;
      const activityTasks = ((w * acts) / DAY_S) * peak; const maxActs = Math.floor((CAP - FIXED_EVENTS) / EVENTS_PER_ACTIVITY);
      const data: [string, string][] = [
        ['Events in one workflow history', `${fmt(events)} (${fmtBytes(bytesPer)})`],
        ['Event appends per second, average', fmt(appendsAvg)],
        ['Event appends per second, at the peak', fmt(appendsPeak)],
        ['Database nodes for the peak writes', fmt(nodes)],
        ['Activity tasks per second, at the peak', fmt(activityTasks)],
        ['Workflows open at one time (all waiting or running)', fmt(open)],
        ['Open workflows per shard', fmt(open / SHARDS)],
        [`Storage for open and kept histories, with ${REPLICAS} replicas`, fmtBytes(store)],
        [`Activities one run can do before the ${CAP.toLocaleString('en-US')}-event cap`, `${fmt(maxActs)}${acts >= maxActs ? ' (this workflow must continue as new)' : ''}`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
