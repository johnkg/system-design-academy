---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Storage for ids is modest, the read rate is large, and a single celebrity list is hundreds of thousands of times longer than an ordinary user's.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Users (millions)" name="u" min="10" max="3000" step="10" value="1000" />
      <RangeField label="Average people followed or friended" name="d" min="20" max="1000" step="10" value="200" />
      <RangeField label="Daily active users (%)" name="dau" min="5" max="80" value="40" />
      <RangeField label="Graph queries per active user per day" name="qd" min="5" max="200" step="5" value="50" />
      <RangeField label="Followers of the biggest celebrity (millions)" name="c" min="1" max="500" value="100" />
      <RangeField label="Read at most N entries of one list" name="cap" min="50" max="5000" step="50" value="500" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a follow is one directed edge stored twice, once in the follower's "following" list and once in the followed person's "followers" list. An entry is a 64-bit id, which is 8 bytes, with 30% extra for the index and framing, 3 copies of every shard, and 1 TB of data per machine. The peak is 3 times the daily average. A bitmap has one bit for every user.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 10; // output lines below
    const MILLION = 1e6; const DAY_S = 86400; const BITS_PER_BYTE = 8;
    const ID_BYTES = 8; const INDEX_OVERHEAD = 1.3; // one adjacency entry; index and page overhead
    const REPLICAS = 3; const MACHINE_BYTES = 1e12; // copies; storage per machine (1 TB)
    const PEAK_FACTOR = 3; // peak query rate over the daily average
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const bytes = (n: number) => (n >= 1e12 ? `${(n / 1e12).toFixed(1)} TB` : n >= 1e9 ? `${(n / 1e9).toFixed(1)} GB` : n >= 1e6 ? `${(n / 1e6).toFixed(1)} MB` : n >= 1e3 ? `${(n / 1e3).toFixed(1)} KB` : `${fmt(n)} B`);
    function draw() {
      const users = val('[data-u]') * MILLION; const deg = val('[data-d]'); const dau = val('[data-dau]') / 100; const qd = val('[data-qd]'); const celeb = val('[data-c]') * MILLION; const cap = val('[data-cap]');
      ['u', 'd', 'dau', 'qd', 'c', 'cap'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const edges = users * deg; const entries = edges * 2; const oneCopy = entries * ID_BYTES * INDEX_OVERHEAD; const machines = Math.ceil((oneCopy * REPLICAS) / MACHINE_BYTES);
      const peak = (users * dau * qd * PEAK_FACTOR) / DAY_S;
      const typical = deg * deg; const withCeleb = deg * deg + celeb; const capped = deg * Math.min(deg, cap) + Math.min(celeb, cap);
      const data: [string, string][] = [
        ['Follow edges', fmt(edges)],
        ['Adjacency entries (both directions)', fmt(entries)],
        ['Storage for one copy', bytes(oneCopy)],
        [`Machines with ${REPLICAS} copies`, fmt(machines)],
        ['Peak graph queries per second', fmt(peak)],
        ['Biggest celebrity list', bytes(celeb * ID_BYTES)],
        ['Entries read to suggest friends of friends (ordinary)', fmt(typical)],
        ['Same, if one followed person is the biggest celebrity', fmt(withCeleb)],
        ['Same, with the limit on every list', fmt(capped)],
        ['A bitmap over all users, per list', bytes(users / BITS_PER_BYTE)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
