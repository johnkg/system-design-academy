---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How long a waiting page takes to clear a crowd, how many workers a slow dependency can freeze, how rare it is for many workers to meet at one resource, and how long it takes to move pods. A teaching model with round numbers, not Shopify's system or data.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Buyers sent to the waiting page (thousands)" name="b" min="1" max="100" value="20" />
      <RangeField label="Buyers let through per 5-second period" name="l" min="100" max="5000" step="100" value="500" />
      <RangeField label="Requests per second to a slow dependency, per server" name="r" min="5" max="200" step="5" value="50" />
      <RangeField label="Timeout of that dependency (seconds)" name="t" min="1" max="30" value="10" />
      <RangeField label="Workers on one server" name="w" min="4" max="64" step="2" value="16" />
      <RangeField label="Share of time one worker uses a resource (%)" name="s" min="5" max="50" step="5" value="10" />
      <RangeField label="Most workers allowed at once (Semian-style limit)" name="c" min="1" max="10" value="5" />
      <RangeField label="Active pods in one data center" name="p" min="1" max="100" value="20" />
      <RangeField label="Minutes to move one pod" name="m" min="1" max="10" value="1" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: these are teaching numbers you can change, not Shopify's. Shopify's 2017 post gives a 5-second period for its checkout throttle and says the limit is whatever load the app can handle; a sale that it says lasted 40 minutes is used for comparison. The chance of several workers meeting is the share of time to the power of the number of workers, as in Shopify's 2015 example (10% of the time, five at once, 0.001%), and assumes workers act independently. Workers stuck on a slow dependency are requests per second times the timeout, capped at the workers a server has (Little's law, a queue rule that says the number waiting equals the arrival rate times the wait). Shopify says its Pod Mover can move one pod in about a minute, and that evacuating a data center means moving each active pod one at a time; here that is simply pods times minutes per pod.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const PERIOD_S = 5; // length of the leaky bucket period (Shopify, 2017)
    const SALE_MIN = 40; // length of the sale Shopify describes (2017)
    const S_PER_MIN = 60;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    const small = (n: number) => n.toLocaleString('en-US', { maximumSignificantDigits: 2 });
    function draw() {
      const buyers = val('[data-b]') * 1000; const limit = val('[data-l]'); const rps = val('[data-r]'); const timeout = val('[data-t]');
      const workers = val('[data-w]'); const share = val('[data-s]') / 100; const cap = val('[data-c]'); const pods = val('[data-p]'); const move = val('[data-m]');
      ['b', 'l', 'r', 't', 'w', 's', 'c', 'p', 'm'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const periods = Math.ceil(buyers / limit);
      const clearMin = (periods * PERIOD_S) / S_PER_MIN;
      const stuck = Math.min(workers, rps * timeout);
      const guarded = Math.min(stuck, cap);
      const chance = 100 * Math.pow(share, cap);
      const data: [string, string][] = [
        ['Buyers let through per second', fmt(limit / PERIOD_S)],
        ['Time for the last buyer to get in (minutes)', fmt(clearMin)],
        [`That time as a share of a ${SALE_MIN} minute sale (%)`, `${fmt((100 * clearMin) / SALE_MIN)}%`],
        ['Workers stuck waiting on the slow dependency, no guard', `${fmt(stuck)} of ${workers}`],
        ['Share of the server stuck, no guard (%)', `${fmt((100 * stuck) / workers)}%`],
        [`Workers stuck with a limit of ${cap}`, `${fmt(guarded)} of ${workers}`],
        ['Workers left free with the limit', fmt(workers - guarded)],
        [`Chance that ${cap} given workers use the resource at once (%)`, `${small(chance)}%`],
        [`Time to evacuate ${pods} pods, one at a time (minutes)`, fmt(pods * move)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
