---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Series count and scrape interval set the write rate, compression sets the disk, and every series costs a few kilobytes of memory for as long as it is alive.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Active series (millions) <input type="range" min="1" max="100" value="10" data-s /> <b data-sval></b></label>
      <label>Scrape interval (seconds) <input type="range" min="5" max="60" step="5" value="15" data-i /> <b data-ival></b></label>
      <label>Compressed bytes per point <input type="range" min="1" max="16" step="0.5" value="1.5" data-b /> <b data-bval></b></label>
      <label>Raw data kept (days) <input type="range" min="1" max="90" value="15" data-raw /> <b data-rawval></b></label>
      <label>5-minute rollups kept (days) <input type="range" min="0" max="730" step="10" value="400" data-ru /> <b data-ruval></b></label>
      <label>Copies of every series <input type="range" min="1" max="3" value="2" data-rf /> <b data-rfval></b></label>
      <label>RAM per node (GB) <input type="range" min="16" max="256" step="16" value="64" data-ram /> <b data-ramval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a series costs about 3 KB of memory while it is active (name and labels, index entries, bookkeeping), the in-memory head holds about 3 hours of points, a rollup keeps 4 numbers (min, max, sum, count) per 5 minutes, one node ingests about 500,000 points per second, and only half of the RAM may be used for series so that queries and compaction have room.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 11 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const size = (b: number) => (b >= 1e12 ? `${(b / 1e12).toFixed(1)} TB` : b >= 1e9 ? `${(b / 1e9).toFixed(1)} GB` : `${(b / 1e6).toFixed(1)} MB`);
    function draw() {
      const series = val('[data-s]') * 1e6; const interval = val('[data-i]'); const bpp = val('[data-b]'); const rawDays = val('[data-raw]'); const ruDays = val('[data-ru]'); const rf = val('[data-rf]'); const ram = val('[data-ram]');
      ['s', 'i', 'b', 'raw', 'ru', 'rf', 'ram'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perSec = series / interval; const perDay = perSec * 86400;
      const rawDisk = perDay * bpp * rawDays; const ruDisk = series * 288 * 4 * bpp * ruDays;
      const mem = series * 3000 + series * ((3 * 3600) / interval) * bpp;
      const byIngest = Math.ceil(perSec / 500000); const byMem = Math.ceil(mem / (ram * 1e9 * 0.5)); const shards = Math.max(byIngest, byMem);
      const data: [string, string][] = [
        ['Points written per second', fmt(perSec)],
        ['Points per day', `${(perDay / 1e9).toFixed(1)} billion`],
        ['Raw data per day (one copy)', size(perDay * bpp)],
        ['Raw data kept (one copy)', size(rawDisk)],
        ['Rollups kept (one copy)', size(ruDisk)],
        ['Disk for all copies', size((rawDisk + ruDisk) * rf)],
        ['Memory for series and the head (one copy)', size(mem)],
        ['Shards needed for ingest', fmt(byIngest)],
        ['Shards needed for memory', fmt(byMem)],
        ['Shards to run', fmt(shards)],
        ['Machines including copies', fmt(shards * rf)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
