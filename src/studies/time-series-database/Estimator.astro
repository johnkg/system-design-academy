---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Series count and scrape interval set the write rate, compression sets the disk, and every series costs a few kilobytes of memory for as long as it is alive.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Active series (millions)" name="s" min="1" max="100" value="10" />
      <RangeField label="Scrape interval (seconds)" name="i" min="5" max="60" step="5" value="15" />
      <RangeField label="Compressed bytes per point" name="b" min="1" max="16" step="0.5" value="1.5" />
      <RangeField label="Raw data kept (days)" name="raw" min="1" max="90" value="15" />
      <RangeField label="5-minute rollups kept (days)" name="ru" min="0" max="730" step="10" value="400" />
      <RangeField label="Copies of every series" name="rf" min="1" max="3" value="2" />
      <RangeField label="RAM per node (GB)" name="ram" min="16" max="256" step="16" value="64" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a series costs about 3 KB of memory while it is active (name and labels, index entries, bookkeeping), the in-memory head holds about 3 hours of points, a rollup keeps 4 numbers (min, max, sum, count) per 5 minutes, one node ingests about 500,000 points per second, and only half of the RAM may be used for series so that queries and compaction have room.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 11; // lines in the result list
    const MILLION = 1e6, BILLION = 1e9, GB = 1e9, DAY_S = 86400, HOUR_S = 3600;
    const ROLLUP = { perDay: 288, values: 4 }; // 5-minute rollups (288 a day) keeping min, max, sum and count
    const SERIES_BYTES = 3000; // index and labels per series in memory
    const HEAD_HOURS = 3; // recent points kept in memory before they are flushed
    const SHARD = { pointsS: 500000, ramShare: 0.5 }; // a shard ingests 500k points/s and may use half its RAM
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const size = (b: number) => (b >= 1e12 ? `${(b / 1e12).toFixed(1)} TB` : b >= 1e9 ? `${(b / 1e9).toFixed(1)} GB` : `${(b / 1e6).toFixed(1)} MB`);
    function draw() {
      const series = val('[data-s]') * MILLION; const interval = val('[data-i]'); const bpp = val('[data-b]'); const rawDays = val('[data-raw]'); const ruDays = val('[data-ru]'); const rf = val('[data-rf]'); const ram = val('[data-ram]');
      ['s', 'i', 'b', 'raw', 'ru', 'rf', 'ram'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perSec = series / interval; const perDay = perSec * DAY_S;
      const rawDisk = perDay * bpp * rawDays; const ruDisk = series * ROLLUP.perDay * ROLLUP.values * bpp * ruDays;
      const mem = series * SERIES_BYTES + series * ((HEAD_HOURS * HOUR_S) / interval) * bpp;
      const byIngest = Math.ceil(perSec / SHARD.pointsS); const byMem = Math.ceil(mem / (ram * GB * SHARD.ramShare)); const shards = Math.max(byIngest, byMem);
      const data: [string, string][] = [
        ['Points written per second', fmt(perSec)],
        ['Points per day', `${(perDay / BILLION).toFixed(1)} billion`],
        ['Raw data per day (one copy)', size(perDay * bpp)],
        ['Raw data kept (one copy)', size(rawDisk)],
        ['Rollups kept (one copy)', size(ruDisk)],
        ['Disk for all copies', size((rawDisk + ruDisk) * rf)],
        ['Memory for series and the head (one copy)', size(mem)],
        ['Shards needed for ingest', fmt(byIngest)],
        ['Shards needed for memory', fmt(byMem)],
        ['Shards to run', fmt(shards)],
        ['Machines including copies', fmt(shards * rf)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
