---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Logout: who is still signed in?" hint="A user logs out of the identity provider. Eight apps each hold a session or token that is still valid. How the logout reaches them decides how long the user, or a thief with the session, keeps access. Each setting is tested on 8,000 app sessions.">
  <ol class="how">
    <li>The default is <b>back-channel logout with no retries</b>, 20% of apps unreachable at that moment, and 15-minute tokens: <b>1,470 of 8,000</b> sessions (18%) are still open a minute later, because a failed message is never sent again.</li>
    <li>Raise the retries to <b>3</b>: only <b>16 of 8,000</b> (0.2%) are still open a minute later, and the average falls from 89 seconds to 1.</li>
    <li>Switch to <b>nothing</b> (apps never told): <b>7,460</b> (93%) stay open until their token expires. <b>Front-channel</b> (the browser tells each app) leaves <b>2,244</b> (28%), since the browser may close or block it.</li>
  </ol>
  <div class="pg ipb" data-ipb>
    <div class="pg-row">
      <label>How apps learn about the logout <select class="pg-in" data-m>
        <option value="none">Nothing: tokens just expire</option>
        <option value="front">Front-channel: the browser tells each app</option>
        <option value="back" selected>Back-channel: the provider tells each app</option>
      </select></label>
      <label>Retries of a failed message <input type="range" min="0" max="5" value="0" data-r /> <b data-rval></b></label>
      <label>Apps unreachable at that moment (%) <input type="range" min="0" max="60" step="5" value="20" data-d /> <b data-dval></b></label>
      <label>Token or app session lifetime <select class="pg-in" data-l>
        <option value="300">5 minutes</option>
        <option value="900" selected>15 minutes</option>
        <option value="3600">1 hour</option>
        <option value="28800">8 hours</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Still signed in after 1 minute</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Average time still signed in</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Slowest 1% of sessions</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: each of 8,000 app sessions has a random amount of lifetime left. Front-channel reaches an app 70% of the time (the browser closed or blocked the hidden page). Back-channel tries at 0, 1, 3, 7, 15 and 31 seconds, and each try fails with the chance set above; a message that gets through ends the session at that moment. An app that is never told keeps the session until its time runs out.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-ipb]').forEach((root) => {
    const q = query(root);
    const DELAY = [0, 1, 3, 7, 15, 31]; const N = 8000;
    const SEED = 4242; const FRONT_OK = 0.7; // front-channel logout reaches the app 70% of the time
    const GRACE_S = 60; // a session still usable this long after logout counts as open
    const P99 = 0.99; const OPEN_LIMIT_PCT = 1; // more than 1% open sessions is a failure
    const fmtT = (s: number) => (s < 120 ? `${Math.round(s)} s` : s < 7200 ? `${(s / 60).toFixed(1)} min` : `${(s / 3600).toFixed(1)} h`);
    const cache = new Map<string, { open: number; avg: number; p99: number }>();
    function sim(method: string, retries: number, downPct: number, life: number) {
      const key = [method, retries, downPct, life].join('/');
      const hit = cache.get(key); if (hit) return hit;
      let seed = SEED; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
      const ex: number[] = [];
      for (let i = 0; i < N; i++) {
        const left = Math.floor(rnd() * life); let e = left;
        if (method === 'front') { if (rnd() < FRONT_OK) e = 0; }
        else if (method === 'back') { for (let k = 0; k <= retries; k++) { if (rnd() >= downPct / 100) { e = Math.min(left, DELAY[k]); break; } } }
        ex.push(e);
      }
      ex.sort((a, b) => a - b);
      const res = { open: ex.filter((v) => v > GRACE_S).length, avg: ex.reduce((a, b) => a + b, 0) / N, p99: ex[Math.floor(N * P99)] };
      cache.set(key, res); return res;
    }
    function draw() {
      const method = q<HTMLSelectElement>('[data-m]').value; const retries = Number(q<HTMLInputElement>('[data-r]').value);
      const down = Number(q<HTMLInputElement>('[data-d]').value); const life = Number(q<HTMLSelectElement>('[data-l]').value);
      q('[data-rval]').textContent = String(retries); q('[data-dval]').textContent = String(down);
      q<HTMLInputElement>('[data-r]').disabled = method !== 'back'; q<HTMLInputElement>('[data-d]').disabled = method !== 'back';
      const r = sim(method, retries, down, life); const pct = (r.open * 100) / N;
      q('[data-o1]').textContent = `${r.open.toLocaleString('en-US')} of ${N.toLocaleString('en-US')}`; q('[data-n1]').textContent = `${pct.toFixed(1)}% of app sessions`;
      q('[data-o2]').textContent = fmtT(r.avg); q('[data-n2]').textContent = 'between the logout and the end of access';
      q('[data-o3]').textContent = fmtT(r.p99); q('[data-n3]').textContent = `the worst sessions, ${(N / 100).toLocaleString('en-US')} of ${N.toLocaleString('en-US')}`;
      q<HTMLElement>('[data-b1]').style.setProperty('--c', pct < OPEN_LIMIT_PCT ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', 'var(--accent)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', r.p99 > GRACE_S ? 'var(--bad)' : 'var(--good)');
      const out = q('[data-verdict]'); const bad = pct >= OPEN_LIMIT_PCT; out.classList.toggle('bad', bad);
      out.textContent = !bad ? `Logout is effective: ${r.open} of ${N.toLocaleString('en-US')} sessions outlive it by more than a minute. Messages that fail are retried at growing intervals, so an app that comes back soon still hears about it.`
        : method === 'none' ? `Apps are never told, so ${pct.toFixed(0)}% of sessions stay usable until their ${fmtT(life)} lifetime runs out. A thief with a copied token is not stopped by logging out.`
        : method === 'front' ? `The browser can only reach apps while it stays open and lets the hidden pages load, so ${pct.toFixed(0)}% of sessions survive. Server-to-server messages do not depend on the browser.`
        : `${pct.toFixed(1)}% of sessions are still open after a minute: an app that is still unreachable ${retries === 0 ? 'when the single attempt is made' : retries === 1 ? 'after its one retry' : `after its last of ${retries} retries`} is never told, and keeps its session for up to ${fmtT(life)}.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
