---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Signing and refreshing tokens is the real load. Verifying a token in the app costs the identity provider nothing, which is why tokens exist.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Users (millions) <input type="range" min="1" max="200" value="20" data-u /> <b data-uval></b></label>
      <label>Sign-ins per user per day <input type="range" min="1" max="6" value="2" data-l /> <b data-lval></b></label>
      <label>Apps used per sign-in <input type="range" min="1" max="15" value="5" data-a /> <b data-aval></b></label>
      <label>Token lifetime (minutes) <input type="range" min="1" max="60" value="10" data-t /> <b data-tval></b></label>
      <label>Users signed in at the peak (%) <input type="range" min="5" max="60" step="5" value="25" data-s /> <b data-sval></b></label>
      <label>API calls per signed-in user per minute <input type="range" min="1" max="30" value="6" data-r /> <b data-rval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: 30% of the day's sign-ins fall in the busiest hour, each app visit needs one new token, every open app renews its token once per lifetime, one CPU core signs about 1,500 RS256 tokens per second (an elliptic-curve key is roughly ten times cheaper), a session record takes 1 KB, and 30% of sessions end with an explicit logout that is sent to every app that was used.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const users = val('[data-u]') * 1e6; const perDay = val('[data-l]'); const apps = val('[data-a]'); const life = val('[data-t]'); const share = val('[data-s]') / 100; const calls = val('[data-r]');
      ['u', 'l', 'a', 't', 's', 'r'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const signIns = (users * perDay * 0.3) / 3600; const active = users * share;
      const refresh = (active * apps) / (life * 60); const signed = signIns * apps + refresh;
      const data: [string, string][] = [
        ['Sign-ins per second at the peak', fmt(signIns)],
        ['Users signed in at the peak', fmt(active)],
        ['Token renewals per second', fmt(refresh)],
        ['Tokens signed per second', fmt(signed)],
        ['CPU cores for signing (RS256)', fmt(Math.ceil(signed / 1500))],
        ['Session store size', `${(active * 1000 / 1e9).toFixed(1)} GB`],
        ['Logout messages per second at the peak', fmt(signIns * 0.3 * apps)],
        ['Calls per second to the provider if every API call were checked with it', fmt((active * calls) / 60)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
