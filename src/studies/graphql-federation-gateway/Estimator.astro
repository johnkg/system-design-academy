---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Without batching, the calls to the services grow with the size of the answer. With batching they grow only with the depth of the query.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Queries per second at the peak" name="rps" min="100" max="20000" step="100" value="2000" />
      <RangeField label="Items in each list" name="f" min="2" max="50" value="10" />
      <RangeField label="Entity hops after the first fetch" name="h" min="1" max="4" value="2" />
      <RangeField label="Latency of one service call (ms)" name="lat" min="5" max="100" step="5" value="20" />
      <RangeField label="Cost budget per query (objects)" name="bud" min="100" max="50000" step="100" value="2000" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: every object has the same number of children at every level, so a query with H hops touches f + f&sup2; + &hellip; + f^(H+1) objects. Without batching there is one call for each parent object, and the router runs at most 10 calls of a level at the same time. With batching there is one call per level. Network time is the call latency, and the work inside the services is ignored.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 9; // output lines below
    const PARALLEL_CALLS = 10; // calls the gateway runs at once without batching
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const rps = val('[data-rps]'); const f = val('[data-f]'); const h = val('[data-h]'); const lat = val('[data-lat]'); const bud = val('[data-bud]');
      ['rps', 'f', 'h', 'lat', 'bud'].forEach((k) => (q(`[data-${k}val]`).textContent = fmt(val(`[data-${k}]`))));
      let objects = 0; let naive = 1; let rounds = 1;
      for (let i = 1; i <= h + 1; i++) objects += f ** i;
      for (let i = 1; i <= h; i++) { naive += f ** i; rounds += Math.ceil(f ** i / PARALLEL_CALLS); }
      const batched = 1 + h;
      const data: [string, string][] = [
        ['Objects in the answer', fmt(objects)],
        ['Cost guard with this budget', objects <= bud ? 'accepted' : 'rejected, before any service is called'],
        ['Service calls per query without batching', fmt(naive)],
        ['Service calls per query with batching', fmt(batched)],
        ['Service calls per second without batching', fmt(naive * rps)],
        ['Service calls per second with batching', fmt(batched * rps)],
        [`Network time without batching (${PARALLEL_CALLS} calls at a time)`, `${fmt(rounds * lat)} ms`],
        ['Network time with batching', `${fmt(batched * lat)} ms`],
        ['Calls saved by batching', `${fmt(((naive - batched) * 100) / naive)} %`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
