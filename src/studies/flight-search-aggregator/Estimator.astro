---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Every search multiplies into provider calls, and only a tiny share of searches end in a booking. The cache hit rate and the deadline decide most of the load.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Searches per second at the peak" name="s" min="500" max="20000" step="500" value="5000" />
      <RangeField label="Providers asked per search" name="n" min="5" max="100" step="5" value="40" />
      <RangeField label="Fare cache hit rate (%)" name="h" min="0" max="99" value="80" />
      <RangeField label="Searches per booking" name="l" min="100" max="5000" step="100" value="1000" />
      <RangeField label="Global deadline (s)" name="d" min="2" max="20" value="8" />
      <RangeField label="Size of one provider answer (KB)" name="k" min="5" max="200" step="5" value="20" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a live provider call takes 2 s on average, a search stays open until its deadline in the worst case, a cached answer costs no provider call, and each provider allows 300 calls per second under its contract. Calls are spread evenly over the providers; real traffic is not, so the busiest provider sees more.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const AVG_CALL_S = 2; // average time a live provider call is open
    const LIMIT = 300; // calls per second each provider allows
    const KB = 1000, MB = 1e6;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const s = val('[data-s]'); const n = val('[data-n]'); const hit = val('[data-h]') / 100; const l2b = val('[data-l]'); const deadline = val('[data-d]'); const size = val('[data-k]') * KB;
      ['s', 'n', 'h', 'l', 'd', 'k'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const raw = s * n; // provider calls per second with no cache
      const live = raw * (1 - hit);
      const bookings = s / l2b;
      const data: [string, string][] = [
        ['Provider calls per second with no cache', fmt(raw)],
        ['Provider calls per second with the cache', fmt(live)],
        ['Calls per second for each provider, on average', fmt(live / n)],
        ['Bookings per second at the peak', fmt(bookings)],
        ['Live provider calls per booking', fmt(live / bookings)],
        ['Searches open at once, at most (searches x deadline)', fmt(s * deadline)],
        ['Provider calls in flight (calls x 2 s)', fmt(live * AVG_CALL_S)],
        ['Data arriving from providers', `${fmt((live * size) / MB)} MB/s`],
        [`Cache hit rate that keeps each provider under ${LIMIT} calls/s`, `${fmt(Math.max(0, 100 * (1 - LIMIT / s)))}%`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
