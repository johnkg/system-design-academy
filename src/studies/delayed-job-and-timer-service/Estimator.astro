---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The number of waiting timers comes from the rate and the delay, and the number of timers in memory comes only from how far ahead you load.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>New timers per day (millions) <input type="range" min="10" max="5000" step="10" value="500" data-n /> <b data-nval></b></label>
      <label>Average delay (hours) <input type="range" min="1" max="72" value="6" data-d /> <b data-dval></b></label>
      <label>Cancelled before firing (%) <input type="range" min="0" max="50" value="10" data-c /> <b data-cval></b></label>
      <label>Peak compared to average <input type="range" min="1" max="10" value="3" data-pk /> <b data-pkval></b></label>
      <label>Bucket width (seconds) <select class="pg-in" data-bw><option value="1">1</option><option value="10" selected>10</option><option value="60">60</option></select></label>
      <label>Load ahead (minutes) <input type="range" min="1" max="30" value="5" data-h /> <b data-hval></b></label>
      <label>Timer nodes <input type="range" min="1" max="256" value="16" data-s /> <b data-sval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a stored timer takes 500 bytes of payload and about 100 bytes of key and index, and is kept on 3 copies. A wheel entry takes about 100 bytes in memory. A wheel has 64 slots per level and a 10 ms tick. Cancelled timers are removed from the store when they are cancelled, but are counted as waiting for the average delay. Each fired timer costs two row writes in the store (the claim and the delete), and each new timer one. The peak applies to creation and to firing. Average rates are spread evenly over the day.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement | HTMLSelectElement>(s).value);
    const N_ROWS = 10; // output lines below
    const MILLION = 1e6; const MB = 1e6; const GB = 1e9; const HOUR_S = 3600; const DAY_S = 86400; const S_PER_MIN = 60;
    const ROW_BYTES = 600; const REPLICAS = 3; // stored timer row; copies kept
    const WHEEL_ENTRY_BYTES = 100; // one timer held in an in-memory wheel
    const TICKS_PER_S = 100; const WHEEL_SLOTS = 64; // 10 ms wheel tick; slots per wheel level
    const WRITES_PER_FIRE = 2; // a fired timer is updated, then removed
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const n = val('[data-n]') * MILLION; const delayS = val('[data-d]') * HOUR_S; const cancel = val('[data-c]') / 100; const peak = val('[data-pk]');
      const bw = val('[data-bw]'); const hMin = val('[data-h]'); const shards = val('[data-s]');
      ['n', 'd', 'c', 'pk', 'h', 's'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const createAvg = n / DAY_S; const createPeak = createAvg * peak;
      const waiting = createAvg * delayS; const storageGb = (waiting * ROW_BYTES * REPLICAS) / GB;
      const fireAvg = createAvg * (1 - cancel); const firePeak = fireAvg * peak;
      const perBucket = fireAvg * bw; const held = fireAvg * hMin * S_PER_MIN; const wheelMbPerNode = (held / shards) * WHEEL_ENTRY_BYTES / MB;
      const ticks = hMin * S_PER_MIN * TICKS_PER_S; let levels = 1; while (Math.pow(WHEEL_SLOTS, levels) < ticks) levels++;
      const writes = createPeak + WRITES_PER_FIRE * firePeak;
      const data: [string, string][] = [
        ['New timers per second, average', fmt(createAvg)],
        ['New timers per second, peak', fmt(createPeak)],
        ['Timers waiting at any moment (rate times delay)', fmt(waiting)],
        [`Storage for waiting timers, ${REPLICAS} copies`, `${fmt(storageGb)} GB`],
        ['Timers fired per second, peak', fmt(firePeak)],
        ['Timers in one average bucket', fmt(perBucket)],
        ['Timers held in wheels at any moment', fmt(held)],
        ['Wheel memory per node', `${wheelMbPerNode < 10 ? wheelMbPerNode.toFixed(1) : fmt(wheelMbPerNode)} MB`],
        ['Wheel levels to cover the load-ahead', fmt(levels)],
        ['Store row writes per second at the peak, per node', fmt(writes / shards)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
