---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Couriers are the expensive part, and courier time per order is what batching and good timing buy back. Pings and menu reads are cheap per item but huge in number.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Orders per day (millions) <input type="range" min="0.2" max="10" step="0.2" value="2" data-d /> <b data-dval></b></label>
      <label>Share of the day's orders in the peak hour (%) <input type="range" min="6" max="25" value="12" data-s /> <b data-sval></b></label>
      <label>Courier minutes per single order <input type="range" min="15" max="40" value="25" data-m /> <b data-mval></b></label>
      <label>Orders carried two at a time (%) <input type="range" min="0" max="60" step="5" value="30" data-b /> <b data-bval></b></label>
      <label>Courier time actually moving or handing over (%) <input type="range" min="40" max="90" step="5" value="70" data-u /> <b data-uval></b></label>
      <label>Menu views per order <input type="range" min="5" max="60" step="5" value="20" data-v /> <b data-vval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a courier minute per order covers the trip to the restaurant, the wait, the ride and the hand-over, and a paired order costs 20% less courier time than a single one. A courier app reports its position every 5 seconds, an order makes about 6 state changes, an order is open for about 35 minutes, and the ETA of an open order is recomputed every 30 seconds.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const OUT_ROWS = 9; // lines in the result list
    const MILLION = 1e6, HOUR_S = 3600, MIN_PER_H = 60, SEC_PER_MIN = 60;
    const PAIRING_SAVING = 0.2; // a paired order needs 20% fewer courier minutes
    const ORDER_OPEN_MIN = 35; // an order is open for about 35 minutes
    const STATES_PER_ORDER = 6, ETA_EVERY_S = 30, POSITION_EVERY_S = 5;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const day = val('[data-d]') * MILLION; const share = val('[data-s]') / 100; const m = val('[data-m]'); const batch = val('[data-b]') / 100; const util = val('[data-u]') / 100; const views = val('[data-v]');
      ['d', 's', 'm', 'b', 'u', 'v'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const peakHour = day * share; const perSec = peakHour / HOUR_S;
      const eff = m * (1 - PAIRING_SAVING * batch); // average courier minutes per order, with pairing
      const couriers = (peakHour * eff) / MIN_PER_H / util;
      const noBatch = (peakHour * m) / MIN_PER_H / util;
      const concurrent = perSec * ORDER_OPEN_MIN * SEC_PER_MIN;
      const data: [string, string][] = [
        ['Orders in the peak hour', fmt(peakHour)],
        ['Orders per second at the peak', perSec.toFixed(1)],
        [`State changes per second (${STATES_PER_ORDER} per order)`, fmt(perSec * STATES_PER_ORDER)],
        ['Menu reads per second', fmt(perSec * views)],
        ['Open orders at once', fmt(concurrent)],
        [`ETA recomputations per second (every ${ETA_EVERY_S} s)`, fmt(concurrent / ETA_EVERY_S)],
        ['Couriers needed on shift in the peak hour', fmt(couriers)],
        ['Couriers needed with no pairing at all', `${fmt(noBatch)} (pairing saves ${fmt(noBatch - couriers)})`],
        [`Courier position updates per second (every ${POSITION_EVERY_S} s)`, fmt(couriers / POSITION_EVERY_S)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
