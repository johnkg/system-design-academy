---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Metadata is small compared with the data it describes. What grows fast is the number of run events, and the size of the search and lineage indexes once you go down to columns.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Tables and dashboards (thousands)" name="a" min="10" max="1000" step="10" value="100" />
      <RangeField label="Columns per table" name="c" min="5" max="100" step="5" value="30" />
      <RangeField label="Scheduled jobs (thousands)" name="j" min="1" max="100" value="20" />
      <RangeField label="Runs per job per day" name="r" min="1" max="24" value="4" />
      <RangeField label="Tables read by one job" name="i" min="1" max="10" value="3" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a run sends 2 events (start and complete), a job writes 2 tables, the busiest hour carries 10 times the average event rate, a table edge has about 8 column edges under it, an edge takes 200 bytes, a column record 300 bytes, a search document 500 bytes, and a metadata crawl reads 200 assets per second per connector worker.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 9; // one per output line
    const THOUSAND = 1e3; const DAY_S = 86400; const SEC_PER_MIN = 60;
    const EVENTS_PER_RUN = 2; // start and complete
    const PEAK_X = 10; // busiest hour vs the daily average
    const EDGES_PER_INPUT = 2; const COLS_PER_EDGE = 8; // lineage edges per job input; column edges per table edge
    const BYTES = { column: 300, edge: 200, doc: 500 }; // per column record, lineage edge, search document
    const CRAWL_PER_S = 200; // assets one crawler worker reads per second
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const size = (bytes: number) => (bytes >= 1e9 ? `${(bytes / 1e9).toFixed(1)} GB` : `${(bytes / 1e6).toFixed(0)} MB`);
    function draw() {
      const assets = val('[data-a]') * THOUSAND; const cols = val('[data-c]'); const jobs = val('[data-j]') * THOUSAND; const runs = val('[data-r]'); const ins = val('[data-i]');
      ['a', 'c', 'j', 'r', 'i'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const events = jobs * runs * EVENTS_PER_RUN; const avg = events / DAY_S; const peak = avg * PEAK_X;
      const tableEdges = jobs * ins * EDGES_PER_INPUT; const colEdges = tableEdges * COLS_PER_EDGE;
      const colRecords = assets * cols;
      const meta = colRecords * BYTES.column; const graph = (tableEdges + colEdges) * BYTES.edge; const index = (assets + colRecords) * BYTES.doc;
      const crawl = assets / CRAWL_PER_S / SEC_PER_MIN;
      const data: [string, string][] = [
        ['Run events per day', fmt(events)],
        ['Run events per second, average and in the busiest hour', `${avg.toFixed(1)} and ${peak.toFixed(1)}`],
        ['Table-level lineage edges', fmt(tableEdges)],
        ['Column-level lineage edges', fmt(colEdges)],
        ['Column records', fmt(colRecords)],
        ['Metadata store (columns)', size(meta)],
        ['Lineage graph, table and column edges', size(graph)],
        ['Search index (assets plus columns)', size(index)],
        ['Full crawl of every asset with one worker, in minutes', fmt(crawl)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
