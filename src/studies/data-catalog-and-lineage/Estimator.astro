---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Metadata is small compared with the data it describes. What grows fast is the number of run events, and the size of the search and lineage indexes once you go down to columns.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Tables and dashboards (thousands) <input type="range" min="10" max="1000" step="10" value="100" data-a /> <b data-aval></b></label>
      <label>Columns per table <input type="range" min="5" max="100" step="5" value="30" data-c /> <b data-cval></b></label>
      <label>Scheduled jobs (thousands) <input type="range" min="1" max="100" value="20" data-j /> <b data-jval></b></label>
      <label>Runs per job per day <input type="range" min="1" max="24" value="4" data-r /> <b data-rval></b></label>
      <label>Tables read by one job <input type="range" min="1" max="10" value="3" data-i /> <b data-ival></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a run sends 2 events (start and complete), a job writes 2 tables, the busiest hour carries 10 times the average event rate, a table edge has about 8 column edges under it, an edge takes 200 bytes, a column record 300 bytes, a search document 500 bytes, and a metadata crawl reads 200 assets per second per connector worker.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const size = (bytes: number) => (bytes >= 1e9 ? `${(bytes / 1e9).toFixed(1)} GB` : `${(bytes / 1e6).toFixed(0)} MB`);
    function draw() {
      const assets = val('[data-a]') * 1e3; const cols = val('[data-c]'); const jobs = val('[data-j]') * 1e3; const runs = val('[data-r]'); const ins = val('[data-i]');
      ['a', 'c', 'j', 'r', 'i'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const events = jobs * runs * 2; const avg = events / 86400; const peak = avg * 10;
      const tableEdges = jobs * ins * 2; const colEdges = tableEdges * 8;
      const colRecords = assets * cols;
      const meta = colRecords * 300; const graph = (tableEdges + colEdges) * 200; const index = (assets + colRecords) * 500;
      const crawl = assets / 200 / 60;
      const data: [string, string][] = [
        ['Run events per day', fmt(events)],
        ['Run events per second, average and in the busiest hour', `${avg.toFixed(1)} and ${peak.toFixed(1)}`],
        ['Table-level lineage edges', fmt(tableEdges)],
        ['Column-level lineage edges', fmt(colEdges)],
        ['Column records', fmt(colRecords)],
        ['Metadata store (columns)', size(meta)],
        ['Lineage graph, table and column edges', size(graph)],
        ['Search index (assets plus columns)', size(index)],
        ['Full crawl of every asset with one worker, in minutes', fmt(crawl)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
