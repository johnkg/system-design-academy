---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="What does this change break?" hint="A lineage graph of 200 assets, built from 400 job runs, is walked downstream from the asset raw_events (t0). Change how the walk is done and see how much of the damage you find, and how much work it costs.">
  <ol class="how">
    <li>Start with the default, <b>a depth limit of 1</b>: you find only <b>8</b> of the <b>119</b> affected assets and tell <b>5 of 8</b> teams. This is the page-view limit used by mistake as a safety check, and it is wrong in the dangerous direction.</li>
    <li>Set the depth to <b>no limit</b> with <b>visited map on</b>: all <b>119</b> assets and <b>all 8</b> teams, after <b>422</b> steps. Depth <b>5</b> is already enough for this graph.</li>
    <li>Turn the visited map <b>off</b>: the same answer, but <b>11,496</b> steps, because shared assets are expanded again for every route that reaches them. Add the <b>feedback loop</b> and it hits the 50,000-step budget and gives up.</li>
  </ol>
  <div class="pg dcb" data-dcb>
    <div class="pg-row">
      <label>Depth limit <select class="pg-in" data-d>
        <option value="1" selected>1 hop</option>
        <option value="2">2 hops</option>
        <option value="3">3 hops</option>
        <option value="5">5 hops</option>
        <option value="99">no limit</option>
      </select></label>
      <label><input type="checkbox" data-v checked /> Remember visited assets</label>
      <label><input type="checkbox" data-loop /> A job feeds a downstream table back into raw_events</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Affected assets found</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Owning teams told</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Work done by the walk</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 400 job runs each read three random lower-numbered assets and write one asset (t20 to t199), and the owner of tN is team N mod 8. One step is looking at one edge. The walk stops at 50,000 steps. The loop adds one edge from t199 back to t0.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-dcb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const BUDGET = 50000; const TEAMS = 8;
    let seed = 7; const rnd = (n: number) => { seed = (seed * 1664525 + 1013904223) % 4294967296; return Math.floor(seed / 65536) % n; };
    const down = new Map<string, string[]>();
    for (let k = 0; k < 400; k++) {
      const out = 20 + rnd(180); const ins = [...new Set([rnd(out), rnd(out), rnd(out)])];
      for (const i of ins) { const key = `t${i}`; if (!down.has(key)) down.set(key, []); const l = down.get(key)!; if (!l.includes(`t${out}`)) l.push(`t${out}`); }
    }
    function walk(limit: number, visited: boolean, loop: boolean) {
      const next = (u: string) => { const l = down.get(u) ?? []; return loop && u === 't199' ? [...l, 't0'] : l; };
      const seen = new Set<string>(['t0']); let frontier = ['t0']; let work = 0; let gaveUp = false;
      for (let d = 1; d <= limit && frontier.length > 0 && !gaveUp; d++) {
        const nxt: string[] = [];
        for (const u of frontier) {
          for (const v of next(u)) {
            work++; if (work > BUDGET) { gaveUp = true; break; }
            if (visited) { if (!seen.has(v)) { seen.add(v); nxt.push(v); } } else { seen.add(v); nxt.push(v); }
          }
          if (gaveUp) break;
        }
        frontier = nxt;
      }
      seen.delete('t0');
      const teams = new Set([...seen].map((n) => Number(n.slice(1)) % TEAMS));
      return { found: seen.size, teams: teams.size, work, gaveUp };
    }
    const full = walk(99, true, false);
    const fmt = (n: number) => n.toLocaleString('en-US');
    function draw() {
      const limit = Number(q<HTMLSelectElement>('[data-d]').value); const visited = q<HTMLInputElement>('[data-v]').checked; const loop = q<HTMLInputElement>('[data-loop]').checked;
      const r = walk(limit, visited, loop);
      q('[data-o1]').textContent = `${fmt(r.found)} of ${fmt(full.found)}`; q('[data-n1]').textContent = r.gaveUp ? 'the walk gave up before it finished' : `${fmt(full.found - r.found)} affected assets missed`;
      q('[data-o2]').textContent = `${r.teams} of ${TEAMS}`; q('[data-n2]').textContent = r.teams === TEAMS ? 'every affected team hears about it' : `${TEAMS - r.teams} teams get no warning`;
      q('[data-o3]').textContent = r.gaveUp ? `${fmt(BUDGET)} steps, gave up` : `${fmt(r.work)} steps`; q('[data-n3]').textContent = visited ? 'each asset is expanded once' : 'an asset is expanded again for every route that reaches it';
      q<HTMLElement>('[data-b1]').style.setProperty('--c', r.found === full.found && !r.gaveUp ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', r.teams === TEAMS && !r.gaveUp ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', r.gaveUp ? 'var(--bad)' : 'var(--accent)');
      const out = q('[data-verdict]'); const bad = r.gaveUp || r.found < full.found; out.classList.toggle('bad', bad);
      out.textContent = r.gaveUp ? `The walk never finished: without a visited map the feedback loop makes it go round again and again until the ${fmt(BUDGET)}-step budget runs out. No answer is worse than a late one here.`
        : r.found < full.found ? `Only ${r.found} of the ${full.found} affected assets were found with a limit of ${limit} hops, and ${r.teams < TEAMS ? `${TEAMS - r.teams} of ${TEAMS} teams would not be told` : `although all ${TEAMS} teams were reached, the asset list is incomplete`}. A depth limit is fine for a page view, but never for a safety check.`
        : visited ? `Complete: all ${full.found} affected assets and all ${TEAMS} teams, in ${fmt(r.work)} steps. The visited map makes the work depend on the size of the reachable graph, not on the number of routes.`
        : `Complete, but it cost ${fmt(r.work)} steps instead of ${fmt(full.work)}. Shared assets were expanded again for every route; with a cycle this never ends.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
