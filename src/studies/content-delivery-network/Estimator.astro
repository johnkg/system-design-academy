---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The hit ratio decides the bill: every point of hit ratio moves traffic off the origin, and a shield multiplies that saving.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Peak requests per second (thousands)" name="r" min="5" max="500" step="5" value="50" />
      <RangeField label="Average response size (KB)" name="kb" min="10" max="1000" step="10" value="100" />
      <RangeField label="Edge hit ratio (%)" name="h" min="50" max="99" value="90" />
      <RangeField label="Edge misses answered by the shield (%)" name="s" min="0" max="95" step="5" value="70" />
      <RangeField label="PoPs" name="pops" min="10" max="300" step="10" value="50" />
      <RangeField label="Objects purged at once (thousands)" name="obj" min="1" max="200" value="5" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: average traffic is 40% of the peak, a month has 30 days, one cache server delivers 20 Gbps and runs with 30% headroom, every PoP has at least 2 servers, the busiest PoP carries 3 times the average, there are 6 regional shields, delivery costs $0.02 per GB on the CDN and $0.08 per GB when sent from the origin's cloud, and after a purge each cache fetches each purged object once (requests that arrive meanwhile are coalesced). Sizes are decimal: 1 KB = 1,000 bytes.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 12; // lines in the result list
    const THOUSAND = 1000, BITS_PER_BYTE = 8, KBIT_PER_GBIT = 1e6, GB_PER_TB = 1000;
    const DAY_S = 86400, MONTH_DAYS = 30;
    const HEADROOM = 1.3, SERVER_GBPS = 20, MIN_PER_POP = 2; // cache servers: 30% headroom, 20 Gbps each, at least two per PoP
    const AVG_OF_PEAK = 0.4; // average traffic over the month is 40% of the peak
    const USD_PER_GB = { cloud: 0.08, cdn: 0.02 }; // egress prices
    const HOT_POP = 3; // busiest PoP carries 3 times the average
    const SHIELDS = 6; // regional shield caches
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const one = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    const usd = (n: number) => `$${fmt(n)}`;
    function draw() {
      const r = val('[data-r]') * THOUSAND; const kb = val('[data-kb]'); const h = val('[data-h]') / 100; const s = val('[data-s]') / 100; const pops = val('[data-pops]'); const obj = val('[data-obj]') * THOUSAND;
      ['r', 'kb', 'h', 's', 'pops', 'obj'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const gbps = (r * kb * BITS_PER_BYTE) / KBIT_PER_GBIT; // requests/s x KB x 8 bits = kilobits/s, divided by 1e6 = Gbps
      const servers = Math.max(Math.ceil((gbps * HEADROOM) / SERVER_GBPS), pops * MIN_PER_POP);
      const miss = r * (1 - h); const originRps = miss * (1 - s); const originGbps = (originRps * kb * BITS_PER_BYTE) / KBIT_PER_GBIT;
      const avgTb = ((gbps * AVG_OF_PEAK) / BITS_PER_BYTE) * DAY_S * MONTH_DAYS / GB_PER_TB; // Gbps to GB/s, times seconds in a month, to TB
      const originTb = ((originGbps * AVG_OF_PEAK) / BITS_PER_BYTE) * DAY_S * MONTH_DAYS / GB_PER_TB;
      const direct = avgTb * GB_PER_TB * USD_PER_GB.cloud; const withCdn = avgTb * GB_PER_TB * USD_PER_GB.cdn + originTb * GB_PER_TB * USD_PER_GB.cloud;
      const data: [string, string][] = [
        ['Peak delivery to users', `${one(gbps)} Gbps`],
        [`Busiest PoP (${HOT_POP} times the average)`, `${one((gbps / pops) * HOT_POP)} Gbps`],
        ['Cache servers in total', fmt(servers)],
        ['Requests per second with no CDN', fmt(r)],
        ['Edge misses per second', fmt(miss)],
        ['Origin requests per second, with the shield', fmt(originRps)],
        ['Share of requests that reach the origin', `${one((originRps / r) * 100)}%`],
        ['Origin egress at the peak, with the shield', `${one(originGbps)} Gbps`],
        ['Traffic delivered per month', `${fmt(avgTb)} TB`],
        ['Monthly bill: all sent from the origin cloud', usd(direct)],
        ['Monthly bill: CDN plus origin egress', usd(withCdn)],
        ['Fetches to refill after a purge: no shield / with shields', `${fmt(pops * obj)} / ${fmt(SHIELDS * obj)}`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
