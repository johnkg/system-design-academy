---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The hit ratio decides the bill: every point of hit ratio moves traffic off the origin, and a shield multiplies that saving.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Peak requests per second (thousands) <input type="range" min="5" max="500" step="5" value="50" data-r /> <b data-rval></b></label>
      <label>Average response size (KB) <input type="range" min="10" max="1000" step="10" value="100" data-kb /> <b data-kbval></b></label>
      <label>Edge hit ratio (%) <input type="range" min="50" max="99" value="90" data-h /> <b data-hval></b></label>
      <label>Edge misses answered by the shield (%) <input type="range" min="0" max="95" step="5" value="70" data-s /> <b data-sval></b></label>
      <label>PoPs <input type="range" min="10" max="300" step="10" value="50" data-pops /> <b data-popsval></b></label>
      <label>Objects purged at once (thousands) <input type="range" min="1" max="200" value="5" data-obj /> <b data-objval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: average traffic is 40% of the peak, a month has 30 days, one cache server delivers 20 Gbps and runs with 30% headroom, every PoP has at least 2 servers, the busiest PoP carries 3 times the average, there are 6 regional shields, delivery costs $0.02 per GB on the CDN and $0.08 per GB when sent from the origin's cloud, and after a purge each cache fetches each purged object once (requests that arrive meanwhile are coalesced). Sizes are decimal: 1 KB = 1,000 bytes.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 12 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const one = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    const usd = (n: number) => `$${fmt(n)}`;
    function draw() {
      const r = val('[data-r]') * 1000; const kb = val('[data-kb]'); const h = val('[data-h]') / 100; const s = val('[data-s]') / 100; const pops = val('[data-pops]'); const obj = val('[data-obj]') * 1000;
      ['r', 'kb', 'h', 's', 'pops', 'obj'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const gbps = (r * kb * 8) / 1e6; // requests/s x KB x 8 bits = kilobits/s, divided by 1e6 = Gbps
      const servers = Math.max(Math.ceil((gbps * 1.3) / 20), pops * 2);
      const miss = r * (1 - h); const originRps = miss * (1 - s); const originGbps = (originRps * kb * 8) / 1e6;
      const avgTb = ((gbps * 0.4) / 8) * 86400 * 30 / 1000; // Gbps to GB/s, times seconds in a month, to TB
      const originTb = ((originGbps * 0.4) / 8) * 86400 * 30 / 1000;
      const direct = avgTb * 1000 * 0.08; const withCdn = avgTb * 1000 * 0.02 + originTb * 1000 * 0.08;
      const data: [string, string][] = [
        ['Peak delivery to users', `${one(gbps)} Gbps`],
        ['Busiest PoP (3 times the average)', `${one((gbps / pops) * 3)} Gbps`],
        ['Cache servers in total', fmt(servers)],
        ['Requests per second with no CDN', fmt(r)],
        ['Edge misses per second', fmt(miss)],
        ['Origin requests per second, with the shield', fmt(originRps)],
        ['Share of requests that reach the origin', `${one((originRps / r) * 100)}%`],
        ['Origin egress at the peak, with the shield', `${one(originGbps)} Gbps`],
        ['Traffic delivered per month', `${fmt(avgTb)} TB`],
        ['Monthly bill: all sent from the origin cloud', usd(direct)],
        ['Monthly bill: CDN plus origin egress', usd(withCdn)],
        ['Fetches to refill after a purge: no shield / with shields', `${fmt(pops * obj)} / ${fmt(6 * obj)}`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
