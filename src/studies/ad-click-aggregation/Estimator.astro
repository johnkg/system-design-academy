---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The click rate sets the number of partitions, the retention of ids sets the memory for dedup, and one hot ad can overload a single partition.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Clicks per day (millions) <input type="range" min="50" max="5000" step="50" value="500" data-c /> <b data-cval></b></label>
      <label>Peak rate compared with the average <input type="range" min="1" max="10" value="3" data-pk /> <b data-pkval></b></label>
      <label>Bytes per click event <input type="range" min="100" max="500" step="50" value="200" data-by /> <b data-byval></b></label>
      <label>Click ids remembered for (hours) <input type="range" min="1" max="48" value="6" data-h /> <b data-hval></b></label>
      <label>Share of clicks on the hottest ad (%) <input type="range" min="1" max="30" value="10" data-hot /> <b data-hotval></b></label>
      <label>Sub-keys for a hot ad (salt) <input type="range" min="1" max="32" value="8" data-salt /> <b data-saltval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: one stream partition and its worker handle about 5,000 clicks per second including the id check and the state update, a stored click id takes about 40 bytes, clicks are spread evenly over partitions except for the hottest ad, and the raw log is counted before compression or replication. Fewer than 4 partitions is rounded up to 4 for availability.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 9; // output lines below
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const CAP = 5000;
    const MILLION = 1e6; const DAY_S = 86400; const HOUR_S = 3600; const GB = 1e9; const GB_PER_TB = 1000; const DAYS_PER_YEAR = 365;
    const MIN_PARTS = 4; // never fewer stream partitions than this
    const ID_BYTES = 40; // memory per remembered click id (dedup set)
    function draw() {
      const clicks = val('[data-c]') * MILLION; const pk = val('[data-pk]'); const by = val('[data-by]'); const h = val('[data-h]'); const hot = val('[data-hot]') / 100; const salt = val('[data-salt]');
      ['c', 'pk', 'by', 'h', 'hot', 'salt'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const avg = clicks / DAY_S; const peak = avg * pk;
      const parts = Math.max(MIN_PARTS, Math.ceil(peak / CAP));
      const rawGb = (clicks * by) / GB; const yearTb = (rawGb * DAYS_PER_YEAR) / GB_PER_TB;
      const idGb = (avg * h * HOUR_S * ID_BYTES) / GB;
      const hotRate = peak * hot; const base = (peak * (1 - hot)) / parts;
      const unsalted = base + hotRate; const spread = Math.min(salt, parts); const salted = base + hotRate / spread;
      const pct = (x: number) => `${fmt(x)} per second, ${Math.round((x / CAP) * 100)}% of its capacity`;
      const data: [string, string][] = [
        ['Average clicks per second', fmt(avg)],
        ['Peak clicks per second', fmt(peak)],
        ['Stream partitions', fmt(parts)],
        ['Raw click log per day', `${fmt(rawGb)} GB`],
        ['Raw click log per year', `${fmt(yearTb)} TB`],
        ['Memory for click ids', `${idGb < 10 ? idGb.toFixed(1) : fmt(idGb)} GB`],
        ['Clicks per second on the hottest ad at the peak', fmt(hotRate)],
        ['Busiest partition without a salt', pct(unsalted)],
        ['Busiest partition with the salt', pct(salted)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
