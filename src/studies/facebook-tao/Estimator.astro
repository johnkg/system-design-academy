---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How many reads reach the leaders and the database for a given cache hit rate, how much load each shard sees, and how many writes come from outside the primary region. A teaching model with round numbers, not Facebook's data.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Reads per second (millions)" name="r" min="100" max="3000" step="100" value="1000" />
      <RangeField label="Writes per second (millions)" name="w" min="1" max="10" value="3" />
      <RangeField label="Follower cache hit rate (%)" name="h" min="80" max="99.9" step="0.1" value="96" />
      <RangeField label="Leader cache hit rate on follower misses (%)" name="l" min="0" max="99" step="1" value="75" />
      <RangeField label="Shards (thousands)" name="s" min="100" max="1000" step="100" value="300" />
      <RangeField label="Regions" name="g" min="1" max="6" value="3" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Teaching model, not Facebook's system or data. The 2013 post says TAO handled over a billion read requests and millions of write requests every second, with hundreds of thousands of shards. The hit rates and the number of regions are my guesses that you can change. Assumptions: reads and writes are spread evenly over shards, writes are spread evenly over regions, each follower miss goes to a leader, and a leader miss reads MySQL once.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 10; // lines in the result list
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const f1 = formatOneDecimalBelow100;
    const pct = (n: number) => `${(Math.round(n * 1000) / 1000).toLocaleString('en-US')}%`;
    function draw() {
      ['r', 'w', 'h', 'l', 's', 'g'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const reads = val('[data-r]') * 1e6; const writes = val('[data-w]') * 1e6; const followerHit = val('[data-h]') / 100;
      const leaderHit = val('[data-l]') / 100; const shards = val('[data-s]') * 1000; const regions = val('[data-g]');
      const misses = reads * (1 - followerHit); const dbReads = misses * (1 - leaderHit);
      const m = (n: number) => `${f1(n / 1e6)} million`;
      const data: [string, string][] = [
        ['Reads for every write', f1(reads / writes)],
        ['Reads answered by followers per second', m(reads * followerHit)],
        ['Follower misses sent to leaders per second', m(misses)],
        ['MySQL reads per second', m(dbReads)],
        ['Share of all reads that reach MySQL', `${f1((100 * dbReads) / reads)}%`],
        ['Reads per shard per second', f1(reads / shards)],
        ['Writes per shard per second', f1(writes / shards)],
        ['MySQL reads per shard per second', f1(dbReads / shards)],
        ['Share of writes made outside the primary region', `${f1((100 * (regions - 1)) / regions)}%`],
        ['Writes forwarded to a primary region per second', m((writes * (regions - 1)) / regions)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
