---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Almost every request ends in a no-bid or a lost auction, so the bidder fleet is sized by requests, while billing and pacing are sized by the much smaller number of wins.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Bid requests per second at the peak (thousands) <input type="range" min="100" max="5000" step="100" value="1000" data-q /> <b data-qval></b></label>
      <label>Peak is how many times the average <input type="range" min="1" max="4" step="0.5" value="2" data-k /> <b data-kval></b></label>
      <label>Requests we bid on (%) <input type="range" min="1" max="100" value="20" data-b /> <b data-bval></b></label>
      <label>Bids we win (%) <input type="range" min="1" max="50" value="15" data-w /> <b data-wval></b></label>
      <label>Average price paid (CPM, $) <input type="range" min="0.5" max="10" step="0.5" value="2" data-p /> <b data-pval></b></label>
      <label>Requests one CPU core handles per second <input type="range" min="500" max="5000" step="500" value="2000" data-c /> <b data-cval></b></label>
      <label>Known users (millions) <input type="range" min="100" max="3000" step="100" value="500" data-u /> <b data-uval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a bid request is about 2 KB of JSON, 70% of requests carry a user id we know, a profile is about 1 KB, servers have 32 cores and run at half their capacity at the peak, and an event (win, impression or click) is about 500 bytes, with one win notice and one impression for every win. A CPM is the price for a thousand impressions.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const OUT_ROWS = 10; // lines in the result list
    const THOUSAND = 1000, MILLION = 1e6, BILLION = 1e9, DAY_S = 86400;
    const REQUEST_BYTES = 2000, PROFILE_BYTES = 1000, EVENT_BYTES = 500;
    const KNOWN_USER_SHARE = 0.7; // requests with a user id we can look up
    const CORES_PER_SERVER = 32, TARGET_UTILISATION = 0.5;
    const EVENTS_PER_WIN = 2; // the win notice and the impression
    const BITS = 8, GB = 1e9;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    const big = (n: number) => (n >= BILLION ? `${fmt(n / BILLION)} billion` : n >= MILLION ? `${fmt(n / MILLION)} million` : fmt(n));
    function draw() {
      const peak = val('[data-q]') * THOUSAND; const ratio = val('[data-k]'); const bidShare = val('[data-b]') / 100; const winShare = val('[data-w]') / 100;
      const cpm = val('[data-p]'); const perCore = val('[data-c]'); const users = val('[data-u]') * MILLION;
      ['q', 'k', 'b', 'w', 'p', 'c', 'u'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const avg = peak / ratio;
      const requestsDay = avg * DAY_S;
      const bidsPeak = peak * bidShare;
      const winsPeak = bidsPeak * winShare;
      const winsDay = avg * bidShare * winShare * DAY_S;
      const spendDay = (winsDay / THOUSAND) * cpm;
      const cores = peak / perCore;
      const servers = Math.ceil(cores / (CORES_PER_SERVER * TARGET_UTILISATION));
      const inboundGbit = (peak * REQUEST_BYTES * BITS) / GB;
      const profileReads = peak * KNOWN_USER_SHARE;
      const profileGB = (users * PROFILE_BYTES) / GB;
      const eventGB = (winsDay * EVENTS_PER_WIN * EVENT_BYTES) / GB;
      const data: [string, string][] = [
        ['Bid requests per day', big(requestsDay)],
        ['Bids sent per second at the peak', fmt(bidsPeak)],
        ['Wins (impressions) per second at the peak', fmt(winsPeak)],
        ['Impressions per day', big(winsDay)],
        ['Media spend per day', `$${big(spendDay)}`],
        ['CPU cores busy at the peak', fmt(cores)],
        [`Bidder servers (${CORES_PER_SERVER} cores, half busy)`, fmt(servers)],
        ['Bid request traffic in at the peak', `${fmt(inboundGbit)} Gbit/s`],
        ['Profile reads per second at the peak', fmt(profileReads)],
        ['Profile store per region, and events per day', `${fmt(profileGB)} GB, ${fmt(eventGB)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
