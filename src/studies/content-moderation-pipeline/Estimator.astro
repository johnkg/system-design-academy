---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The machines are the small part. The size of the human review team follows from the share of items that need a person and how long each takes.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Uploads per day (millions) <input type="range" min="1" max="500" value="50" data-u /> <b data-uval></b></label>
      <label>Sent to human review (% of uploads) <input type="range" min="0.2" max="5" step="0.1" value="1.5" data-r /> <b data-rval></b></label>
      <label>Removed automatically (% of uploads) <input type="range" min="0.1" max="3" step="0.1" value="0.8" data-a /> <b data-aval></b></label>
      <label>Appeal rate (% of removals) <input type="range" min="1" max="20" value="5" data-ap /> <b data-apval></b></label>
      <label>Seconds per review <input type="range" min="10" max="120" step="5" value="40" data-s /> <b data-sval></b></label>
      <label>Hours of review per reviewer per day <input type="range" min="2" max="7" step="0.5" value="5" data-h /> <b data-hval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the peak is 3 times the average, a reviewer works 5 days out of 7 and is absent on 10% of working days (so about 64% of the team is present on a given day), a decision record is about 500 bytes, and an appeal takes as long to review as a first review.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 10; // one per output line
    const MILLION = 1e6; const DAY_S = 86400; const SEC_PER_H = 3600; const DAYS_PER_YEAR = 365; const BYTES_PER_GB = 1e9; const GB_PER_TB = 1000;
    const PEAK_X = 3; const ROSTER = 0.643; // share of the team working on a given day (shifts, leave)
    const DECISION_BYTES = 500;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const u = val('[data-u]') * MILLION; const r = val('[data-r]') / 100; const a = val('[data-a]') / 100; const ap = val('[data-ap]') / 100;
      const sec = val('[data-s]'); const hours = val('[data-h]');
      ['u', 'r', 'a', 'ap', 's', 'h'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perSec = u / DAY_S; const reviews = u * r; const appeals = u * a * ap; const items = reviews + appeals;
      const reviewHours = (items * sec) / SEC_PER_H; const present = reviewHours / hours; const team = present / ROSTER;
      const decisions = u + reviews + appeals; const logGb = (decisions * DECISION_BYTES) / BYTES_PER_GB;
      const data: [string, string][] = [
        ['Uploads per second, average', fmt(perSec)],
        ['Uploads per second at the peak', fmt(perSec * PEAK_X)],
        ['Hash lookups and classifier runs per second at the peak', fmt(perSec * PEAK_X)],
        ['Items for human review per day', fmt(reviews)],
        ['Appeals per day', fmt(appeals)],
        ['Review hours per day', fmt(reviewHours)],
        ['Reviewers working on a given day', fmt(present)],
        ['Reviewers on the team', fmt(team)],
        ['Decision log growth per day', `${logGb.toFixed(1)} GB`],
        ['Decision log for a year', `${(logGb * DAYS_PER_YEAR / GB_PER_TB).toFixed(1)} TB`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
