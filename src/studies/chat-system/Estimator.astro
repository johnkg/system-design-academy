---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Change the audience and see what the chat service has to handle.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Daily active users (millions) <input type="range" min="1" max="500" value="50" data-dau /> <b data-dauval></b></label>
      <label>Messages sent per user per day <input type="range" min="5" max="200" step="5" value="40" data-per /> <b data-perval></b></label>
      <label>Share of messages sent to groups <input type="range" min="0" max="80" step="5" value="30" data-grp /> <b data-grpval></b></label>
      <label>Typical group size <input type="range" min="3" max="500" value="20" data-size /> <b data-sizeval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: peak traffic is 3 times the average, 20% of daily users are connected at the busiest moment, one chat server holds about 100,000 connections, a stored message takes about 150 bytes with its metadata, and history is kept for 5 years.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const dau = val('[data-dau]'); const per = val('[data-per]'); const grp = val('[data-grp]') / 100; const size = val('[data-size]');
      q('[data-dauval]').textContent = String(dau); q('[data-perval]').textContent = String(per); q('[data-grpval]').textContent = `${Math.round(grp * 100)}%`; q('[data-sizeval]').textContent = String(size);
      const daily = dau * 1e6 * per; const avg = daily / 86400; const peak = avg * 3; const factor = 1 + grp * (size - 1);
      const conns = dau * 1e6 * 0.2; const servers = Math.max(1, Math.ceil(conns / 1e5));
      const tb = (daily * 150 * 365 * 5) / 1e12;
      const data: [string, string][] = [
        ['Messages per day', `${(daily / 1e9).toFixed(1)} billion`],
        ['Messages per second (peak)', fmt(peak)],
        ['Deliveries per message on average', factor.toFixed(1)],
        ['Deliveries per second (peak)', fmt(peak * factor)],
        ['Simultaneous connections at peak', `${(conns / 1e6).toFixed(1)} million`],
        ['Chat servers for those connections', fmt(servers)],
        ['Message history after 5 years', tb >= 1000 ? `${(tb / 1000).toFixed(1)} PB` : `${tb.toFixed(0)} TB`],
        ['Polling requests per second if clients polled every 2 s', fmt(conns / 2)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
