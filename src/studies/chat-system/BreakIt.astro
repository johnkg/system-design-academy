---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Polling vs open connections" hint="Compare how the first attempt and a WebSocket design cope as the number of users grows. Figures are modelled.">
  <div class="pg csa" data-csa>
    <div class="pg-row">
      <label>Connected users (millions) <input type="range" min="0.1" max="20" step="0.1" value="5" data-users /> <b data-usersval></b></label>
      <label>Polling interval <input type="range" min="1" max="10" value="2" data-interval /> <b data-intervalval></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-pbox><h3>Polling</h3><span class="pg-mono" data-poll></span><span class="pg-note" data-pollnote></span></div>
      <div class="pg-box" style="--c: var(--role-2)"><h3>Open connections</h3><span class="pg-mono" data-ws></span><span class="pg-note" data-wsnote></span></div>
    </div>
    <p class="pg-note">Model: each user sends about 40 messages a day and receives about 40. A poll is a request whether or not a message is waiting. A polled message arrives on average half an interval late. A pushed message arrives in about 50 ms. One chat server holds 100,000 connections and one polling server handles 5,000 requests per second.</p>
  </div>
</PlaygroundShell>
<PlaygroundShell title="Order and duplicates" hint="Alice and Bob exchange messages. Decide how the conversation is ordered, how wrong Alice's phone clock is, and whether a lost acknowledgement makes her app resend.">
  <ol class="how">
    <li>Order by <b>device timestamp</b> and set <b>Alice's clock</b> to <b>+5 s</b>: her messages sort after Bob's replies, so answers appear <b>before the question</b>.</li>
    <li>Switch to <b>server sequence number</b>: the order is the order the server stored them, whatever the clocks say.</li>
    <li>Tick <b>Alice's app resends message 2</b>: without <b>de-duplicate by client id</b> it shows twice. Tick de-duplication and it appears once.</li>
  </ol>
  <div class="pg cso" data-cso>
    <div class="pg-row">
      <label>Order messages by <select class="pg-in" data-order><option value="ts" selected>Device timestamp</option><option value="seq">Server sequence number</option></select></label>
      <label>Alice's clock is off by <input type="range" min="-5" max="5" value="5" data-skew /> <b data-skewval></b></label>
    </div>
    <div class="pg-row">
      <label class="cso-check"><input type="checkbox" data-resend /> Alice's app resends message 2 (acknowledgement lost)</label>
      <label class="cso-check"><input type="checkbox" data-dedupe /> De-duplicate by client id</label>
    </div>
    <ol class="cso-list" data-list aria-label="The conversation as Bob sees it"></ol>
    <p class="pg-out" data-verdict aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-csa]').forEach((root) => {
    const q = query(root);
    const MILLION = 1e6; const DAY_S = 86400;
    const MSGS_PER_USER_DAY = 40; // messages each user receives per day
    const POLLS_PER_SERVER = 5000; const CONNS_PER_SERVER = 1e5; // requests/s one polling server handles; open WebSockets per server
    const EMPTY_BAD_PCT = 90; // share of empty polls that marks polling as wasteful
    function draw() {
      const users = Number(q<HTMLInputElement>('[data-users]').value) * MILLION; const interval = Number(q<HTMLInputElement>('[data-interval]').value);
      q('[data-usersval]').textContent = (users / MILLION).toFixed(1); q('[data-intervalval]').textContent = `${interval} s`;
      const polls = users / interval; const msgs = (users * MSGS_PER_USER_DAY) / DAY_S;
      const empty = Math.max(0, 1 - msgs / polls) * 100;
      q('[data-poll]').textContent = `${Math.round(polls).toLocaleString('en-US')} requests/s`;
      q('[data-pollnote]').textContent = `${empty.toFixed(1)}% of polls find nothing · ${Math.ceil(polls / POLLS_PER_SERVER).toLocaleString('en-US')} servers · messages ${(interval / 2).toFixed(1)} s late on average`;
      q('[data-ws]').textContent = `${(users / MILLION).toFixed(1)} million connections`;
      q('[data-wsnote]').textContent = `${Math.ceil(users / CONNS_PER_SERVER).toLocaleString('en-US')} servers · messages arrive in about 50 ms · no empty requests`;
      q<HTMLElement>('[data-pbox]').style.setProperty('--c', empty > EMPTY_BAD_PCT ? 'var(--bad)' : 'var(--role-3)');
    }
    root.addEventListener('input', draw);
    draw();
  });

  document.querySelectorAll<HTMLElement>('[data-cso]').forEach((root) => {
    const q = query(root);
    const RESEND_TS_STEP = 0.01; // a resent copy is stamped 10 ms after the first
    // The real order in which the server received messages. Times are seconds after the start.
    const script = [
      { who: 'Alice', text: 'Are you free for lunch?', real: 0, id: 'm1' },
      { who: 'Bob', text: 'Yes!', real: 1, id: 'b1' },
      { who: 'Alice', text: 'Great, 12:30 at the cafe', real: 2, id: 'm2' },
      { who: 'Bob', text: 'See you there', real: 3, id: 'b2' },
    ];
    function draw() {
      const skew = Number(q<HTMLInputElement>('[data-skew]').value); const byTs = q<HTMLSelectElement>('[data-order]').value === 'ts';
      const resend = q<HTMLInputElement>('[data-resend]').checked; const dedupe = q<HTMLInputElement>('[data-dedupe]').checked;
      q('[data-skewval]').textContent = `${skew > 0 ? '+' : ''}${skew} s`;
      let seq = 0; const stored: { who: string; text: string; ts: number; seq: number; id: string }[] = []; const seen = new Set<string>();
      script.forEach((m) => {
        const attempts = resend && m.id === 'm2' ? 2 : 1;
        for (let a = 0; a < attempts; a++) {
          const key = `${m.who}:${m.id}`;
          if (dedupe && seen.has(key)) continue;
          seen.add(key); stored.push({ who: m.who, text: m.text, ts: m.real + (m.who === 'Alice' ? skew : 0) + a * RESEND_TS_STEP, seq: ++seq, id: m.id });
        }
      });
      const shown = [...stored].sort((x, y) => (byTs ? x.ts - y.ts : x.seq - y.seq));
      const list = q('[data-list]'); list.replaceChildren();
      const dupIds = new Set(shown.filter((m, i) => shown.findIndex((n) => n.id === m.id) !== i).map((m) => m.id));
      shown.forEach((m) => { const li = document.createElement('li'); li.textContent = `${m.who}: ${m.text}${dupIds.has(m.id) ? '  (duplicate)' : ''}`; if (dupIds.has(m.id)) li.className = 'flag'; list.appendChild(li); });
      const real = ['m1', 'b1', 'm2', 'b2']; const order = shown.filter((m, i) => shown.findIndex((n) => n.id === m.id) === i).map((m) => m.id);
      const scrambled = order.join() !== real.join(); const dups = dupIds.size > 0;
      const out = q('[data-verdict]'); out.classList.toggle('bad', scrambled || dups);
      out.textContent = scrambled ? 'The order is wrong: replies appear before the messages they answer.' : dups ? 'A message appears twice.' : 'Correct order, each message once.';
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .cso-check { display: inline-flex; align-items: center; gap: 6px; }
  .playground .cso-list { margin: 0; padding-left: 1.2rem; display: grid; gap: 4px; }
  .playground .cso-list li.flag { color: var(--bad-text); font-weight: 600; }
</style>
