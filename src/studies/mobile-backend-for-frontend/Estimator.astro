---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The BFF trades one slow phone round trip for several fast datacenter calls. See what that does to time, bytes and backend load.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Daily active users (millions)" name="dau" min="1" max="100" value="20" />
      <RangeField label="Home-screen opens per user per day" name="opens" min="1" max="30" value="10" />
      <RangeField label="Backend calls behind one screen" name="calls" min="2" max="12" value="6" />
      <RangeField label="Calls that depend on an earlier answer (waves)" name="waves" min="1" max="4" value="2" />
      <RangeField label="Phone round trip on mobile data (ms)" name="rtt" min="30" max="300" step="10" value="100" />
      <RangeField label="Share of opens answered from cache or by 304 (%)" name="hit" min="0" max="90" value="40" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the busiest hour carries 3 times the average load, a slow backend call takes 60 ms, a call inside the datacenter adds 2 ms, one BFF instance handles about 800 screen requests per second, each backend response is about 12 KB while the screen needs 6 KB, headers add 0.5 KB per request on the phone's connection, and a cache hit or 304 sends only the headers. Without a BFF the phone makes every call over the mobile network, in the waves given above.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 11; // one per output line
    const MILLION = 1e6; const DAY_S = 86400; const MS_PER_S = 1000; const KB_PER_TB = 1e9;
    const PEAK_X = 3; // busiest hour vs the daily average
    const BFF = { rps: 800, min: 2 }; // per instance; always run at least two
    const BACKEND_MS = 60; const BFF_HOP_MS = 2; // backend call time; extra hop inside the data centre
    const PAYLOAD_KB = { rawPerCall: 12, shaped: 6, overhead: 0.5 }; // per backend response, BFF screen payload, per-request overhead
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n).toLocaleString('en-US') : String(Math.round(n * 10) / 10));
    function draw() {
      const dau = val('[data-dau]') * MILLION; const opens = val('[data-opens]'); const calls = val('[data-calls]'); const waves = Math.min(val('[data-waves]'), calls);
      const rtt = val('[data-rtt]'); const hit = val('[data-hit]') / 100;
      ['dau', 'opens', 'calls', 'waves', 'rtt', 'hit'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const avg = (dau * opens) / DAY_S; const peak = avg * PEAK_X;
      const bffInstances = Math.max(BFF.min, Math.ceil(peak / BFF.rps));
      const backendCalls = peak * (1 - hit) * calls;
      const direct = waves * (rtt + BACKEND_MS); const viaBff = rtt + waves * (BACKEND_MS + BFF_HOP_MS);
      const inflight = peak * (1 - hit) * (viaBff / MS_PER_S);
      const rawKb = calls * PAYLOAD_KB.rawPerCall; const shapedKb = PAYLOAD_KB.shaped;
      const wireAvg = (1 - hit) * (shapedKb + PAYLOAD_KB.overhead) + hit * PAYLOAD_KB.overhead; const directKb = rawKb + PAYLOAD_KB.overhead * calls;
      const dailyTb = (dau * opens * wireAvg) / KB_PER_TB;
      const data: [string, string][] = [
        ['Screen requests per second, average', fmt(avg)],
        ['Screen requests per second, busiest hour', fmt(peak)],
        [`BFF instances (${BFF.rps} requests per second each, at least ${BFF.min})`, fmt(bffInstances)],
        ['Backend calls per second, busiest hour, after the cache', fmt(backendCalls)],
        ['Backend calls per second the phones would cause with no cache and no BFF', fmt(peak * calls)],
        ['Time to show the screen without a BFF (ms)', fmt(direct)],
        ['Time to show the screen through the BFF (ms)', fmt(viaBff)],
        ['Screens being assembled at once in the busiest hour', fmt(inflight)],
        ['KB on the phone connection per open without a BFF', fmt(directKb)],
        ['KB on the phone connection per open through the BFF, on average', fmt(wireAvg)],
        ['Mobile data sent per day through the BFF (TB)', fmt(dailyTb)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
