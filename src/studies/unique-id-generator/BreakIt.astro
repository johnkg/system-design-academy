---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Do the IDs collide?" hint="Several machines make IDs for 100 milliseconds with six different designs. Count the duplicates and check whether newer IDs are larger.">
  <ol class="how">
    <li>With <b>16 machines and 5 IDs per millisecond</b>: counters, or timestamps without a machine number, collide at once. Time plus machine plus sequence never does. Raise the rate to <b>100</b> and even a random 32-bit number starts to repeat: the birthday effect.</li>
    <li>Look at the last two boxes: when one machine's clock is set back by 5 ms, a plain generator repeats <b>every ID it made in those 5 ms</b>. The guarded one never repeats, but it <b>pauses</b>.</li>
    <li>With <b>1 machine</b> even the weak designs look fine, because collisions need two machines. A single test machine would never find these bugs.</li>
  </ol>
  <div class="pg idb" data-idb>
    <div class="pg-row">
      <label>Machines <input type="range" min="1" max="32" value="16" data-m /> <b data-mval></b></label>
      <label>IDs per machine per millisecond <select class="pg-in" data-r>
        <option value="1">1</option>
        <option value="5" selected>5</option>
        <option value="20">20</option>
        <option value="100">100</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Random 32-bit number</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Counter on each machine</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Time and sequence, no machine</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Time, machine and sequence</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Same, clock set back, no guard</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
      <div class="pg-box" data-b6><h3>Same, clock set back, with guard</h3><span class="pg-mono" data-o6></span><span class="pg-note" data-n6></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 100 milliseconds; each machine makes the chosen number of IDs every millisecond. In the last two designs machine 0's clock is set back by 5 ms at millisecond 50. "In order" is the share of 3,000 random pairs of IDs, made in different milliseconds, where the later one has the larger number.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-idb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const T = 100; const BACK = 5; const AT = 50;
    type Rec = { ms: number; id: number };
    function simulate(design: number, machines: number, rate: number): { recs: Rec[]; stalled: number } {
      let a = 41 + design; // a small random number generator (mulberry32)
      const rnd = () => { a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
      const counters = new Array(machines).fill(0); const recs: Rec[] = []; let stalled = 0; let lastUsed = new Array(machines).fill(-1);
      for (let ms = 0; ms < T; ms++) {
        for (let m = 0; m < machines; m++) {
          let clock = ms;
          if (design >= 5 && m === 0 && ms >= AT) clock = ms - BACK; // this machine's clock was set back
          if (design === 6 && clock <= lastUsed[m] && lastUsed[m] >= 0 && clock < lastUsed[m] + 1 && ms >= AT && ms < AT + BACK) { stalled += rate; continue; } // waits until the clock passes the last time it used
          for (let k = 0; k < rate; k++) {
            let id: number;
            if (design === 1) { id = Math.floor(rnd() * 4294967296); }
            else if (design === 2) { id = counters[m]++; }
            else if (design === 3) { id = clock * 1000 + k; }
            else { id = clock * 1e6 + m * 1000 + k; }
            recs.push({ ms, id });
          }
          lastUsed[m] = Math.max(lastUsed[m], clock);
        }
      }
      return { recs, stalled };
    }
    function order(recs: Rec[]) {
      let seed = 5; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
      let good = 0; let total = 0;
      for (let i = 0; i < 6000 && total < 3000; i++) { const a = recs[Math.floor(rnd() * recs.length)]; const b = recs[Math.floor(rnd() * recs.length)]; if (a.ms === b.ms) continue; total++; if ((a.ms < b.ms) === (a.id < b.id) && a.id !== b.id) good++; }
      return total ? (good / total) * 100 : 100;
    }
    function draw() {
      const machines = Number(q<HTMLInputElement>('[data-m]').value); const rate = Number(q<HTMLSelectElement>('[data-r]').value);
      q('[data-mval]').textContent = String(machines);
      const res: { dup: number; total: number; ord: number; stalled: number }[] = [];
      for (let d = 1; d <= 6; d++) {
        const { recs, stalled } = simulate(d, machines, rate);
        const seen = new Set<number>(); let dup = 0; recs.forEach((r) => { if (seen.has(r.id)) dup++; else seen.add(r.id); });
        res.push({ dup, total: recs.length, ord: order(recs), stalled });
        const k = d;
        q(`[data-o${k}]`).textContent = dup === 0 ? '0 duplicates' : `${dup.toLocaleString('en-US')} duplicates`;
        q(`[data-n${k}]`).textContent = `of ${recs.length.toLocaleString('en-US')} IDs · ${Math.round(order(recs))}% in order${stalled ? ` · machine 0 paused, ${stalled} IDs delayed` : ''}`;
        q<HTMLElement>(`[data-b${k}]`).style.setProperty('--c', dup === 0 && order(recs) > 99 ? 'var(--good)' : 'var(--bad)');
      }
      const out = q('[data-verdict]'); const bad = res.slice(0, 3).some((r) => r.dup > 0) || res[4].dup > 0; out.classList.toggle('bad', bad);
      out.textContent = machines === 1 ? 'With one machine the weak designs seem to work. Add machines to see them fail.'
        : `Random numbers repeated ${res[0].dup} times, counters ${res[1].dup.toLocaleString('en-US')} times and time without a machine number ${res[2].dup.toLocaleString('en-US')} times. With a machine number there are ${res[3].dup}. A clock set back repeated ${res[4].dup} IDs unless the generator checks for it (${res[5].dup}).`;
    }
    let queued = false; // the simulation is a little heavy, so run it at most once per frame while a slider moves
    const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; draw(); }); } };
    root.addEventListener('input', schedule); root.addEventListener('change', schedule);
    draw();
  });
</script>
