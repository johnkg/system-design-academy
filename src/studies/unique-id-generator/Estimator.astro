---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="See how far the 64-bit layout stretches, and what a bigger key costs once there are billions of rows.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Machines making IDs" name="m" min="1" max="1024" value="200" />
      <RangeField label="IDs per machine per second" name="r" min="100" max="500000" step="100" value="20000" />
      <RangeField label="Rows stored (billions)" name="rows" min="1" max="500" value="50" />
      <RangeField label="Indexes that contain the ID (each stores a copy)" name="ix" min="1" max="5" value="2" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Layout: 41 bits of milliseconds (about 69.7 years), 10 bits of machine number (1,024 machines), 12 bits of sequence (4,096 IDs per machine per millisecond). A 64-bit ID takes 8 bytes and a UUID 16 bytes.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 8; // one per output line
    const SEQ_PER_MS = 4096; const MS_PER_S = 1000; const DAY_S = 86400; const BILLION = 1e9; // 12-bit sequence per millisecond
    const EPOCH_YEAR = 2025; const TIME_FIELD_YEARS = 69; // a 41-bit millisecond field lasts about 69 years
    const MAX_MACHINES = 1024; const BYTES = { id64: 8, uuid: 16 };
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const m = val('[data-m]'); const r = val('[data-r]'); const billions = val('[data-rows]'); const ix = val('[data-ix]');
      ['m', 'r', 'rows', 'ix'].forEach((k) => (q(`[data-${k}val]`).textContent = fmt(val(`[data-${k}]`))));
      const cap = SEQ_PER_MS * MS_PER_S; const copies = 1 + ix;
      const data: [string, string][] = [
        ['IDs per second across the fleet', fmt(m * r)],
        ['One machine can make at most (per second)', fmt(cap)],
        ['Headroom on each machine', r > cap ? `short by ${fmt(r / cap)} times` : `${fmt(cap / r)} times`],
        ['IDs per day', `${fmt((m * r * DAY_S) / BILLION)} billion`],
        ['Time field lasts until about', String(EPOCH_YEAR + TIME_FIELD_YEARS)],
        ['Machine numbers left unused', fmt(MAX_MACHINES - m)],
        ['ID storage as 64-bit keys', `${fmt((billions * BYTES.id64 * copies))} GB`],
        ['ID storage as 128-bit UUIDs', `${fmt((billions * BYTES.uuid * copies))} GB`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
