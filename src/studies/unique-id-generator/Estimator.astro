---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="See how far the 64-bit layout stretches, and what a bigger key costs once there are billions of rows.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Machines making IDs <input type="range" min="1" max="1024" value="200" data-m /> <b data-mval></b></label>
      <label>IDs per machine per second <input type="range" min="100" max="500000" step="100" value="20000" data-r /> <b data-rval></b></label>
      <label>Rows stored (billions) <input type="range" min="1" max="500" value="50" data-rows /> <b data-rowsval></b></label>
      <label>Indexes that contain the ID (each stores a copy) <input type="range" min="1" max="5" value="2" data-ix /> <b data-ixval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Layout: 41 bits of milliseconds (about 69.7 years), 10 bits of machine number (1,024 machines), 12 bits of sequence (4,096 IDs per machine per millisecond). A 64-bit ID takes 8 bytes and a UUID 16 bytes.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const m = val('[data-m]'); const r = val('[data-r]'); const billions = val('[data-rows]'); const ix = val('[data-ix]');
      ['m', 'r', 'rows', 'ix'].forEach((k) => (q(`[data-${k}val]`).textContent = fmt(val(`[data-${k}]`))));
      const cap = 4096 * 1000; const copies = 1 + ix;
      const data: [string, string][] = [
        ['IDs per second across the fleet', fmt(m * r)],
        ['One machine can make at most (per second)', fmt(cap)],
        ['Headroom on each machine', r > cap ? `short by ${fmt(r / cap)} times` : `${fmt(cap / r)} times`],
        ['IDs per day', `${fmt((m * r * 86400) / 1e9)} billion`],
        ['Time field lasts until about', String(2025 + 69)],
        ['Machine numbers left unused', fmt(1024 - m)],
        ['ID storage as 64-bit keys', `${fmt((billions * 8 * copies))} GB`],
        ['ID storage as 128-bit UUIDs', `${fmt((billions * 16 * copies))} GB`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
