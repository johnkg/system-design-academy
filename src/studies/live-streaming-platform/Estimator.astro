---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Viewers times bitrate sets the bandwidth bill, broadcasters times renditions sets the transcoding bill, and the shield decides what the origin sees.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Concurrent viewers (thousands) <input type="range" min="10" max="10000" step="10" value="2000" data-v /> <b data-vval></b></label>
      <label>Average delivered bitrate (kbit/s) <input type="range" min="500" max="8000" step="100" value="2500" data-br /> <b data-brval></b></label>
      <label>Concurrent live broadcasters <input type="range" min="100" max="20000" step="100" value="2000" data-bc /> <b data-bcval></b></label>
      <label>Renditions in the ladder <input type="range" min="2" max="8" value="5" data-r /> <b data-rval></b></label>
      <label>Segment length (seconds) <input type="range" min="1" max="10" value="2" data-seg /> <b data-segval></b></label>
      <label>CDN points of presence <input type="range" min="20" max="500" step="20" value="100" data-pop /> <b data-popval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: one edge server delivers 28 Gbit/s (a 40 Gbit/s card at 70%), a broadcaster sends 6 Mbit/s, transcoding one rendition in real time takes about 1.5 CPU cores, the origin shield is 4 nodes, and every point of presence is watching the one popular stream. Latency adds 0.3 s of ingest, 0.5 s of transcoding and 0.4 s of delivery to one segment and a hold-back of three segments (or three parts).</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 9; // one per output line
    const THOUSAND = 1000; const KBIT_PER_TBIT = 1e9; const GBIT_PER_TBIT = 1000; const MBIT_PER_GBIT = 1000;
    const EDGE_GBPS = 28; // usable egress per edge server
    const INGEST_MBPS = 6; // per broadcaster
    const CORES_PER_RENDITION = 1.5; const SHIELDS = 4; // origin shields in front of the origin
    const LATENCY = { fixedS: 1.2, buffered: 4, partS: 0.5 }; // capture, encode and network; segments (or parts) the player holds
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const v = val('[data-v]') * THOUSAND; const br = val('[data-br]'); const bc = val('[data-bc]'); const r = val('[data-r]'); const seg = val('[data-seg]'); const pop = val('[data-pop]');
      ['v', 'br', 'bc', 'r', 'seg', 'pop'].forEach((k) => (q(`[data-${k}val]`).textContent = fmt(val(`[data-${k}]`))));
      const egressTbps = (v * br) / KBIT_PER_TBIT; const servers = Math.ceil((egressTbps * GBIT_PER_TBIT) / EDGE_GBPS);
      const ingestGbps = (bc * INGEST_MBPS) / MBIT_PER_GBIT; const cores = bc * r * CORES_PER_RENDITION; const objects = (bc * r) / seg;
      const direct = (pop * r) / seg; const shielded = (SHIELDS * r) / seg;
      const lat = LATENCY.fixedS + LATENCY.buffered * seg; const latParts = LATENCY.fixedS + LATENCY.buffered * LATENCY.partS;
      const data: [string, string][] = [
        ['Viewer bandwidth leaving the CDN', `${egressTbps.toFixed(2)} Tbit/s`],
        ['Edge servers needed for it', fmt(servers)],
        ['Ingest bandwidth', `${ingestGbps.toFixed(1)} Gbit/s`],
        ['CPU cores for real-time transcoding', fmt(cores)],
        ['Segments written per second, all renditions', fmt(objects)],
        ['Origin requests per second for one popular stream, no shield', fmt(direct)],
        ['Origin requests per second for it, with the shield', fmt(shielded)],
        ['Glass-to-glass latency with whole segments', `${lat.toFixed(1)} s`],
        ['Glass-to-glass latency with half-second parts', `${latParts.toFixed(1)} s`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
