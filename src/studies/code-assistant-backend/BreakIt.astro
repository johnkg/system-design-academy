---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="One request per keystroke" hint="A developer types a line of 60 characters, pausing for 600 milliseconds after every tenth one. Choose how long the extension waits for a pause before it asks, and whether it cancels a request when more typing arrives, and see how many requests are sent and how many answers are still useful.">
  <ol class="how">
    <li>The default asks at once and never cancels: <b>60</b> requests are sent, only <b>6</b> answers arrive while they are still relevant, <b>54</b> arrive too late, the model does <b>60</b> requests of work, and <b>90.0</b> percent of it is wasted.</li>
    <li>Set <b>Cancel when typing continues</b> to <b>Yes</b>: the model's work falls to <b>33</b> requests, because a cancelled request is stopped half way, and the wasted share to <b>81.8</b> percent.</li>
    <li>Set <b>Cancel when typing continues</b> to <b>No</b> and <b>Wait for a pause</b> to <b>300 ms</b>: only <b>6</b> requests are sent, all <b>6</b> answers are still relevant, <b>0</b> arrive late, and <b>0.0</b> percent of the work is wasted.</li>
    <li>Set <b>Wait for a pause</b> to <b>500 ms</b>: still <b>6</b> requests, but waiting that long plus the model's delay means <b>0</b> answers are in time and <b>100.0</b> percent of the work is wasted. A wait that is too long is as bad as none.</li>
  </ol>
  <div class="pg kst" data-kst>
    <div class="pg-row">
      <RangeField label="Typing speed (characters per second)" name="cps" min="2" max="10" value="5" />
      <RangeField label="Model delay (ms)" name="lat" min="100" max="800" step="50" value="250" />
      <label>Wait for a pause <select class="pg-in" data-wait>
        <option value="0" selected>No wait</option>
        <option value="150">150 ms</option>
        <option value="300">300 ms</option>
        <option value="500">500 ms</option>
      </select></label>
      <label>Cancel when typing continues <select class="pg-in" data-cancel>
        <option value="0" selected>No</option>
        <option value="1">Yes</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Requests sent</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Answers still relevant on arrival</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Answers that arrive too late</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Model work, in whole requests</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 60 key presses. The gap after a key is 1000 divided by the typing speed, except 600 ms after every tenth key. A request is sent after a key if the gap is at least the wait. Its answer arrives after the wait plus the model's delay, and is relevant only if that is before the next key. A cancelled request is stopped half way and costs half a request.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-kst]').forEach((root) => {
    const q = query(root);
    const KEYS = 60; const PAUSE_EVERY = 10; const PAUSE_MS = 600; const CANCEL_COST = 0.5;
    const trim = (n: number) => String(Number(n.toFixed(2)));
    type Tone = 'good' | 'bad' | 'mid';
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const cps = Number(q<HTMLInputElement>('[data-cps]').value), lat = Number(q<HTMLInputElement>('[data-lat]').value);
      const wait = Number(q<HTMLSelectElement>('[data-wait]').value), cancel = q<HTMLSelectElement>('[data-cancel]').value === '1';
      q('[data-cpsval]').textContent = String(cps); q('[data-latval]').textContent = String(lat);
      let sent = 0, useful = 0, stale = 0;
      for (let i = 1; i <= KEYS; i++) {
        const gap = i % PAUSE_EVERY === 0 ? PAUSE_MS : Math.round(1000 / cps);
        if (gap < wait) continue;
        sent++;
        if (wait + lat <= gap) useful++; else stale++;
      }
      const wasted = stale * (cancel ? CANCEL_COST : 1), work = useful + wasted;
      const share = work === 0 ? 0 : (100 * wasted) / work;
      setBox(1, String(sent), wait === 0 ? 'one request for every key press' : `only after a pause of at least ${wait} ms`, sent > 20 ? 'bad' : 'good');
      setBox(2, String(useful), 'the answer is there before the developer types again', useful === sent && sent > 0 ? 'good' : 'mid');
      setBox(3, String(stale), cancel ? 'these are cancelled, so only half the work is spent' : 'the developer has already typed on, so these are shown to nobody', stale > 0 ? 'bad' : 'good');
      setBox(4, trim(work), `${share.toFixed(1)} percent of it was wasted on answers that came too late`, share > 50 ? 'bad' : 'good');
      q('[data-verdict]').textContent = wait === 0 && !cancel ? 'Every key press starts a full request, and almost every answer is stale on arrival. Waiting for a pause and cancelling remove this work at the source.'
        : wait + lat > PAUSE_MS ? 'The wait and the model together take longer than a typing pause, so no answer arrives in time. The wait must be shorter than the pauses it is meant to catch.'
        : 'The assistant now asks when the developer has paused, and the answer is still relevant when it arrives.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
