---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Completions are frequent and short, chat is rare and large, and the repository sets the size of the index. The numbers are worked out from the assumptions below, not measured on any product.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Developers (thousands)" name="dev" min="1" max="200" value="20" />
      <RangeField label="Active hours per developer per day" name="hrs" min="1" max="8" value="4" />
      <RangeField label="Requests per active hour, after waiting for a pause" name="req" min="50" max="1000" step="50" value="300" />
      <RangeField label="Requests cancelled by more typing (%)" name="canc" min="0" max="90" step="5" value="60" />
      <RangeField label="Tokens sent per completion" name="cin" min="500" max="8000" step="500" value="2500" />
      <RangeField label="Tokens in a completion" name="cout" min="10" max="300" step="10" value="60" />
      <RangeField label="Share of the prompt that is cached (%)" name="hit" min="0" max="90" step="5" value="50" />
      <RangeField label="Chat questions per developer per day" name="cq" min="0" max="40" value="8" />
      <RangeField label="Tokens of context per chat question" name="ctx" min="2000" max="30000" step="1000" value="8000" />
      <RangeField label="Tokens in a chat answer" name="aout" min="100" max="1500" step="100" value="500" />
      <RangeField label="Repository size (million lines)" name="loc" min="1" max="100" value="5" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 15 percent of a day's requests fall in the busiest hour; a cancelled request is billed for its prompt and not for an answer; the completion model costs 0.50 dollars per million input tokens and 1.50 per million output tokens; the chat model costs 3 and 15 dollars; an index chunk is 40 lines, with a vector of 768 numbers of 4 bytes and 1.5 times overhead. The keyword index and the stored code are extra. Cached prompt tokens are counted as free here; in practice they are billed at a reduced rate or cost memory on the serving side.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatWholeNumber } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 9; // one per output line
    const THOUSAND = 1e3; const MILLION = 1e6; const GB = 1e9; const HOUR_S = 3600;
    const PEAK_SHARE = 0.15; const CHUNK_LINES = 40; const DIMS = 768; const VECTOR_BYTES = 4; const INDEX_OVERHEAD = 1.5;
    const SMALL = { inM: 0.5, outM: 1.5 }; const BIG = { inM: 3, outM: 15 }; // dollars per million tokens
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
    const fmt2 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 2 });
    function draw() {
      const dev = val('[data-dev]') * THOUSAND; const hrs = val('[data-hrs]'); const req = val('[data-req]'); const canc = val('[data-canc]') / 100;
      const cin = val('[data-cin]'); const cout = val('[data-cout]'); const hit = val('[data-hit]') / 100;
      const cq = val('[data-cq]'); const ctx = val('[data-ctx]'); const aout = val('[data-aout]'); const loc = val('[data-loc]') * MILLION;
      ['dev', 'hrs', 'req', 'canc', 'cin', 'cout', 'hit', 'cq', 'ctx', 'aout', 'loc'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const sentDev = hrs * req; const sent = dev * sentDev; const shown = sent * (1 - canc);
      const qps = (sent * PEAK_SHARE) / HOUR_S;
      const inTps = qps * cin * (1 - hit); const outTps = qps * (1 - canc) * cout;
      const chatDay = dev * cq; const chatQps = (chatDay * PEAK_SHARE) / HOUR_S;
      const completionCost = (sentDev * cin * (1 - hit) * SMALL.inM + sentDev * (1 - canc) * cout * SMALL.outM) / MILLION;
      const chatCost = (cq * (ctx * BIG.inM + aout * BIG.outM)) / MILLION;
      const indexGb = (loc / CHUNK_LINES) * DIMS * VECTOR_BYTES * INDEX_OVERHEAD / GB;
      const data: [string, string][] = [
        ['Completion requests sent per day', formatWholeNumber(sent)],
        ['Completions that reach the screen', formatWholeNumber(shown)],
        ['Completion requests per second in the busiest hour', formatWholeNumber(qps)],
        ['Model input tokens per second at the peak, after the cache', formatWholeNumber(inTps)],
        ['Model output tokens per second at the peak', formatWholeNumber(outTps)],
        ['Chat questions per day', formatWholeNumber(chatDay)],
        ['Chat questions per second in the busiest hour', fmt1(chatQps)],
        ['Model cost per developer per day', `$${fmt2(completionCost + chatCost)}`],
        ['Index size for one repository', `${fmt2(indexGb)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
