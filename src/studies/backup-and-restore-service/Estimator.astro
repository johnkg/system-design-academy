---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Storage is set by how long you keep full backups, restore time by the chain length and the pipe, and the throttle by how big a full is.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Databases" name="n" min="50" max="2000" step="50" value="500" />
      <RangeField label="Average size (GB)" name="gb" min="50" max="2000" step="50" value="400" />
      <RangeField label="Share that changes per day (%)" name="ch" min="1" max="30" value="5" />
      <RangeField label="Compression ratio (x)" name="cr" min="1" max="6" value="3" />
      <RangeField label="Retention (days)" name="ret" min="7" max="365" step="7" value="35" />
      <RangeField label="Full backup every (days)" name="fe" min="1" max="30" value="7" />
      <RangeField label="Backup window (hours)" name="win" min="1" max="24" value="6" />
      <RangeField label="Copies in other regions" name="cp" min="0" max="3" value="1" />
      <RangeField label="Restore bandwidth for the fleet (Gbps)" name="bw" min="5" max="200" step="5" value="40" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a full backup is the whole database, an incremental holds the changed share of one day, and both are compressed by the ratio. A restore writes data at 200 MB/s per database and applies up to one chain of incrementals, and a whole-fleet restore is limited by the download bandwidth of the compressed chains. Backups are spread evenly so that each database takes its own full on its own day, and a full must finish within the window.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 12; // output lines below
    const GB_PER_TB = 1000; const MB_PER_GB = 1000; const BYTES_PER_TB = 1e12; const BITS_PER_BYTE = 8; const BITS_PER_GBIT = 1e9;
    const DAY_S = 86400; const HOUR_S = 3600;
    const RESTORE_MBS = 200; // read rate of one database restore, MB/s
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const one = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const n = val('[data-n]'); const gb = val('[data-gb]'); const ch = val('[data-ch]') / 100; const cr = val('[data-cr]'); const ret = val('[data-ret]');
      const fe = val('[data-fe]'); const win = val('[data-win]'); const cp = val('[data-cp]'); const bw = val('[data-bw]');
      ['n', 'gb', 'ch', 'cr', 'ret', 'fe', 'win', 'cp', 'bw'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const rawTb = (n * gb) / GB_PER_TB; const fullTb = rawTb / cr; const incTb = (rawTb * ch) / cr;
      const fulls = Math.ceil(ret / fe); const incs = Math.max(0, ret - fulls);
      const primaryTb = fulls * fullTb + incs * incTb; const totalTb = primaryTb * (1 + cp);
      const dayTb = (fullTb + (fe - 1) * incTb) / fe;
      const xGbps = (dayTb * BYTES_PER_TB * BITS_PER_BYTE * cp) / DAY_S / BITS_PER_GBIT;
      const fullMBs = (gb * MB_PER_GB) / (win * HOUR_S);
      const chainGb = gb + (fe - 1) * gb * ch;
      const restoreH = (chainGb * MB_PER_GB) / RESTORE_MBS / HOUR_S;
      const fleetTb = fullTb + (fe - 1) * incTb;
      const fleetH = (fleetTb * BYTES_PER_TB * BITS_PER_BYTE) / (bw * BITS_PER_GBIT) / HOUR_S;
      const data: [string, string][] = [
        ['Data in the fleet', `${one(rawTb)} TB`],
        ['One full backup of the fleet, compressed', `${one(fullTb)} TB`],
        ['One day of incrementals, compressed', `${one(incTb)} TB`],
        ['Full backups and incrementals kept', `${fmt(fulls)} and ${fmt(incs)}`],
        ['Stored in the primary region', `${fmt(primaryTb)} TB`],
        ['Stored in all regions', `${fmt(totalTb)} TB`],
        ['Backup data written per day, on average', `${one(dayTb)} TB`],
        ['Cross-region transfer, sustained', `${one(xGbps)} Gbps`],
        ['Read rate per database to finish a full in the window', `${one(fullMBs)} MB/s`],
        ['Restore of one database, with a full chain', `${one(restoreH)} hours`],
        ['Compressed data to download for a whole-fleet restore', `${one(fleetTb)} TB`],
        ['Whole-fleet restore time, limited by bandwidth', `${one(fleetH)} hours`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
