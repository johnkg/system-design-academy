---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Matching is cheap next to the people. What decides the size of the team is the share of payments that still end up as a break after the rules have run.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Card payments per day (millions)" name="p" min="1" max="20" step="0.5" value="5" />
      <RangeField label="Processors that send a settlement file" name="n" min="1" max="12" value="4" />
      <RangeField label="Extra lines per 100 payments (refunds, chargebacks)" name="x" min="0" max="30" value="8" />
      <RangeField label="Bytes per row in a file" name="by" min="100" max="1000" step="50" value="250" />
      <RangeField label="Rows one core matches per second (thousands)" name="r" min="5" max="100" step="5" value="20" />
      <RangeField label="Minutes allowed after the last file arrives" name="w" min="10" max="120" step="10" value="30" />
      <RangeField label="Payments left as a break after the rules (per 10,000)" name="b" min="1" max="50" value="2" />
      <RangeField label="Minutes a person spends on one break" name="m" min="1" max="30" value="6" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: every payment is one ledger line, and refunds and chargebacks add the extra lines on both the ledger and the processor side. Each processor sends one file a day, and the bank statement is small next to them. Matching reads the ledger side and the processor side once. A match is a lookup and a compare, so one core does the rate above. A person has about 6 productive hours a day for breaks. Real break rates after the rules are much lower than in the simulation, and they depend on how clean the sources are.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatWholeNumber, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const MILLION = 1e6, THOUSAND = 1e3, DAY_S = 86400, MIN_S = 60, GB = 1e9, PER_100 = 100, PER_10000 = 10000;
    const SIDES = 2; // ledger side and processor side
    const OPEN_DAYS = 5; // business days that stay open for late and corrected files
    const HOURS_PER_ANALYST = 6, MIN_PER_HOUR = 60;
    const N_ROWS = 9;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const p = val('[data-p]') * MILLION, n = val('[data-n]'), x = val('[data-x]'), by = val('[data-by]');
      const rate = val('[data-r]') * THOUSAND, w = val('[data-w]'), b = val('[data-b]'), m = val('[data-m]');
      ['p', 'n', 'x', 'by', 'r', 'w', 'b', 'm'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const lines = p * (1 + x / PER_100);
      const matchRows = lines * SIDES;
      const cores = Math.ceil(matchRows / (rate * w * MIN_S));
      const breaks = (p * b) / PER_10000;
      const hours = (breaks * m) / MIN_PER_HOUR;
      const data: [string, string][] = [
        ['Payments per second, on average', formatOneDecimalBelow100(p / DAY_S)],
        ['Lines a day, with refunds and chargebacks', formatWholeNumber(lines)],
        ['Rows in an average processor file', formatWholeNumber(lines / n)],
        ['Processor files landed per day, in GB', formatOneDecimalBelow100((lines * by) / GB)],
        ['Rows the matcher reads, both sides', formatWholeNumber(matchRows)],
        ['Cores to finish matching inside the window', formatWholeNumber(cores)],
        ['Partitions open at once (processor by day)', formatWholeNumber(n * OPEN_DAYS)],
        ['Breaks for people per day', formatWholeNumber(breaks)],
        ['Analysts needed for those breaks', formatWholeNumber(Math.ceil(hours / HOURS_PER_ANALYST))],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
