---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How much storage and memory a photo store needs, how many storage machines that means, and how many disk reads a peak of requests costs with a file per photo and with Haystack. A teaching model with round numbers, not Facebook's data.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Photos stored (billions)" name="p" min="1" max="50" step="1" value="15" />
      <RangeField label="Sizes stored per photo" name="z" min="1" max="6" value="4" />
      <RangeField label="Average size of one image (KB)" name="k" min="5" max="200" step="5" value="25" />
      <RangeField label="New photos per week (millions)" name="w" min="10" max="500" step="10" value="220" />
      <RangeField label="Peak images served per second (thousands)" name="q" min="50" max="1000" step="50" value="550" />
      <RangeField label="Usable storage per machine (TB)" name="t" min="2" max="20" step="1" value="10" />
      <RangeField label="Memory per index entry (bytes)" name="e" min="2" max="32" step="1" value="8" />
      <RangeField label="Disk reads per image in the file-per-photo layout" name="n" min="2" max="6" value="3" />
      <RangeField label="Reads one disk can do per second" name="i" min="50" max="300" step="10" value="100" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Teaching model, not Facebook's system or data. The 2009 post gives: more than 15 billion photos stored in four sizes (60 billion images, 1.5 PB), 220 million new photos a week (about 25 TB), a peak of 550,000 images per second, storage blades with about 10 TB usable and 16 to 32 GB of memory, and an index with about 2 bits of overhead per entry. The memory per entry, the reads per disk and the reads per image in the old layout are my guesses that you can change. Assumptions: every request goes to the origin (no CDN), reads and storage are spread evenly over machines and disks, and a Haystack read takes one disk read.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 11; // lines in the result list
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const f1 = formatOneDecimalBelow100;
    const pct = (n: number) => `${(Math.round(n * 1000) / 1000).toLocaleString('en-US')}%`;
    function draw() {
      ['p', 'z', 'k', 'w', 'q', 't', 'e', 'n', 'i'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const photos = val('[data-p]') * 1e9; const sizes = val('[data-z]'); const kb = val('[data-k]'); const weekly = val('[data-w]') * 1e6;
      const peak = val('[data-q]') * 1000; const tbPer = val('[data-t]'); const entry = val('[data-e]'); const oldReads = val('[data-n]'); const iops = val('[data-i]');
      const images = photos * sizes; const petabytes = (images * kb * 1000) / 1e15;
      const machines = Math.ceil((petabytes * 1000) / tbPer); const perMachine = images / machines;
      const indexGb = (perMachine * entry) / 1e9;
      const data: [string, string][] = [
        ['Images stored (billions)', f1(images / 1e9)],
        ['Storage for all images (PB)', f1(petabytes)],
        ['Growth each week (TB)', f1((weekly * sizes * kb * 1000) / 1e12)],
        ['Storage machines needed', f1(machines)],
        ['Images on each machine (millions)', f1(perMachine / 1e6)],
        ['Memory for the index on each machine (GB)', f1(indexGb)],
        ['Share of a 32 GB machine used by the index', `${f1((100 * indexGb) / 32)}%`],
        ['Disk reads per second at the peak, file per photo (thousands)', f1((peak * oldReads) / 1000)],
        ['Disk reads per second at the peak, Haystack (thousands)', f1(peak / 1000)],
        ['Disks busy at the peak, file per photo', f1((peak * oldReads) / iops)],
        ['Disks busy at the peak, Haystack', f1(peak / iops)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
