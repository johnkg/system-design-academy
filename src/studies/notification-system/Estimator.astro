---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Change the audience and see what the pipeline has to handle.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Users (millions) <input type="range" min="1" max="500" value="50" data-users /> <b data-usersval></b></label>
      <label>Notifications per user per day <input type="range" min="1" max="20" value="4" data-per /> <b data-perval></b></label>
      <label>Campaign size (millions) <input type="range" min="0.1" max="100" step="0.1" value="10" data-blast /> <b data-blastval></b></label>
      <label>Campaign must finish in (minutes) <input type="range" min="5" max="120" step="5" value="30" data-mins /> <b data-minsval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: peak traffic is 5 times the average, one sender worker makes about 100 provider calls per second, and a record in the sent log takes about 300 bytes and is kept for 30 days.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const OUT_ROWS = 7; // lines in the result list
    const MILLION = 1e6, DAY_S = 86400, MIN_S = 60, GB = 1e9, GB_PER_TB = 1000;
    const PEAK = 5; // peak over the daily average
    const WORKER_RATE = 100; // sends per second one worker makes
    const LOG = { days: 30, bytes: 300 }; // the sent log keeps 30 days at 300 bytes a row
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const users = val('[data-users]'); const per = val('[data-per]'); const blast = val('[data-blast]'); const mins = val('[data-mins]');
      q('[data-usersval]').textContent = String(users); q('[data-perval]').textContent = String(per); q('[data-blastval]').textContent = String(blast); q('[data-minsval]').textContent = String(mins);
      const daily = users * MILLION * per; const avg = daily / DAY_S; const peak = avg * PEAK; const blastRate = (blast * MILLION) / (mins * MIN_S);
      const logGb = (daily * LOG.days * LOG.bytes) / GB;
      const data: [string, string][] = [
        ['Notifications per day', `${fmt(daily / MILLION)} million`],
        ['Average per second', fmt(avg)],
        [`Peak per second (${PEAK} times average)`, fmt(peak)],
        ['Campaign send rate needed', `${fmt(blastRate)} per second`],
        ['Workers for everyday peak', fmt(Math.max(1, Math.ceil(peak / WORKER_RATE)))],
        ['Workers for the campaign', fmt(Math.max(1, Math.ceil(blastRate / WORKER_RATE)))],
        [`Sent log after ${LOG.days} days`, logGb >= GB_PER_TB ? `${(logGb / GB_PER_TB).toFixed(1)} TB` : `${logGb.toFixed(0)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
