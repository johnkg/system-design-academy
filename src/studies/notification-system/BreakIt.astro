---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Blast vs login codes" hint="Workers can send 100 messages per second. A campaign arrives all at once, and login codes keep arriving at 10 per second for a minute.">
  <p>Pick one shared queue or separate queues, then change the campaign size and see how long a login code waits.</p>
  <div class="pg nsa" data-nsa>
    <div class="pg-row">
      <label>Queues <select class="pg-in" data-layout><option value="shared" selected>One shared queue</option><option value="split">Urgent queue + bulk queue</option></select></label>
      <label>Campaign size <select class="pg-in" data-size><option value="1000">1,000</option><option value="5000">5,000</option><option value="20000" selected>20,000</option></select></label>
    </div>
    <div class="pg-grid" aria-live="polite">
      <div class="pg-box" data-box><h3>Login code wait</h3><span class="pg-mono" data-wait></span><span class="pg-note" data-waitnote></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Campaign finished after</h3><span class="pg-mono" data-done></span></div>
    </div>
  </div>
</PlaygroundShell>
<PlaygroundShell title="Flaky provider, retries and duplicates" hint="1,000 notifications go to a provider that sometimes fails, and sometimes delivers but the answer is lost.">
  <ol class="how">
    <li>With <b>no retries</b>, every failed call is a lost notification. Turn on <b>up to 3 attempts</b> and delivery recovers.</li>
    <li>But now lost answers cause <b>duplicates</b>: the message was delivered, the sender did not hear, so it sent it again.</li>
    <li>Tick <b>idempotency key</b>: duplicates disappear and nothing is lost.</li>
  </ol>
  <div class="pg nsb" data-nsb>
    <div class="pg-row">
      <label>Provider fails <input type="range" min="0" max="60" step="5" value="30" data-fail /> <b data-failval></b></label>
      <label>Answer lost after delivering <input type="range" min="0" max="30" step="5" value="10" data-lost /> <b data-lostval></b></label>
    </div>
    <div class="pg-row">
      <label>Retries <select class="pg-in" data-retries><option value="1" selected>No retries</option><option value="3">Up to 3 attempts</option></select></label>
      <label class="nsb-check"><input type="checkbox" data-key /> Send an idempotency key</label>
    </div>
    <div class="pg-grid" aria-live="polite">
      <div class="pg-box" data-got><h3>Received at least once</h3><span class="pg-mono" data-gotval></span></div>
      <div class="pg-box" data-dup><h3>Received more than once</h3><span class="pg-mono" data-dupval></span></div>
      <div class="pg-box" style="--c: var(--role-3)"><h3>Provider calls made</h3><span class="pg-mono" data-calls></span></div>
    </div>
  </div>
</PlaygroundShell>
<script>
  function prng(seed: number) { let s = seed >>> 0; return () => { s = (s + 0x6d2b79f5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }

  document.querySelectorAll<HTMLElement>('[data-nsa]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const PER_TICK = 10; // 100 messages per second, in 100 ms ticks
    function draw() {
      const split = q<HTMLSelectElement>('[data-layout]').value === 'split'; const size = Number(q<HTMLSelectElement>('[data-size]').value);
      let bulk = size; const urgent: number[] = []; const shared: { urgent: boolean; at: number }[] = [];
      for (let i = 0; i < size; i++) shared.push({ urgent: false, at: 0 });
      let waits: number[] = []; let doneAt = 0; let head = 0;
      for (let tick = 0; tick < 6000; tick++) {
        if (tick < 600) { if (split) urgent.push(tick); else shared.push({ urgent: true, at: tick }); } // one login code per tick = 10 per second
        let cap = PER_TICK;
        if (split) {
          while (cap > 0 && urgent.length) { waits.push(tick - urgent.shift()!); cap--; }
          const n = Math.min(cap, bulk); bulk -= n; if (n && bulk === 0) doneAt = tick;
        } else {
          while (cap > 0 && head < shared.length && shared[head].at <= tick) { const m = shared[head++]; if (m.urgent) waits.push(tick - m.at); else { bulk--; if (bulk === 0) doneAt = tick; } cap--; }
        }
        if (tick >= 600 && !urgent.length && head >= shared.length && bulk <= 0) break;
      }
      const avg = waits.reduce((a, b) => a + b, 0) / waits.length / 10; const max = Math.max(...waits) / 10;
      q('[data-wait]').textContent = `average ${avg.toFixed(1)} s, worst ${max.toFixed(1)} s`;
      q('[data-waitnote]').textContent = max > 5 ? 'users are waiting for their code' : 'arrives in seconds';
      q('[data-done]').textContent = `${(doneAt / 10).toFixed(0)} s`;
      q<HTMLElement>('[data-box]').style.setProperty('--c', max > 5 ? 'var(--bad)' : 'var(--role-2)');
    }
    root.addEventListener('change', draw);
    draw();
  });

  document.querySelectorAll<HTMLElement>('[data-nsb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    function draw() {
      const fail = val('[data-fail]') / 100; const lost = val('[data-lost]') / 100; const attempts = Number(q<HTMLSelectElement>('[data-retries]').value); const key = q<HTMLInputElement>('[data-key]').checked;
      q('[data-failval]').textContent = `${Math.round(fail * 100)}%`; q('[data-lostval]').textContent = `${Math.round(lost * 100)}%`;
      const rnd = prng(12345); let got = 0; let dup = 0; let calls = 0;
      for (let m = 0; m < 1000; m++) {
        let delivered = 0;
        for (let a = 0; a < attempts; a++) {
          calls++;
          if (rnd() < fail) continue; // failed before delivering
          if (!(key && delivered > 0)) delivered++; // an idempotency key makes a repeat harmless
          if (rnd() < lost) continue; // delivered, but the sender never heard
          break;
        }
        if (delivered > 0) got++; if (delivered > 1) dup++;
      }
      q('[data-gotval]').textContent = `${got} of 1000`; q('[data-dupval]').textContent = String(dup); q('[data-calls]').textContent = String(calls);
      q<HTMLElement>('[data-got]').style.setProperty('--c', got < 1000 ? 'var(--bad)' : 'var(--role-2)');
      q<HTMLElement>('[data-dup]').style.setProperty('--c', dup > 0 ? 'var(--bad)' : 'var(--role-2)');
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .nsb-check { display: inline-flex; align-items: center; gap: 6px; }
</style>
