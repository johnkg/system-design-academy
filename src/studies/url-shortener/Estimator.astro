---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Change the assumptions and see what the design has to handle.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>New links per month (millions) <input type="range" min="1" max="1000" value="100" data-m /> <b data-mval></b></label>
      <label>Reads per write <input type="range" min="10" max="500" step="10" value="100" data-ratio /> <b data-rval></b></label>
      <label>Years of links kept <input type="range" min="1" max="10" value="5" data-years /> <b data-yval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a month is 30 days, peak traffic is 3 times the average, one app server handles about 1,000 redirects per second, one database node about 2,000 reads per second, each link record takes about 500 bytes, and the cache holds the hottest 20% of a day's redirects.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const num = (n: number) => (n >= 1e9 ? `${(n / 1e9).toFixed(1)} billion` : n >= 1e6 ? `${(n / 1e6).toFixed(1)} million` : n >= 1e3 ? `${(n / 1e3).toFixed(1)} thousand` : String(Math.round(n)));
    const bytes = (n: number) => (n >= 1e12 ? `${(n / 1e12).toFixed(1)} TB` : n >= 1e9 ? `${(n / 1e9).toFixed(1)} GB` : `${(n / 1e6).toFixed(1)} MB`);
    const rows = ['writes', 'reads', 'peak', 'links', 'storage', 'code', 'servers', 'cache', 'db'].map((id) => {
      const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { id, dt, dd };
    });
    function draw() {
      const m = val('[data-m]'); const ratio = val('[data-ratio]'); const years = val('[data-years]');
      q('[data-mval]').textContent = `${m}`; q('[data-rval]').textContent = `${ratio}`; q('[data-yval]').textContent = `${years}`;
      const writes = (m * 1e6) / (30 * 86400); const reads = writes * ratio; const peak = reads * 3;
      const links = m * 1e6 * 12 * years; const storage = links * 500;
      let len = 1; while (62 ** len < links) len++;
      const cache = reads * 86400 * 0.2 * 500;
      const data: [string, string][] = [
        ['New links per second', `${writes.toFixed(1)}`],
        ['Redirects per second (average)', `${Math.round(reads).toLocaleString('en-US')}`],
        ['Redirects per second (peak)', `${Math.round(peak).toLocaleString('en-US')}`],
        [`Links after ${years} years`, num(links)],
        ['Storage needed', bytes(storage)],
        ['Characters needed in a short code', `${len} (base62 gives ${num(62 ** len)} codes)`],
        ['App servers at peak', `${Math.max(1, Math.ceil(peak / 1000))}`],
        ['Cache size for the hottest 20%', bytes(cache)],
        ['Database nodes for cache misses (90% hit rate)', `${Math.max(1, Math.ceil((peak * 0.1) / 2000))}`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
