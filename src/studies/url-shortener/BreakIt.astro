---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Turn up the traffic" hint="Start with the single server and raise the redirects per second. Then add the fixes one at a time and watch the bottleneck move.">
  <ol class="how">
    <li>Raise <b>redirects per second</b> past 1,000: the lone server is overloaded. Add <b>app servers</b> and it recovers, but the database is next.</li>
    <li>Turn on the <b>cache</b> (90% hit rate): the database only sees the misses, so its load drops tenfold.</li>
    <li>At very high traffic add <b>read replicas</b>, then <b>shards</b>. Each bar shows the load on one part, and red means requests are failing there.</li>
  </ol>
  <div class="pg bi" data-bi>
    <div class="pg-row">
      <label>Redirects per second <input type="range" min="100" max="50000" step="100" value="800" data-rate /> <b data-rateval></b></label>
      <label>App servers <input type="range" min="1" max="60" value="1" data-servers /> <b data-serverval></b></label>
    </div>
    <div class="pg-row">
      <label class="bi-check"><input type="checkbox" data-cache /> Cache (90% of reads hit it)</label>
      <label class="bi-check"><input type="checkbox" data-replicas /> 2 read replicas</label>
      <label class="bi-check"><input type="checkbox" data-shards /> 4 shards</label>
    </div>
    <div class="bi-bars" data-bars></div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  const APP = 1000; const DB = 2000; const CACHE = 50000;
  document.querySelectorAll<HTMLElement>('[data-bi]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const on = (s: string) => q<HTMLInputElement>(s).checked;
    const bars = ['app', 'cache', 'db'].map((id) => {
      const wrap = document.createElement('div'); wrap.className = 'bi-row';
      wrap.innerHTML = '<span class="bi-name"></span><div class="bi-track"><div class="bi-fill"></div></div><span class="pg-mono bi-pct"></span>';
      q('[data-bars]').appendChild(wrap);
      return { id, wrap, name: wrap.querySelector<HTMLElement>('.bi-name')!, fill: wrap.querySelector<HTMLElement>('.bi-fill')!, pct: wrap.querySelector<HTMLElement>('.bi-pct')! };
    });
    const REPLICAS = 3, SHARDS = 4; // database nodes when replication / sharding is on
    const CACHE_MISS = 0.1; // with a cache, 10% of reads reach the database
    const WARN = 0.8; // bars turn amber above 80% load
    function draw() {
      const rate = val('[data-rate]'); const servers = val('[data-servers]'); const cache = on('[data-cache]');
      const nodes = (on('[data-replicas]') ? REPLICAS : 1) * (on('[data-shards]') ? SHARDS : 1);
      q('[data-rateval]').textContent = rate.toLocaleString('en-US'); q('[data-serverval]').textContent = String(servers);
      const dbLoad = cache ? rate * CACHE_MISS : rate;
      const stats = [
        { id: 'app', name: `App servers (${servers})`, load: rate, cap: servers * APP, show: true },
        { id: 'cache', name: 'Cache', load: rate, cap: CACHE, show: cache },
        { id: 'db', name: `Database (${nodes} node${nodes > 1 ? 's' : ''})`, load: dbLoad, cap: nodes * DB, show: true },
      ];
      const hot: string[] = [];
      bars.forEach((b, i) => {
        const s = stats[i]; const u = s.load / s.cap;
        b.wrap.hidden = !s.show; if (!s.show) return;
        b.name.textContent = s.name; b.fill.style.width = `${Math.min(100, u * 100)}%`;
        b.fill.classList.toggle('bad', u > 1); b.fill.classList.toggle('warn', u > WARN && u <= 1);
        b.pct.textContent = `${Math.round(u * 100)}%${u > 1 ? ' overloaded' : ''}`;
        if (u > 1) hot.push(s.name.replace(/ \(.*\)/, '').toLowerCase());
      });
      const out = q('[data-verdict]');
      out.classList.toggle('bad', hot.length > 0);
      out.textContent = hot.length ? `Failing at: ${hot.join(', ')}. Requests are being dropped or timing out.` : 'Everything is within capacity.';
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
<style is:global>
  .bi-check { display: inline-flex; align-items: center; gap: 6px; }
  .bi-bars { display: grid; gap: 8px; margin: 12px 0; }
  .bi-row { display: grid; grid-template-columns: minmax(110px, 190px) 1fr 9.5rem; gap: 10px; align-items: center; }
  .bi-row[hidden] { display: none; }
  .bi-track { height: 18px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .bi-fill { height: 100%; border-radius: 99px; background: var(--accent); transition: width .15s; }
  .bi-fill.warn { background: var(--role-3); }
  .bi-fill.bad { background: var(--bad); }
  .bi-name { font-size: .9rem; }
  @media (max-width: 560px) { .bi-row { grid-template-columns: 1fr; gap: 2px; } }
</style>
