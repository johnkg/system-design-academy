---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Instances are sized for the loss of a zone, not for the average. Shared counters, upstream connections and configuration pushes all grow with the number of instances.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Peak traffic (thousand requests per second) <input type="range" min="2" max="200" value="20" data-rps /> <b data-rpsval></b></label>
      <label>Requests one instance can handle (thousand per second) <input type="range" min="1" max="20" value="6" data-cap /> <b data-capval></b></label>
      <label>Availability zones <input type="range" min="2" max="5" value="3" data-z /> <b data-zval></b></label>
      <label>Median upstream latency (ms) <input type="range" min="5" max="500" step="5" value="40" data-up /> <b data-upval></b></label>
      <label>Upstream pods <input type="range" min="2" max="200" value="20" data-pods /> <b data-podsval></b></label>
      <label>Connections per instance to each pod <input type="range" min="1" max="16" value="4" data-pool /> <b data-poolval></b></label>
      <label>Consumers with active quotas <input type="range" min="10" max="5000" step="10" value="100" data-cons /> <b data-consval></b></label>
      <label>Counter sync interval (ms) <input type="range" min="20" max="1000" step="10" value="100" data-sync /> <b data-syncval></b></label>
      <label>Heaviest consumer (requests per second) <input type="range" min="100" max="20000" step="100" value="3000" data-heavy /> <b data-heavyval></b></label>
      <label>Routes in the configuration (hundreds) <input type="range" min="1" max="200" value="20" data-routes /> <b data-routesval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: an instance is run at most 80% busy even after a zone is lost, and ideally near half at the peak; the gateway adds 0.3 ms to each request; a shared counter store call costs one command per consumer touched in a sync, and a central design sends one command per request; the worst quota overshoot is one sync interval of the heaviest consumer's traffic, capped by their total traffic above the limit of 1,000 requests per second; one route with its plugin settings takes about 2 KB in the configuration snapshot, and a full push goes to every instance.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const N_ROWS = 12; // output lines below
    const THOUSAND = 1000; const MS_PER_S = 1000; const KB_PER_MB = 1024;
    const ROUTES_STEP = 100; // the routes slider counts in hundreds
    const TARGET_LOAD = 0.5; const ZONE_LOSS_MAX = 0.8; // peak load per instance, and the ceiling after losing a zone
    const GATEWAY_MS = 0.3; // latency the gateway adds per request
    const CONSUMER_LIMIT = 1000; // rate limit of the heaviest consumer, requests per second
    const KB_PER_ROUTE = 2; // configuration snapshot size per route
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const keys = ['rps', 'cap', 'z', 'up', 'pods', 'pool', 'cons', 'sync', 'heavy', 'routes'];
    function draw() {
      const v: Record<string, number> = {}; keys.forEach((k) => { v[k] = val(`[data-${k}]`); q(`[data-${k}val]`).textContent = k === 'routes' ? fmt(v[k] * ROUTES_STEP) : fmt(v[k]); });
      const rps = v.rps * THOUSAND; const cap = v.cap * THOUSAND; const Z = v.z;
      const forLoad = Math.ceil(rps / (cap * TARGET_LOAD));
      const forZone = Math.ceil(rps / (cap * ZONE_LOSS_MAX) / ((Z - 1) / Z));
      const n = Math.ceil(Math.max(forLoad, forZone) / Z) * Z;
      const left = (n * (Z - 1)) / Z;
      const inflight = rps * (v.up / MS_PER_S + GATEWAY_MS / MS_PER_S);
      const syncsPerSec = MS_PER_S / v.sync; const perInterval = rps / n / syncsPerSec;
      const distinct = v.cons * (1 - Math.exp(-perInterval / v.cons));
      const syncOps = n * syncsPerSec * distinct;
      const overshoot = Math.min(v.heavy * (v.sync / MS_PER_S), Math.max(0, v.heavy - CONSUMER_LIMIT));
      const snapMb = (v.routes * ROUTES_STEP * KB_PER_ROUTE) / KB_PER_MB;
      const data: [string, string][] = [
        ['Instances to run at about half load at the peak', fmt(forLoad)],
        [`Instances so that losing a zone leaves everyone under ${ZONE_LOSS_MAX * 100}%`, fmt(forZone)],
        ['Instances to run, a multiple of the zones', `${fmt(n)} (${fmt(n / Z)} per zone)`],
        ['Load per instance at the peak, and after losing a zone', `${fmt((rps / n / cap) * 100)}% and ${fmt((rps / left / cap) * 100)}%`],
        ['Requests in flight at the peak (traffic times latency)', `${fmt(inflight)}, or ${fmt(inflight / n)} per instance`],
        ['Gateway share of the end-to-end latency', `${((GATEWAY_MS / (v.up + GATEWAY_MS)) * 100).toFixed(2)}%`],
        ['Connections held open to the upstream pods', fmt(n * v.pods * v.pool)],
        ['Connections arriving at each pod', fmt(n * v.pool)],
        ['Shared counter commands per second, one per request', fmt(rps)],
        ['Shared counter commands per second, synced', fmt(syncOps)],
        ['Worst overshoot of the heaviest consumer (extra requests in one second)', fmt(overshoot)],
        ['Configuration snapshot, and one full push to every instance', `${snapMb.toFixed(1)} MB, and ${fmt(snapMb * n)} MB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
