---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Layer 7 proxies carry every byte both ways, while layer 4 with direct server return carries only the requests. Raise the traffic to see the node counts split: at the defaults both still fit in the minimum of three nodes plus a spare.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Peak requests per second (thousands)" name="r" min="10" max="5000" step="10" value="500" />
      <RangeField label="Requests per connection" name="q" min="1" max="100" value="10" />
      <RangeField label="Average response (KB)" name="kb" min="1" max="500" value="20" />
      <RangeField label="New connections that need a full TLS handshake (%)" name="tls" min="0" max="100" value="40" />
      <RangeField label="Connection lifetime (seconds)" name="life" min="1" max="300" value="30" />
      <RangeField label="Backends" name="be" min="10" max="2000" step="10" value="200" />
      <RangeField label="Health probe interval (seconds)" name="iv" min="1" max="30" value="2" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a request is 1 KB and takes 3 packets to reach the balancer; a layer 4 node handles about 10 million packets per second; a node has a 40 Gbps network card that we load to 70%; a core does about 5,000 full TLS handshakes per second and a layer 7 node has 16 cores for it; a tracked connection costs 100 bytes; every layer 7 node probes every backend; and we always run at least 3 nodes plus one spare.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 11; // one per output line
    const RPS_UNIT = 1000; // the slider is in thousands of requests per second
    const BITS_PER_BYTE = 8; const KBIT_PER_GBIT = 1e6; const REQ_KB = 1; const BYTES_PER_MB = 1e6;
    const HANDSHAKES_PER_CORE = 5000; const CORES_PER_NODE = 16;
    const NIC = { gbps: 40, usable: 0.7 }; // per node, keep 30% headroom
    const PKTS_PER_REQ = 3; const L4_PPS_PER_NODE = 10e6;
    const MIN_NODES = 3; // run at least three, then add one spare
    const CONNTRACK_BYTES = 100; // per tracked connection
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const rps = val('[data-r]') * RPS_UNIT; const perConn = val('[data-q]'); const kb = val('[data-kb]'); const tlsShare = val('[data-tls]') / 100; const life = val('[data-life]'); const be = val('[data-be]'); const iv = val('[data-iv]');
      ['r', 'q', 'kb', 'tls', 'life', 'be', 'iv'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const newConn = rps / perConn; const conc = newConn * life;
      const outGbps = (rps * kb * BITS_PER_BYTE) / KBIT_PER_GBIT; const inGbps = (rps * REQ_KB * BITS_PER_BYTE) / KBIT_PER_GBIT;
      const handshakes = newConn * tlsShare; const cores = Math.ceil(handshakes / HANDSHAKES_PER_CORE);
      const l7Bw = Math.ceil((outGbps + inGbps) / (NIC.gbps * NIC.usable)); const l7Cpu = Math.ceil(cores / CORES_PER_NODE);
      const l7 = Math.max(l7Bw, l7Cpu, 1);
      const pps = rps * PKTS_PER_REQ; const l4Pps = Math.ceil(pps / L4_PPS_PER_NODE); const l4Bw = Math.ceil(inGbps / (NIC.gbps * NIC.usable)); const l4 = Math.max(l4Pps, l4Bw, 1);
      const l7Run = Math.max(MIN_NODES, l7) + 1; const l4Run = Math.max(MIN_NODES, l4) + 1;
      const memMb = (conc * CONNTRACK_BYTES) / BYTES_PER_MB;
      const probesEach = l7Run / iv; const probesAll = (l7Run * be) / iv;
      const data: [string, string][] = [
        ['New connections per second', fmt(newConn)],
        ['Concurrent connections', fmt(conc)],
        ['Response traffic (Gbps), and request traffic (Gbps)', `${fmt1(outGbps)} and ${fmt1(inGbps)}`],
        ['Full TLS handshakes per second, and cores they need', `${fmt(handshakes)} and ${fmt(cores)}`],
        ['Layer 7 proxy nodes needed (bandwidth, then CPU)', `${fmt(l7)} (${fmt(l7Bw)}, ${fmt(l7Cpu)})`],
        ['Layer 4 DSR nodes needed (packets, then bandwidth)', `${fmt(l4)} (${fmt(l4Pps)}, ${fmt(l4Bw)})`],
        ['Layer 7 nodes to run, with a spare', fmt(l7Run)],
        ['Layer 4 DSR nodes to run, with a spare', fmt(l4Run)],
        ['Connection-tracking memory in total (MB)', fmt(memMb)],
        ['Health probes per backend per second', fmt1(probesEach)],
        ['Health probes per second, all backends', fmt(probesAll)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
