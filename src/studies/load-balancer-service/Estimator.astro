---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Layer 7 proxies carry every byte both ways, while layer 4 with direct server return carries only the requests. Watch how the node counts differ.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Peak requests per second (thousands) <input type="range" min="10" max="5000" step="10" value="500" data-r /> <b data-rval></b></label>
      <label>Requests per connection <input type="range" min="1" max="100" value="10" data-q /> <b data-qval></b></label>
      <label>Average response (KB) <input type="range" min="1" max="500" value="20" data-kb /> <b data-kbval></b></label>
      <label>New connections that need a full TLS handshake (%) <input type="range" min="0" max="100" value="40" data-tls /> <b data-tlsval></b></label>
      <label>Connection lifetime (seconds) <input type="range" min="1" max="300" value="30" data-life /> <b data-lifeval></b></label>
      <label>Backends <input type="range" min="10" max="2000" step="10" value="200" data-be /> <b data-beval></b></label>
      <label>Health probe interval (seconds) <input type="range" min="1" max="30" value="2" data-iv /> <b data-ivval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a request is 1 KB and takes 3 packets to reach the balancer; a layer 4 node handles about 10 million packets per second; a node has a 40 Gbps network card that we load to 70%; a core does about 5,000 full TLS handshakes per second and a layer 7 node has 16 cores for it; a tracked connection costs 100 bytes; every layer 7 node probes every backend; and we always run at least 3 nodes plus one spare.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 11 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmt1 = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const rps = val('[data-r]') * 1000; const perConn = val('[data-q]'); const kb = val('[data-kb]'); const tlsShare = val('[data-tls]') / 100; const life = val('[data-life]'); const be = val('[data-be]'); const iv = val('[data-iv]');
      ['r', 'q', 'kb', 'tls', 'life', 'be', 'iv'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const newConn = rps / perConn; const conc = newConn * life;
      const outGbps = (rps * kb * 8) / 1e6; const inGbps = (rps * 1 * 8) / 1e6;
      const handshakes = newConn * tlsShare; const cores = Math.ceil(handshakes / 5000);
      const l7Bw = Math.ceil((outGbps + inGbps) / (40 * 0.7)); const l7Cpu = Math.ceil(cores / 16);
      const l7 = Math.max(l7Bw, l7Cpu, 1);
      const pps = rps * 3; const l4Pps = Math.ceil(pps / 10e6); const l4Bw = Math.ceil(inGbps / (40 * 0.7)); const l4 = Math.max(l4Pps, l4Bw, 1);
      const l7Run = Math.max(3, l7) + 1; const l4Run = Math.max(3, l4) + 1;
      const memMb = (conc * 100) / 1e6;
      const probesEach = l7Run / iv; const probesAll = (l7Run * be) / iv;
      const data: [string, string][] = [
        ['New connections per second', fmt(newConn)],
        ['Concurrent connections', fmt(conc)],
        ['Response traffic (Gbps), and request traffic (Gbps)', `${fmt1(outGbps)} and ${fmt1(inGbps)}`],
        ['Full TLS handshakes per second, and cores they need', `${fmt(handshakes)} and ${fmt(cores)}`],
        ['Layer 7 proxy nodes needed (bandwidth, then CPU)', `${fmt(l7)} (${fmt(l7Bw)}, ${fmt(l7Cpu)})`],
        ['Layer 4 DSR nodes needed (packets, then bandwidth)', `${fmt(l4)} (${fmt(l4Pps)}, ${fmt(l4Bw)})`],
        ['Layer 7 nodes to run, with a spare', fmt(l7Run)],
        ['Layer 4 DSR nodes to run, with a spare', fmt(l4Run)],
        ['Connection-tracking memory in total (MB)', fmt(memMb)],
        ['Health probes per backend per second', fmt1(probesEach)],
        ['Health probes per second, all backends', fmt(probesAll)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
