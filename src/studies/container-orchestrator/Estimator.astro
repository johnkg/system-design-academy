---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Heartbeats dominate the write load, the store's size depends on pods, and the scheduler is one serial loop, so a big burst takes minutes however many nodes you add.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Nodes" name="n" min="100" max="5000" step="100" value="5000" />
      <RangeField label="Pods per node" name="ppn" min="10" max="110" step="5" value="30" />
      <RangeField label="Restarts or replacements per pod per day" name="r" min="0" max="10" step="1" value="1" />
      <RangeField label="Pods to place in one burst" name="burst" min="1000" max="50000" step="1000" value="10000" />
      <RangeField label="Nodes lost at once (%)" name="loss" min="1" max="20" value="5" />
      <RangeField label="Wait before evicting (s)" name="wait" min="10" max="300" step="10" value="40" />
      <RangeField label="API servers" name="api" min="1" max="10" value="3" />
      <label>Store members <select class="pg-in" data-etcd><option value="3" selected>3</option><option value="5">5</option><option value="7">7</option></select></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a pod object is about 6 KB and a node object 10 KB, and the store holds 1.5 times that for history before compaction. Each node renews a small lease every 10 s and posts a full status every 5 minutes. A replacement costs about 6 writes (create, bind and several status updates). The store comfortably handles about 5,000 writes per second on fast disks, and its size is best kept under 8 GB. Every node watches the service endpoint lists, and one list update is about 10 KB (a slice of 100 endpoints). The scheduler examines the share of nodes that Kubernetes' default adaptive rule picks (50% minus 1% per 125 nodes, at least 5% and at least 100 nodes), and a scheduling cycle takes about 1 ms plus 15 microseconds per node examined, one pod at a time. Rescheduling assumes the lost nodes' pods all find room.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const DAY_S = 86400; const ROWS = 11; // one per output line
    const STORE = { kbPerPod: 6, kbPerNode: 10, overhead: 1.5, kbPerGb: 1e6, comfortableWrites: 5000 }; // object sizes in the store; history overhead
    const RENEW = { leaseEveryS: 10, statusEveryS: 300, writesPerPodChange: 6 }; // node heartbeats and writes per pod replacement
    const WATCH = { perNode: 2, base: 50 }; // watch connections per node plus controllers
    const ENDPOINT = { changesPerReplacement: 2, kbPerUpdate: 10, kbPerMb: 1000 };
    const SCHED = { maxPct: 50, minPct: 5, nodesPerPctDrop: 125, minScored: 100, basePerS: 1000, costPerNode: 0.015 }; // node sampling rule and scoring cost
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const dur = (s: number) => (s < 120 ? `${fmt(s)} s` : `${fmt1(s / 60)} min`);
    function draw() {
      const nodes = val('[data-n]'); const ppn = val('[data-ppn]'); const r = val('[data-r]'); const burst = val('[data-burst]'); const loss = val('[data-loss]') / 100; const wait = val('[data-wait]'); const api = val('[data-api]'); const members = val('[data-etcd]');
      ['n', 'ppn', 'r', 'burst', 'loss', 'wait', 'api'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const pods = nodes * ppn;
      const dbGb = ((pods * STORE.kbPerPod + nodes * STORE.kbPerNode) * STORE.overhead) / STORE.kbPerGb;
      const leases = nodes / RENEW.leaseEveryS; const status = nodes / RENEW.statusEveryS; const podWrites = (pods * r * RENEW.writesPerPodChange) / DAY_S;
      const writes = leases + status + podWrites;
      const watches = nodes * WATCH.perNode + WATCH.base;
      const slices = ((pods * r) / DAY_S) * ENDPOINT.changesPerReplacement; // each replacement removes an endpoint and adds one
      const mbps = (slices * nodes * ENDPOINT.kbPerUpdate) / ENDPOINT.kbPerMb;
      const pct = Math.max(SCHED.minPct, SCHED.maxPct - Math.floor(nodes / SCHED.nodesPerPctDrop)); const scored = nodes < SCHED.minScored ? nodes : Math.max(SCHED.minScored, Math.ceil((nodes * pct) / 100));
      const rate = SCHED.basePerS / (1 + SCHED.costPerNode * scored);
      const lost = nodes * loss; const moved = lost * ppn; const recover = wait + moved / rate;
      const quorum = Math.floor(members / 2) + 1;
      const data: [string, string][] = [
        ['Pods in the cluster', fmt(pods)],
        ['Data in the store (limit about 8 GB)', `${fmt1(dbGb)} GB`],
        ['Lease renewals per second (heartbeats)', fmt(leases)],
        [`Store writes per second in total (about ${fmt(STORE.comfortableWrites)} is comfortable)`, `${fmt(writes)} (${fmt((writes / STORE.comfortableWrites) * 100)}% of that)`],
        ['Watch connections open on the API servers', `${fmt(watches)}, about ${fmt(watches / api)} per server`],
        ['Endpoint updates sent to nodes per second', `${fmt(slices * nodes)}, about ${fmt1(mbps / api)} MB/s per API server`],
        ['Nodes examined per pod by the scheduler', `${fmt(scored)} of ${fmt(nodes)} (${pct}% rule)`],
        ['Pods the scheduler can place per second', fmt(rate)],
        ['Time to place the burst', dur(burst / rate)],
        [`Time to recover after losing ${fmt(lost)} nodes (${fmt(moved)} pods)`, dur(recover)],
        ['Store members needed for a majority, and failures survived', `${quorum} of ${members}, survives ${members - quorum}`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
