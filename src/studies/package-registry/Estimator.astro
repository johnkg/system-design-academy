---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="A CDN hit rate of 98 percent sounds high, but at this scale the 2 percent that is left is still thousands of requests per second for the origin.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Downloads per day (billions) <input type="range" min="1" max="30" value="10" data-d /> <b data-dval></b></label>
      <label>Peak compared with the average (times) <input type="range" min="1" max="4" step="0.5" value="2" data-pk /> <b data-pkval></b></label>
      <label>Average downloaded tarball (KB) <input type="range" min="20" max="500" step="10" value="150" data-kb /> <b data-kbval></b></label>
      <label>Metadata requests per tarball download <input type="range" min="0.1" max="2" step="0.1" value="0.5" data-mr /> <b data-mrval></b></label>
      <label>CDN hit rate for tarballs (%) <input type="range" min="80" max="99.9" step="0.1" value="98" data-ht /> <b data-htval></b></label>
      <label>CDN hit rate for metadata (%) <input type="range" min="50" max="99" step="1" value="90" data-hm /> <b data-hmval></b></label>
      <label>New versions published per day (thousands) <input type="range" min="5" max="200" step="5" value="50" data-pub /> <b data-pubval></b></label>
      <label>Average stored tarball (KB) <input type="range" min="20" max="500" step="10" value="100" data-sk /> <b data-skval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: metadata documents are 20 KB on the wire, a metadata request is needed only for installs without a lockfile or with a changed one, every stored tarball is kept in 3 copies, 10 percent of publishes are saved as identical files that dedupe to nothing, and traffic is spread over the day with the stated peak factor. Hit rates are for requests, not bytes.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 11 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    function draw() {
      const keys = ['d', 'pk', 'kb', 'mr', 'ht', 'hm', 'pub', 'sk'];
      keys.forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perDay = val('[data-d]') * 1e9; const peakF = val('[data-pk]'); const kb = val('[data-kb]'); const mr = val('[data-mr]');
      const ht = val('[data-ht]') / 100; const hm = val('[data-hm]') / 100; const pub = val('[data-pub]') * 1000; const sk = val('[data-sk]');
      const MD_KB = 20;
      const avg = perDay / 86400; const peak = avg * peakF;
      const tarGbps = (peak * kb * 1000 * 8) / 1e9; const metaRps = peak * mr; const metaGbps = (metaRps * MD_KB * 1000 * 8) / 1e9;
      const originTar = peak * (1 - ht); const originMeta = metaRps * (1 - hm);
      const originGbps = (originTar * kb * 1000 * 8) / 1e9 + (originMeta * MD_KB * 1000 * 8) / 1e9;
      const noCdnGbps = tarGbps + metaGbps;
      const storedTB = (pub * 0.9 * sk * 1000 * 3) / 1e12;
      const data: [string, string][] = [
        ['Downloads per second, average', fmt(avg)],
        ['Downloads per second, peak', fmt(peak)],
        ['Tarball traffic at the peak', `${fmt(tarGbps)} Gbit/s`],
        ['Metadata requests per second at the peak', fmt(metaRps)],
        ['Metadata traffic at the peak', `${fmt1(metaGbps)} Gbit/s`],
        ['Requests per second reaching the origin at the peak', fmt(originTar + originMeta)],
        ['Origin traffic at the peak', `${fmt1(originGbps)} Gbit/s`],
        ['Share of traffic the origin is spared', `${fmt1((1 - originGbps / noCdnGbps) * 100)} %`],
        ['Publishes per second, average', fmt1(pub / 86400)],
        ['New storage per year, 3 copies', `${fmt1(storedTB * 365)} TB`],
        ['Storage after 5 years of this growth', `${fmt1(storedTB * 365 * 5)} TB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
