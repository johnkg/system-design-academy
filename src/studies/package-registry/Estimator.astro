---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="A CDN hit rate of 98 percent sounds high, but at this scale the 2 percent that is left is still thousands of requests per second for the origin.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Downloads per day (billions)" name="d" min="1" max="30" value="10" />
      <RangeField label="Peak compared with the average (times)" name="pk" min="1" max="4" step="0.5" value="2" />
      <RangeField label="Average downloaded tarball (KB)" name="kb" min="20" max="500" step="10" value="150" />
      <RangeField label="Metadata requests per tarball download" name="mr" min="0.1" max="2" step="0.1" value="0.5" />
      <RangeField label="CDN hit rate for tarballs (%)" name="ht" min="80" max="99.9" step="0.1" value="98" />
      <RangeField label="CDN hit rate for metadata (%)" name="hm" min="50" max="99" step="1" value="90" />
      <RangeField label="New versions published per day (thousands)" name="pub" min="5" max="200" step="5" value="50" />
      <RangeField label="Average stored tarball (KB)" name="sk" min="20" max="500" step="10" value="100" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: metadata documents are 20 KB on the wire, a metadata request is needed only for installs without a lockfile or with a changed one, every stored tarball is kept in 3 copies, 10 percent of publishes are saved as identical files that dedupe to nothing, and traffic is spread over the day with the stated peak factor. Hit rates are for requests, not bytes.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 11; // output lines below
    const THOUSAND = 1000; const BILLION = 1e9; const BYTES_PER_KB = 1000; const BITS_PER_BYTE = 8; const BITS_PER_GBIT = 1e9; const TB = 1e12;
    const DAY_S = 86400; const DAYS_PER_YEAR = 365; const YEARS = 5;
    const STORED_SHARE = 0.9; // publishes that add a new tarball to storage
    const REPLICAS = 3;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    function draw() {
      const keys = ['d', 'pk', 'kb', 'mr', 'ht', 'hm', 'pub', 'sk'];
      keys.forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perDay = val('[data-d]') * BILLION; const peakF = val('[data-pk]'); const kb = val('[data-kb]'); const mr = val('[data-mr]');
      const ht = val('[data-ht]') / 100; const hm = val('[data-hm]') / 100; const pub = val('[data-pub]') * THOUSAND; const sk = val('[data-sk]');
      const MD_KB = 20;
      const avg = perDay / DAY_S; const peak = avg * peakF;
      const tarGbps = (peak * kb * BYTES_PER_KB * BITS_PER_BYTE) / BITS_PER_GBIT; const metaRps = peak * mr; const metaGbps = (metaRps * MD_KB * BYTES_PER_KB * BITS_PER_BYTE) / BITS_PER_GBIT;
      const originTar = peak * (1 - ht); const originMeta = metaRps * (1 - hm);
      const originGbps = (originTar * kb * BYTES_PER_KB * BITS_PER_BYTE) / BITS_PER_GBIT + (originMeta * MD_KB * BYTES_PER_KB * BITS_PER_BYTE) / BITS_PER_GBIT;
      const noCdnGbps = tarGbps + metaGbps;
      const storedTB = (pub * STORED_SHARE * sk * BYTES_PER_KB * REPLICAS) / TB;
      const data: [string, string][] = [
        ['Downloads per second, average', fmt(avg)],
        ['Downloads per second, peak', fmt(peak)],
        ['Tarball traffic at the peak', `${fmt(tarGbps)} Gbit/s`],
        ['Metadata requests per second at the peak', fmt(metaRps)],
        ['Metadata traffic at the peak', `${fmt1(metaGbps)} Gbit/s`],
        ['Requests per second reaching the origin at the peak', fmt(originTar + originMeta)],
        ['Origin traffic at the peak', `${fmt1(originGbps)} Gbit/s`],
        ['Share of traffic the origin is spared', `${fmt1((1 - originGbps / noCdnGbps) * 100)} %`],
        ['Publishes per second, average', fmt1(pub / DAY_S)],
        [`New storage per year, ${REPLICAS} copies`, `${fmt1(storedTB * DAYS_PER_YEAR)} TB`],
        [`Storage after ${YEARS} years of this growth`, `${fmt1(storedTB * DAYS_PER_YEAR * YEARS)} TB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
