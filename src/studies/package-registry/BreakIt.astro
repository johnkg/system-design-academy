---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Unpublish, yank or scan" hint="Pick a policy for removing and vetting versions, then replay the same two bad days: a popular package is removed, and a malicious version is published. Every project and build is the same each time, only the policy changes.">
  <ol class="how">
    <li>The default is <b>allow unpublish</b> when a <b>popular package is removed</b>: <b>1,502 of 2,000 builds fail</b>, because the bytes are gone, even for projects with a lockfile. Only the 25% behind their own mirror are spared.</li>
    <li>Switch to <b>Immutable, with yank</b> or <b>plus scan</b>: the removal is refused because the package has dependents, and <b>0 builds fail</b>.</li>
    <li>Switch the event to a <b>malicious publish</b> (65% lockfiles, noticed after 6 hours): unpublish gives <b>2,052 runs of the bad code and 818 failed builds</b>. Yank has <b>0 failures but 2,870 runs</b>, because projects that locked the bad version keep installing it. With a scan, <b>15 of 20 attacks never get released</b> and runs fall to <b>502</b>.</li>
  </ol>
  <div class="pg rgb" data-rgb>
    <div class="pg-row">
      <label>Policy <select class="pg-in" data-policy>
        <option value="unpublish" selected>Maintainer can unpublish any time</option>
        <option value="yank">Immutable, with yank</option>
        <option value="scan">Immutable, with yank and scan on publish</option>
      </select></label>
      <label>What happens <select class="pg-in" data-scn>
        <option value="removed" selected>A popular package is removed</option>
        <option value="malware">A malicious version is published</option>
      </select></label>
      <RangeField label="Projects with a lockfile (%)" name="lock" min="0" max="100" step="5" value="65" />
      <RangeField label="Hours until a human notices" name="hrs" min="1" max="48" value="6" />
      <RangeField label="Projects behind their own mirror (%)" name="mir" min="0" max="100" step="5" value="25" />
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Builds that failed</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Builds that ran malicious code</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Attacks stopped before release</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: every project builds 4 times in 48 hours at random moments. In the removal event, 500 projects depend on one package that is removed after hour 1. In the malicious event there are 20 separate attacks on 20 packages with 500 projects each (40,000 builds), and the bad version is published at hour 0. A project without a lockfile resolves to the newest version each build; one with a lockfile keeps its old version, except that 10 percent of its builds update the lock and pick up the bad version. Yank hides a version from new resolution but keeps it downloadable. The scanner catches 80 percent of attacks within 15 minutes, before release; the rest are found by a human after the chosen delay and then removed by the registry's security team (a tombstone, so those builds fail instead of running the bad code). Without a scan, unpublish and yank both take effect at the same hour.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-rgb]').forEach((root) => {
    const q = query(root);
    const ATT = 20; const PROJ = 500; const NB = 4; const SPAN = 48; const BUMP = 0.1; const SCAN_RATE = 0.8; const REMOVE_AT = 1;
    const SEED = 5;
    // linear congruential generator (Numerical Recipes constants)
    let seed = SEED; const rnd = () => { seed = (seed * 1664525 + 1013904223) % 4294967296; return seed / 4294967296; };
    // The whole world is drawn once, so only the policy changes between runs.
    const world = Array.from({ length: ATT }, () => ({
      scan: rnd(),
      projects: Array.from({ length: PROJ }, () => ({
        lock: rnd(), mirror: rnd(),
        builds: Array.from({ length: NB }, () => ({ t: rnd() * SPAN, bump: rnd() })).sort((a, b) => a.t - b.t),
      })),
    }));
    type R = { failed: number; malicious: number; blocked: number; builds: number };
    function simulate(policy: string, scenario: string, lockPct: number, hours: number, mirrorPct: number): R {
      let failed = 0; let malicious = 0; let blocked = 0; let builds = 0;
      if (scenario === 'removed') {
        for (const p of world[0].projects) for (const b of p.builds) {
          builds++;
          if (policy === 'unpublish' && b.t >= REMOVE_AT && p.mirror * 100 >= mirrorPct) failed++;
        }
        return { failed, malicious, blocked, builds };
      }
      for (const w of world) {
        const caught = policy === 'scan' && w.scan < SCAN_RATE;
        if (caught) blocked++;
        const stop = caught ? 0 : hours; // the hour when the bad version stops being offered to new resolutions
        for (const p of w.projects) {
          const locked = p.lock * 100 < lockPct; let lockedToBad = false;
          for (const b of p.builds) {
            builds++;
            if (caught) continue;
            if (!locked) { if (b.t < stop) malicious++; continue; }
            if (lockedToBad) { if (policy === 'yank' || b.t < stop) malicious++; else failed++; continue; } // a locked build fails only once the bad version is gone
            if (b.bump < BUMP && b.t < stop) { lockedToBad = true; malicious++; }
          }
        }
      }
      return { failed, malicious, blocked, builds };
    }
    const n = (x: number) => x.toLocaleString('en-US');
    function draw() {
      const policy = q<HTMLSelectElement>('[data-policy]').value; const scn = q<HTMLSelectElement>('[data-scn]').value;
      const lockPct = Number(q<HTMLInputElement>('[data-lock]').value); const hrs = Number(q<HTMLInputElement>('[data-hrs]').value); const mir = Number(q<HTMLInputElement>('[data-mir]').value);
      q('[data-lockval]').textContent = String(lockPct); q('[data-hrsval]').textContent = String(hrs); q('[data-mirval]').textContent = String(mir);
      const removed = scn === 'removed';
      q<HTMLInputElement>('[data-lock]').disabled = removed; q<HTMLInputElement>('[data-hrs]').disabled = removed; q<HTMLInputElement>('[data-mir]').disabled = !removed;
      const r = simulate(policy, scn, lockPct, hrs, mir);
      const set = (k: string, big: string, small: string, c: string) => { q(`[data-o${k}]`).textContent = big; q(`[data-n${k}]`).textContent = small; q<HTMLElement>(`[data-b${k}]`).style.setProperty('--c', c); };
      const pct = r.builds ? Math.round((r.failed / r.builds) * 100) : 0;
      set('1', n(r.failed), `of ${n(r.builds)} builds in 48 hours (${pct}%)`, r.failed === 0 ? 'var(--good)' : 'var(--bad)');
      if (removed) {
        set('2', 'not part of this event', 'no bad code was published', 'var(--accent)');
        set('3', 'not part of this event', 'nothing to scan', 'var(--accent)');
      } else {
        set('2', n(r.malicious), 'installs of the bad version, over 20 attacks', r.malicious === 0 ? 'var(--good)' : 'var(--bad)');
        set('3', policy === 'scan' ? `${r.blocked} of ${ATT}` : 'no scan', policy === 'scan' ? 'held before any build could resolve them' : 'every attack reaches the index', policy === 'scan' ? 'var(--good)' : 'var(--bad)');
      }
      let text = ''; let bad = false;
      if (removed) {
        if (policy === 'unpublish') { bad = true; text = `The package was removed and ${n(r.failed)} of ${n(r.builds)} builds (${pct}%) broke, even those with a lockfile, because the bytes were gone. Only the projects behind their own mirror were spared. The name can also be taken over by someone else.`; }
        else text = 'The removal was refused because the package has dependents. The maintainer can deprecate or yank it, but the bytes stay, so all builds keep working and the name stays reserved.';
      } else if (policy === 'unpublish') {
        bad = true; text = `${n(r.malicious)} builds ran the bad code before it was found, and ${n(r.failed)} more failed after the unpublish, because they had locked the bad version and its bytes were gone.`;
      } else if (policy === 'yank') {
        const u = simulate('unpublish', scn, lockPct, hrs, mir); bad = r.malicious > 0;
        text = `Nothing broke, but ${n(r.malicious)} builds ran the bad code, ${n(r.malicious - u.malicious)} more than with unpublish. A yank hides the version from new resolution, yet projects whose lockfile already names it keep installing it.`;
      } else {
        const y = simulate('yank', scn, lockPct, hrs, mir); bad = r.malicious > 0 || r.failed > 0;
        text = `${r.blocked} of ${ATT} attacks were held before release and never reached anyone. The other ${ATT - r.blocked} were found after ${hrs} h and taken down: ${n(r.malicious)} builds ran bad code (instead of ${n(y.malicious)} with yank only), and ${n(r.failed)} builds failed on purpose rather than run it.`;
      }
      const out = q('[data-verdict]'); out.classList.toggle('bad', bad); out.textContent = text;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
