---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The hot set is usually small enough for one machine's memory. What decides the size of the cache tier is the reads it must serve, and what decides the database's fate is the hit rate.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Peak reads per second (thousands)" name="r" min="20" max="1000" step="10" value="150" />
      <RangeField label="Hit rate (%)" name="h" min="50" max="99" value="85" />
      <RangeField label="Hot items (millions)" name="k" min="0.1" max="50" step="0.1" value="1" />
      <RangeField label="Average item size (KB)" name="kb" min="1" max="64" value="2" />
      <RangeField label="Reads one cache node can serve (thousands per second)" name="n" min="10" max="200" step="10" value="50" />
      <RangeField label="Share of reads on the hottest item (%)" name="s" min="0.1" max="5" step="0.1" value="1" />
      <RangeField label="Time to rebuild one entry (ms)" name="ms" min="10" max="500" step="10" value="50" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each entry costs its value plus about 100 bytes of key, map and list overhead. A cache node has 64 GB of memory, 75% of it usable for entries. Each shard has one replica, so every shard runs on 2 nodes. The database serves about 30,000 reads a second. Hottest-item numbers are for one popular entry on one node, with no single flight.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatWholeNumber, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const THOUSAND = 1e3, MILLION = 1e6, BYTES_PER_GB = 1e9, KB = 1e3, MS_PER_S = 1000;
    const ENTRY_OVERHEAD = 100; // bytes of key, map entry and list pointers around each value
    const NODE_GB = 64, USABLE = 0.75, REPLICAS = 2, DB_LIMIT = 30000, HIT_DROP = 10;
    const N_ROWS = 9;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const reads = val('[data-r]') * THOUSAND, hit = val('[data-h]'), keys = val('[data-k]') * MILLION, kb = val('[data-kb]');
      const nodeReads = val('[data-n]') * THOUSAND, share = val('[data-s]'), ms = val('[data-ms]');
      ['r', 'h', 'k', 'kb', 'n', 's', 'ms'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const dbReads = (reads * (100 - hit)) / 100;
      const dbReadsWorse = (reads * (100 - Math.max(0, hit - HIT_DROP))) / 100;
      const hotGb = (keys * (kb * KB + ENTRY_OVERHEAD)) / BYTES_PER_GB;
      const shardsMemory = Math.max(1, Math.ceil(hotGb / (NODE_GB * USABLE)));
      const shardsTraffic = Math.max(1, Math.ceil((reads * hit) / 100 / nodeReads));
      const shards = Math.max(shardsMemory, shardsTraffic);
      const hotReads = (reads * share) / 100;
      const stampede = (hotReads * ms) / MS_PER_S;
      const movedRing = 100 / (shards + 1), movedMod = (100 * shards) / (shards + 1);
      const data: [string, string][] = [
        ['Database reads per second at this hit rate', `${formatWholeNumber(dbReads)}${dbReads > DB_LIMIT ? ' (over what the database can serve)' : ''}`],
        [`Database reads per second if the hit rate falls ${HIT_DROP} points`, `${formatWholeNumber(dbReadsWorse)}${dbReadsWorse > DB_LIMIT ? ' (over what the database can serve)' : ''}`],
        ['Memory for the hot items, entries included', `${formatOneDecimalBelow100(hotGb)} GB`],
        ['Shards needed for that memory', formatWholeNumber(shardsMemory)],
        ['Shards needed for the reads the cache must serve', formatWholeNumber(shardsTraffic)],
        ['Cache nodes to run, with a replica per shard', formatWholeNumber(shards * REPLICAS)],
        ['Reads per second on the hottest item', formatWholeNumber(hotReads)],
        ['Identical database queries when that entry expires', formatWholeNumber(stampede)],
        [`Keys that move when a shard is added to ${shards}: ring, then modulo`, `${formatOneDecimalBelow100(movedRing)}%, then ${formatOneDecimalBelow100(movedMod)}%`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
