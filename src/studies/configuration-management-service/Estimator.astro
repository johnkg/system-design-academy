---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Polling is cheap when most answers are 'not modified'. The cost is in the burst after a change, and in the length of a staged rollout.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Instances (thousands) <input type="range" min="1" max="200" value="50" data-n /> <b data-nval></b></label>
      <label>Poll interval (seconds) <input type="range" min="5" max="120" step="5" value="30" data-i /> <b data-ival></b></label>
      <label>Config size (KB) <input type="range" min="1" max="200" value="20" data-kb /> <b data-kbval></b></label>
      <label>Releases per hour <input type="range" min="1" max="60" value="6" data-c /> <b data-cval></b></label>
      <label>Rollout stages <input type="range" min="1" max="6" value="4" data-st /> <b data-stval></b></label>
      <label>Bake time per stage (minutes) <input type="range" min="1" max="30" value="5" data-bake /> <b data-bakeval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a 'not modified' reply is about 300 bytes including headers, a polling instance fetches the full document once per release, one API server handles about 5,000 conditional requests per second, and a notifier node holds about 20,000 connections. Instances poll at random offsets, so polls are spread evenly. The first release takes place in one interval at worst.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const bytes = (b: number) => (b >= 1e9 ? `${(b / 1e9).toFixed(1)} GB/s` : b >= 1e6 ? `${(b / 1e6).toFixed(1)} MB/s` : `${(b / 1e3).toFixed(1)} KB/s`);
    function draw() {
      const n = val('[data-n]') * 1000; const interval = val('[data-i]'); const kb = val('[data-kb]'); const rel = val('[data-c]'); const stages = val('[data-st]'); const bake = val('[data-bake]');
      ['n', 'i', 'kb', 'c', 'st', 'bake'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const polls = n / interval;
      const full = polls * kb * 1000;
      const cond = polls * 300 + (rel * n * kb * 1000) / 3600;
      const servers = Math.max(2, Math.ceil(polls / 5000));
      const rolloutMin = stages * bake + interval / 60;
      const data: [string, string][] = [
        ['Polls per second', fmt(polls)],
        ['Bandwidth if every poll downloads the document', bytes(full)],
        ['Average bandwidth with conditional polls', bytes(cond)],
        ['Saving from conditional polls', `${fmt((1 - cond / full) * 100)}%`],
        ['Document downloads per second right after a release', fmt(polls)],
        ['API servers (at least 2)', fmt(servers)],
        ['Notifier nodes if every instance holds a connection', fmt(Math.ceil(n / 20000))],
        ['Time for a release to reach everyone once it is allowed', `${interval} s at worst, ${fmt(interval / 2)} s on average`],
        ['Time for a full staged rollout', `${rolloutMin.toFixed(1)} minutes`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
