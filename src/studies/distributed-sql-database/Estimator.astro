---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The range size sets how many Raft groups the cluster carries, the survival goal sets the cost of every write, and rebalancing a new node is limited by how fast data may move.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Logical data (TB) <input type="range" min="1" max="500" value="50" data-tb /> <b data-tbval></b></label>
      <label>Range size (MB) <input type="range" min="64" max="1024" step="64" value="512" data-rs /> <b data-rsval></b></label>
      <label>Copies of each range <select class="pg-in" data-rf><option value="3" selected>3</option><option value="5">5</option></select></label>
      <label>Machines <input type="range" min="3" max="300" value="30" data-n /> <b data-nval></b></label>
      <label>Transactions per second <input type="range" min="1000" max="200000" step="1000" value="20000" data-tps /> <b data-tpsval></b></label>
      <label>Rows written per transaction <input type="range" min="1" max="20" value="4" data-w /> <b data-wval></b></label>
      <label>Transactions that touch several ranges (%) <input type="range" min="0" max="100" step="5" value="30" data-x /> <b data-xval></b></label>
      <label>Survival goal <select class="pg-in" data-goal><option value="zone" selected>Survive a zone failure (replicas in one region)</option><option value="region">Survive a region failure (replicas across regions)</option></select></label>
      <label>Round trip to the nearest other region (ms) <input type="range" min="10" max="150" step="10" value="30" data-rtt /> <b data-rttval></b></label>
      <label>Clock error bound (ms) <input type="range" min="1" max="250" value="7" data-eps /> <b data-epsval></b></label>
      <label>Data movement per machine (MB/s) <input type="range" min="8" max="256" step="8" value="64" data-mv /> <b data-mvval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 1 TB is 1,000,000 MB. A transaction that stays in one range is a single Raft proposal, while a transaction that spans ranges makes one proposal per row plus one for the transaction record. Inside a region a round trip is 1 ms and a disk sync 1 ms. Under the region goal the nearest majority is reached through the nearest other region. Commit wait is twice the clock error bound, and it overlaps the consensus round, so only the excess adds latency. Adding one machine means moving its share of the copies to it, and the new machine receives them at the movement rate set above.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement | HTMLSelectElement>(s).value);
    const N_ROWS = 12; // output lines below
    const MB_PER_TB = 1e6; const HOUR_S = 3600;
    const LOCAL_RTT_MS = 1; const DISK_MS = 1; // round trip inside one region; log fsync
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmt1 = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const tb = val('[data-tb]'); const rs = val('[data-rs]'); const rf = val('[data-rf]'); const n = val('[data-n]'); const tps = val('[data-tps]'); const w = val('[data-w]'); const x = val('[data-x]') / 100;
      const region = q<HTMLSelectElement>('[data-goal]').value === 'region'; const rtt = val('[data-rtt]'); const eps = val('[data-eps]'); const mv = val('[data-mv]');
      ['tb', 'rs', 'n', 'tps', 'w', 'x', 'rtt', 'eps', 'mv'].forEach((k) => (q(`[data-${k}val]`).textContent = k === 'x' ? String(Math.round(x * 100)) : String(val(`[data-${k}]`))));
      const ranges = (tb * MB_PER_TB) / rs; const copies = ranges * rf; const rawTb = tb * rf;
      const perNodeCopies = copies / n; const perNodeTb = rawTb / n;
      const proposals = tps * ((1 - x) * 1 + x * (w + 1)); const logAppends = proposals * rf; const perNodeAppends = logAppends / n;
      const roundMs = (region ? rtt : LOCAL_RTT_MS) + DISK_MS; const waitMs = 2 * eps; const commitMs = Math.max(roundMs, waitMs);
      const moveMb = (rawTb / (n + 1)) * MB_PER_TB; const moveHours = moveMb / mv / HOUR_S;
      const data: [string, string][] = [
        ['Ranges (Raft groups)', fmt(ranges)],
        ['Range copies in the cluster', fmt(copies)],
        ['Raw storage with all copies', `${fmt(rawTb)} TB`],
        ['Range copies per machine', fmt(perNodeCopies)],
        ['Storage per machine', `${fmt1(perNodeTb)} TB`],
        ['Raft proposals per second', fmt(proposals)],
        ['Log appends per second across all copies', fmt(logAppends)],
        ['Log appends per second per machine', fmt(perNodeAppends)],
        ['One consensus round', `${roundMs} ms`],
        ['Commit wait (twice the error bound)', `${waitMs} ms`],
        ['Single-range write commit', `${commitMs} ms${waitMs > roundMs ? ' (limited by commit wait)' : ''}`],
        ['Hours to fill a newly added machine', `${fmt1(moveHours)} h (${fmt1(moveMb / MB_PER_TB)} TB to move)`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
