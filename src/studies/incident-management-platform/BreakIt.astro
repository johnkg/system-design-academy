---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Does the page get through?" hint="200 simulated incidents, a quarter of them big outages of the main infrastructure. Change where the platform runs, how it escalates and how it reaches people, and count the incidents where nobody was told.">
  <ol class="how">
    <li>Start with the platform <b>in the same region as everything else</b>: in <b>42 of 200</b> incidents it fell over with the outage, so no page was sent at all. Escalation cannot help, because the pager itself is gone.</li>
    <li>Move the platform to <b>a different provider</b>: only <b>1</b> incident stays silent. The same code, hosted somewhere that does not share the outage, is the biggest single improvement.</li>
    <li>With the platform still on <b>a different provider</b>, set escalation to <b>primary only</b>: <b>36</b> incidents have nobody answering, because the single person was asleep or out of coverage. Use <b>the whole chain</b> and it falls to <b>1</b>, and with <b>push, SMS and voice</b> as well it is <b>0</b>.</li>
    <li>Make the acknowledgement window longer, and the slowest 10 percent of acknowledgements get slower: a long window waits too long before moving on.</li>
  </ol>
  <div class="pg imb" data-imb>
    <div class="pg-row">
      <label>The platform runs <select class="pg-in" data-host>
        <option value="same" selected>in the same region as everything else</option>
        <option value="account">in another account, same provider</option>
        <option value="provider">at a different provider with its own login</option>
      </select></label>
      <label>Escalation <select class="pg-in" data-esc>
        <option value="none">page the primary only</option>
        <option value="chain" selected>primary, then secondary, then manager</option>
      </select></label>
      <label>Ways to reach a person <select class="pg-in" data-ch>
        <option value="push" selected>push notification only</option>
        <option value="multi">push, SMS and a voice call</option>
      </select></label>
      <RangeField label="Minutes before escalating" name="win" min="2" max="12" value="5" />
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>No page sent at all</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Paged, but nobody answered</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Median time to acknowledge</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Slowest 10 percent</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 200 incidents, and the same random draws in every setting, so only your choices change the result. 25% are big outages of the main infrastructure. In the same region, 90% of those take the platform down too, in another account 25% (the shared login or DNS fails), at another provider 2%. A person is reachable with 80% probability by push alone and 95% with SMS and voice, and takes 1 to 12 minutes to acknowledge. With escalation, the next level is paged every window, and the earliest acknowledgement counts.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-imb]').forEach((root) => {
    const q = query(root);
    const N = 200;
    const SEED = 77;
    const BIG_PCT = 25; // a quarter of incidents are big enough to take down shared infrastructure
    const LEVELS = 3; // the escalation chain: primary, secondary, manager
    const ACK_MAX_MIN = 12; // a reached responder acks within 1..12 minutes
    const P50 = 0.5, P90 = 0.9;
    const LOST_BAD = 5; // incidents nobody hears about
    // linear congruential generator (Numerical Recipes constants), integer in 0..n-1
    let seed = SEED; const rnd = (n: number) => { seed = (seed * 1664525 + 1013904223) % 4294967296; return Math.floor(seed / 65536) % n; };
    const incidents = Array.from({ length: N }, () => ({ big: rnd(100) < BIG_PCT, pf: rnd(100), lv: Array.from({ length: LEVELS }, () => ({ r: rnd(100), d: 1 + rnd(ACK_MAX_MIN) })) }));
    const HOST: Record<string, number> = { same: 90, account: 25, provider: 2 };
    const REACH: Record<string, number> = { push: 80, multi: 95 };
    function run(host: string, esc: string, ch: string, win: number) {
      let silent = 0; let nobody = 0; const times: number[] = [];
      for (const x of incidents) {
        if (x.big && x.pf < HOST[host]) { silent++; continue; }
        let got = -1; const levels = esc === 'chain' ? LEVELS : 1;
        for (let i = 0; i < levels; i++) { const l = x.lv[i]; if (l.r < REACH[ch]) { const at = i * win + l.d; if (got < 0 || at < got) got = at; } }
        if (got < 0) nobody++; else times.push(got);
      }
      times.sort((a, b) => a - b);
      const pct = (p: number) => (times.length ? times[Math.min(times.length - 1, Math.floor(times.length * p))] : 0);
      return { silent, nobody, med: pct(P50), p90: pct(P90), acked: times.length };
    }
    function draw() {
      const host = q<HTMLSelectElement>('[data-host]').value; const esc = q<HTMLSelectElement>('[data-esc]').value;
      const ch = q<HTMLSelectElement>('[data-ch]').value; const win = Number(q<HTMLInputElement>('[data-win]').value);
      q('[data-winval]').textContent = String(win);
      const r = run(host, esc, ch, win);
      q('[data-o1]').textContent = `${r.silent} of ${N}`; q('[data-n1]').textContent = r.silent > 0 ? 'the platform was down with the outage' : 'the platform stayed up';
      q('[data-o2]').textContent = `${r.nobody} of ${N}`; q('[data-n2]').textContent = esc === 'chain' ? 'every level in the chain missed it' : 'the one person paged missed it';
      q('[data-o3]').textContent = `${r.med} min`; q('[data-n3]').textContent = `over the ${r.acked} incidents that were acknowledged`;
      q('[data-o4]').textContent = `${r.p90} min`; q('[data-n4]').textContent = 'the wait for the unlucky tenth';
      q<HTMLElement>('[data-b1]').style.setProperty('--c', r.silent > LOST_BAD ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', r.nobody > LOST_BAD ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', 'var(--accent)');
      q<HTMLElement>('[data-b4]').style.setProperty('--c', 'var(--accent)');
      const lost = r.silent + r.nobody; const out = q('[data-verdict]'); out.classList.toggle('bad', lost > LOST_BAD);
      out.textContent = r.silent > LOST_BAD
        ? `${r.silent} incidents were never paged, because the platform fell over with the outage it was meant to report. No escalation policy can fix that: the monitor of last resort must not share fate with what it monitors.`
        : r.nobody > LOST_BAD
          ? `${r.nobody} incidents were paged but nobody answered. ${esc === 'none' ? 'Paging a single person is a single point of failure: escalate to the next level.' : 'Add a second way of reaching people, such as SMS and a voice call.'}`
          : `Only ${lost} of ${N} incidents went unanswered. The platform survives the outage, the chain gives each page several chances, and acknowledgement takes a median of ${r.med} minutes and ${r.p90} for the slowest tenth.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
