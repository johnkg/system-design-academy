---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Grouping decides how many people are woken up, and the subscriber list decides how long a status update takes to send.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Alerts per day (all tools)" name="a" min="1000" max="100000" step="1000" value="20000" />
      <RangeField label="Alerts that need a human (%)" name="h" min="1" max="50" value="10" />
      <RangeField label="Alerts grouped into one incident" name="g" min="1" max="100" value="25" />
      <RangeField label="Incidents shown on the status page (%)" name="pub" min="1" max="30" value="5" />
      <RangeField label="Subscribers (thousands)" name="s" min="1" max="1000" value="200" />
      <RangeField label="Updates per public incident" name="u" min="1" max="20" value="6" />
      <RangeField label="Messages sent per second by the fleet" name="r" min="100" max="10000" step="100" value="2000" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a person is paged once per alert that needs a human when nothing is grouped, one incident gets about 150 timeline entries of about 500 bytes each, every subscriber gets one message per update, and a storm is 5,000 alerts in one minute.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 9; // output lines below
    const THOUSAND = 1000; const GB = 1e9; const DAYS_PER_YEAR = 365; const S_PER_MIN = 60;
    const ENTRIES_PER_INCIDENT = 150; const ENTRY_BYTES = 500; // timeline entries and their size
    const STORM_ALERTS_PER_MIN = 5000; // alert intake during an alert storm
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const alerts = val('[data-a]'); const human = val('[data-h]') / 100; const group = val('[data-g]'); const pub = val('[data-pub]') / 100;
      const subs = val('[data-s]') * THOUSAND; const updates = val('[data-u]'); const rate = val('[data-r]');
      ['a', 'h', 'g', 'pub', 's', 'u', 'r'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const pagesRaw = alerts * human; const incidents = Math.max(1, pagesRaw / group); const publicInc = incidents * pub;
      const messages = publicInc * updates * subs; const sendSecs = subs / rate;
      const timelineGb = (incidents * ENTRIES_PER_INCIDENT * ENTRY_BYTES * DAYS_PER_YEAR) / GB;
      const data: [string, string][] = [
        ['Pages per day if every alert pages', fmt(pagesRaw)],
        ['Incidents per day after grouping', fmt(incidents)],
        ['Pages saved by grouping', `${fmt(pagesRaw / incidents)} times fewer`],
        ['Incidents per day on the status page', publicInc.toFixed(1)],
        ['Status messages per day', fmt(messages)],
        ['Time to send one update to every subscriber', sendSecs < 120 ? `${fmt(sendSecs)} seconds` : `${(sendSecs / 60).toFixed(1)} minutes`],
        ['Alert intake rate in a storm', `${fmt(STORM_ALERTS_PER_MIN / S_PER_MIN)} per second`],
        ['Timeline entries per day', fmt(incidents * ENTRIES_PER_INCIDENT)],
        ['Timeline storage per year', `${timelineGb.toFixed(1)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
