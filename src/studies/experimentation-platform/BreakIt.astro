---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Peeking at an experiment" hint="Each of 1,000 simulated experiments collects 2,000 users per arm, in 20 daily batches of 100. You choose how often the team looks and which limit decides a win. With no real effect, every win is a false one.">
  <ol class="how">
    <li>The default has <b>no real effect</b>, <b>20 looks</b> and the ordinary <b>1.96 limit at every look</b>: about <b>26 in 100</b> experiments declare a winner anyway, where 5 were promised. Looking daily and stopping on the first significant day is the peeking problem.</li>
    <li>Switch to <b>1 look, at the end</b>: the same data gives about <b>5 in 100</b>. Or keep 20 looks and use the <b>graduated: strict early, 1.96-like at the end</b>, which is very strict early and relaxes towards the end: about <b>6 in 100</b>.</li>
    <li>Set the effect to <b>a real lift: 10% to 13%</b> (+3 points): a single look finds it in about <b>86 of 100</b> experiments, and the graduated limit with 20 looks finds it in about <b>85</b>, stopping on average at <b>1,406</b> users per arm instead of 2,000. The flat wider limit is safe but finds only about <b>75</b>.</li>
  </ol>
  <div class="pg peek" data-peek>
    <div class="pg-row">
      <label>Real effect <select class="pg-in" data-eff>
        <option value="1000" selected>none (both arms convert at 10%)</option>
        <option value="1300">a real lift: 10% to 13%</option>
      </select></label>
      <label>Times the team looks <select class="pg-in" data-looks>
        <option value="1">1 look, at the end</option>
        <option value="4">4 looks</option>
        <option value="10">10 looks</option>
        <option value="20" selected>20 looks, one a day</option>
      </select></label>
      <label>Limit that decides a win <select class="pg-in" data-rule>
        <option value="fixed" selected>1.96 at every look (the fixed-sample test)</option>
        <option value="const">one wider limit at every look</option>
        <option value="obf">graduated: strict early, 1.96-like at the end</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Experiments declared a winner</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3 data-t2></h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Average users per arm at the decision</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: each user converts with a seeded random draw, 100 new users per arm per look, and the test is a two-proportion z test on all users so far. The experiment stops at the first look that crosses the limit. The flat limits come from the Pocock design (1.96, 2.36, 2.56 and 2.67 for 1, 4, 10 and 20 looks). The graduated limits are of the O'Brien-Fleming kind, c times the square root of looks divided by look number, with c close to 2.0 to 2.1. Both are approximations. With 1,000 experiments the rates carry a margin of about 1 point.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-peek]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const SIMS = 1000; const STEPS = 20; const PER = 100;
    const TAB: Record<string, Record<number, number>> = { const: { 1: 1.96, 4: 2.361, 10: 2.555, 20: 2.672 }, obf: { 1: 1.96, 4: 2.024, 10: 2.07, 20: 2.09 } };
    const SEED = 2024, BP = 10000; // conversion rates are in basis points
    const BASE_BP = 1000; // control converts at 10%
    const Z95 = 1.96; // two-sided 5% critical value for a single look
    const ALPHA_PCT = 5, BAD_PCT = 7.5; // promised false-positive rate, and the level that counts as broken
    const cache = new Map<number, { ca: Int32Array; cb: Int32Array }>();
    function build(rateB: number) {
      const hit = cache.get(rateB); if (hit) return hit;
      // linear congruential generator (Numerical Recipes constants), integer in 0..9999
      let seed = SEED; const draw = () => { seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0; return (seed >>> 16) % BP; };
      const ca = new Int32Array(SIMS * STEPS); const cb = new Int32Array(SIMS * STEPS);
      for (let s = 0; s < SIMS; s++) {
        let a = 0; let b = 0;
        for (let k = 0; k < STEPS; k++) { for (let i = 0; i < PER; i++) { if (draw() < BASE_BP) a++; if (draw() < rateB) b++; } ca[s * STEPS + k] = a; cb[s * STEPS + k] = b; }
      }
      const d = { ca, cb }; cache.set(rateB, d); return d;
    }
    const bound = (rule: string, looks: number, j: number) => (rule === 'fixed' ? Z95 : rule === 'const' ? TAB.const[looks] : TAB.obf[looks] * Math.sqrt(looks / j));
    function run(rateB: number, rule: string, looks: number) {
      const data = build(rateB); const every = STEPS / looks; let wins = 0; let users = 0;
      for (let s = 0; s < SIMS; s++) {
        let stopped = false;
        for (let j = 1; j <= looks; j++) {
          const k = j * every - 1; const n = (k + 1) * PER; const a = data.ca[s * STEPS + k]; const b = data.cb[s * STEPS + k];
          const p = (a + b) / (2 * n); const d = (a - b) / n; const z2 = p > 0 ? (d * d) / (p * (1 - p) * (2 / n)) : 0; const z = bound(rule, looks, j);
          if (z2 > z * z) { wins++; users += n; stopped = true; break; }
        }
        if (!stopped) users += STEPS * PER;
      }
      return { wins, avg: Math.round(users / SIMS) };
    }
    function draw() {
      const rateB = Number(q<HTMLSelectElement>('[data-eff]').value); const looks = Number(q<HTMLSelectElement>('[data-looks]').value); const rule = q<HTMLSelectElement>('[data-rule]').value;
      const real = rateB !== BASE_BP; const r = run(rateB, rule, looks); const pct = (r.wins / SIMS) * 100;
      q('[data-o1]').textContent = `${r.wins} of ${SIMS} (${pct.toFixed(1)}%)`;
      q('[data-n1]').textContent = real ? 'there is a real lift, so a win is the right answer' : 'there is no real effect, so every win is false';
      q('[data-t2]').textContent = real ? 'Chance of finding the real lift' : 'False win rate against the 5% promised';
      q('[data-o2]').textContent = `${pct.toFixed(1)}%`;
      q('[data-n2]').textContent = real ? `higher is better, as long as the no-effect rate stays near ${ALPHA_PCT}%` : (pct > BAD_PCT ? `${(pct / ALPHA_PCT).toFixed(1)} times what the report claims` : `close to the promised ${ALPHA_PCT}%`);
      q('[data-o3]').textContent = `${r.avg.toLocaleString('en-US')} of ${(STEPS * PER).toLocaleString('en-US')}`;
      q('[data-n3]').textContent = 'stopping early saves users, and only valid limits make it safe';
      const bad = !real && pct > BAD_PCT;
      q<HTMLElement>('[data-b1]').style.setProperty('--c', 'var(--accent)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', bad ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', 'var(--accent)');
      const out = q('[data-verdict]'); out.classList.toggle('bad', bad);
      out.textContent = real
        ? `The real lift was found in ${pct.toFixed(1)}% of experiments, with the average experiment using ${r.avg.toLocaleString('en-US')} users per arm. Compare the rules: a flat wider limit is safe but loses power, while the graduated limit keeps almost all of it.`
        : bad ? `${pct.toFixed(1)}% of experiments declared a winner although nothing changed, against the 5% the report claims. Each extra look is another chance for luck to cross 1.96, so the more often you look, the more false wins you ship.`
        : `${pct.toFixed(1)}% false wins, close to the promised 5%, even with ${looks} look${looks === 1 ? '' : 's'}. ${looks === 1 ? 'A single look at the planned sample size is always valid.' : 'The limit is wider at the looks where luck is most likely to mislead, which pays for the extra chances.'}`;
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
