---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Traffic and events are driven by users and events per user. How long one experiment must run is driven by the baseline rate and the smallest effect you want to see.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Daily users (millions) <input type="range" min="1" max="200" value="50" data-p /> <b data-pval></b></label>
      <label>Product events per user per day <input type="range" min="10" max="200" step="10" value="60" data-ev /> <b data-evval></b></label>
      <label>Assignment checks per user per day <input type="range" min="10" max="200" step="10" value="40" data-ch /> <b data-chval></b></label>
      <label>Experiments each user is in at once <input type="range" min="1" max="10" value="3" data-x /> <b data-xval></b></label>
      <label>Metrics computed per experiment <input type="range" min="5" max="60" step="5" value="20" data-mt /> <b data-mtval></b></label>
      <label>Baseline conversion rate (%) <input type="range" min="1" max="50" value="5" data-base /> <b data-baseval></b></label>
      <label>Smallest relative lift to detect (%) <input type="range" min="1" max="20" value="2" data-lift /> <b data-liftval></b></label>
      <label>Users who reach the tested page (%) <input type="range" min="1" max="100" value="5" data-reach /> <b data-reachval></b></label>
      <label>Share of those put in the experiment (%) <input type="range" min="1" max="100" value="10" data-alloc /> <b data-allocval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a peak of 3 times the average rate, an event of about 300 bytes in the stream and about 60 bytes per metric row, columnar files compress the raw events 5 times, 80% power and a 5% two-sided significance level (so the sample per arm is 16 times p(1-p) divided by the square of the absolute effect), and a 50/50 split. Real runs last whole weeks so that every weekday is covered.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const N_ROWS = 10; // output lines below
    const MILLION = 1e6; const GB = 1e9; const GB_PER_TB = 1000; const DAY_S = 86400; const WEEK_D = 7;
    const PEAK_FACTOR = 3; // peak rate over the daily average
    const EXPOSURES_PER_EXPERIMENT = 1; // exposure events per user per day for each running experiment
    const EVENT_BYTES = 300; const COMPRESSION = 5; const METRIC_ROW_BYTES = 60;
    const LEHR = 16; // Lehr's rule: n per arm = 16 p(1-p) / delta^2 for 80% power at 5% significance
    const ARMS = 2; const RETENTION_DAYS = 90;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const big = (n: number) => (n >= 1e9 ? `${(n / 1e9).toFixed(1)} billion` : n >= 1e6 ? `${(n / 1e6).toFixed(1)} million` : fmt(n));
    function draw() {
      const keys = ['p', 'ev', 'ch', 'x', 'mt', 'base', 'lift', 'reach', 'alloc'];
      keys.forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const users = val('[data-p]') * MILLION; const ev = val('[data-ev]'); const ch = val('[data-ch]'); const x = val('[data-x]'); const mt = val('[data-mt]');
      const base = val('[data-base]') / 100; const lift = val('[data-lift]') / 100; const reach = val('[data-reach]') / 100; const alloc = val('[data-alloc]') / 100;
      const checksPeak = ((users * ch) / DAY_S) * PEAK_FACTOR;
      const events = users * (ev + x * EXPOSURES_PER_EXPERIMENT);
      const eventsPerSec = (events / DAY_S) * PEAK_FACTOR;
      const rawDayGb = (events * EVENT_BYTES) / GB; const storedDayGb = rawDayGb / COMPRESSION;
      const metricRows = users * x * mt; const metricGb = (metricRows * METRIC_ROW_BYTES) / GB;
      const delta = base * lift; const perArm = (LEHR * base * (1 - base)) / (delta * delta);
      const enrolled = users * reach * alloc; const days = (ARMS * perArm) / Math.max(1, enrolled);
      const planned = Math.max(WEEK_D, Math.ceil(days / WEEK_D) * WEEK_D); // whole weeks, at least one
      const data: [string, string][] = [
        ['Assignment checks per second at the peak (all local in the SDK)', fmt(checksPeak)],
        ['Events per day (product events plus exposures)', big(events)],
        ['Event stream rate at the peak, per second', fmt(eventsPerSec)],
        ['Raw events per day', `${fmt(rawDayGb)} GB, about ${fmt(storedDayGb)} GB stored`],
        [`Raw event storage for ${RETENTION_DAYS} days`, `${(storedDayGb * RETENTION_DAYS / GB_PER_TB).toFixed(1)} TB`],
        ['Per-user metric rows per day', `${big(metricRows)}, about ${fmt(metricGb)} GB`],
        ['Absolute effect to detect', `${(delta * 100).toFixed(2)} points on ${(base * 100).toFixed(0)}%`],
        ['Users needed per arm', fmt(perArm)],
        ['Users entering the experiment per day', fmt(enrolled)],
        ['Days to collect the sample, and the planned run', `${days.toFixed(1)} days, run ${planned} days`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
