---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Task runs per day set the worker fleet and the write rate on the metadata database. A backfill multiplies both for a while.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Pipelines <input type="range" min="100" max="5000" step="100" value="1000" data-p /> <b data-pval></b></label>
      <label>Tasks per pipeline <input type="range" min="2" max="40" value="10" data-t /> <b data-tval></b></label>
      <label>Runs per pipeline per day <input type="range" min="1" max="24" value="1" data-r /> <b data-rval></b></label>
      <label>Average task time (minutes) <input type="range" min="1" max="60" value="5" data-m /> <b data-mval></b></label>
      <label>Slots per worker <input type="range" min="4" max="64" step="4" value="16" data-s /> <b data-sval></b></label>
      <label>Days in a backfill <input type="range" min="1" max="365" value="90" data-d /> <b data-dval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each task goes through about 5 state changes (scheduled, queued, running, success and one more for retries or heartbeats), 10% of task runs are retried once, runs are bunched into 4 busy hours that hold half of the day's work, and a backfill of one pipeline runs 10 days at once, each run using about 3 slots at a time and taking about half the sum of its task times because branches overlap.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const RETRY_FACTOR = 1.1; // 10% of tasks run a second attempt
    const BUSY = { share: 0.5, hours: 4 }; // half of the day's task runs start in 4 busy hours
    const HOUR_S = 3600, DAY_S = 86400, MIN_S = 60, MIN_PER_H = 60;
    const WRITES_PER_TASK = 5; // state transitions written per task run
    const BACKFILL_PAR = 10; // backfill runs 10 days at a time
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const p = val('[data-p]'); const t = val('[data-t]'); const r = val('[data-r]'); const m = val('[data-m]'); const s = val('[data-s]'); const d = val('[data-d]');
      ['p', 't', 'r', 'm', 's', 'd'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const tasks = p * t * r; const attempts = tasks * RETRY_FACTOR;
      const peakPerSec = (attempts * BUSY.share) / (BUSY.hours * HOUR_S);
      const busySlots = (attempts * BUSY.share * m * MIN_S) / (BUSY.hours * HOUR_S); // task-seconds in the busy hours divided by seconds
      const workers = Math.ceil(busySlots / s);
      const writes = (tasks * WRITES_PER_TASK) / DAY_S; const writesPeak = (tasks * WRITES_PER_TASK * BUSY.share) / (BUSY.hours * HOUR_S);
      const bfTasks = d * t; const bfRunMin = (t / 2) * m; // a run is about half as long as its tasks in a row, since branches overlap
      const bfHours = (Math.ceil(d / BACKFILL_PAR) * bfRunMin) / MIN_PER_H;
      const data: [string, string][] = [
        ['Task runs per day', fmt(tasks)],
        ['Task starts per second at the busy hours', peakPerSec.toFixed(1)],
        ['Task slots busy at the busy hours', fmt(busySlots)],
        ['Workers needed', fmt(workers)],
        ['State writes per second, average', writes.toFixed(1)],
        ['State writes per second at the busy hours', writesPeak.toFixed(1)],
        ['Task runs in a backfill of one pipeline', fmt(bfTasks)],
        ['Extra slots the backfill takes while it runs', '30'],
        ['Time to finish the backfill', `${bfHours.toFixed(1)} hours`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
