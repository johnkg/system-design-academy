---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Re-run history: append or replace?" hint="A 30-day backfill where a task can fail halfway through its write. Change how the task writes and how the re-run is done, and count the days that end up wrong.">
  <ol class="how">
    <li>The default is <b>append</b>, 25% failures, <b>2 retries</b>, the backfill run <b>twice</b> and not skipping finished days: <b>all 30 days</b> end with duplicate rows, 36,000 too many. Each failed attempt left 400 rows, and each repeat added 1,000 more.</li>
    <li>Switch to <b>replacing the day's partition</b>: all 30 days are correct however many retries or re-runs, because every attempt overwrites the one before it.</li>
    <li>With <b>append</b>, tick <b>skip days already successful</b>: the second run no longer adds data, but the days that needed a retry still hold the 400 rows of the failed attempt (8 days, 3,200 extra rows). Skipping helps, only replacing makes it right.</li>
  </ol>
  <div class="pg dpo" data-dpo>
    <div class="pg-row">
      <label>The task writes by <select class="pg-in" data-mode><option value="append" selected>appending rows</option><option value="overwrite">replacing the day's partition</option></select></label>
      <label>Failure chance per attempt (%) <input type="range" min="0" max="50" step="5" value="25" data-p /> <b data-pval></b></label>
      <label>Retries <input type="range" min="0" max="4" value="2" data-r /> <b data-rval></b></label>
      <label>Times the backfill is run <input type="range" min="1" max="3" value="2" data-n /> <b data-nval></b></label>
      <label><input type="checkbox" data-skip /> Skip days already successful</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Correct days</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Days with extra rows</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Days missing or partial</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Rows in the table</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 30 days of 1,000 rows each. An attempt fails with the chosen chance after writing 400 rows, and otherwise writes all 1,000. Appending adds what was written to the day, and replacing sets the day to it. Without skipping, every run of the backfill starts each day again. The failures are drawn from one fixed random sequence, so the same settings always give the same answer.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-dpo]').forEach((root) => {
    const q = query(root);
    const DAYS = 30; const FULL = 1000; const PART = 400;
    function sim(mode: string, pct: number, retries: number, runs: number, skip: boolean) {
      // Numerical Recipes LCG
      let seed = 77; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
      const days = Array.from({ length: DAYS }, () => ({ rows: 0, done: false }));
      let attempts = 0;
      for (let r = 0; r < runs; r++) for (const d of days) {
        if (skip && d.done) continue;
        d.done = false;
        for (let a = 0; a <= retries; a++) {
          attempts++; const fail = rnd() * 100 < pct; const w = fail ? PART : FULL;
          d.rows = mode === 'append' ? d.rows + w : w;
          if (!fail) { d.done = true; break; }
        }
      }
      let ok = 0; let dup = 0; let miss = 0; let extra = 0; let total = 0;
      for (const d of days) { if (!d.done || d.rows < FULL) miss++; else if (d.rows === FULL) ok++; else dup++; if (d.rows > FULL) extra += d.rows - FULL; total += d.rows; }
      return { ok, dup, miss, extra, total, attempts };
    }
    const fmt = (n: number) => n.toLocaleString('en-US');
    function draw() {
      const mode = q<HTMLSelectElement>('[data-mode]').value; const pct = Number(q<HTMLInputElement>('[data-p]').value); const retries = Number(q<HTMLInputElement>('[data-r]').value);
      const runs = Number(q<HTMLInputElement>('[data-n]').value); const skip = q<HTMLInputElement>('[data-skip]').checked;
      q('[data-pval]').textContent = String(pct); q('[data-rval]').textContent = String(retries); q('[data-nval]').textContent = String(runs);
      const r = sim(mode, pct, retries, runs, skip);
      q('[data-o1]').textContent = `${r.ok} of ${DAYS}`; q('[data-n1]').textContent = 'exactly 1,000 rows and finished';
      q('[data-o2]').textContent = `${r.dup} of ${DAYS}`; q('[data-n2]').textContent = `${fmt(r.extra)} extra rows in total`;
      q('[data-o3]').textContent = `${r.miss} of ${DAYS}`; q('[data-n3]').textContent = 'every attempt failed';
      q('[data-o4]').textContent = fmt(r.total); q('[data-n4]').textContent = `should be ${fmt(DAYS * FULL)}, after ${r.attempts} attempts`;
      q<HTMLElement>('[data-b1]').style.setProperty('--c', r.ok === DAYS ? 'var(--good)' : 'var(--accent)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', r.dup ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', r.miss ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b4]').style.setProperty('--c', r.total === DAYS * FULL ? 'var(--good)' : 'var(--bad)');
      const out = q('[data-verdict]'); const bad = r.ok !== DAYS; out.classList.toggle('bad', bad);
      out.textContent = !bad ? `All ${DAYS} days are exactly right. ${mode === 'overwrite' ? 'Every attempt replaced the day, so retries and re-runs change nothing.' : 'Nothing needed a retry here.'}`
        : r.dup ? `${r.dup} days hold duplicated or leftover rows (${fmt(r.extra)} extra). Appending is not safe to repeat: a retry or re-run adds on top of whatever is there.${mode === 'append' ? ' Replacing the partition fixes it.' : ''}`
        : `${r.miss} days never finished, because ${retries === 0 ? 'there are no retries' : 'every attempt failed'}. Add retries, or run the backfill again; replacing makes that safe.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
