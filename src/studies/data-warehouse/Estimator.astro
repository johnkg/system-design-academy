---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The bytes you scan set both the time and the bill. See how columns, compression and date partitions each cut them.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Fact rows (billions) <input type="range" min="1" max="100" value="10" data-r /> <b data-rval></b></label>
      <label>Columns in the table <input type="range" min="5" max="100" value="20" data-c /> <b data-cval></b></label>
      <label>Average bytes per value <input type="range" min="2" max="40" value="10" data-w /> <b data-wval></b></label>
      <label>Days of data kept <input type="range" min="30" max="1095" step="5" value="365" data-d /> <b data-dval></b></label>
      <label>Columns the query reads <input type="range" min="1" max="40" value="3" data-q /> <b data-qval></b></label>
      <label>Days the query covers <input type="range" min="1" max="365" value="30" data-n /> <b data-nval></b></label>
      <label>Column compression (times smaller) <input type="range" min="1" max="10" value="4" data-z /> <b data-zval></b></label>
      <label>Worker nodes <input type="range" min="1" max="128" value="16" data-k /> <b data-kval></b></label>
      <label>Scan speed per node (GB/s) <input type="range" min="0.2" max="5" step="0.2" value="1" data-s /> <b data-sval></b></label>
      <label>Price per TB scanned ($) <input type="range" min="1" max="10" step="0.5" value="5" data-p /> <b data-pval></b></label>
      <label>Queries per day <input type="range" min="100" max="50000" step="100" value="5000" data-qd /> <b data-qdval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a row store reads whole rows and has no compression, the table is partitioned by day, and a column store reads only the columns the query names. Time is bytes read divided by the total scan speed of the nodes, so it assumes the work spreads evenly. Joins, shuffles and result transfer are not counted, and the cost is the on-demand price per TB of stored data read.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 10 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const bytes = (b: number) => (b >= 1e12 ? `${(b / 1e12).toFixed(2)} TB` : b >= 1e9 ? `${(b / 1e9).toFixed(1)} GB` : `${(b / 1e6).toFixed(1)} MB`);
    const secs = (t: number) => (t >= 3600 ? `${(t / 3600).toFixed(1)} h` : t >= 60 ? `${(t / 60).toFixed(1)} min` : t >= 1 ? `${t.toFixed(1)} s` : `${Math.round(t * 1000)} ms`);
    const usd = (v: number) => `$${v >= 100 ? Math.round(v).toLocaleString('en-US') : v.toFixed(v < 1 ? 3 : 2)}`;
    function draw() {
      const rowsN = val('[data-r]') * 1e9; const cols = val('[data-c]'); const width = val('[data-w]'); const days = val('[data-d]');
      const read = Math.min(val('[data-q]'), cols); const range = Math.min(val('[data-n]'), days); const ratio = val('[data-z]');
      const nodes = val('[data-k]'); const speed = val('[data-s]') * 1e9; const price = val('[data-p]'); const perDay = val('[data-qd]');
      ['r', 'c', 'w', 'd', 'q', 'n', 'z', 'k', 's', 'p', 'qd'].forEach((k) => (q(`[data-${k}val]`).textContent = k === 'q' ? String(read) : k === 'n' ? String(range) : String(val(`[data-${k}]`))));
      const raw = rowsN * cols * width;
      const partitioned = raw * (range / days);
      const colsOnly = partitioned * (read / cols);
      const small = colsOnly / ratio;
      const rate = nodes * speed;
      const data: [string, string][] = [
        ['Table size, uncompressed', bytes(raw)],
        ['Row store with no partitions: reads everything', `${bytes(raw)}, ${secs(raw / rate)}`],
        ['Row store with date partitions', `${bytes(partitioned)}, ${secs(partitioned / rate)}`],
        ['Column store: only the columns needed', bytes(colsOnly)],
        ['Column store: after compression', bytes(small)],
        ['Column store reads this many times less than the partitioned row store', `${(partitioned / small).toFixed(1)} times`],
        ['Query time on the column store', secs(small / rate)],
        ['Cost of one query, column store', usd((small / 1e12) * price)],
        ['Cost per day, partitioned row store', usd((partitioned / 1e12) * price * perDay)],
        ['Cost per day, column store', usd((small / 1e12) * price * perDay)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
