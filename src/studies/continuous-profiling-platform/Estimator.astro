---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The sampling rate multiplies everything: CPU spent in the agents, bytes on the wire and rows in storage. Agent-side aggregation and a stack-id cache are what keep the totals small.">
  <div class="pg est" data-cpe>
    <div class="pg-row">
      <label>Hosts <input type="range" min="500" max="50000" step="500" value="5000" data-h /> <b data-hval></b></label>
      <label>Profiled processes per host <input type="range" min="1" max="20" value="6" data-pp /> <b data-ppval></b></label>
      <label>Samples per second per process (Hz) <input type="range" min="1" max="100" value="20" data-hz /> <b data-hzval></b></label>
      <label>Upload interval (seconds) <input type="range" min="10" max="120" step="10" value="60" data-iv /> <b data-ivval></b></label>
      <label>Distinct stacks (% of samples in one interval) <input type="range" min="2" max="60" value="20" data-ds /> <b data-dsval></b></label>
      <label>CPU cost of one sample (microseconds) <input type="range" min="20" max="1000" step="10" value="100" data-cost /> <b data-costval></b></label>
      <label>Compression ratio of stored rows <input type="range" min="1" max="10" value="5" data-cr /> <b data-crval></b></label>
      <label>Retention (days) <input type="range" min="1" max="90" value="30" data-ret /> <b data-retval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a stack has 40 frames of 8 bytes, so a raw sample is about 336 bytes with its timestamp and labels. After aggregation an agent sends one count per distinct stack. With a stack-id cache the agent sends 12 bytes (id and count) per distinct stack, plus the full 320-byte stack for the 5% of distinct stacks that are new in this interval. A stored row is 12 bytes before compression.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-cpe]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const N_ROWS = 10; // output lines below
    const MB = 1e6; const GB = 1e9; const BILLION = 1e9; const GB_PER_TB = 1000; const US_PER_S = 1e6; const DAY_S = 86400;
    const RAW_SAMPLE_BYTES = 336; // one raw sample with its full stack
    const ROW_BYTES = 12; // aggregated row: stack id and count
    const NEW_STACK_SHARE = 0.05; const STACK_BYTES = 320; // stacks not yet in the id cache, sent in full
    const CPU_BUDGET_PCT = 1; // profiler overhead budget per process
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const one = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    function draw() {
      const hosts = val('[data-h]'); const pp = val('[data-pp]'); const hz = val('[data-hz]'); const iv = val('[data-iv]');
      const ds = val('[data-ds]') / 100; const cost = val('[data-cost]'); const cr = val('[data-cr]'); const ret = val('[data-ret]');
      ['h', 'pp', 'hz', 'iv', 'ds', 'cost', 'cr', 'ret'].forEach((k) => (q(`[data-${k}val]`).textContent = fmt(val(`[data-${k}]`))));
      const procs = hosts * pp; const samples = procs * hz;
      const rawMb = (samples * RAW_SAMPLE_BYTES) / MB;
      const distinct = hz * iv * ds; // distinct stacks per process per interval
      const uploadMb = (procs * (distinct * ROW_BYTES + distinct * NEW_STACK_SHARE * STACK_BYTES)) / iv / MB;
      const overheadPct = (hz * cost) / (US_PER_S / 100); // microseconds per second, as a percent of one core
      const cores = (procs * hz * cost) / US_PER_S;
      const rowsPerDay = procs * distinct * (DAY_S / iv);
      const dayGb = (rowsPerDay * ROW_BYTES) / cr / GB;
      const data: [string, string][] = [
        ['Profiled processes', fmt(procs)],
        ['Samples taken per second, fleet-wide', fmt(samples)],
        ['Wire traffic if every raw sample were shipped', `${one(rawMb)} MB/s`],
        ['Wire traffic with aggregation and a stack-id cache', `${one(uploadMb)} MB/s`],
        ['Profiler CPU per process', `${one(overheadPct)}% of a core, ${overheadPct <= CPU_BUDGET_PCT ? 'within' : 'over'} a ${CPU_BUDGET_PCT}% budget`],
        ['Cores spent on profiling across the fleet', fmt(cores)],
        ['Rows written per day', `${one(rowsPerDay / BILLION)} billion`],
        ['Stored per day after compression', `${one(dayGb)} GB`],
        ['Stored for the whole retention', `${one((dayGb * ret) / GB_PER_TB)} TB`],
        ['Saving from aggregation and the stack-id cache', `${fmt(rawMb / uploadMb)} times less traffic`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
