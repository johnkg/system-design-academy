---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Retry after a timeout" hint="1,000 customers pay. Some replies are lost, so the shop retries. Compare retrying with and without an idempotency key. Both columns use the same random events.">
  <ol class="how">
    <li>Leave the timeout rate at <b>10%</b> and attempts at <b>2</b>. Without keys, some customers are <b>charged twice</b>, and every one of them is real money.</li>
    <li>Look at the right-hand column: with keys, <b>no one is charged twice</b>, however many retries.</li>
    <li>Set the timeout rate to <b>40%</b>: even with keys, some payments are <b>still unknown</b> after the retries. Those need the provider's webhook or a status check, and the shop must not guess.</li>
  </ol>
  <div class="pg pyb" data-pyb>
    <div class="pg-row">
      <RangeField label="Share of calls that time out (%)" name="rate" min="0" max="40" step="1" value="10" />
      <label>Attempts per payment <select class="pg-in" data-tries>
        <option value="1">1 (never retry)</option>
        <option value="2" selected>2</option>
        <option value="3">3</option>
        <option value="4">4</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-nbox><h3>Retry without a key</h3><span class="pg-mono" data-nout></span><span class="pg-note" data-nnote></span></div>
      <div class="pg-box" data-kbox><h3>Retry with an idempotency key</h3><span class="pg-mono" data-kout></span><span class="pg-note" data-knote></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: each of the 1,000 payments is $25. A call that times out has a 50% chance that the charge happened and only the reply was lost. A reply that arrives ends the payment. Without a key, every attempt that reaches the provider creates a new charge. With a key, the provider keeps the first charge and returns it to the retries.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-pyb]').forEach((root) => {
    const q = query(root);
    const N = 1000; const MAX = 4;
    const SEED = 11; const PRICE = 25; // dollars per order
    let seed = SEED; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
    const draws = Array.from({ length: N }, () => Array.from({ length: MAX }, () => ({ lost: rnd(), charged: rnd() })));
    function run(rate: number, tries: number, keyed: boolean) {
      let once = 0; let twice = 0; let surprise = 0; let none = 0;
      for (const d of draws) {
        let charges = 0; let told = false;
        for (let a = 0; a < tries; a++) {
          const timedOut = d[a].lost < rate;
          if (!timedOut) { if (!keyed || charges === 0) charges++; told = true; break; }
          if (d[a].charged < 0.5 && (!keyed || charges === 0)) charges++;
        }
        if (charges === 0) none++;
        else if (charges > 1) twice++;
        else if (told) once++;
        else surprise++;
      }
      return { once, twice, surprise, none };
    }
    function draw() {
      const rate = Number(q<HTMLInputElement>('[data-rate]').value) / 100; const tries = Number(q<HTMLSelectElement>('[data-tries]').value);
      q('[data-rateval]').textContent = String(Math.round(rate * 100));
      const n = run(rate, tries, false); const k = run(rate, tries, true);
      const f = (r: ReturnType<typeof run>) => `${r.once} charged once and told so`;
      q('[data-nout]').textContent = f(n); q('[data-kout]').textContent = f(k);
      q('[data-nnote]').textContent = `${n.twice} charged twice or more ($${n.twice * PRICE} too much) · ${n.surprise} charged but told it failed · ${n.none} not charged`;
      q('[data-knote]').textContent = `${k.twice} charged twice · ${k.surprise} charged but outcome still unknown, settled by webhook · ${k.none} not charged`;
      q<HTMLElement>('[data-nbox]').style.setProperty('--c', n.twice > 0 ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-kbox]').style.setProperty('--c', k.twice > 0 ? 'var(--bad)' : 'var(--good)');
      const out = q('[data-verdict]'); const bad = n.twice > 0;
      out.classList.toggle('bad', bad);
      out.textContent = bad
        ? `Without a key, ${n.twice} customers were charged more than once. With a key, ${k.twice} were.${k.surprise > 0 ? ` The ${k.surprise} unknown payments are settled by the provider's webhook, not by guessing.` : ''}`
        : tries === 1 ? 'With a single attempt nothing can be charged twice, but every lost reply leaves a payment that nobody has resolved.' : 'No retries were needed or no duplicates occurred with these settings.';
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
