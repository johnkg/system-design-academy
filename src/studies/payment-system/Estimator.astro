---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Payment volume is modest. What matters is how many of those payments end in doubt, and what that costs.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Payments per day (thousands) <input type="range" min="1" max="2000" value="200" data-pay /> <b data-payval></b></label>
      <label>Share that time out or lose the reply (%) <input type="range" min="0.1" max="5" step="0.1" value="1" data-to /> <b data-toval></b></label>
      <label>Average payment ($) <input type="range" min="5" max="500" step="5" value="60" data-amt /> <b data-amtval></b></label>
      <label>Ledger entries per payment <input type="range" min="2" max="10" value="4" data-ent /> <b data-entval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: peak traffic is 5 times the average, about half of the timed-out charges actually went through, a ledger entry takes about 200 bytes with its indexes, and without idempotency keys every timed-out payment is retried once.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const pay = val('[data-pay]') * 1000; const to = val('[data-to]') / 100; const amt = val('[data-amt]'); const ent = val('[data-ent]');
      q('[data-payval]').textContent = String(val('[data-pay]')); q('[data-toval]').textContent = to * 100 === Math.round(to * 100) ? String(to * 100) : (to * 100).toFixed(1);
      q('[data-amtval]').textContent = String(amt); q('[data-entval]').textContent = String(ent);
      const perSec = (pay / 86400) * 5; const doubt = pay * to; const dupes = doubt * 0.5;
      const data: [string, string][] = [
        ['Payments per second at the peak', perSec.toFixed(1)],
        ['Payments with an uncertain outcome per day', fmt(doubt)],
        ['Double charges per day without idempotency keys', fmt(dupes)],
        ['Money wrongly taken per day without keys', `$${fmt(dupes * amt)}`],
        ['Double charges per day with keys', '0'],
        ['Ledger entries written per day', fmt(pay * ent)],
        ['Ledger storage per year', `${((pay * ent * 200 * 365) / 1e9).toFixed(1)} GB`],
        ['Lines in the daily settlement report', fmt(pay)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
