---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The busiest hour sets how many runners you need, and a fixed pool sized for it sits idle most of the day. The cache shrinks every number.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Repositories (thousands) <input type="range" min="1" max="100" value="10" data-r /> <b data-rval></b></label>
      <label>Repositories with activity on a working day (%) <input type="range" min="5" max="80" step="5" value="30" data-act /> <b data-actval></b></label>
      <label>Builds per active repository per day <input type="range" min="1" max="30" value="8" data-b /> <b data-bval></b></label>
      <label>Jobs per build <input type="range" min="1" max="20" value="6" data-j /> <b data-jval></b></label>
      <label>Minutes per job without a cache <input type="range" min="1" max="20" value="5" data-m /> <b data-mval></b></label>
      <label>Minutes the cache saves (%) <input type="range" min="0" max="70" step="5" value="30" data-c /> <b data-cval></b></label>
      <label>Busiest hour compared with the average hour <input type="range" min="1" max="8" value="4" data-pk /> <b data-pkval></b></label>
      <label>Runner price ($ per hour) <input type="range" min="0.05" max="0.60" step="0.01" value="0.17" data-pr /> <b data-prval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: builds happen in a 10-hour working day, so the average hour is a tenth of the day. A runner runs one job at a time. An autoscaled pool pays for 25% more than the busy minutes, for boot time and idle waiting. A job writes about 0.4 MB of compressed logs, a build keeps about 20 MB of artifacts for 14 days, and each active repository holds about 1 GB of caches.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 10; // output lines below
    const THOUSAND = 1000; const MIN_PER_H = 60; const HOUR_S = 3600; const HOURS_PER_DAY = 24; const MB_PER_GB = 1000; const GB_PER_TB = 1000;
    const WORK_HOURS = 10; // builds are spread over a 10-hour working day
    const AUTOSCALE_OVERHEAD = 1.25; // autoscaled runners are billed 25% above their busy time
    const LOG_MB_PER_JOB = 0.4; const ARTIFACT_GB_PER_BUILD = 0.02; const KEEP_DAYS = 14; const CACHE_GB_PER_REPO = 1;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const one = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    function draw() {
      const repos = val('[data-r]') * THOUSAND; const act = val('[data-act]') / 100; const perRepo = val('[data-b]'); const jobsPer = val('[data-j]');
      const mins = val('[data-m]'); const saved = val('[data-c]') / 100; const peak = val('[data-pk]'); const price = val('[data-pr]');
      ['r', 'act', 'b', 'j', 'm', 'c', 'pk'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      q('[data-prval]').textContent = `$${price.toFixed(2)}`;
      const builds = repos * act * perRepo; const jobs = builds * jobsPer; const jobMin = jobs * mins * (1 - saved); const busyHours = jobMin / MIN_PER_H;
      const peakBuildsHour = (builds / WORK_HOURS) * peak; const peakRunners = (peakBuildsHour * jobsPer * mins * (1 - saved)) / MIN_PER_H;
      const avgRunners = busyHours / WORK_HOURS;
      const auto = busyHours * price * AUTOSCALE_OVERHEAD; const fixed = peakRunners * HOURS_PER_DAY * price;
      const logsGb = (jobs * LOG_MB_PER_JOB) / MB_PER_GB; const storageTb = (builds * ARTIFACT_GB_PER_BUILD * KEEP_DAYS + repos * act * CACHE_GB_PER_REPO) / GB_PER_TB;
      const data: [string, string][] = [
        ['Builds per day', fmt(builds)],
        ['Builds started per second in the busiest hour', one(peakBuildsHour / HOUR_S)],
        ['Jobs per day', fmt(jobs)],
        ['Runner time per day after the cache', `${fmt(busyHours)} hours`],
        ['Runners busy on average over the working day', fmt(avgRunners)],
        ['Runners needed in the busiest hour', fmt(peakRunners)],
        ['Cost per day, autoscaled pool', `$${fmt(auto)}`],
        ['Cost per day, fixed pool sized for the peak and running all day', `$${fmt(fixed)}`],
        ['Compressed logs per day', `${one(logsGb)} GB`],
        ['Artifacts and caches kept', `${one(storageTb)} TB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
