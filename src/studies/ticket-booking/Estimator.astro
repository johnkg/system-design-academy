---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="A big on-sale has many more fans than seats. See the load with and without a waiting room and a cache.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Fans trying to buy (thousands) <input type="range" min="10" max="5000" step="10" value="1000" data-fans /> <b data-fansval></b></label>
      <label>Seats on sale (thousands) <input type="range" min="1" max="100" value="50" data-seats /> <b data-seatsval></b></label>
      <label>Seat map refresh interval of each fan (seconds) <input type="range" min="1" max="10" value="3" data-ref /> <b data-refval></b></label>
      <label>Fans let in per second <input type="range" min="100" max="5000" step="100" value="1000" data-admit /> <b data-admitval></b></label>
      <label>Hold length (minutes) <input type="range" min="2" max="20" value="8" data-hold /> <b data-holdval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each fan wants 2 seats, an admitted fan makes about 3 booking requests, the seat map has 50 sections cached separately and refreshed once a second, and a quarter of the admitted fans end up holding seats for the whole hold length.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 8; // output lines below
    const THOUSAND = 1000; const S_PER_MIN = 60;
    const REQ_PER_FAN = 3; // booking requests per fan (pick, hold, pay)
    const RUSH_S = 10; // without a waiting room every fan arrives within 10 seconds
    const HOLDING_SHARE = 0.25; const SEATS_PER_FAN = 2; // admitted fans holding seats at once; seats each
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const fans = val('[data-fans]') * THOUSAND; const seats = val('[data-seats]') * THOUSAND; const ref = val('[data-ref]'); const admit = val('[data-admit]'); const hold = val('[data-hold]');
      ['fans', 'seats', 'ref', 'admit', 'hold'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const minutes = fans / admit / S_PER_MIN;
      const data: [string, string][] = [
        ['Seat map requests per second, no cache', fmt(fans / ref)],
        ['Reaching the database with a cache', '50'],
        ['Booking requests per second through the waiting room', fmt(admit * REQ_PER_FAN)],
        ['Booking requests per second with no waiting room', fmt(fans * REQ_PER_FAN / RUSH_S)],
        ['Time to let every fan through the room', `${minutes < 1 ? '< 1' : fmt(minutes)} minutes`],
        ['Seats held at the same time (peak)', fmt(Math.min(seats, admit * HOLDING_SHARE * SEATS_PER_FAN * hold * S_PER_MIN))],
        [`Chance that a given fan gets ${SEATS_PER_FAN} seats`, `${Math.min(100, (seats / SEATS_PER_FAN / fans) * 100).toFixed(1)}%`],
        ['Fans who leave with nothing', fmt(Math.max(0, fans - seats / SEATS_PER_FAN))],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
