---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="A commit is cheap in messages but costly in forced disk writes and in lock time. Move the sliders to see which one dominates.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Transactions per second <input type="range" min="500" max="100000" step="500" value="5000" data-tps /> <b data-tpsval></b></label>
      <label>Shards per transaction <input type="range" min="2" max="8" value="3" data-n /> <b data-nval></b></label>
      <label>Round trip between coordinator and shard (ms) <input type="range" min="0.2" max="100" step="0.2" value="1" data-rtt /> <b data-rttval></b></label>
      <label>Time of one forced log write (ms) <input type="range" min="0.1" max="10" step="0.1" value="1" data-fs /> <b data-fsval></b></label>
      <label>Transactions per group commit <input type="range" min="1" max="100" value="10" data-g /> <b data-gval></b></label>
      <label>Time to replace a lost coordinator (s) <input type="range" min="1" max="600" value="30" data-rest /> <b data-restval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: four messages per shard per transaction (prepare, vote, commit, acknowledgement), shards prepare in parallel, each shard forces its log twice (prepared and commit), the coordinator forces one commit record, and one log device does 1,000 divided by the write time forced writes per second. The client is answered once the commit record is durable. A shard holds its locks from the start of its prepare write until its commit write, and a hot row can be changed by one transaction at a time. Group commit applies to every forced write, and the time spent waiting for a group to fill is not counted in the latency. The in-doubt count is by Little's law, the load times the time between a yes vote and the decision arriving.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 9; // one per output line
    const MS_PER_S = 1000;
    const MSGS_PER_SHARD = 4; // prepare, vote, commit, acknowledgement
    const SHARD_FORCES = 2; // forced writes per shard: prepare and commit
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const dec = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
    function draw() {
      const tps = val('[data-tps]'); const n = val('[data-n]'); const rtt = val('[data-rtt]'); const fs = val('[data-fs]'); const g = val('[data-g]'); const rest = val('[data-rest]');
      ['tps', 'n', 'rtt', 'fs', 'g', 'rest'].forEach((k) => (q(`[data-${k}val]`).textContent = dec(val(`[data-${k}]`))));
      const messages = tps * n * MSGS_PER_SHARD;
      const coordForces = tps / g; const perDevice = MS_PER_S / fs; const devices = Math.ceil(coordForces / perDevice);
      const shardForces = (tps * n * SHARD_FORCES) / g; // each shard also batches its forced writes
      const commitMs = rtt + fs + fs; // prepare round trip and write, then the commit record
      const holdMs = fs + rtt + fs + fs; // prepare write, the round trip, the commit record, the shard's commit write
      const hotTps = MS_PER_S / holdMs;
      const inDoubtMs = rtt + fs; // from a shard's yes vote until the commit message arrives
      const inDoubt = tps * (inDoubtMs / MS_PER_S);
      const stuckRowSeconds = inDoubt * n * rest;
      const data: [string, string][] = [
        ['Messages per second', fmt(messages)],
        ['Coordinator forced writes per second', fmt(coordForces)],
        ['Log devices needed for the coordinators', fmt(devices)],
        ['Shard forced writes per second, all shards', fmt(shardForces)],
        ['Latency the client sees for a commit', `${dec(commitMs)} ms`],
        ['Lock hold time per shard', `${dec(holdMs)} ms`],
        ['Most transactions per second on one hot row', fmt(hotTps)],
        ['Transactions in doubt if the coordinator dies', fmt(inDoubt)],
        ['Row-seconds of locks blocked until it is replaced', fmt(stuckRowSeconds)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
