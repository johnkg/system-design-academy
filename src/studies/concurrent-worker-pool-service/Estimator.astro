---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Workers are sized by cores for CPU-bound work and by waiting time for I/O-bound work. The queue is sized by how long a job may wait, not by how much memory is free.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Jobs submitted per second at the peak" name="r" min="1" max="500" value="40" />
      <RangeField label="Time a job needs on a core (ms)" name="cpu" min="10" max="2000" step="10" value="2000" />
      <RangeField label="Time a job spends waiting on I/O (ms)" name="io" min="0" max="5000" step="50" value="300" />
      <RangeField label="Cores per machine" name="cores" min="2" max="64" value="16" />
      <RangeField label="Longest a job may wait in the queue (s)" name="w" min="1" max="120" value="10" />
      <RangeField label="Size of a queued job (KB)" name="kb" min="1" max="512" value="20" />
      <RangeField label="Busiest tenant's share of the traffic (%)" name="big" min="5" max="90" step="5" value="50" />
      <RangeField label="Machine start-up time (s)" name="boot" min="10" max="300" step="10" value="60" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a worker that waits on I/O does not use a core, so one core can serve (CPU time + wait time) / CPU time workers. Machines are kept at most 70% busy on CPU. The queue is sized so that the last job in a full queue is served just inside the wait limit. The 'fleet taken' figure is the busiest tenant's jobs per second as a share of what the fleet can finish; it is capped at 100%. Queue storage is before replication.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatWholeNumber } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const MS_PER_S = 1000, PCT = 100, KB_PER_MB = 1000, TARGET_BUSY = 0.7;
    const N_ROWS = 10;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const one = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const r = val('[data-r]'), cpu = val('[data-cpu]'), io = val('[data-io]'), cores = val('[data-cores]'), w = val('[data-w]');
      const kb = val('[data-kb]'), big = val('[data-big]') / PCT, boot = val('[data-boot]');
      ['r', 'cpu', 'io', 'cores', 'w', 'kb', 'big', 'boot'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const coreSeconds = (r * cpu) / MS_PER_S; // cores kept busy at the peak
      const machines = Math.ceil(coreSeconds / (cores * TARGET_BUSY));
      const perCore = (cpu + io) / cpu; // workers one core can keep busy when jobs wait on I/O
      const workersPerMachine = Math.ceil(cores * TARGET_BUSY * perCore);
      const jobSeconds = (cpu + io) / MS_PER_S; // how long a job holds a worker
      const inFlight = r * jobSeconds; // Little's law: jobs running at once
      const capacity = (machines * workersPerMachine) / jobSeconds; // jobs per second the fleet can finish
      const queueBound = Math.ceil(capacity * w);
      const noisyRate = r * big;
      const overflow = Math.max(0, r - capacity) * boot; // jobs that arrive above capacity while a new machine starts
      const data: [string, string][] = [
        ['Cores kept busy at the peak', one(coreSeconds)],
        ['Machines of that size, with headroom', formatWholeNumber(machines)],
        ['Workers per machine when jobs wait on I/O', formatWholeNumber(workersPerMachine)],
        ['Jobs running at once at the peak', formatWholeNumber(inFlight)],
        ['Jobs per second the fleet can finish', formatWholeNumber(capacity)],
        ['Queue bound for the wait limit', `${formatWholeNumber(queueBound)} jobs`],
        ['Memory of a full queue', `${one((queueBound * kb) / KB_PER_MB)} MB`],
        ['Jobs per second from the busiest tenant', formatWholeNumber(noisyRate)],
        ['Share of the fleet that tenant takes without fairness', `${formatWholeNumber(Math.min(PCT, (noisyRate * PCT) / capacity))}%`],
        ['Jobs the queue must absorb while a new machine starts', formatWholeNumber(overflow)],
      ];
      rows.forEach((r2, i) => { r2.dt.textContent = data[i][0]; r2.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
