---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Every zoom level has four times as many tiles as the one above, so the pre-generated depth decides storage. For routing, the number of nodes a query settles decides the CPU bill.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Deepest zoom level pre-generated <input type="range" min="10" max="18" value="14" data-z /> <b data-zval></b></label>
      <label>Tiles that hold any content (%) <input type="range" min="5" max="60" step="5" value="25" data-share /> <b data-shareval></b></label>
      <label>Average tile size (KB) <input type="range" min="2" max="40" value="8" data-kb /> <b data-kbval></b></label>
      <label>Road graph size (million intersections) <input type="range" min="5" max="100" step="5" value="25" data-nodes /> <b data-nodesval></b></label>
      <label>Daily active users (millions) <input type="range" min="1" max="200" value="50" data-dau /> <b data-dauval></b></label>
      <label>Route requests per user per day <input type="range" min="1" max="10" value="2" data-rpd /> <b data-rpdval></b></label>
      <label>Drivers navigating at the peak (thousands) <input type="range" min="50" max="2000" step="50" value="500" data-nav /> <b data-navval></b></label>
      <label>Typical trip length (km) <input type="range" min="10" max="300" step="10" value="60" data-trip /> <b data-tripval></b></label>
      <label>Traffic refresh (seconds) <input type="range" min="10" max="300" step="10" value="60" data-ref /> <b data-refval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: tiles use the usual 256 by 256 pixel grid where level z has 4^z tiles; the road graph has 2.6 directed edges per intersection at 20 bytes each, and a contraction hierarchy adds about 1.5 shortcuts per edge; roads are about 40 intersections per square kilometre around the trip; Dijkstra settles every intersection within the trip distance (a disc), A* about 30% of that, and a contraction hierarchy about 1,000; one settled intersection costs 250 ns; a full rebuild of the hierarchy costs 8 core-seconds per million intersections and runs on 16 cores. Each map view loads 20 tiles, each user opens 10 map views a day, the peak is 4 times the average, the CDN hits 95% of requests, every navigating driver reports a position every 5 seconds, and navigating drivers have their route checked at every traffic refresh.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const OUT_ROWS = 18; // lines in the result list
    const MILLION = 1e6, THOUSAND = 1e3, BYTES_PER_KB = 1000, DAY_S = 86400;
    const CHILDREN = 4; // each tile splits into four at the next zoom level
    const VIEWS = { perUser: 10, tilesPerView: 20 }; // map views per user a day, tiles per view
    const PEAK = 4; // peak traffic over the daily average
    const CDN_MISS = 0.05;
    const ROAD = { edgesPerNode: 2.6, bytesPerEdge: 20, chFactor: 2.5 }; // graph size; a contraction hierarchy adds 2.5x
    const SETTLE = { perKm2: 40, aStarShare: 0.3, hierarchy: 1000 }; // intersections a query settles: Dijkstra covers the trip-radius disc, A* 30% of it, the hierarchy about 1000
    const S_PER_NODE = 250e-9, CH_OVERHEAD_S = 0.0005; // CPU per settled node; fixed cost of a hierarchy query
    const REBUILD = { sPerMillion: 8, cores: 16 }; // hierarchy rebuild: 8 core-seconds per million intersections, on 16 cores
    const REPORT_EVERY_S = 5; // a navigating driver reports its position every 5 s
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const bytes = (n: number) => { const u = ['B', 'KB', 'MB', 'GB', 'TB', 'PB']; let i = 0; while (n >= 1000 && i < u.length - 1) { n /= 1000; i++; } return `${n >= 100 ? Math.round(n) : n.toFixed(1)} ${u[i]}`; };
    const time = (s: number) => (s >= 1 ? `${s.toFixed(1)} s` : s >= 0.001 ? `${(s * 1000).toFixed(1)} ms` : `${(s * 1e6).toFixed(0)} µs`);
    function draw() {
      const keys = ['z', 'share', 'kb', 'nodes', 'dau', 'rpd', 'nav', 'trip', 'ref'];
      keys.forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const z = val('[data-z]'); const share = val('[data-share]') / 100; const kb = val('[data-kb]');
      const nodes = val('[data-nodes]') * MILLION; const dau = val('[data-dau]') * MILLION; const rpd = val('[data-rpd]'); const nav = val('[data-nav]') * THOUSAND; const trip = val('[data-trip]'); const ref = val('[data-ref]');
      const topTiles = Math.pow(CHILDREN, z); const allTiles = (Math.pow(CHILDREN, z + 1) - 1) / (CHILDREN - 1); // geometric series 1 + 4 + ... + 4^z
      const stored = allTiles * share; const storage = stored * kb * BYTES_PER_KB;
      const nextStorage = storage * CHILDREN; // one more level adds four times the top level
      const viewTiles = (dau * VIEWS.perUser * VIEWS.tilesPerView * PEAK) / DAY_S; const origin = viewTiles * CDN_MISS;
      const edges = nodes * ROAD.edgesPerNode; const graph = edges * ROAD.bytesPerEdge; const withCh = graph * ROAD.chFactor;
      const routeQps = (dau * rpd * PEAK) / DAY_S; const navQps = nav / ref; const qps = routeQps + navQps;
      const settledD = Math.min(nodes, Math.PI * trip * trip * SETTLE.perKm2); const settledA = settledD * SETTLE.aStarShare; const settledC = SETTLE.hierarchy;
      const tD = settledD * S_PER_NODE; const tA = settledA * S_PER_NODE; const tC = settledC * S_PER_NODE + CH_OVERHEAD_S;
      const rebuild = (nodes / MILLION) * REBUILD.sPerMillion / REBUILD.cores;
      const probes = nav / REPORT_EVERY_S;
      const data: [string, string][] = [
        [`Tiles at level ${z} alone`, fmt(topTiles)],
        [`Tiles in levels 0 to ${z}`, fmt(allTiles)],
        ['Stored tiles (only those with content)', fmt(stored)],
        ['Storage for the pre-generated pyramid', bytes(storage)],
        [`Storage if one more level (${z + 1}) were pre-generated`, bytes(storage + nextStorage)],
        ['Tile requests per second at the peak (all at the CDN edge)', fmt(viewTiles)],
        [`Tile requests per second that reach the origin (${CDN_MISS * 100}% miss)`, fmt(origin)],
        ['Edges in the road graph', fmt(edges)],
        ['Graph in memory, plain / with a contraction hierarchy', `${bytes(graph)} / ${bytes(withCh)}`],
        ['Route queries per second at the peak (new trips + reroute checks)', fmt(qps)],
        ['Intersections settled per query: Dijkstra / A* / hierarchy', `${fmt(settledD)} / ${fmt(settledA)} / ${fmt(settledC)}`],
        ['CPU time per query: Dijkstra / A* / hierarchy', `${time(tD)} / ${time(tA)} / ${time(tC)}`],
        ['Cores needed at the peak with Dijkstra', fmt(Math.ceil(qps * tD))],
        ['Cores needed at the peak with A*', fmt(Math.ceil(qps * tA))],
        ['Cores needed at the peak with the hierarchy', fmt(Math.ceil(qps * tC))],
        ['Position reports per second from the drivers navigating', fmt(probes)],
        [`Full hierarchy rebuild after a traffic refresh (${REBUILD.cores} cores)`, time(rebuild)],
        ['Can a full rebuild keep up with the refresh interval?', rebuild <= ref ? `yes, using ${Math.round((rebuild / ref) * 100)}% of the interval` : `no, it takes ${(rebuild / ref).toFixed(1)} times the interval`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
