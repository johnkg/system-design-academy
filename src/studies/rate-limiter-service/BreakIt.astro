---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Try the algorithms" hint="The limit is 10 requests per second. Pick how the limiter counts and what the client does, and see how many requests really get through.">
  <ol class="how">
    <li>Start with <b>Each gateway counts alone</b> and a <b>steady 15 per second</b>: three gateways each see only 5 per second, so everything passes. The limit is not enforced at all.</li>
    <li>Switch to <b>Shared fixed window</b> and pick <b>Burst across a window boundary</b>: 20 requests get through in a fifth of a second, double the limit, because the count resets at the boundary.</li>
    <li>Try <b>Shared sliding window</b> and <b>Shared token bucket</b> on the same burst. Both hold the line (the bucket lets one extra through as it refills).</li>
  </ol>
  <div class="pg rl2" data-rl2>
    <div class="pg-row">
      <label>Limiter <select class="pg-in" data-mode>
        <option value="local" selected>Each gateway counts alone (3 gateways)</option>
        <option value="fixed">Shared fixed window</option>
        <option value="sliding">Shared sliding window</option>
        <option value="bucket">Shared token bucket</option>
      </select></label>
      <label>Client <select class="pg-in" data-scenario>
        <option value="steady" selected>Steady 15 per second for 6 seconds</option>
        <option value="burst">Burst across a window boundary</option>
      </select></label>
    </div>
    <div class="rl2-chart" role="img" aria-label="Requests over time" data-chart>
      <div class="rl2-row" data-rowa></div>
      <div class="rl2-row rej" data-rowr></div>
    </div>
    <p class="pg-note"><span class="rl2-key a"></span> allowed &nbsp; <span class="rl2-key r"></span> rejected &nbsp; Each bar is 100 ms.</p>
    <p class="pg-out" data-verdict aria-live="polite"></p>
  </div>
</PlaygroundShell>
<script>
  const LIMIT = 10; const WINDOW = 1000; const BUCKETS = 60;
  type Allow = (t: number) => boolean;
  function fixedWindow(): Allow { let w = -1; let c = 0; return (t) => { const n = Math.floor(t / WINDOW); if (n !== w) { w = n; c = 0; } if (c >= LIMIT) return false; c++; return true; }; }
  function slidingLog(): Allow { const times: number[] = []; return (t) => { while (times.length && times[0] <= t - WINDOW) times.shift(); if (times.length >= LIMIT) return false; times.push(t); return true; }; }
  function tokenBucket(): Allow { let tokens = LIMIT; let last = 0; return (t) => { tokens = Math.min(LIMIT, tokens + ((t - last) / 1000) * LIMIT); last = t; if (tokens < 1) return false; tokens -= 1; return true; }; }
  function build(mode: string): Allow {
    if (mode === 'fixed') return fixedWindow();
    if (mode === 'sliding') return slidingLog();
    if (mode === 'bucket') return tokenBucket();
    const gates = [fixedWindow(), fixedWindow(), fixedWindow()]; let turn = 0;
    return (t) => gates[turn++ % 3](t);
  }
  function requests(scenario: string): number[] {
    const times: number[] = [];
    if (scenario === 'steady') for (let i = 0; i * (1000 / 15) < 6000; i++) times.push(Math.round(i * (1000 / 15)));
    else { for (let k = 0; k < 10; k++) times.push(2900 + k * 10); for (let k = 0; k < 10; k++) times.push(3000 + k * 10); }
    return times;
  }
  document.querySelectorAll<HTMLElement>('[data-rl2]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const mk = (parent: HTMLElement) => Array.from({ length: BUCKETS }, () => { const b = document.createElement('i'); parent.appendChild(b); return b; });
    const allowedBars = mk(q('[data-rowa]')); const rejectedBars = mk(q('[data-rowr]'));
    function draw() {
      const times = requests(q<HTMLSelectElement>('[data-scenario]').value); const allow = build(q<HTMLSelectElement>('[data-mode]').value);
      const ok: number[] = []; const no: number[] = []; times.forEach((t) => (allow(t) ? ok : no).push(t));
      const a = new Array(BUCKETS).fill(0); const r = new Array(BUCKETS).fill(0);
      ok.forEach((t) => a[Math.min(BUCKETS - 1, Math.floor(t / 100))]++); no.forEach((t) => r[Math.min(BUCKETS - 1, Math.floor(t / 100))]++);
      const max = Math.max(5, ...a, ...r);
      allowedBars.forEach((b, i) => (b.style.height = `${(a[i] / max) * 100}%`)); rejectedBars.forEach((b, i) => (b.style.height = `${(r[i] / max) * 100}%`));
      const worst = ok.length ? Math.max(...ok.map((t) => ok.filter((u) => u >= t && u < t + 1000).length)) : 0;
      const out = q('[data-verdict]'); out.classList.toggle('bad', worst > LIMIT);
      out.textContent = `Allowed ${ok.length} of ${times.length}. Most allowed in any 1 second: ${worst} (limit ${LIMIT}). ${worst > LIMIT ? `Over the limit by ${worst - LIMIT}.` : 'Within the limit.'}${worst > LIMIT && q<HTMLSelectElement>('[data-mode]').value === 'bucket' ? ' A token bucket is built to allow a burst up to its capacity on top of the refill rate.' : ''}`;
      q('[data-chart]').setAttribute('aria-label', `Requests over ${BUCKETS / 10} seconds: ${ok.length} allowed, ${no.length} rejected`);
    }
    root.addEventListener('change', draw);
    draw();
  });
</script>
<style is:global>
  .playground .rl2-chart { display: grid; gap: 4px; }
  .playground .rl2-row { height: 56px; display: flex; align-items: flex-end; gap: 1px; background: var(--surface-2); border-radius: 6px; padding: 2px; }
  .playground .rl2-row i { flex: 1 1 0; min-width: 0; background: var(--accent); }
  .playground .rl2-row.rej { height: 40px; }
  .playground .rl2-row.rej i { background: var(--bad); }
  .playground .rl2-key { display: inline-block; width: 12px; height: 12px; border-radius: 3px; vertical-align: -1px; }
  .playground .rl2-key.a { background: var(--accent); } .playground .rl2-key.r { background: var(--bad); }
</style>
