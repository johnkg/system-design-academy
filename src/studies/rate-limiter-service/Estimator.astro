---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Change the traffic and see what the limiter has to handle.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Peak checks per second <input type="range" min="1000" max="1000000" step="1000" value="100000" data-rps /> <b data-rpsval></b></label>
      <label>Active API keys (millions) <input type="range" min="0.1" max="100" step="0.1" value="5" data-keys /> <b data-keysval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: every request makes one store call, one store node handles about 100,000 operations per second and is kept under 70% busy, each key needs about 100 bytes of state, one gateway handles about 20,000 requests per second, and every shard has one replica.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const N_ROWS = 6; // output lines below
    const MILLION = 1e6; const GB = 1e9; const MB_PER_GB = 1000;
    const SHARD_OPS = 70000; const GATEWAY_RPS = 20000; // operations one counter shard, requests one gateway handles per second
    const COUNTER_BYTES = 100; const COPIES = 2; // memory per key counter; primary and replica
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const rps = val('[data-rps]'); const keys = val('[data-keys]');
      q('[data-rpsval]').textContent = fmt(rps); q('[data-keysval]').textContent = String(keys);
      const shards = Math.max(1, Math.ceil(rps / SHARD_OPS)); const gateways = Math.max(1, Math.ceil(rps / GATEWAY_RPS));
      const gb = (keys * MILLION * COUNTER_BYTES) / GB;
      const data: [string, string][] = [
        ['Store operations per second', fmt(rps)],
        ['Counter shards needed', `${shards}`],
        ['Store nodes including replicas', `${shards * COPIES}`],
        ['Memory for all counters', gb >= 1 ? `${gb.toFixed(1)} GB` : `${(gb * MB_PER_GB).toFixed(0)} MB`],
        ['Gateways needed', `${gateways}`],
        ['Real limit if each gateway counted alone', `${gateways} times the intended limit`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
