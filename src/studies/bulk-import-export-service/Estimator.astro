---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Rows per second set the workers you need, and the number of busy tenants shows why work must be split into chunks that share workers.">
  <div class="pg est" data-bie>
    <div class="pg-row">
      <label>Imports per day (thousands) <input type="range" min="1" max="500" value="50" data-i /> <b data-ival></b></label>
      <label>Rows per import (thousands) <input type="range" min="1" max="2000" value="200" data-r /> <b data-rval></b></label>
      <label>Bytes per row <input type="range" min="50" max="2000" step="50" value="300" data-by /> <b data-byval></b></label>
      <label>Peak hour compared with the average <input type="range" min="1" max="20" value="5" data-pk /> <b data-pkval></b></label>
      <label>Rows per second per worker <input type="range" min="1000" max="20000" step="1000" value="5000" data-w /> <b data-wval></b></label>
      <label>Chunk size (MB) <input type="range" min="4" max="64" step="4" value="8" data-c /> <b data-cval></b></label>
      <label>Tenants importing at the same time <input type="range" min="1" max="2000" value="200" data-t /> <b data-tval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: imports arrive evenly over 24 hours except for the peak factor, uploads are kept for 7 days, one worker validates and writes about the number of rows per second you set (a database write dominates), and the time for one import is rows divided by the worker's speed, with no queueing.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-bie]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 10; // one per output line
    const THOUSAND = 1000; const BYTES_PER_MB = 1e6; const BYTES_PER_GB = 1e9; const GB_PER_TB = 1000; const DAY_S = 86400;
    const KEEP_DAYS = 7; // uploads are kept for a week
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const imports = val('[data-i]') * THOUSAND; const perImport = val('[data-r]') * THOUSAND; const bytes = val('[data-by]'); const peak = val('[data-pk]');
      const speed = val('[data-w]'); const chunkMb = val('[data-c]'); const tenants = val('[data-t]');
      ['i', 'r', 'by', 'pk', 'w', 'c', 't'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const rowsDay = imports * perImport; const gbDay = (rowsDay * bytes) / BYTES_PER_GB; const avg = rowsDay / DAY_S; const peakRate = avg * peak;
      const workers = Math.ceil(peakRate / speed); const chunks = Math.ceil((perImport * bytes) / (chunkMb * BYTES_PER_MB));
      const data: [string, string][] = [
        ['Rows imported per day', fmt(rowsDay)],
        ['Data uploaded per day', `${fmt(gbDay)} GB`],
        ['Average rows per second', fmt(avg)],
        ['Rows per second at the peak', fmt(peakRate)],
        ['Workers needed at the peak', fmt(workers)],
        ['Chunks in one import', fmt(chunks)],
        ['Chunk uploads per second (average)', (imports * chunks / DAY_S).toFixed(1)],
        ['Time for one import on one worker', `${fmt(perImport / speed)} s`],
        [`Storage for uploads kept ${KEEP_DAYS} days`, `${(gbDay * KEEP_DAYS / GB_PER_TB).toFixed(1)} TB`],
        ['Workers per busy tenant, if all are busy', (workers / tenants).toFixed(1)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
