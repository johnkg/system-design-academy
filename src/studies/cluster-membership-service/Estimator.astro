---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Compare the cost of heartbeating everyone with the cost of SWIM probes, and see how long a failure takes to reach every node.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Nodes in the cluster <input type="range" min="10" max="5000" step="10" value="1000" data-n /> <b data-nval></b></label>
      <label>Protocol period or heartbeat interval (seconds) <input type="range" min="0.2" max="5" step="0.1" value="1" data-per /> <b data-perval></b></label>
      <label>Indirect probes per failed ping <input type="range" min="0" max="6" value="3" data-k /> <b data-kval></b></label>
      <label>Suspicion multiplier <input type="range" min="1" max="8" value="4" data-mult /> <b data-multval></b></label>
      <label>Data per node (GB) <input type="range" min="10" max="2000" step="10" value="500" data-gb /> <b data-gbval></b></label>
      <label>Re-replication speed for the cluster (MB/s) <input type="range" min="10" max="2000" step="10" value="200" data-mbs /> <b data-mbsval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a heartbeat or ack is a 100-byte UDP packet, a SWIM message also carries up to 6 updates of about 30 bytes, each node is probed by one other node per period on average, the suspicion timeout is the multiplier times max(1, log10 N) periods (as in Consul's memberlist), and an update needs about log2 N + ln N rounds to reach every node (the known result for push gossip with one contact per round, which is pessimistic when each node also answers pings). The first node to probe a crashed node does so after about 1.6 periods on average, because the chance that nobody picks it in a round is about 1/e.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 12 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const one = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    function draw() {
      const n = val('[data-n]'); const per = val('[data-per]'); const k = val('[data-k]'); const mult = val('[data-mult]'); const gb = val('[data-gb]'); const mbs = val('[data-mbs]');
      ['n', 'per', 'k', 'mult', 'gb', 'mbs'].forEach((id) => (q(`[data-${id}val]`).textContent = String(val(`[data-${id}]`))));
      const a2aNode = (n - 1) / per; const a2aCluster = (n * (n - 1)) / per;
      const swimNode = 2 / per; const swimCluster = (n * 2) / per;
      const a2aKB = (a2aNode * 100) / 1000; const swimKB = (swimNode * (100 + 6 * 30)) / 1000;
      const detect = 1.6 * per;
      const suspicion = mult * Math.max(1, Math.log10(n)) * per;
      const spread = (Math.log2(n) + Math.log(n)) * per;
      const total = detect + suspicion + spread;
      const moveGB = gb; const moveMin = (moveGB * 1024) / mbs / 60;
      const data: [string, string][] = [
        ['All-to-all heartbeats, messages per node per second', fmt(a2aNode)],
        ['All-to-all heartbeats, messages per second in the whole cluster', fmt(a2aCluster)],
        ['All-to-all heartbeats, traffic out of one node', `${one(a2aKB)} KB/s`],
        ['SWIM, messages per node per second (ping and ack)', one(swimNode)],
        ['SWIM, messages per second in the whole cluster', fmt(swimCluster)],
        ['SWIM, traffic out of one node', `${one(swimKB)} KB/s`],
        ['Time until some node notices a crash', `${one(detect)} s`],
        [`Suspicion timeout (${mult} x max(1, log10 N) periods)`, `${one(suspicion)} s`],
        ['Rounds and time to spread the news to every node', `${fmt(Math.log2(n) + Math.log(n))} rounds, ${one(spread)} s`],
        ['Time until every node knows the node is dead', `${one(total)} s`],
        ['Messages for one probe that falls back to indirect probes, at most', fmt(1 + 4 * k)],
        ['A false alarm streams one node\'s data out and back', `${fmt(moveGB * 2)} GB, about ${one((2 * moveMin))} minutes of streaming`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
