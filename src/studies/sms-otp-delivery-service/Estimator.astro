---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Traffic is small next to a chat app, but every message costs real money, so the fraud share and the price move the bill far more than the load.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>One-time codes sent per day (millions) <input type="range" min="1" max="50" value="5" data-m /> <b data-mval></b></label>
      <label>Peak traffic, times the daily average <input type="range" min="2" max="12" value="6" data-pk /> <b data-pkval></b></label>
      <label>Average price per message (cents, tenths) <input type="range" min="2" max="30" value="8" data-pr /> <b data-prval></b></label>
      <label>Share of sends that are pumping fraud (%) <input type="range" min="0" max="20" value="5" data-fr /> <b data-frval></b></label>
      <label>Messages per second one provider account accepts <input type="range" min="50" max="500" step="50" value="150" data-cap /> <b data-capval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the price slider is in tenths of a cent (8 means 0.8 cents per message), fraud messages go to premium ranges that cost 8 times the average, each message produces 2 receipt callbacks, a message record takes 400 bytes and is kept for 90 days, and one extra provider is kept as a spare for failover.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 9; // one per output line
    const MILLION = 1e6; const DAY_S = 86400; const CENTS_PER_USD = 100; const BYTES_PER_TB = 1e12;
    const PRICE_STEPS_PER_CENT = 10; // the price slider is in tenths of a cent
    const SPARE_PROVIDERS = 1; const CALLBACKS_PER_MSG = 2; // delivery receipts per message
    const FRAUD_PRICE_X = 8; // pumped traffic goes to destinations about 8x the price
    const DAYS_PER_MONTH = 30; const RECORD_BYTES = 400; const KEEP_DAYS = 90;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    function draw() {
      const sends = val('[data-m]') * MILLION; const peakX = val('[data-pk]'); const cents = val('[data-pr]') / PRICE_STEPS_PER_CENT; const fraud = val('[data-fr]') / 100; const cap = val('[data-cap]');
      ['m', 'pk', 'pr', 'fr', 'cap'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const avg = sends / DAY_S; const peak = avg * peakX; const providers = Math.ceil(peak / cap) + SPARE_PROVIDERS;
      const goodCost = (sends * (1 - fraud) * cents) / CENTS_PER_USD; const fraudCost = (sends * fraud * cents * FRAUD_PRICE_X) / CENTS_PER_USD;
      const data: [string, string][] = [
        ['Messages per second, daily average', fmt(avg)],
        ['Messages per second at the peak', fmt(peak)],
        ['Provider accounts to run (peak load plus one spare)', fmt(providers)],
        ['Receipt callbacks per second at the peak', fmt(peak * CALLBACKS_PER_MSG)],
        ['Cost of real messages per day', usd(goodCost)],
        ['Cost of fraud messages per day if nothing stops them', usd(fraudCost)],
        ['Fraud as a share of the whole bill', `${fmt((fraudCost / Math.max(1, goodCost + fraudCost)) * 100)}%`],
        ['Cost of one percent of price per month', usd(((goodCost + fraudCost) * DAYS_PER_MONTH) / 100)],
        [`Message records kept for ${KEEP_DAYS} days`, `${(sends * RECORD_BYTES * KEEP_DAYS / BYTES_PER_TB).toFixed(2)} TB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
