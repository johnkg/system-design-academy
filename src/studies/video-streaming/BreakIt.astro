---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Fixed quality or adaptive" hint="Play a one-minute video over different connections. A fixed-quality file is compared with a player that picks each four-second segment's quality. Figures are modelled.">
  <ol class="how">
    <li>Choose <b>steady fast</b>: both play smoothly, and the fixed file looks as good as the best quality.</li>
    <li>Choose <b>drops in the middle</b> with fixed quality <b>1080p</b>: the fixed file <b>stalls</b> while the connection is weak, and the adaptive player drops to a lower quality instead.</li>
    <li>Lower the fixed quality to <b>240p</b>: it no longer stalls, but the picture is poor even when the connection is excellent.</li>
  </ol>
  <div class="pg vsb" data-vsb>
    <div class="pg-row">
      <label>Connection <select class="pg-in" data-net>
        <option value="steady">Steady fast (8 Mbps)</option>
        <option value="drop" selected>Drops in the middle (8, then 1.5, then 8 Mbps)</option>
        <option value="flaky">Flaky mobile (0.8 to 6 Mbps)</option>
      </select></label>
      <label>Fixed quality <select class="pg-in" data-fixed>
        <option value="0">240p (0.4 Mbps)</option>
        <option value="1">480p (1 Mbps)</option>
        <option value="2">720p (2.5 Mbps)</option>
        <option value="3" selected>1080p (5 Mbps)</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-fbox><h3>One fixed file</h3><span class="pg-mono" data-fout></span><span class="pg-note" data-fnote></span></div>
      <div class="pg-box" data-abox><h3>Adaptive streaming</h3><span class="pg-mono" data-aout></span><span class="pg-note" data-anote></span></div>
    </div>
    <p class="pg-note"><b>Qualities used by the adaptive player, segment by segment:</b> <span class="pg-mono" data-line></span></p>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: a 60-second video in 15 segments of 4 seconds. The adaptive player starts at 480p, picks the highest quality that fits within 80% of the last segment's measured speed, and takes the lowest quality when it has less than 4 seconds buffered. Playback starts once one segment is ready.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-vsb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const LADDER = [{ name: '240p', mbps: 0.4 }, { name: '480p', mbps: 1 }, { name: '720p', mbps: 2.5 }, { name: '1080p', mbps: 5 }];
    const SEG = 4; const SEGMENTS = 15; const DT = 0.05;
    const bandwidth = (net: string, t: number) => {
      if (net === 'steady') return 8;
      if (net === 'drop') return t >= 15 && t < 40 ? 1.5 : 8;
      const k = Math.floor(t / 5); return 0.8 + (((k * 7919 + 13) % 97) / 97) * 5.2;
    };
    function play(net: string, pick: (est: number, buffer: number) => number) {
      let clock = 0; let buffer = 0; let playing = false; let startup = 0; let stalled = 0; let est = 0;
      const chosen: number[] = [];
      for (let i = 0; i < SEGMENTS; i++) {
        const level = pick(est, buffer); chosen.push(level);
        let bits = LADDER[level].mbps * SEG; const began = clock;
        while (bits > 0) {
          bits -= bandwidth(net, clock) * DT; clock += DT;
          if (playing) { if (buffer > 0) buffer = Math.max(0, buffer - DT); else stalled += DT; }
        }
        est = (LADDER[level].mbps * SEG) / Math.max(clock - began, DT);
        buffer += SEG;
        if (!playing) { playing = true; startup = clock; }
        while (buffer > 16) { buffer -= DT; clock += DT; }
      }
      return { startup, stalled, chosen };
    }
    function draw() {
      const net = q<HTMLSelectElement>('[data-net]').value; const fixed = Number(q<HTMLSelectElement>('[data-fixed]').value);
      const f = play(net, () => fixed);
      const a = play(net, (est, buffer) => {
        if (est === 0) return 1;
        if (buffer < SEG) return 0;
        let best = 0; LADDER.forEach((l, i) => { if (l.mbps <= 0.8 * est) best = i; }); return best;
      });
      const avg = (c: number[]) => c.reduce((s, v) => s + LADDER[v].mbps, 0) / c.length;
      const fmtTime = (s: number) => (s < 0.5 ? 'none' : `${s.toFixed(1)} s`);
      q('[data-fout]').textContent = `${LADDER[fixed].name} throughout`;
      q('[data-fnote]').textContent = `starts after ${f.startup.toFixed(1)} s · stalled ${fmtTime(f.stalled)}`;
      q('[data-aout]').textContent = `${avg(a.chosen).toFixed(1)} Mbps on average`;
      q('[data-anote]').textContent = `starts after ${a.startup.toFixed(1)} s · stalled ${fmtTime(a.stalled)}`;
      q('[data-line]').textContent = a.chosen.map((l) => LADDER[l].name).join(' ');
      q<HTMLElement>('[data-fbox]').style.setProperty('--c', f.stalled > 3 ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-abox]').style.setProperty('--c', a.stalled > 3 ? 'var(--bad)' : 'var(--good)');
      const out = q('[data-verdict]'); const bad = f.stalled > 3;
      out.classList.toggle('bad', bad);
      out.textContent = bad ? `The fixed file froze for ${f.stalled.toFixed(1)} s. The adaptive player ${a.stalled < 0.5 ? 'did not stall' : `stalled for ${fmtTime(a.stalled)}`}, because it lowered the quality when the connection weakened.`
        : fixed < 3 && avg(a.chosen) > LADDER[fixed].mbps + 0.5 ? `No stalls, but the fixed file stays at ${LADDER[fixed].name} while the adaptive player averages ${avg(a.chosen).toFixed(1)} Mbps.`
        : 'Both play without freezing.';
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
