---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Change the audience and see why delivery, not storage, is the hard part.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Daily active viewers (millions) <input type="range" min="1" max="500" value="50" data-dau /> <b data-dauval></b></label>
      <label>Minutes watched per viewer per day <input type="range" min="10" max="180" step="5" value="60" data-min /> <b data-minval></b></label>
      <label>Average stream bitrate (Mbps) <input type="range" min="1" max="8" step="0.5" value="3" data-rate /> <b data-rateval></b></label>
      <label>Hours of video uploaded per minute <input type="range" min="10" max="1000" step="10" value="500" data-up /> <b data-upval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: peak traffic is 3 times the average, one server can send 10 Gbps, all qualities of one hour of video take about 3 GB, and encoding all qualities takes about 10 CPU seconds per second of video.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 8; // lines in the result list
    const MILLION = 1e6, MIN_PER_H = 60, MIN_PER_DAY = 1440, H_PER_DAY = 24, S_PER_H = 3600;
    const PEAK = 3; // peak concurrency over the daily average
    const MBIT_PER_TBIT = 1e6, BITS_PER_BYTE = 8, MB_PER_PB = 1e9, GB_PER_TB = 1000, GBIT_PER_TBIT = 1000;
    const GB_PER_HOUR_STORED = 3; // one hour of video in all qualities
    const CORES_PER_UPLOAD = 600; // transcoding cores per hour of video uploaded each minute
    const SERVER_GBPS = 10;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const dau = val('[data-dau]'); const min = val('[data-min]'); const rate = val('[data-rate]'); const up = val('[data-up]');
      q('[data-dauval]').textContent = String(dau); q('[data-minval]').textContent = String(min); q('[data-rateval]').textContent = rate.toFixed(1); q('[data-upval]').textContent = String(up);
      const hours = (dau * MILLION * min) / MIN_PER_H; const concurrent = ((dau * MILLION * min) / MIN_PER_DAY) * PEAK;
      const tbps = (concurrent * rate) / MBIT_PER_TBIT; const pb = (hours * S_PER_H * rate) / BITS_PER_BYTE / MB_PER_PB;
      const upDay = up * MIN_PER_H * H_PER_DAY; const tbDay = (upDay * GB_PER_HOUR_STORED) / GB_PER_TB; const cores = up * CORES_PER_UPLOAD;
      const data: [string, string][] = [
        ['Watch time per day', `${(hours / MILLION).toFixed(0)} million hours`],
        ['Viewers watching at the peak', `${(concurrent / MILLION).toFixed(1)} million`],
        ['Bandwidth at the peak', `${tbps.toFixed(1)} Tbps`],
        ['Data delivered per day', `${pb.toFixed(1)} PB`],
        ['Video uploaded per day', `${fmt(upDay)} hours`],
        ['New storage per day (all qualities)', `${fmt(tbDay)} TB`],
        ['Transcoding CPU cores needed', fmt(cores)],
        ['Servers just to send the bits, without a CDN', fmt((tbps * GBIT_PER_TBIT) / SERVER_GBPS)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
