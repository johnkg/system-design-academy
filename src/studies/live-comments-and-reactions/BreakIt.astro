---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="One gateway with slow viewers" hint="One gateway holds 1,000 viewers: 800 on fast connections (100 comments per second) and 200 on poor ones (5 per second). Comments arrive for 60 seconds, with a burst of three times the rate from second 20 to 30. What happens to the slow viewers' queues?">
  <ol class="how">
    <li>The <b>default</b> sends <b>every comment</b> to everyone at <b>200 per second</b> and <b>buffers without limit</b>: the queues of the slow viewers grow until the gateway needs about <b>2,228 MB</b>, over its 2,048 MB budget, so it <b>runs out of memory</b>.</li>
    <li>Change the slow-viewer policy to <b>drop the oldest</b>: memory falls to about 10 MB and slow viewers are <b>10 seconds</b> behind, but about <b>11.1 million</b> comments are dropped on the way. <b>Disconnect</b> instead cuts all 1,000 viewers, because even the fast ones cannot read 200 a second.</li>
    <li>Sample <b>10 per second for everyone</b> and buffer: memory is only 12 MB, yet slow viewers fall <b>60 seconds</b> behind. With drop oldest the lag is 10 s.</li>
    <li>Sample <b>to each viewer's speed</b> (up to 20 per second): nobody lags, nothing is dropped, and no policy is needed. This is the only setting where all three numbers are zero.</li>
  </ol>
  <div class="pg lcb" data-lcb>
    <div class="pg-row">
      <label>Comments arriving per second <select class="pg-in" data-rate><option value="20">20</option><option value="200" selected>200</option><option value="2000">2,000</option></select></label>
      <label>Sampling <select class="pg-in" data-samp>
        <option value="none" selected>none: send every comment</option>
        <option value="fixed">10 per second for everyone</option>
        <option value="adaptive">to each viewer's speed (up to 20)</option>
      </select></label>
      <label>When a viewer falls behind <select class="pg-in" data-pol>
        <option value="buffer" selected>buffer without limit</option>
        <option value="drop">drop the oldest (keep 50)</option>
        <option value="cut">disconnect past 100 waiting</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Peak gateway buffer</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Slow viewers' lag</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Comments dropped</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Viewers disconnected</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: one tick per second, 200 bytes per queued comment, a 2,048 MB budget for buffers. Each viewer has a queue and reads at its own speed. Lag is the longest queue divided by the reading speed, taken as the worst moment of the minute among viewers still connected. Dropping the oldest keeps at most 50 queued, disconnecting removes a whole group of viewers when a queue passes 100.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-lcb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const FAST = 800, SLOW = 200, FAST_DRAIN = 100, SLOW_DRAIN = 5, BYTES = 200, LIMIT_MB = 2048, SECS = 60;
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function sim(rate: number, sampling: string, policy: string) {
      const groups = [{ n: FAST, d: FAST_DRAIN, q: 0, off: false }, { n: SLOW, d: SLOW_DRAIN, q: 0, off: false }];
      let peak = 0; let dropped = 0; let cut = 0; let lag = 0;
      for (let t = 0; t < SECS; t++) {
        const base = t >= 20 && t < 30 ? rate * 3 : rate;
        let mem = 0;
        for (const g of groups) {
          if (g.off) continue;
          const offered = sampling === 'none' ? base : sampling === 'fixed' ? Math.min(base, 10) : Math.min(base, g.d, 20);
          g.q += offered; g.q -= Math.min(g.q, g.d);
          if (policy === 'drop' && g.q > 50) { dropped += (g.q - 50) * g.n; g.q = 50; }
          if (policy === 'cut' && g.q > 100) { cut += g.n; g.off = true; g.q = 0; }
          mem += g.q * g.n; lag = Math.max(lag, Math.ceil(g.q / g.d));
        }
        peak = Math.max(peak, mem);
      }
      return { mb: Math.round((peak * BYTES) / 1e6), dropped, cut, lag };
    }
    function draw() {
      const rate = Number(q<HTMLSelectElement>('[data-rate]').value); const samp = q<HTMLSelectElement>('[data-samp]').value; const pol = q<HTMLSelectElement>('[data-pol]').value;
      const r = sim(rate, samp, pol); const oom = r.mb > LIMIT_MB;
      q('[data-o1]').textContent = `${fmt(r.mb)} MB`; q('[data-n1]').textContent = oom ? `over the ${fmt(LIMIT_MB)} MB budget` : `within the ${fmt(LIMIT_MB)} MB budget`;
      q('[data-o2]').textContent = `${fmt(r.lag)} s`; q('[data-n2]').textContent = r.lag > 15 ? 'what they read is far out of date' : 'close to live';
      q('[data-o3]').textContent = fmt(r.dropped); q('[data-n3]').textContent = 'summed over all viewers';
      q('[data-o4]').textContent = `${fmt(r.cut)} of 1,000`; q('[data-n4]').textContent = r.cut ? 'they must reconnect and catch up' : 'everyone stays connected';
      const set = (id: string, bad: boolean) => q<HTMLElement>(id).style.setProperty('--c', bad ? 'var(--bad)' : 'var(--good)');
      set('[data-b1]', oom); set('[data-b2]', r.lag > 15); set('[data-b3]', r.dropped > 0); set('[data-b4]', r.cut > 0);
      const out = q('[data-verdict]'); let text = ''; let bad = true;
      if (oom) text = `The gateway runs out of memory: the queues of slow viewers need ${fmt(r.mb)} MB, and the crash takes down all 1,000 connections. Unbounded buffers turn one slow client into an outage.`;
      else if (r.cut) text = `${fmt(r.cut)} of 1,000 viewers are cut off. The gateway is safe, but those viewers must reconnect and fetch what they missed${r.cut === 1000 ? ', and here that includes the fast ones, because the offered rate is beyond what any phone reads' : ''}.`;
      else if (r.lag > 15) text = `Memory is fine, but slow viewers are ${fmt(r.lag)} seconds behind, so their screen shows old comments. Bounding the queue or sampling to their speed fixes that.`;
      else if (r.dropped > 0) text = `Memory is small and the lag at most ${fmt(r.lag)} s, paid for by dropping ${fmt(r.dropped)} comments. Fine for a chat that moves fast, but a lot of work is thrown away after it was sent to the gateway.`;
      else { bad = false; text = 'Everybody stays current: nothing is dropped, nobody is cut off and memory is tiny. The gateway sends each viewer only what that viewer can read.'; }
      out.classList.toggle('bad', bad); out.textContent = text;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
