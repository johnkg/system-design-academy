---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Viewers multiply everything on the way out. The writes are small, but sending each comment to every viewer is what costs.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Concurrent viewers (millions) <input type="range" min="1" max="50" value="5" data-v /> <b data-vval></b></label>
      <label>Viewers who react in a given minute (%) <input type="range" min="1" max="40" value="10" data-sh /> <b data-shval></b></label>
      <label>Reactions per reacting viewer per minute <input type="range" min="1" max="30" value="6" data-r /> <b data-rval></b></label>
      <label>Comments per viewer per hour <input type="range" min="1" max="10" value="2" data-c /> <b data-cval></b></label>
      <label>Connections per gateway (thousands) <input type="range" min="10" max="100" step="10" value="50" data-g /> <b data-gval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a comment message is about 200 bytes, a reaction tally is about 100 bytes, each viewer is sent at most 10 sampled comments and one tally per second, and each relay feeds 10 gateways. Gigabytes are 10<sup>9</sup> bytes.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const v = val('[data-v]') * 1e6; const share = val('[data-sh]') / 100; const perMin = val('[data-r]'); const cph = val('[data-c]'); const conn = val('[data-g]') * 1000;
      ['v', 'sh', 'r', 'c', 'g'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const reactions = (v * share * perMin) / 60; const comments = (v * cph) / 3600;
      const gateways = Math.ceil(v / conn); const relays = Math.ceil(gateways / 10);
      const rawGb = (comments * v * 200) / 1e9; const sampledGb = (v * (Math.min(comments, 10) * 200 + 100)) / 1e9;
      const data: [string, string][] = [
        ['Reactions arriving per second', fmt(reactions)],
        ['Comments arriving per second', fmt(comments)],
        ['Gateways to hold all connections', fmt(gateways)],
        ['Tallies per second into the counters (one per gateway)', fmt(gateways)],
        ['Relays between the root topic and the gateways', fmt(relays)],
        ['Outgoing data if every comment goes to every viewer', `${fmt(rawGb)} GB/s`],
        ['Outgoing data with 10 sampled comments and a tally', `${sampledGb.toFixed(1)} GB/s (${fmt(sampledGb * 8)} Gbit/s)`],
        ['Saving from sampling and aggregating', `${fmt(rawGb / sampledGb)} times less`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
