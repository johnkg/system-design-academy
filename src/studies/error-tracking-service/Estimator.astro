---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Events per second set the ingest and worker fleet, and retention times the stored share sets the storage. Sampling the hot issues is what keeps the bill sensible.">
  <div class="pg est" data-ets>
    <div class="pg-row">
      <label>Daily active users of customer apps (millions) <input type="range" min="10" max="2000" step="10" value="500" data-k="dau" /> <b data-v="dau"></b></label>
      <label>Sessions per user per day <input type="range" min="1" max="10" value="5" data-k="ses" /> <b data-v="ses"></b></label>
      <label>Errors per 100 sessions <input type="range" min="1" max="30" value="8" data-k="err" /> <b data-v="err"></b></label>
      <label>Backend events per day (millions) <input type="range" min="0" max="5000" step="100" value="1000" data-k="srv" /> <b data-v="srv"></b></label>
      <label>Peak to average factor <input type="range" min="1" max="10" value="4" data-k="peak" /> <b data-v="peak"></b></label>
      <label>Events per SDK batch <input type="range" min="1" max="30" value="8" data-k="batch" /> <b data-v="batch"></b></label>
      <label>Share of events stored after sampling (%) <input type="range" min="5" max="100" step="5" value="30" data-k="keep" /> <b data-v="keep"></b></label>
      <label>Retention (days) <input type="range" min="7" max="90" value="30" data-k="days" /> <b data-v="days"></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: an event is about 4 KB compressed on the wire and about 10 KB stored with its indexes, one grouping worker with a warm source-map cache handles about 2,000 events per second, and the queue must be able to hold 10 minutes of peak traffic if the workers stop. Counters for every event are kept in the issues database, which is small next to the event store and is not included.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-ets]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (k: string) => Number(q<HTMLInputElement>(`[data-k="${k}"]`).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      ['dau', 'ses', 'err', 'srv', 'peak', 'batch', 'keep', 'days'].forEach((k) => (q(`[data-v="${k}"]`).textContent = String(val(k))));
      const perDay = val('dau') * 1e6 * val('ses') * (val('err') / 100) + val('srv') * 1e6;
      const avg = perDay / 86400; const peak = avg * val('peak');
      const requests = peak / val('batch'); const mbps = (peak * 4) / 1000;
      const stored = perDay * (val('keep') / 100); const tb = (stored * 10 * val('days')) / 1e9;
      const workers = Math.ceil(peak / 2000); const backlogGb = (peak * 600 * 4) / 1e6;
      const data: [string, string][] = [
        ['Events per day (millions)', fmt(perDay / 1e6)],
        ['Average events per second', fmt(avg)],
        ['Peak events per second', fmt(peak)],
        ['Ingest requests per second at the peak', fmt(requests)],
        ['Peak ingest bandwidth', `${fmt(mbps)} MB/s (${fmt(mbps * 8)} Mbit/s)`],
        ['Events stored per day (millions)', fmt(stored / 1e6)],
        ['Event store for the retention period', `${fmt(tb)} TB`],
        ['Grouping workers at the peak', fmt(workers)],
        ['Queue to hold 10 minutes of peak', `${fmt(backlogGb)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
