---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="One bug, one issue" hint="2,000 events come from 5 real bugs, over 1 to 3 releases. Choose how events are fingerprinted and see how many issues the team gets, compared with the 5 real bugs.">
  <ol class="how">
    <li>Start with <b>in-app stack frames</b> on <b>3 releases</b> with <b>symbolication off</b>: <b>13 issues</b> for 5 bugs. The minified function names change at every release, so each of the 4 bugs that have a stack is split into 3, and the team is told about the same bug three times.</li>
    <li>Switch <b>symbolication on</b>: <b>5 issues</b>, one per bug, at any number of releases, because the fingerprint now uses original names, and the names do not change when the code is rebuilt.</li>
    <li>Choose the <b>exact message</b>: over a thousand issues, since a user id or an order number in the text makes each event look new. Choose the <b>message with numbers replaced</b>: 4 issues, which is too few, because two different bugs (A and B) share one message and are merged.</li>
  </ol>
  <div class="pg etb" data-etb>
    <div class="pg-row">
      <label>Fingerprint rule <select class="pg-in" data-rule>
        <option value="message">The exact message</option>
        <option value="normalized">The message with numbers replaced</option>
        <option value="inapp" selected>Type and in-app stack frames</option>
        <option value="full">Every frame with its line number</option>
      </select></label>
      <label>Releases in the period <select class="pg-in" data-rel>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3" selected>3</option>
      </select></label>
      <label><input type="checkbox" data-sym /> Symbolicate with source maps before grouping</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Issues created</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>One bug in several issues</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Different bugs in one issue</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <ul class="etb-list" data-list aria-label="The largest issues and the bugs in each">
      <li></li><li></li><li></li><li></li><li></li><li></li>
    </ul>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 5 real bugs with these shares of the events: A 30%, B 20%, C 20%, D 15% and E 15%. A and B are different bugs with the same message, C and E have an id in the message, and D has no stack and a host address in its message. Without symbolication the in-app function names are minified and differ for each release. The full-frame rule also counts the library frame, which has 3 variants, and it falls back to the exact message for D. Events are 2,000 and the random numbers are seeded.</p>
  </div>
</PlaygroundShell>
<style>
  .etb-list { list-style: none; margin: 0.6rem 0; padding: 0; display: grid; gap: 0.25rem; }
  .etb-list li { font-family: var(--font-mono, monospace); font-size: 0.85rem; overflow-wrap: anywhere; }
  .etb-list li:empty { display: none; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-etb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const N = 2000;
    const norm = (m: string) => m.replace(/[0-9]+/g, '#');
    type Bug = { id: string; w: number; type: string; msg: (r: () => number) => string; fns: [string, string, number][] };
    const BUGS: Bug[] = [
      { id: 'A', w: 30, type: 'TypeError', msg: () => "Cannot read properties of undefined (reading 'price')", fns: [['cart.js', 'priceOf', 40], ['cart.js', 'total', 12], ['view.js', 'render', 88]] },
      { id: 'B', w: 20, type: 'TypeError', msg: () => "Cannot read properties of undefined (reading 'price')", fns: [['list.js', 'rowPrice', 21], ['list.js', 'draw', 66], ['view.js', 'render', 88]] },
      { id: 'C', w: 20, type: 'NotFoundError', msg: (r) => `User ${1000 + r() % 9000} not found`, fns: [['users.js', 'find', 17], ['api.js', 'handle', 64]] },
      { id: 'D', w: 15, type: 'TimeoutError', msg: (r) => { const a = r() % 200; const b = r() % 250; return `Timeout after 30000 ms calling host 10.2.${a}.${b}`; }, fns: [] },
      { id: 'E', w: 15, type: 'CheckoutError', msg: (r) => `Card declined for order ${10000 + r() % 90000}`, fns: [['pay.js', 'charge', 55], ['checkout.js', 'submit', 19]] },
    ];
    const VENDOR_FNS = 3; const VENDOR_LINE = 300; // library frame varies between three functions
    const LINE_DRIFT = 7; // source lines move by 7 per release
    const MINIFIED = { base: 1000, perLine: 13, perRelease: 400 }; // column positions in the minified bundle
    const IN_APP_FRAMES = 3; // top in-app frames used for the fingerprint
    function simulate(rule: string, symbolicate: boolean, releases: number) {
      // Numerical Recipes LCG
      let seed = 11; const rawRnd = () => { seed = (seed * 1664525 + 1013904223) % 4294967296; return Math.floor(seed / 65536); };
      const groups = new Map<string, { count: number; bugs: Set<string>; title: string }>();
      for (let i = 0; i < N; i++) {
        let r = rawRnd() % 100; let b = 0;
        while (r >= BUGS[b].w) { r -= BUGS[b].w; b++; }
        const bug = BUGS[b]; const rel = Math.floor((i * releases) / N);
        const msg = bug.msg(rawRnd); const vendor = rawRnd() % VENDOR_FNS;
        const app = bug.fns.map(([f, fn, line], k) => (symbolicate ? [f, fn, line + rel * LINE_DRIFT] : [`app.${rel}.js`, `m${rel}${b}${k}`, MINIFIED.base + line * MINIFIED.perLine + rel * MINIFIED.perRelease]));
        const frames = app.length ? [...app, ['vendor.js', `run${vendor}`, VENDOR_LINE + vendor]] : [];
        let key: string;
        if (rule === 'message') key = `${bug.type}|${msg}`;
        else if (rule === 'normalized') key = `${bug.type}|${norm(msg)}`;
        else if (rule === 'inapp') key = `${bug.type}|${app.length ? app.slice(0, IN_APP_FRAMES).map((f) => f[1]).join('>') : norm(msg)}`;
        else key = `${bug.type}|${frames.length ? frames.map((f) => f.join(':')).join('>') : msg}`;
        const g = groups.get(key) ?? { count: 0, bugs: new Set<string>(), title: `${bug.type}: ${norm(msg)}` };
        g.count++; g.bugs.add(bug.id); groups.set(key, g);
      }
      const list = [...groups.values()].sort((a, b) => b.count - a.count);
      const seen = new Map<string, number>();
      list.forEach((g) => g.bugs.forEach((x) => seen.set(x, (seen.get(x) ?? 0) + 1)));
      const splits = [...seen.values()].reduce((s, c) => s + c - 1, 0);
      const merges = list.reduce((s, g) => s + g.bugs.size - 1, 0);
      return { groups: list.length, splits, merges, list };
    }
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-list] li'));
    const fmt = (n: number) => n.toLocaleString('en-US');
    function draw() {
      const rule = q<HTMLSelectElement>('[data-rule]').value; const rel = Number(q<HTMLSelectElement>('[data-rel]').value); const sym = q<HTMLInputElement>('[data-sym]').checked;
      const r = simulate(rule, sym, rel);
      q('[data-o1]').textContent = `${fmt(r.groups)} issues`; q('[data-n1]').textContent = `for ${BUGS.length} real bugs and ${fmt(N)} events`;
      q('[data-o2]').textContent = fmt(r.splits); q('[data-n2]').textContent = 'extra issues beyond one per bug, which means repeated alerts';
      q('[data-o3]').textContent = fmt(r.merges); q('[data-n3]').textContent = 'bugs hidden inside another bug\'s issue';
      q<HTMLElement>('[data-b1]').style.setProperty('--c', r.groups === BUGS.length ? 'var(--good)' : 'var(--accent)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', r.splits === 0 ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', r.merges === 0 ? 'var(--good)' : 'var(--bad)');
      items.forEach((li, i) => { const g = r.list[i]; li.textContent = g ? `${fmt(g.count)} events, bugs ${[...g.bugs].sort().join('+')}: ${g.title}` : ''; });
      const out = q('[data-verdict]'); const ok = r.splits === 0 && r.merges === 0; out.classList.toggle('bad', !ok);
      if (ok) out.textContent = `One issue for each real bug: ${r.groups} issues for ${BUGS.length} bugs. Ids and line numbers no longer matter, and the grouping stays the same when the code is rebuilt.`;
      else if (r.splits > 0 && r.merges > 0) out.textContent = `Both errors: ${r.splits} extra issues from splits and ${r.merges} merged bug. The team gets many alerts for the same bug, and still cannot tell A and B apart.`;
      else if (r.splits > 0) out.textContent = `${r.groups} issues for ${BUGS.length} bugs: ${r.splits} are duplicates. ${rule === 'inapp' && !sym ? 'The minified names change with each release, so the same bug looks new after every deploy. Symbolicate first.' : 'Text, library frames and line numbers that vary between events make the same bug look different each time.'}`;
      else out.textContent = `Only ${r.groups} issues, but ${r.merges} bug is hidden inside another one: A and B throw the same message from different code. Fix A, and the issue stays open because of B.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
