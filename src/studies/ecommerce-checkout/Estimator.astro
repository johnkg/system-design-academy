---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="A normal day is easy. The flash sale is a different problem: millions of requests for a few thousand units, and a single stock row that can take about a thousand updates per second.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Orders per day (millions) <input type="range" min="1" max="100" value="5" data-od /> <b data-odval></b></label>
      <label>Peak rate compared with the average (times) <input type="range" min="2" max="10" value="4" data-pk /> <b data-pkval></b></label>
      <label>Units in the flash sale <input type="range" min="1000" max="100000" step="1000" value="20000" data-u /> <b data-uval></b></label>
      <label>Shoppers in the first minute (thousands) <input type="range" min="100" max="5000" step="100" value="2000" data-sh /> <b data-shval></b></label>
      <label>Requests per shopper in that minute <input type="range" min="1" max="30" value="10" data-rq /> <b data-rqval></b></label>
      <label>Shoppers who take a unit and never pay (%) <input type="range" min="0" max="80" value="40" data-ab /> <b data-abval></b></label>
      <label>Hold on a unit while paying (seconds) <input type="range" min="30" max="900" step="30" value="90" data-hold /> <b data-holdval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each order makes 3 saga calls (stock, payment, shipping) and writes 4 outbox events (placed, paid, shipped, confirmed). One stock row takes about 1,000 conditional updates per second because of its row lock. Each round of unpaid holds expires after the hold time, and the next shoppers in the queue take those units.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 9; // one per output line
    const MILLION = 1e6; const THOUSAND = 1e3; const DAY_S = 86400; const SEC_PER_MIN = 60;
    const SAGA_CALLS = 3; const OUTBOX_EVENTS = 4; // per order
    const MAX_ROUNDS = 100;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const perDay = val('[data-od]') * MILLION; const pk = val('[data-pk]'); const units = val('[data-u]'); const shoppers = val('[data-sh]') * THOUSAND;
      const reqs = val('[data-rq]'); const ab = val('[data-ab]') / 100; const hold = val('[data-hold]');
      ['od', 'pk', 'u', 'sh', 'rq', 'ab', 'hold'].forEach((k) => (q(`[data-${k}val]`).textContent = fmt(val(`[data-${k}]`))));
      const avg = perDay / DAY_S; const peak = avg * pk;
      const rps = (shoppers * reqs) / SEC_PER_MIN;
      const rowRate = 1000;
      // Each round of holds: a share `ab` of the units comes back after the hold time, and the queue takes them again.
      let rounds = 1; let left = units; while (left * ab >= 1 && rounds < MAX_ROUNDS) { left *= ab; rounds++; }
      const data: [string, string][] = [
        ['Orders per second, average', fmt(avg)],
        ['Orders per second at the daily peak', fmt(peak)],
        [`Saga calls per second at the peak (${SAGA_CALLS} per order)`, fmt(peak * SAGA_CALLS)],
        [`Outbox events per second at the peak (${OUTBOX_EVENTS} per order)`, fmt(peak * OUTBOX_EVENTS)],
        ['Flash-sale requests per second in the first minute', fmt(rps)],
        ['Requests for each unit of stock', fmt((shoppers * reqs) / units)],
        ['Share of those requests one stock row could serve', `${Math.min(100, (rowRate / rps) * 100).toFixed(1)}%`],
        [`Seconds for one row to take every unit, at ${rowRate.toLocaleString('en-US')} per second`, fmt(units / rowRate)],
        ['Rounds of holds before the last unit is settled, and the time', `${fmt(rounds)} rounds, about ${fmt((rounds * hold) / SEC_PER_MIN)} min`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
