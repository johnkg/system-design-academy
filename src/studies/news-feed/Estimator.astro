---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Change the audience and see how lopsided reads and writes become.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Daily active users (millions) <input type="range" min="1" max="500" value="100" data-dau /> <b data-dauval></b></label>
      <label>Posts per user per day <input type="range" min="0.1" max="5" step="0.1" value="0.5" data-ppd /> <b data-ppdval></b></label>
      <label>Feed opens per user per day <input type="range" min="1" max="50" value="10" data-opens /> <b data-opensval></b></label>
      <label>Average followers per account <input type="range" min="10" max="1000" step="10" value="200" data-fol /> <b data-folval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: peak traffic is 3 times the average, each user follows as many accounts as an account has followers on average, a feed list keeps the latest 500 post ids at 8 bytes each, and building a feed on read would query every followed account once.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const N_ROWS = 8; // output lines below
    const MILLION = 1e6; const GB = 1e9; const GB_PER_TB = 1000; const DAY_S = 86400;
    const PEAK_FACTOR = 3; // peak rate over the daily average
    const FEED_LEN = 500; const ID_BYTES = 8; // post ids kept in each precomputed feed list
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const dau = val('[data-dau]'); const ppd = val('[data-ppd]'); const opens = val('[data-opens]'); const fol = val('[data-fol]');
      q('[data-dauval]').textContent = String(dau); q('[data-ppdval]').textContent = ppd.toFixed(1); q('[data-opensval]').textContent = String(opens); q('[data-folval]').textContent = String(fol);
      const postsDay = dau * MILLION * ppd; const postsPeak = (postsDay / DAY_S) * PEAK_FACTOR;
      const readsDay = dau * MILLION * opens; const readsPeak = (readsDay / DAY_S) * PEAK_FACTOR;
      const writesPeak = postsPeak * fol;
      const gb = (dau * MILLION * FEED_LEN * ID_BYTES) / GB;
      const data: [string, string][] = [
        ['Posts per day', `${(postsDay / MILLION).toFixed(0)} million`],
        ['Posts per second (peak)', fmt(postsPeak)],
        ['Feed opens per second (peak)', fmt(readsPeak)],
        ['Feed opens for every post written', (readsDay / postsDay).toFixed(0)],
        ['Feed list writes per second with fan-out on write', fmt(writesPeak)],
        ['Account lookups per second if feeds are built on read', fmt(readsPeak * fol)],
        ['Memory for everyone\'s feed list', gb >= GB_PER_TB ? `${(gb / GB_PER_TB).toFixed(1)} TB` : `${gb.toFixed(0)} GB`],
        ['Reads saved per feed open by precomputing', `${fmt(fol)} lookups become 1`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
