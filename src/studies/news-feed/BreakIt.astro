---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Push, pull or both" hint="Pick who posts, how the feed is built, and how many accounts the reader follows. Watch the cost move between posting and reading. Figures are modelled.">
  <ol class="how">
    <li>Choose <b>fan-out on write</b> and a poster with <b>5,000,000 followers</b>: one post means millions of writes and takes minutes to reach everyone.</li>
    <li>Switch to <b>fan-out on read</b>: posting is free, but each feed open now needs a lookup for <b>every account the reader follows</b>.</li>
    <li>Choose <b>hybrid</b>: ordinary accounts are pushed and accounts with <b>100,000</b> followers or more are pulled, so both costs stay small.</li>
  </ol>
  <div class="pg nfb" data-nfb>
    <div class="pg-row">
      <label>Who posts <select class="pg-in" data-poster>
        <option value="200" selected>Ordinary account (200 followers)</option>
        <option value="5000">Local business (5,000 followers)</option>
        <option value="100000">Popular creator (100,000 followers)</option>
        <option value="5000000">Celebrity (5,000,000 followers)</option>
      </select></label>
      <label>How the feed is built <select class="pg-in" data-mode>
        <option value="write" selected>Fan-out on write (push)</option>
        <option value="read">Fan-out on read (pull)</option>
        <option value="hybrid">Hybrid</option>
      </select></label>
      <RangeField label="Accounts the reader follows" name="follows" min="50" max="2000" step="50" value="300" />
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-wbox><h3>When someone posts</h3><span class="pg-mono" data-wout></span><span class="pg-note" data-wnote></span></div>
      <div class="pg-box" data-rbox><h3>When someone opens their feed</h3><span class="pg-mono" data-rout></span><span class="pg-note" data-rnote></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: a fan-out cluster performs 50,000 feed list writes per second, a lookup of one account's recent posts is one query, the hybrid threshold is 100,000 followers, and a typical reader follows 5 accounts above that threshold.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-nfb]').forEach((root) => {
    const q = query(root);
    const THRESHOLD = 100000; const RATE = 50000; const BIG = 5;
    const dur = (s: number) => (s < 1 ? 'under a second' : s < 90 ? `${Math.round(s)} seconds` : `${(s / 60).toFixed(1)} minutes`);
    function draw() {
      const followers = Number(q<HTMLSelectElement>('[data-poster]').value); const mode = q<HTMLSelectElement>('[data-mode]').value;
      const follows = Number(q<HTMLInputElement>('[data-follows]').value);
      q('[data-followsval]').textContent = fmt(follows);
      const pushed = mode === 'write' || (mode === 'hybrid' && followers < THRESHOLD);
      const writes = pushed ? followers : 0; const seconds = writes / RATE;
      const lookups = mode === 'write' ? 1 : mode === 'read' ? follows : 1 + BIG;
      q('[data-wout]').textContent = pushed ? `${fmt(writes)} list writes` : '1 write, no fan-out';
      q('[data-wnote]').textContent = pushed ? `reaches every follower in ${dur(seconds)}` : mode === 'read' ? 'followers find it when they open their feed' : 'followers pick it up when they open their feed';
      q('[data-rout]').textContent = `${fmt(lookups)} ${lookups === 1 ? 'lookup' : 'lookups'}`;
      q('[data-rnote]').textContent = mode === 'write' ? 'one read of a precomputed list' : mode === 'read' ? `one query for each of the ${fmt(follows)} accounts followed` : `the list plus ${BIG} popular accounts, merged`;
      const SLOW_WRITE_S = 60, SLOW_READ_LOOKUPS = 100;
      const slowWrite = seconds > SLOW_WRITE_S; const slowRead = lookups > SLOW_READ_LOOKUPS;
      q<HTMLElement>('[data-wbox]').style.setProperty('--c', slowWrite ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-rbox]').style.setProperty('--c', slowRead ? 'var(--bad)' : 'var(--good)');
      const out = q('[data-verdict]'); out.classList.toggle('bad', slowWrite || slowRead);
      out.textContent = slowWrite ? `Too slow to post: followers wait ${dur(seconds)} for the post, and the workers are busy the whole time.`
        : slowRead ? `Too slow to read: every feed open runs ${fmt(lookups)} queries, and feeds are opened far more often than posts are written.`
        : 'Both sides stay cheap.';
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
