---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Every write is stored RF times, so storage and write load both scale with the replication factor, and compaction needs spare disk.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Writes per second (thousands) <input type="range" min="10" max="2000" step="10" value="200" data-w /> <b data-wval></b></label>
      <label>Row size (bytes) <input type="range" min="50" max="2000" step="50" value="200" data-s /> <b data-sval></b></label>
      <label>Replication factor <input type="range" min="1" max="5" value="3" data-rf /> <b data-rfval></b></label>
      <label>Retention (days) <input type="range" min="1" max="365" value="30" data-d /> <b data-dval></b></label>
      <label>Disk per node (TB) <input type="range" min="1" max="16" value="4" data-tb /> <b data-tbval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: row size includes the key, column names, timestamps and overhead before compression, one node absorbs about 20,000 replica writes per second, only half of each disk is used for data so that compaction has room to rewrite SSTables, and compaction rewrites each byte about 8 times over its life. A QUORUM is a majority of the replicas.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 10; // one per output line
    const THOUSAND = 1000; const BYTES_PER_MB = 1e6; const BYTES_PER_TB = 1e12; const DAY_S = 86400;
    const DISK_USABLE = 0.5; // half of each disk, room for compaction
    const WRITES_PER_NODE = 20000; const WRITE_AMP = 8; // replica writes per node per second; compaction rewrites
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmt1 = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    function draw() {
      const w = val('[data-w]') * THOUSAND; const size = val('[data-s]'); const rf = val('[data-rf]'); const days = val('[data-d]'); const tb = val('[data-tb]');
      ['w', 's', 'rf', 'd', 'tb'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const replicaWrites = w * rf; const ingestMb = (w * size) / BYTES_PER_MB; const perDayTb = (w * size * DAY_S) / BYTES_PER_TB; const totalTb = perDayTb * days * rf;
      const nodesDisk = Math.ceil(totalTb / (tb * DISK_USABLE)); const nodesWrite = Math.ceil(replicaWrites / WRITES_PER_NODE); const nodes = Math.max(nodesDisk, nodesWrite);
      const diskMb = (replicaWrites * size * WRITE_AMP) / nodes / BYTES_PER_MB; const quorum = Math.floor(rf / 2) + 1;
      const data: [string, string][] = [
        ['Replica writes per second (writes times RF)', fmt(replicaWrites)],
        ['Ingest before replication', `${fmt1(ingestMb)} MB/s`],
        ['New data per day, one copy', `${fmt1(perDayTb)} TB`],
        ['Stored for the retention period, all copies', `${fmt(totalTb)} TB`],
        ['Nodes needed for storage (half of each disk usable)', fmt(nodesDisk)],
        ['Nodes needed for write rate', fmt(nodesWrite)],
        ['Nodes to run', fmt(nodes)],
        ['Average disk writes per node, with compaction', `${fmt1(diskMb)} MB/s`],
        ['Copies a QUORUM read or write must reach', `${quorum} of ${rf}`],
        ['Replicas of one partition that can be down while QUORUM still works', fmt(rf - quorum)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
