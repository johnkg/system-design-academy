---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Ordinary traffic is modest. What sizes this system is the hot product, the holds that wait to expire, and the fan-out of every movement to every channel.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Orders per day (thousands) <input type="range" min="100" max="5000" step="100" value="2000" data-o /> <b data-oval></b></label>
      <label>Items per order <input type="range" min="1" max="8" value="3" data-i /> <b data-ival></b></label>
      <label>Peak-hour traffic compared with the average (times) <input type="range" min="2" max="20" value="10" data-pk /> <b data-pkval></b></label>
      <label>Checkouts that never pay (%) <input type="range" min="0" max="60" step="5" value="30" data-ab /> <b data-abval></b></label>
      <label>Hold time (minutes) <input type="range" min="2" max="30" value="10" data-h /> <b data-hval></b></label>
      <label>Sales channels <input type="range" min="1" max="10" value="5" data-ch /> <b data-chval></b></label>
      <label>Warehouses <input type="range" min="1" max="30" value="12" data-w /> <b data-wval></b></label>
      <label>Products (thousands) <input type="range" min="5" max="500" step="5" value="100" data-sk /> <b data-skval></b></label>
      <label>Flash-sale requests per second for one product (thousands) <input type="range" min="1" max="100" value="20" data-fl /> <b data-flval></b></label>
      <label>Units in the flash sale <input type="range" min="500" max="20000" step="500" value="5000" data-fu /> <b data-fuval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: orders are spread over 24 hours, and a checkout that pays holds its units for about 2 minutes while one that does not pay holds them for the whole hold time. Each item sold causes 1.3 movements (the sale, plus returns, receipts, transfers and corrections). A ledger row or a hold takes about 100 bytes. One counter row sustains about 1,000 updates per second. Each product is stocked in 20% of the warehouses and every product and location is counted once every 90 days.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const OUT_ROWS = 12; // lines in the result list
    const THOUSAND = 1000, DAY_S = 86400, MIN_S = 60, DAYS_PER_YEAR = 365, MB = 1e6, GB = 1e9;
    const PAID_HOLD_S = 120; // a reservation that is paid is released after about 2 minutes
    const MOVES_PER_ITEM = 1.3; // ledger movements (and bus events) per ordered item, counting returns and transfers
    const HOLD_BYTES = 100, LEDGER_ROW_BYTES = 100;
    const ROW_UPDATES_S = 1000; // updates per second one counter row takes
    const CYCLE = { share: 0.2, days: 90 }; // 20% of SKU-warehouse slots hold stock and are counted every 90 days
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const keys = ['o', 'i', 'pk', 'ab', 'h', 'ch', 'w', 'sk', 'fl', 'fu'];
    function draw() {
      const orders = val('[data-o]') * THOUSAND; const items = val('[data-i]'); const peak = val('[data-pk]'); const ab = val('[data-ab]') / 100;
      const hold = val('[data-h]'); const channels = val('[data-ch]'); const wh = val('[data-w]'); const skus = val('[data-sk]') * THOUSAND;
      const flash = val('[data-fl]') * THOUSAND; const flashUnits = val('[data-fu]');
      keys.forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const peakOrders = (orders / DAY_S) * peak; const peakItems = peakOrders * items;
      const reserves = peakItems / (1 - ab);
      const holds = reserves * (ab * hold * MIN_S + (1 - ab) * PAID_HOLD_S);
      const moves = orders * items * MOVES_PER_ITEM;
      const slices = Math.ceil(flash / ROW_UPDATES_S);
      const data: [string, string][] = [
        ['Orders per second at the peak', fmt(peakOrders)],
        ['Reservations per second at the peak (paid or not)', fmt(reserves)],
        ['Holds open at the same time at the peak', fmt(holds)],
        ['Memory for those holds', `${(holds * HOLD_BYTES / MB).toFixed(1)} MB`],
        ['Ledger movements per day', fmt(moves)],
        ['Ledger growth per year', `${fmt((moves * DAYS_PER_YEAR * LEDGER_ROW_BYTES) / GB)} GB`],
        ['Events per second on the bus at the peak', fmt(peakItems * MOVES_PER_ITEM)],
        ['Messages per second to channels at the peak', fmt(peakItems * MOVES_PER_ITEM * channels)],
        [`Flash sale: counter rows needed (${fmt(ROW_UPDATES_S)} updates per second each)`, fmt(slices)],
        ['Flash sale: units per counter row', fmt(Math.floor(flashUnits / slices))],
        ['Flash sale: seconds to sell out if every request wins', (flashUnits / flash).toFixed(2)],
        [`Cycle counts per day to cover everything every ${CYCLE.days} days`, fmt((skus * wh * CYCLE.share) / CYCLE.days)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
