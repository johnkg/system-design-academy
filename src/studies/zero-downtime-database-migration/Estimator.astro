---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The bulk copy takes hours, and the writes that arrive during those hours become a backlog the change stream must catch up on. The freeze is only as short as the lag you wait for.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Database size (TB) <input type="range" min="1" max="50" value="5" data-tb /> <b data-tbval></b></label>
      <label>Parallel copy streams <input type="range" min="1" max="32" value="8" data-st /> <b data-stval></b></label>
      <label>MB/s per stream <input type="range" min="10" max="100" step="10" value="40" data-mb /> <b data-mbval></b></label>
      <label>Writes per second at the peak <input type="range" min="100" max="20000" step="100" value="3000" data-w /> <b data-wval></b></label>
      <label>Change-log bytes per write <input type="range" min="200" max="4000" step="100" value="1000" data-by /> <b data-byval></b></label>
      <label>Target apply speed (times the source write rate) <input type="range" min="1.2" max="6" step="0.2" value="3" data-ap /> <b data-apval></b></label>
      <label>Lag allowed at the freeze (seconds) <input type="range" min="1" max="60" value="5" data-lag /> <b data-lagval></b></label>
      <label>Minutes before you could decide to roll back <input type="range" min="5" max="240" step="5" value="30" data-rb /> <b data-rbval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the copy reads from a snapshot or a replica, so its speed is streams times MB/s. The target applies the change log at a steady multiple of the source write rate. A checksum pass runs at a quarter of the copy speed, to leave the source room for production traffic. Flipping connections takes about 2 seconds. Estimates, not measurements.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 10; // lines in the result list
    const MB_PER_TB = 1e6, GB = 1e9;
    const VERIFY_FACTOR = 4; // checksumming both copies takes about four times the copy
    const CUTOVER_S = 2; // switching traffic once the backlog has drained
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const one = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    function draw() {
      const tb = val('[data-tb]'); const st = val('[data-st]'); const mb = val('[data-mb]'); const w = val('[data-w]'); const by = val('[data-by]'); const ap = val('[data-ap]'); const lag = val('[data-lag]'); const rb = val('[data-rb]');
      ['tb', 'st', 'mb', 'w', 'by', 'ap', 'lag', 'rb'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const speed = st * mb; const copyS = (tb * MB_PER_TB) / speed; const backlog = w * copyS; const logGb = (backlog * by) / GB;
      const catchS = backlog / ((ap - 1) * w); const sumS = copyS * VERIFY_FACTOR; const drainS = lag / ap + CUTOVER_S;
      const data: [string, string][] = [
        ['Bulk copy speed', `${fmt(speed)} MB/s`],
        ['Bulk copy time', `${one(copyS / 3600)} hours`],
        ['Writes that pile up during the copy', `${fmt(backlog / 1e6)} million entries`],
        ['Change-log volume to keep and replay', `${one(logGb)} GB`],
        ['Time for the target to catch up afterwards', `${one(catchS / 3600)} hours`],
        ['Total time until the target is in sync', `${one((copyS + catchS) / 3600)} hours`],
        ['One full checksum pass', `${one(sumS / 3600)} hours`],
        ['Write freeze at the cutover', `${one(drainS)} seconds`],
        ['Writes lost on a rollback without reverse replication', `${fmt(w * rb * 60)}`],
        ['Writes lost with reverse replication (if it lags 1 second)', `at most ${fmt(w)}`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
