---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How big the table is, how long a throttled copy takes, and how many writes the primary sees while the migration runs and while it is paused. A teaching model with round numbers, not GitHub's data.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Rows in the table (millions)" name="r" min="10" max="2000" step="10" value="500" />
      <RangeField label="Average row size (bytes)" name="b" min="100" max="2000" step="100" value="500" />
      <RangeField label="Rows copied per second" name="c" min="1000" max="20000" step="1000" value="6000" />
      <RangeField label="Rows copied per chunk" name="k" min="100" max="10000" step="100" value="1000" />
      <RangeField label="Application writes per second" name="w" min="1000" max="20000" step="1000" value="8000" />
      <RangeField label="Share of the time the migration is throttled (%)" name="f" min="0" max="80" step="5" value="30" />
      <RangeField label="Writes per second the primary can do" name="m" min="10000" max="60000" step="5000" value="30000" />
      <RangeField label="Writes per second a replica can apply" name="a" min="10000" max="60000" step="5000" value="20000" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Teaching model, not GitHub's system or data. The post says only that tables range from empty to many hundreds of GB, and its settings of 1500 rows per chunk and a lag of 2000 milliseconds are examples; every other figure here is a guess of mine that you can change. Assumptions: the ghost table ends up as big as the original; the application's writes are spread evenly; every application write is also made once on the ghost table, by a trigger or by gh-ost reading the binary log; and a throttled migration makes no writes at all, except that triggers cannot be throttled. Lag grows at the rate the replica is overloaded, and shrinks at the same rate when it has room.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 12; // lines in the result list
    const MILLION = 1e6, GB = 1e9, SECONDS_PER_HOUR = 3600, PERCENT = 100, MS_PER_SECOND = 1000;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      ['r', 'b', 'c', 'k', 'w', 'f', 'm', 'a'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const tableRows = val('[data-r]') * MILLION, rowBytes = val('[data-b]'), copyRate = val('[data-c]'), chunk = val('[data-k]');
      const appWrites = val('[data-w]'), throttledPct = val('[data-f]'), primaryCapacity = val('[data-m]'), replicaCapacity = val('[data-a]');
      const sizeGb = (tableRows * rowBytes) / GB;
      const copyHours = tableRows / copyRate / SECONDS_PER_HOUR;
      const throttledHours = copyHours / (1 - throttledPct / PERCENT);
      const runningWrites = appWrites + appWrites + copyRate; // the application, the matching write on the ghost table, and the row copy
      const pausedTriggers = appWrites + appWrites; // triggers keep writing to the ghost table
      const pausedGhost = appWrites; // gh-ost stops, so only the application writes
      const share = (n: number) => `${formatOneDecimalBelow100((PERCENT * n) / primaryCapacity)}% of what the primary can do`;
      const data: [string, string][] = [
        ['Size of the table (GB)', formatOneDecimalBelow100(sizeGb)],
        ['Room needed for the ghost table as well (GB)', formatOneDecimalBelow100(sizeGb)],
        ['Chunks to copy', formatOneDecimalBelow100(tableRows / chunk)],
        ['Copy time with no throttling (hours)', formatOneDecimalBelow100(copyHours)],
        ['Copy time with the throttle (hours)', formatOneDecimalBelow100(throttledHours)],
        ['Changes made during the copy that must be replayed (millions)', formatOneDecimalBelow100((appWrites * throttledHours * SECONDS_PER_HOUR) / MILLION)],
        ['Writes the primary sees while the migration runs (per second)', formatOneDecimalBelow100(runningWrites)],
        ['That is', share(runningWrites)],
        ['Writes the primary sees when paused, with triggers (per second)', formatOneDecimalBelow100(pausedTriggers)],
        ['Writes the primary sees when paused, with gh-ost (per second)', formatOneDecimalBelow100(pausedGhost)],
        ['Replica lag grows by this much each second while running (milliseconds)', formatOneDecimalBelow100(Math.max(0, ((runningWrites - replicaCapacity) / replicaCapacity) * MS_PER_SECOND))],
        ['Replica lag grows by this much each second when paused, with triggers (milliseconds)', formatOneDecimalBelow100(Math.max(0, ((pausedTriggers - replicaCapacity) / replicaCapacity) * MS_PER_SECOND))],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
