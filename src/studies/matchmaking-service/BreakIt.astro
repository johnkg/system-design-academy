---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Wait time against match quality" hint="400 players join a 1v1 queue. Two players match when their rating gap fits inside both of their search windows. Change how wide the window starts, how fast it widens and how many players arrive, and watch who gives up and who gets a lopsided game.">
  <ol class="how">
    <li>Start with <b>quiet hours</b> and a <b>fixed window of 25</b>: matches are fair (average gap about 12), but <b>114 of the 400 players give up</b> after 90 seconds, because nobody is close enough.</li>
    <li>Set the window to <b>grow by 10 per second</b>: only <b>6 give up</b> and the average wait is about 12 seconds, at the cost of a wider average gap (about 74) and some <b>lopsided</b> games.</li>
    <li>Instead, still on quiet hours, set <b>Window at the start</b> to 300 and <b>Widening per second waited</b> to 0 (a <b>fixed window of 300</b>): nearly everyone matches in about 5 seconds, but almost half of the games are lopsided. Back at the fixed window of 25, switch to <b>busy hours</b>: only <b>26 give up</b> instead of 114, because a crowd fills a narrow window quickly.</li>
  </ol>
  <div class="pg mmb" data-mmb>
    <div class="pg-row">
      <label>Arrivals <select class="pg-in" data-rate>
        <option value="4" selected>Quiet hours: one player every 4 seconds</option>
        <option value="1">Busy hours: one player every second</option>
      </select></label>
      <label>Window at the start (rating points) <input type="range" min="10" max="300" step="5" value="25" data-start /> <b data-startval></b></label>
      <label>Widening per second waited <input type="range" min="0" max="30" value="0" data-widen /> <b data-widenval></b></label>
      <label>Widest the window may get <input type="range" min="25" max="600" step="25" value="400" data-cap /> <b data-capval></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Players who found a game</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Players who gave up</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Average wait</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Lopsided games</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: ratings are the sum of three random numbers, so most players are near the middle and a few are far out. A player gives up after 90 seconds without a game. A game is lopsided when the rating gap is above 150. The queue is checked once per second and the longest-waiting player picks the closest rating among those who also accept the gap. The same 400 players are used for every setting.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-mmb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const num = (s: string) => Number(q<HTMLInputElement>(s).value);
    const PLAYERS = 400; const QUIT = 90; const LOPSIDED = 150;
    const SEED = 11; const RATING = { base: 400, span: 600 }; // rating = base + three uniform draws, bell-shaped around 1,300
    const MAX_QUIT_SHARE = 0.1; const MAX_LOPSIDED_SHARE = 0.2; // verdict thresholds
    // LCG, upper bits
    let seed = SEED; const rnd = (n: number) => { seed = (seed * 1664525 + 1013904223) % 4294967296; return Math.floor(seed / 65536) % n; };
    const ratings = Array.from({ length: PLAYERS }, () => RATING.base + rnd(RATING.span) + rnd(RATING.span) + rnd(RATING.span));
    type Ticket = { id: number; rating: number; since: number };
    function simulate(every: number, start: number, grow: number, cap: number) {
      const windowOf = (waited: number) => Math.min(cap, start + grow * waited);
      let queue: Ticket[] = []; let pairs = 0; let gapSum = 0; let waitSum = 0; let lopsided = 0; let gaveUp = 0;
      for (let now = 0; now < PLAYERS * every + QUIT + 1; now++) {
        if (now % every === 0 && now / every < PLAYERS) queue.push({ id: now / every, rating: ratings[now / every], since: now });
        const taken = new Set<number>();
        for (const a of queue) {
          if (taken.has(a.id)) continue;
          const wa = windowOf(now - a.since); let best: Ticket | null = null; let bestGap = 0;
          for (const b of queue) {
            if (b.id === a.id || taken.has(b.id)) continue;
            const gap = Math.abs(a.rating - b.rating);
            if (gap <= wa && gap <= windowOf(now - b.since) && (best === null || gap < bestGap)) { best = b; bestGap = gap; }
          }
          if (best === null) continue;
          taken.add(a.id); taken.add(best.id); pairs++; gapSum += bestGap; waitSum += now - a.since + (now - best.since);
          if (bestGap > LOPSIDED) lopsided++;
        }
        const next: Ticket[] = [];
        for (const t of queue) { if (taken.has(t.id)) continue; if (now - t.since >= QUIT) gaveUp++; else next.push(t); }
        queue = next;
      }
      return { matched: pairs * 2, gaveUp, pairs, lopsided, avgGap: pairs ? gapSum / pairs : 0, avgWait: pairs ? waitSum / (pairs * 2) : 0 };
    }
    let pending = false;
    function draw() {
      pending = false;
      const every = Number(q<HTMLSelectElement>('[data-rate]').value); const start = num('[data-start]'); const grow = num('[data-widen]'); const cap = num('[data-cap]');
      ['start', 'widen', 'cap'].forEach((k) => (q(`[data-${k}val]`).textContent = String(num(`[data-${k}]`))));
      const r = simulate(every, start, grow, cap);
      const quitShare = r.gaveUp / PLAYERS; const badShare = r.pairs ? r.lopsided / r.pairs : 0;
      q('[data-o1]').textContent = `${r.matched} of ${PLAYERS}`; q('[data-n1]').textContent = `${r.pairs} games of two`;
      q('[data-o2]').textContent = `${r.gaveUp} of ${PLAYERS}`; q('[data-n2]').textContent = `${Math.round(quitShare * 100)}% waited ${QUIT} seconds and left`;
      q('[data-o3]').textContent = `${r.avgWait.toFixed(1)} s`; q('[data-n3]').textContent = 'for players who found a game';
      q('[data-o4]').textContent = `${r.lopsided} of ${r.pairs}`; q('[data-n4]').textContent = `average rating gap ${Math.round(r.avgGap)}; ${Math.round(badShare * 100)}% of games above ${LOPSIDED}`;
      q<HTMLElement>('[data-b1]').style.setProperty('--c', 'var(--accent)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', quitShare > MAX_QUIT_SHARE ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', 'var(--accent)');
      q<HTMLElement>('[data-b4]').style.setProperty('--c', badShare > MAX_LOPSIDED_SHARE ? 'var(--bad)' : 'var(--good)');
      const out = q('[data-verdict]'); const bad = quitShare > MAX_QUIT_SHARE || badShare > MAX_LOPSIDED_SHARE; out.classList.toggle('bad', bad);
      out.textContent = quitShare > MAX_QUIT_SHARE ? `Too strict for this crowd: ${r.gaveUp} players gave up, because nobody within the window ever showed up. Let the window widen with the wait, or wait for more players.`
        : badShare > MAX_LOPSIDED_SHARE ? `Too loose: ${Math.round(badShare * 100)}% of the games are lopsided. Waits are short, but strong players keep meeting weak ones and the weaker side stops enjoying the game.`
        : `A fair balance for this crowd: ${r.gaveUp} gave up, the average wait is ${r.avgWait.toFixed(1)} seconds and ${Math.round(badShare * 100)}% of the games are lopsided.`;
    }
    const schedule = () => { if (pending) return; pending = true; requestAnimationFrame(draw); };
    root.addEventListener('input', schedule); root.addEventListener('change', schedule);
    draw();
  });
</script>
