---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Players finish matches at a steady rate, and each one needs a ticket, a queue and a game server. Little's law turns the wait into a crowd.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Players online at the peak (thousands) <input type="range" min="100" max="5000" step="100" value="1000" data-on /> <b data-onval></b></label>
      <label>Match length (minutes) <input type="range" min="5" max="60" step="5" value="20" data-len /> <b data-lenval></b></label>
      <label>Players per match <input type="range" min="2" max="100" value="10" data-pp /> <b data-ppval></b></label>
      <label>Average wait in the queue (seconds) <input type="range" min="5" max="120" step="5" value="20" data-wait /> <b data-waitval></b></label>
      <label>Game modes <input type="range" min="1" max="10" value="4" data-modes /> <b data-modesval></b></label>
      <label>Regions <input type="range" min="1" max="20" value="8" data-reg /> <b data-regval></b></label>
      <label>Matches one game server can run <input type="range" min="1" max="16" value="4" data-mps /> <b data-mpsval></b></label>
      <label>Seconds to start a new server <input type="range" min="10" max="120" step="10" value="30" data-boot /> <b data-bootval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 80% of the players online are inside a match at any moment and each of them joins the queue once per match length, tickets arrive evenly across all queues, one matcher worker handles about 5,000 tickets per second and there are always at least two for failover, and a surge doubles the match rate for as long as a new server takes to start.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 9; // one per output line
    const THOUSAND = 1000; const SEC_PER_MIN = 60;
    const PLAYING_SHARE = 0.8; // online players who are in or queueing for a match
    const MATCHER = { ticketsPerS: 5000, min: 2 }; const WARM_MATCHES_X = 2; // warm capacity for twice the match rate during boot
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const online = val('[data-on]') * THOUSAND; const len = val('[data-len]'); const pp = val('[data-pp]'); const wait = val('[data-wait]');
      const modes = val('[data-modes]'); const reg = val('[data-reg]'); const mps = val('[data-mps]'); const boot = val('[data-boot]');
      ['on', 'len', 'pp', 'wait', 'modes', 'reg', 'mps', 'boot'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const tickets = (online * PLAYING_SHARE) / (len * SEC_PER_MIN); const matches = tickets / pp; const concurrent = matches * len * SEC_PER_MIN;
      const servers = Math.ceil(concurrent / mps); const waiting = tickets * wait; const queues = modes * reg;
      const perQueue = waiting / queues; const compares = queues * ((perQueue * perQueue) / 2);
      const workers = Math.max(MATCHER.min, Math.ceil(tickets / MATCHER.ticketsPerS)); const warm = Math.ceil((matches * WARM_MATCHES_X * boot) / mps);
      const data: [string, string][] = [
        ['Tickets entering queues per second', fmt(tickets)],
        ['New matches per second', fmt(matches)],
        ['Matches running at once', fmt(concurrent)],
        ['Game servers to run them', fmt(servers)],
        ['Players waiting in queues at any moment (tickets per second times wait)', fmt(waiting)],
        ['Queues (modes times regions) and players waiting in each', `${fmt(queues)} queues, ${fmt(perQueue)} each`],
        ['Pair checks per second if every waiting player is compared with every other', fmt(compares)],
        ['Matcher workers', fmt(workers)],
        ['Warm servers to absorb a surge while new ones start', fmt(warm)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
