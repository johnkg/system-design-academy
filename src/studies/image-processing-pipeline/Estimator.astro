---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Processing is CPU, storage grows with every variant, and a backfill is the same work again for every photo you already have.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Photos uploaded per day (millions)" name="u" min="0.5" max="20" step="0.5" value="2" />
      <RangeField label="Variants per photo" name="v" min="1" max="12" value="6" />
      <RangeField label="CPU time per variant (ms)" name="ms" min="50" max="1000" step="50" value="300" />
      <RangeField label="Size of an original (MB)" name="mb" min="1" max="20" value="4" />
      <RangeField label="Largest bulk import (thousands of photos)" name="b" min="10" max="1000" step="10" value="100" />
      <RangeField label="Photos to backfill for a new size (millions)" name="bf" min="10" max="2000" step="10" value="400" />
      <RangeField label="Days allowed for the backfill" name="d" min="1" max="30" value="7" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the busiest hour has 3 times the daily average of uploads. A worker machine has 16 cores and is kept 70% busy at most. All the variants of one photo together take about 0.3 MB. A bulk import should finish within an hour. A backfill makes one new variant per photo. Storage is before replication.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatWholeNumber } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const MILLION = 1e6, THOUSAND = 1e3, DAY_S = 86400, HOUR_S = 3600, MS_PER_S = 1000, MB_PER_TB = 1e6, DAYS_PER_MONTH = 30;
    const PEAK = 3; // busiest hour over the daily average
    const CORES_PER_MACHINE = 16, TARGET_BUSY = 0.7;
    const VARIANTS_MB = 0.3; // all variants of one photo
    const IMPORT_HOURS = 1;
    const N_ROWS = 9;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const machinesFor = (cores: number) => Math.ceil(cores / (CORES_PER_MACHINE * TARGET_BUSY));
    const one = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const u = val('[data-u]') * MILLION, v = val('[data-v]'), ms = val('[data-ms]'), mb = val('[data-mb]');
      const b = val('[data-b]') * THOUSAND, bf = val('[data-bf]') * MILLION, d = val('[data-d]');
      ['u', 'v', 'ms', 'mb', 'b', 'bf', 'd'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const cpuPerPhoto = (v * ms) / MS_PER_S; // core-seconds
      const peakRate = (u / DAY_S) * PEAK;
      const peakCores = peakRate * cpuPerPhoto;
      const importCores = (b * cpuPerPhoto) / (IMPORT_HOURS * HOUR_S);
      const backfillCores = (bf * (ms / MS_PER_S)) / (d * DAY_S);
      const storeTbMonth = (u * (mb + VARIANTS_MB) * DAYS_PER_MONTH) / MB_PER_TB;
      const data: [string, string][] = [
        ['Uploads per second in the busiest hour', formatWholeNumber(peakRate)],
        ['CPU per photo, all variants', `${one(cpuPerPhoto)} core-seconds`],
        ['Cores for live uploads at the busiest hour', formatWholeNumber(peakCores)],
        [`Machines of ${CORES_PER_MACHINE} cores for live uploads`, formatWholeNumber(machinesFor(peakCores))],
        ['Extra cores to finish the largest import in an hour', formatWholeNumber(importCores)],
        ['Extra machines while that import runs', formatWholeNumber(machinesFor(importCores))],
        ['Cores to finish the backfill in time', formatWholeNumber(backfillCores)],
        ['Machines for the backfill, running day and night', formatWholeNumber(machinesFor(backfillCores))],
        ['Storage added per month, originals and variants', `${one(storeTbMonth)} TB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
