---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How fast jobs arrive, how much a durable log must hold, how many partitions and canaries that means, and how long Redis or Kafka can ride out workers that fall behind. A teaching model with round numbers, not Slack's data.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Jobs on a busy day (millions) <input type="range" min="100" max="3000" step="100" value="1400" data-j /> <b data-jval></b></label>
      <label>Peak jobs per second (thousands) <input type="range" min="5" max="60" value="33" data-p /> <b data-pval></b></label>
      <label>Stored size per job (bytes) <input type="range" min="100" max="2000" step="50" value="500" data-b /> <b data-bval></b></label>
      <label>Copies of each partition (replication factor) <input type="range" min="1" max="5" value="3" data-r /> <b data-rval></b></label>
      <label>Kafka retention (days) <input type="range" min="1" max="7" value="2" data-d /> <b data-dval></b></label>
      <label>Kafka brokers <input type="range" min="4" max="32" value="16" data-k /> <b data-kval></b></label>
      <label>Disk per broker (TB) <input type="range" min="0.5" max="4" step="0.1" value="1.9" data-s /> <b data-sval></b></label>
      <label>Topics <input type="range" min="10" max="100" step="10" value="50" data-t /> <b data-tval></b></label>
      <label>Partitions per topic <input type="range" min="8" max="64" step="8" value="32" data-n /> <b data-nval></b></label>
      <label>Minutes between canary jobs <input type="range" min="1" max="10" value="1" data-c /> <b data-cval></b></label>
      <label>Jobs the workers finish at the peak (thousands per second) <input type="range" min="5" max="60" value="24" data-w /> <b data-wval></b></label>
      <label>Free Redis memory for waiting jobs (GB) <input type="range" min="1" max="50" value="10" data-m /> <b data-mval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Teaching model, not Slack's system or data. From Slack's 2017 post: over 1.4 billion jobs on the busiest days, a peak of 33,000 jobs per second, 16 brokers, 50 topics of 32 partitions, 3 copies, 2 days of retention, and a canary job for every partition every minute. Guesses of mine that you can change: 500 bytes per job, 1.9 TB of disk per broker, 24,000 jobs per second finished by workers during a slowdown, and 10 GB of free Redis memory. Assumptions: jobs and partitions are spread evenly, a day has 86,400 seconds, and the workers fall behind at the peak rate and stay there. Kafka keeps jobs by age, not by whether they were read, so a backlog does not add disk use; it ends when the oldest waiting job is older than the retention period and may expire before it is relayed.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 14; // lines in the result list
    const SECONDS_PER_DAY = 86400, MINUTES_PER_DAY = 1440, SECONDS_PER_MIN = 60;
    const MILLION = 1e6, GB = 1e9, TB = 1e12;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    const fmt2 = (n: number) => (Math.round(n * 100) / 100).toLocaleString('en-US');
    function draw() {
      ['j', 'p', 'b', 'r', 'd', 'k', 's', 't', 'n', 'c', 'w', 'm'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const perDay = val('[data-j]') * MILLION; const peak = val('[data-p]') * 1000; const size = val('[data-b]'); const copies = val('[data-r]');
      const days = val('[data-d]'); const brokers = val('[data-k]'); const diskTb = val('[data-s]'); const topics = val('[data-t]');
      const perTopic = val('[data-n]'); const canaryMin = val('[data-c]'); const workers = val('[data-w]') * 1000; const redisGb = val('[data-m]');
      const avg = perDay / SECONDS_PER_DAY;
      const dayGb = (perDay * size) / GB;
      const kafkaTb = (perDay * size * days * copies) / TB;
      const perBrokerTb = kafkaTb / brokers;
      const partitions = topics * perTopic;
      const canaries = partitions * (MINUTES_PER_DAY / canaryMin);
      const shortfall = Math.max(0, peak - workers);
      const redisMin = shortfall > 0 ? (redisGb * GB) / (shortfall * size) / SECONDS_PER_MIN : Infinity;
      const expireDays = shortfall > 0 ? (days * workers) / shortfall : Infinity;
      const data: [string, string][] = [
        ['Average jobs per second', fmt(avg)],
        ['Peak compared with the average', `${fmt(peak / avg)} times`],
        ['New job data per day (GB)', fmt(dayGb)],
        [`Kafka data kept for ${days} day${days === 1 ? '' : 's'}, with all copies (TB)`, fmt(kafkaTb)],
        ['Per broker (TB)', fmt2(perBrokerTb)],
        ['Share of each broker’s disk used', `${fmt((100 * perBrokerTb) / diskTb)}%`],
        ['Partitions in total', fmt(partitions)],
        ['Partition copies on each broker', fmt((partitions * copies) / brokers)],
        ['Peak jobs per second for one partition', fmt(peak / partitions)],
        ['Canary jobs per day', fmt(canaries)],
        ['Canaries as a share of real jobs', `${fmt2((100 * canaries) / perDay)}%`],
        ['Jobs piling up per second at the peak', fmt(shortfall)],
        ['Time until the free Redis memory is full with no Kafka (minutes)', Number.isFinite(redisMin) ? fmt(redisMin) : 'never, the workers keep up'],
        ['Days of this slowdown until waiting jobs could expire from Kafka', Number.isFinite(expireDays) ? fmt(expireDays) : 'never, the workers keep up'],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
