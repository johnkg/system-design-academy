---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="A viral photo and its like counter" hint="A post goes viral and the likes pour in for ten seconds. Compare four ways to count them, with the same stream of likes. Only the way of counting changes.">
  <ol class="how">
    <li>At <b>6,000 likes per second</b>, <b>one counter row with a lock</b> counts only <b>10,000 of 52,464</b> likes: each update holds the row for about 1 ms, so it handles about 1,000 a second, and the rest wait 2 seconds and time out.</li>
    <li>Set <b>shards to 4</b>: 4 rows handle only about 4,000 a second, so <b>7,041</b> likes still time out. At <b>16 shards</b> nothing is lost, because the work is spread over 16 rows.</li>
    <li>With <b>batching</b> nothing is lost either, and the database sees only about 10 counter writes. The price is a count that is behind by up to <b>6,128</b> likes at a 1 s window, and <b>28,198</b> at 5 s. <b>Row per like</b> never loses a like, but counting 2 million rows for each view takes <b>410 ms</b>.</li>
  </ol>
  <div class="pg phb" data-phb>
    <div class="pg-row">
      <label>Likes per second at the peak <input type="range" min="500" max="50000" step="500" value="6000" data-r /> <b data-rval></b></label>
      <label>Counter shards <select class="pg-in" data-k><option value="4">4</option><option value="16" selected>16</option><option value="64">64</option></select></label>
      <label>Batch window <select class="pg-in" data-t><option value="100">0.1 s</option><option value="1000" selected>1 s</option><option value="5000">5 s</option></select></label>
      <label>Likes the post already has (millions) <input type="range" min="0" max="5" step="0.5" value="2" data-e /> <b data-eval></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Row per like, count when read</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span><span class="pg-note" data-m1></span></div>
      <div class="pg-box" data-b2><h3>One counter row, row lock</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span><span class="pg-note" data-m2></span></div>
      <div class="pg-box" data-b3><h3>Sharded counter rows</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span><span class="pg-note" data-m3></span></div>
      <div class="pg-box" data-b4><h3>Batched, async aggregation</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span><span class="pg-note" data-m4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: ten seconds of likes, in steps of 10 ms. The rate climbs to your peak in about 2 seconds, stays there, and halves after 8 seconds, with random bursts of plus or minus 20%. A counter row can take about 1,000 updates a second, because each update holds its lock for about 1 ms. A table of likes takes about 10,000 inserts a second on one primary, and a count scans about 5 million rows a second. The in-memory buffer takes 100,000 likes a second. A like that waits more than 2 seconds times out. Every approach keeps a unique (user, post) row, so a repeated tap is never counted twice.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-phb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const TICKS = 1000; const ROW_CAP = 1000; const INSERT_CAP = 10000; const TIMEOUT = 2;
    let seed = 77; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
    const jitter = Array.from({ length: TICKS }, () => 0.8 + 0.4 * rnd());
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    type R = { done: number; rej: number; avg: number; max: number; lag: number; writes: number };
    function simulate(rate: number, shards: number, windowMs: number, existing: number) {
      const profile = (s: number) => Math.min(1, 0.3 + 0.7 * s) * (s < 8 ? 1 : 0.5);
      const arr: number[] = []; let total = 0;
      for (let i = 0; i < TICKS; i++) { const a = Math.round(rate * 0.01 * profile(i / 100) * jitter[i]); arr.push(a); total += a; }
      // A queue served at a fixed number of updates per second; a like that would wait over 2 seconds times out.
      function queue(cap: number): R {
        let b = 0; let done = 0; let rej = 0; let waitSum = 0; let maxW = 0; let acc = 0; let maxLag = 0;
        for (let i = 0; i < TICKS; i++) {
          b += arr[i]; let a = arr[i];
          const limit = cap * TIMEOUT; if (b > limit) { const r = b - limit; rej += r; a -= Math.min(a, r); b = limit; }
          const s = Math.min(b, cap * 0.01); b -= s; done += s;
          if (b > maxLag) maxLag = b;
          const w = b / cap; waitSum += a * w; acc += a; if (w > maxW) maxW = w;
        }
        return { done: Math.round(done), rej: Math.round(rej), avg: acc ? (waitSum / acc) * 1000 : 0, max: maxW * 1000, lag: Math.round(maxLag), writes: Math.round(done) };
      }
      const A = queue(INSERT_CAP); const B = queue(ROW_CAP); const C = queue(shards * ROW_CAP);
      // D: likes are added to a memory buffer at once, and one write per window adds the whole batch to the counter.
      const every = Math.max(1, Math.round(windowMs / 10)); let buf: number[] = []; let maxBuf = 0; let done = 0; let waitSum = 0; let maxW = 0; let flushes = 0;
      for (let i = 0; i < TICKS; i++) {
        buf.push(arr[i]);
        const cur = buf.reduce((x, y) => x + y, 0); if (cur > maxBuf) maxBuf = cur;
        if ((i + 1) % every === 0) {
          buf.forEach((n, j) => { const wt = (buf.length - j) * 10; waitSum += n * wt; if (n > 0 && wt > maxW) maxW = wt; });
          done += buf.reduce((x, y) => x + y, 0); buf = []; flushes++;
        }
      }
      const D: R = { done, rej: 0, avg: waitSum / Math.max(1, done), max: maxW, lag: maxBuf, writes: flushes };
      const readMs = ((existing * 1e6 + A.done) / 5e6) * 1000;
      return { total, A, B, C, D, readMs };
    }
    function draw() {
      const rate = Number(q<HTMLInputElement>('[data-r]').value); const k = Number(q<HTMLSelectElement>('[data-k]').value);
      const t = Number(q<HTMLSelectElement>('[data-t]').value); const e = Number(q<HTMLInputElement>('[data-e]').value);
      q('[data-rval]').textContent = fmt(rate); q('[data-eval]').textContent = String(e);
      const r = simulate(rate, k, t, e);
      const rows: [R, string][] = [
        [r.A, `count scans ${fmt(e * 1e6 + r.A.done)} rows: ${fmt(r.readMs)} ms per read`],
        [r.B, 'a read is one row'],
        [r.C, `a read sums ${k} rows`],
        [r.D, 'a read is one row'],
      ];
      rows.forEach(([x, readNote], i) => {
        const n = i + 1;
        q(`[data-o${n}]`).textContent = `${fmt(x.done)} of ${fmt(r.total)} likes counted`;
        q(`[data-n${n}]`).textContent = `wait ${fmt(x.avg)} ms on average, ${fmt(x.max)} ms at worst` + (x.rej > 0 ? `; ${fmt(x.rej)} timed out` : '');
        q(`[data-m${n}]`).textContent = `count behind by up to ${fmt(x.lag)}; ${fmt(x.writes)} database writes; ${readNote}`;
        const bad = x.rej > 0 || (i === 0 && r.readMs > 200);
        q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', bad ? 'var(--bad)' : 'var(--good)');
      });
      const out = q('[data-verdict]'); const bad = r.B.rej > 0 || r.C.rej > 0 || r.A.rej > 0; out.classList.toggle('bad', bad);
      out.textContent = r.B.rej > 0
        ? `The single counter row counted ${fmt(r.B.done)} of ${fmt(r.total)} likes and ${fmt(r.B.rej)} timed out, because its lock lets through about ${fmt(ROW_CAP)} updates a second. ` +
          (r.C.rej > 0 ? `${k} shards give only about ${fmt(k * ROW_CAP)} a second, which is still too few, so ${fmt(r.C.rej)} timed out there too. Use more shards, or batch.`
            : `${k} shards give about ${fmt(k * ROW_CAP)} a second and lose nothing. Batching also loses nothing, but its count trails by up to ${fmt(r.D.lag)} likes.`)
        : 'At this rate every approach keeps up, which is why a naive counter looks fine in testing. Raise the likes per second to see the single row fall behind.';
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
