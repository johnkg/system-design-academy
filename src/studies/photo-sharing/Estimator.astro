---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Storage and image bandwidth dominate the bill, and the hit ratio of the CDN decides how much of that reaches your own servers.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Photos uploaded per day (millions) <input type="range" min="1" max="500" value="100" data-u /> <b data-uval></b></label>
      <label>Size of an original (MB) <input type="range" min="1" max="10" step="0.5" value="3" data-mb /> <b data-mbval></b></label>
      <label>Daily active users (millions) <input type="range" min="10" max="1000" step="10" value="500" data-dau /> <b data-dauval></b></label>
      <label>Images viewed per user per day <input type="range" min="20" max="500" step="10" value="200" data-v /> <b data-vval></b></label>
      <label>CDN hit ratio (%) <input type="range" min="80" max="99" value="95" data-hit /> <b data-hitval></b></label>
      <label>Likes per user per day <input type="range" min="1" max="20" value="6" data-l /> <b data-lval></b></label>
      <label>Share of peak likes going to one viral post (%) <input type="range" min="1" max="20" value="5" data-hot /> <b data-hotval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: the peak is 3 times the daily average for uploads and likes and 2 times for views. All the sizes of one photo together take about 0.4 MB, and the average image sent to a phone is about 60 KB. Resizing and encoding one original takes about 0.5 CPU-seconds. A worker machine has 32 cores. One counter row takes about 1,000 updates a second, and a shard is kept to about 500 so there is room to spare. Storage is before replication.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 12 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const one = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const u = val('[data-u]') * 1e6; const mb = val('[data-mb]'); const dau = val('[data-dau]') * 1e6; const views = val('[data-v]');
      const hit = val('[data-hit]') / 100; const likes = val('[data-l]'); const hot = val('[data-hot]') / 100;
      ['u', 'mb', 'dau', 'v', 'hit', 'l', 'hot'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const upPeak = (u / 86400) * 3; const rawTb = (u * mb) / 1e6; const yearPb = (u * (mb + 0.4) * 365) / 1e9;
      const cores = upPeak * 0.5; const machines = Math.ceil(cores / 32);
      const reqPeak = ((dau * views) / 86400) * 2; const tbps = (reqPeak * 60e3 * 8) / 1e12; const originRps = reqPeak * (1 - hit);
      const likesPeak = ((dau * likes) / 86400) * 3; const hotRate = likesPeak * hot; const shards = Math.ceil(hotRate / 500);
      const data: [string, string][] = [
        ['Uploads per second at the peak', fmt(upPeak)],
        ['Original bytes uploaded per day', `${fmt(rawTb)} TB`],
        ['Storage added per year, originals and sizes', `${one(yearPb)} PB`],
        ['Worker CPU cores at the peak', fmt(cores)],
        ['Worker machines of 32 cores', fmt(machines)],
        ['Image requests per second at the peak', fmt(reqPeak)],
        ['CDN bandwidth at the peak', `${one(tbps)} Tbps`],
        ['Requests per second that reach the origin store', fmt(originRps)],
        ['Likes per second at the peak, all posts', fmt(likesPeak)],
        ['Likes per second on the one viral post', fmt(hotRate)],
        ['Counter shards the viral post needs', fmt(shards)],
        ['Counter updates per second on the hottest row, batched once a second', '1'],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
