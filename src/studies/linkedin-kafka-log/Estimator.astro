---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How much network, disk bandwidth and disk space a stream of small records needs on a Kafka-style log with copies, and which limit you reach first. A teaching model with round numbers, not LinkedIn's data.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Records written per second (thousands) <input type="range" min="100" max="3000" step="100" value="800" data-r /> <b data-rval></b></label>
      <label>Bytes per record <input type="range" min="10" max="1000" step="10" value="100" data-z /> <b data-zval></b></label>
      <label>Copies of each partition (replication factor) <input type="range" min="1" max="3" value="3" data-c /> <b data-cval></b></label>
      <label>Brokers (machines holding logs) <input type="range" min="3" max="12" value="3" data-k /> <b data-kval></b></label>
      <label>Producer machines <input type="range" min="1" max="6" value="1" data-p /> <b data-pval></b></label>
      <label>Network card speed (gigabits per second) <input type="range" min="1" max="10" value="1" data-n /> <b data-nval></b></label>
      <label>Drives per broker <input type="range" min="2" max="12" value="6" data-d /> <b data-dval></b></label>
      <label>Disk space per drive (TB) <input type="range" min="0.5" max="8" step="0.5" value="2" data-s /> <b data-sval></b></label>
      <label>Days of records kept <input type="range" min="1" max="14" value="1" data-t /> <b data-tval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Teaching model, not LinkedIn's system or data. From LinkedIn's 2014 benchmark post: records of 100 bytes, about 22 bytes of extra overhead per message on the network, 1 gigabit Ethernet, six 7200 RPM SATA drives per machine giving an aggregate of 822 MB per second of linear disk I/O, and a three machine cluster. Everything else is a guess of mine that you can change, including 137 MB per second per drive (822 divided by 6), 2 TB per drive, and the assumption that the 22 bytes are stored on disk as well. Other assumptions: 125 MB per second per gigabit, records and partitions spread evenly over brokers and producers, every copy takes the same disk writes, and the request overhead the post mentions is ignored, so real limits are lower. A day has 86,400 seconds. For comparison, the post measured 821,557 records per second from one producer thread with no replication, and 2,024,032 from three producers with three copies; this calculator does not predict those results.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 13; // lines in the result list
    const OVERHEAD = 22; // bytes per message on the network, from the post
    const MB_PER_GBIT = 125, DRIVE_MBPS = 137, SECONDS_PER_DAY = 86400, MB_PER_TB = 1e6, MILLION = 1e6;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      ['r', 'z', 'c', 'k', 'p', 'n', 'd', 's', 't'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const rate = val('[data-r]') * 1000; const size = val('[data-z]'); const copies = val('[data-c]'); const brokers = val('[data-k]');
      const producers = val('[data-p]'); const nic = val('[data-n]'); const drives = val('[data-d]'); const driveTb = val('[data-s]'); const days = val('[data-t]');
      const payload = (rate * size) / MILLION;
      const wire = size + OVERHEAD;
      const inbound = (rate * wire) / MILLION;
      const perProducer = inbound / producers;
      const nicShare = (100 * perProducer) / (nic * MB_PER_GBIT);
      const producersNeeded = Math.ceil(inbound / (nic * MB_PER_GBIT));
      const diskAll = inbound * copies;
      const perBroker = diskAll / brokers;
      const capability = drives * DRIVE_MBPS;
      const diskShare = (100 * perBroker) / capability;
      const replication = inbound * (copies - 1);
      const keptTb = (diskAll * SECONDS_PER_DAY * days) / MB_PER_TB;
      const perBrokerTb = keptTb / brokers;
      const spaceShare = (100 * perBrokerTb) / (drives * driveTb);
      const data: [string, string][] = [
        ['Record data from producers (MB per second)', fmt(payload)],
        ['Bytes sent per record, with the 22 bytes of overhead', fmt(wire)],
        ['Network into the cluster (MB per second)', fmt(inbound)],
        ['Network use of each producer machine', `${fmt(nicShare)}% of its card`],
        [`Producer machines needed at 100% of a ${nic} gigabit card`, fmt(producersNeeded)],
        [`Disk writes, all ${copies} cop${copies === 1 ? 'y' : 'ies'} (MB per second)`, fmt(diskAll)],
        ['Disk writes per broker (MB per second)', fmt(perBroker)],
        ['Linear disk speed of one broker (MB per second)', fmt(capability)],
        ['Share of that speed used', `${fmt(diskShare)}%`],
        ['Copying between brokers (MB per second)', fmt(replication)],
        [`Data kept for ${days} day${days === 1 ? '' : 's'}, all copies (TB)`, fmt(keptTb)],
        ['Per broker (TB)', fmt(perBrokerTb)],
        ['Share of each broker’s disk space used', `${fmt(spaceShare)}%`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
      const limits: string[] = [];
      if (nicShare > 100) limits.push(`each producer machine would need more than its network card gives (add producer machines)`);
      if (diskShare > 100) limits.push(`each broker would need more linear disk speed than its drives give (add brokers or drives)`);
      if (spaceShare > 100) limits.push(`the kept records would not fit on the brokers' disks (add brokers or drives, or keep fewer days)`);
      const out = q('[data-verdict]'); out.classList.toggle('bad', limits.length > 0);
      out.textContent = limits.length ? `Over a limit: ${limits.join('; ')}.` : 'Within all three limits in this model: producer network, broker disk speed and broker disk space.';
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
