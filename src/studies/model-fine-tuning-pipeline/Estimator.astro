---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The examples and the GPUs set the length and cost of a run, and the method sets the size of every checkpoint. The numbers are worked out from the assumptions below, not measured on any product.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Examples (thousands)" name="ex" min="1" max="2000" value="50" />
      <RangeField label="Tokens per example" name="tpe" min="50" max="4000" step="50" value="500" />
      <RangeField label="Passes over the data (epochs)" name="ep" min="1" max="5" value="3" />
      <RangeField label="GPUs" name="g" min="1" max="64" value="8" />
      <label>Tokens per second per GPU <select class="pg-in" data-tps>
        <option value="2000">2,000</option>
        <option value="5000" selected>5,000</option>
        <option value="10000">10,000</option>
      </select></label>
      <RangeField label="Price per GPU hour (dollars)" name="price" min="1" max="10" step="0.5" value="2.5" />
      <label>Model size <select class="pg-in" data-size>
        <option value="7" selected>7 billion parameters</option>
        <option value="13">13 billion parameters</option>
        <option value="70">70 billion parameters</option>
      </select></label>
      <label>Method <select class="pg-in" data-method>
        <option value="lora" selected>LoRA adapter</option>
        <option value="full">Full fine-tuning</option>
      </select></label>
      <RangeField label="Checkpoint every (minutes)" name="ck" min="5" max="120" step="5" value="30" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: throughput is an example figure per GPU and varies a lot with the model and the hardware; a LoRA run trains about 1 percent of the parameters; a checkpoint holds 16 bytes for every trainable parameter (the weight, its gradient and the optimizer state); the three newest checkpoints are kept; a failure can come at any moment, so on average half an interval of work is lost.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatWholeNumber } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 10; // one per output line
    const THOUSAND = 1e3; const BILLION = 1e9; const GB = 1e9; const HOUR_S = 3600; const HOUR_MIN = 60;
    const LORA_SHARE = 0.01; const BYTES_PER_TRAINABLE = 16; const KEPT = 3;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
    function draw() {
      const ex = val('[data-ex]') * THOUSAND; const tpe = val('[data-tpe]'); const ep = val('[data-ep]'); const g = val('[data-g]');
      const tps = val('[data-tps]'); const price = val('[data-price]'); const size = val('[data-size]') * BILLION; const ck = val('[data-ck]');
      const lora = q<HTMLSelectElement>('[data-method]').value === 'lora';
      ['ex', 'tpe', 'ep', 'g', 'price', 'ck'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const tokens = ex * tpe * ep;
      const hours = tokens / (g * tps) / HOUR_S;
      const gpuHours = hours * g;
      const cost = gpuHours * price;
      const ckptGb = (size * (lora ? LORA_SHARE : 1) * BYTES_PER_TRAINABLE) / GB;
      const written = Math.floor((hours * HOUR_MIN) / ck);
      const worstCost = g * (ck / HOUR_MIN) * price;
      const data: [string, string][] = [
        ['Tokens trained', formatWholeNumber(tokens)],
        ['Time to train', `${fmt1(hours)} hours`],
        ['GPU hours', fmt1(gpuHours)],
        ['Cost of the run', `$${fmt1(cost)}`],
        ['Size of one checkpoint', `${fmt1(ckptGb)} GB`],
        ['Checkpoints written during the run', formatWholeNumber(written)],
        ['Storage for the newest checkpoints', `${fmt1(ckptGb * KEPT)} GB`],
        ['Average work lost to a failure', `${fmt1(ck / 2)} minutes`],
        ['Worst-case work lost to a failure', `${formatWholeNumber(ck)} minutes`],
        ['Worst-case cost of that lost work', `$${fmt1(worstCost)}`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
