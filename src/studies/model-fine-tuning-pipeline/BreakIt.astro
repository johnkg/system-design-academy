---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="A node fails at hour 30" hint="A 36-hour run on 8 GPUs loses a node at 30 hours and 45 minutes. Choose how often checkpoints are written, and see how much work is lost and how much the checkpoints themselves cost.">
  <ol class="how">
    <li>The default is <b>No checkpoints</b>: the <b>30.75</b> hours of work are lost, the run finishes after <b>67</b> hours, <b>31</b> hours later than a clean run, and the extra <b>248</b> GPU hours cost <b>$620</b>.</li>
    <li>Choose <b>Every 30 minutes</b>: only <b>0.25</b> hours are lost, the run finishes after <b>37.7</b> hours, <b>1.7</b> hours late, and the extra <b>13.6</b> GPU hours cost <b>$34</b>. Most of that is the time spent writing the checkpoints.</li>
    <li>Choose <b>Every 2 hours</b>: <b>0.75</b> hours are lost, the run finishes after <b>37.3</b> hours, and the extra cost is <b>$26</b>. Fewer checkpoints cost less to write and lose more work.</li>
    <li>Choose <b>Every 10 minutes</b>: only <b>0.08</b> hours are lost, but the run finishes after <b>39.93</b> hours and the extra cost is <b>$78.67</b>. Checkpointing too often costs more than the work it saves.</li>
  </ol>
  <div class="pg brk" data-brk>
    <div class="pg-row">
      <label>Checkpoints <select class="pg-in" data-every>
        <option value="0" selected>No checkpoints</option>
        <option value="10">Every 10 minutes</option>
        <option value="30">Every 30 minutes</option>
        <option value="120">Every 2 hours</option>
      </select></label>
      <RangeField label="Time to write one checkpoint (minutes)" name="wr" min="0" max="10" value="1" />
      <RangeField label="Time to restart (minutes)" name="rs" min="5" max="60" step="5" value="15" />
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Work lost</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Time until the run finishes</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Extra GPU hours compared with a clean run</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Extra cost</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: a run of 36 hours of training on 8 GPUs at 2.50 dollars a GPU hour. The node is lost after 30 hours and 45 minutes of training. Work since the last checkpoint is redone, every checkpoint pauses training for the time you set, and the restart takes the time you set. Training progress, not wall-clock time, decides which checkpoint is the newest.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-brk]').forEach((root) => {
    const q = query(root);
    const RUN_MIN = 36 * 60; const CRASH_MIN = 30 * 60 + 45; const GPUS = 8; const PRICE = 2.5;
    const trim = (n: number) => String(Number(n.toFixed(2)));
    type Tone = 'good' | 'bad' | 'mid';
    const setBox = (i: number, value: string, note: string, tone: Tone) => {
      q(`[data-o${i}]`).textContent = value; q(`[data-n${i}]`).textContent = note;
      q<HTMLElement>(`[data-b${i}]`).style.setProperty('--c', tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--border)');
    };
    function draw() {
      const every = Number(q<HTMLSelectElement>('[data-every]').value);
      const wr = Number(q<HTMLInputElement>('[data-wr]').value), rs = Number(q<HTMLInputElement>('[data-rs]').value);
      q('[data-wrval]').textContent = String(wr); q('[data-rsval]').textContent = String(rs);
      const lost = every ? CRASH_MIN % every : CRASH_MIN;
      const overhead = every ? Math.floor(RUN_MIN / every) * wr : 0;
      const finish = (rs + RUN_MIN + lost + overhead) / 60;
      const extra = finish - RUN_MIN / 60;
      const gpuHours = extra * GPUS, cost = gpuHours * PRICE;
      setBox(1, `${trim(lost / 60)} hours`, every ? `the work since the last checkpoint, which was ${every} minutes apart` : 'everything since the start of the run', lost > 120 ? 'bad' : 'good');
      setBox(2, `${trim(finish)} hours`, `${trim(extra)} hours later than a clean run of 36 hours`, extra > 5 ? 'bad' : 'mid');
      setBox(3, trim(gpuHours), 'restart time, redone work and checkpoint writes, across all 8 GPUs', extra > 5 ? 'bad' : 'mid');
      setBox(4, `$${trim(cost)}`, 'at 2.50 dollars per GPU hour', extra > 5 ? 'bad' : 'mid');
      q('[data-verdict]').textContent = every === 0 ? 'Without checkpoints the crash costs almost the whole run.'
        : overhead / 60 > 2 ? 'Checkpointing this often costs more time writing checkpoints than it saves in lost work.'
        : 'A checkpoint interval balances two costs: the work lost to a failure and the time spent writing checkpoints.';
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
