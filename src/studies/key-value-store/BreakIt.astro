---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Choose your quorum" hint="Pick how many copies a write must reach (W) and how many a read asks (R), and take nodes down. 4,000 random reads and writes are simulated for each setting.">
  <ol class="how">
    <li>Start with <b>N = 3, W = 2, R = 2</b>: <b>no stale reads</b>, since 2 + 2 is more than 3. Typical latency is higher than for one copy.</li>
    <li>Set <b>W = 1 and R = 1</b>: the fastest, but a read often misses the replica that took the write, so a large share of reads are <b>stale</b>.</li>
    <li>Set <b>W = 3</b> and take <b>1 node down</b>: writes <b>fail</b>, because all three copies are required. Lower W or bring the node back, and writes work again.</li>
  </ol>
  <div class="pg kvb" data-kvb>
    <div class="pg-row">
      <label>Copies of each key (N) <select class="pg-in" data-n><option value="3" selected>3</option><option value="5">5</option></select></label>
      <label>Copies a write waits for (W) <select class="pg-in" data-w></select></label>
      <label>Copies a read asks (R) <select class="pg-in" data-r></select></label>
      <label>Replicas that are down <select class="pg-in" data-down><option value="0" selected>0</option><option value="1">1</option><option value="2">2</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-wbox><h3>Writes</h3><span class="pg-mono" data-wout></span><span class="pg-note" data-wnote></span></div>
      <div class="pg-box" data-rbox><h3>Reads</h3><span class="pg-mono" data-rout></span><span class="pg-note" data-rnote></span></div>
      <div class="pg-box" data-sbox><h3>Freshness</h3><span class="pg-mono" data-sout></span><span class="pg-note" data-snote></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: after the write is acknowledged by the W fastest up replicas, a read goes to the up replicas and uses the R fastest answers. A read is stale when none of those R replicas stored the write. Each request to a replica takes 5 ms plus a random delay averaging 10 ms. Latency shown is the median and the 99th percentile.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-kvb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const TRIALS = 4000;
    const MAX_N = 5; const LAT = { minMs: 5, meanMs: 10 }; // replica latency: 5 ms plus an exponential tail with mean 10 ms
    // Numerical Recipes LCG
    let seed = 99; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
    const lat = Array.from({ length: TRIALS }, () => ({ w: Array.from({ length: MAX_N }, () => LAT.minMs - LAT.meanMs * Math.log(1 - rnd())), r: Array.from({ length: MAX_N }, () => LAT.minMs - LAT.meanMs * Math.log(1 - rnd())) }));
    const pct = (xs: number[], p: number) => { const s = [...xs].sort((a, b) => a - b); return s[Math.min(s.length - 1, Math.floor(p * s.length))]; };
    function fillOptions(sel: HTMLSelectElement, max: number, keep: number) {
      if (sel.options.length === max) return;
      sel.replaceChildren(...Array.from({ length: max }, (_, i) => { const o = document.createElement('option'); o.value = String(i + 1); o.textContent = String(i + 1); return o; }));
      sel.value = String(Math.min(keep, max));
    }
    function draw() {
      const n = Number(q<HTMLSelectElement>('[data-n]').value);
      const wSel = q<HTMLSelectElement>('[data-w]'); const rSel = q<HTMLSelectElement>('[data-r]');
      const majority = Math.floor(n / 2) + 1; fillOptions(wSel, n, majority); fillOptions(rSel, n, majority);
      const w = Number(wSel.value); const r = Number(rSel.value); const down = Math.min(Number(q<HTMLSelectElement>('[data-down]').value), n - 1);
      const up = n - down;
      const writeOk = w <= up; const readOk = r <= up;
      let stale = 0; const wl: number[] = []; const rl: number[] = [];
      if (writeOk && readOk) {
        for (const t of lat) {
          const ids = Array.from({ length: up }, (_, i) => i + down); // the replicas that are up
          const byW = [...ids].sort((a, b) => t.w[a] - t.w[b]); const byR = [...ids].sort((a, b) => t.r[a] - t.r[b]);
          const has = new Set(byW.slice(0, w));
          if (!byR.slice(0, r).some((x) => has.has(x))) stale++;
          wl.push(t.w[byW[w - 1]]); rl.push(t.r[byR[r - 1]]);
        }
      }
      const f = (x: number) => `${Math.round(x)} ms`;
      q('[data-wout]').textContent = writeOk ? `median ${f(pct(wl, 0.5))}, p99 ${f(pct(wl, 0.99))}` : 'every write fails';
      q('[data-wnote]').textContent = writeOk ? `waits for ${w} of ${n} copies` : `needs ${w} copies but only ${up} are up`;
      q('[data-rout]').textContent = readOk ? `median ${f(pct(rl, 0.5))}, p99 ${f(pct(rl, 0.99))}` : 'every read fails';
      q('[data-rnote]').textContent = readOk ? `asks ${r} of ${n} copies` : `needs ${r} copies but only ${up} are up`;
      const strong = w + r > n; const share = (stale / TRIALS) * 100;
      q('[data-sout]').textContent = writeOk && readOk ? `${share.toFixed(1)}% of reads stale` : 'not measured';
      q('[data-snote]').textContent = `W + R = ${w + r}, N = ${n}: ${strong ? 'quorums overlap, so a read always meets the newest write' : 'quorums may miss each other'}`;
      q<HTMLElement>('[data-wbox]').style.setProperty('--c', writeOk ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-rbox]').style.setProperty('--c', readOk ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-sbox]').style.setProperty('--c', writeOk && readOk && share === 0 ? 'var(--good)' : 'var(--bad)');
      const out = q('[data-verdict]'); const bad = !writeOk || !readOk || share > 0; out.classList.toggle('bad', bad);
      out.textContent = !writeOk ? `Writes are unavailable: ${w} copies are required and only ${up} replicas are up. Lower W to keep accepting writes.`
        : !readOk ? `Reads are unavailable: ${r} copies are required and only ${up} replicas are up. Lower R to keep answering.`
        : share > 0 ? `${share.toFixed(1)}% of reads returned old data. That is the price of W + R not exceeding N, and it buys lower latency and more availability.`
        : 'No stale reads: every read set overlaps the latest write set.';
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
