---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Replication multiplies the storage and the write traffic. See how the cluster grows and how little moves when a node is added.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Keys stored (billions) <input type="range" min="1" max="500" value="50" data-keys /> <b data-keysval></b></label>
      <label>Average value size (KB) <input type="range" min="1" max="10" value="2" data-size /> <b data-sizeval></b></label>
      <label>Copies of each key (N) <select class="pg-in" data-n><option value="2">2</option><option value="3" selected>3</option><option value="5">5</option></select></label>
      <label>Requests per second (thousands) <input type="range" min="10" max="2000" step="10" value="500" data-ops /> <b data-opsval></b></label>
      <label>Nodes in the cluster <input type="range" min="3" max="500" value="100" data-nodes /> <b data-nodesval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: 20% of requests are writes, a node stores up to 4 TB and serves about 20,000 requests per second, and adding a node with consistent hashing moves its fair share of keys, while hashing modulo the number of nodes moves nearly all of them.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const keys = val('[data-keys]') * 1e9; const size = val('[data-size]'); const n = Number(q<HTMLSelectElement>('[data-n]').value); const ops = val('[data-ops]') * 1000; const nodes = val('[data-nodes]');
      q('[data-keysval]').textContent = String(val('[data-keys]')); q('[data-sizeval]').textContent = String(size);
      q('[data-opsval]').textContent = String(val('[data-ops]')); q('[data-nodesval]').textContent = String(nodes);
      const rawTb = (keys * size * 1000) / 1e12; const totalTb = rawTb * n;
      const writes = ops * 0.2; const reads = ops * 0.8;
      const data: [string, string][] = [
        ['Data before replication', `${fmt(rawTb)} TB`],
        ['Data stored with all copies', `${fmt(totalTb)} TB`],
        ['Nodes needed for the storage', fmt(Math.ceil(totalTb / 4))],
        ['Nodes needed for the traffic', fmt(Math.ceil((reads + writes * n) / 20000))],
        ['Writes handled across nodes per second', fmt(writes * n)],
        ['Data on each node in this cluster', `${(totalTb / nodes).toFixed(1)} TB`],
        ['Keys that move when a node is added (ring)', `${fmt(keys / (nodes + 1))}`],
        ['Keys that move with hash modulo node count', `${fmt(keys * (nodes / (nodes + 1)))}`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
