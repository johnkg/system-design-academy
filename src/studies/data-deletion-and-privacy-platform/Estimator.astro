---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The request rate is small. What costs money is how many stores each request touches, and how much of the lake an erasure would have to rewrite.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Active accounts (millions) <input type="range" min="5" max="200" step="5" value="40" data-a /> <b data-aval></b></label>
      <label>Deletion requests per 10,000 accounts per month <input type="range" min="1" max="20" value="2" data-r /> <b data-rval></b></label>
      <label>Stores that hold a typical person <input type="range" min="10" max="150" step="5" value="60" data-s /> <b data-sval></b></label>
      <label>Spike on a news-story day (times the average) <input type="range" min="1" max="50" value="20" data-k /> <b data-kval></b></label>
      <label>Data lake size (TB) <input type="range" min="50" max="2000" step="50" value="600" data-t /> <b data-tval></b></label>
      <label>Backup retention (days) <input type="range" min="7" max="90" value="35" data-b /> <b data-bval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a month has 30 days, a task row takes about 200 bytes, a person's rows are spread over nearly every lake file so a rewrite batch touches all of them, rewrites run once a week, a per-user key takes 32 bytes, and a replay-list entry is a 16-byte salted hash. The legal deadline is 30 days.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 10 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const accounts = val('[data-a]') * 1e6; const per10k = val('[data-r]'); const stores = val('[data-s]'); const spike = val('[data-k]'); const tb = val('[data-t]'); const ret = val('[data-b]');
      ['a', 'r', 's', 'k', 't', 'b'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perMonth = (accounts * per10k) / 10000; const perDay = perMonth / 30; const peakDay = perDay * spike;
      const tasksDay = perDay * stores; const peakTasksSec = (peakDay * stores) / 86400;
      const open = perMonth * stores; const openMb = (open * 200) / 1e6;
      const rewriteGbs = (tb * 1000) / (7 * 86400); const keysGb = (accounts * 32) / 1e9;
      const replay = perDay * ret; const replayKb = (replay * 16) / 1000;
      const data: [string, string][] = [
        ['Requests per day on average', fmt(perDay)],
        ['Requests on a spike day', fmt(peakDay)],
        ['Tasks created per day on average', fmt(tasksDay)],
        ['Tasks per second on a spike day, over 24 hours', fmt(peakTasksSec)],
        ['Tasks open at once in a 30-day window', fmt(open)],
        ['Task table size', `${fmt(openMb)} MB`],
        ['Lake read and write rate to rewrite every file each week', `${fmt(rewriteGbs)} GB/s`],
        ['Per-user key store for all accounts', `${fmt(keysGb)} GB`],
        ['People on the replay-deletion list', fmt(replay)],
        ['Replay list size, and days until backups forget a person', `${fmt(replayKb)} KB, ${ret} days${ret > 30 ? ' (past the 30-day deadline)' : ''}`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
