---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The request rate is small. What costs money is how many stores each request touches, and how much of the lake an erasure would have to rewrite.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Active accounts (millions)" name="a" min="5" max="200" step="5" value="40" />
      <RangeField label="Deletion requests per 10,000 accounts per month" name="r" min="1" max="20" value="2" />
      <RangeField label="Stores that hold a typical person" name="s" min="10" max="150" step="5" value="60" />
      <RangeField label="Spike on a news-story day (times the average)" name="k" min="1" max="50" value="20" />
      <RangeField label="Data lake size (TB)" name="t" min="50" max="2000" step="50" value="600" />
      <RangeField label="Backup retention (days)" name="b" min="7" max="90" value="35" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a month has 30 days, a task row takes about 200 bytes, a person's rows are spread over nearly every lake file so a rewrite batch touches all of them, rewrites run once a week, a per-user key takes 32 bytes, and a replay-list entry is a 16-byte salted hash. The legal deadline is 30 days.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 10; // output lines below
    const MILLION = 1e6; const MB = 1e6; const GB = 1e9; const GB_PER_TB = 1000; const BYTES_PER_KB = 1000; const DAY_S = 86400;
    const PER = 10000; // the request-rate slider counts requests per 10,000 accounts per month
    const DAYS_PER_MONTH = 30; const DEADLINE_DAYS = 30; // legal deadline to finish a deletion
    const TASK_BYTES = 200; const KEY_BYTES = 32; const REPLAY_ENTRY_BYTES = 16; // one task row; one per-user key; one replay-list entry
    const REWRITE_DAYS = 7; // every lake file is rewritten once a week
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const accounts = val('[data-a]') * MILLION; const per10k = val('[data-r]'); const stores = val('[data-s]'); const spike = val('[data-k]'); const tb = val('[data-t]'); const ret = val('[data-b]');
      ['a', 'r', 's', 'k', 't', 'b'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perMonth = (accounts * per10k) / PER; const perDay = perMonth / DAYS_PER_MONTH; const peakDay = perDay * spike;
      const tasksDay = perDay * stores; const peakTasksSec = (peakDay * stores) / DAY_S;
      const open = perMonth * stores; const openMb = (open * TASK_BYTES) / MB;
      const rewriteGbs = (tb * GB_PER_TB) / (REWRITE_DAYS * DAY_S); const keysGb = (accounts * KEY_BYTES) / GB;
      const replay = perDay * ret; const replayKb = (replay * REPLAY_ENTRY_BYTES) / BYTES_PER_KB;
      const data: [string, string][] = [
        ['Requests per day on average', fmt(perDay)],
        ['Requests on a spike day', fmt(peakDay)],
        ['Tasks created per day on average', fmt(tasksDay)],
        ['Tasks per second on a spike day, over 24 hours', fmt(peakTasksSec)],
        [`Tasks open at once in a ${DEADLINE_DAYS}-day window`, fmt(open)],
        ['Task table size', `${fmt(openMb)} MB`],
        ['Lake read and write rate to rewrite every file each week', `${fmt(rewriteGbs)} GB/s`],
        ['Per-user key store for all accounts', `${fmt(keysGb)} GB`],
        ['People on the replay-deletion list', fmt(replay)],
        ['Replay list size, and days until backups forget a person', `${fmt(replayKb)} KB, ${ret} days${ret > DEADLINE_DAYS ? ` (past the ${DEADLINE_DAYS}-day deadline)` : ''}`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
