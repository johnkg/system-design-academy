---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Does the person really disappear?" hint="200 people ask to be deleted from 12 stores, 22 of them under a legal hold. Change one design choice at a time and watch what is left behind after 30 days.">
  <ol class="how">
    <li>The <b>default</b> is the manual-script design: a map that misses 2 stores, nothing done for the lake, one try per task, a plain restore and no hold check. <b>0 of 178 requests</b> finish, <b>1,340 records</b> are left, <b>22 held people</b> are erased and <b>187 deleted people</b> come back after a restore.</li>
    <li>Make the data map <b>complete</b> and use <b>crypto-shredding</b> and <b>retries</b> and the leftovers fall to 0, and all 178 requests finish. A single store that is not on the map, or a task that is tried once, is enough to fail a request.</li>
    <li>The <b>replay list</b> and the <b>hold check</b> fix different failures. Without the replay list every restore brings back the deleted users; without the hold check the held people are erased.</li>
  </ol>
  <div class="pg dpb" data-dpb>
    <div class="pg-row">
      <label>Data map <select class="pg-in" data-map><option value="incomplete" selected>misses 2 stores (a search index and a database)</option><option value="complete">complete</option></select></label>
      <label>Data lake <select class="pg-in" data-lake><option value="none" selected>nothing is done</option><option value="rewrite">rewrite files every week</option><option value="shred">destroy the per-user key</option></select></label>
      <label>Failed tasks <select class="pg-in" data-retry><option value="once" selected>tried once</option><option value="retry">retried daily for 28 days</option></select></label>
      <label>Restore on day 20 <select class="pg-in" data-replay><option value="plain" selected>plain restore of the day 0 backup</option><option value="replay">restore plus replay-deletion list</option></select></label>
      <label>Legal holds <select class="pg-in" data-check><option value="ignore" selected>not checked</option><option value="check">checked before every hard delete</option></select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Requests finished</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Records still readable on day 30</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Held people erased</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Deleted people back after the restore</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
      <div class="pg-box" data-b5><h3>Work on the data lake</h3><span class="pg-mono" data-o5></span><span class="pg-note" data-n5></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 12 stores, 1 to 3 records per person in each. 10% of people are under a hold. A store task fails 5% of the time per attempt, and the email vendor 35%. The hard delete starts on day 2 after a 2-day grace period. A file rewrite is assumed to finish within the 30 days. The restore uses the day 0 backup, and a person counts as back if the main database had already erased them by day 20. The lake rewrite figure assumes 600 TB read and written each week for 4 weeks.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-dpb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const N = 200; const S = 12; const LAKE = 10; const CRM = 11; const GRACE = 2; const DAYS = 28;
    const SEED = 77;
    const HOLD_RATE = 0.1; // users under a legal hold
    const UNMAPPED = [4, 9]; // systems missing from an incomplete data map
    const FAIL_RATE = { crm: 0.35, other: 0.05 }; // chance a deletion call fails on a given day
    const ROWS_SPREAD = 3; // a user has 1..3 rows in each system
    const BACKUP_DAYS = 20; // backups from the last 20 days can be restored, bringing deleted rows back
    // linear congruential generator (Numerical Recipes constants)
    let seed = SEED; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
    const held: boolean[] = []; const draws: number[][][] = [];
    for (let u = 0; u < N; u++) { held.push(rnd() < HOLD_RATE); draws.push(Array.from({ length: S }, () => Array.from({ length: DAYS }, rnd))); }
    const fmt = (n: number) => n.toLocaleString('en-US');
    function run(map: string, lake: string, retry: boolean, replay: boolean, check: boolean) {
      const missing: number[] = map === 'complete' ? [] : UNMAPPED;
      let done = 0; let nonheld = 0; let left = 0; let wrong = 0; let back = 0; let blocked = 0;
      for (let u = 0; u < N; u++) {
        const h = held[u];
        if (h && check) { blocked++; continue; }
        if (h) wrong++; else nonheld++;
        let l = 0; let dbDay = -1;
        for (let s = 0; s < S; s++) {
          const rowsN = 1 + ((u + s) % ROWS_SPREAD);
          if (missing.includes(s)) { l += rowsN; continue; }
          if (s === LAKE) { if (lake === 'none') l += rowsN; continue; }
          const p = s === CRM ? FAIL_RATE.crm : FAIL_RATE.other; let ok = -1;
          for (let d = 0; d < (retry ? DAYS : 1); d++) if (draws[u][s][d] >= p) { ok = GRACE + d; break; }
          if (ok < 0) l += rowsN; else if (s === 0) dbDay = ok;
        }
        if (!h) { left += l; if (l === 0) done++; }
        if (dbDay >= 0 && dbDay <= BACKUP_DAYS && !replay) back++;
      }
      return { done, nonheld, left, wrong, back, blocked };
    }
    function draw() {
      const map = q<HTMLSelectElement>('[data-map]').value; const lake = q<HTMLSelectElement>('[data-lake]').value;
      const retry = q<HTMLSelectElement>('[data-retry]').value === 'retry'; const replay = q<HTMLSelectElement>('[data-replay]').value === 'replay'; const check = q<HTMLSelectElement>('[data-check]').value === 'check';
      const r = run(map, lake, retry, replay, check);
      const set = (id: string, text: string, note: string, ok: boolean) => { q(`[data-o${id}]`).textContent = text; q(`[data-n${id}]`).textContent = note; q<HTMLElement>(`[data-b${id}]`).style.setProperty('--c', ok ? 'var(--good)' : 'var(--bad)'); };
      set('1', `${r.done} of ${r.nonheld}`, `people with no hold; ${r.blocked} held requests were paused on purpose`, r.done === r.nonheld);
      set('2', fmt(r.left), r.left === 0 ? 'nothing left in any store' : 'in stores that were skipped, failed or never touched', r.left === 0);
      set('3', String(r.wrong), r.wrong === 0 ? (r.blocked ? `${r.blocked} held people kept, as the law requires` : 'no one was held') : 'data that a court order said to keep is gone', r.wrong === 0);
      set('4', String(r.back), replay ? 'the replay list removed them after restoring' : 'a restore without the list brings them back', r.back === 0);
      q('[data-o5]').textContent = lake === 'rewrite' ? '2,400 TB' : lake === 'shred' ? `${r.nonheld + r.wrong} keys` : '0';
      q('[data-n5]').textContent = lake === 'rewrite' ? '600 TB read and written each week, for 4 weeks' : lake === 'shred' ? 'deleted, and no file rewritten' : 'the lake rows stay readable';
      q<HTMLElement>('[data-b5]').style.setProperty('--c', lake === 'rewrite' ? 'var(--bad)' : lake === 'shred' ? 'var(--good)' : 'var(--accent)');
      const bad = r.done < r.nonheld || r.wrong > 0 || r.back > 0 || r.left > 0;
      const out = q('[data-verdict]'); out.classList.toggle('bad', bad);
      const faults: string[] = [];
      if (r.left > 0) faults.push(`${fmt(r.left)} records are still readable (${[map !== 'complete' ? 'unmapped stores' : '', lake === 'none' ? 'the lake was ignored' : '', !retry ? 'failed tasks were not retried' : ''].filter(Boolean).join(', ')})`);
      if (r.wrong > 0) faults.push(`${r.wrong} people under a hold were erased`);
      if (r.back > 0) faults.push(`${r.back} deleted people came back in the restore`);
      out.textContent = bad ? `Not compliant: ${faults.join('; ')}.` : `Compliant: all ${r.done} requests finished, ${r.blocked} held people were kept, and nobody came back after the restore.${lake === 'rewrite' ? ' The lake rewrite works too, but it moves 2,400 TB; destroying a key moves none.' : ''}`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
