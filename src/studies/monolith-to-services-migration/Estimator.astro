---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Extracting one service costs a copy of its data, a stream of changes while both sides run, and a second copy of the traffic while you compare. Size those before promising a date.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Peak requests per second on the monolith" name="rps" min="100" max="20000" step="100" value="2000" />
      <RangeField label="Share of requests that belong to the extracted service (%)" name="sh" min="1" max="60" value="15" />
      <RangeField label="Share of those that are writes (%)" name="w" min="5" max="80" step="5" value="30" />
      <RangeField label="Share of reads mirrored to the new service as shadow traffic (%)" name="sd" min="0" max="100" step="10" value="100" />
      <RangeField label="Rows in the tables that move (millions)" name="rows" min="1" max="500" value="50" />
      <RangeField label="Average row size (bytes)" name="by" min="100" max="4000" step="100" value="500" />
      <RangeField label="Backfill speed (rows per second)" name="bf" min="500" max="20000" step="500" value="5000" />
      <RangeField label="Days both sides run in parallel" name="d" min="1" max="90" value="30" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: one instance of the new service handles 200 requests per second and is kept at most 50% busy. Every write produces one change event, and an event is about 1 KB. The backfill runs while live writes continue, so the changes made during it are replayed afterwards at the same speed as the backfill. Storage is before replication.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatWholeNumber } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const MILLION = 1e6, GB = 1e9, HOUR_S = 3600, DAY_S = 86400, PCT = 100;
    const PER_INSTANCE = 200, TARGET_BUSY = 0.5; // requests per second per instance, and how busy it may be
    const EVENT_BYTES = 1000;
    const N_ROWS = 10;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const one = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const rps = val('[data-rps]'), sh = val('[data-sh]') / PCT, w = val('[data-w]') / PCT, sd = val('[data-sd]') / PCT;
      const n = val('[data-rows]') * MILLION, by = val('[data-by]'), bf = val('[data-bf]'), d = val('[data-d]');
      ['rps', 'sh', 'w', 'sd', 'rows', 'by', 'bf', 'd'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const own = rps * sh; // requests a second that belong to the new service
      const writes = own * w, reads = own - writes;
      const shadow = reads * sd;
      const backfillS = n / bf;
      const duringBackfill = writes * backfillS; // change events produced while the backfill runs
      const replayS = duringBackfill / bf;
      const instances = (rate: number) => Math.ceil(rate / (PER_INSTANCE * TARGET_BUSY));
      const data: [string, string][] = [
        ['Requests per second that belong to the new service', formatWholeNumber(own)],
        ['Writes per second among them', formatWholeNumber(writes)],
        ['Extra shadow reads per second on the new service', formatWholeNumber(shadow)],
        ['Instances needed while shadowing, with the live share at 10%', formatWholeNumber(instances(own * 0.1 + shadow))],
        ['Instances needed at 100% of its traffic', formatWholeNumber(instances(own))],
        ['Data to copy', `${one((n * by) / GB)} GB`],
        ['Backfill time', `${one(backfillS / HOUR_S)} hours`],
        ['Change events produced during the backfill', formatWholeNumber(duringBackfill)],
        ['Time to replay them afterwards', `${one(replayS / HOUR_S)} hours`],
        ['Change events over the parallel run, per day and in total', `${formatWholeNumber((writes * DAY_S * EVENT_BYTES) / GB)} GB a day, ${formatWholeNumber((writes * DAY_S * d * EVENT_BYTES) / GB)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
