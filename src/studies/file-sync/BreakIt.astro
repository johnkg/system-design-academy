---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="What gets uploaded after an edit" hint="A 400 KB file is cut into chunks and then edited. See how many bytes each approach has to send again. Chunk sizes are scaled down to suit a small demo file.">
  <ol class="how">
    <li>Choose <b>change one byte in the middle</b>: whole-file upload sends everything, and both chunking methods send one chunk.</li>
    <li>Choose <b>insert 10 bytes at the start</b>: fixed chunks all shift, so nearly <b>everything is sent again</b>, while content-defined chunks send only a chunk or two.</li>
    <li>Try a smaller chunk size: less is re-sent, but there are <b>more chunks</b> to hash, list and store, which is the cost.</li>
  </ol>
  <div class="pg fsb" data-fsb>
    <div class="pg-row">
      <label>The edit <select class="pg-in" data-edit>
        <option value="byte">Change one byte in the middle</option>
        <option value="insert" selected>Insert 10 bytes at the start</option>
        <option value="append">Append 1,000 bytes at the end</option>
        <option value="delete">Delete 100 bytes in the middle</option>
      </select></label>
      <label>Average chunk size <select class="pg-in" data-size>
        <option value="11">2 KB</option>
        <option value="12" selected>4 KB</option>
        <option value="13">8 KB</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Whole file</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Fixed-size chunks</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Content-defined chunks</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: the file is 400,000 random bytes. Fixed chunks have exactly the chosen size. Content-defined chunks end where a rolling hash of the last few dozen bytes matches a pattern, at least a quarter and at most four times the average. A chunk is re-sent when no chunk with identical bytes existed in the old version.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-fsb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    let seed = 7; const next = () => (seed = (seed * 1664525 + 1013904223) % 4294967296);
    const GEAR = Array.from({ length: 256 }, () => next());
    const original = Uint8Array.from({ length: 400000 }, () => (next() >>> 16) & 255);
    const extra = Uint8Array.from({ length: 1000 }, () => (next() >>> 16) & 255);
    const cat = (...parts: Uint8Array[]) => { const o = new Uint8Array(parts.reduce((s, p) => s + p.length, 0)); let at = 0; parts.forEach((p) => { o.set(p, at); at += p.length; }); return o; };
    const mid = 200000;
    const edits: Record<string, Uint8Array> = {
      byte: (() => { const e = original.slice(); e[mid] ^= 0xff; return e; })(),
      insert: cat(extra.slice(0, 10), original),
      append: cat(original, extra),
      delete: cat(original.slice(0, mid), original.slice(mid + 100)),
    };
    const hashOf = (c: Uint8Array) => { let h = 2166136261; for (let i = 0; i < c.length; i++) { h ^= c[i]; h = Math.imul(h, 16777619) >>> 0; } return `${h}:${c.length}`; };
    function fixed(d: Uint8Array, size: number) { const out: Uint8Array[] = []; for (let i = 0; i < d.length; i += size) out.push(d.subarray(i, i + size)); return out; }
    function content(d: Uint8Array, bits: number) {
      const avg = 1 << bits; const min = avg / 4; const max = avg * 4; const mask = (((1 << bits) - 1) << (32 - bits)) >>> 0;
      const out: Uint8Array[] = []; let start = 0; let h = 0;
      for (let i = 0; i < d.length; i++) {
        h = ((h << 1) + GEAR[d[i]]) >>> 0; const size = i - start + 1;
        if ((size >= min && (h & mask) === 0) || size >= max) { out.push(d.subarray(start, i + 1)); start = i + 1; h = 0; }
      }
      if (start < d.length) out.push(d.subarray(start));
      return out;
    }
    function resend(oldC: Uint8Array[], newC: Uint8Array[]) {
      const known = new Set(oldC.map(hashOf)); let bytes = 0; let changed = 0;
      newC.forEach((c) => { if (!known.has(hashOf(c))) { bytes += c.length; changed++; } });
      return { bytes, changed, total: newC.length };
    }
    function draw() {
      const edit = edits[q<HTMLSelectElement>('[data-edit]').value]; const bits = Number(q<HTMLSelectElement>('[data-size]').value);
      const f = resend(fixed(original, 1 << bits), fixed(edit, 1 << bits)); const c = resend(content(original, bits), content(edit, bits));
      const kb = (b: number) => `${(b / 1000).toFixed(1)} KB`; const pct = (b: number) => `${((b / edit.length) * 100).toFixed(1)}% of the file`;
      q('[data-o1]').textContent = kb(edit.length); q('[data-n1]').textContent = '100% of the file, always';
      q('[data-o2]').textContent = kb(f.bytes); q('[data-n2]').textContent = `${f.changed} of ${f.total} chunks · ${pct(f.bytes)}`;
      q('[data-o3]').textContent = kb(c.bytes); q('[data-n3]').textContent = `${c.changed} of ${c.total} chunks · ${pct(c.bytes)}`;
      q<HTMLElement>('[data-b1]').style.setProperty('--c', 'var(--bad)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', f.bytes / edit.length > 0.5 ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', c.bytes / edit.length > 0.5 ? 'var(--bad)' : 'var(--good)');
      const out = q('[data-verdict]'); const bad = f.bytes / edit.length > 0.5; out.classList.toggle('bad', bad);
      out.textContent = bad ? `The edit moved every later byte, so every fixed chunk changed and ${pct(f.bytes)} had to be uploaded again. Content-defined chunks found the old boundaries again after the edit and sent only ${pct(c.bytes)}.`
        : `Both chunking methods send a small part of the file (${pct(f.bytes)} and ${pct(c.bytes)}) instead of all ${kb(edit.length)}. Try inserting at the start to see where fixed chunks fail.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
