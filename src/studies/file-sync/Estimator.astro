---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="See why sending only changed chunks and storing duplicates once matter at this scale.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Registered users (millions) <input type="range" min="1" max="1000" value="300" data-users /> <b data-usersval></b></label>
      <label>Stored per user (GB) <input type="range" min="1" max="50" value="5" data-gb /> <b data-gbval></b></label>
      <label>Share of data that is duplicate (%) <input type="range" min="0" max="60" step="5" value="30" data-dup /> <b data-dupval></b></label>
      <label>Files changed per active user per day <input type="range" min="1" max="100" value="20" data-chg /> <b data-chgval></b></label>
      <label>Share of a file that changes in an edit (%) <input type="range" min="1" max="100" value="5" data-part /> <b data-partval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 20% of registered users are active each day, the average file is 2 MB, every chunk is kept in 1.5 times its size for durability (erasure coding), and one change notification connection is open per active device, with 2 devices per user.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 8; // output lines below
    const MILLION = 1e6; const GB_PER_PB = 1e6; const MB_PER_TB = 1e6;
    const ACTIVE_SHARE = 0.2; // users active on a given day
    const DURABILITY = 1.5; // stored bytes per logical byte (erasure coding)
    const FILE_MB = 2; // average size of a changed file
    const DEVICES = 2; // devices per active user holding a notification connection
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const users = val('[data-users]') * MILLION; const gb = val('[data-gb]'); const dup = val('[data-dup]') / 100; const chg = val('[data-chg]'); const part = val('[data-part]') / 100;
      q('[data-usersval]').textContent = String(val('[data-users]')); q('[data-gbval]').textContent = String(gb); q('[data-dupval]').textContent = String(Math.round(dup * 100));
      q('[data-chgval]').textContent = String(chg); q('[data-partval]').textContent = String(Math.round(part * 100));
      const active = users * ACTIVE_SHARE; const logicalPb = (users * gb) / GB_PER_PB; const storedPb = logicalPb * (1 - dup) * DURABILITY;
      const wholeTb = (active * chg * FILE_MB) / MB_PER_TB; const chunkTb = wholeTb * part;
      const data: [string, string][] = [
        ['Data users think they have', `${fmt(logicalPb)} PB`],
        ['Data actually stored after dedupe and durability', `${fmt(storedPb)} PB`],
        ['Saved by storing duplicates once', `${fmt(logicalPb * DURABILITY - storedPb)} PB`],
        ['Upload per day, whole files re-sent', `${fmt(wholeTb)} TB`],
        ['Upload per day, changed chunks only', `${fmt(chunkTb)} TB`],
        ['Bandwidth saved by chunking', `${fmt((1 - part) * 100)}%`],
        ['Files changed per day', `${fmt((active * chg) / MILLION)} million`],
        ['Open notification connections', `${fmt((active * DEVICES) / MILLION)} million`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
