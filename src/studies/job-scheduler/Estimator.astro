---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Many jobs are scheduled for round times such as the top of the minute, so the peak is what matters.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Jobs per day (millions) <input type="range" min="1" max="500" value="50" data-jobs /> <b data-jobsval></b></label>
      <label>Average run time (seconds) <input type="range" min="1" max="300" value="20" data-run /> <b data-runval></b></label>
      <label>Share scheduled on the exact minute (%) <input type="range" min="0" max="80" step="5" value="40" data-share /> <b data-shareval></b></label>
      <label>Workers <input type="range" min="10" max="20000" step="10" value="1000" data-w /> <b data-wval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the rest of the jobs are spread evenly over the day, a worker runs one job at a time, a run record takes about 300 bytes, and run records are kept for 30 days.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const jobs = val('[data-jobs]') * 1e6; const run = val('[data-run]'); const share = val('[data-share]') / 100; const w = val('[data-w]');
      ['jobs', 'run', 'share', 'w'].forEach((k) => (q(`[data-${k}val]`).textContent = String(k === 'share' ? Math.round(val('[data-share]')) : val(`[data-${k}]`))));
      const perSec = jobs / 86400; const burst = (jobs * share) / 1440; const drain = (burst * run) / w;
      const data: [string, string][] = [
        ['Average jobs per second', fmt(perSec)],
        ['Workers busy on average', fmt(perSec * run)],
        ['Jobs due at the top of one minute', fmt(burst)],
        ['Time to clear that burst with these workers', `${drain < 1 ? '< 1' : fmt(drain)} seconds`],
        ['Workers to clear the burst within 10 seconds', fmt((burst * run) / 10)],
        ['Runs recorded per day', `${fmt(jobs / 1e6)} million`],
        ['Run records kept (30 days)', `${((jobs * 300 * 30) / 1e12).toFixed(2)} TB`],
        ['Average delay from polling once a second', '0.5 seconds'],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
