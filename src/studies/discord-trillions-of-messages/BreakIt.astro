---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="One announcement, one hot partition" hint="Thousands of readers open the same channel for 20 seconds. Change how the data services treat their requests and watch how many reads reach the one database partition that holds the channel's newest messages. A simple model with round numbers, not Discord's measurements.">
  <ol class="how">
    <li>Press <b>Reset</b>. With <b>Coalescing</b> off, every reader's request becomes a database read: <b>5,000</b> reads per second hit a partition that can serve 500, which is <b>1,000%</b> of its capacity, and after 20 seconds a read waits <b>180.0 s</b>.</li>
    <li>Set <b>Coalescing</b> to <b>On</b> (6 service instances, <b>Routing</b> still on any instance): each instance runs one read at a time and everyone else joins it, so reads fall to <b>300</b> per second, <b>60%</b> of capacity, and the wait is <b>0.0 s</b>.</li>
    <li>Set <b>Service instances</b> to <b>12</b>: every instance now reads the row on its own, reads rise to <b>600</b> per second, <b>120%</b>, and the wait grows to <b>4.0 s</b>.</li>
    <li>Set <b>Routing</b> to <b>By channel ID</b>: one instance sees every request for the channel, so reads drop to <b>50</b> per second, <b>10%</b>, and the wait is back to <b>0.0 s</b>.</li>
  </ol>
  <div class="pg dsc" data-dsc>
    <div class="pg-row">
      <label>Coalescing <select class="pg-in" data-mode><option value="off">Off</option><option value="on">On</option></select></label>
      <label>Routing <select class="pg-in" data-route><option value="any">Any instance</option><option value="channel">By channel ID</option></select></label>
      <RangeField label="Service instances" name="n" min="1" max="12" value="6" />
      <RangeField label="Readers per second" name="r" min="500" max="20000" step="500" value="5000" />
      <RangeField label="Partition capacity (reads per second)" name="c" min="100" max="2000" step="100" value="500" />
      <RangeField label="One database read takes (ms)" name="t" min="5" max="100" step="5" value="20" />
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Reads reaching the database</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Hot partition load</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Wait for a read after 20 s</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Instances reading the row</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="dsc-strip-wrap">
      <p class="pg-note dsc-cap">Each second of the announcement, how long a new read waits in line:</p>
      <ol class="dsc-strip" data-strip></ol>
      <p class="pg-note">ok = the wait is 0.1 s or less, late = longer than that (a queue has built up).</p>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: for 20 seconds, the chosen number of readers per second each ask for the newest messages of one channel, and all of those reads go to one partition that can serve the capacity you set. Without coalescing every request is a database read. With coalescing, an instance runs one read for the row at a time and starts the next when the last ends, so it starts at most 1,000 divided by the read time reads per second, and everyone else joins. With routing by channel ID one instance gets every request; otherwise requests spread evenly over all the instances. Reads beyond the capacity queue up and the queue keeps growing for as long as they arrive faster than they are served, which is the cascading latency Discord described. Real databases are more complicated than this.</p>
  </div>
</PlaygroundShell>
<style>
  .dsc-strip-wrap { display: grid; gap: 6px; }
  .dsc-cap { margin: 0; }
  .dsc-strip { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 3px; }
  .dsc-strip li { min-width: 2.6rem; height: 1.8rem; padding: 0 4px; display: grid; place-items: center; border-radius: 5px; font: 600 .75rem var(--font-mono); border: 1px solid var(--border); background: var(--surface); color: var(--text); }
  .dsc-strip li[data-k='ok'] { background: color-mix(in srgb, var(--good) 22%, var(--surface)); }
  .dsc-strip li[data-k='late'] { background: color-mix(in srgb, var(--bad) 16%, var(--surface)); color: var(--bad-text); border-style: dashed; }
</style>
<script>
  import { query, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-dsc]').forEach((root) => {
    const q = query(root);
    const SECONDS = 20; // length of the announcement spike
    const OK_WAIT_S = 0.1; // a wait at or under this counts as fine
    const MS_PER_S = 1000;
    const DEFAULTS: Record<string, string> = { mode: 'off', route: 'any', n: '6', r: '5000', c: '500', t: '20' };
    const strip = q('[data-strip]');
    const cells = Array.from({ length: SECONDS }, () => { const li = document.createElement('li'); strip.append(li); return li; });
    const input = (k: string) => q<HTMLInputElement>(`[data-${k}]`);

    function draw() {
      const coalesce = q<HTMLSelectElement>('[data-mode]').value === 'on';
      const byChannel = q<HTMLSelectElement>('[data-route]').value === 'channel';
      const instances = Number(input('n').value); const readers = Number(input('r').value);
      const cap = Number(input('c').value); const readMs = Number(input('t').value);
      q('[data-nval]').textContent = String(instances); q('[data-rval]').textContent = fmt(readers);
      q('[data-cval]').textContent = fmt(cap); q('[data-tval]').textContent = String(readMs);
      const active = byChannel ? 1 : instances; // instances that receive requests for this channel
      const perInstance = readers / active;
      const reads = coalesce ? active * Math.min(perInstance, MS_PER_S / readMs) : readers;
      const load = (100 * reads) / cap;
      let backlog = 0; const waits: number[] = [];
      for (let s = 0; s < SECONDS; s++) { backlog = Math.max(0, backlog + reads - cap); waits.push(backlog / cap); }
      const wait = waits[SECONDS - 1];
      const late = waits.filter((w) => w > OK_WAIT_S).length;
      const joined = 100 * (1 - reads / readers);
      q('[data-o1]').textContent = `${fmt(reads)} per second`;
      q('[data-n1]').textContent = coalesce ? `${fmt(readers)} requests per second, ${fmt(joined)}% of them join a read already running` : `${fmt(readers)} requests per second, each one its own read`;
      q('[data-o2]').textContent = `${fmt(load)}% of capacity`;
      q('[data-n2]').textContent = load > 100 ? `${fmt(reads - cap)} more reads per second than the partition can serve, so a queue grows` : `${fmt(cap - reads)} reads per second to spare`;
      q('[data-o3]').textContent = `${wait.toFixed(1)} s`;
      q('[data-n3]').textContent = late ? `${late} of the ${SECONDS} seconds ended with a queue` : 'no queue built up during the spike';
      q('[data-o4]').textContent = coalesce ? `${active} of ${instances}` : `${instances} (no sharing)`;
      q('[data-n4]').textContent = byChannel ? 'routing by channel ID sends every request for the channel to one instance' : 'requests spread over every instance, and each one reads the row for itself';
      const states = ['b1', 'b2', 'b3', 'b4'];
      const bad = [false, load > 100, late > 0, false];
      states.forEach((b, i) => q<HTMLElement>(`[data-${b}]`).style.setProperty('--c', bad[i] ? 'var(--bad)' : 'var(--good)'));
      waits.forEach((w, i) => { cells[i].textContent = w > OK_WAIT_S ? 'late' : 'ok'; cells[i].dataset.k = w > OK_WAIT_S ? 'late' : 'ok'; });
      strip.setAttribute('aria-label', `${late} of ${SECONDS} seconds ended with a queue of reads`);
      const out = q('[data-verdict]'); out.classList.toggle('bad', load > 100);
      if (load > 100) out.textContent = `The partition is at ${fmt(load)}% of its capacity, so a read that arrives after ${SECONDS} s waits ${wait.toFixed(1)} s. ${coalesce ? (byChannel ? 'Even one read at a time per row is too much for this capacity.' : 'Route by channel ID so one instance, not all of them, reads the row.') : 'Turn coalescing on so readers share a read instead of each starting their own.'}`;
      else out.textContent = `The partition is at ${fmt(load)}% of its capacity and no queue builds up: ${fmt(readers)} requests per second turn into ${fmt(reads)} reads per second.`;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    q('[data-reset]').addEventListener('click', () => {
      q<HTMLSelectElement>('[data-mode]').value = DEFAULTS.mode; q<HTMLSelectElement>('[data-route]').value = DEFAULTS.route;
      ['n', 'r', 'c', 't'].forEach((k) => (input(k).value = DEFAULTS[k]));
      draw();
    });
    draw();
  });
</script>
