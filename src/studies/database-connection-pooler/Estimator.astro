---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Connections multiply (instances times pool), but the work the database can do at once does not. Little's law tells you how many server connections you really need.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>App instances <input type="range" min="10" max="2000" step="10" value="300" data-i /> <b data-ival></b></label>
      <label>Pool size inside each instance <input type="range" min="2" max="50" value="20" data-pp /> <b data-ppval></b></label>
      <label>Database max_connections <input type="range" min="100" max="2000" step="50" value="500" data-mc /> <b data-mcval></b></label>
      <label>Queries per second at the peak <input type="range" min="500" max="50000" step="500" value="6000" data-qps /> <b data-qpsval></b></label>
      <label>Average query time (ms) <input type="range" min="1" max="50" value="4" data-ms /> <b data-msval></b></label>
      <label>Database CPU cores <input type="range" min="4" max="64" step="4" value="16" data-cores /> <b data-coresval></b></label>
      <label>Effective disks (spindles) <input type="range" min="1" max="16" value="4" data-disks /> <b data-disksval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a PostgreSQL connection is a process that uses about 10 MB, a pooler keeps about 4 KB per client connection, and a good starting server pool is cores times 2 plus the number of effective disks (the rule of thumb from the HikariCP pool-sizing guide), to be tuned by measuring. Average busy connections come from Little's law: queries per second times the time each takes. Real traffic is bursty, so keep the average below about 70% of the pool.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmt1 = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const keys = ['i', 'pp', 'mc', 'qps', 'ms', 'cores', 'disks'];
      keys.forEach((k) => (q(`[data-${k}val]`).textContent = fmt(val(`[data-${k}]`))));
      const inst = val('[data-i]'); const pp = val('[data-pp]'); const mc = val('[data-mc]'); const qps = val('[data-qps]'); const ms = val('[data-ms]'); const cores = val('[data-cores]'); const disks = val('[data-disks]');
      const wanted = inst * pp; const direct = wanted / mc; const memDirect = (wanted * 10) / 1000;
      const busy = (qps * ms) / 1000; const pool = cores * 2 + disks; const util = (busy / pool) * 100; const cap = (pool * 1000) / ms;
      const memPool = (pool * 10) / 1000 + (wanted * 4) / 1e6;
      const data: [string, string][] = [
        ['Connections the apps open (instances times pool)', fmt(wanted)],
        ['Direct to the database against max_connections', direct > 1 ? `${fmt(wanted)} wanted, ${fmt(mc)} allowed: ${fmt1(direct)}x over` : `${fmt(wanted)} of ${fmt(mc)} used (${fmt(direct * 100)}%)`],
        ['Memory those direct connections would take', `${fmt1(memDirect)} GB`],
        ['Queries running at once on average (Little\'s law)', fmt1(busy)],
        ['Suggested server pool (cores x 2 + disks)', fmt(pool)],
        ['Average load on that pool', `${fmt(util)}%${util > 70 ? ' (above 70%: bursts will queue)' : ''}`],
        ['Most queries per second the pool can run', fmt(cap)],
        ['Client connections per server connection', `${fmt(wanted / pool)} to 1`],
        ['Memory with a pooler (server pool plus client connections)', `${fmt1(memPool)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
