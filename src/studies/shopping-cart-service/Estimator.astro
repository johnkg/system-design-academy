---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Cart traffic is modest per cart but large in total, and every write goes to several replicas. Merge work depends on how often the copies diverge.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Active carts per day (millions) <input type="range" min="1" max="200" value="30" data-a /> <b data-aval></b></label>
      <label>Changes per active cart per day <input type="range" min="1" max="30" value="8" data-c /> <b data-cval></b></label>
      <label>Peak is this many times the average <input type="range" min="1" max="10" value="5" data-pk /> <b data-pkval></b></label>
      <label>Cart views per change <input type="range" min="1" max="6" value="2" data-v /> <b data-vval></b></label>
      <label>Replicas per cart <input type="range" min="1" max="5" value="3" data-n /> <b data-nval></b></label>
      <label>Reads that find diverged copies (%) <input type="range" min="0" max="5" step="0.1" value="0.5" data-d /> <b data-dval></b></label>
      <label>New carts per day (millions) <input type="range" min="1" max="100" value="10" data-nw /> <b data-nwval></b></label>
      <label>Days until a cart expires <input type="range" min="1" max="90" value="30" data-life /> <b data-lifeval></b></label>
      <label>Items in a cart <input type="range" min="1" max="20" value="5" data-it /> <b data-itval></b></label>
      <label>Tombstones kept per cart <input type="range" min="0" max="10" value="2" data-tb /> <b data-tbval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: an item entry takes about 40 bytes (item id, add tag, quantity), a tombstone about 24 bytes, and a cart's key and version information about 64 bytes. A write goes to every replica. A read contacts a majority of the replicas. One node handles about 20,000 replica operations per second and holds about 500 GB. The cart count assumes every new cart lives until it expires.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 10 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const KEYS = ['a', 'c', 'pk', 'v', 'n', 'd', 'nw', 'life', 'it', 'tb'];
    function draw() {
      KEYS.forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const a = val('[data-a]') * 1e6; const c = val('[data-c]'); const pk = val('[data-pk]'); const v = val('[data-v]'); const n = val('[data-n]');
      const div = val('[data-d]') / 100; const carts = val('[data-nw]') * 1e6 * val('[data-life]'); const it = val('[data-it]'); const tb = val('[data-tb]');
      const avg = (a * c) / 86400; const peak = avg * pk; const repW = peak * n; const reads = peak * v; const quorum = Math.floor(n / 2) + 1; const repR = reads * quorum;
      const bytes = it * 40 + tb * 24 + 64; const gb = (carts * bytes * n) / 1e9;
      const byLoad = Math.ceil((repW + repR) / 20000); const byDisk = Math.ceil(gb / 500); const nodes = Math.max(byLoad, byDisk, n);
      const data: [string, string][] = [
        ['Cart changes per second, average', fmt(avg)],
        ['Cart changes per second at the peak', fmt(peak)],
        ['Replica writes per second at the peak', fmt(repW)],
        ['Cart reads per second at the peak', fmt(reads)],
        ['Replica reads per second at the peak (majority of replicas)', fmt(repR)],
        ['Reads per second that must merge diverged copies', fmt(reads * div)],
        ['Carts alive before they expire', `${fmt(carts / 1e6)} million`],
        ['Size of one cart with its bookkeeping', `${fmt(bytes)} bytes`],
        ['Storage for all replicas', `${fmt(gb)} GB`],
        ['Nodes to run (load, disk, and at least the replica count)', `${fmt(nodes)} (${fmt(byLoad)} for load, ${fmt(byDisk)} for disk)`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
