---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Cart traffic is modest per cart but large in total, and every write goes to several replicas. Merge work depends on how often the copies diverge.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Active carts per day (millions)" name="a" min="1" max="200" value="30" />
      <RangeField label="Changes per active cart per day" name="c" min="1" max="30" value="8" />
      <RangeField label="Peak is this many times the average" name="pk" min="1" max="10" value="5" />
      <RangeField label="Cart views per change" name="v" min="1" max="6" value="2" />
      <RangeField label="Replicas per cart" name="n" min="1" max="5" value="3" />
      <RangeField label="Reads that find diverged copies (%)" name="d" min="0" max="5" step="0.1" value="0.5" />
      <RangeField label="New carts per day (millions)" name="nw" min="1" max="100" value="10" />
      <RangeField label="Days until a cart expires" name="life" min="1" max="90" value="30" />
      <RangeField label="Items in a cart" name="it" min="1" max="20" value="5" />
      <RangeField label="Tombstones kept per cart" name="tb" min="0" max="10" value="2" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: an item entry takes about 40 bytes (item id, add tag, quantity), a tombstone about 24 bytes, and a cart's key and version information about 64 bytes. A write goes to every replica. A read contacts a majority of the replicas. One node handles about 20,000 replica operations per second and holds about 500 GB. The cart count assumes every new cart lives until it expires.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 10; // lines in the result list
    const MILLION = 1e6, DAY_S = 86400, GB = 1e9;
    const CART_BYTES = { item: 40, tombstone: 24, base: 64 }; // per item, per removed-item tombstone, fixed bookkeeping
    const NODE_OPS_S = 20000, NODE_DISK_GB = 500; // what one node handles
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const KEYS = ['a', 'c', 'pk', 'v', 'n', 'd', 'nw', 'life', 'it', 'tb'];
    function draw() {
      KEYS.forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const a = val('[data-a]') * MILLION; const c = val('[data-c]'); const pk = val('[data-pk]'); const v = val('[data-v]'); const n = val('[data-n]');
      const div = val('[data-d]') / 100; const carts = val('[data-nw]') * MILLION * val('[data-life]'); const it = val('[data-it]'); const tb = val('[data-tb]');
      const avg = (a * c) / DAY_S; const peak = avg * pk; const repW = peak * n; const reads = peak * v; const quorum = Math.floor(n / 2) + 1; const repR = reads * quorum;
      const bytes = it * CART_BYTES.item + tb * CART_BYTES.tombstone + CART_BYTES.base; const gb = (carts * bytes * n) / GB;
      const byLoad = Math.ceil((repW + repR) / NODE_OPS_S); const byDisk = Math.ceil(gb / NODE_DISK_GB); const nodes = Math.max(byLoad, byDisk, n);
      const data: [string, string][] = [
        ['Cart changes per second, average', fmt(avg)],
        ['Cart changes per second at the peak', fmt(peak)],
        ['Replica writes per second at the peak', fmt(repW)],
        ['Cart reads per second at the peak', fmt(reads)],
        ['Replica reads per second at the peak (majority of replicas)', fmt(repR)],
        ['Reads per second that must merge diverged copies', fmt(reads * div)],
        ['Carts alive before they expire', `${fmt(carts / MILLION)} million`],
        ['Size of one cart with its bookkeeping', `${fmt(bytes)} bytes`],
        ['Storage for all replicas', `${fmt(gb)} GB`],
        ['Nodes to run (load, disk, and at least the replica count)', `${fmt(nodes)} (${fmt(byLoad)} for load, ${fmt(byDisk)} for disk)`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
