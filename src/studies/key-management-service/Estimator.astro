---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Envelope encryption keeps bulk data away from the KMS, a cache cuts its load several times over, and the size of the stored data decides how long a rewrap takes.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Encrypted objects (billions)" name="o" min="1" max="100" value="20" />
      <RangeField label="Writes per second at the peak (thousands)" name="w" min="1" max="100" value="20" />
      <RangeField label="Reads per second at the peak (thousands)" name="r" min="1" max="500" value="100" />
      <RangeField label="Reads served by the data-key cache (%)" name="hit" min="0" max="99" value="95" />
      <RangeField label="Share of KMS capacity the rewrap may use (%)" name="share" min="5" max="50" value="20" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: an object is 4 KB, a wrapped data key with its header is about 100 bytes, one KMS node handles about 5,000 wrap or unwrap calls per second (policy check, audit write and the unwrap), the KMS runs two spare nodes, a write needs a new data key and so always calls the KMS, and a rewrap is one call per object. Throughput of an HSM is not the limit because the KMS caches unwrapped key-encryption keys.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 9; // output lines below
    const THOUSAND = 1000; const BILLION = 1e9; const MB = 1e6; const TB = 1e12; const DAY_S = 86400;
    const OBJECT_BYTES = 4096; // average object, all sent to the KMS in the direct design
    const KEY_CALL_BYTES = 100; // one wrapped data key per call, also stored per object
    const NODE_CALLS = 5000; const SPARE_NODES = 2; // calls per second one KMS node handles; spares
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmtN = (n: number, unit: string) => `${n >= 10 ? fmt(n) : n.toFixed(1)} ${unit}`;
    function draw() {
      const objects = val('[data-o]') * BILLION; const writes = val('[data-w]') * THOUSAND; const reads = val('[data-r]') * THOUSAND; const hit = val('[data-hit]') / 100; const share = val('[data-share]') / 100;
      ['o', 'w', 'r', 'hit', 'share'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const direct = writes + reads; const directMBs = (direct * OBJECT_BYTES) / MB;
      const calls = writes + Math.round(reads * (100 - val('[data-hit]')) / 100); const nodes = Math.ceil(calls / NODE_CALLS) + SPARE_NODES; const capacity = nodes * NODE_CALLS;
      const rewrapRate = capacity * share; const days = objects / rewrapRate / DAY_S;
      const wrappedTb = (objects * KEY_CALL_BYTES) / TB; const dataTb = (objects * OBJECT_BYTES) / TB;
      const data: [string, string][] = [
        ['KMS calls per second if the KMS encrypted every object itself', fmt(direct)],
        ['Data through the KMS in that design', `${fmt(directMBs)} MB/s`],
        ['KMS calls per second with envelope encryption and a cache', fmt(calls)],
        [`Key traffic in that design (about ${KEY_CALL_BYTES} bytes per call)`, fmtN((calls * KEY_CALL_BYTES) / MB, 'MB/s')],
        ['KMS nodes to run, with two spare', fmt(nodes)],
        ['Storage for the wrapped keys', fmtN(wrappedTb, 'TB')],
        ['Bulk data that a rotation does not have to re-encrypt', `${fmt(dataTb)} TB`],
        ['Time for a rewrap of every object, within its capacity share', fmtN(days, 'days')],
        ['Reads that survive a KMS outage while the cache is warm', `${fmt(reads * hit)} per second (${fmt(hit * 100)}% of reads), writes stop`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
