---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Envelope encryption keeps bulk data away from the KMS, a cache cuts its load several times over, and the size of the stored data decides how long a rewrap takes.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Encrypted objects (billions) <input type="range" min="1" max="100" value="20" data-o /> <b data-oval></b></label>
      <label>Writes per second at the peak (thousands) <input type="range" min="1" max="100" value="20" data-w /> <b data-wval></b></label>
      <label>Reads per second at the peak (thousands) <input type="range" min="1" max="500" value="100" data-r /> <b data-rval></b></label>
      <label>Reads served by the data-key cache (%) <input type="range" min="0" max="99" value="95" data-hit /> <b data-hitval></b></label>
      <label>Share of KMS capacity the rewrap may use (%) <input type="range" min="5" max="50" value="20" data-share /> <b data-shareval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: an object is 4 KB, a wrapped data key with its header is about 100 bytes, one KMS node handles about 5,000 wrap or unwrap calls per second (policy check, audit write and the unwrap), the KMS runs two spare nodes, a write needs a new data key and so always calls the KMS, and a rewrap is one call per object. Throughput of an HSM is not the limit because the KMS caches unwrapped key-encryption keys.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmtN = (n: number, unit: string) => `${n >= 10 ? fmt(n) : n.toFixed(1)} ${unit}`;
    function draw() {
      const objects = val('[data-o]') * 1e9; const writes = val('[data-w]') * 1000; const reads = val('[data-r]') * 1000; const hit = val('[data-hit]') / 100; const share = val('[data-share]') / 100;
      ['o', 'w', 'r', 'hit', 'share'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const direct = writes + reads; const directMBs = (direct * 4096) / 1e6;
      const calls = writes + Math.round(reads * (100 - val('[data-hit]')) / 100); const nodes = Math.ceil(calls / 5000) + 2; const capacity = nodes * 5000;
      const rewrapRate = capacity * share; const days = objects / rewrapRate / 86400;
      const wrappedTb = (objects * 100) / 1e12; const dataTb = (objects * 4096) / 1e12;
      const data: [string, string][] = [
        ['KMS calls per second if the KMS encrypted every object itself', fmt(direct)],
        ['Data through the KMS in that design', `${fmt(directMBs)} MB/s`],
        ['KMS calls per second with envelope encryption and a cache', fmt(calls)],
        ['Key traffic in that design (about 100 bytes per call)', fmtN((calls * 100) / 1e6, 'MB/s')],
        ['KMS nodes to run, with two spare', fmt(nodes)],
        ['Storage for the wrapped keys', fmtN(wrappedTb, 'TB')],
        ['Bulk data that a rotation does not have to re-encrypt', `${fmt(dataTb)} TB`],
        ['Time for a rewrap of every object, within its capacity share', fmtN(days, 'days')],
        ['Reads that survive a KMS outage while the cache is warm', `${fmt(reads * hit)} per second (${fmt(hit * 100)}% of reads), writes stop`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
