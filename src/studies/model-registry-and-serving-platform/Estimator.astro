---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Weight size drives storage and cold-start time, and the shared store's bandwidth decides how bad a fleet-wide restart is.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Models in the registry <input type="range" min="20" max="1000" step="10" value="200" data-m /> <b data-mval></b></label>
      <label>New versions per model per month <input type="range" min="1" max="20" value="3" data-v /> <b data-vval></b></label>
      <label>Months of versions kept <input type="range" min="1" max="36" value="12" data-r /> <b data-rval></b></label>
      <label>Weights per version (GB) <input type="range" min="1" max="140" value="4" data-s /> <b data-sval></b></label>
      <label>Live endpoints <input type="range" min="10" max="500" step="10" value="80" data-e /> <b data-eval></b></label>
      <label>Peak requests per second per endpoint <input type="range" min="1" max="500" value="50" data-q /> <b data-qval></b></label>
      <label>Requests per second one replica handles <input type="range" min="1" max="100" value="10" data-c /> <b data-cval></b></label>
      <label>Download speed of one node (GB/s) <input type="range" min="0.25" max="5" step="0.25" value="1.25" data-n /> <b data-nval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the runtime needs 6 s to start before it loads weights, local NVMe reads at 3 GB/s, the artifact store can serve 10 GB/s in total, and every live endpoint has the same size and traffic. Content-addressed storage means identical files are stored once, so this is an upper bound. A restart of the whole fleet is the worst case, as after a region failover.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 9; // output lines below
    const GB_PER_TB = 1000;
    const STARTUP_S = 6; // container and runtime start before weights load
    const NVME_GBS = 3; const STORE_GBS = 10; // local NVMe read rate; total artifact store bandwidth, GB/s
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const models = val('[data-m]'); const perMonth = val('[data-v]'); const months = val('[data-r]'); const gb = val('[data-s]');
      const endpoints = val('[data-e]'); const qps = val('[data-q]'); const cap = val('[data-c]'); const net = val('[data-n]');
      ['m', 'v', 'r', 's', 'e', 'q', 'c', 'n'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const versions = models * perMonth * months; const storageTb = (versions * gb) / GB_PER_TB;
      const perEndpoint = Math.ceil(qps / cap); const fleet = perEndpoint * endpoints;
      const cold = STARTUP_S + Math.ceil(gb / net); const warm = STARTUP_S + Math.ceil(gb / NVME_GBS);
      const pullGb = fleet * gb; const restart = STARTUP_S + Math.max(Math.ceil(gb / net), Math.ceil(pullGb / STORE_GBS));
      const data: [string, string][] = [
        ['Versions stored', fmt(versions)],
        ['Artifact storage for all versions', `${storageTb.toFixed(1)} TB`],
        ['Replicas per endpoint at the peak', fmt(perEndpoint)],
        ['Replicas in the whole fleet', fmt(fleet)],
        ['Cold start, weights from the artifact store', `${fmt(cold)} s`],
        ['Cold start, weights on local NVMe', `${fmt(warm)} s`],
        ['Weights to download if the whole fleet restarts', `${fmt(pullGb)} GB`],
        ['Fleet restart time when every node pulls from the store', `${fmt(restart)} s`],
        ['Fleet restart time when weights are already on the nodes', `${fmt(warm)} s`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
