---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="At thousands of GPUs, hardware failures are routine, and the checkpoint interval decides how much work each one destroys.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>GPUs in the cluster <input type="range" min="512" max="16384" step="512" value="4096" data-g /> <b data-gval></b></label>
      <label>GPUs in one big training job <input type="range" min="64" max="4096" step="64" value="1024" data-j /> <b data-jval></b></label>
      <label>Mean time between failures of one GPU, with its host (hours) <input type="range" min="10000" max="100000" step="5000" value="50000" data-mtbf /> <b data-mtbfval></b></label>
      <label>Model size (billions of parameters) <input type="range" min="1" max="400" value="70" data-par /> <b data-parval></b></label>
      <label>Checkpoint write speed of the storage (GB/s) <input type="range" min="20" max="800" step="20" value="200" data-bw /> <b data-bwval></b></label>
      <label>Time between checkpoints (minutes) <input type="range" min="5" max="120" step="5" value="30" data-int /> <b data-intval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 8 GPUs per node and 32 nodes per rack, failures of different GPUs are independent, a checkpoint holds the weights and optimiser state at 14 bytes per parameter (bf16 weights plus fp32 master copy and two Adam moments), a failure loses on average half a checkpoint interval of work, and restarting takes 10 minutes to find a replacement, reschedule and reload. The best interval is the Young formula, the square root of 2 times the write time times the job's mean time between failures.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const OUT_ROWS = 10; // lines in the result list
    const H_PER_DAY = 24, MIN_PER_H = 60, SEC_PER_MIN = 60, SEC_PER_H = 3600;
    const CKPT_GB_PER_B_PARAMS = 14; // checkpoint GB per billion parameters (weights plus optimiser state)
    const RESTART_MIN = 10;
    const GPUS_PER_NODE = 8, GPUS_PER_RACK = 256;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmt1 = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const g = val('[data-g]'); const j = val('[data-j]'); const mtbf = val('[data-mtbf]'); const par = val('[data-par]'); const bw = val('[data-bw]'); const interval = val('[data-int]');
      ['g', 'j', 'mtbf', 'par', 'bw', 'int'].forEach((k) => (q(`[data-${k}val]`).textContent = fmt(val(`[data-${k}]`))));
      const jobMtbfH = mtbf / j; const failuresPerDay = H_PER_DAY / jobMtbfH;
      const ckptGb = par * CKPT_GB_PER_B_PARAMS; const writeS = ckptGb / bw;
      const overhead = (writeS / (interval * SEC_PER_MIN)) * 100;
      const lostPerFailure = (j * (interval / 2 + RESTART_MIN)) / MIN_PER_H;
      const young = Math.sqrt(2 * writeS * jobMtbfH * SEC_PER_H) / SEC_PER_MIN; // Young's formula: sqrt(2 x write time x MTBF)
      const data: [string, string][] = [
        ['Nodes and racks', `${fmt(g / GPUS_PER_NODE)} nodes in ${fmt(Math.ceil(g / GPUS_PER_RACK))} racks`],
        ['GPU failures somewhere in the cluster, per day', fmt1((g * H_PER_DAY) / mtbf)],
        ['The big job is interrupted about every', `${fmt1(jobMtbfH)} hours`],
        ['Interruptions of the big job per day', fmt1(failuresPerDay)],
        ['Checkpoint size', `${fmt(ckptGb)} GB`],
        ['Time to write one checkpoint', `${fmt1(writeS)} seconds`],
        ['Share of time spent writing checkpoints', `${fmt1(overhead)}%`],
        ['GPU-hours lost per interruption (half an interval plus restart)', fmt(lostPerFailure)],
        ['GPU-hours lost per day to interruptions', fmt(lostPerFailure * failuresPerDay)],
        ['Checkpoint interval that minimises total loss', `${fmt(young)} minutes`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
