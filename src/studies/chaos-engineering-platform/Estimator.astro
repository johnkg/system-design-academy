---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The blast radius sets how many requests are exposed, and the time to abort sets how many of them are lost.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Instances in the fleet" name="i" min="500" max="20000" step="500" value="5000" />
      <RangeField label="Requests per second per instance" name="r" min="50" max="1000" step="50" value="200" />
      <RangeField label="Blast radius (% of the fleet)" name="b" min="1" max="20" value="2" />
      <RangeField label="Requests that fail on a hit instance (%)" name="f" min="10" max="100" step="10" value="30" />
      <RangeField label="Guardrail check every (seconds)" name="c" min="1" max="30" value="5" />
      <RangeField label="Metrics delay (seconds)" name="l" min="1" max="60" value="10" />
      <RangeField label="Experiments per month" name="e" min="20" max="1000" step="20" value="200" />
      <RangeField label="Minutes per experiment" name="d" min="1" max="60" value="10" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: traffic is spread evenly, so each hit instance carries the average load, clients do not retry (a worst case), an abort takes 3 seconds to reach the agents and remove the fault, the worst case waits a full check interval plus the metrics delay, and each agent sends one heartbeat every 10 seconds.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const ABORT_S = 3; // time for agents to remove the fault once the abort is sent
    const MIN_PER_H = 60;
    const HEARTBEAT_S = 10; // each agent reports every 10 s
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const inst = val('[data-i]'); const rps = val('[data-r]'); const b = val('[data-b]') / 100; const f = val('[data-f]') / 100; const check = val('[data-c]'); const lag = val('[data-l]'); const exps = val('[data-e]'); const mins = val('[data-d]');
      ['i', 'r', 'b', 'f', 'c', 'l', 'e', 'd'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const hit = Math.ceil(inst * b); const fleetRps = inst * rps; const hitRps = hit * rps; const failPerSec = hitRps * f;
      const abort = check + lag + ABORT_S; const lost = failPerSec * abort;
      const data: [string, string][] = [
        ['Instances inside the blast radius', fmt(hit)],
        ['Requests per second across the fleet', fmt(fleetRps)],
        ['Requests per second reaching the hit instances', fmt(hitRps)],
        ['Failed requests per second while the fault is on', fmt(failPerSec)],
        ['Share of all customer requests failing', `${((failPerSec / fleetRps) * 100).toFixed(2)}%`],
        ['Worst-case time to abort', `${fmt(abort)} s`],
        ['Failed requests before an abort completes', fmt(lost)],
        ['Experiment hours per month', (exps * mins / MIN_PER_H).toFixed(1)],
        ['Agent heartbeats per second', fmt(inst / HEARTBEAT_S)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
