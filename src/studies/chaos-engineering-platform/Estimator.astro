---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The blast radius sets how many requests are exposed, and the time to abort sets how many of them are lost.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Instances in the fleet <input type="range" min="500" max="20000" step="500" value="5000" data-i /> <b data-ival></b></label>
      <label>Requests per second per instance <input type="range" min="50" max="1000" step="50" value="200" data-r /> <b data-rval></b></label>
      <label>Blast radius (% of the fleet) <input type="range" min="1" max="20" value="2" data-b /> <b data-bval></b></label>
      <label>Requests that fail on a hit instance (%) <input type="range" min="10" max="100" step="10" value="30" data-f /> <b data-fval></b></label>
      <label>Guardrail check every (seconds) <input type="range" min="1" max="30" value="5" data-c /> <b data-cval></b></label>
      <label>Metrics delay (seconds) <input type="range" min="1" max="60" value="10" data-l /> <b data-lval></b></label>
      <label>Experiments per month <input type="range" min="20" max="1000" step="20" value="200" data-e /> <b data-eval></b></label>
      <label>Minutes per experiment <input type="range" min="1" max="60" value="10" data-d /> <b data-dval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: traffic is spread evenly, so each hit instance carries the average load, clients do not retry (a worst case), an abort takes 3 seconds to reach the agents and remove the fault, the worst case waits a full check interval plus the metrics delay, and each agent sends one heartbeat every 10 seconds.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const inst = val('[data-i]'); const rps = val('[data-r]'); const b = val('[data-b]') / 100; const f = val('[data-f]') / 100; const check = val('[data-c]'); const lag = val('[data-l]'); const exps = val('[data-e]'); const mins = val('[data-d]');
      ['i', 'r', 'b', 'f', 'c', 'l', 'e', 'd'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const hit = Math.ceil(inst * b); const fleetRps = inst * rps; const hitRps = hit * rps; const failPerSec = hitRps * f;
      const abort = check + lag + 3; const lost = failPerSec * abort;
      const data: [string, string][] = [
        ['Instances inside the blast radius', fmt(hit)],
        ['Requests per second across the fleet', fmt(fleetRps)],
        ['Requests per second reaching the hit instances', fmt(hitRps)],
        ['Failed requests per second while the fault is on', fmt(failPerSec)],
        ['Share of all customer requests failing', `${((failPerSec / fleetRps) * 100).toFixed(2)}%`],
        ['Worst-case time to abort', `${fmt(abort)} s`],
        ['Failed requests before an abort completes', fmt(lost)],
        ['Experiment hours per month', (exps * mins / 60).toFixed(1)],
        ['Agent heartbeats per second', fmt(inst / 10)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
