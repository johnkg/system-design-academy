---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Every event writes a new offline row, but the online store keeps one row per user. A backfill replays the whole window, so its time depends on the window and the workers.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Users (millions) <input type="range" min="1" max="500" value="50" data-u /> <b data-uval></b></label>
      <label>Events per user per day <input type="range" min="1" max="100" value="20" data-e /> <b data-eval></b></label>
      <label>Features per user <input type="range" min="10" max="500" step="10" value="100" data-f /> <b data-fval></b></label>
      <label>Predictions per second at the peak <input type="range" min="1000" max="200000" step="1000" value="50000" data-q /> <b data-qval></b></label>
      <label>Backfill window (days) <input type="range" min="7" max="365" value="90" data-w /> <b data-wval></b></label>
      <label>Backfill workers <input type="range" min="10" max="1000" step="10" value="200" data-k /> <b data-kval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the peak is 3 times the average event rate; a feature value takes 8 bytes and a row also holds an 8-byte key and an 8-byte time; each event changes one row of all features (a wide row); the online store adds about 50 bytes of overhead per user; every prediction does one batched lookup of one user; one worker replays about 20,000 events per second; sizes are before compression, which in columnar files is often 3 to 5 times.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 9; // one per output line
    const MILLION = 1e6; const BILLION = 1e9; const DAY_S = 86400;
    const PEAK_X = 3; const ROW = { keyBytes: 16, perFeature: 8, onlineOverhead: 50 }; // bytes
    const REPLAY_PER_WORKER = 20000; // events per second per backfill worker
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const size = (bytes: number) => (bytes >= 1e12 ? `${(bytes / 1e12).toFixed(1)} TB` : `${fmt(bytes / 1e9)} GB`);
    const dur = (s: number) => (s >= 7200 ? `${(s / 3600).toFixed(1)} hours` : `${fmt(s / 60)} minutes`);
    function draw() {
      const users = val('[data-u]') * MILLION; const ev = val('[data-e]'); const feats = val('[data-f]'); const qps = val('[data-q]'); const win = val('[data-w]'); const workers = val('[data-k]');
      ['u', 'e', 'f', 'q', 'w', 'k'].forEach((k) => (q(`[data-${k}val]`).textContent = val(`[data-${k}]`).toLocaleString('en-US')));
      const perDay = users * ev; const avg = perDay / DAY_S; const peak = avg * PEAK_X;
      const rowBytes = ROW.keyBytes + feats * ROW.perFeature; const offlineDay = perDay * rowBytes;
      const online = users * (rowBytes + ROW.onlineOverhead);
      const backfillEvents = perDay * win; const secs = backfillEvents / (workers * REPLAY_PER_WORKER);
      const data: [string, string][] = [
        ['Events per second, average', fmt(avg)],
        [`Events per second at the peak (${PEAK_X} times the average)`, fmt(peak)],
        ['Offline rows written per day', fmt(perDay)],
        ['Offline storage per day, uncompressed', size(offlineDay)],
        ['Offline storage for the backfill window', size(offlineDay * win)],
        ['Online store size (one row per user)', size(online)],
        ['Online lookups per second (one user each)', fmt(qps)],
        ['Bytes read per lookup', `${fmt(rowBytes)} bytes`],
        ['Backfill: events to replay, and time at this size', `${fmt(backfillEvents / BILLION)} billion events, ${dur(secs)}`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
