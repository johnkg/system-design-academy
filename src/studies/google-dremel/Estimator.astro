---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How much data a query reads from columns compared with whole records, how many slots and tablets a table needs, and how long a scan takes. A teaching model with round numbers, not Google's data.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Records in the table (billions)" name="r" min="1" max="2000" step="1" value="85" />
      <RangeField label="Fields in each record" name="f" min="10" max="1000" step="10" value="100" />
      <RangeField label="Fields the query reads" name="c" min="1" max="20" step="1" value="1" />
      <RangeField label="Compressed bytes per field value" name="b" min="1" max="20" step="1" value="2" />
      <RangeField label="Leaf servers" name="l" min="100" max="5000" step="100" value="3000" />
      <RangeField label="Threads on each leaf" name="h" min="2" max="16" step="1" value="8" />
      <RangeField label="Scan speed of a thread (MB per second)" name="s" min="10" max="200" step="10" value="50" />
      <RangeField label="Tablets in the table (thousands)" name="t" min="10" max="500" step="10" value="100" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Teaching model, not Google's system or data. From the Dremel paper: a 3,000-node instance with 8 threads on each leaf has 24,000 slots, a table of 100,000 tablets is about 5 tablets per slot, the 85-billion-record table T1 is 87 TB, and reading one field needed about 0.5 TB of columnar data against 87 TB of whole records. The bytes per value, the scan speed and the field counts are my guesses that you can change. Assumptions: all fields have the same size, tablets are the same size and spread evenly over slots, the scan is the only cost, and one terabyte is 1,000,000 MB.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const f1 = formatOneDecimalBelow100;
    const pct = (n: number) => `${(Math.round(n * 1000) / 1000).toLocaleString('en-US')}%`;
    function draw() {
      ['r', 'f', 'c', 'b', 'l', 'h', 's', 't'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const records = val('[data-r]') * 1e9; const fields = val('[data-f]'); const read = Math.min(val('[data-c]'), fields); const bytes = val('[data-b]');
      const leaves = val('[data-l]'); const threads = val('[data-h]'); const speed = val('[data-s]'); const tablets = val('[data-t]') * 1000;
      const tableTb = (records * fields * bytes) / 1e12; const colTb = (records * read * bytes) / 1e12;
      const slots = leaves * threads;
      const scanSeconds = (colTb * 1e6) / (slots * speed); const recordSeconds = (tableTb * 1e6) / (slots * speed);
      const data: [string, string][] = [
        ['Table size, all fields (TB)', f1(tableTb)],
        ['Data the query reads from columns (TB)', f1(colTb)],
        ['Share of the table read', `${f1((100 * read) / fields)}%`],
        ['Slots (leaf servers x threads)', f1(slots)],
        ['Tablets per slot', f1(tablets / slots)],
        ['Seconds to scan the columns', f1(scanSeconds)],
        ['Seconds to scan whole records, with the same slots', f1(recordSeconds)],
        ['How many times faster the columns are', `${f1(recordSeconds / scanSeconds)} times`],
        ['Seconds if the slowest tablet takes 10 times a normal tablet', f1(((tablets / slots) + 9) * (colTb * 1e6) / tablets / speed)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
