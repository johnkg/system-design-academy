---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Columns and a slow tablet" hint="Choose whether the data is stored as whole records or as column stripes, how many fields the query uses, how many tablets are slow and how the dispatcher reacts, and see how much data is read and how long the query takes on 3,000 leaf servers. A simple model, not Google's code or data.">
  <ol class="how">
    <li>Press <b>Reset</b>. Whole records mean <b>87</b> TB scanned, <b>72.5</b> s normally, and <b>1,795.1</b> s with the stragglers, because the answer waits for them.</li>
    <li>Set <b>Storage</b> to <b>Column stripes</b>: only <b>0.87</b> TB is scanned, and the times drop to <b>0.7</b> s normally and <b>18</b> s with the stragglers.</li>
    <li>Choose <b>Re-send it to another server</b>: the stragglers cost only <b>1.1</b> s.</li>
    <li>Choose <b>Return when 98% of tablets are scanned</b>: the answer comes back at the normal speed with <b>99.995%</b> of the tablets in it.</li>
  </ol>
  <div class="pg brk" data-brk>
    <div class="pg-row">
      <label>Storage <select class="pg-in" data-store><option value="rec">Whole records</option><option value="col">Column stripes</option></select></label>
      <RangeField label="Fields the query reads (of 100)" name="used" min="1" max="100" step="1" value="1" />
      <RangeField label="Slow tablets (of 100,000)" name="slow" min="0" max="50" step="1" value="5" />
      <RangeField label="How much slower they run (times)" name="factor" min="10" max="1000" step="10" value="100" />
      <label>When a tablet is slow <select class="pg-in" data-handle><option value="wait">Wait for it</option><option value="resend">Re-send it to another server</option><option value="early">Return when 98% of tablets are scanned</option></select></label>
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Data scanned (TB)</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Time with no slow tablets (s)</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Time with the slow tablets (s)</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Share of the tablets in the answer</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model, invented for teaching and not Google data. A table of 100 equal fields is 87 TB if all fields are read (the paper's table T1 is 85 billion records and 87 TB), and each field is 1% of that when only columns are read; the paper measured about 0.5 TB for the one field it used. The table has 100,000 tablets and 24,000 slots (3,000 leaf servers with 8 threads, as in the paper), each slot scanning 50 MB per second. A tablet takes the same time unless it is slow. When a tablet is re-sent, the dispatcher notices after 3 normal tablet times and the copy runs on an idle slot. Returning at 98% skips the slow tablets, which the paper says can speed up execution a lot.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, formatWholeNumber, mulberry32 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-brk]').forEach((root) => {
    const q = query(root);
    const DEFAULTS: Record<string, string> = {"store": "rec", "used": "1", "slow": "5", "factor": "100", "handle": "wait"};
    const input = (k: string) => q<HTMLInputElement>(`[data-${k}]`);
    const select = (k: string) => q<HTMLSelectElement>(`[data-${k}]`);
    const whole = formatWholeNumber;
    const one = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');

    function draw() {
      const store = select('store').value;
      const handle = select('handle').value;
      const used = Number(input('used').value);
      const slow = Number(input('slow').value);
      const factor = Number(input('factor').value);
      q('[data-usedval]').textContent = String(used);
      q('[data-slowval]').textContent = String(slow);
      q('[data-factorval]').textContent = String(factor);
      const boxes: { big: string; note: string; bad: boolean }[] = [];
      let verdict = '';
      let failed = false;
      const TABLETS = 100000, SLOTS = 24000, SPEED = 50, TABLE_TB = 87; // 3,000 leaves x 8 threads; MB per second per thread; the 100-field table of the paper's experiment
      const dataTb = store === 'rec' ? TABLE_TB : (TABLE_TB / 100) * used;
      const tabletSeconds = (dataTb * 1e6) / TABLETS / SPEED;
      const base = tabletSeconds * (TABLETS / SLOTS);
      const withSlow = slow === 0 ? base : handle === 'wait' ? base + (factor - 1) * tabletSeconds : handle === 'resend' ? base + 2 * tabletSeconds : base; // a re-sent tablet is noticed after 3 normal tablet times
      const share = handle === 'early' ? (100 * (TABLETS - slow)) / TABLETS : 100;
      boxes.push({ big: dataTb < 10 ? dataTb.toFixed(2) : one(dataTb), note: store === 'rec' ? 'every field of every record is read' : 'only the stripes the query names', bad: dataTb > 10 });
      boxes.push({ big: one(base), note: 'if every tablet takes the usual time', bad: base > 30 });
      boxes.push({ big: one(withSlow), note: slow === 0 ? 'no slow tablets' : handle === 'wait' ? 'the query waits for the slowest tablet' : handle === 'resend' ? 'the dispatcher moves each slow tablet to another server' : 'the slow tablets are left out of the answer', bad: withSlow > 3 * base });
      boxes.push({ big: share === 100 ? '100%' : `${share.toFixed(3)}%`, note: handle === 'early' && slow > 0 ? 'a slightly incomplete answer' : 'every tablet is in the answer', bad: false });
      failed = withSlow > 3 * base || base > 30;
      if (store === 'rec' && base > 30) verdict = `Scanning whole records reads ${one(dataTb)} TB and takes ${one(base)} seconds even though the query needs only ${used} of 100 fields.`;
      else if (withSlow > 3 * base) verdict = `${slow} slow tablets stretch the query from ${one(base)} to ${one(withSlow)} seconds, because the answer needs every tablet. Re-sending the slow tablets or returning at 98% avoids it.`;
      else verdict = slow > 0 && handle === 'early' ? 'The answer came back at the normal speed, with a few tablets missing.' : `The query takes about ${one(withSlow)} seconds.`;
      boxes.forEach((b, i) => {
        q(`[data-o${i + 1}]`).textContent = b.big;
        q(`[data-n${i + 1}]`).textContent = b.note;
        q<HTMLElement>(`[data-b${i + 1}]`).style.setProperty('--c', b.bad ? 'var(--bad)' : 'var(--good)');
      });
      const out = q('[data-verdict]'); out.classList.toggle('bad', failed); out.textContent = verdict;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    q('[data-reset]').addEventListener('click', () => {
      Object.entries(DEFAULTS).forEach(([k, v]) => { (root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-${k}]`)!).value = v; });
      draw();
    });
    draw();
  });
</script>
