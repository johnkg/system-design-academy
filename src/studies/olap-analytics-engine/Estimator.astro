---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Rollup decides how much is stored, and the hot tier is sized by whichever is larger, the data or the dashboard queries.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Events per second (thousands) <input type="range" min="10" max="2000" step="10" value="500" data-e /> <b data-eval></b></label>
      <label>Bytes per raw event <input type="range" min="100" max="2000" step="100" value="600" data-rb /> <b data-rbval></b></label>
      <label>Rollup ratio (events per stored row) <input type="range" min="1" max="200" value="20" data-r /> <b data-rval></b></label>
      <label>Stored bytes per row, after columnar compression <input type="range" min="10" max="100" step="5" value="30" data-sb /> <b data-sbval></b></label>
      <label>Days on the hot tier <input type="range" min="1" max="60" value="14" data-hot /> <b data-hotval></b></label>
      <label>Days of retention in total <input type="range" min="30" max="1095" step="5" value="365" data-ret /> <b data-retval></b></label>
      <label>Hot replicas <input type="range" min="1" max="3" value="2" data-rep /> <b data-repval></b></label>
      <label>Disk per hot node (TB) <input type="range" min="1" max="8" value="2" data-disk /> <b data-diskval></b></label>
      <label>Dashboard queries per second <input type="range" min="1" max="200" value="20" data-qps /> <b data-qpsval></b></label>
      <label>Days of data per query <input type="range" min="1" max="30" value="1" data-days /> <b data-daysval></b></label>
      <label>Rows left after filters and bitmaps (%) <input type="range" min="1" max="100" value="5" data-sel /> <b data-selval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a segment holds about 5 million rows, one ingest core handles 25,000 events per second including parsing and rollup, a hot node has 16 cores that each scan 50 million filtered rows per second, disks are filled to 70%, and cold segments live once in object storage. Replicas are copies that also answer queries, so scanning uses the cores of all hot nodes.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 11 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const size = (gb: number) => (gb >= 1e6 ? `${(gb / 1e6).toFixed(1)} PB` : gb >= 1000 ? `${(gb / 1000).toFixed(1)} TB` : `${gb.toFixed(1)} GB`);
    function draw() {
      const e = val('[data-e]') * 1000; const rb = val('[data-rb]'); const r = val('[data-r]'); const sb = val('[data-sb]');
      const hot = val('[data-hot]'); const ret = Math.max(val('[data-ret]'), hot); const rep = val('[data-rep]'); const disk = val('[data-disk]');
      const qps = val('[data-qps]'); const days = val('[data-days]'); const sel = val('[data-sel]') / 100;
      ['e', 'rb', 'r', 'sb', 'hot', 'ret', 'rep', 'disk', 'qps', 'days', 'sel'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const eventsDay = e * 86400; const rawGb = (eventsDay * rb) / 1e9;
      const rowsDay = eventsDay / r; const storedGb = (rowsDay * sb) / 1e9;
      const hotGb = storedGb * hot * rep; const deepGb = storedGb * ret;
      const scanned = rowsDay * days * sel;
      const nodesStorage = Math.ceil(hotGb / (disk * 1000 * 0.7)); const nodesQuery = Math.ceil((qps * scanned) / (50e6 * 16));
      const data: [string, string][] = [
        ['Events per day', `${(eventsDay / 1e9).toFixed(1)} billion`],
        ['Raw events per day', size(rawGb)],
        ['Rolled-up rows per day', `${(rowsDay / 1e6).toFixed(0)} million`],
        ['Stored per day, columnar', size(storedGb)],
        ['Reduction versus raw events', `${fmt(rawGb / storedGb)}x`],
        ['Segments created per day', fmt(rowsDay / 5e6)],
        ['Hot tier, with replicas', size(hotGb)],
        ['Deep storage for the whole retention', size(deepGb)],
        ['Ingest cores', fmt(Math.ceil(e / 25000))],
        ['Rows scanned per query', `${(scanned / 1e6).toFixed(1)} million`],
        [`Hot nodes: ${nodesStorage} for storage, ${nodesQuery} for queries`, fmt(Math.max(2, nodesStorage, nodesQuery))],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
