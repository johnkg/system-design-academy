---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How much raw disk does a given amount of user data need, once new data is copied, older data is erasure coded and cold data is spread across regions? Only the 500 PB start value and the 1 GB, 14 TB, 50 PB and 1.4 PB sizes come from Dropbox's posts. The rest are knobs for you to turn.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>User data (PB) <input type="range" min="50" max="1000" step="50" value="500" data-d /> <b data-dval></b></label>
      <label>Share of data that is cold (%) <input type="range" min="0" max="95" step="5" value="80" data-c /> <b data-cval></b></label>
      <label>Copies of new data in a region <input type="range" min="2" max="4" step="1" value="3" data-n /> <b data-nval></b></label>
      <label>Erasure code data shards <input type="range" min="4" max="12" step="1" value="6" data-k /> <b data-kval></b></label>
      <label>Erasure code parity shards <input type="range" min="1" max="4" step="1" value="3" data-m /> <b data-mval></b></label>
      <label>Regions holding a full copy <input type="range" min="2" max="3" step="1" value="2" data-r /> <b data-rval></b></label>
      <label>Regions in the cold tier <input type="range" min="2" max="6" step="1" value="3" data-t /> <b data-tval></b></label>
      <label>Machines helping a rebuild <input type="range" min="50" max="400" step="50" value="200" data-h /> <b data-hval></b></label>
      <label>Network each helper gives (Gbps) <input type="range" min="1" max="10" step="1" value="5" data-g /> <b data-gval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: every region stores its own full, independent copy of the data (the cold tier replaces that with fragments spread over its regions, so it needs the number of regions divided by that number minus one, such as 3 regions for 1.5 times); new data stays in its copies and older data is erasure coded within each region, which costs data plus parity shards divided by data shards; 14 TB drives, 50 PB of raw disk per cell and 1 GB buckets are sizes the posts mention, and 500 PB is the user data Dropbox reported in March 2016; a rebuilt machine holds 1.4 PB, as in the 2018 SMR post, and its helpers share the work evenly. Real systems also keep spare space and different codes.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 10; // lines in the result list
    const DRIVE_TB = 14; // size of one drive
    const CELL_PB = 50; // raw disk in one cell
    const MACHINE_PB = 1.4; // data on one storage machine
    const TB_PER_PB = 1000;
    const GB_PER_PB = 1e6; // 1 PB = 1,000,000 GB
    const BYTES_PER_PB = 1e15;
    const BITS = 8; const GBIT = 1e9; const SECONDS_PER_HOUR = 3600;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const d = val('[data-d]'); const cold = val('[data-c]') / 100; const n = val('[data-n]'); const k = val('[data-k]'); const m = val('[data-m]');
      const r = val('[data-r]'); const t = val('[data-t]'); const helpers = val('[data-h]'); const gbps = val('[data-g]');
      ['d', 'c', 'n', 'k', 'm', 'r', 't', 'h', 'g'].forEach((x) => (q(`[data-${x}val]`).textContent = String(val(`[data-${x}]`))));
      const ec = (k + m) / k; // disk per byte of erasure coded data
      const cross = t / (t - 1); // disk per byte of cold data spread across the cold-tier regions
      const copies = d * n * r; // everything kept as full copies in every region
      const coded = d * r * ((1 - cold) * n + cold * ec); // older data erasure coded in every region
      const tiered = d * ((1 - cold) * n * r + cold * ec * cross); // cold data also spread across regions
      const rebuildHours = (MACHINE_PB * BYTES_PER_PB * BITS) / (helpers * gbps * GBIT) / SECONDS_PER_HOUR;
      const data: [string, string][] = [
        ['Raw disk if all data stays as full copies in every region', `${fmt(copies)} PB`],
        ['Raw disk when older data is erasure coded in each region', `${fmt(coded)} PB`],
        ['Raw disk when cold data is also spread across regions', `${fmt(tiered)} PB`],
        ['Saved by erasure coding older data', `${fmt(100 * (1 - coded / copies))}%`],
        ['Saved by the cold tier on top of that', `${fmt(100 * (1 - tiered / coded))}%`],
        ['Disk per byte of cold data across regions (the cold tier)', `${fmt(cross)} times`],
        [`${DRIVE_TB} TB drives for the last figure above`, fmt((tiered * TB_PER_PB) / DRIVE_TB)],
        [`Cells of ${CELL_PB} PB raw disk`, fmt(tiered / CELL_PB)],
        ['1 GB buckets of user data', fmt(d * GB_PER_PB)],
        [`Hours to rebuild one ${MACHINE_PB} PB machine`, fmt(rebuildHours)],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
