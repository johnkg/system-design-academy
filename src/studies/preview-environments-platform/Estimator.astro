---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Previews that sleep when nobody looks cost a fraction of previews that always run. The time a pull request stays open sets how many exist at once.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Pull requests opened per day" name="p" min="5" max="300" step="5" value="60" />
      <RangeField label="Days a pull request stays open" name="d" min="1" max="7" value="2" />
      <RangeField label="Share of previews awake at the busiest time (%)" name="a" min="2" max="100" value="15" />
      <RangeField label="Memory of an awake preview (GB)" name="r" min="1" max="8" value="2" />
      <RangeField label="Seed database size (GB)" name="s" min="1" max="100" value="20" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a node has 64 GB of memory and 80% of it can be given to previews, one extra node runs the shared services, a node costs $0.60 per hour (730 hours per month), a sleeping preview uses no memory, and a copy-on-write clone of the seed database stores only the 5% that the preview changes.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 8; // one per output line
    const NODE = { ramGb: 64, usable: 0.8, usdPerH: 0.6 }; // per node; 80% of memory for previews
    const SPARE_NODES = 1; const HOURS_PER_MONTH = 730;
    const CLONE_SHARE = 0.05; // a copy-on-write clone stores about 5% of the seed
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const perDay = val('[data-p]'); const days = val('[data-d]'); const awakeShare = val('[data-a]') / 100; const ram = val('[data-r]'); const seedGb = val('[data-s]');
      ['p', 'd', 'a', 'r', 's'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const open = perDay * days; const memAll = open * ram; const usable = NODE.ramGb * NODE.usable;
      const nodesAll = Math.ceil(memAll / usable) + SPARE_NODES;
      const awake = Math.ceil(open * awakeShare); const nodesSleep = Math.ceil((awake * ram) / usable) + SPARE_NODES;
      const costAll = nodesAll * NODE.usdPerH * HOURS_PER_MONTH; const costSleep = nodesSleep * NODE.usdPerH * HOURS_PER_MONTH;
      const saving = costAll > 0 ? Math.round((1 - costSleep / costAll) * 100) : 0;
      const data: [string, string][] = [
        ['Previews open at the same time', fmt(open)],
        ['Memory if every preview always runs', `${fmt(memAll)} GB`],
        ['Nodes if every preview always runs', fmt(nodesAll)],
        ['Previews awake at the busiest time', fmt(awake)],
        ['Nodes when idle previews sleep', fmt(nodesSleep)],
        ['Monthly node cost, always running', `$${fmt(costAll)}`],
        ['Monthly node cost, with sleep', `$${fmt(costSleep)} (${saving}% less)`],
        ['Database storage: full copies or clones', `${fmt(open * seedGb)} GB or ${fmt(open * seedGb * CLONE_SHARE)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
