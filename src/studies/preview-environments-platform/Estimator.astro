---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Previews that sleep when nobody looks cost a fraction of previews that always run. The time a pull request stays open sets how many exist at once.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Pull requests opened per day <input type="range" min="5" max="300" step="5" value="60" data-p /> <b data-pval></b></label>
      <label>Days a pull request stays open <input type="range" min="1" max="7" value="2" data-d /> <b data-dval></b></label>
      <label>Share of previews awake at the busiest time (%) <input type="range" min="2" max="100" value="15" data-a /> <b data-aval></b></label>
      <label>Memory of an awake preview (GB) <input type="range" min="1" max="8" value="2" data-r /> <b data-rval></b></label>
      <label>Seed database size (GB) <input type="range" min="1" max="100" value="20" data-s /> <b data-sval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a node has 64 GB of memory and 80% of it can be given to previews, one extra node runs the shared services, a node costs $0.60 per hour (730 hours per month), a sleeping preview uses no memory, and a copy-on-write clone of the seed database stores only the 5% that the preview changes.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const perDay = val('[data-p]'); const days = val('[data-d]'); const awakeShare = val('[data-a]') / 100; const ram = val('[data-r]'); const seedGb = val('[data-s]');
      ['p', 'd', 'a', 'r', 's'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const open = perDay * days; const memAll = open * ram; const usable = 64 * 0.8;
      const nodesAll = Math.ceil(memAll / usable) + 1;
      const awake = Math.ceil(open * awakeShare); const nodesSleep = Math.ceil((awake * ram) / usable) + 1;
      const costAll = nodesAll * 0.6 * 730; const costSleep = nodesSleep * 0.6 * 730;
      const saving = costAll > 0 ? Math.round((1 - costSleep / costAll) * 100) : 0;
      const data: [string, string][] = [
        ['Previews open at the same time', fmt(open)],
        ['Memory if every preview always runs', `${fmt(memAll)} GB`],
        ['Nodes if every preview always runs', fmt(nodesAll)],
        ['Previews awake at the busiest time', fmt(awake)],
        ['Nodes when idle previews sleep', fmt(nodesSleep)],
        ['Monthly node cost, always running', `$${fmt(costAll)}`],
        ['Monthly node cost, with sleep', `$${fmt(costSleep)} (${saving}% less)`],
        ['Database storage: full copies or clones', `${fmt(open * seedGb)} GB or ${fmt(open * seedGb * 0.05)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
