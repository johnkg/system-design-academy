---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="One month of pull requests" hint="Sixty pull requests are opened over thirty days, and reviewers visit their previews now and then. Change the housekeeping rules and watch the bill, the leftovers and the broken visits. The same 60 pull requests are replayed for every setting.">
  <ol class="how">
    <li>The <b>default</b> has no housekeeping: every preview runs all month with its own database server, nothing is deleted, and nothing limits a leaking preview. It costs about <b>$1,884</b>, <b>60</b> previews are still alive on day 30, and <b>69</b> visits land on a preview that a leaking neighbour slowed down.</li>
    <li>Tick <b>Delete the preview when its pull request is merged or closed</b>: the cost drops to about <b>$782</b> and the leftovers to <b>17</b>, the pull requests that were abandoned without ever being closed.</li>
    <li>Switch the databases to <b>shared server, one schema per preview</b>, set idle sleep to <b>after 1 hour</b> and tick <b>per-preview quota</b>: the bill falls to about <b>$20</b>, and no visit is disturbed. A <b>7-day time limit</b> then removes the last 17 abandoned previews, but a <b>2-day limit</b> deletes previews that are still under review, which breaks <b>76</b> visits.</li>
  </ol>
  <div class="pg peb" data-peb>
    <div class="pg-row">
      <label><input type="checkbox" data-pe-clean /> Delete the preview when its pull request is merged or closed</label>
      <label>Idle sleep <select class="pg-in" data-pe-idle>
        <option value="-1" selected>never (always running)</option>
        <option value="1">after 1 hour without a visit</option>
        <option value="0">after 15 minutes without a visit</option>
      </select></label>
      <label>Time limit <select class="pg-in" data-pe-ttl>
        <option value="0" selected>none</option>
        <option value="7">7 days after creation</option>
        <option value="2">2 days after creation</option>
      </select></label>
      <label>Database <select class="pg-in" data-pe-db>
        <option value="own" selected>a database server per preview</option>
        <option value="shared">shared server, one schema per preview</option>
      </select></label>
      <label><input type="checkbox" data-pe-quota /> Memory and CPU quota per preview</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-pe-b1><h3>Cost for 30 days</h3><span class="pg-mono" data-pe-o1></span><span class="pg-note" data-pe-n1></span></div>
      <div class="pg-box" data-pe-b2><h3>Previews alive on day 30</h3><span class="pg-mono" data-pe-o2></span><span class="pg-note" data-pe-n2></span></div>
      <div class="pg-box" data-pe-b3><h3>Most previews awake at once</h3><span class="pg-mono" data-pe-o3></span><span class="pg-note" data-pe-n3></span></div>
      <div class="pg-box" data-pe-b4><h3>Visits that fail or are slow</h3><span class="pg-mono" data-pe-o4></span><span class="pg-note" data-pe-n4></span></div>
    </div>
    <p class="pg-out" data-pe-verdict aria-live="polite"></p>
    <p class="pg-note">Model: an awake preview costs $0.02 per hour, any preview that exists costs $0.001 per hour for its disk, and a database server of its own costs $0.05 per hour. A preview is awake in the hour of each visit, and for one more hour with the 1-hour rule. 1 in 8 previews leaks memory; without a quota, a visit during an hour in which a leaking preview is awake has a one-in-three chance of sharing its machine and being slowed down. A visit after the preview was deleted fails. About 20% of pull requests are never closed.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-peb]').forEach((root) => {
    const q = query(root);
    const HOURS = 720;
    const SEED = 11; const N_PRS = 60; const DAY_H = 24;
    const WORK = { start: 9, end: 17, span: 8 }; // working hours in which people visit previews
    const OPEN_DAYS = 26; const DUR_SPAN = 4; const MAX_VISITS = 3; // PRs open on days 0..25, stay 1..4 days, up to 2 visits a day
    const CLOSE_ODDS = 5; const LEAK_ODDS = 8; // 1 in 5 PRs is abandoned, 1 in 8 leaks resources
    const COST = { base: 0.001, db: 0.05, awake: 0.02 }; // dollars per preview-hour
    const SLOW_EVERY = 3; // one visit in three lands on a node shared with a leaking preview
    const BUDGET = 300; // dollars per month
    // LCG, upper bits
    let seed = SEED; const rnd = (n: number) => { seed = (seed * 1664525 + 1013904223) % 4294967296; return Math.floor(seed / 65536) % n; };
    type Pr = { create: number; last: number; closes: boolean; leaks: boolean; touches: number[] };
    // The same 60 pull requests for every setting. A touch is the hour in which someone visits the preview.
    const prs: Pr[] = Array.from({ length: N_PRS }, () => {
      const open = rnd(OPEN_DAYS); const dur = 1 + rnd(DUR_SPAN); const closes = rnd(CLOSE_ODDS) !== 0; const leaks = rnd(LEAK_ODDS) === 0; const touches = [open * DAY_H + WORK.start];
      for (let d = open; d <= open + dur; d++) { const n = rnd(MAX_VISITS); for (let k = 0; k < n; k++) touches.push(d * DAY_H + WORK.start + rnd(WORK.span)); }
      return { create: open * DAY_H + WORK.start, last: (open + dur) * DAY_H + WORK.end, closes, leaks, touches };
    });
    function run(cleanup: boolean, idle: number, ttl: number, quota: boolean, ownDb: boolean) {
      let cost = 0; let alive = 0; let broken = 0;
      const awakeAt = new Array(HOURS).fill(0); const leakAt = new Array(HOURS).fill(0);
      prs.forEach((p) => {
        let end = HOURS; if (cleanup && p.closes) end = Math.min(end, p.last); if (ttl > 0) end = Math.min(end, p.create + ttl * DAY_H);
        for (let h = p.create; h < end; h++) {
          const awake = idle < 0 || p.touches.some((t) => t <= h && h <= t + idle);
          cost += COST.base + (ownDb ? COST.db : 0) + (awake ? COST.awake : 0);
          if (awake) { awakeAt[h]++; if (p.leaks && !quota) leakAt[h] = 1; }
        }
        if (end >= HOURS) alive++;
        p.touches.forEach((t) => { if (t >= end) broken++; });
      });
      let slowed = 0;
      prs.forEach((p, i) => p.touches.forEach((t, k) => { if (leakAt[t] && (i + k) % SLOW_EVERY === 0 && !p.leaks) slowed++; }));
      return { cost: Math.round(cost), alive, broken, slowed, peak: Math.max(...awakeAt) };
    }
    function draw() {
      const r = run(q<HTMLInputElement>('[data-pe-clean]').checked, Number(q<HTMLSelectElement>('[data-pe-idle]').value), Number(q<HTMLSelectElement>('[data-pe-ttl]').value), q<HTMLInputElement>('[data-pe-quota]').checked, q<HTMLSelectElement>('[data-pe-db]').value === 'own');
      q('[data-pe-o1]').textContent = `$${r.cost.toLocaleString('en-US')}`; q('[data-pe-n1]').textContent = 'awake time, disks and databases';
      q('[data-pe-o2]').textContent = `${r.alive} of ${N_PRS}`; q('[data-pe-n2]').textContent = r.alive ? 'merged, closed or abandoned previews that still hold resources' : 'nothing is left behind';
      q('[data-pe-o3]').textContent = String(r.peak); q('[data-pe-n3]').textContent = 'this sets how many machines the cluster needs';
      q('[data-pe-o4]').textContent = `${r.broken + r.slowed}`; q('[data-pe-n4]').textContent = `${r.broken} found the preview deleted, ${r.slowed} were slowed by a leaking neighbour`;
      q<HTMLElement>('[data-pe-b1]').style.setProperty('--c', r.cost > BUDGET ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-pe-b2]').style.setProperty('--c', r.alive > 0 ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-pe-b3]').style.setProperty('--c', 'var(--accent)');
      q<HTMLElement>('[data-pe-b4]').style.setProperty('--c', r.broken + r.slowed > 0 ? 'var(--bad)' : 'var(--good)');
      const issues: string[] = [];
      if (r.broken > 0) issues.push(`the time limit deleted previews that were still under review, so ${r.broken} visits failed`);
      if (r.slowed > 0) issues.push(`without a quota a leaking preview slowed ${r.slowed} visits to other previews`);
      if (r.alive > 0) issues.push(`${r.alive} previews still hold resources on day ${HOURS / DAY_H}`);
      if (r.cost > BUDGET) issues.push(`the bill is $${r.cost.toLocaleString('en-US')} for the month, with up to ${r.peak} previews awake together`);
      const out = q('[data-pe-verdict]'); out.classList.toggle('bad', issues.length > 0);
      out.textContent = issues.length ? `Problems: ${issues.join('; ')}.` : `Healthy: $${r.cost} for the month, at most ${r.peak} previews awake together, nothing left behind and no visit disturbed.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
