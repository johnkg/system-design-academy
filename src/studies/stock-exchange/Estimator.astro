---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="A busy exchange sends far more messages than it makes trades. See what the busiest symbol needs, and what the market data feed costs.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Orders per day (millions) <input type="range" min="1" max="3000" value="500" data-o /> <b data-oval></b></label>
      <label>Peak rate compared with the average <input type="range" min="2" max="50" value="10" data-pk /> <b data-pkval></b></label>
      <label>Share of orders in the busiest symbol (%) <input type="range" min="1" max="30" value="5" data-hot /> <b data-hotval></b></label>
      <label>Subscribers to market data (thousands) <input type="range" min="1" max="100" value="10" data-sub /> <b data-subval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a trading day has 6.5 hours, an order message takes 64 bytes in the journal, one engine thread can process about 1 million orders per second, every order produces about 1.5 market data messages, and a market data message is 40 bytes.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 8; // lines in the result list
    const MILLION = 1e6, THOUSAND = 1000, HOUR_S = 3600, GB = 1e9, TBIT = 1e12, BITS_PER_BYTE = 8;
    const TRADING_HOURS = 6.5;
    const MSGS_PER_ORDER = 1.5; // market data messages per order
    const ENGINE = { opsS: 1e6, targetOps: 700000 }; // one engine thread matches 1M orders/s; plan for 70% of that
    const JOURNAL_BYTES = 64, MD_MSG_BYTES = 40;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const orders = val('[data-o]') * MILLION; const pk = val('[data-pk]'); const hot = val('[data-hot]') / 100; const subs = val('[data-sub]') * THOUSAND;
      ['o', 'pk', 'hot', 'sub'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const avg = orders / (TRADING_HOURS * HOUR_S); const peak = avg * pk; const hotPeak = peak * hot; const msgs = peak * MSGS_PER_ORDER;
      const data: [string, string][] = [
        ['Average orders per second', fmt(avg)],
        ['Orders per second at the peak', fmt(peak)],
        ['Peak for the busiest symbol', fmt(hotPeak)],
        ['Headroom of one engine thread on that symbol', hotPeak > ENGINE.opsS ? `short by ${(hotPeak / ENGINE.opsS).toFixed(1)} times` : `${(ENGINE.opsS / hotPeak).toFixed(1)} times`],
        ['Engines needed at the peak (at 70% load each)', fmt(Math.max(1, Math.ceil(peak / ENGINE.targetOps)))],
        ['Journal written per day', `${((orders * JOURNAL_BYTES) / GB).toFixed(0)} GB`],
        ['Market data messages per second at the peak', fmt(msgs)],
        ['Data sent if each subscriber got a private copy', `${((msgs * MD_MSG_BYTES * BITS_PER_BYTE * subs) / TBIT).toFixed(1)} Tbps (multicast sends one copy)`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
