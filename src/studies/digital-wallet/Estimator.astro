---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Cross-shard transfers cost several durable writes each in two-phase commit, and one popular merchant is limited by how long each transfer holds its account.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Users (millions) <input type="range" min="10" max="500" step="10" value="100" data-u /> <b data-uval></b></label>
      <label>Share who transfer on a given day (%) <input type="range" min="1" max="50" value="20" data-act /> <b data-actval></b></label>
      <label>Transfers per active user per day <input type="range" min="1" max="10" value="2" data-t /> <b data-tval></b></label>
      <label>Peak compared to the average <input type="range" min="2" max="10" value="5" data-peak /> <b data-peakval></b></label>
      <label>Shards <input type="range" min="2" max="256" step="2" value="16" data-s /> <b data-sval></b></label>
      <label>Share of all transfers paying one big merchant (%) <input type="range" min="0" max="10" value="5" data-hot /> <b data-hotval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: sender and recipient are random, so a transfer crosses shards with probability 1 - 1/shards. A durable write costs 3 ms and a round trip 2 ms. Durable writes per transfer: 1 if both wallets are on one shard, and for a cross-shard transfer 5 in two-phase commit (2 prepares, 1 decision, 2 commits), 3 in a saga (intent, debit, credit) and 2 with a single writer per account (an append for the sender and one for the receiver). A shard handles about 5,000 durable writes per second. An account is held for 13 ms in two-phase commit (prepare to commit), 3 ms in a saga (the local debit or credit) and a single writer appends a batch of about 30 transfers per 3 ms disk write. A ledger entry takes about 100 bytes and every transfer writes two.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 11; // one per output line
    const MILLION = 1e6; const DAY_S = 86400; const MS_PER_S = 1000; const DAYS_PER_YEAR = 365; const BYTES_PER_TB = 1e12;
    const WRITES = { twoPhase: 5, saga: 3, single: 2 }; // durable writes per cross-shard transfer
    const SHARD_WRITES_PER_S = 5000;
    const HOT = { lockMs2pc: 13, lockMsSaga: 3, batch: 30 }; // how long one account is locked per transfer; single writer applies 30 per batch
    const LEDGER = { entries: 2, bytes: 100 }; // two entries of 100 bytes per transfer
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const users = val('[data-u]') * MILLION; const act = val('[data-act]') / 100; const per = val('[data-t]'); const peakX = val('[data-peak]'); const shards = val('[data-s]'); const hot = val('[data-hot]') / 100;
      ['u', 'act', 't', 'peak', 's', 'hot'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perDay = users * act * per; const peak = (perDay / DAY_S) * peakX; const cross = 1 - 1 / shards;
      const writes = (perCross: number) => peak * (cross * perCross + (1 - cross));
      const w2 = writes(WRITES.twoPhase); const ws = writes(WRITES.saga); const w1 = writes(WRITES.single); const CAP = SHARD_WRITES_PER_S;
      const merchant = peak * hot; const lim2 = MS_PER_S / HOT.lockMs2pc; const limSaga = MS_PER_S / HOT.lockMsSaga; const limOne = HOT.batch * (MS_PER_S / HOT.lockMsSaga);
      const fits = (n: number) => (merchant <= n ? 'fits' : `over by ${(merchant / n).toFixed(1)}x`);
      const data: [string, string][] = [
        ['Transfers per day', fmt(perDay)],
        ['Transfers per second at the peak', fmt(peak)],
        ['Transfers that cross shards', `${(cross * 100).toFixed(1)}%`],
        ['Durable writes per second at the peak, two-phase commit', fmt(w2)],
        ['Durable writes per second at the peak, saga', fmt(ws)],
        ['Durable writes per second at the peak, single writer', fmt(w1)],
        ['Shards needed for write load (two-phase commit, saga, single writer)', `${fmt(Math.ceil(w2 / CAP))}, ${fmt(Math.ceil(ws / CAP))}, ${fmt(Math.ceil(w1 / CAP))}`],
        ['Ledger growth per year', `${((perDay * LEDGER.entries * LEDGER.bytes * DAYS_PER_YEAR) / BYTES_PER_TB).toFixed(1)} TB`],
        ['Transfers per second into the big merchant at the peak', fmt(merchant)],
        ['Most that one account can take per second (two-phase commit, saga, single writer)', `${fmt(lim2)}, ${fmt(limSaga)}, ${fmt(limOne)}`],
        ['Does the big merchant fit? (two-phase commit, saga, single writer)', `${fits(lim2)}, ${fits(limSaga)}, ${fits(limOne)}`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
