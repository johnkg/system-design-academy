---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The event rate drives ingest, the dedup window drives memory, and the archive is what makes late events and audits possible.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Customers (thousands) <input type="range" min="1" max="500" value="50" data-c /> <b data-cval></b></label>
      <label>Events per customer per second, on average <input type="range" min="1" max="50" value="5" data-r /> <b data-rval></b></label>
      <label>Peak compared with the average <input type="range" min="1" max="10" value="3" data-k /> <b data-kval></b></label>
      <label>Bytes per event <input type="range" min="100" max="1000" step="50" value="300" data-by /> <b data-byval></b></label>
      <label>Days of raw events kept <input type="range" min="7" max="730" step="1" value="90" data-d /> <b data-dval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 10 metrics per customer, each with hourly rows; an ingest node handles about 20,000 events per second; the archive compresses 3 to 1; the dedup store keeps 32 bytes per event id for 24 hours.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 8; // lines in the result list
    const THOUSAND = 1000, DAY_S = 86400, GB = 1e9, BILLION = 1e9, GB_PER_TB = 1000, H_PER_DAY = 24;
    const TENTHS = 10; // the rate slider is in tenths of an event per second
    const COMPRESSION = 3; // archive compression ratio
    const NODE_EPS = 20000; // events per second one ingest node takes
    const DEDUP_KEY_BYTES = 32; // one event id in the 24-hour dedup store
    const METERS = 10; // billable meters per customer, one aggregate row each per hour
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const customers = val('[data-c]') * THOUSAND; const rate = val('[data-r]') / TENTHS; const peakK = val('[data-k]'); const bytes = val('[data-by]'); const days = val('[data-d]');
      q('[data-cval]').textContent = String(val('[data-c]')); q('[data-rval]').textContent = rate.toFixed(1); q('[data-kval]').textContent = String(peakK); q('[data-byval]').textContent = String(bytes); q('[data-dval]').textContent = String(days);
      const avg = customers * rate; const peak = avg * peakK; const perDay = avg * DAY_S;
      const rawGb = (perDay * bytes) / GB; const archiveGbDay = rawGb / COMPRESSION;
      const data: [string, string][] = [
        ['Events per second on average', fmt(avg)],
        ['Events per second at the peak', fmt(peak)],
        ['Ingest nodes at the peak', fmt(Math.ceil(peak / NODE_EPS))],
        ['Events per day', `${(perDay / BILLION).toFixed(2)} billion`],
        ['Raw event volume per day', `${fmt(rawGb)} GB`],
        [`Compressed archive for ${days} days`, `${(archiveGbDay * days / GB_PER_TB).toFixed(1)} TB`],
        ['Dedup store for the 24-hour window', `${fmt((perDay * DEDUP_KEY_BYTES) / GB)} GB`],
        ['Aggregate rows written per day', `${fmt(customers * METERS * H_PER_DAY)}`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
