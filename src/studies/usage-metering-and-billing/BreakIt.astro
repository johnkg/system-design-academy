---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Double charges and missing usage" hint="A stream of 2,000 usage events is replayed with retries and late arrivals. Change how long the meter remembers event ids, how long it waits before the invoice closes, and what it does with events that arrive after that. The true total is 6,026 units.">
  <ol class="how">
    <li>The <b>default</b> remembers ids for 20 time units, waits 100 and <b>ignores late events</b>: the invoice says 6,111 units, only 85 above the truth, but that hides two opposite mistakes: <b>294 units billed twice</b> and <b>209 units never billed</b>.</li>
    <li>Remember ids for <b>50 or more</b>: every retry in this stream comes within 50 time units of the original, so no repeat is billed. The invoice is now <b>209 units short</b>, because the late events were dropped.</li>
    <li>With ids remembered for 50 or more, set events that arrive after the close to <b>are billed as an adjustment on the next invoice</b> (or wait 600 before closing): the invoice is exactly <b>6,026</b>. The adjustment keeps the invoice on time, and waiting makes the invoice late instead.</li>
  </ol>
  <div class="pg umb" data-umb>
    <div class="pg-row">
      <label>Remember event ids for <input type="range" min="0" max="100" step="10" value="20" data-w /> <b data-wval></b></label>
      <label>Wait before closing the invoice <input type="range" min="0" max="600" step="100" value="100" data-g /> <b data-gval></b></label>
      <label>Events that arrive after the close <select class="pg-in" data-a>
        <option value="ignore" selected>are ignored</option>
        <option value="adjust">are billed as an adjustment on the next invoice</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Repeats billed again</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Usage never billed</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Invoice against the truth</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: two billing periods of 1,000 time units. 1 event in 5 is delayed by up to 600 units, the rest by under 20. 1 event in 10 is sent a second time up to 49 units later, with the same id. Usage is counted by the time it happened, and a period closes the given wait after it ends. A price of 0.10 per unit is assumed for the money figures.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-umb]').forEach((root) => {
    const q = query(root);
    const PERIOD = 1000;
    const EVENTS = 2000; const QTY_MAX = 5; // usage events, units per event 1-5
    const DELAY = { lateOf: 10, lateBelow: 2, lateMax: 600, normalMax: 20 }; // 20% of events arrive up to 600 late, the rest within 20
    const DUP = { oneIn: 10, extraMax: 50 }; // one event in ten is delivered again, up to 50 later
    // Numerical Recipes LCG
    let seed = 7; const rnd = (n: number) => { seed = (seed * 1664525 + 1013904223) % 4294967296; return Math.floor(seed / 65536) % n; };
    type Ev = { id: number; ts: number; qty: number; arrival: number };
    const stream: Ev[] = [];
    for (let id = 0; id < EVENTS; id++) {
      const ts = rnd(2 * PERIOD); const qty = 1 + rnd(QTY_MAX);
      const delay = rnd(DELAY.lateOf) < DELAY.lateBelow ? rnd(DELAY.lateMax) : rnd(DELAY.normalMax);
      stream.push({ id, ts, qty, arrival: ts + delay });
      if (rnd(DUP.oneIn) === 0) stream.push({ id, ts, qty, arrival: ts + delay + rnd(DUP.extraMax) });
    }
    stream.sort((a, b) => a.arrival - b.arrival || a.id - b.id);
    const firstSeen = new Set<number>(); let truth = 0;
    stream.forEach((e) => { if (!firstSeen.has(e.id)) { firstSeen.add(e.id); truth += e.qty; } });
    function run(window: number, grace: number, adjust: boolean) {
      const first = new Map<number, number>();
      let onTime = 0; let adjusted = 0; let twice = 0; let dropped = 0; let late = 0; let caught = 0;
      for (const e of stream) {
        const f = first.get(e.id); let again = false;
        if (f !== undefined) { if (window > 0 && e.arrival - f <= window) { caught++; continue; } again = true; } else first.set(e.id, e.arrival);
        const p = Math.floor(e.ts / PERIOD);
        if (e.arrival >= (p + 1) * PERIOD + grace) {
          late += e.qty;
          if (adjust) { adjusted += e.qty; if (again) twice += e.qty; } else dropped += e.qty;
        } else { onTime += e.qty; if (again) twice += e.qty; }
      }
      const billed = onTime + adjusted;
      return { billed, twice, missing: truth - (billed - twice), late, adjusted, caught };
    }
    const fmt = (n: number) => n.toLocaleString('en-US');
    const money = (units: number) => `$${(units / 10).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    function draw() {
      const w = Number(q<HTMLInputElement>('[data-w]').value); const g = Number(q<HTMLInputElement>('[data-g]').value);
      const adjust = q<HTMLSelectElement>('[data-a]').value === 'adjust';
      q('[data-wval]').textContent = w === 0 ? 'not at all' : String(w); q('[data-gval]').textContent = String(g);
      const r = run(w, g, adjust);
      q('[data-o1]').textContent = `${fmt(r.twice)} units`; q('[data-n1]').textContent = `${money(r.twice)} charged twice; ${fmt(r.caught)} repeats were caught`;
      q('[data-o2]').textContent = `${fmt(r.missing)} units`; q('[data-n2]').textContent = adjust ? `${fmt(r.adjusted)} late units went to an adjustment` : `${fmt(r.late)} units arrived after the close and were dropped`;
      const diff = r.billed - truth;
      q('[data-o3]').textContent = `${fmt(r.billed)} of ${fmt(truth)}`; q('[data-n3]').textContent = diff === 0 ? 'exactly right' : `${diff > 0 ? 'over' : 'under'} by ${fmt(Math.abs(diff))} units (${money(Math.abs(diff))})`;
      q<HTMLElement>('[data-b1]').style.setProperty('--c', r.twice === 0 ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', r.missing === 0 ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', diff === 0 ? 'var(--good)' : 'var(--bad)');
      const out = q('[data-verdict]'); const bad = r.twice > 0 || r.missing > 0; out.classList.toggle('bad', bad);
      const parts: string[] = [];
      if (r.twice > 0) parts.push(`${fmt(r.twice)} units were billed twice, because a retry came after the meter had forgotten the id (a retry here can come up to 49 units later, so remember ids for at least 50)`);
      if (r.missing > 0) parts.push(`${fmt(r.missing)} units were never billed, because they arrived after the invoice closed and were ignored`);
      out.textContent = bad ? (diff === 0 ? 'The totals happen to match, but only because opposite mistakes cancel: ' : 'Wrong invoice: ') + parts.join(', and ') + '.'
        : (adjust && r.adjusted > 0 ? `Exact: ${fmt(r.adjusted)} late units were added as an adjustment on the next invoice, and every repeat was recognised.` : 'Exact, because every repeat was recognised and the invoice waited long enough for every late event. The cost is an invoice that closes later.');
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
