---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Who may read the best passages?" hint="One employee asks 60 questions. Change how permissions are applied, and watch for answers that use a passage they may not read, and for answers that have too little to go on.">
  <ol class="how">
    <li>The default is a <b>post-filter on 20 candidates</b> for a person who can read <b>10%</b> of the chunks: the 20 best chunks hold about 2 readable ones, so <b>all 60 answers get fewer than 5 passages</b> (1.8 on average). The access copy is stale, so 3 answers still use a chunk whose access was removed.</li>
    <li>Choose <b>no filter</b>: all 60 answers are full, but <b>all 60 use passages the person may not read</b>. That is the failure to prevent.</li>
    <li>Choose <b>pre-filter</b>: every answer is full again, and the ranking only sees readable chunks. With a stale access copy, <b>7 answers</b> still use a revoked chunk. Switch the access copy to <b>kept current</b> and the leaks go to <b>0</b>.</li>
  </ol>
  <div class="pg rgb" data-rgb>
    <div class="pg-row">
      <label>Permissions are applied <select class="pg-in" data-strat>
        <option value="none">not at all</option>
        <option value="post" selected>after retrieval (post-filter)</option>
        <option value="pre">inside the search (pre-filter)</option>
      </select></label>
      <label>The access copy on each chunk is <select class="pg-in" data-acl>
        <option value="stale" selected>updated nightly (stale)</option>
        <option value="fresh">kept current by events</option>
      </select></label>
      <label>Share of chunks this person can read (%) <input type="range" min="1" max="100" value="10" data-share /> <b data-shareval></b></label>
      <label>Candidates kept before a post-filter <input type="range" min="10" max="200" step="10" value="20" data-pool /> <b data-poolval></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Passages per answer</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Answers using unreadable chunks</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Best readable passages found</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 3,000 chunks, 60 questions, and each answer wants 5 passages. Relevance is random per question. Each chunk is readable with the chosen probability, and 3% of the chunks that were readable when the copy was made have lost access since. Candidates in the post-filter are only used by that option. The best readable passages found is the share of the 5 best chunks the person may read right now that were returned.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-rgb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const M = 3000; const Q = 60; const K = 5;
    const SEED = 77; const REVOKED_SHARE = 0.03; // documents whose access was revoked after indexing
    const GOOD_RECALL = 95; // percent
    let seed = SEED; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
    const rel = Array.from({ length: Q }, () => Array.from({ length: M }, () => rnd()));
    const u = Array.from({ length: M }, () => rnd());
    const revoked = Array.from({ length: M }, () => rnd() < REVOKED_SHARE);
    const orders = rel.map((r) => Array.from({ length: M }, (_, i) => i).sort((a, b) => r[b] - r[a]));
    function run(strategy: string, pool: number, share: number, acl: string) {
      let short = 0; let leaked = 0; let returned = 0; let hit = 0;
      const snap = (c: number) => u[c] < share / 100; const live = (c: number) => snap(c) && !revoked[c];
      const pass = acl === 'fresh' ? live : snap;
      for (let i = 0; i < Q; i++) {
        const order = orders[i]; let got: number[];
        if (strategy === 'none') got = order.slice(0, K);
        else if (strategy === 'post') got = order.slice(0, pool).filter(pass).slice(0, K);
        else got = order.filter(pass).slice(0, K);
        const ideal = order.filter(live).slice(0, K);
        returned += got.length; if (got.length < K) short++;
        if (got.some((c) => !live(c))) leaked++;
        hit += got.filter((c) => ideal.includes(c)).length / K;
      }
      return { avg: returned / Q, short, leaked, recall: Math.round((100 * hit) / Q) };
    }
    let frame = 0;
    function draw() {
      const strat = q<HTMLSelectElement>('[data-strat]').value; const acl = q<HTMLSelectElement>('[data-acl]').value;
      const share = Number(q<HTMLInputElement>('[data-share]').value); const pool = Number(q<HTMLInputElement>('[data-pool]').value);
      q('[data-shareval]').textContent = String(share); q('[data-poolval]').textContent = String(pool);
      q<HTMLInputElement>('[data-pool]').disabled = strat !== 'post';
      const r = run(strat, pool, share, acl);
      q('[data-o1]').textContent = r.avg.toFixed(1); q('[data-n1]').textContent = `${r.short} of ${Q} answers had fewer than ${K}`;
      q('[data-o2]').textContent = `${r.leaked} of ${Q}`; q('[data-n2]').textContent = strat === 'none' ? 'nothing checks who is asking' : acl === 'stale' ? 'the access copy is out of date for revoked chunks' : 'the access data is current';
      q('[data-o3]').textContent = `${r.recall}%`; q('[data-n3]').textContent = `of the best ${K} the person may read`;
      q<HTMLElement>('[data-b1]').style.setProperty('--c', r.short === 0 ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', r.leaked === 0 ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', r.recall >= GOOD_RECALL ? 'var(--good)' : 'var(--bad)');
      const out = q('[data-verdict]'); const bad = r.leaked > 0 || r.short > 0; out.classList.toggle('bad', bad);
      out.textContent = strat === 'none' ? `${r.leaked} of ${Q} answers used chunks this person may not read. Retrieval alone can never be the security boundary.`
        : r.leaked > 0 ? `${r.leaked} of ${Q} answers used a chunk whose access was removed after the copy was made. Keep the access data current with events, and check the final chunks once more.`
        : r.short > 0 ? `No leaks, but ${r.short} of ${Q} answers had fewer than ${K} passages (${r.avg.toFixed(1)} on average): the best ${pool} candidates held too few readable chunks. Filter inside the search instead, or keep more candidates.`
        : `No leaks and every answer has ${K} passages. ${strat === 'pre' ? 'The ranking only ever sees readable chunks.' : `${pool} candidates happen to hold enough readable chunks for a person who can read ${share}%.`}`;
    }
    const schedule = () => { if (frame) return; frame = requestAnimationFrame(() => { frame = 0; draw(); }); };
    root.addEventListener('input', schedule); root.addEventListener('change', schedule);
    draw();
  });
</script>
