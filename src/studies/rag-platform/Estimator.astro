---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Chunks set the size of the index, questions set the model load, and edits set how much re-embedding the pipeline must keep up with.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Employees (thousands)" name="emp" min="1" max="200" value="20" />
      <RangeField label="Documents (millions)" name="docs" min="1" max="200" value="10" />
      <RangeField label="Chunks per document" name="cpd" min="1" max="30" value="6" />
      <label>Vector size <select class="pg-in" data-dims>
        <option value="384">384 numbers</option>
        <option value="768" selected>768 numbers</option>
        <option value="1536">1,536 numbers</option>
      </select></label>
      <label>Stored as <select class="pg-in" data-bytes>
        <option value="4" selected>32-bit floats (4 bytes)</option>
        <option value="1">8-bit integers (1 byte)</option>
      </select></label>
      <RangeField label="Memory per search node (GB)" name="gb" min="32" max="256" step="32" value="64" />
      <RangeField label="Questions per employee per day" name="q" min="1" max="20" value="5" />
      <RangeField label="Share of questions in the busiest hour (%)" name="peak" min="5" max="40" value="20" />
      <RangeField label="Context sent to the model (tokens)" name="ctx" min="1000" max="12000" step="500" value="3000" />
      <RangeField label="Documents edited per day (%)" name="edit" min="0" max="10" step="0.5" value="2" />
      <RangeField label="Embedding workers" name="w" min="1" max="64" value="8" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: an approximate-nearest-neighbour index needs about 1.5 times the raw vector size, an embedding worker does 200 chunks per second, an edit changes 30% of the chunks of a document, an answer is 250 tokens long and streams for about 8 seconds, work happens in an 8-hour day, and the price is 3 dollars per million input tokens and 15 dollars per million output tokens. The keyword index and the chunk text are extra.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 12; // one per output line
    const THOUSAND = 1e3; const MILLION = 1e6; // slider units
    const INDEX_OVERHEAD = 1.5; const BYTES_PER_GB = 1e9; const HOUR_S = 3600;
    const ANSWER_TOKENS = 250; const STREAM_S = 8; // tokens per answer, seconds an answer streams
    const PRICE = { inPerM: 3, outPerM: 15 }; // dollars per million tokens
    const CHANGED_SHARE = 0.3; // share of an edited document's chunks that change
    const EMBED_PER_WORKER = 200; // chunks per second
    const WORKDAY_H = 8;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
    function draw() {
      const emp = val('[data-emp]') * THOUSAND; const docs = val('[data-docs]') * MILLION; const cpd = val('[data-cpd]');
      const dims = val('[data-dims]'); const bytes = val('[data-bytes]'); const gb = val('[data-gb]');
      const perDay = val('[data-q]'); const peak = val('[data-peak]') / 100; const ctx = val('[data-ctx]');
      const edit = val('[data-edit]') / 100; const workers = val('[data-w]');
      ['emp', 'docs', 'cpd', 'gb', 'q', 'peak', 'ctx', 'edit', 'w'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const chunks = docs * cpd;
      const vectorGb = (chunks * dims * bytes * INDEX_OVERHEAD) / BYTES_PER_GB;
      const nodes = Math.ceil(vectorGb / gb);
      const questionsDay = emp * perDay;
      const qps = (questionsDay * peak) / HOUR_S;
      const inTokens = qps * ctx; const outTokens = qps * ANSWER_TOKENS;
      const streams = qps * STREAM_S;
      const cost = (questionsDay * (ctx * PRICE.inPerM + ANSWER_TOKENS * PRICE.outPerM)) / MILLION;
      const reembed = docs * edit * cpd * CHANGED_SHARE;
      const rate = workers * EMBED_PER_WORKER;
      const fullHours = chunks / rate / HOUR_S;
      const editsPerSec = (docs * edit) / (WORKDAY_H * HOUR_S);
      const data: [string, string][] = [
        ['Chunks in the index', fmt(chunks)],
        ['Vector index size', `${fmt1(vectorGb)} GB`],
        ['Search nodes for the vectors alone', fmt(nodes)],
        ['Questions per day', fmt(questionsDay)],
        ['Questions per second in the busiest hour', fmt1(qps)],
        ['Model input tokens per second at the peak', fmt(inTokens)],
        ['Model output tokens per second at the peak', fmt(outTokens)],
        ['Answers streaming at the same time', fmt(streams)],
        ['Model cost per day', `$${fmt(cost)}`],
        ['Chunks re-embedded per day', fmt(reembed)],
        ['Edited documents per second over the workday', fmt1(editsPerSec)],
        ['Time to embed everything from scratch, with these workers', `${fmt1(fullHours)} hours`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    draw();
  });
</script>
