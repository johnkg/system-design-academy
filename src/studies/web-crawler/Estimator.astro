---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Change the size of the crawl and see what it takes in bandwidth, storage and politeness.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Pages crawled per month (billions) <input type="range" min="0.1" max="10" step="0.1" value="1" data-pages /> <b data-pagesval></b></label>
      <label>Average page size (KB) <input type="range" min="20" max="500" step="10" value="100" data-size /> <b data-sizeval></b></label>
      <label>Time to fetch one page (ms) <input type="range" min="100" max="3000" step="100" value="800" data-ms /> <b data-msval></b></label>
      <label>Seconds between requests to one site <input type="range" min="0.5" max="10" step="0.5" value="1" data-gap /> <b data-gapval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a month has 30 days, stored pages are compressed to 40% of their size, a Bloom filter uses 10 bits per URL, a plain hash set about 40 bytes per URL, and every page is a new URL for the seen-set (the real number of distinct URLs is a few times the pages fetched).</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const pages = val('[data-pages]') * 1e9; const size = val('[data-size]'); const ms = val('[data-ms]'); const gap = val('[data-gap]');
      q('[data-pagesval]').textContent = val('[data-pages]').toFixed(1); q('[data-sizeval]').textContent = String(size);
      q('[data-msval]').textContent = String(ms); q('[data-gapval]').textContent = gap.toFixed(1);
      const perSec = pages / (30 * 86400); const gbps = (perSec * size * 1000 * 8) / 1e9;
      const tb = (pages * size * 1000 * 0.4) / 1e12;
      const data: [string, string][] = [
        ['Pages per second', fmt(perSec)],
        ['Download bandwidth', `${gbps.toFixed(2)} Gbps`],
        ['Raw storage added per month (compressed)', `${fmt(tb)} TB`],
        ['Connections open at the same time', fmt(perSec * (ms / 1000))],
        ['Different sites being fetched at once, at least', fmt(perSec * gap)],
        ['Seen-set with a Bloom filter', `${((pages * 10) / 8 / 1e9).toFixed(1)} GB`],
        ['Seen-set as a plain hash set', `${((pages * 40) / 1e9).toFixed(0)} GB`],
        ['DNS lookups per second without a cache', fmt(perSec)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
