---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Slow password hashing is the main CPU cost of a login service, and an attack multiplies it unless the cheap checks run first. Token refreshes are far more frequent than logins.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Registered users (millions) <input type="range" min="1" max="500" value="50" data-u /> <b data-uval></b></label>
      <label>Users who log in on a day (%) <input type="range" min="1" max="60" value="20" data-d /> <b data-dval></b></label>
      <label>Peak hour as a multiple of the daily average <input type="range" min="1" max="10" value="4" data-pk /> <b data-pkval></b></label>
      <label>Password hash time (ms) <input type="range" min="20" max="500" step="10" value="100" data-ms /> <b data-msval></b></label>
      <label>Attack requests per second <input type="range" min="0" max="20000" step="500" value="3000" data-at /> <b data-atval></b></label>
      <label>Attack stopped before hashing (%) <input type="range" min="0" max="99" value="90" data-st /> <b data-stval></b></label>
      <label>Access token lifetime (minutes) <input type="range" min="1" max="60" value="10" data-tt /> <b data-ttval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each active user does one password login a day and stays signed in on the device afterwards, 25% of them are signed in at the same time, every user has 2 devices with a refresh-token record of about 200 bytes, one login server has 16 cores and is run at 50% CPU for headroom, a login writes 4 audit events of about 300 bytes (attempt, second factor, token issue, session), and one hash occupies one core for the whole hash time. Checking a signed access token needs no database and costs microseconds.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 10; // one per output line
    const MILLION = 1e6; const DAY_S = 86400; const MS_PER_S = 1000; const SEC_PER_MIN = 60; const BYTES_PER_GB = 1e9;
    const SERVER = { cores: 16, util: 0.5 }; // login servers run at 50% CPU
    const CONCURRENT_SHARE = 0.25; // share of the day's users signed in at once
    const TOKEN = { devices: 2, bytes: 200 }; const AUDIT = { eventsPerLogin: 4, bytes: 300 };
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const users = val('[data-u]') * MILLION; const daily = val('[data-d]') / 100; const peak = val('[data-pk]'); const ms = val('[data-ms]');
      const attack = val('[data-at]'); const stopped = val('[data-st]') / 100; const life = val('[data-tt]');
      ['u', 'd', 'pk', 'ms', 'at', 'st', 'tt'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const logins = users * daily; const perSec = (logins / DAY_S) * peak;
      const realCores = (perSec * ms) / MS_PER_S; const atkCores = (attack * (1 - stopped) * ms) / MS_PER_S; const rawAtkCores = (attack * ms) / MS_PER_S;
      const servers = Math.ceil((realCores + atkCores) / (SERVER.cores * SERVER.util));
      const signedIn = logins * CONCURRENT_SHARE; const refresh = signedIn / (life * SEC_PER_MIN);
      const tokenGb = (users * TOKEN.devices * TOKEN.bytes) / BYTES_PER_GB; const auditGb = (logins * AUDIT.eventsPerLogin * AUDIT.bytes) / BYTES_PER_GB;
      const data: [string, string][] = [
        ['Password logins per day', fmt(logins)],
        ['Password logins per second at the peak', fmt(perSec)],
        ['CPU cores for real logins at the peak', fmt(realCores)],
        ['CPU cores spent on attack traffic that reaches the hash', fmt(atkCores)],
        ['CPU cores if no attack traffic were stopped early', fmt(rawAtkCores)],
        [`Login servers (${SERVER.cores} cores, run at ${SERVER.util * 100}%)`, fmt(servers)],
        ['Signed-in users at the same moment', fmt(signedIn)],
        ['Token refreshes per second', fmt(refresh)],
        [`Refresh-token records (${TOKEN.devices} devices per user)`, `${tokenGb.toFixed(1)} GB`],
        ['Audit log per day', `${auditGb.toFixed(1)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
