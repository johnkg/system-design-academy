---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Every pod gets a proxy, every call crosses two of them, and every change in the cluster is pushed to the proxies that need to know.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Services <input type="range" min="50" max="1000" step="50" value="300" data-s /> <b data-sval></b></label>
      <label>Pods per service <input type="range" min="2" max="40" value="10" data-p /> <b data-pval></b></label>
      <label>User requests per second <input type="range" min="1000" max="100000" step="1000" value="20000" data-u /> <b data-uval></b></label>
      <label>Service calls per user request <input type="range" min="1" max="20" value="6" data-h /> <b data-hval></b></label>
      <label>Added latency per hop (ms) <input type="range" min="0.2" max="3" step="0.1" value="1" data-ms /> <b data-msval></b></label>
      <label>Share of the mesh each proxy knows (%) <input type="range" min="5" max="100" step="5" value="100" data-scope /> <b data-scopeval></b></label>
      <label>Pod restarts per hour in the cluster <input type="range" min="10" max="3000" step="10" value="300" data-r /> <b data-rval></b></label>
      <label>Certificate lifetime (hours) <input type="range" min="1" max="72" value="24" data-life /> <b data-lifeval></b></label>
      <label>Access logs kept (%) <input type="range" min="1" max="100" value="10" data-log /> <b data-logval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a sidecar uses 50 MB plus about 10 KB for each endpoint it knows, 10 millicores when idle and 0.5 vCPU for each 1,000 requests per second that pass through it (a call crosses 2 sidecars, one on each side). A pod restart changes one endpoint, and the control plane pushes a 2 KB incremental update to each proxy that knows that service. Certificates are renewed when half their lifetime has passed. Each service calls 8 others, each pair keeps 80 metric series (4 response classes and 20 latency buckets), and an access log line is 500 bytes. The added latency per hop is the sum for the client and server proxy, a median, and the 99th percentile is often 3 to 5 times as much.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const N_ROWS = 11; // output lines below
    const HOUR_S = 3600; const DAY_S = 86400; const KB_PER_MB = 1000; const MB_PER_GB = 1000; const MILLI = 1000; const THOUSAND = 1000;
    const PASSES_PER_CALL = 2; // a call crosses the caller's and the callee's sidecar
    const SIDECAR = { baseMb: 50, kbPerEndpoint: 10, idleCpu: 0.01, cpuPer1k: 0.5 }; // memory and vCPU per sidecar; vCPU per 1,000 passes/s
    const CERT_RENEW_AT = 0.5; // certificates are renewed at half their lifetime
    const METRICS = 8; const LABEL_SETS = 80; // metric names per service, label combinations each
    const PUSH_BYTES = 2000; const LOG_LINE_BYTES = 500;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const one = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
    const bytes = (n: number) => (n >= 1e12 ? `${one(n / 1e12)} TB` : n >= 1e9 ? `${one(n / 1e9)} GB` : n >= 1e6 ? `${one(n / 1e6)} MB` : `${fmt(n / 1e3)} KB`);
    function draw() {
      const s = val('[data-s]'), p = val('[data-p]'), u = val('[data-u]'), h = val('[data-h]'), ms = val('[data-ms]'), scope = val('[data-scope]') / 100, r = val('[data-r]'), life = val('[data-life]'), logs = val('[data-log]') / 100;
      [['s', fmt(s)], ['p', String(p)], ['u', fmt(u)], ['h', String(h)], ['ms', one(ms)], ['scope', String(Math.round(scope * 100))], ['r', fmt(r)], ['life', String(life)], ['log', String(Math.round(logs * 100))]].forEach(([k, v]) => (q(`[data-${k}val]`).textContent = v));
      const pods = s * p; const calls = u * h; const passes = calls * PASSES_PER_CALL;
      const endpoints = pods * scope; const memEach = SIDECAR.baseMb + (endpoints * SIDECAR.kbPerEndpoint) / KB_PER_MB; // MB
      const cpu = pods * SIDECAR.idleCpu + (passes / THOUSAND) * SIDECAR.cpuPer1k;
      const knowing = pods * scope; // proxies that know the changed service
      const pushRate = (r / HOUR_S) * knowing; // pushes per second
      const certRate = pods / (life * CERT_RENEW_AT * HOUR_S);
      const series = s * METRICS * LABEL_SETS;
      const logRate = passes * logs * LOG_LINE_BYTES;
      const data: [string, string][] = [
        ['Pods, and so sidecars to run', fmt(pods)],
        ['Calls between services per second', fmt(calls)],
        ['Added latency on one user request', `${one(h * ms)} ms (${h} hops of ${one(ms)} ms)`],
        ['Memory of one sidecar', `${fmt(memEach)} MB`],
        ['Memory of all sidecars', `${one((pods * memEach) / MB_PER_GB)} GB`],
        ['CPU of all sidecars', `${fmt(cpu)} vCPU, about ${one(cpu / pods * MILLI)} millicores each`],
        ['Config updates pushed per second', `${one(pushRate)} (each pod restart goes to ${fmt(knowing)} proxies)`],
        ['Config data pushed per second', bytes(pushRate * PUSH_BYTES)],
        ['Certificate signings per second', `${certRate.toFixed(2)} (and a burst on every mass restart)`],
        ['Metric series from the proxies', fmt(series)],
        ['Access log volume', `${bytes(logRate)} per second, ${bytes(logRate * DAY_S)} per day`],
      ];
      rows.forEach((row, i) => { row.dt.textContent = data[i][0]; row.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
