---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Sampling and collection" hint="Choose how many requests are traced, how busy the service is, how rare a problem is, and whether spans travel in the responses, and see what tracing costs and whether the rare problem still shows up in a trace. A simple model, not Google's code or data.">
  <ol class="how">
    <li>Press <b>Reset</b>. Tracing everything adds <b>+16.3%</b> latency, records <b>50,000</b> traces a second, and the rare issue appears in <b>43,200</b> traces a day.</li>
    <li>Set <b>Sampling</b> to <b>1 in 1,024</b>: the latency cost is within the noise, <b>48.8</b> traces a second are recorded, and the rare issue still shows up in <b>42.2</b> traces a day.</li>
    <li>Set <b>Sampling</b> to <b>1 in 16,384</b>: only <b>3.1</b> traces a second are recorded and just <b>2.6</b> traces of the rare issue a day, too few to study.</li>
    <li>Choose <b>In band: inside the responses</b>: each response grows by <b>17</b> KB, more than a typical <b>10</b> KB response, which is why Dapper collects out of band.</li>
  </ol>
  <div class="pg brk" data-brk>
    <div class="pg-row">
      <label>Sampling <select class="pg-in" data-rate><option value="1">Every request</option><option value="16">1 in 16</option><option value="1024">1 in 1,024</option><option value="16384">1 in 16,384</option></select></label>
      <RangeField label="Traffic (k calls per s)" name="rps" min="1" max="1000" step="1" value="50" />
      <RangeField label="Problem frequency (1 in k)" name="rare" min="1" max="1000" step="1" value="100" />
      <label>Where spans travel <select class="pg-in" data-mode><option value="out">Out of band: local logs, then a collector</option><option value="in">In band: inside the responses</option></select></label>
      <RangeField label="Spans in one request" name="spans" min="5" max="200" step="5" value="40" />
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Average latency added</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Traces recorded per second</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Traces of the rare problem per day</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Trace data added to each response (KB)</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model, invented for teaching and not Google data, except the latency figures. The Dapper report measured a web search cluster: tracing every request added 16.3% to the average latency, 1 in 16 added 2.12%, and 1 in 1,024 was within the experimental error. Each span is about 426 bytes in the repository, and the report says responses are often under ten kilobytes, so sending the spans back in the response would dwarf them. A rare problem that happens once in the number of requests you set is traced whenever it falls in the sample. The report argues that in high-traffic services such a pattern will appear thousands of times even with aggressive sampling.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, formatWholeNumber, mulberry32 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-brk]').forEach((root) => {
    const q = query(root);
    const DEFAULTS: Record<string, string> = {"rate": "1", "rps": "50", "rare": "100", "mode": "out", "spans": "40"};
    const input = (k: string) => q<HTMLInputElement>(`[data-${k}]`);
    const select = (k: string) => q<HTMLSelectElement>(`[data-${k}]`);
    const whole = formatWholeNumber;
    const one = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');

    function draw() {
      const rate = select('rate').value;
      const mode = select('mode').value;
      const rps = Number(input('rps').value);
      const rare = Number(input('rare').value);
      const spans = Number(input('spans').value);
      q('[data-rpsval]').textContent = String(rps);
      q('[data-rareval]').textContent = String(rare);
      q('[data-spansval]').textContent = String(spans);
      const boxes: { big: string; note: string; bad: boolean }[] = [];
      let verdict = '';
      let failed = false;
      const N = Number(rate);
      const latency = N === 1 ? '+16.3%' : N === 16 ? '+2.1%' : 'within the noise';
      const traces = (rps * 1000) / N;
      const rareDay = (rps * 1000 * 86400) / (rare * 1000) / N;
      const extraKb = mode === 'in' ? spans * 0.426 : 0;
      boxes.push({ big: latency, note: 'from the report\'s search cluster test; the smallest rate was not measured', bad: N === 1 });
      boxes.push({ big: one(traces), note: `every one has about ${spans} spans`, bad: false });
      boxes.push({ big: one(rareDay), note: rareDay < 10 ? 'too few to study the problem' : 'enough to see the pattern many times', bad: rareDay < 10 });
      boxes.push({ big: one(extraKb), note: mode === 'in' ? 'responses are often under 10 KB, so the trace can dwarf them' : 'nothing is added to the responses', bad: extraKb > 10 });
      failed = N === 1 || rareDay < 10 || extraKb > 10;
      if (extraKb > 10) verdict = `Putting ${spans} spans in the response adds ${one(extraKb)} KB, more than a typical 10 KB response. Dapper collects out of band for this reason.`;
      else if (N === 1) verdict = 'Tracing every request costs about 16% extra latency in the report\'s test, enough for teams to turn tracing off.';
      else if (rareDay < 10) verdict = `Only ${one(rareDay)} traces of the rare problem are recorded a day, too few to study. Services with little traffic can trace more of their requests.`;
      else verdict = `Cheap and still useful: ${whole(rareDay)} traces of the rare problem are recorded every day.`;
      boxes.forEach((b, i) => {
        q(`[data-o${i + 1}]`).textContent = b.big;
        q(`[data-n${i + 1}]`).textContent = b.note;
        q<HTMLElement>(`[data-b${i + 1}]`).style.setProperty('--c', b.bad ? 'var(--bad)' : 'var(--good)');
      });
      const out = q('[data-verdict]'); out.classList.toggle('bad', failed); out.textContent = verdict;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    q('[data-reset]').addEventListener('click', () => {
      Object.entries(DEFAULTS).forEach(([k, v]) => { (root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-${k}]`)!).value = v; });
      draw();
    });
    draw();
  });
</script>
