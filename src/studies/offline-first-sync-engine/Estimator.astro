---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The change log grows with every edit and every delete, and a long retention window (to let people return after weeks) multiplies it. Polling or pushing decides how many requests idle devices cost.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Users (thousands) <input type="range" min="10" max="2000" step="10" value="300" data-u /> <b data-uval></b></label>
      <label>Devices per user <input type="range" min="1" max="4" value="2" data-dv /> <b data-dvval></b></label>
      <label>Share of users active on a day (%) <input type="range" min="5" max="100" value="40" data-act /> <b data-actval></b></label>
      <label>Edits per active user per day <input type="range" min="10" max="500" step="10" value="80" data-ed /> <b data-edval></b></label>
      <label>Share of edits that are deletes (%) <input type="range" min="0" max="30" value="5" data-del /> <b data-delval></b></label>
      <label>Records per user <input type="range" min="500" max="50000" step="500" value="5000" data-rec /> <b data-recval></b></label>
      <label>Days of history the server keeps <input type="range" min="7" max="90" value="35" data-ret /> <b data-retval></b></label>
      <label>Polling interval of an open app (seconds) <input type="range" min="5" max="300" step="5" value="30" data-poll /> <b data-pollval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a change-log entry is about 360 bytes (300 bytes of mutation plus an id, a timestamp and a sequence number), a record is about 500 bytes and compresses about 4 times in a first sync, the busiest hour carries 15% of a day's edits, 10% of the active devices have the app open at any moment, a push hint lets a client pull once for a batch of about 5 edits, and every active device reconnects within a 60-second jittered window after an outage.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const gb = (bytes: number) => `${(bytes / 1e9).toLocaleString('en-US', { maximumFractionDigits: 1 })} GB`;
    function draw() {
      const users = val('[data-u]') * 1000; const dv = val('[data-dv]'); const act = val('[data-act]') / 100; const ed = val('[data-ed]');
      const del = val('[data-del]') / 100; const rec = val('[data-rec]'); const ret = val('[data-ret]'); const poll = val('[data-poll]');
      ['u', 'dv', 'act', 'ed', 'del', 'rec', 'ret', 'poll'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perDay = users * act * ed; const peak = (perDay * 0.15) / 3600; const entry = 360;
      const activeDevices = users * act * dv; const online = activeDevices * 0.1;
      const data: [string, string][] = [
        ['Mutations per day', fmt(perDay)],
        ['Mutations per second in the busiest hour', fmt(peak)],
        ['Change log written per day', gb(perDay * entry)],
        [`Change log kept for ${ret} days`, gb(perDay * entry * ret)],
        ['Tombstones kept before they are collected', fmt(perDay * del * ret)],
        ['First sync of a new device, compressed', `${((rec * 500) / 4 / 1e6).toFixed(2)} MB`],
        ['Pull requests per second if open apps poll', fmt(online / poll)],
        ['Pull requests per second with a push hint', fmt((peak / 5) * (dv - 1))],
        ['Reconnect burst after an outage (requests per second)', fmt(activeDevices / 60)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
