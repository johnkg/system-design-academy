---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The change log grows with every edit and every delete, and a long retention window (to let people return after weeks) multiplies it. Polling or pushing decides how many requests idle devices cost.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Users (thousands)" name="u" min="10" max="2000" step="10" value="300" />
      <RangeField label="Devices per user" name="dv" min="1" max="4" value="2" />
      <RangeField label="Share of users active on a day (%)" name="act" min="5" max="100" value="40" />
      <RangeField label="Edits per active user per day" name="ed" min="10" max="500" step="10" value="80" />
      <RangeField label="Share of edits that are deletes (%)" name="del" min="0" max="30" value="5" />
      <RangeField label="Records per user" name="rec" min="500" max="50000" step="500" value="5000" />
      <RangeField label="Days of history the server keeps" name="ret" min="7" max="90" value="35" />
      <RangeField label="Polling interval of an open app (seconds)" name="poll" min="5" max="300" step="5" value="30" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a change-log entry is about 360 bytes (300 bytes of mutation plus an id, a timestamp and a sequence number), a record is about 500 bytes and compresses about 4 times in a first sync, the busiest hour carries 15% of a day's edits, 10% of the active devices have the app open at any moment, a push hint lets a client pull once for a batch of about 5 edits, and every active device reconnects within a 60-second jittered window after an outage.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 9; // output lines below
    const THOUSAND = 1000; const MB = 1e6; const HOUR_S = 3600;
    const BUSIEST_HOUR_SHARE = 0.15; // share of a day's edits made in the busiest hour
    const ONLINE_SHARE = 0.1; // active devices with the app open at once
    const RECORD_BYTES = 500; const COMPRESSION = 4; // one record in a first sync, and its compression
    const EDITS_PER_HINT = 5; // edits coalesced into one push hint
    const RECONNECT_S = 60; // devices reconnect spread over a minute after an outage
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const gb = (bytes: number) => `${(bytes / 1e9).toLocaleString('en-US', { maximumFractionDigits: 1 })} GB`;
    function draw() {
      const users = val('[data-u]') * THOUSAND; const dv = val('[data-dv]'); const act = val('[data-act]') / 100; const ed = val('[data-ed]');
      const del = val('[data-del]') / 100; const rec = val('[data-rec]'); const ret = val('[data-ret]'); const poll = val('[data-poll]');
      ['u', 'dv', 'act', 'ed', 'del', 'rec', 'ret', 'poll'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perDay = users * act * ed; const peak = (perDay * BUSIEST_HOUR_SHARE) / HOUR_S; const entry = 360;
      const activeDevices = users * act * dv; const online = activeDevices * ONLINE_SHARE;
      const data: [string, string][] = [
        ['Mutations per day', fmt(perDay)],
        ['Mutations per second in the busiest hour', fmt(peak)],
        ['Change log written per day', gb(perDay * entry)],
        [`Change log kept for ${ret} days`, gb(perDay * entry * ret)],
        ['Tombstones kept before they are collected', fmt(perDay * del * ret)],
        ['First sync of a new device, compressed', `${((rec * RECORD_BYTES) / COMPRESSION / MB).toFixed(2)} MB`],
        ['Pull requests per second if open apps poll', fmt(online / poll)],
        ['Pull requests per second with a push hint', fmt((peak / EDITS_PER_HINT) * (dv - 1))],
        ['Reconnect burst after an outage (requests per second)', fmt(activeDevices / RECONNECT_S)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
