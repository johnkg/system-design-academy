---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Retention times replication sets the disks, the write rate sets the partitions and brokers, and every consumer group adds a full copy of the reads.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Messages per second (thousands) <input type="range" min="10" max="2000" step="10" value="200" data-m /> <b data-mval></b></label>
      <label>Average message size (bytes) <input type="range" min="100" max="10000" step="100" value="1000" data-sz /> <b data-szval></b></label>
      <label>Replication factor <input type="range" min="1" max="5" value="3" data-rf /> <b data-rfval></b></label>
      <label>Retention (days) <input type="range" min="1" max="30" value="7" data-d /> <b data-dval></b></label>
      <label>Consumer groups <input type="range" min="1" max="10" value="3" data-g /> <b data-gval></b></label>
      <label>Messages per second one consumer can process (thousands) <input type="range" min="1" max="50" value="5" data-c /> <b data-cval></b></label>
      <label>Usable disk per broker (TB) <input type="range" min="2" max="48" step="2" value="20" data-tb /> <b data-tbval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: no compression, so the stored size equals the message size. A partition is kept to about 10 MB/s of writes so that its leader and its recovery stay manageable. A broker takes about 100 MB/s of incoming data, counting both producer writes and replica copies. Consumers that keep up read from the page cache, so reads add network traffic but no disk reads. 1 TB is 10^12 bytes.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 11 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmt1 = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    function draw() {
      const m = val('[data-m]') * 1000; const sz = val('[data-sz]'); const rf = val('[data-rf]'); const d = val('[data-d]'); const g = val('[data-g]'); const c = val('[data-c]') * 1000; const tb = val('[data-tb]');
      ['m', 'sz', 'rf', 'd', 'g', 'c', 'tb'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const inMb = (m * sz) / 1e6; const diskMb = inMb * rf; const replMb = inMb * (rf - 1); const readMb = inMb * g;
      const storeTb = (inMb * 1e6 * d * 86400 * rf) / 1e12;
      const partWrite = Math.ceil(inMb / 10); const partRead = Math.ceil(m / c); const parts = Math.max(partWrite, partRead);
      const brokersDisk = Math.ceil(storeTb / tb); const brokersIo = Math.ceil(diskMb / 100); const brokers = Math.max(brokersDisk, brokersIo, rf);
      const data: [string, string][] = [
        ['Producer traffic in', `${fmt1(inMb)} MB/s`],
        ['Disk writes across the cluster, with replicas', `${fmt1(diskMb)} MB/s`],
        ['Copy traffic between brokers', `${fmt1(replMb)} MB/s`],
        ['Reads by consumers, all groups', `${fmt1(readMb)} MB/s`],
        ['Storage for the retention period, with replicas', `${fmt1(storeTb)} TB`],
        ['Partitions needed for write throughput', fmt(partWrite)],
        ['Partitions needed for consumer parallelism', fmt(partRead)],
        ['Partitions to create', fmt(parts)],
        ['Brokers needed for storage', fmt(brokersDisk)],
        ['Brokers needed for incoming data', fmt(brokersIo)],
        ['Brokers to run (at least the replication factor)', fmt(brokers)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
