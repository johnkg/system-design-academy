---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Memory sets how many shards you need, and every query that has to ask all shards multiplies the work.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Players (millions) <input type="range" min="1" max="500" value="100" data-p /> <b data-pval></b></label>
      <label>Share playing in the busiest hour (%) <input type="range" min="1" max="30" value="10" data-act /> <b data-actval></b></label>
      <label>Matches per active player per hour <input type="range" min="1" max="20" value="4" data-m /> <b data-mval></b></label>
      <label>Boards each score is written to <input type="range" min="1" max="6" value="3" data-b /> <b data-bval></b></label>
      <label>Memory per shard (GB) <input type="range" min="8" max="128" step="8" value="32" data-gb /> <b data-gbval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a sorted-set entry takes about 100 bytes, one shard handles about 50,000 updates per second, 5% of the players look at the board per hour and each look needs a top-100 query and a rank query that visit every shard.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const p = val('[data-p]') * 1e6; const act = val('[data-act]') / 100; const m = val('[data-m]'); const boards = val('[data-b]'); const gb = val('[data-gb]');
      ['p', 'act', 'm', 'b', 'gb'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const updates = (p * act * m * boards) / 3600; const memGb = (p * boards * 100) / 1e9;
      const shardsMem = Math.ceil(memGb / gb); const shardsWrite = Math.ceil(updates / 50000); const shards = Math.max(shardsMem, shardsWrite);
      const looks = (p * 0.05) / 3600;
      const data: [string, string][] = [
        ['Score updates per second at the peak', fmt(updates)],
        ['Memory for all boards', `${fmt(memGb)} GB`],
        ['Shards needed for memory', fmt(shardsMem)],
        ['Shards needed for writes', fmt(shardsWrite)],
        ['Shards to run', fmt(shards)],
        ['Board views per second', fmt(looks)],
        ['Shard requests per second if every view asks all shards twice', fmt(looks * 2 * shards)],
        ['Shard requests per second with a 1-second cache', fmt(2 * shards * 3)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
