---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Memory sets how many shards you need, and every query that has to ask all shards multiplies the work.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Players (millions)" name="p" min="1" max="500" value="100" />
      <RangeField label="Share playing in the busiest hour (%)" name="act" min="1" max="30" value="10" />
      <RangeField label="Matches per active player per hour" name="m" min="1" max="20" value="4" />
      <RangeField label="Boards each score is written to" name="b" min="1" max="6" value="3" />
      <RangeField label="Memory per shard (GB)" name="gb" min="8" max="128" step="8" value="16" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a sorted-set entry takes about 100 bytes, one shard handles about 50,000 updates per second, 5% of the players look at the board per hour and each look needs a top-100 query and a rank query that visit every shard.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 8; // output lines below
    const MILLION = 1e6; const GB = 1e9; const HOUR_S = 3600;
    const ENTRY_BYTES = 100; // one player on one board, with sorted-set overhead
    const SHARD_WRITES = 50000; // score updates per second one shard sustains
    const VIEW_SHARE = 0.05; // players who look at a board in an hour
    const QUERIES_PER_VIEW = 2; // each view asks every shard twice (rank and neighbours)
    const CACHED_VIEWS = 3; // distinct cached views, each refreshed once per second
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const p = val('[data-p]') * MILLION; const act = val('[data-act]') / 100; const m = val('[data-m]'); const boards = val('[data-b]'); const gb = val('[data-gb]');
      ['p', 'act', 'm', 'b', 'gb'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const updates = (p * act * m * boards) / HOUR_S; const memGb = (p * boards * ENTRY_BYTES) / GB;
      const shardsMem = Math.ceil(memGb / gb); const shardsWrite = Math.ceil(updates / SHARD_WRITES); const shards = Math.max(shardsMem, shardsWrite);
      const looks = (p * VIEW_SHARE) / HOUR_S;
      const data: [string, string][] = [
        ['Score updates per second at the peak', fmt(updates)],
        ['Memory for all boards', `${fmt(memGb)} GB`],
        ['Shards needed for memory', fmt(shardsMem)],
        ['Shards needed for writes', fmt(shardsWrite)],
        ['Shards to run', fmt(shards)],
        ['Board views per second', fmt(looks)],
        ['Shard requests per second if every view asks all shards twice', fmt(looks * QUERIES_PER_VIEW * shards)],
        ['Shard requests per second with a 1-second cache', fmt(QUERIES_PER_VIEW * shards * CACHED_VIEWS)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
