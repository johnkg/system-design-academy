---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The feature lookups set the load on the counter store, and the model time and the lookup fan-out decide whether the 100 ms budget holds.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Payments per second at the peak <input type="range" min="500" max="20000" step="500" value="5000" data-p /> <b data-pval></b></label>
      <label>Average payment (dollars) <input type="range" min="10" max="500" step="10" value="60" data-v /> <b data-vval></b></label>
      <label>Fraud rate (basis points, 10 = 0.1%) <input type="range" min="1" max="100" value="10" data-f /> <b data-fval></b></label>
      <label>Feature lookups per payment <input type="range" min="2" max="24" value="8" data-l /> <b data-lval></b></label>
      <label>Active cards (millions) <input type="range" min="1" max="200" value="50" data-c /> <b data-cval></b></label>
      <label>Model time per score (ms) <input type="range" min="1" max="40" value="8" data-m /> <b data-mval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the daily average is 35% of the peak rate, 3% of payments are challenged, each payment updates 5 counter keys (card, device, IP address, address, merchant), there are 2.5 counter keys per active card, a key takes about 250 bytes (three windows of six buckets) and is stored on 2 replicas, rules take 2 ms, the scoring service runs at 50% CPU, and the network takes 15 ms. Lookups run in parallel, with a 99th percentile of 6 ms plus 0.5 ms per lookup.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 8; // one per output line
    const BASIS_POINTS = 10000; const MILLION = 1e6; const DAY_S = 86400; const MS_PER_S = 1000; const BYTES_PER_GB = 1e9;
    const AVG_TO_PEAK = 0.35; // a day's average load is 35% of the peak
    const COUNTER = { perCard: 2.5, bytes: 250, replicas: 2 }; // counter sets per card, bytes each, copies
    const LAT_MS = { network: 6, perLookup: 0.5, rules: 2, overhead: 15 }; // latency budget parts (plus the model)
    const CORE_UTIL = 0.5; const BUDGET_MS = 100; const UPDATES_PER_PAYMENT = 5; const CHALLENGE_SHARE = 0.03;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const p = val('[data-p]'); const v = val('[data-v]'); const f = val('[data-f]') / BASIS_POINTS; const l = val('[data-l]'); const cards = val('[data-c]') * MILLION; const m = val('[data-m]');
      ['p', 'v', 'f', 'l', 'c', 'm'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perDay = p * DAY_S * AVG_TO_PEAK; const fraudDay = perDay * f;
      const memGb = (cards * COUNTER.perCard * COUNTER.bytes * COUNTER.replicas) / BYTES_PER_GB;
      const cores = Math.ceil((p * (m + LAT_MS.rules)) / MS_PER_S / CORE_UTIL);
      const total = LAT_MS.network + LAT_MS.perLookup * l + LAT_MS.rules + m + LAT_MS.overhead;
      const data: [string, string][] = [
        ['Payments per day', fmt(perDay)],
        ['Fraud payments per day, and their value', `${fmt(fraudDay)}, ${fmt(fraudDay * v)} dollars`],
        ['Counter reads per second', fmt(p * l)],
        ['Counter updates per second', fmt(p * UPDATES_PER_PAYMENT)],
        [`Counter memory with ${COUNTER.replicas} replicas`, `${memGb.toFixed(1)} GB`],
        ['CPU cores for rules and model', fmt(cores)],
        [`Time used of the ${BUDGET_MS} ms budget`, `${total.toFixed(1)} ms ${total <= BUDGET_MS ? '(inside)' : '(over)'}`],
        ['Challenges per day', fmt(perDay * CHALLENGE_SHARE)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
