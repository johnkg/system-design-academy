---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The dispute rate sets everything: how many cases are open at once, how many deadlines are ticking, and how much money is held back.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Card payments per month (millions) <input type="range" min="1" max="500" value="50" data-tx /> <b data-txval></b></label>
      <label>Dispute rate (%) <input type="range" min="0.1" max="2" step="0.1" value="0.6" data-rate /> <b data-rateval></b></label>
      <label>Average payment ($) <input type="range" min="10" max="500" step="10" value="60" data-amt /> <b data-amtval></b></label>
      <label>Response window (days) <input type="range" min="5" max="30" value="14" data-win /> <b data-winval></b></label>
      <label>Days from opening to ruling <input type="range" min="30" max="120" step="5" value="60" data-life /> <b data-lifeval></b></label>
      <label>Disputes won (%) <input type="range" min="10" max="60" step="5" value="30" data-won /> <b data-wonval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a month has 30 days, each dispute makes 5 notices (opened, evidence requested, submitted, ruling and one update) and each arrives twice (webhook and file), the network fee is 15 dollars and is kept even when the dispute is won, a merchant responds on average halfway through the window, 60% of disputes are contested with a packet of about 3 MB, and a lost dispute costs the whole payment. Card networks watch merchants whose dispute rate goes above about 1%.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 10 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const usd = (n: number) => `$${fmt(n)}`;
    function draw() {
      const tx = val('[data-tx]') * 1e6; const rate = val('[data-rate]') / 100; const amt = val('[data-amt]'); const win = val('[data-win]'); const life = val('[data-life]'); const won = val('[data-won]') / 100;
      ['tx', 'rate', 'amt', 'win', 'life', 'won'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perMonth = tx * rate; const perDay = perMonth / 30;
      const openNow = perDay * life; const timers = (perDay * win) / 2;
      const held = openNow * amt; const fees = perMonth * 15; const lost = perMonth * (1 - won) * amt;
      const gb = (perMonth * 0.6 * 3) / 1000;
      const data: [string, string][] = [
        ['New disputes per month', fmt(perMonth)],
        ['New disputes per day', fmt(perDay)],
        ['Notice deliveries per day (5 notices, each sent twice)', fmt(perDay * 10)],
        ['Disputes open at any moment', fmt(openNow)],
        ['Deadlines still ticking at any moment', fmt(timers)],
        ['Money held back as provisional debits', usd(held)],
        ['Network fees per month', usd(fees)],
        ['Money lost for good per month, with fees', usd(lost + fees)],
        ['Evidence stored per month', `${fmt(gb)} GB`],
        ['Rate against the 1% watch line', rate > 0.01 ? 'above it, so the platform is flagged' : rate >= 0.005 ? 'between 0.5% and 1%, so watch it' : 'below 0.5%'],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
