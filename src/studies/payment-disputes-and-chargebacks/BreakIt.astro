---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Three ways to lose money in disputes" hint="Replay 1,000 disputes through the design. Switch each safeguard on and off and watch which kind of loss appears or goes away.">
  <ol class="how">
    <li>Start with the defaults, the first attempt: <b>242</b> duplicate notices are applied twice, <b>52</b> deadlines are missed because two restarts wiped the in-memory timers, and <b>69</b> refunds pay a customer whose dispute is then lost.</li>
    <li>Choose <b>one notice id, one effect</b>: duplicates drop to <b>0</b>. Choose <b>stored deadlines</b>: missed deadlines drop to <b>0</b>, whatever the number of restarts.</li>
    <li>Choose <b>hold the refund</b>: double payments drop to <b>0</b>, and the price is that <b>96</b> customers wait for their refund until the dispute is decided.</li>
  </ol>
  <div class="pg dpb" data-dpb>
    <div class="pg-row">
      <label>Duplicate notices <select class="pg-in" data-dedupe>
        <option value="no" selected>apply every delivery</option>
        <option value="yes">one notice id, one effect</option>
      </select></label>
      <label>Deadlines are kept <select class="pg-in" data-stored>
        <option value="mem" selected>in process memory</option>
        <option value="db">as stored rows with a sweeper</option>
      </select></label>
      <RangeField label="Service restarts in 100 days" name="r" min="0" max="3" value="2" />
      <label>Refund of a disputed payment <select class="pg-in" data-refund>
        <option value="allow" selected>paid at once</option>
        <option value="hold">held until the ruling</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Debited twice for one dispute</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Deadlines missed after a restart</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Customer paid twice</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Refunds made to wait</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 1,000 disputes opened at random days over 100 days, each with a 7-day response window and a 15 dollar fee, and amounts from 20 to 199 dollars. 25% of opened notices arrive twice (webhook and file). 35% of merchants respond only after a reminder, so they miss the deadline if a restart on a day inside their window wiped the timer (restarts happen on days 25, 50 and 75, in that order). 10% of disputed payments get a refund request, and 70% of disputes are lost. With stored deadlines the sweeper finds every due dispute after a restart.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-dpb]').forEach((root) => {
    const q = query(root);
    const FEE = 15; const WINDOW = 7; const N = 1000;
    const RESTART_DAYS = [25, 50, 75]; // when the service restarts, if it does
    const SHARE = { dup: 0.25, needsReply: 0.35, refunded: 0.1, lostAnyway: 0.7 }; // dispute mix
    const OPEN_DAYS = 100; const AMT = { min: 20, range: 180 }; // disputes open over 100 days; $20-$199
    const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
    function simulate(dedupe: boolean, stored: boolean, restarts: number, hold: boolean) {
      // Numerical Recipes LCG
      let seed = 77; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
      const days = RESTART_DAYS.slice(0, restarts);
      let dupN = 0, dupUsd = 0, missN = 0, missUsd = 0, dblN = 0, dblUsd = 0, heldN = 0;
      for (let i = 0; i < N; i++) {
        const dup = rnd() < SHARE.dup, needs = rnd() < SHARE.needsReply, open = Math.floor(rnd() * OPEN_DAYS), refund = rnd() < SHARE.refunded, lost = rnd() < SHARE.lostAnyway, amt = AMT.min + Math.floor(rnd() * AMT.range);
        if (dup && !dedupe) { dupN++; dupUsd += amt + FEE; }
        if (!stored && needs && days.some((r) => r >= open && r < open + WINDOW)) { missN++; missUsd += amt; }
        if (refund) { if (!hold) { if (lost) { dblN++; dblUsd += amt; } } else heldN++; }
      }
      return { dupN, dupUsd, missN, missUsd, dblN, dblUsd, heldN };
    }
    function draw() {
      const dedupe = q<HTMLSelectElement>('[data-dedupe]').value === 'yes'; const stored = q<HTMLSelectElement>('[data-stored]').value === 'db';
      const hold = q<HTMLSelectElement>('[data-refund]').value === 'hold'; const r = Number(q<HTMLInputElement>('[data-r]').value);
      q('[data-rval]').textContent = String(r);
      const x = simulate(dedupe, stored, r, hold);
      q('[data-o1]').textContent = `${x.dupN} disputes`; q('[data-n1]').textContent = x.dupN ? `${usd(x.dupUsd)} taken from merchants twice, with the fee` : 'the second delivery changed nothing';
      q('[data-o2]').textContent = `${x.missN} disputes`; q('[data-n2]').textContent = x.missN ? `${usd(x.missUsd)} lost without a reply` : stored ? 'every deadline is a stored row, so restarts change nothing' : 'no restarts, so no timers were lost';
      q('[data-o3]').textContent = `${x.dblN} customers`; q('[data-n3]').textContent = x.dblN ? `${usd(x.dblUsd)} paid out and also taken by the bank` : 'refunds wait for the ruling';
      q('[data-o4]').textContent = `${x.heldN} refunds`; q('[data-n4]').textContent = x.heldN ? 'the customer waits until the dispute is decided' : 'nobody waits, but see the losses on the left';
      q<HTMLElement>('[data-b1]').style.setProperty('--c', x.dupN ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', x.missN ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', x.dblN ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b4]').style.setProperty('--c', x.heldN ? 'var(--accent)' : 'var(--good)');
      const bad = x.dupN + x.missN + x.dblN > 0; const out = q('[data-verdict]'); out.classList.toggle('bad', bad);
      const problems: string[] = [];
      if (x.dupN) problems.push(`${x.dupN} duplicate notices were applied twice`);
      if (x.missN) problems.push(`${x.missN} deadlines were missed because timers died in a restart`);
      if (x.dblN) problems.push(`${x.dblN} customers were refunded for disputes the platform then lost`);
      const unheld = simulate(dedupe, stored, r, false).dblUsd; // what paying refunds at once would have cost in this same run
      out.textContent = bad ? `${problems.join(', ')}. Each safeguard fixes exactly one of these.` : `No losses in 1,000 disputes. The cost is that ${x.heldN} refunds wait for the ruling${unheld ? `, a small price next to ${usd(unheld)} paid twice` : ''}.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
