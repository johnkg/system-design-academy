---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The re-ranker runs on every search, so the number of candidates and the cost of scoring each one decide both the latency and the size of the fleet.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Searches per day (millions) <input type="range" min="5" max="500" step="5" value="50" data-s /> <b data-sval></b></label>
      <label>Peak traffic compared with the average (times) <input type="range" min="1" max="6" value="3" data-pk /> <b data-pkval></b></label>
      <label>Candidates re-ranked per search <input type="range" min="50" max="1000" step="50" value="300" data-c /> <b data-cval></b></label>
      <label>Scoring cost per candidate (microseconds) <input type="range" min="20" max="2000" step="20" value="200" data-us /> <b data-usval></b></label>
      <label>Total latency budget (ms) <input type="range" min="100" max="200" step="10" value="150" data-bud /> <b data-budval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: query understanding, retrieval with first-stage scoring, feature fetch and result assembly with network use 10 + 40 + 20 + 25 = 95 ms before the re-ranker. One search scores its candidates on 4 threads. Servers have 16 cores and run at 50% utilisation at the peak. 10 results are shown per search, and one logged impression is about 200 bytes. The "safe" candidate count keeps 30% of the remaining budget free for slow requests.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const perDay = val('[data-s]') * 1e6; const peakX = val('[data-pk]'); const cand = val('[data-c]'); const us = val('[data-us]'); const bud = val('[data-bud]');
      ['s', 'pk', 'c', 'us', 'bud'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const avg = perDay / 86400; const peak = avg * peakX;
      const cpuMs = (cand * us) / 1000; const rerankMs = cpuMs / 4;
      const used = 95 + rerankMs; const room = bud - 95;
      const safe = Math.floor((room * 0.7 * 4 * 1000) / us);
      const cores = Math.ceil((peak * cpuMs) / 1000 / 0.5); const servers = Math.ceil(cores / 16);
      const gbDay = (perDay * 10 * 200) / 1e9;
      const data: [string, string][] = [
        ['Searches per second, average', fmt(avg)],
        ['Searches per second at the peak', fmt(peak)],
        ['Re-ranker CPU time per search', `${cpuMs.toFixed(1)} ms`],
        ['Re-ranker latency on 4 threads', `${rerankMs.toFixed(1)} ms`],
        ['Total latency used', `${used.toFixed(1)} ms of ${bud} ms ${used <= bud ? '(fits)' : '(over budget)'}`],
        ['Most candidates that fit with a safety margin', fmt(Math.max(0, safe))],
        ['Re-ranker cores at the peak', fmt(cores)],
        ['Re-ranker servers (16 cores each)', fmt(servers)],
        ['Impression log per day', `${gbDay.toFixed(0)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
