---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The re-ranker runs on every search, so the number of candidates and the cost of scoring each one decide both the latency and the size of the fleet.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Searches per day (millions)" name="s" min="5" max="500" step="5" value="50" />
      <RangeField label="Peak traffic compared with the average (times)" name="pk" min="1" max="6" value="3" />
      <RangeField label="Candidates re-ranked per search" name="c" min="50" max="1000" step="50" value="300" />
      <RangeField label="Scoring cost per candidate (microseconds)" name="us" min="20" max="2000" step="20" value="200" />
      <RangeField label="Total latency budget (ms)" name="bud" min="100" max="200" step="10" value="150" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: query understanding, retrieval with first-stage scoring, feature fetch and result assembly with network use 10 + 40 + 20 + 25 = 95 ms before the re-ranker. One search scores its candidates on 4 threads. Servers have 16 cores and run at 50% utilisation at the peak. 10 results are shown per search, and one logged impression is about 200 bytes. The "safe" candidate count keeps 30% of the remaining budget free for slow requests.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 9; // one per output line
    const MILLION = 1e6; const DAY_S = 86400; const US_PER_MS = 1000; const MS_PER_S = 1000; const BYTES_PER_GB = 1e9;
    const THREADS = 4; // re-ranker threads per search
    const BASE_MS = 95; // latency of every other stage
    const MARGIN = 0.7; // use 70% of the remaining budget
    const CORE_UTIL = 0.5; const CORES_PER_SERVER = 16; // run cores at 50%
    const LOG = { resultsPerSearch: 10, bytesPerResult: 200 }; // impression log
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const perDay = val('[data-s]') * MILLION; const peakX = val('[data-pk]'); const cand = val('[data-c]'); const us = val('[data-us]'); const bud = val('[data-bud]');
      ['s', 'pk', 'c', 'us', 'bud'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const avg = perDay / DAY_S; const peak = avg * peakX;
      const cpuMs = (cand * us) / US_PER_MS; const rerankMs = cpuMs / THREADS;
      const used = BASE_MS + rerankMs; const room = bud - BASE_MS;
      const safe = Math.floor((room * MARGIN * THREADS * US_PER_MS) / us);
      const cores = Math.ceil((peak * cpuMs) / MS_PER_S / CORE_UTIL); const servers = Math.ceil(cores / CORES_PER_SERVER);
      const gbDay = (perDay * LOG.resultsPerSearch * LOG.bytesPerResult) / BYTES_PER_GB;
      const data: [string, string][] = [
        ['Searches per second, average', fmt(avg)],
        ['Searches per second at the peak', fmt(peak)],
        ['Re-ranker CPU time per search', `${cpuMs.toFixed(1)} ms`],
        [`Re-ranker latency on ${THREADS} threads`, `${rerankMs.toFixed(1)} ms`],
        ['Total latency used', `${used.toFixed(1)} ms of ${bud} ms ${used <= bud ? '(fits)' : '(over budget)'}`],
        ['Most candidates that fit with a safety margin', fmt(Math.max(0, safe))],
        ['Re-ranker cores at the peak', fmt(cores)],
        [`Re-ranker servers (${CORES_PER_SERVER} cores each)`, fmt(servers)],
        ['Impression log per day', `${gbDay.toFixed(0)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
