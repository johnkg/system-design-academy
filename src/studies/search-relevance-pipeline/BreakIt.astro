---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Learning from clicks" hint="The ranker is retrained every round on the clicks it caused. Choose how it reads the clicks and whether it ever shows something it has no data for, then see where the ranking ends up after 6 rounds.">
  <ol class="how">
    <li>Start with <b>raw clicks</b> and <b>no exploration</b>: NDCG stays at <b>0.79</b> in every round. Only the 10 products on page one ever get clicks, so <b>50 of the 60</b> products never get a single impression, and 4 of the 8 perfect products stay hidden.</li>
    <li>Switch to <b>position-corrected clicks</b> and keep exploration at 0: still <b>0.79</b>. Correcting for position cannot create data about products that were never shown.</li>
    <li>Set exploration to <b>10%</b>: all 8 perfect products reach the top 10 and no product is left unseen. Raw clicks end at <b>0.97</b>, corrected clicks at <b>1.00</b>, because raw clicks reward whoever sat near the top. At <b>50%</b> the learning is the same, but the page shoppers actually see is worse (<b>0.96</b> against 0.99 at 10%).</li>
  </ol>
  <div class="pg srb" data-srb>
    <div class="pg-row">
      <label>Learn from <select class="pg-in" data-mode>
        <option value="raw" selected>raw click rate</option>
        <option value="ips">clicks divided by the chance the position was looked at</option>
      </select></label>
      <label>Searches that swap one slot for an unproven product (%) <input type="range" min="0" max="50" step="5" value="0" data-ex /> <b data-exval></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Ranking quality (NDCG@10) by round</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Perfect products in the top 10</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Products that never got an impression</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Quality of the page shoppers saw (last round)</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 60 products with a judged grade of 0 to 3 (8 of them grade 3). The starting order comes from a first-stage score that is only loosely related to the grade. Each round has 5,000 searches that show 10 products. The chance a position is looked at falls from 100% at position 1 to 5% at position 10. A looked-at product is clicked 2%, 10%, 30% or 60% of the time by grade. The model is retrained on all logs so far, scoring each product as its (corrected) click total divided by its impressions plus 5. An exploration search replaces position 5 with a random product from outside the top 10. The numbers come from one seeded run.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-srb]').forEach((root) => {
    const q = query(root);
    const N = 60; const SHOWN = 10; const ROUNDS = 6; const PER = 5000;
    const EXAMINE = [100, 55, 38, 28, 20, 15, 11, 8, 6, 5]; const CLICK = [2, 10, 30, 60];
    const SEED = 11;
    const GRADE_PCT = [35, 65, 85]; // cumulative percent of products below grade 1, 2, 3
    const TOP_GRADE = 3; // a perfect product
    const START = { perGrade: 5, noise: 40 }; // the first ranking: grade x 5 plus noise 0..39
    const EXPLORE_SLOT = 4; // page position (0-based) that shows an unproven product
    const PRIOR = 5; // impressions added to every product when estimating its click rate
    const GOOD = 0.95; const CLEAN = 0.995; // quality that counts as good; as fully clean
    function run(mode: string, explore: number) {
      let seed = SEED; const rnd = (n: number) => { seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0; return Math.floor(seed / 65536) % n; };
      const rel = Array.from({ length: N }, () => { const r = rnd(100); return r < GRADE_PCT[0] ? 0 : r < GRADE_PCT[1] ? 1 : r < GRADE_PCT[2] ? 2 : TOP_GRADE; });
      const start = [...rel.keys()].map((i) => ({ i, s: rel[i] * START.perGrade + rnd(START.noise) })).sort((a, b) => b.s - a.s || a.i - b.i).map((o) => o.i);
      const dcgOf = (order: number[]) => order.slice(0, SHOWN).reduce((s, it, p) => s + ((1 << rel[it]) - 1) / Math.log2(p + 2), 0);
      const ideal = dcgOf([...rel.keys()].sort((a, b) => rel[b] - rel[a] || a - b));
      const shown = new Array(N).fill(0); const val = new Array(N).fill(0);
      const gems = rel.map((r, i) => (r === TOP_GRADE ? i : -1)).filter((i) => i >= 0);
      let order = start; let served = 0; const hist: number[] = [];
      for (let r = 0; r < ROUNDS; r++) {
        hist.push(dcgOf(order) / ideal);
        for (let s = 0; s < PER; s++) {
          const list = order.slice(0, SHOWN);
          if (explore > 0 && rnd(100) < explore) { const pool = order.slice(SHOWN); list[EXPLORE_SLOT] = pool[rnd(pool.length)]; }
          if (r === ROUNDS - 1) served += dcgOf(list) / ideal;
          for (let p = 0; p < SHOWN; p++) { const it = list[p]; shown[it]++; if (rnd(100) < EXAMINE[p] && rnd(100) < CLICK[rel[it]]) val[it] += mode === 'ips' ? 100 / EXAMINE[p] : 1; }
        }
        const est = val.map((v, i) => v / (shown[i] + PRIOR));
        order = [...est.keys()].sort((a, b) => est[b] - est[a] || a - b);
      }
      hist.push(dcgOf(order) / ideal);
      const top = order.slice(0, SHOWN);
      return { hist, gems: gems.length, gemsIn: gems.filter((g) => top.includes(g)).length, unseen: shown.filter((x) => x === 0).length, served: served / PER };
    }
    const cache = new Map<string, ReturnType<typeof run>>();
    function draw() {
      const mode = q<HTMLSelectElement>('[data-mode]').value; const ex = Number(q<HTMLInputElement>('[data-ex]').value);
      q('[data-exval]').textContent = `${ex}%`;
      const key = `${mode}:${ex}`; if (!cache.has(key)) cache.set(key, run(mode, ex));
      const r = cache.get(key)!; const final = r.hist[r.hist.length - 1];
      q('[data-o1]').textContent = r.hist.map((x) => x.toFixed(2)).join(' > ');
      q('[data-n1]').textContent = `start, then after each of the ${ROUNDS} rounds; 1.00 is the ideal order`;
      q('[data-o2]').textContent = `${r.gemsIn} of ${r.gems}`;
      q('[data-n2]').textContent = 'grade 3 products on page one at the end';
      q('[data-o3]').textContent = `${r.unseen} of ${N}`;
      q('[data-n3]').textContent = r.unseen > 0 ? 'with no impressions there is nothing to learn from' : 'every product has been tried at least once';
      q('[data-o4]').textContent = r.served.toFixed(2);
      q('[data-n4]').textContent = ex > 0 ? `includes the cost of the unproven product in slot ${EXPLORE_SLOT + 1} on ${ex}% of searches` : 'no exploration, so this equals the ranking quality';
      const good = r.gemsIn === r.gems;
      q<HTMLElement>('[data-b1]').style.setProperty('--c', final >= GOOD ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', good ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', r.unseen === 0 ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b4]').style.setProperty('--c', r.served >= GOOD ? 'var(--good)' : 'var(--accent)');
      const out = q('[data-verdict]'); out.classList.toggle('bad', !good);
      out.textContent = r.unseen > 0
        ? `Stuck at ${final.toFixed(2)}: ${r.unseen} products were never shown, so the model has no clicks to learn from, and ${r.gems - r.gemsIn} perfect products stay hidden. The ranking confirms itself.`
        : mode === 'raw'
          ? `Every product got tried and ${r.gemsIn} of ${r.gems} perfect products made page one, ending at ${final.toFixed(2)}.${final < CLEAN ? ' Raw click rates still reward products for sitting high, so the order is not fully clean.' : ' Here the exploration was strong enough to undo the position bias, but raw click rates still reward sitting high, so at lower rates the order drifts.'}`
          : `Every product got tried, the position correction removed the advantage of sitting high, and the ranking ends at ${final.toFixed(2)}. Exploration costs a little on the page shoppers see (${r.served.toFixed(2)}), and that cost grows with the exploration rate.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
