---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Shard size is a trade: more tenants per shard is cheaper, but a failure, a restore or a migration then touches more of them.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Tenants (thousands) <input type="range" min="1" max="50" value="5" data-t /> <b data-tval></b></label>
      <label>Large tenants with their own shard <input type="range" min="0" max="100" value="20" data-big /> <b data-bigval></b></label>
      <label>Data per small tenant (GB) <input type="range" min="0.5" max="20" step="0.5" value="2" data-gb /> <b data-gbval></b></label>
      <label>Tenants per pooled shard <input type="range" min="50" max="2000" step="50" value="500" data-tps /> <b data-tpsval></b></label>
      <label>Tables per tenant schema <input type="range" min="20" max="200" step="10" value="60" data-tab /> <b data-tabval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each table has 2 indexes, so a schema holds 3 relations per table. A restore runs at 250 MB per second. A pooled shard is filled to its tenant count with tenants of the size chosen above, and the large tenants each have one dedicated shard. Database-per-tenant means one database for every tenant. The numbers show orders of magnitude, not a sizing.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 9; // one per output line
    const THOUSAND = 1000; const MB_PER_GB = 1000;
    const RELATIONS_PER_TABLE = 3; // a table plus about two indexes
    const RESTORE_MBPS = 250;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const dur = (s: number) => (s < 90 ? `${Math.round(s)} seconds` : s < 5400 ? `${Math.round(s / 60)} minutes` : `${(s / 3600).toFixed(1)} hours`);
    function draw() {
      const tenants = val('[data-t]') * THOUSAND; const big = Math.min(val('[data-big]'), tenants); const gb = val('[data-gb]'); const tps = val('[data-tps]'); const tabs = val('[data-tab]');
      [['t', 'tval'], ['big', 'bigval'], ['gb', 'gbval'], ['tps', 'tpsval'], ['tab', 'tabval']].forEach(([k, v]) => (q(`[data-${v}]`).textContent = String(val(`[data-${k}]`))));
      const small = tenants - big; const pooled = Math.ceil(small / tps); const perShardGb = (small * gb) / pooled; const rel = tabs * RELATIONS_PER_TABLE;
      const data: [string, string][] = [
        ['Small tenants in the pool', fmt(small)],
        ['Pooled shards, plus dedicated shards', `${fmt(pooled)} + ${fmt(big)} = ${fmt(pooled + big)}`],
        ['Data on one pooled shard', `${fmt(perShardGb)} GB`],
        ['Share of customers hit by one pooled shard failing', `${((100 * Math.min(tps, small)) / tenants).toFixed(1)}%`],
        ['Databases to migrate: shared tables, against one per tenant', `${fmt(pooled + big)} against ${fmt(tenants)}`],
        ['Relations (tables and indexes) in one shard, shared tables', fmt(rel)],
        ['Relations in one shard, schema per tenant', fmt(rel * Math.min(tps, small))],
        ['Restore one tenant from a backup: shared shard, restore it all', dur((perShardGb * MB_PER_GB) / RESTORE_MBPS)],
        ['Restore one tenant from a backup: database per tenant', dur((gb * MB_PER_GB) / RESTORE_MBPS)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
