---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How many tasks a cell runs, how much a Borgmaster has to handle each second, how much machine capacity reclamation recovers, and how long a cold scheduling pass would take. A teaching model with round numbers, not Google's data.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Machines in the cell (thousands)" name="m" min="1" max="50" step="1" value="10" />
      <RangeField label="Tasks on each machine" name="t" min="3" max="30" step="1" value="9" />
      <RangeField label="Task arrivals per minute" name="a" min="100" max="20000" step="100" value="10000" />
      <RangeField label="Seconds between Borglet polls" name="p" min="1" max="10" step="1" value="3" />
      <RangeField label="CPU limits of production tasks, as a share of the cell (%)" name="l" min="20" max="90" step="5" value="70" />
      <RangeField label="Share of those limits really used (%)" name="u" min="20" max="100" step="5" value="60" />
      <RangeField label="Safety margin on top of usage (% of limit)" name="s" min="0" max="30" step="5" value="10" />
      <RangeField label="Microseconds to score one task on one machine" name="x" min="1" max="200" step="1" value="20" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Teaching model, not Google's system or data. From the Borg paper: the median cell has about 10,000 machines, several cells see more than 10,000 task arrivals a minute, the Borgmaster polls each Borglet every few seconds, in a representative cell production jobs are allocated about 70% of the CPU and use about 60% of the total, half the machines run 9 or more tasks, and the scheduler uses score caching, equivalence classes and relaxed randomization to avoid scoring every machine. The scoring time, the arrival rate and the margin are my guesses that you can change. Assumptions: tasks are spread evenly, a production task's reservation is its usage plus the margin, the reclaimed capacity is all lent to batch work, and scoring every task on every machine is the worst case that the paper's techniques avoid.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const f1 = formatOneDecimalBelow100;
    const pct = (n: number) => `${(Math.round(n * 1000) / 1000).toLocaleString('en-US')}%`;
    function draw() {
      ['m', 't', 'a', 'p', 'l', 'u', 's', 'x'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const machines = val('[data-m]') * 1000; const perMachine = val('[data-t]'); const arrivals = val('[data-a]'); const poll = val('[data-p]');
      const limitShare = val('[data-l]'); const usedShare = val('[data-u]'); const margin = val('[data-s]'); const micros = val('[data-x]');
      const tasks = machines * perMachine;
      const reservedShare = Math.min(limitShare, (limitShare * usedShare) / 100 + (limitShare * margin) / 100); // as a share of the cell, never above the limit
      const lent = limitShare - reservedShare;
      const coldSeconds = (tasks * machines * micros) / 1e6;
      const data: [string, string][] = [
        ['Tasks running in the cell (thousands)', f1(tasks / 1000)],
        ['Task arrivals each second', f1(arrivals / 60)],
        ['Borglet polls each second the master must handle', f1(machines / poll)],
        ['Production limits as a share of the cell', `${f1(limitShare)}%`],
        ['Production reservations (usage plus margin) as a share of the cell', `${f1(reservedShare)}%`],
        ['Capacity that can be lent to batch work', `${f1(lent)}% of the cell`],
        ['Machines needed without reclamation to hold the same batch work', f1((machines * lent) / 100)],
        ['Time to score every task on every machine, with no tricks (days)', f1(coldSeconds / 86400)],
        ['Time if each task is scored on only 100 machines (seconds)', f1((tasks * 100 * micros) / 1e6)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
