---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="One lost update, two ways to copy" hint="Eight changes are sent to a replica and you choose which ones get lost on the way. Compare a copy that follows only a timestamp with a copy that follows a numbered log. A small model with round numbers, not Cloudflare's code or data.">
  <ol class="how">
    <li>Press <b>Reset</b>. With <b>Copy method</b> set to <b>Timestamp only</b> and entries <b>4</b> and <b>6</b> lost, the replica sees entry 8 last and believes it is up to date, but <b>2</b> keys are wrong: <b>page</b> still exists and <b>worker</b> is still v1.</li>
    <li>Set <b>Copy method</b> to <b>Numbered log</b>: the replica applies entries 1 to 3, sees that 5 is not 4, stops and asks again from entry 3. After it catches up, <b>0</b> keys are wrong.</li>
    <li>Set the method back to <b>Timestamp only</b> and lose only entry <b>8</b>, the newest: the replica is simply behind, asks for changes after entry 7 and gets it, so <b>0</b> keys are wrong.</li>
  </ol>
  <div class="pg qsb" data-qsb>
    <div class="pg-row">
      <label>Copy method <select class="pg-in" data-mode><option value="ts">Timestamp only</option><option value="log">Numbered log</option></select></label>
      <fieldset class="qsb-drop">
        <legend>Entries lost on the way to the replica</legend>
        <ul class="qsb-list" data-list></ul>
      </fieldset>
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Replica thinks it is at</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Does it know something is missing?</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Keys wrong after catching up</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <table class="qsb-tab">
      <caption class="pg-note">Value of each key at the source and on the replica after it has caught up as far as its method allows:</caption>
      <thead><tr><th scope="col">Key</th><th scope="col">Source</th><th scope="col">Replica</th><th scope="col">Result</th></tr></thead>
      <tbody data-body></tbody>
    </table>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: the source makes the eight changes in the list, numbered 1 to 8 (1 SET dns=A, 2 SET page=1, 3 SET worker=v1, 4 DEL page, 5 SET dns=B, 6 SET worker=v2, 7 SET cert=X, 8 SET dns=C). The replica applies the entries that arrive, in order. With a timestamp only, it remembers the time of the newest entry it received and later asks only for entries after that, so a lost entry older than the newest one is never asked for again, which is what Cloudflare describes for Kyoto Tycoon. With a numbered log, each entry must be exactly one higher than the last applied, so the replica stops at the first gap, asks again from its last applied entry and receives the lost ones. Real networks and retries are more complicated than this.</p>
  </div>
</PlaygroundShell>
<style>
  .qsb-drop { border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px; margin: 0; min-width: 0; }
  .qsb-drop legend { font-size: .85rem; padding: 0 4px; }
  .qsb-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .qsb-list label { display: inline-flex; gap: 6px; align-items: center; font-size: .85rem; }
  .qsb-tab { width: 100%; border-collapse: collapse; font-size: .88rem; }
  .qsb-tab caption { text-align: left; padding-bottom: 4px; }
  .qsb-tab th, .qsb-tab td { text-align: left; padding: 4px 6px; border-bottom: 1px solid var(--border); overflow-wrap: anywhere; }
  .qsb-tab td[data-k='bad'] { color: var(--bad-text); font-weight: 600; }
</style>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-qsb]').forEach((root) => {
    const q = query(root);
    type Op = { key: string; value: string | null; text: string };
    const LOG: Op[] = [
      { key: 'dns', value: 'A', text: 'SET dns=A' }, { key: 'page', value: '1', text: 'SET page=1' },
      { key: 'worker', value: 'v1', text: 'SET worker=v1' }, { key: 'page', value: null, text: 'DEL page' },
      { key: 'dns', value: 'B', text: 'SET dns=B' }, { key: 'worker', value: 'v2', text: 'SET worker=v2' },
      { key: 'cert', value: 'X', text: 'SET cert=X' }, { key: 'dns', value: 'C', text: 'SET dns=C' },
    ];
    const KEYS = ['dns', 'page', 'worker', 'cert'];
    const DEFAULT_LOST = [4, 6];
    const list = q('[data-list]');
    const boxes = LOG.map((op, i) => {
      const li = document.createElement('li'); const label = document.createElement('label'); const cb = document.createElement('input');
      cb.type = 'checkbox'; cb.value = String(i + 1);
      label.append(cb, `${i + 1} ${op.text}`); li.append(label); list.append(li); return cb;
    });
    const apply = (ids: number[]) => { const s: Record<string, string | null> = {}; ids.forEach((id) => { const o = LOG[id - 1]; s[o.key] = o.value; }); return s; };
    const show = (v: string | null | undefined) => (v == null ? 'absent' : v);
    function draw() {
      const log = q<HTMLSelectElement>('[data-mode]').value === 'log';
      const lost = new Set(boxes.filter((b) => b.checked).map((b) => Number(b.value)));
      const all = LOG.map((_, i) => i + 1);
      const got = all.filter((i) => !lost.has(i)); // entries that arrived the first time
      const newest = got.length ? got[got.length - 1] : 0;
      const firstGap = all.find((i) => lost.has(i)) ?? all.length + 1;
      // Timestamp: lost entries older than the newest received one are never asked for again. Numbered log: everything is recovered.
      const finalIds = log ? all : all.filter((i) => !lost.has(i) || i > newest);
      const source = apply(all); const replica = apply(finalIds);
      const body = q('[data-body]'); body.replaceChildren();
      let wrong = 0;
      KEYS.forEach((k) => {
        const bad = show(source[k]) !== show(replica[k]); if (bad) wrong++;
        const tr = document.createElement('tr');
        [k, show(source[k]), show(replica[k]), bad ? 'wrong' : 'correct'].forEach((t, i) => { const td = document.createElement('td'); td.textContent = t; if (i === 3) td.dataset.k = bad ? 'bad' : 'ok'; tr.append(td); });
        body.append(tr);
      });
      const gap = lost.size > 0 && firstGap < newest; // a lost entry sits before a received one
      const at = log ? firstGap - 1 : newest;
      q('[data-o1]').textContent = at ? `entry ${at}` : 'nothing yet';
      q('[data-n1]').textContent = log ? (gap ? `it applied entries 1 to ${at} and is holding the later ones back` : `it has applied every entry it received, up to ${at}`) : `the newest entry it received is ${newest || 'none'}, so it asks only for changes after that`;
      const knows = log && lost.size > 0;
      q('[data-o2]').textContent = log ? (gap ? `Yes, entry ${firstGap} is missing` : (knows ? 'Not yet, it is only behind' : 'Nothing is missing')) : 'No';
      q('[data-n2]').textContent = log ? 'each entry must be exactly one higher than the last applied' : 'a timestamp always moves forward, so a lost older entry looks like nothing';
      q('[data-o3]').textContent = String(wrong);
      q('[data-n3]').textContent = wrong ? `out of ${KEYS.length} keys, the replica differs from the source` : `all ${KEYS.length} keys match the source`;
      q<HTMLElement>('[data-b1]').style.setProperty('--c', 'var(--good)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', !log && gap ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', wrong ? 'var(--bad)' : 'var(--good)');
      const out = q('[data-verdict]'); out.classList.toggle('bad', wrong > 0);
      if (wrong) out.textContent = `The replica is silently wrong on ${wrong} of ${KEYS.length} keys and reports no problem. Switch to the numbered log so it notices the missing entry and asks for it again.`;
      else if (gap) out.textContent = `The replica stopped at entry ${at}, noticed that entry ${firstGap} was missing, asked again and now matches the source on all ${KEYS.length} keys.`;
      else out.textContent = lost.size ? `The lost entries were the newest, so the replica is only behind. It asks again and matches the source on all ${KEYS.length} keys.` : `Nothing was lost, so the replica matches the source on all ${KEYS.length} keys.`;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    q('[data-reset]').addEventListener('click', () => {
      q<HTMLSelectElement>('[data-mode]').value = 'ts';
      boxes.forEach((b) => (b.checked = DEFAULT_LOST.includes(Number(b.value))));
      draw();
    });
    boxes.forEach((b) => (b.checked = DEFAULT_LOST.includes(Number(b.value))));
    draw();
  });
</script>
