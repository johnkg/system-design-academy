---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Scanning every table in full for every check is what makes a quality platform unaffordable. See what metadata, incremental scans and sampling save, and how grouping cuts the pages.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Monitored tables (thousands) <input type="range" min="1" max="50" value="10" data-t /> <b data-tval></b></label>
      <label>Checks per table <input type="range" min="2" max="20" value="8" data-c /> <b data-cval></b></label>
      <label>Runs per table per day <input type="range" min="1" max="24" value="4" data-r /> <b data-rval></b></label>
      <label>Average table size (GB) <input type="range" min="10" max="2000" step="10" value="200" data-gb /> <b data-gbval></b></label>
      <label>Days of partitions kept <input type="range" min="30" max="1000" step="10" value="365" data-d /> <b data-dval></b></label>
      <label>Sample rate for scanning checks (%) <input type="range" min="1" max="100" value="1" data-s /> <b data-sval></b></label>
      <label>Alerts per 10,000 check runs <input type="range" min="1" max="50" value="5" data-f /> <b data-fval></b></label>
      <label>Alerts merged into one root cause <input type="range" min="1" max="20" value="5" data-g /> <b data-gval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: 60% of checks (freshness, volume, schema) are answered from table metadata and cost nothing to scan, the other 40% need to read data, an incremental scan reads only the newest daily partition, a sampled scan reads the sample rate of it, and scanning costs about 5 dollars per TB. Uniqueness cannot be sampled safely, so treat the sampled line as a lower bound. Alerts for the same root cause (an upstream table failing and everything downstream) are merged into one page.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 10 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const money = (n: number) => `$${fmt(n)}`;
    function draw() {
      const tables = val('[data-t]') * 1000; const checks = val('[data-c]'); const runs = val('[data-r]'); const gb = val('[data-gb]'); const days = val('[data-d]'); const sample = val('[data-s]') / 100; const fa = val('[data-f]') / 10000; const grp = val('[data-g]');
      ['t', 'c', 'r', 'gb', 'd', 's', 'f', 'g'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const total = tables * checks * runs; const scanning = total * 0.4;
      const fullTb = (scanning * gb) / 1000; const incTb = fullTb / days; const smpTb = incTb * sample;
      const falseAlerts = total * fa;
      const data: [string, string][] = [
        ['Check runs per day', fmt(total)],
        ['Of these, runs that read data', fmt(scanning)],
        ['TB read per day if every check scans the full table', fmt(fullTb)],
        ['TB read per day with incremental scans of the newest partition', fmt(incTb)],
        ['TB read per day with incremental scans plus sampling', incTb * sample < 10 ? (incTb * sample).toFixed(1) : fmt(smpTb)],
        ['Cost per day, full scans', money(fullTb * 5)],
        ['Cost per day, incremental and sampled', money(smpTb * 5)],
        ['Check runs per second, spread over the day', (total / 86400).toFixed(1)],
        ['Alerts per day before grouping', fmt(falseAlerts)],
        ['Pages per day after grouping by root cause (lineage)', fmt(falseAlerts / grp)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
