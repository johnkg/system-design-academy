---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Scanning every table in full for every check is what makes a quality platform unaffordable. See what metadata, incremental scans and sampling save, and how grouping cuts the pages.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Monitored tables (thousands)" name="t" min="1" max="50" value="10" />
      <RangeField label="Checks per table" name="c" min="2" max="20" value="8" />
      <RangeField label="Runs per table per day" name="r" min="1" max="24" value="4" />
      <RangeField label="Average table size (GB)" name="gb" min="10" max="2000" step="10" value="200" />
      <RangeField label="Days of partitions kept" name="d" min="30" max="1000" step="10" value="365" />
      <RangeField label="Sample rate for scanning checks (%)" name="s" min="1" max="100" value="1" />
      <RangeField label="Alerts per 10,000 check runs" name="f" min="1" max="50" value="5" />
      <RangeField label="Alerts merged into one root cause" name="g" min="1" max="20" value="5" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 60% of checks (freshness, volume, schema) are answered from table metadata and cost nothing to scan, the other 40% need to read data, an incremental scan reads only the newest daily partition, a sampled scan reads the sample rate of it, and scanning costs about 5 dollars per TB. Uniqueness cannot be sampled safely, so treat the sampled line as a lower bound. Alerts for the same root cause (an upstream table failing and everything downstream) are merged into one page.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 10; // one per output line
    const THOUSAND = 1000; const BASIS_POINTS = 10000; const GB_PER_TB = 1000; const DAY_S = 86400;
    const SCANNING_SHARE = 0.4; // checks that read table data (the rest read metadata)
    const USD_PER_TB = 5; // scan price
    const SMALL_TB = 10; // show one decimal below this
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const money = (n: number) => `$${fmt(n)}`;
    function draw() {
      const tables = val('[data-t]') * THOUSAND; const checks = val('[data-c]'); const runs = val('[data-r]'); const gb = val('[data-gb]'); const days = val('[data-d]'); const sample = val('[data-s]') / 100; const fa = val('[data-f]') / BASIS_POINTS; const grp = val('[data-g]');
      ['t', 'c', 'r', 'gb', 'd', 's', 'f', 'g'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const total = tables * checks * runs; const scanning = total * SCANNING_SHARE;
      const fullTb = (scanning * gb) / GB_PER_TB; const incTb = fullTb / days; const smpTb = incTb * sample;
      const falseAlerts = total * fa;
      const data: [string, string][] = [
        ['Check runs per day', fmt(total)],
        ['Of these, runs that read data', fmt(scanning)],
        ['TB read per day if every check scans the full table', fmt(fullTb)],
        ['TB read per day with incremental scans of the newest partition', fmt(incTb)],
        ['TB read per day with incremental scans plus sampling', incTb * sample < SMALL_TB ? (incTb * sample).toFixed(1) : fmt(smpTb)],
        ['Cost per day, full scans', money(fullTb * USD_PER_TB)],
        ['Cost per day, incremental and sampled', money(smpTb * USD_PER_TB)],
        ['Check runs per second, spread over the day', (total / DAY_S).toFixed(1)],
        ['Alerts per day before grouping', fmt(falseAlerts)],
        ['Pages per day after grouping by root cause (lineage)', fmt(falseAlerts / grp)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
