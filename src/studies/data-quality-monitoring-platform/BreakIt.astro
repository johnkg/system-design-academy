---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Catch a bad week of loads" hint="A table is loaded every hour for 5 weeks. In the last week 8 hours go wrong. Pick the detector, its sensitivity and what happens to a flagged hour, and see what pages the owner and what reaches the dashboards.">
  <ol class="how">
    <li>Start with the defaults, the <b>fixed floor</b> (rows below 200 thousand) with no breaker: it raises <b>9 false pages</b> for quiet nights and weekends, catches only <b>1 of the 8</b> bad hours, and all <b>8 bad hours reach the dashboards</b>.</li>
    <li>Switch to the <b>seasonal baseline</b> at sensitivity <b>4</b>: <b>0 false pages</b> and <b>7 of 8</b> bad hours caught, because every hour is compared with the same hour of the week before. The mild 15% drop is the one it can miss. The <b>global mean and spread</b> sees nothing at all: its lower bound is below zero, so a drop cannot trip it.</li>
    <li>With the <b>seasonal baseline</b> at sensitivity <b>4</b> still chosen, set the breaker to <b>hold every flagged hour</b>: only <b>1</b> bad hour reaches the dashboards, and no healthy hour is held. Move the sensitivity slider down to <b>2</b> and the page count jumps to <b>10 false pages</b> and <b>13 healthy hours</b> are held: an over-eager detector plus a breaker delays good data. Sensitivity is the dial that tunes noise.</li>
  </ol>
  <div class="pg dqb" data-dqb>
    <div class="pg-row">
      <label>Detector <select class="pg-in" data-det>
        <option value="fixed" selected>Fixed floor (under 200 thousand rows)</option>
        <option value="global">Global mean and spread</option>
        <option value="seasonal">Same hour of the week (median and MAD)</option>
      </select></label>
      <RangeField label="Sensitivity (flag beyond k spreads)" name="k" min="1" max="8" value="4" />
      <label>Flagged hours <select class="pg-in" data-br>
        <option value="off" selected>Load anyway, only send an alert</option>
        <option value="one">Hold every flagged hour back</option>
        <option value="open2">Breaker: open after 2 flagged in a row, close after 3 clean</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Pages to the owner</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Bad hours the detector caught</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Bad hours that reached dashboards</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Healthy hours held back</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <div class="pg-box"><h3>The last week, one cell per hour (a row per day, Monday first)</h3>
      <div class="dq-strip" data-strip role="img" aria-label="Last week of hourly loads"></div>
      <span class="pg-note">Red border: a really bad hour. Filled: flagged by the detector. Green dot: held back, not loaded.</span>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: weekday volume follows a daily curve from 60 to 940 thousand rows an hour with about 5% noise, and weekends carry 40% of it. The bad hours are Monday 10 and 11 (15% fewer rows), Wednesday 13 to 16 (65% fewer), Friday 03 (four times too many, a double load) and Saturday 14 (65% fewer). The baselines use the 4 earlier weeks, and a page is a run of consecutive flagged hours.</p>
  </div>
</PlaygroundShell>
<style is:global>
  .playground .dq-strip { display: grid; grid-template-columns: repeat(24, minmax(0, 1fr)); gap: 2px; }
  .playground .dq-cell { aspect-ratio: 1; border-radius: 2px; background: var(--surface-2); border: 2px solid transparent; position: relative; box-sizing: border-box; }
  .playground .dq-cell.flag { background: var(--accent); }
  .playground .dq-cell.inc { border-color: var(--bad); }
  .playground .dq-cell.held::after { content: ''; position: absolute; left: 50%; top: 50%; width: 40%; height: 40%; transform: translate(-50%, -50%); border-radius: 50%; background: var(--good); }
</style>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-dqb]').forEach((root) => {
    const q = query(root);
    const HW = 168; const WEEKS = 5; const START = HW * (WEEKS - 1);
    const SEED = 4242; const DAY_H = 24; const WEEK_D = 7;
    const WEEKEND_FROM = 5; const WEEKEND_PCT = 40; // Saturday and Sunday carry 40% of the weekday volume
    const NOISE = { base: 950, span: 101 }; // per-mille noise on each hour, 95%..105%
    const FAULTS = { // incidents injected into the last week
      outage: { day: 2, from: 13, to: 16, pct: 35 }, double: { day: 4, hour: 3, factor: 4 },
      mild: { day: 0, hours: [10, 11], pct: 85 }, short: { day: 5, hour: 14, pct: 35 },
    };
    const FIXED_FLOOR = 200; // rows per hour below which the fixed check fires
    const MAD_SCALE_PCT = 148; const MIN_SPREAD_PCT = 3; // MAD x 1.48 estimates the standard deviation; spread never below 3% of the median
    const OPEN_AFTER = 2; const CLOSE_AFTER = 3; // breaker opens after 2 flagged hours in a row, closes after 3 clean ones
    const MAX_FALSE = 2; const MAX_MISSED = 2; const MAX_LEAKED = 2; const LEAK_OK = 1; const MAX_COLLATERAL = 5; // verdict thresholds, hours
    // LCG, upper bits
    let seed = SEED; const rnd = (n: number) => { seed = (seed * 1664525 + 1013904223) % 4294967296; return Math.floor(seed / 65536) % n; };
    const SHAPE = [120, 90, 70, 60, 60, 80, 150, 300, 520, 700, 820, 900, 880, 860, 900, 940, 880, 760, 600, 480, 380, 300, 220, 160];
    const series: number[] = []; const incident: boolean[] = [];
    for (let t = 0; t < HW * WEEKS; t++) {
      const hour = t % DAY_H; const day = Math.floor(t / DAY_H) % WEEK_D;
      let v = Math.floor((SHAPE[hour] * (day >= WEEKEND_FROM ? WEEKEND_PCT : 100)) / 100); v = Math.floor((v * (NOISE.base + rnd(NOISE.span))) / 1000);
      let bad = false;
      if (t >= START) {
        const { outage, double, mild, short } = FAULTS;
        if (day === outage.day && hour >= outage.from && hour <= outage.to) { v = Math.floor((v * outage.pct) / 100); bad = true; }
        if (day === double.day && hour === double.hour) { v *= double.factor; bad = true; }
        if (day === mild.day && mild.hours.includes(hour)) { v = Math.floor((v * mild.pct) / 100); bad = true; }
        if (day === short.day && hour === short.hour) { v = Math.floor((v * short.pct) / 100); bad = true; }
      }
      series.push(v); incident.push(bad);
    }
    const median = (xs: number[]) => { const a = [...xs].sort((p, r) => p - r); const n = a.length; return n % 2 ? a[(n - 1) / 2] : Math.floor((a[n / 2 - 1] + a[n / 2]) / 2); };
    const hist = series.slice(0, START);
    const mean = Math.floor(hist.reduce((s, x) => s + x, 0) / hist.length);
    const variance = Math.floor(hist.reduce((s, x) => s + (x - mean) * (x - mean), 0) / hist.length);
    function flagged(det: string, k: number, t: number) {
      const x = series[t];
      if (det === 'fixed') return x < FIXED_FLOOR;
      if (det === 'global') return (x - mean) * (x - mean) > k * k * variance;
      const same: number[] = []; for (let w = 1; w < WEEKS; w++) same.push(series[t - w * HW]);
      const med = median(same); const mad = median(same.map((y) => Math.abs(y - med)));
      return Math.abs(x - med) * 100 > k * Math.max(mad * MAD_SCALE_PCT, med * MIN_SPREAD_PCT);
    }
    function run(det: string, k: number, br: string) {
      let open = false; let bad = 0; let good = 0; let held = 0; let collateral = 0; let leaked = 0; let missed = 0; let incidents = 0;
      const flags: boolean[] = []; const heldAt: boolean[] = [];
      for (let t = START; t < series.length; t++) {
        const f = flagged(det, k, t); flags.push(f);
        if (incident[t]) { incidents++; if (!f) missed++; }
        let h = false;
        if (br === 'one') h = f;
        else if (br === 'open2') { if (f) { bad++; good = 0; } else { good++; bad = 0; } if (!open && bad >= OPEN_AFTER) open = true; else if (open && good >= CLOSE_AFTER) open = false; h = open; }
        heldAt.push(h);
        if (h) { held++; if (!incident[t]) collateral++; } else if (incident[t]) leaked++;
      }
      let pagesTrue = 0; let pagesFalse = 0; let i = 0;
      while (i < flags.length) { if (!flags[i]) { i++; continue; } let j = i; let has = false; while (j < flags.length && flags[j]) { if (incident[START + j]) has = true; j++; } if (has) pagesTrue++; else pagesFalse++; i = j; }
      return { pagesTrue, pagesFalse, missed, leaked, collateral, held, incidents, flags, heldAt };
    }
    const strip = q('[data-strip]');
    const cells: HTMLElement[] = [];
    for (let i = 0; i < HW; i++) { const c = document.createElement('div'); c.className = 'dq-cell'; if (incident[START + i]) c.classList.add('inc'); strip.append(c); cells.push(c); }
    const set = (n: number, out: string, note: string, c: string) => { q(`[data-o${n}]`).textContent = out; q(`[data-n${n}]`).textContent = note; q<HTMLElement>(`[data-b${n}]`).style.setProperty('--c', c); };
    function draw() {
      const det = q<HTMLSelectElement>('[data-det]').value; const k = Number(q<HTMLInputElement>('[data-k]').value); const br = q<HTMLSelectElement>('[data-br]').value;
      q('[data-kval]').textContent = String(k);
      q<HTMLInputElement>('[data-k]').disabled = det === 'fixed';
      const r = run(det, k, br);
      const caught = r.incidents - r.missed;
      set(1, `${r.pagesTrue + r.pagesFalse} (${r.pagesFalse} false)`, `${r.pagesTrue} true and ${r.pagesFalse} false`, r.pagesFalse > MAX_FALSE ? 'var(--bad)' : 'var(--accent)');
      set(2, `${caught} of ${r.incidents}`, `${r.missed} slipped through unseen`, r.missed === 0 ? 'var(--good)' : r.missed > MAX_MISSED ? 'var(--bad)' : 'var(--accent)');
      set(3, `${r.leaked} of ${r.incidents}`, br === 'off' ? 'no hold, so every bad hour is loaded' : 'bad hours not held back', r.leaked <= LEAK_OK ? 'var(--good)' : 'var(--bad)');
      set(4, `${r.collateral}`, `${r.held} hours held in all`, r.collateral > MAX_COLLATERAL ? 'var(--bad)' : 'var(--accent)');
      cells.forEach((c, i) => { c.classList.toggle('flag', r.flags[i]); c.classList.toggle('held', r.heldAt[i]); });
      strip.setAttribute('aria-label', `Last week: ${r.flags.filter(Boolean).length} flagged hours, ${r.held} held back, ${r.incidents} really bad`);
      const out = q('[data-verdict]'); const bad = r.pagesFalse > MAX_FALSE || r.missed > MAX_MISSED || r.leaked > MAX_LEAKED || r.collateral > MAX_COLLATERAL; out.classList.toggle('bad', bad);
      out.textContent = det === 'global' ? `The global mean and spread flagged nothing: its lower bound is below zero, so a drop in rows can never trip it, and the daily rhythm hides the rest.`
        : det === 'fixed' && r.pagesFalse > MAX_FALSE ? `${r.pagesFalse} false pages: a fixed floor cannot tell a quiet night or weekend from a failure, and it misses a double load and a mild drop.`
        : r.pagesFalse > MAX_FALSE ? `${r.pagesFalse} false pages: at sensitivity ${k} ordinary noise trips the check, and ${br === 'off' ? 'owners learn to ignore it' : `${r.collateral} healthy hours are held back for nothing`}.`
        : r.leaked > MAX_LEAKED ? (br === 'off' ? `${caught} of ${r.incidents} bad hours are seen and the owners are paged, but nothing stops the load, so all ${r.leaked} bad hours are already in the dashboards. An alert without a hold is only a notification.`
          : `Bad hours are seen, but the breaker needs two flagged hours in a row, so ${r.leaked} of them still leak: the first hour of each incident, and any single-hour one.`)
        : r.missed > MAX_MISSED ? `Quiet, but ${r.missed} bad hours are missed: sensitivity ${k} is too coarse for a ${100 - FAULTS.mild.pct}% drop.`
        : `${r.pagesFalse} false pages, ${caught} of ${r.incidents} bad hours caught and ${r.leaked} reaching the dashboards, at the price of ${r.collateral} healthy hours held.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
