---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Volume decides everything: the buffer you need, and how much cheaper it is to index only labels than every word.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Hosts <input type="range" min="100" max="10000" step="100" value="2000" data-h /> <b data-hval></b></label>
      <label>Log lines per second per host <input type="range" min="5" max="200" step="5" value="50" data-l /> <b data-lval></b></label>
      <label>Bytes per line <input type="range" min="100" max="1000" step="50" value="300" data-by /> <b data-byval></b></label>
      <label>Peak is this many times the average <input type="range" min="1" max="10" value="5" data-pk /> <b data-pkval></b></label>
      <label>Buffer holds minutes of peak traffic <input type="range" min="5" max="120" step="5" value="30" data-bm /> <b data-bmval></b></label>
      <label>Lines per batch <input type="range" min="100" max="10000" step="100" value="1000" data-bl /> <b data-blval></b></label>
      <label>Days in the hot tier <input type="range" min="1" max="30" value="7" data-hot /> <b data-hotval></b></label>
      <label>Days in the warm tier <input type="range" min="0" max="90" value="23" data-warm /> <b data-warmval></b></label>
      <label>Days in the cold tier <input type="range" min="0" max="730" step="5" value="335" data-cold /> <b data-coldval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: text compresses 8:1. The full-index design keeps the hot and warm days as an inverted index on disk the size of the raw text, with 2 copies, on SSD ($0.10 per GB-month) for hot and on cheaper disk ($0.045) for warm. The labels-only design keeps compressed chunks in object storage ($0.023) for hot and warm days, a label index of 3% of the raw size with 2 copies on SSD, and a one-copy SSD cache of the hot days. Both put the cold days in an archive tier at $0.004. Only storage is counted, and queries, compute and the network are extra.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 11 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const usd = (n: number) => `$${fmt(n)}`;
    function draw() {
      const hosts = val('[data-h]'); const lps = val('[data-l]'); const bytes = val('[data-by]'); const peak = val('[data-pk]'); const bufMin = val('[data-bm]'); const batch = val('[data-bl]');
      const hot = val('[data-hot]'); const warm = val('[data-warm]'); const cold = val('[data-cold]');
      ['h', 'l', 'by', 'pk', 'bm', 'bl', 'hot', 'warm', 'cold'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const lines = hosts * lps; const mbs = (lines * bytes) / 1e6; const gbDay = (mbs * 86400) / 1000;
      const bufGb = (mbs * peak * bufMin * 60) / 1000;
      const batches = lines / batch;
      const ratio = 8;
      const fullCost = gbDay * hot * 2 * 0.1 + gbDay * warm * 2 * 0.045 + (gbDay / ratio) * cold * 0.004;
      const labelCost = (gbDay / ratio) * (hot + warm) * 0.023 + gbDay * 0.03 * (hot + warm) * 2 * 0.1 + (gbDay / ratio) * hot * 0.1 + (gbDay / ratio) * cold * 0.004;
      const data: [string, string][] = [
        ['Log lines per second on average', fmt(lines)],
        ['Ingest rate on average', `${fmt(mbs)} MB/s`],
        ['Ingest rate at the peak', `${fmt(mbs * peak)} MB/s, ${fmt(lines * peak)} lines/s`],
        ['New raw text per day', `${fmt(gbDay)} GB`],
        ['Batches per second from all agents', fmt(batches)],
        ['Buffer needed for the peak', `${fmt(bufGb)} GB for ${bufMin} minutes`],
        ['Compressed data per day', `${fmt(gbDay / ratio)} GB`],
        ['Total retention', `${hot + warm + cold} days`],
        ['Storage per month, index every word', `${usd(fullCost)}`],
        ['Storage per month, labels-only index over chunks', `${usd(labelCost)}`],
        ['Labels-only design is cheaper by', fullCost > 0 && labelCost > 0 ? `${(Math.round((fullCost / labelCost) * 10) / 10).toLocaleString('en-US')} times` : 'not applicable'],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
