---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How full each database and table is against the limits Notion set, when the layout runs out of room, which host counts the shards divide into evenly, and how long a backfill and a catch-up take. A teaching model with round numbers, not Notion's data.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Logical shards" name="l" min="60" max="960" step="60" value="480" />
      <RangeField label="Physical databases" name="d" min="8" max="96" step="8" value="32" />
      <RangeField label="Data across everything (TB)" name="z" min="10" max="500" step="10" value="100" />
      <RangeField label="Share of that data in the biggest table (%)" name="p" min="10" max="90" step="10" value="60" />
      <RangeField label="Growth per year (%)" name="g" min="10" max="300" step="10" value="100" />
      <RangeField label="IOPS the whole system needs" name="i" min="10000" max="200000" step="10000" value="60000" />
      <RangeField label="Backfill speed (MB per second)" name="v" min="50" max="1000" step="50" value="250" />
      <RangeField label="Writes per second during the migration" name="w" min="1000" max="100000" step="1000" value="20000" />
      <RangeField label="Changes the catch-up script replays per second" name="s" min="5000" max="200000" step="5000" value="60000" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Teaching model, not Notion's system or data. The post gives three limits, which are built in here: at least 60,000 IOPS in total, at most 500 GB in any one table and at most 10 TB on any one physical database, and it says a zero-downtime switch-over would have needed the catch-up script to finish in under 30 seconds. It does not give table sizes, row counts or the growth rate, so those figures are guesses of mine that you can change. Assumptions: data and traffic are spread evenly over the logical shards; the table limit applies to the biggest table; growth is a steady yearly percentage; and the backfill and the catch-up each run at a constant speed.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 13; // lines in the result list
    const MB_PER_TB = 1e6, GB_PER_TB = 1000, SECONDS_PER_DAY = 86400, SECONDS_PER_HOUR = 3600, MILLION = 1e6, PERCENT = 100;
    const DATABASE_LIMIT_TB = 10, TABLE_LIMIT_GB = 500, SWITCH_OVER_SECONDS = 30; // from Notion's post
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    /** Database counts above `from` and up to double it that the shards divide into evenly. */
    const evenSteps = (shards: number, from: number) => Array.from({ length: from }, (_, i) => from + 1 + i).filter((n) => shards % n === 0);
    function draw() {
      ['l', 'd', 'z', 'p', 'g', 'i', 'v', 'w', 's'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const shards = val('[data-l]'), databases = val('[data-d]'), totalTb = val('[data-z]'), tablePct = val('[data-p]'), growthPct = val('[data-g]');
      const iops = val('[data-i]'), backfillMb = val('[data-v]'), writes = val('[data-w]'), replay = val('[data-s]');
      const perDatabaseTb = totalTb / databases;
      const tableGb = (totalTb * (tablePct / PERCENT) * GB_PER_TB) / shards;
      const yearsLeft = perDatabaseTb >= DATABASE_LIMIT_TB ? 0 : Math.log(DATABASE_LIMIT_TB / perDatabaseTb) / Math.log(1 + growthPct / PERCENT);
      const backfillSeconds = (totalTb * MB_PER_TB) / backfillMb;
      const changes = writes * backfillSeconds;
      const steps = evenSteps(shards, databases);
      const data: [string, string][] = [
        ['Logical shards on each physical database', formatOneDecimalBelow100(shards / databases)],
        ['Do the shards divide evenly over the databases?', Number.isInteger(shards / databases) ? 'yes' : 'no, some databases get one more'],
        ['Data on each physical database (TB)', formatOneDecimalBelow100(perDatabaseTb)],
        ['Share of the 10 TB limit used', `${formatOneDecimalBelow100((PERCENT * perDatabaseTb) / DATABASE_LIMIT_TB)}%`],
        ['Biggest table in one logical shard (GB)', formatOneDecimalBelow100(tableGb)],
        ['Share of the 500 GB table limit used', `${formatOneDecimalBelow100((PERCENT * tableGb) / TABLE_LIMIT_GB)}%`],
        ['IOPS each database must deliver', formatOneDecimalBelow100(iops / databases)],
        ['Years until a database reaches 10 TB at this growth', perDatabaseTb >= DATABASE_LIMIT_TB ? 'already there' : formatOneDecimalBelow100(yearsLeft)],
        ['Database counts up to double today that the shards divide into evenly', steps.length ? steps.join(', ') : 'none'],
        ['Backfill time at this speed (days)', formatOneDecimalBelow100(backfillSeconds / SECONDS_PER_DAY)],
        ['Changes made during the backfill that must be replayed (millions)', formatOneDecimalBelow100(changes / MILLION)],
        ['Time to replay them all (hours)', formatOneDecimalBelow100(changes / replay / SECONDS_PER_HOUR)],
        ['Changes the catch-up can replay in the 30 seconds a zero-downtime switch-over allows', formatOneDecimalBelow100(replay * SWITCH_OVER_SECONDS)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
