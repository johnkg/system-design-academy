---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="More regions cut the load on each one but multiply the replication traffic, and the time to cross an ocean decides how many writes collide.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Peak writes per second, all regions <input type="range" min="1000" max="100000" step="1000" value="20000" data-w /> <b data-wval></b></label>
      <label>Regions <input type="range" min="2" max="6" value="3" data-r /> <b data-rval></b></label>
      <label>Size of a replicated change (KB) <input type="range" min="1" max="20" value="2" data-kb /> <b data-kbval></b></label>
      <label>Round trip between regions (ms) <input type="range" min="20" max="300" step="10" value="140" data-rtt /> <b data-rttval></b></label>
      <label>Distinct keys written (millions) <input type="range" min="1" max="500" value="50" data-keys /> <b data-keysval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: every region sends each change to every other region, the average write rate is 40% of the peak, a month has 2.592 million seconds, cross-region transfer costs $0.02 per GB, applying a change adds 50 ms to half the round trip, writes are spread evenly over regions and keys, and two writes to the same key from different regions collide if they fall within one lag window of each other.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    function draw() {
      const w = val('[data-w]'); const r = val('[data-r]'); const kb = val('[data-kb]'); const rtt = val('[data-rtt]'); const keys = val('[data-keys]') * 1e6;
      ['w', 'r', 'kb', 'rtt', 'keys'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perRegion = w / r;
      const egressMb = (perRegion * kb * (r - 1)) / 1000;
      const monthTb = (w * 0.4 * kb * (r - 1) * 2592000) / 1e9;
      const cost = monthTb * 1000 * 0.02;
      const lagMs = rtt / 2 + 50;
      const atRisk = (perRegion * lagMs) / 1000;
      const conflictsPerSec = (((r - 1) / r) * w * w * (lagMs / 1000)) / keys;
      const capacity = r / (r - 1);
      const data: [string, string][] = [
        ['Writes per region per second', fmt(perRegion)],
        ['Replication traffic sent by each region', `${fmt1(egressMb)} MB/s`],
        ['Cross-region transfer per month', `${fmt(monthTb)} TB`],
        ['Transfer cost per month', `$${fmt(cost)}`],
        ['Typical replication lag', `${fmt(lagMs)} ms`],
        ['Writes only in the failed region if it is lost', fmt(atRisk)],
        ['Colliding writes per hour', fmt(conflictsPerSec * 3600)],
        ['Total capacity to survive one region loss', `${fmt1(capacity)} times the peak`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
