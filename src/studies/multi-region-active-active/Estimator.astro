---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="More regions cut the load on each one but multiply the replication traffic, and the time to cross an ocean decides how many writes collide.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Peak writes per second, all regions" name="w" min="1000" max="100000" step="1000" value="20000" />
      <RangeField label="Regions" name="r" min="2" max="6" value="3" />
      <RangeField label="Size of a replicated change (KB)" name="kb" min="1" max="20" value="2" />
      <RangeField label="Round trip between regions (ms)" name="rtt" min="20" max="300" step="10" value="140" />
      <RangeField label="Distinct keys written (millions)" name="keys" min="1" max="500" value="50" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: every region sends each change to every other region, the average write rate is 40% of the peak, a month has 2.592 million seconds, cross-region transfer costs $0.02 per GB, applying a change adds 50 ms to half the round trip, writes are spread evenly over regions and keys, and two writes to the same key from different regions collide if they fall within one lag window of each other.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 8; // lines in the result list
    const MILLION = 1e6, KB_PER_MB = 1000, KB_PER_TB = 1e9, GB_PER_TB = 1000, MS_PER_S = 1000, HOUR_S = 3600;
    const MONTH_S = 2592000; // 30 days
    const AVG_OF_PEAK = 0.4; // average write rate over the month is 40% of the peak
    const USD_PER_GB = 0.02; // cross-region transfer
    const APPLY_MS = 50; // queueing and apply time on top of half the round trip
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    function draw() {
      const w = val('[data-w]'); const r = val('[data-r]'); const kb = val('[data-kb]'); const rtt = val('[data-rtt]'); const keys = val('[data-keys]') * MILLION;
      ['w', 'r', 'kb', 'rtt', 'keys'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perRegion = w / r;
      const egressMb = (perRegion * kb * (r - 1)) / KB_PER_MB;
      const monthTb = (w * AVG_OF_PEAK * kb * (r - 1) * MONTH_S) / KB_PER_TB;
      const cost = monthTb * GB_PER_TB * USD_PER_GB;
      const lagMs = rtt / 2 + APPLY_MS;
      const atRisk = (perRegion * lagMs) / MS_PER_S;
      const conflictsPerSec = (((r - 1) / r) * w * w * (lagMs / MS_PER_S)) / keys;
      const capacity = r / (r - 1);
      const data: [string, string][] = [
        ['Writes per region per second', fmt(perRegion)],
        ['Replication traffic sent by each region', `${fmt1(egressMb)} MB/s`],
        ['Cross-region transfer per month', `${fmt(monthTb)} TB`],
        ['Transfer cost per month', `$${fmt(cost)}`],
        ['Typical replication lag', `${fmt(lagMs)} ms`],
        ['Writes only in the failed region if it is lost', fmt(atRisk)],
        ['Colliding writes per hour', fmt(conflictsPerSec * HOUR_S)],
        ['Total capacity to survive one region loss', `${fmt1(capacity)} times the peak`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
