---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Peak rate sets the number of partitions, retention sets the archive, and the checkpoint interval sets how long an insider could rewrite unsealed history.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Average events per second (thousands) <input type="range" min="1" max="100" value="20" data-avg /> <b data-avgval></b></label>
      <label>Peak is this many times the average <input type="range" min="1" max="12" value="10" data-pk /> <b data-pkval></b></label>
      <label>Bytes per entry <input type="range" min="100" max="2000" step="50" value="600" data-by /> <b data-byval></b></label>
      <label>Retention (years) <input type="range" min="1" max="10" value="7" data-yr /> <b data-yrval></b></label>
      <label>Days kept searchable <input type="range" min="7" max="180" step="1" value="30" data-hot /> <b data-hotval></b></label>
      <label>Seconds between checkpoints <input type="range" min="10" max="900" step="10" value="60" data-ck /> <b data-ckval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each entry also stores 64 bytes of hashes, one partition ingests 10,000 events per second and is run at 70% of that, the archive compresses 5 to 1, the search index takes 1.5 times the uncompressed size of the entries, events are spread evenly across partitions, and a Merkle proof needs one hash per level of the tree.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 10; // lines in the result list
    const THOUSAND = 1000, DAY_S = 86400, GB = 1e9, GB_PER_TB = 1000, DAYS_PER_YEAR = 365;
    const CHAIN_BYTES = 64; // hash-chain fields added to every entry
    const PARTITION = { eps: 10000, load: 0.7 }; // a partition takes 10,000 events per second, run at 70%
    const ARCHIVE_RATIO = 5; // archive compression
    const INDEX_FACTOR = 1.5; // search index size over the raw data
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const avg = val('[data-avg]') * THOUSAND; const pk = val('[data-pk]'); const by = val('[data-by]'); const yr = val('[data-yr]'); const hot = val('[data-hot]'); const ck = val('[data-ck]');
      ['avg', 'pk', 'by', 'yr', 'hot', 'ck'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const peak = avg * pk; const perDay = avg * DAY_S; const stored = by + CHAIN_BYTES;
      const parts = Math.ceil(peak / (PARTITION.eps * PARTITION.load));
      const gbDay = (perDay * stored) / GB;
      const archiveTb = (gbDay * DAYS_PER_YEAR * yr) / ARCHIVE_RATIO / GB_PER_TB;
      const indexTb = (gbDay * hot * INDEX_FACTOR) / GB_PER_TB;
      const block = (avg / parts) * ck; const proof = Math.max(1, Math.ceil(Math.log2(Math.max(2, block))));
      const data: [string, string][] = [
        ['Events per second at the peak', fmt(peak)],
        ['Events per day', fmt(perDay)],
        ['Partitions (each with its own chain)', fmt(parts)],
        ['New log data per day', `${fmt(gbDay)} GB`],
        ['Write-once archive after the retention period, compressed', `${fmt(archiveTb)} TB`],
        ['Search index for the searchable days', `${fmt(indexTb)} TB`],
        ['Entries sealed per checkpoint, per partition', fmt(block)],
        ['Hashes in a Merkle proof for one entry', fmt(proof)],
        ['Signed checkpoints published per day', fmt((parts * DAY_S) / ck)],
        ['Unsealed window an insider could rewrite', `${ck} seconds, about ${fmt(avg * ck)} entries in all`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
