---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Traffic sets the gateway fleet, and keeping every raw usage event is what makes analytics expensive. Hourly rollups keep it small.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Registered apps (thousands) <input type="range" min="10" max="1000" step="10" value="200" data-a /> <b data-aval></b></label>
      <label>Apps active on a given day (%) <input type="range" min="1" max="60" value="20" data-act /> <b data-actval></b></label>
      <label>Calls per active app per day (thousands) <input type="range" min="1" max="200" value="25" data-c /> <b data-cval></b></label>
      <label>Peak rate compared with the average <input type="range" min="2" max="10" value="4" data-pk /> <b data-pkval></b></label>
      <label>Requests per second one gateway instance handles <input type="range" min="2000" max="20000" step="1000" value="10000" data-cap /> <b data-capval></b></label>
      <label>Days of raw usage events kept <input type="range" min="1" max="30" value="7" data-ret /> <b data-retval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: gateway instances are sized to run at 60% load at the peak, one raw usage event is about 200 bytes, an active app touches about 20 combinations of endpoint, version and status code, and one hourly rollup row is about 64 bytes.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 8; // lines in the result list
    const THOUSAND = 1000, DAY_S = 86400, GB = 1e9, GB_PER_TB = 1000, H_PER_DAY = 24, DAYS_PER_YEAR = 365;
    const TARGET_LOAD = 0.6; // gateway instances run at 60% at the peak
    const EVENT_BYTES = 200; // one raw usage event
    const ENDPOINTS = 20; // endpoints an active app uses: one rollup row per endpoint per hour
    const ROLLUP_BYTES = 64;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    function draw() {
      ['a', 'act', 'c', 'pk', 'cap', 'ret'].forEach((k) => (q(`[data-${k}val]`).textContent = val(`[data-${k}]`).toLocaleString('en-US')));
      const active = val('[data-a]') * THOUSAND * (val('[data-act]') / 100);
      const perDay = active * val('[data-c]') * THOUSAND; const avg = perDay / DAY_S; const peak = avg * val('[data-pk]');
      const instances = Math.ceil(peak / (val('[data-cap]') * TARGET_LOAD));
      const rawDayGb = (perDay * EVENT_BYTES) / GB; const rawKeptTb = (rawDayGb * val('[data-ret]')) / GB_PER_TB;
      const rollRows = active * H_PER_DAY * ENDPOINTS; const rollYearGb = (rollRows * ROLLUP_BYTES * DAYS_PER_YEAR) / GB;
      const data: [string, string][] = [
        ['Active apps per day', fmt(active)],
        ['Requests per day', fmt(perDay)],
        ['Average and peak requests per second', `${fmt(avg)} and ${fmt(peak)}`],
        [`Gateway instances at ${TARGET_LOAD * 100}% load at the peak`, fmt(instances)],
        ['Raw usage events per day', `${fmt1(rawDayGb)} GB`],
        ['Raw events kept for the retention period', `${fmt1(rawKeptTb)} TB`],
        ['Hourly rollup rows per day', fmt(rollRows)],
        ['Rollups kept for a year', `${fmt1(rollYearGb)} GB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
