---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Change the API without breaking anyone" hint="300 integrations use one endpoint. Pick a change and a way to release it, and see how many apps stop working. Every result is the same on each visit.">
  <ol class="how">
    <li>Default: <b>remove a field</b> and <b>edit the live version in place</b>. The field is the fifth most used one, so <b>148 of 300 apps</b> break at once, and the support queue fills up.</li>
    <li>Switch to <b>a contract check blocks the release</b>. The same change is stopped before it ships: <b>0 apps break</b>, but the change did not ship either. It has to go out as a new version.</li>
    <li>Switch to <b>ship it as a new version, keys stay pinned</b>: <b>0 apps break</b>. After 6 months <b>49 of the 148</b> affected apps are still on the old version, so you must keep running it. Then try <b>add an optional parameter</b>: no app is affected under any option.</li>
  </ol>
  <div class="pg dapi" data-dapi>
    <div class="pg-row">
      <label>The change <select class="pg-in" data-change>
        <option value="addopt">add an optional request parameter</option>
        <option value="addfield">add a new field to the response</option>
        <option value="addreq">add a required request parameter</option>
        <option value="remove" selected>remove a field from the response</option>
        <option value="retype">change a field from a number to text</option>
      </select></label>
      <label>How it is released <select class="pg-in" data-appr>
        <option value="inplace" selected>edit the live version in place</option>
        <option value="ci">a contract check blocks breaking changes</option>
        <option value="versioned">ship it as a new version, keys stay pinned</option>
      </select></label>
      <label>Months since the new version shipped <input type="range" min="0" max="18" value="6" data-mo /> <b data-moval></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Apps broken right now</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Did the change ship?</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Old version still needed by</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <div class="dapi-bar" role="img" aria-label="Share of the 300 apps that are broken" data-bar><span data-fill></span></div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 300 apps; each reads 3 to 8 of the 12 response fields, favouring the popular ones (field k is chosen with weight 1/k), and sends no parameter it was not told about. 4% of apps use a strict parser that rejects unknown fields. The field being changed is the fifth most used. Apps move to a new version after a random delay averaging about 6 months, with a long tail. The slider only matters for the pinned-version option.</p>
  </div>
</PlaygroundShell>
<style is:global>
  .playground .dapi-bar { height: .6rem; border-radius: 999px; background: var(--border); overflow: hidden; margin: .6rem 0; }
  .playground .dapi-bar span { display: block; height: 100%; width: 0; background: var(--bad); transition: width .2s; }
  @media (prefers-reduced-motion: reduce) { .playground .dapi-bar span { transition: none; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-dapi]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const APPS = 300; const FIELDS = 12; const TARGET = 4;
    let seed = 17; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
    const weights = Array.from({ length: FIELDS }, (_, i) => 1 / (i + 1)); const total = weights.reduce((a, b) => a + b, 0);
    const apps = Array.from({ length: APPS }, () => {
      const want = 3 + Math.floor(rnd() * 6); const fields = new Set<number>();
      while (fields.size < want) { let r = rnd() * total; let i = 0; while (r > weights[i]) { r -= weights[i]; i++; } fields.add(i); }
      return { fields, strict: rnd() < 0.04, migrates: Math.floor(-Math.log(1 - rnd()) * 5) + 1 };
    });
    type Kind = { breaking: boolean; all?: boolean; field?: boolean; strict?: boolean };
    const kinds: Record<string, Kind> = {
      addopt: { breaking: false }, addfield: { breaking: false, strict: true }, addreq: { breaking: true, all: true },
      remove: { breaking: true, field: true }, retype: { breaking: true, field: true },
    };
    function simulate(change: string, appr: string, months: number) {
      const k = kinds[change]; let hit = 0; let hitLeft = 0;
      for (const a of apps) {
        const affected = k.all || (k.field && a.fields.has(TARGET)) || (k.strict && a.strict);
        if (affected) { hit++; if (a.migrates > months) hitLeft++; }
      }
      if (appr === 'inplace') return { broken: hit, shipped: true, hit, left: 0, versions: 1 };
      if (appr === 'ci') return k.breaking ? { broken: 0, shipped: false, hit, left: 0, versions: 1 } : { broken: hit, shipped: true, hit, left: 0, versions: 1 };
      return { broken: 0, shipped: true, hit, left: hitLeft, versions: hitLeft > 0 ? 2 : 1 };
    }
    let queued = false;
    function draw() {
      queued = false;
      const change = q<HTMLSelectElement>('[data-change]').value; const appr = q<HTMLSelectElement>('[data-appr]').value; const months = Number(q<HTMLInputElement>('[data-mo]').value);
      q('[data-moval]').textContent = String(months);
      const r = simulate(change, appr, months); const pct = Math.round((r.broken / APPS) * 100);
      q('[data-o1]').textContent = `${r.broken} of ${APPS}`; q('[data-n1]').textContent = `${pct}% of integrations; ${r.hit} would be affected by this change`;
      q('[data-o2]').textContent = r.shipped ? 'yes' : 'no, blocked'; q('[data-n2]').textContent = r.shipped ? (appr === 'versioned' ? 'as a new version' : 'to everyone, immediately') : 'the check found a breaking change';
      q('[data-o3]').textContent = appr === 'versioned' ? `${r.left} apps` : 'nobody'; q('[data-n3]').textContent = appr === 'versioned' ? `${r.versions} version${r.versions > 1 ? 's' : ''} to run, ${months} months in` : 'there is only one version';
      q<HTMLElement>('[data-b1]').style.setProperty('--c', r.broken === 0 ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', r.shipped ? 'var(--accent)' : 'var(--good)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', r.left > 0 ? 'var(--accent)' : 'var(--good)');
      q<HTMLElement>('[data-fill]').style.width = `${pct}%`;
      const out = q('[data-verdict]'); out.classList.toggle('bad', r.broken > 0);
      let text: string;
      if (r.broken > 0) text = appr === 'inplace' ? `${r.broken} apps stop working the moment this ships, because nobody had a chance to move. A contract check or a new version would have prevented it.` : `The contract check treats a new response field as safe, but ${r.broken} apps with strict parsers still fail. Only a small share breaks, which is why such fields are announced in advance and parsers are told to ignore unknown fields.`;
      else if (!r.shipped) text = 'The check blocked the release, so nothing broke, but the change has not shipped. Ship it as a new version and let apps move over.';
      else if (appr === 'versioned' && r.hit === 0) text = 'Nothing breaks and no old version is needed. For a harmless change a new version only adds work.';
      else if (appr === 'versioned') text = `Nothing breaks. ${r.left} of the ${r.hit} affected apps are still on the old version after ${months} months, so it must keep running, and the usage data tells you whom to contact.`;
      else text = 'This change is safe: no app depends on anything that changed.';
      out.textContent = text;
    }
    const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(draw); } };
    root.addEventListener('input', schedule); root.addEventListener('change', schedule);
    draw();
  });
</script>
