---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Storage grows with every line ever written, and one busy account can need more write capacity than a single row has.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Payments per day (millions)" name="p" min="1" max="500" value="50" />
      <RangeField label="Peak rate compared with the average (times)" name="k" min="2" max="10" value="5" />
      <RangeField label="Lines per entry" name="l" min="2" max="6" value="3" />
      <RangeField label="Bytes stored per line, with indexes" name="by" min="50" max="300" step="10" value="150" />
      <RangeField label="Entries that touch the busiest account (%)" name="h" min="0" max="50" value="20" />
      <RangeField label="Updates per second one balance row can take" name="r" min="100" max="1000" step="50" value="500" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: one payment is one entry, a row lock is held for about 2 ms so a row takes about 500 updates per second, sub-accounts are sized to run at 60% of that, and a replay reads about 200,000 lines per second. Every line is stored once; replicas and backups multiply the storage.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const MILLION = 1e6, DAY_S = 86400, GB = 1e9, GB_PER_TB = 1000, DAYS_PER_YEAR = 365;
    const ROW_LOAD = 0.6; // run each sub-account row at 60% of what it can take
    const REPLAY_LINES_S = 200000; // lines replayed per second
    const SHOW_MIN_FROM_S = 120;
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const one = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    function draw() {
      const p = val('[data-p]') * MILLION; const k = val('[data-k]'); const l = val('[data-l]'); const by = val('[data-by]'); const h = val('[data-h]') / 100; const r = val('[data-r]');
      ['p', 'k', 'l', 'by', 'h', 'r'].forEach((id) => (q(`[data-${id}val]`).textContent = String(val(`[data-${id}]`))));
      const avg = p / DAY_S; const peak = avg * k; const lines = p * l; const gbDay = (lines * by) / GB;
      const hot = peak * h; const subs = Math.max(1, Math.ceil(hot / (r * ROW_LOAD))); const replay = lines / REPLAY_LINES_S;
      const data: [string, string][] = [
        ['Entries per second on average', fmt(avg)],
        ['Entries per second at the peak', fmt(peak)],
        ['Lines written per second at the peak', fmt(peak * l)],
        ['Journal growth per day', `${one(gbDay)} GB`],
        ['Journal growth per year', `${one((gbDay * DAYS_PER_YEAR) / GB_PER_TB)} TB`],
        ['Updates per second on the busiest account at the peak', fmt(hot)],
        ['Load on that account if it is a single row', `${fmt((hot / r) * 100)}% of what a row can take`],
        ['Sub-accounts needed for the busiest account', fmt(subs)],
        ['Time to replay one day of lines to rebuild balances', replay >= SHOW_MIN_FROM_S ? `${one(replay / 60)} minutes` : `${fmt(replay)} seconds`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
