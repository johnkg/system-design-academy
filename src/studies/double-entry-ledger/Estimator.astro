---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Storage grows with every line ever written, and one busy account can need more write capacity than a single row has.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Payments per day (millions) <input type="range" min="1" max="500" value="50" data-p /> <b data-pval></b></label>
      <label>Peak rate compared with the average (times) <input type="range" min="2" max="10" value="5" data-k /> <b data-kval></b></label>
      <label>Lines per entry <input type="range" min="2" max="6" value="3" data-l /> <b data-lval></b></label>
      <label>Bytes stored per line, with indexes <input type="range" min="50" max="300" step="10" value="150" data-by /> <b data-byval></b></label>
      <label>Entries that touch the busiest account (%) <input type="range" min="0" max="50" value="20" data-h /> <b data-hval></b></label>
      <label>Updates per second one balance row can take <input type="range" min="100" max="1000" step="50" value="500" data-r /> <b data-rval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: one payment is one entry, a row lock is held for about 2 ms so a row takes about 500 updates per second, sub-accounts are sized to run at 60% of that, and a replay reads about 200,000 lines per second. Every line is stored once; replicas and backups multiply the storage.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const one = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    function draw() {
      const p = val('[data-p]') * 1e6; const k = val('[data-k]'); const l = val('[data-l]'); const by = val('[data-by]'); const h = val('[data-h]') / 100; const r = val('[data-r]');
      ['p', 'k', 'l', 'by', 'h', 'r'].forEach((id) => (q(`[data-${id}val]`).textContent = String(val(`[data-${id}]`))));
      const avg = p / 86400; const peak = avg * k; const lines = p * l; const gbDay = (lines * by) / 1e9;
      const hot = peak * h; const subs = Math.max(1, Math.ceil(hot / (r * 0.6))); const replay = lines / 200000;
      const data: [string, string][] = [
        ['Entries per second on average', fmt(avg)],
        ['Entries per second at the peak', fmt(peak)],
        ['Lines written per second at the peak', fmt(peak * l)],
        ['Journal growth per day', `${one(gbDay)} GB`],
        ['Journal growth per year', `${one((gbDay * 365) / 1000)} TB`],
        ['Updates per second on the busiest account at the peak', fmt(hot)],
        ['Load on that account if it is a single row', `${fmt((hot / r) * 100)}% of what a row can take`],
        ['Sub-accounts needed for the busiest account', fmt(subs)],
        ['Time to replay one day of lines to rebuild balances', replay >= 120 ? `${one(replay / 60)} minutes` : `${fmt(replay)} seconds`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
