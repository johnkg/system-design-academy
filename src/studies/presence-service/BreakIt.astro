---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Heartbeats, TTL and reconnect" hint="1,000 devices run for 5 simulated minutes. Heartbeats are lost at random and 100 devices crash. Change the TTL, the fan-out rule and the reconnect behaviour, and see what the friends and the backend experience.">
  <ol class="how">
    <li>Start as set: heartbeats every <b>10 s</b> with a TTL of only <b>1 interval</b> and 10% loss. One lost heartbeat expires the session, so about <b>2,600 false offline flickers</b> appear, and every flicker is sent to friends: about <b>350 messages per second</b>. It does notice a crash fast (about 4 s).</li>
    <li>Set the TTL to <b>3 intervals</b>: flickers fall to about <b>25</b> and messages to about <b>10 per second</b>, and a crashed device is now noticed after about <b>24 s</b> on average (29 s at worst). That is the trade: steadiness against detection delay.</li>
    <li>Switch the fan-out to <b>every heartbeat</b>: the same steady system now sends about <b>1,700 messages per second</b>, almost all of them saying 'still online'.</li>
    <li>In the outage, all 1,000 devices reconnect at once: a peak of <b>1,000 per second</b> against a capacity of 100. Tick <b>jitter</b> and the arrivals spread over 30 s, to a peak of about <b>46 per second</b>.</li>
  </ol>
  <div class="pg prb" data-prb>
    <div class="pg-row">
      <label>Heartbeat interval <select class="pg-in" data-i><option value="5">5 s</option><option value="10" selected>10 s</option><option value="30">30 s</option></select></label>
      <label>TTL <select class="pg-in" data-m><option value="1" selected>1 interval</option><option value="2">2 intervals</option><option value="3">3 intervals</option><option value="5">5 intervals</option></select></label>
      <label>Heartbeats lost (%) <input type="range" min="0" max="30" value="10" data-loss /> <b data-lossval></b></label>
      <label>Friends are told <select class="pg-in" data-mode><option value="changes" selected>only when status changes</option><option value="every">on every heartbeat</option></select></label>
      <label><input type="checkbox" data-jit /> Reconnect with random jitter after an outage</label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>False offline flickers</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>A crashed device is noticed after</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Messages to friends</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Reconnects in the busiest second</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: 1,000 devices, 300 seconds, each heartbeat lost independently, 100 devices crash between 150 s and 210 s. A session expires when its last received heartbeat is older than the TTL, and a flicker is an expiry of a device that is still running. Each status change goes to 20 watching friends. In the outage all devices reconnect at the same second, or spread over 30 s with jitter, and the backend can admit 100 sessions per second.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-prb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const CAP = 100; const WATCH = 20; const U = 1000; const T = 300; const CR = 100;
    const CRASH = { from: 150, range: 60 }; // crashing devices die between 150 and 209 s
    const JITTER_S = 30; const DELAY_BAD_S = 45; // reconnects spread over 30 s with jitter
    function sim(I: number, mult: number, lossPct: number, mode: string, jitter: boolean) {
      const TTL = I * mult;
      // Numerical Recipes LCG
      let seed = 4242; const rnd = (n: number) => { seed = (seed * 1664525 + 1013904223) % 4294967296; return Math.floor(seed / 65536) % n; };
      let flickers = 0; let transitions = 0; let beatsOk = 0; let delaySum = 0; let delayMax = 0;
      for (let d = 0; d < U; d++) {
        const phase = rnd(I); const crash = d < CR ? CRASH.from + rnd(CRASH.range) : -1;
        let online = true; let lastOk = 0; let offlineAt = -1;
        for (let t = 0; t < T; t++) {
          const alive = crash < 0 || t < crash;
          if (alive && t >= phase && (t - phase) % I === 0 && rnd(100) >= lossPct) { lastOk = t; beatsOk++; if (!online) { online = true; transitions++; } }
          if (online && t - lastOk >= TTL) { online = false; transitions++; if (alive) flickers++; else if (offlineAt < 0) offlineAt = t; }
          if (crash >= 0 && t === crash && !online) offlineAt = crash;
        }
        if (crash >= 0) { const dl = offlineAt < 0 ? T - crash : Math.max(0, offlineAt - crash); delaySum += dl; if (dl > delayMax) delayMax = dl; }
      }
      const msgs = mode === 'every' ? (beatsOk * WATCH) / T : (transitions * WATCH) / T;
      const perSec = new Array(T).fill(0);
      for (let d = 0; d < U; d++) perSec[jitter ? rnd(JITTER_S) : 0]++;
      return { flickers, delayAvg: delaySum / CR, delayMax, msgs, peak: Math.max(...perSec) };
    }
    let frame = 0;
    function draw() {
      const I = Number(q<HTMLSelectElement>('[data-i]').value); const m = Number(q<HTMLSelectElement>('[data-m]').value);
      const loss = Number(q<HTMLInputElement>('[data-loss]').value); const mode = q<HTMLSelectElement>('[data-mode]').value; const jit = q<HTMLInputElement>('[data-jit]').checked;
      q('[data-lossval]').textContent = String(loss);
      const r = sim(I, m, loss, mode, jit);
      q('[data-o1]').textContent = fmt(r.flickers); q('[data-n1]').textContent = `TTL is ${I * m} s, and a flicker is sent to friends twice (off, then on)`;
      q('[data-o2]').textContent = `${r.delayAvg.toFixed(1)} s on average`; q('[data-n2]').textContent = `slowest ${r.delayMax} s, because the TTL is ${I * m} s`;
      q('[data-o3]').textContent = `${fmt(r.msgs)} per second`; q('[data-n3]').textContent = mode === 'every' ? 'every heartbeat is broadcast, mostly saying still online' : 'only real status changes are published';
      q('[data-o4]').textContent = `${fmt(r.peak)} per second`; q('[data-n4]').textContent = `the backend admits ${CAP} per second`;
      const flick = r.flickers > 100; const storm = r.peak > CAP; const chatty = mode === 'every';
      q<HTMLElement>('[data-b1]').style.setProperty('--c', flick ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', r.delayMax > DELAY_BAD_S ? 'var(--bad)' : 'var(--accent)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', chatty || r.msgs > 100 ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b4]').style.setProperty('--c', storm ? 'var(--bad)' : 'var(--good)');
      const issues: string[] = [];
      if (flick) issues.push(`${fmt(r.flickers)} false offline flickers: the TTL of ${I * m} s is too short for ${loss}% loss`);
      if (chatty) issues.push(`broadcasting every heartbeat costs ${fmt(r.msgs)} messages per second`);
      if (storm) issues.push(`the reconnect peak of ${fmt(r.peak)} per second is above the ${CAP} the backend can admit`);
      if (r.delayMax > DELAY_BAD_S) issues.push(`a crashed device can look online for ${r.delayMax} s`);
      const out = q('[data-verdict]'); out.classList.toggle('bad', issues.length > 0);
      out.textContent = issues.length ? `Problems: ${issues.join('; ')}.` : `Healthy: ${fmt(r.flickers)} flickers, crashes noticed within ${r.delayMax} s, ${fmt(r.msgs)} messages per second, and a reconnect peak of ${fmt(r.peak)} per second.`;
    }
    const schedule = () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(draw); };
    root.addEventListener('input', schedule); root.addEventListener('change', schedule);
    draw();
  });
</script>
