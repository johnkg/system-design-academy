---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Heartbeats scale with every connected device, but status changes are rare. Compare the cost of broadcasting each heartbeat with publishing only changes.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Registered users (millions) <input type="range" min="10" max="1000" step="10" value="500" data-reg /> <b data-regval></b></label>
      <label>Connected at the peak (%) <input type="range" min="1" max="30" value="10" data-on /> <b data-onval></b></label>
      <label>Devices per connected user <input type="range" min="1" max="4" step="0.5" value="1.5" data-dev /> <b data-devval></b></label>
      <label>Heartbeat interval (seconds) <input type="range" min="5" max="60" step="5" value="30" data-int /> <b data-intval></b></label>
      <label>Friends per user <input type="range" min="20" max="1000" step="20" value="200" data-fr /> <b data-frval></b></label>
      <label>Friends who are online and watching (%) <input type="range" min="1" max="50" value="10" data-watch /> <b data-watchval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a session key with its metadata takes about 150 bytes and every key has one replica, one presence store shard handles about 100,000 heartbeats per second, and each connected user changes status about twice per 30 minutes, counting network flickers and devices coming and going. Only friends who are online and watching receive a message.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      ['reg', 'on', 'dev', 'int', 'fr', 'watch'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const users = val('[data-reg]') * 1e6 * (val('[data-on]') / 100);
      const sessions = users * val('[data-dev]');
      const beats = sessions / val('[data-int]');
      const memGb = (sessions * 150 * 2) / 1e9;
      const shards = Math.max(1, Math.ceil(beats / 100000));
      const changes = (users * 2) / 1800;
      const audience = val('[data-fr]') * (val('[data-watch]') / 100);
      const data: [string, string][] = [
        ['Connected users', fmt(users)],
        ['Live device sessions', fmt(sessions)],
        ['Heartbeats per second', fmt(beats)],
        ['Memory for session keys, with a replica', `${memGb.toFixed(1)} GB`],
        ['Presence store shards for heartbeats', fmt(shards)],
        ['Status changes per second', fmt(changes)],
        ['Messages per second, publishing changes only', fmt(changes * audience)],
        ['Messages per second, if every heartbeat were sent to watchers', fmt(beats * audience)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
