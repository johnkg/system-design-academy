---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Sandboxes cost memory, hung calls cost workers in proportion to the timeout, and a staged rollout trades speed for a small blast radius.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Peak plugin calls per second (hundreds)" name="c" min="5" max="100" value="30" />
      <RangeField label="Average plugin call time (ms)" name="ms" min="10" max="500" step="10" value="100" />
      <RangeField label="Plugins running at once (hundreds)" name="p" min="1" max="20" value="10" />
      <RangeField label="Memory per sandbox (MB)" name="mb" min="16" max="512" step="16" value="64" />
      <RangeField label="Share of calls to the hung plugin (%)" name="s" min="0.5" max="20" step="0.5" value="5" />
      <RangeField label="Call timeout (s)" name="t" min="1" max="60" value="2" />
      <RangeField label="Installs of the plugin (thousands)" name="i" min="1" max="50" value="40" />
      <RangeField label="Wait between rollout stages (hours)" name="w" min="1" max="24" value="6" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a host process has 40 workers, shared by everything running in it. A machine has 32 GB for sandboxes. A sandbox pool lets 4 calls to one plugin run at once. A hung call lasts until the timeout. A rollout goes to 1%, 5%, 25% and then 100% of installs, with the wait before each step after the first. All calls are spread evenly, with no bursts.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatWholeNumber, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const HUNDRED = 100, THOUSAND = 1e3, MS_PER_S = 1000, MB_PER_GB = 1000;
    const HOST_WORKERS = 40, MACHINE_GB = 32, POOL = 4;
    const STAGES = [1, 5, 25, 100]; // percent of installs at each rollout stage
    const N_ROWS = 9;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const calls = val('[data-c]') * HUNDRED, ms = val('[data-ms]'), plugins = val('[data-p]') * HUNDRED, mb = val('[data-mb]');
      const share = val('[data-s]'), timeout = val('[data-t]'), installs = val('[data-i]') * THOUSAND, wait = val('[data-w]');
      ['c', 'ms', 'p', 'mb', 's', 't', 'i', 'w'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const inFlight = (calls * ms) / MS_PER_S;
      const memGb = (plugins * mb) / MB_PER_GB;
      const hungRate = (calls * share) / HUNDRED;
      const held = hungRate * timeout;
      const slots = Math.min(POOL, Math.ceil(held));
      const data: [string, string][] = [
        ['Plugin calls in flight on average', formatWholeNumber(inFlight)],
        ['Memory for the sandboxes', `${formatOneDecimalBelow100(memGb)} GB`],
        [`Machines for that memory (${MACHINE_GB} GB each)`, formatWholeNumber(Math.max(1, Math.ceil(memGb / MACHINE_GB)))],
        ['Calls per second to the hung plugin', formatOneDecimalBelow100(hungRate)],
        [`In the host process: workers it holds, of ${HOST_WORKERS}`, `${formatWholeNumber(Math.min(held, HOST_WORKERS))}${held >= HOST_WORKERS ? ' (all of them: the host is stuck)' : ''}`],
        [`In its own sandbox pool: slots it holds, of ${POOL}`, `${formatWholeNumber(slots)}, and none of the host's workers`],
        [`Installs reached by the ${STAGES[0]}% stage`, formatWholeNumber((installs * STAGES[0]) / 100)],
        [`Installs reached if it halts at the ${STAGES[2]}% stage`, formatWholeNumber((installs * STAGES[2]) / 100)],
        ['Time until every install has the update', `${formatWholeNumber((STAGES.length - 1) * wait)} hours`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
