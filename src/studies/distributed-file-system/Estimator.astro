---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The master keeps every file and chunk in memory, so small files and small chunks cost it far more than big ones. Try a 1 MB average file size.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Chunkservers <input type="range" min="100" max="10000" step="100" value="4000" data-s /> <b data-sval></b></label>
      <label>Disk per server (TB) <input type="range" min="4" max="96" step="4" value="48" data-tb /> <b data-tbval></b></label>
      <label>Copies of each chunk <input type="range" min="2" max="4" value="3" data-r /> <b data-rval></b></label>
      <label>Chunk size <select class="pg-in" data-ck><option value="16">16 MB</option><option value="64">64 MB</option><option value="128" selected>128 MB</option><option value="256">256 MB</option></select></label>
      <label>Average file size <select class="pg-in" data-f><option value="1">1 MB</option><option value="16">16 MB</option><option value="256" selected>256 MB</option><option value="1024">1 GB</option><option value="10240">10 GB</option></select></label>
      <label>Recovery speed per server (MB/s) <input type="range" min="5" max="100" step="5" value="20" data-rec /> <b data-recval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: disks are 75% full, the master spends about 150 bytes of memory on each file and each chunk, every server sends a heartbeat every 3 seconds, a server is lost for good about 8 times in 100 server-years, and when a server dies all the other servers copy its chunks at the recovery speed in parallel.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const OUT_ROWS = 9; // lines in the result list
    const TB = 1e12, MB = 1e6;
    const USABLE = 0.75; // disks are filled to 75%
    const META_BYTES = 150; // master memory per file or chunk
    const HEARTBEAT_S = 3; // each server reports every 3 seconds
    const ANNUAL_FAILURE = 0.08, DAYS_PER_YEAR = 365; // 8% of servers fail each year
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const size = (bytes: number) => (bytes >= 1e15 ? `${(bytes / 1e15).toFixed(1)} PB` : bytes >= 1e12 ? `${(bytes / 1e12).toFixed(1)} TB` : `${(bytes / 1e9).toFixed(1)} GB`);
    const span = (sec: number) => (sec >= 3600 ? `${(sec / 3600).toFixed(1)} hours` : `${(sec / 60).toFixed(1)} minutes`);
    function draw() {
      const servers = val('[data-s]'); const tb = val('[data-tb]'); const copies = val('[data-r]'); const rec = val('[data-rec]');
      const chunkMb = Number(q<HTMLSelectElement>('[data-ck]').value); const fileMb = Number(q<HTMLSelectElement>('[data-f]').value);
      ['s', 'tb', 'r', 'rec'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const raw = servers * tb * TB; const logical = (raw * USABLE) / copies; // bytes of distinct data
      const files = logical / (fileMb * MB); const chunksPerFile = Math.ceil(fileMb / chunkMb); const chunks = files * chunksPerFile;
      const masterBytes = (files + chunks) * META_BYTES; const replicas = chunks * copies;
      const perServer = raw * USABLE / servers; const healSec = perServer / (servers * rec * MB);
      const data: [string, string][] = [
        ['Distinct data stored', size(logical)],
        ['Files', fmt(files)],
        ['Chunks (before copies)', fmt(chunks)],
        ['Master memory for files and chunks', size(masterBytes)],
        ['Chunk copies spread over the servers', fmt(replicas)],
        ['Heartbeats arriving at the master per second', fmt(servers / HEARTBEAT_S)],
        ['Servers lost per day', (servers * ANNUAL_FAILURE / DAYS_PER_YEAR).toFixed(2)],
        ['Data on one server that must be copied elsewhere', size(perServer)],
        ['Time to restore full copies after one server dies', span(healSec)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
