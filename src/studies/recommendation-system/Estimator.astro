---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Serving is a latency budget, and the embedding index is a memory budget. Both are small compared with the logging and training data that the system produces.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Daily active users (millions) <input type="range" min="1" max="500" value="100" data-u /> <b data-uval></b></label>
      <label>Recommendation requests per user per day <input type="range" min="1" max="50" value="10" data-r /> <b data-rval></b></label>
      <label>Items in the catalogue (millions) <input type="range" min="1" max="100" value="10" data-i /> <b data-ival></b></label>
      <label>Embedding size (floats) <select class="pg-in" data-d><option value="32">32</option><option value="64" selected>64</option><option value="128">128</option></select></label>
      <label>Items shown per request <input type="range" min="5" max="50" step="5" value="20" data-n /> <b data-nval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: the peak is 3 times the average rate, an embedding takes 4 bytes per float, the approximate nearest neighbour index adds 50% to the raw vectors, one index replica serves about 500 queries per second, the ranking model scores 500 candidates per request at about 20,000 candidates per second per CPU core, and each shown item is logged as an impression of about 200 bytes. About 90% of the shown items are never clicked, which is why impressions, not clicks, dominate the log volume.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement | HTMLSelectElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const size = (bytes: number) => (bytes >= 1e12 ? `${(bytes / 1e12).toFixed(1)} TB` : bytes >= 1e9 ? `${(bytes / 1e9).toFixed(1)} GB` : `${(bytes / 1e6).toFixed(1)} MB`);
    function draw() {
      const users = val('[data-u]') * 1e6; const perUser = val('[data-r]'); const items = val('[data-i]') * 1e6; const dim = val('[data-d]'); const shown = val('[data-n]');
      ['u', 'r', 'i', 'n'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const requests = users * perUser; const avg = requests / 86400; const peak = avg * 3;
      const indexBytes = items * dim * 4 * 1.5; const replicas = Math.ceil(peak / 500);
      const cores = Math.ceil((peak * 500) / 20000);
      const logBytes = requests * shown * 200;
      const data: [string, string][] = [
        ['Recommendation requests per second, average', fmt(avg)],
        ['Requests per second at the peak', fmt(peak)],
        ['Embedding index in memory (vectors plus graph)', size(indexBytes)],
        ['Index replicas needed at the peak', fmt(replicas)],
        ['Memory for all the index replicas', size(indexBytes * replicas)],
        ['CPU cores to rank 500 candidates per request at the peak', fmt(cores)],
        ['Impressions logged per day', fmt(requests * shown)],
        ['Log volume per day', size(logBytes)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
