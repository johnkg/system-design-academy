---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Storage depends on how much of each push is really new, so deduplication is the biggest lever. Bandwidth depends on how many layers a node already has and on how much the CDN absorbs.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Images pushed per day (thousands) <input type="range" min="1" max="200" value="20" data-push /> <b data-pushval></b></label>
      <label>Image size, compressed (MB) <input type="range" min="50" max="2000" step="50" value="400" data-size /> <b data-sizeval></b></label>
      <label>Layers per image <input type="range" min="4" max="40" value="12" data-layers /> <b data-layersval></b></label>
      <label>Bytes in a push that are new (%) <input type="range" min="1" max="50" value="5" data-new /> <b data-newval></b></label>
      <label>New bytes still referenced after cleanup (%) <input type="range" min="10" max="100" step="5" value="40" data-kept /> <b data-keptval></b></label>
      <label>Retention (days) <input type="range" min="30" max="730" step="10" value="360" data-days /> <b data-daysval></b></label>
      <label>Image pulls per day (millions) <input type="range" min="1" max="100" value="5" data-pull /> <b data-pullval></b></label>
      <label>Layers already on the pulling node (%) <input type="range" min="0" max="95" step="5" value="80" data-have /> <b data-haveval></b></label>
      <label>Layer downloads served by the CDN (%) <input type="range" min="0" max="99" value="90" data-cdn /> <b data-cdnval></b></label>
      <label>Regions holding a full copy <input type="range" min="1" max="6" value="3" data-reg /> <b data-regval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: sizes use 1 GB = 1,000 MB, the peak is 3 times the daily average, object storage costs $23 per TB-month, and every pull makes 2 calls (a token and the manifest) plus one redirect for each layer the node lacks. Uploading skips layers the registry already has, so the bytes sent equal the new bytes. The "bytes still referenced" share is what survives cleanup, since untagged images and orphan layers are swept.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 11;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const size = (gb: number) => (gb >= 1000 ? `${(gb / 1000).toLocaleString('en-US', { maximumFractionDigits: 1 })} TB` : `${fmt(gb)} GB`);
    const keys = ['push', 'size', 'layers', 'new', 'kept', 'days', 'pull', 'have', 'cdn', 'reg'];
    function draw() {
      keys.forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const pushes = val('[data-push]') * 1000; const mb = val('[data-size]'); const layers = val('[data-layers]');
      const fresh = val('[data-new]') / 100; const kept = val('[data-kept]') / 100; const days = val('[data-days]');
      const pulls = val('[data-pull]') * 1e6; const have = val('[data-have]') / 100; const cdn = val('[data-cdn]') / 100; const regions = val('[data-reg]');
      const logicalGb = (pushes * mb) / 1000; const newGb = logicalGb * fresh;
      const upMbps = (newGb * 8000) / 86400;
      const perRegionGb = newGb * kept * days; const totalGb = perRegionGb * regions;
      const noDedupGb = logicalGb * kept * days * regions;
      const pullGbps = (pulls * mb * (1 - have) * 8) / 1000 / 86400; const peakGbps = pullGbps * 3;
      const originGbps = peakGbps * (1 - cdn);
      const callsPeak = ((pulls * (2 + layers * (1 - have))) / 86400) * 3;
      const data: [string, string][] = [
        ['Bytes in all pushed images per day', size(logicalGb)],
        ['New bytes stored per day, after dedup', size(newGb)],
        ['Average upload traffic', `${fmt(upMbps)} Mbps`],
        ['Storage in one region after retention', size(perRegionGb)],
        ['Storage in all regions', size(totalGb)],
        ['Storage if nothing were shared', size(noDedupGb)],
        ['Storage bill per month', `$${fmt((totalGb / 1000) * 23)}`],
        ['Pull traffic at the average', `${fmt(pullGbps)} Gbps`],
        ['Pull traffic at the peak', `${fmt(peakGbps)} Gbps`],
        ['Of that, reaching the blob store', `${(Math.round(originGbps * 10) / 10).toLocaleString('en-US')} Gbps`],
        ['Registry API calls per second at the peak', fmt(callsPeak)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
