---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Storage depends on how much of each push is really new, so deduplication is the biggest lever. Bandwidth depends on how many layers a node already has and on how much the CDN absorbs.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Images pushed per day (thousands)" name="push" min="1" max="200" value="20" />
      <RangeField label="Image size, compressed (MB)" name="size" min="50" max="2000" step="50" value="400" />
      <RangeField label="Layers per image" name="layers" min="4" max="40" value="12" />
      <RangeField label="Bytes in a push that are new (%)" name="new" min="1" max="50" value="5" />
      <RangeField label="New bytes still referenced after cleanup (%)" name="kept" min="10" max="100" step="5" value="40" />
      <RangeField label="Retention (days)" name="days" min="30" max="730" step="10" value="360" />
      <RangeField label="Image pulls per day (millions)" name="pull" min="1" max="100" value="5" />
      <RangeField label="Layers already on the pulling node (%)" name="have" min="0" max="95" step="5" value="80" />
      <RangeField label="Layer downloads served by the CDN (%)" name="cdn" min="0" max="99" value="90" />
      <RangeField label="Regions holding a full copy" name="reg" min="1" max="6" value="3" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: sizes use 1 GB = 1,000 MB, the peak is 3 times the daily average, object storage costs $23 per TB-month, and every pull makes 2 calls (a token and the manifest) plus one redirect for each layer the node lacks. Uploading skips layers the registry already has, so the bytes sent equal the new bytes. The "bytes still referenced" share is what survives cleanup, since untagged images and orphan layers are swept.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 11;
    const THOUSAND = 1000; const MILLION = 1e6; const MB_PER_GB = 1000; const GB_PER_TB = 1000; const DAY_S = 86400;
    const MBIT_PER_GB = 8000; const BITS_PER_BYTE = 8; const MBIT_PER_GBIT = 1000;
    const PEAK_FACTOR = 3; // peak pull rate over the daily average
    const CALLS_PER_PULL = 2; // manifest calls per pull, plus one per layer to fetch
    const USD_PER_TB_MONTH = 23; // blob storage price
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const size = (gb: number) => (gb >= 1000 ? `${(gb / 1000).toLocaleString('en-US', { maximumFractionDigits: 1 })} TB` : `${fmt(gb)} GB`);
    const keys = ['push', 'size', 'layers', 'new', 'kept', 'days', 'pull', 'have', 'cdn', 'reg'];
    function draw() {
      keys.forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const pushes = val('[data-push]') * THOUSAND; const mb = val('[data-size]'); const layers = val('[data-layers]');
      const fresh = val('[data-new]') / 100; const kept = val('[data-kept]') / 100; const days = val('[data-days]');
      const pulls = val('[data-pull]') * MILLION; const have = val('[data-have]') / 100; const cdn = val('[data-cdn]') / 100; const regions = val('[data-reg]');
      const logicalGb = (pushes * mb) / MB_PER_GB; const newGb = logicalGb * fresh;
      const upMbps = (newGb * MBIT_PER_GB) / DAY_S;
      const perRegionGb = newGb * kept * days; const totalGb = perRegionGb * regions;
      const noDedupGb = logicalGb * kept * days * regions;
      const pullGbps = (pulls * mb * (1 - have) * BITS_PER_BYTE) / MBIT_PER_GBIT / DAY_S; const peakGbps = pullGbps * PEAK_FACTOR;
      const originGbps = peakGbps * (1 - cdn);
      const callsPeak = ((pulls * (CALLS_PER_PULL + layers * (1 - have))) / DAY_S) * PEAK_FACTOR;
      const data: [string, string][] = [
        ['Bytes in all pushed images per day', size(logicalGb)],
        ['New bytes stored per day, after dedup', size(newGb)],
        ['Average upload traffic', `${fmt(upMbps)} Mbps`],
        ['Storage in one region after retention', size(perRegionGb)],
        ['Storage in all regions', size(totalGb)],
        ['Storage if nothing were shared', size(noDedupGb)],
        ['Storage bill per month', `$${fmt((totalGb / GB_PER_TB) * USD_PER_TB_MONTH)}`],
        ['Pull traffic at the average', `${fmt(pullGbps)} Gbps`],
        ['Pull traffic at the peak', `${fmt(peakGbps)} Gbps`],
        ['Of that, reaching the blob store', `${(Math.round(originGbps * 10) / 10).toLocaleString('en-US')} Gbps`],
        ['Registry API calls per second at the peak', fmt(callsPeak)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
