---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Each step sends the whole conversation to the model again, so cost grows faster than the number of steps. Prompt caching and a cost cap matter for that reason.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Runs per day (thousands) <input type="range" min="1" max="500" value="50" data-r /> <b data-rval></b></label>
      <label>Model steps per run <input type="range" min="2" max="60" value="20" data-s /> <b data-sval></b></label>
      <label>Fixed prompt: instructions and tool schemas (tokens) <input type="range" min="500" max="10000" step="500" value="3000" data-p /> <b data-pval></b></label>
      <label>Tokens added per step: model output and tool result <input type="range" min="300" max="3000" step="100" value="700" data-a /> <b data-aval></b></label>
      <label>Input served from the prompt cache (%) <input type="range" min="0" max="95" step="5" value="70" data-c /> <b data-cval></b></label>
      <label>Seconds per step: model plus tool <input type="range" min="2" max="30" value="8" data-t /> <b data-tval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: $3 per million input tokens and $15 per million output tokens, cached input costs 10% of the normal input price, 300 of the added tokens in each step are model output, a step-log record takes 3 KB, the peak is 3 times the average, and the per-run cost cap is set at 3 times the average run.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const OUT_ROWS = 10; // lines in the result list
    const THOUSAND = 1000, MILLION = 1e6, DAY_S = 86400;
    const OUT_TOKENS_PER_STEP = 300;
    const USD_PER_M_TOKENS = { input: 3, output: 15 };
    const CACHED_PRICE = 0.1; // cached input tokens cost 10% of the normal price
    const RECORD_KB = 3; // one step-log record per step
    const PEAK_FACTOR = 3; // the busiest hour runs at 3 times the daily average
    const KB_PER_GB = 1e6;
    const COST_CAP = 3; // the per-run cap is 3 times the average cost
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const usd = (n: number) => '$' + (n >= 100 ? fmt(n) : n.toFixed(2));
    function draw() {
      const runs = val('[data-r]') * THOUSAND; const n = val('[data-s]'); const p = val('[data-p]'); const a = val('[data-a]'); const cached = val('[data-c]') / 100; const secs = val('[data-t]');
      ['r', 's', 'p', 'a', 'c', 't'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const input = n * p + a * (n * (n - 1)) / 2; // step i sends the fixed prompt plus everything added in steps 1..i-1
      const output = n * OUT_TOKENS_PER_STEP;
      const priceIn = USD_PER_M_TOKENS.input / MILLION; const priceOut = USD_PER_M_TOKENS.output / MILLION;
      const full = input * priceIn + output * priceOut;
      const withCache = input * (1 - cached) * priceIn + input * cached * priceIn * CACHED_PRICE + output * priceOut;
      const lastCtx = p + a * (n - 1);
      const inflight = (runs / DAY_S) * n * secs;
      const writes = ((runs * n) / DAY_S) * PEAK_FACTOR;
      const data: [string, string][] = [
        ['Input tokens per run (all steps added up)', fmt(input)],
        ['Output tokens per run', fmt(output)],
        ['Context size at the last step', `${fmt(lastCtx)} tokens`],
        ['Cost per run with no caching', usd(full)],
        ['Cost per run with the prompt cache', usd(withCache)],
        ['Model spend per day with the cache', usd(withCache * runs)],
        ['Runs in flight at the same time (average)', fmt(inflight)],
        ['Step-log writes per second at the peak', fmt(writes)],
        ['Step-log storage per day', `${((runs * n * RECORD_KB) / KB_PER_GB).toFixed(1)} GB`],
        [`Per-run cost cap (${COST_CAP} times the average)`, usd(withCache * COST_CAP)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
