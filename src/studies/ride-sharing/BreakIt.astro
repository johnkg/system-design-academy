---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Finding the nearest driver" hint="Place a rider on a 100 by 100 map of cells (2 by 2 each) and search for the closest driver three ways. Figures come from a real search over generated drivers.">
  <ol class="how">
    <li>Choose <b>check every driver</b> with <b>20,000 drivers</b>: the answer is right, but every driver is measured.</li>
    <li>Switch to <b>own cell only</b> with the rider <b>on a cell edge</b>: the search is fast but often misses a closer car just across the line, and the answer is marked wrong.</li>
    <li>Switch to <b>ring by ring</b>: it looks at only a few cells and always agrees with the full check. Lower the fleet to <b>200</b> and watch it widen the rings to find anyone.</li>
  </ol>
  <div class="pg rsb" data-rsb>
    <div class="pg-row">
      <label>Drivers online <select class="pg-in" data-n>
        <option value="200">200</option>
        <option value="2000">2,000</option>
        <option value="20000" selected>20,000</option>
        <option value="100000">100,000</option>
      </select></label>
      <label>Rider is <select class="pg-in" data-spot>
        <option value="middle">in the middle of a cell</option>
        <option value="edge" selected>on a cell edge</option>
      </select></label>
      <label>Search <select class="pg-in" data-method>
        <option value="all">Check every driver</option>
        <option value="own" selected>Own cell only</option>
        <option value="rings">Ring by ring until nothing closer is possible</option>
      </select></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-xbox><h3>Exact answer (every driver)</h3><span class="pg-mono" data-xout></span><span class="pg-note" data-xnote></span></div>
      <div class="pg-box" data-mbox><h3>Chosen search</h3><span class="pg-mono" data-mout></span><span class="pg-note" data-mnote></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: drivers are placed at random (the same ones every time) on a 100 by 100 map split into 2 by 2 cells. The rider stands at (21, 21) in the middle of a cell, or at (21.99, 21.99) on the corner of one. "Examined" counts the drivers whose distance was measured. Each search is repeated for 40 riders around the map so that the average is not a fluke.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-rsb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    type D = { x: number; y: number };
    const CELL = 2; const SIZE = 100;
    const cellOf = (v: number) => Math.floor(v / CELL);
    const dist = (a: D, b: D) => Math.hypot(a.x - b.x, a.y - b.y);
    let seed = 7; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
    let drivers: D[] = []; let cells = new Map<string, D[]>(); let builtFor = 0;
    function build(n: number) {
      if (builtFor === n) return;
      seed = 7; builtFor = n; cells = new Map();
      drivers = Array.from({ length: n }, () => ({ x: rnd() * SIZE, y: rnd() * SIZE }));
      drivers.forEach((d) => { const k = `${cellOf(d.x)},${cellOf(d.y)}`; (cells.get(k) ?? cells.set(k, []).get(k)!).push(d); });
    }
    function scan(list: D[], rider: D, state: { best: D | null; d: number; seen: number }) {
      for (const d of list) { state.seen++; const x = dist(rider, d); if (x < state.d) { state.d = x; state.best = d; } }
    }
    function search(method: string, rider: D) {
      const s = { best: null as D | null, d: Infinity, seen: 0, rings: 0 };
      if (method === 'all') { scan(drivers, rider, s); return s; }
      const cx = cellOf(rider.x), cy = cellOf(rider.y);
      const maxRing = method === 'own' ? 0 : SIZE / CELL;
      for (let k = 0; k <= maxRing; k++) {
        if (s.best && (k - 1) * CELL >= s.d) break;
        s.rings = k + 1;
        for (let dx = -k; dx <= k; dx++) for (let dy = -k; dy <= k; dy++) {
          if (Math.max(Math.abs(dx), Math.abs(dy)) !== k) continue;
          const list = cells.get(`${cx + dx},${cy + dy}`); if (list) scan(list, rider, s);
        }
      }
      return s;
    }
    function draw() {
      const n = Number(q<HTMLSelectElement>('[data-n]').value); const spot = q<HTMLSelectElement>('[data-spot]').value; const method = q<HTMLSelectElement>('[data-method]').value;
      build(n);
      const offset = spot === 'edge' ? 1.99 : 1;
      const riders: D[] = [{ x: 20 + offset, y: 20 + offset }];
      for (let i = 0; i < 39; i++) riders.push({ x: 4 * (1 + (i % 8) * 3) + offset, y: 4 * (1 + Math.floor(i / 8) * 4) + offset });
      let seen = 0; let seenExact = 0; let wrong = 0; let missing = 0;
      for (const r of riders) {
        const exact = search('all', r); const got = search(method, r);
        seenExact += exact.seen; seen += got.seen;
        if (!got.best) missing++; else if (got.d > exact.d + 1e-9) wrong++;
      }
      const first = riders[0]; const e = search('all', first); const m = search(method, first);
      const fmtD = (s: { best: D | null; d: number }) => (s.best ? `nearest driver ${s.d.toFixed(2)} away` : 'no driver found');
      q('[data-xout]').textContent = fmtD(e); q('[data-xnote]').textContent = `examined ${e.seen.toLocaleString('en-US')} drivers`;
      q('[data-mout]').textContent = fmtD(m); q('[data-mnote]').textContent = `examined ${m.seen.toLocaleString('en-US')} drivers${method === 'all' ? '' : `, looked in ${m.rings} ring${m.rings === 1 ? '' : 's'} of cells`} · average over ${riders.length} riders: ${Math.round(seen / riders.length).toLocaleString('en-US')}`;
      const right = m.best === e.best;
      q<HTMLElement>('[data-xbox]').style.setProperty('--c', 'var(--good)');
      q<HTMLElement>('[data-mbox]').style.setProperty('--c', right ? 'var(--good)' : 'var(--bad)');
      const out = q('[data-verdict]');
      const bad = wrong + missing > 0;
      out.classList.toggle('bad', bad);
      out.textContent = bad
        ? `This search gave the wrong answer for ${wrong + missing} of ${riders.length} riders${missing ? ` (${missing} found nobody at all)` : ''}. A closer car was in a neighbouring cell.`
        : method === 'all' ? `Always right, but it measured ${Math.round(seenExact / riders.length).toLocaleString('en-US')} drivers per request on average.`
        : `Right for all ${riders.length} riders, measuring ${Math.round(seen / riders.length).toLocaleString('en-US')} drivers per request instead of ${Math.round(seenExact / riders.length).toLocaleString('en-US')}.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
