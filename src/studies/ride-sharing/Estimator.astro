---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Change the size of the fleet and see why location updates, not ride requests, are the heavy load.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Drivers online at the peak (thousands) <input type="range" min="1" max="1000" value="200" data-drivers /> <b data-driversval></b></label>
      <label>Seconds between location updates <input type="range" min="1" max="15" value="4" data-gap /> <b data-gapval></b></label>
      <label>Rides per day (millions) <input type="range" min="0.1" max="30" step="0.1" value="5" data-rides /> <b data-ridesval></b></label>
      <label>Average trip length (minutes) <input type="range" min="5" max="60" step="5" value="20" data-len /> <b data-lenval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a location update is about 100 bytes, peak ride requests are 4 times the daily average rate, a trip is open for its length plus 5 minutes of waiting and pickup, one index shard handles about 20,000 updates per second, and every online driver and every rider in a trip keeps one open connection.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const drivers = val('[data-drivers]') * 1000; const gap = val('[data-gap]'); const rides = val('[data-rides]') * 1e6; const len = val('[data-len]');
      q('[data-driversval]').textContent = String(val('[data-drivers]')); q('[data-gapval]').textContent = String(gap);
      q('[data-ridesval]').textContent = val('[data-rides]').toFixed(1); q('[data-lenval]').textContent = String(len);
      const updates = drivers / gap; const requests = (rides / 86400) * 4;
      const openTrips = (rides / 1440) * (len + 5) ;
      const trailGb = (updates * 100 * 86400) / 1e9;
      const data: [string, string][] = [
        ['Location updates per second', fmt(updates)],
        ['Ride requests per second at the peak', requests.toFixed(1)],
        ['Location updates for each ride request', fmt(updates / requests)],
        ['Location data written per second', `${((updates * 100) / 1e6).toFixed(1)} MB`],
        ['Trail kept per day if every point is stored', `${fmt(trailGb)} GB`],
        ['Trips open at the same time (average)', fmt(openTrips)],
        ['Open connections to the push gateway', fmt(drivers + openTrips)],
        ['Index shards needed for the updates alone', fmt(Math.ceil(updates / 20000))],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
