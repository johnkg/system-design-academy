---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Change the size of the fleet and see why location updates, not ride requests, are the heavy load.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Drivers online at the peak (thousands)" name="drivers" min="1" max="1000" value="200" />
      <RangeField label="Seconds between location updates" name="gap" min="1" max="15" value="4" />
      <RangeField label="Rides per day (millions)" name="rides" min="0.1" max="30" step="0.1" value="5" />
      <RangeField label="Average trip length (minutes)" name="len" min="5" max="60" step="5" value="20" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a location update is about 100 bytes, peak ride requests are 4 times the daily average rate, a trip is open for its length plus 5 minutes of waiting and pickup, one index shard handles about 20,000 updates per second, and every online driver and every rider in a trip keeps one open connection.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 8; // one per output line
    const THOUSAND = 1000; const MILLION = 1e6; const DAY_S = 86400; const MIN_PER_DAY = 1440; const BYTES_PER_MB = 1e6; const BYTES_PER_GB = 1e9;
    const PEAK_X = 4; const PICKUP_MIN = 5; // peak vs average requests; minutes to reach the rider
    const POINT_BYTES = 100; const UPDATES_PER_SHARD = 20000;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const drivers = val('[data-drivers]') * THOUSAND; const gap = val('[data-gap]'); const rides = val('[data-rides]') * MILLION; const len = val('[data-len]');
      q('[data-driversval]').textContent = String(val('[data-drivers]')); q('[data-gapval]').textContent = String(gap);
      q('[data-ridesval]').textContent = val('[data-rides]').toFixed(1); q('[data-lenval]').textContent = String(len);
      const updates = drivers / gap; const requests = (rides / DAY_S) * PEAK_X;
      const openTrips = (rides / MIN_PER_DAY) * (len + PICKUP_MIN) ;
      const trailGb = (updates * POINT_BYTES * DAY_S) / BYTES_PER_GB;
      const data: [string, string][] = [
        ['Location updates per second', fmt(updates)],
        ['Ride requests per second at the peak', requests.toFixed(1)],
        ['Location updates for each ride request', fmt(updates / requests)],
        ['Location data written per second', `${((updates * POINT_BYTES) / BYTES_PER_MB).toFixed(1)} MB`],
        ['Trail kept per day if every point is stored', `${fmt(trailGb)} GB`],
        ['Trips open at the same time (average)', fmt(openTrips)],
        ['Open connections to the push gateway', fmt(drivers + openTrips)],
        ['Index shards needed for the updates alone', fmt(Math.ceil(updates / UPDATES_PER_SHARD))],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
