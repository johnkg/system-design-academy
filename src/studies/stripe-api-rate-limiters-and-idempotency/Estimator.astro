---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How much of a runaway script a token bucket lets through, what the workers see with and without it, how large a reserve for charges must be, and how many charges are made twice when clients retry without keys. A teaching model with round numbers, not Stripe's limits.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Token refill per user (requests per second)" name="r" min="10" max="200" step="10" value="100" />
      <RangeField label="Bucket size (the burst a user may send)" name="b" min="10" max="1000" step="10" value="500" />
      <RangeField label="Runaway script sends (requests per second)" name="q" min="100" max="10000" step="100" value="5000" />
      <RangeField label="Script runs for (seconds)" name="d" min="1" max="120" value="30" />
      <RangeField label="Workers can finish (requests per second)" name="c" min="200" max="3000" step="100" value="1000" />
      <RangeField label="Everyone else sends (requests per second)" name="n" min="100" max="2000" step="100" value="600" />
      <RangeField label="Share of that which is critical, such as charges (%)" name="k" min="5" max="80" step="5" value="30" />
      <RangeField label="Share of capacity non-critical requests may use (%)" name="u" min="10" max="100" step="10" value="50" />
      <RangeField label="Cap on requests in progress per user" name="cc" min="1" max="100" value="20" />
      <RangeField label="A heavy request takes (milliseconds)" name="l" min="50" max="2000" step="50" value="300" />
      <RangeField label="Finished charges whose answer is lost (%)" name="p" min="0" max="10" step="0.5" value="2" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Teaching model, not Stripe's system or data. Stripe's posts give no production limits: their figures of 20 requests in progress and a 20% reserve are examples, and the rest here are guesses of mine that you can change. Assumptions: the bucket starts full and refills evenly; the script is one user and sends only non-critical requests; everyone else is spread over many users and stays under every per-user limit; and clients retry every lost answer. Requests in progress follow Little's law, which says a user who finishes each request in the stated time can complete at most the cap divided by that time. The doubled charges are an upper estimate: they assume the retry runs as a second charge.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 14; // lines in the result list
    const MS_PER_SECOND = 1000, SECONDS_PER_HOUR = 3600, PERCENT = 100;
    const BACKOFF_RETRY = 3, BACKOFF_BASE = 2; // the third retry waits a time proportional to 2 to the power 3
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      ['r', 'b', 'q', 'd', 'c', 'n', 'k', 'u', 'cc', 'l', 'p'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const refill = val('[data-r]'), bucket = val('[data-b]'), script = val('[data-q]'), seconds = val('[data-d]');
      const capacity = val('[data-c]'), normal = val('[data-n]'), criticalPct = val('[data-k]'), nonCriticalPct = val('[data-u]');
      const concurrency = val('[data-cc]'), heavyMs = val('[data-l]'), lostPct = val('[data-p]');
      const steady = Math.min(script, refill);
      const burst = Math.min(script, bucket);
      const sent = script * seconds;
      const letThrough = burst + (seconds - 1) * steady;
      const critical = (normal * criticalPct) / PERCENT;
      const reserve = (capacity * (PERCENT - nonCriticalPct)) / PERCENT;
      const nonCriticalRoom = (capacity * nonCriticalPct) / PERCENT;
      const nonCriticalOffered = normal - critical + script;
      const data: [string, string][] = [
        ['Requests the limiter lets through each second, after the burst', formatOneDecimalBelow100(steady)],
        ['Requests let through in the first second (the burst)', formatOneDecimalBelow100(burst)],
        ['Requests the script sends in the whole run', formatOneDecimalBelow100(sent)],
        ['Requests the limiter lets through in the whole run', formatOneDecimalBelow100(letThrough)],
        ['Rejected with 429', `${formatOneDecimalBelow100((PERCENT * (sent - letThrough)) / sent)}% of the script’s requests`],
        ['Load on the workers with no limiter (times their capacity)', formatOneDecimalBelow100((normal + script) / capacity)],
        ['Load on the workers with the limiter, after the burst (times capacity)', formatOneDecimalBelow100((normal + steady) / capacity)],
        ['Most requests per second one user can finish under the cap on requests in progress', formatOneDecimalBelow100(concurrency / (heavyMs / MS_PER_SECOND))],
        ['Capacity kept back for critical requests (per second)', formatOneDecimalBelow100(reserve)],
        ['Critical requests arriving (per second)', formatOneDecimalBelow100(critical)],
        ['Critical requests the reserve cannot hold (per second)', formatOneDecimalBelow100(Math.max(0, critical - reserve))],
        ['Non-critical requests shed each second in the incident, with no limiter', formatOneDecimalBelow100(Math.max(0, nonCriticalOffered - nonCriticalRoom))],
        ['Charges made twice per hour if clients retry lost answers without keys', formatOneDecimalBelow100((critical * SECONDS_PER_HOUR * lostPct) / PERCENT)],
        ['Backoff window before the 3rd retry, if the base wait is 1 second (seconds)', formatOneDecimalBelow100(BACKOFF_BASE ** BACKOFF_RETRY)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
