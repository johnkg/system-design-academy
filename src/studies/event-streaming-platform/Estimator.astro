---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Retention and replication decide how many brokers you need for disk, and the readers decide how many you need for the network. Find out which one wins.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Events per second (thousands)" name="ev" min="50" max="2000" step="50" value="500" />
      <RangeField label="Average event size (KB)" name="sz" min="0.2" max="10" step="0.1" value="1" />
      <RangeField label="Retention (days)" name="days" min="1" max="30" value="7" />
      <RangeField label="Replication factor" name="rf" min="1" max="5" value="3" />
      <RangeField label="Consumer groups reading everything" name="g" min="0" max="10" value="4" />
      <RangeField label="Disk per broker (TB)" name="disk" min="4" max="48" step="4" value="24" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: events are not compressed, 70% of each disk is usable, a broker can move about 750 MB/s of network traffic in and out together (a 10 Gbit/s card at 60%), one partition is kept to about 10 MB/s of writes, and every consumer group reads the whole stream once. Peak traffic is already the number you enter.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 9; // one per output line
    const DAY_S = 86400; const MB_PER_TB = 1e6;
    const DISK_USABLE = 0.7; const BROKER_NET_MBPS = 750; const PARTITION_MBPS = 10; // per broker disk share and network; write rate per partition
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
    function draw() {
      const ev = val('[data-ev]'); const sz = val('[data-sz]'); const days = val('[data-days]'); const rf = val('[data-rf]'); const g = val('[data-g]'); const disk = val('[data-disk]');
      ['ev', 'sz', 'days', 'rf', 'g', 'disk'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const ingress = ev * sz; // thousands of events per second times KB is MB per second
      const perDayTb = (ingress * DAY_S) / MB_PER_TB; const storedTb = perDayTb * days * rf;
      const brokersDisk = Math.ceil(storedTb / (disk * DISK_USABLE));
      const network = ingress * (1 + (rf - 1) + g); const brokersNet = Math.ceil(network / BROKER_NET_MBPS);
      const brokers = Math.max(brokersDisk, brokersNet, rf);
      const partitions = Math.max(1, Math.ceil(ingress / PARTITION_MBPS)); const replicas = partitions * rf;
      const data: [string, string][] = [
        ['Data written per second', `${fmt1(ingress)} MB/s`],
        ['New data per day, before copies', `${fmt1(perDayTb)} TB`],
        ['Disk for the retention, with all copies', `${fmt(storedTb)} TB`],
        ['Brokers needed for disk', fmt(brokersDisk)],
        ['Network in and out of the cluster', `${fmt(network)} MB/s (producers, replication and readers)`],
        ['Brokers needed for network', fmt(brokersNet)],
        ['Brokers to run (the larger of the two, at least one per copy)', `${fmt(brokers)} (${brokersDisk >= brokersNet ? 'disk' : 'network'} sets it)`],
        ['Partitions for the write rate', fmt(partitions)],
        ['Partition replicas per broker', fmt(Math.ceil(replicas / brokers))],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
