---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Chunkservers die" hint="Choose how many copies each chunk has, how many of 10 chunkservers die at once, how many copies the master may make at once and in what order, and see which chunks are lost, which are down to one copy, and how long recovery takes. A simple model, not Google's code or data.">
  <ol class="how">
    <li>Press <b>Reset</b>. With the defaults nothing is lost and making the missing copies takes <b>19.6</b> minutes.</li>
    <li>Set <b>Servers failing (of 10)</b> to <b>2</b>: <b>118</b> chunks are down to one copy, and because the most endangered are copied first the danger ends after <b>4</b> minutes.</li>
    <li>Set <b>Servers failing (of 10)</b> to <b>3</b>: <b>15</b> chunks are lost for good, and <b>330</b> more are down to one copy.</li>
    <li>Set <b>Copying order</b> to <b>Any order</b> with <b>2</b> servers failing: the danger lasts <b>39.5</b> minutes instead of <b>4</b>.</li>
    <li>Set <b>Parallel clones</b> to <b>10</b> and <b>Copying order</b> back to <b>Most endangered first</b>, with <b>2</b> servers failing: the danger ends after <b>2</b> minutes.</li>
    <li>Set <b>Servers failing (of 10)</b> to <b>3</b> and <b>Replication factor</b> to <b>5</b>: <b>0</b> chunks are lost, because no chunk had all five copies on the three failed servers.</li>
  </ol>
  <div class="pg brk" data-brk>
    <div class="pg-row">
      <RangeField label="Replication factor" name="copies" min="1" max="5" value="3" />
      <RangeField label="Servers failing (of 10)" name="dead" min="0" max="5" value="1" />
      <RangeField label="Parallel clones" name="clones" min="1" max="20" value="5" />
      <label>Copying order <select class="pg-in" data-order><option value="first">Most endangered first</option><option value="any">Any order</option></select></label>
      <button type="button" class="btn" data-reset>Reset</button>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Chunks lost for good (of 2,000)</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Chunks down to one copy</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Minutes until every chunk has all its copies</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Minutes until no chunk has a single copy</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model, invented for teaching and not Google data: 10 chunkservers hold 2,000 chunks of 64 MB, with each chunk's copies on different servers chosen at random. The servers die in a fixed order. The master makes the missing copies, each copy running at the paper's limit of 6.25 MB per second and as many at once as you set. In the paper, a master gives higher priority to chunks that lost more copies, and it limits clones so applications are not slowed. With any order, the model assumes the single-copy chunks are spread evenly among the chunks to copy. Real clusters also spread copies across racks.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, formatWholeNumber, mulberry32 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-brk]').forEach((root) => {
    const q = query(root);
    const DEFAULTS: Record<string, string> = {"copies": "3", "dead": "1", "clones": "5", "order": "first"};
    const input = (k: string) => q<HTMLInputElement>(`[data-${k}]`);
    const select = (k: string) => q<HTMLSelectElement>(`[data-${k}]`);
    const whole = formatWholeNumber;
    const one = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');

    function draw() {
      const order = select('order').value;
      const copies = Number(input('copies').value);
      const dead = Number(input('dead').value);
      const clones = Number(input('clones').value);
      q('[data-copiesval]').textContent = String(copies);
      q('[data-deadval]').textContent = String(dead);
      q('[data-clonesval]').textContent = String(clones);
      const boxes: { big: string; note: string; bad: boolean }[] = [];
      let verdict = '';
      let failed = false;
      const SERVERS = 10, CHUNKS = 2000, CHUNK_MB = 64, CLONE_MBS = 6.25;
      const deadSet = new Set([3, 7, 1, 8, 5].slice(0, dead));
      const rand = mulberry32(11);
      let lost = 0, single = 0, needed = 0;
      for (let c = 0; c < CHUNKS; c++) {
        const servers = Array.from({ length: SERVERS }, (_, i) => i);
        for (let i = 0; i < copies; i++) { const j = i + Math.floor(rand() * (SERVERS - i)); [servers[i], servers[j]] = [servers[j], servers[i]]; }
        const live = servers.slice(0, copies).filter((s) => !deadSet.has(s)).length;
        if (live === 0) { lost++; continue; }
        if (live === 1 && copies > 1) single++;
        needed += copies - live;
      }
      const rate = clones * CLONE_MBS; // MB per second across all clones
      const full = (needed * CHUNK_MB) / rate / 60;
      const safe = single === 0 ? 0 : order === 'first' ? (single * CHUNK_MB) / rate / 60 : full * (single / (single + 1));
      boxes.push({ big: whole(lost), note: lost > 0 ? 'every copy of these chunks was on a dead chunkserver' : 'every chunk still has a live copy', bad: lost > 0 });
      boxes.push({ big: whole(single), note: single > 0 ? 'one more failure could lose these' : 'no chunk is one failure from loss', bad: single > 0 });
      boxes.push({ big: needed === 0 ? '0' : one(full), note: `copies to make: ${whole(needed)}, at ${one(rate)} MB per second in total`, bad: false });
      boxes.push({ big: one(safe), note: single === 0 ? 'nothing at risk' : order === 'first' ? 'the most endangered chunks are copied first' : 'in a random order the last single-copy chunk waits until nearly the end', bad: false });
      failed = lost > 0 || single > 0;
      if (lost > 0) verdict = `${whole(lost)} chunks are gone: all their copies were on the ${dead} failed chunkserver${dead === 1 ? '' : 's'}. More copies, or spreading them across racks, would have prevented it.`;
      else if (single > 0) verdict = `${whole(single)} chunks are down to one copy. ${order === 'first' ? 'They are copied first, so the risk window is short.' : 'In any order they stay at risk much longer.'}`;
      else verdict = dead === 0 ? 'Nothing failed.' : 'Every chunk still has at least two copies, so it can survive another failure while the master copies the missing ones.';
      boxes.forEach((b, i) => {
        q(`[data-o${i + 1}]`).textContent = b.big;
        q(`[data-n${i + 1}]`).textContent = b.note;
        q<HTMLElement>(`[data-b${i + 1}]`).style.setProperty('--c', b.bad ? 'var(--bad)' : 'var(--good)');
      });
      const out = q('[data-verdict]'); out.classList.toggle('bad', failed); out.textContent = verdict;
    }
    root.addEventListener('input', draw);
    root.addEventListener('change', draw);
    q('[data-reset]').addEventListener('click', () => {
      Object.entries(DEFAULTS).forEach(([k, v]) => { (root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-${k}]`)!).value = v; });
      draw();
    });
    draw();
  });
</script>
