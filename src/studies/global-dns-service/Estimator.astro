---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Query rate sizes the servers and links, zone data sizes the memory of every site, and health probes are a load of their own.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Queries per day (billions) <input type="range" min="10" max="2000" step="10" value="400" data-q /> <b data-qval></b></label>
      <label>Peak compared with average <input type="range" min="1" max="4" step="0.5" value="2" data-pk /> <b data-pkval></b></label>
      <label>Sites <input type="range" min="10" max="200" step="5" value="50" data-s /> <b data-sval></b></label>
      <label>Queries per second per server (thousands) <input type="range" min="50" max="500" step="50" value="250" data-qs /> <b data-qsval></b></label>
      <label>Capacity for attacks, times the peak <input type="range" min="1" max="20" value="10" data-hd /> <b data-hdval></b></label>
      <label>Zones (millions) <input type="range" min="1" max="20" value="5" data-z /> <b data-zval></b></label>
      <label>Records per zone <input type="range" min="5" max="100" step="5" value="20" data-r /> <b data-rval></b></label>
      <label>Changes per zone per day <input type="range" min="1" max="20" value="2" data-ch /> <b data-chval></b></label>
      <label>Health-checked endpoints (thousands) <input type="range" min="50" max="2000" step="50" value="500" data-hc /> <b data-hcval></b></label>
      <label>Seconds between health checks <input type="range" min="10" max="60" step="10" value="30" data-iv /> <b data-ivval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the busiest site gets 2 times the average share of the queries, an answer is about 150 bytes on the wire, a record takes about 200 bytes in memory including the tree and prepared answers, one change message is about 1 KB, and every endpoint is probed from 8 regions. Every site holds all zones. Queries are those that reach us after resolver caches, so they are what the name servers must answer.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 12; // output lines below
    const THOUSAND = 1000; const MILLION = 1e6; const BILLION = 1e9; const GB = 1e9; const DAY_S = 86400; const BITS_PER_BYTE = 8; const BITS_PER_GBIT = 1e9; const BITS_PER_MBIT = 1e6;
    const BUSIEST_FACTOR = 2; // the busiest site takes twice its even share
    const RECORD_BYTES = 200; const ANSWER_BYTES = 150; const CHANGE_MSG_BYTES = 1000;
    const PROBE_REGIONS = 8; // regions each endpoint is health-checked from
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const keys = ['q', 'pk', 's', 'qs', 'hd', 'z', 'r', 'ch', 'hc', 'iv'];
      keys.forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perDay = val('[data-q]') * BILLION; const sites = val('[data-s]'); const perServer = val('[data-qs]') * THOUSAND; const headroom = val('[data-hd]');
      const zones = val('[data-z]') * MILLION; const recs = val('[data-r]'); const changes = val('[data-ch]'); const endpoints = val('[data-hc]') * THOUSAND; const iv = val('[data-iv]');
      const avg = perDay / DAY_S; const peak = avg * val('[data-pk]'); const busiest = (peak / sites) * BUSIEST_FACTOR;
      const serversBusiest = Math.ceil((busiest * headroom) / perServer);
      const memGb = (zones * recs * RECORD_BYTES) / GB;
      const egressBusiest = (busiest * ANSWER_BYTES * BITS_PER_BYTE) / BITS_PER_GBIT;
      const updates = (zones * changes) / DAY_S;
      const data: [string, string][] = [
        ['Average queries per second', fmt(avg)],
        ['Peak queries per second, all sites', fmt(peak)],
        ['Peak at the busiest site', fmt(busiest)],
        ['Servers at the busiest site, with attack capacity', fmt(serversBusiest)],
        ['Servers in the fleet if every site is sized like the busiest', fmt(serversBusiest * sites)],
        ['Zone data in memory at every site', `${fmt1(memGb)} GB`],
        ['Answer traffic at the busiest site at peak', `${fmt1(egressBusiest)} Gbps`],
        ['Link capacity at the busiest site, with attack capacity', `${fmt1(egressBusiest * headroom)} Gbps`],
        ['Zone changes per second', fmt(updates)],
        ['Change messages per second sent to all sites', fmt(updates * sites)],
        ['Change feed bandwidth into every site', `${fmt1((updates * CHANGE_MSG_BYTES * BITS_PER_BYTE) / BITS_PER_MBIT)} Mbps`],
        [`Health probes per second, ${PROBE_REGIONS} regions`, fmt((endpoints * PROBE_REGIONS) / iv)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
