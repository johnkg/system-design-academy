---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="One keystroke is sent to everyone else in the document, so the cost grows quickly with the number of editors.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Editors in one document <input type="range" min="2" max="100" value="10" data-n /> <b data-nval></b></label>
      <label>Share who are typing at any moment (%) <input type="range" min="5" max="100" step="5" value="30" data-act /> <b data-actval></b></label>
      <label>Characters per second while typing <input type="range" min="1" max="10" value="4" data-cps /> <b data-cpsval></b></label>
      <label>Open documents (millions) <input type="range" min="1" max="50" value="5" data-docs /> <b data-docsval></b></label>
      <label>Snapshot every this many operations <input type="range" min="100" max="2000" step="100" value="500" data-snap /> <b data-snapval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: an operation is about 40 bytes with its envelope, a document server holds up to 2,000 live documents in memory, a snapshot is 50 KB, and a typical open document has 3 editors (the editors slider shows one very busy document), 30% of them are typing at any moment, and each typing editor averages 4 operations a minute over all open documents, because most are idle most of the time.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 8; // output lines below
    const MILLION = 1e6; const HOUR_S = 3600; const S_PER_MIN = 60; const BYTES_PER_KB = 1000; const KB_PER_MB = 1000;
    const OP_BYTES = 40; const SNAPSHOT_KB = 50; // one operation on the wire; one stored snapshot
    const DOCS_PER_SERVER = 2000; // open documents one document server holds
    const TYPICAL = { users: 3, active: 0.3, opsPerMin: 4 }; // a typical open document: editors, share typing, operations per minute each
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const n = val('[data-n]'); const act = val('[data-act]'); const cps = val('[data-cps]'); const docs = val('[data-docs]') * MILLION; const snap = val('[data-snap]');
      ['n', 'act', 'cps', 'docs', 'snap'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const ops = n * (act / 100) * cps; const fan = ops * (n - 1);
      const data: [string, string][] = [
        ['Operations per second in this document', ops.toFixed(1)],
        ['Messages sent out per second (fan-out)', fmt(fan)],
        ['Outgoing data from this document per second', `${((fan * OP_BYTES) / BYTES_PER_KB).toFixed(1)} KB`],
        ['Operations logged per hour of typing', fmt(ops * HOUR_S)],
        ['Snapshots written per hour', fmt((ops * HOUR_S) / snap)],
        ['Snapshot storage per hour', `${(((ops * HOUR_S) / snap) * SNAPSHOT_KB / KB_PER_MB).toFixed(1)} MB`],
        ['Document servers for all open documents', fmt(Math.ceil(docs / DOCS_PER_SERVER))],
        ['Operations per second across typical documents', fmt(docs * TYPICAL.users * TYPICAL.active * TYPICAL.opsPerMin / S_PER_MIN)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
