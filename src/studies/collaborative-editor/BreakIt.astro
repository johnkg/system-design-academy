---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Two edits at the same moment" hint="Alice and Bob start from the same text and each make one edit before they see the other's. Compare what happens when each copy applies the other's edit as written, or after transforming it.">
  <ol class="how">
    <li>Load the example <b>Insert at the start, delete at the end</b>. Without transformation, Alice and Bob end up with <b>different text</b>. With it, both end up with the same text.</li>
    <li>Try <b>Both insert at the same place</b>. The server needs a tie-break rule, here the lower user number goes first, so everyone orders the two letters the same way.</li>
    <li>Try <b>Both delete the same letter</b>: without care, two letters are removed. The transformed edit becomes a no-op, because the letter is already gone.</li>
  </ol>
  <div class="pg otb" data-otb>
    <div class="pg-row">
      <label>Example <select class="pg-in" data-ex>
        <option value="mix" selected>Insert at the start, delete at the end</option>
        <option value="same">Both insert at the same place</option>
        <option value="del">Both delete the same letter</option>
        <option value="custom">My own edits</option>
      </select></label>
      <label>Starting text <input class="pg-in" type="text" maxlength="14" value="CAT" autocomplete="off" spellcheck="false" data-text /></label>
    </div>
    <div class="pg-row">
      <label>Alice <select class="pg-in" data-at><option value="ins">inserts</option><option value="del">deletes</option></select></label>
      <label>at position <input class="pg-in" type="number" min="0" value="0" data-ap /></label>
      <label>the letter <input class="pg-in" type="text" maxlength="1" value="X" autocomplete="off" spellcheck="false" data-ac /></label>
    </div>
    <div class="pg-row">
      <label>Bob <select class="pg-in" data-bt><option value="ins">inserts</option><option value="del" selected>deletes</option></select></label>
      <label>at position <input class="pg-in" type="number" min="0" value="2" data-bp /></label>
      <label>the letter <input class="pg-in" type="text" maxlength="1" value="Y" autocomplete="off" spellcheck="false" data-bc /></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Without transformation</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>With transformation</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Positions count from 0, so position 0 is before the first letter. An insert at position p puts the new letter before the letter now at p, and a delete at p removes that letter. Alice is user 1 and Bob is user 2.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-otb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    type Op = { type: 'ins' | 'del'; pos: number; ch: string; site: number } | null;
    const apply = (t: string, op: Op) => (!op ? t : op.type === 'ins' ? t.slice(0, op.pos) + op.ch + t.slice(op.pos) : t.slice(0, op.pos) + t.slice(op.pos + 1));
    function transform(a: Op, b: Op): Op {
      if (!a || !b) return a;
      if (a.type === 'ins' && b.type === 'ins') return a.pos < b.pos || (a.pos === b.pos && a.site < b.site) ? a : { ...a, pos: a.pos + 1 };
      if (a.type === 'ins' && b.type === 'del') return a.pos <= b.pos ? a : { ...a, pos: a.pos - 1 };
      if (a.type === 'del' && b.type === 'ins') return a.pos < b.pos ? a : { ...a, pos: a.pos + 1 };
      if (a.pos < b.pos) return a;
      if (a.pos > b.pos) return { ...a, pos: a.pos - 1 };
      return null;
    }
    const text = q<HTMLInputElement>('[data-text]'); const ex = q<HTMLSelectElement>('[data-ex]');
    const f = { at: q<HTMLSelectElement>('[data-at]'), ap: q<HTMLInputElement>('[data-ap]'), ac: q<HTMLInputElement>('[data-ac]'), bt: q<HTMLSelectElement>('[data-bt]'), bp: q<HTMLInputElement>('[data-bp]'), bc: q<HTMLInputElement>('[data-bc]') };
    const show = (s: string) => `"${s}"`;
    function preset() {
      const v = ex.value; if (v === 'custom') return;
      text.value = v === 'mix' ? 'CAT' : v === 'same' ? 'CAT' : 'CAT';
      if (v === 'mix') { f.at.value = 'ins'; f.ap.value = '0'; f.ac.value = 'X'; f.bt.value = 'del'; f.bp.value = '2'; }
      if (v === 'same') { f.at.value = 'ins'; f.ap.value = '1'; f.ac.value = 'X'; f.bt.value = 'ins'; f.bp.value = '1'; f.bc.value = 'Y'; }
      if (v === 'del') { f.at.value = 'del'; f.ap.value = '1'; f.bt.value = 'del'; f.bp.value = '1'; }
    }
    function draw() {
      const start = text.value;
      const clamp = (type: string, p: number) => Math.max(0, Math.min(type === 'ins' ? start.length : Math.max(0, start.length - 1), Math.floor(p) || 0));
      f.ap.max = String(f.at.value === 'ins' ? start.length : Math.max(0, start.length - 1)); f.bp.max = String(f.bt.value === 'ins' ? start.length : Math.max(0, start.length - 1));
      const mk = (type: string, p: string, c: string, site: number): Op => {
        if (type === 'del' && start.length === 0) return null;
        return { type: type as 'ins' | 'del', pos: clamp(type, Number(p)), ch: c || '?', site };
      };
      const a = mk(f.at.value, f.ap.value, f.ac.value, 1); const b = mk(f.bt.value, f.bp.value, f.bc.value, 2);
      const aliceRaw = apply(apply(start, a), b); const bobRaw = apply(apply(start, b), a);
      const aliceOt = apply(apply(start, a), transform(b, a)); const bobOt = apply(apply(start, b), transform(a, b));
      const double = !!a && !!b && a.type === 'del' && b.type === 'del' && a.pos === b.pos; // the same letter deleted by both people
      q('[data-o1]').textContent = `Alice ${show(aliceRaw)}   Bob ${show(bobRaw)}`; q('[data-n1]').textContent = aliceRaw !== bobRaw ? 'the two copies differ' : double ? 'the copies match, but a second letter was deleted by mistake' : 'identical this time';
      q('[data-o2]').textContent = `Alice ${show(aliceOt)}   Bob ${show(bobOt)}`; q('[data-n2]').textContent = aliceOt === bobOt ? 'identical: converged' : 'the two copies differ';
      q<HTMLElement>('[data-b1]').style.setProperty('--c', aliceRaw === bobRaw && !double ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', aliceOt === bobOt ? 'var(--good)' : 'var(--bad)');
      const out = q('[data-verdict]'); const bad = aliceRaw !== bobRaw || double; out.classList.toggle('bad', bad);
      out.textContent = double ? `Both people deleted the same letter. Applied as written, each copy deletes it and then also deletes the next letter, leaving ${show(aliceRaw)}. After transformation the second delete is recognised as a repeat and both copies keep ${show(aliceOt)}.`
        : bad ? `Applied as written, the edits leave Alice with ${show(aliceRaw)} and Bob with ${show(bobRaw)}. After transformation both have ${show(aliceOt)}.`
        : aliceOt === bobOt ? `Both approaches agree here, because the two edits do not interfere. Try an example where the positions overlap.` : 'The transformation produced different results, which should never happen.';
    }
    ex.addEventListener('change', () => { preset(); draw(); });
    root.addEventListener('input', (e) => { if (e.target !== ex) { if (ex.value !== 'custom' && e.target !== text) ex.value = 'custom'; draw(); } });
    preset(); draw();
  });
</script>
