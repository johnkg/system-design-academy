---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The stream is cheap while the connector is healthy. The danger is the log the source must keep while it is not.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Row changes per second at the peak <input type="range" min="100" max="50000" step="100" value="5000" data-w /> <b data-wval></b></label>
      <label>Average load as a share of the peak (%) <input type="range" min="10" max="100" step="5" value="40" data-avg /> <b data-avgval></b></label>
      <label>Row size (bytes) <input type="range" min="100" max="2000" step="100" value="500" data-row /> <b data-rowval></b></label>
      <label>Hours the connector is down <input type="range" min="0.5" max="48" step="0.5" value="4" data-down /> <b data-downval></b></label>
      <label>Free disk for the source log (GB) <input type="range" min="50" max="2000" step="50" value="500" data-disk /> <b data-diskval></b></label>
    </div>
    <div class="pg-row">
      <label>Table size (million rows) <input type="range" min="1" max="2000" value="200" data-rows /> <b data-rowsval></b></label>
      <label>Snapshot read rate (MB/s) <input type="range" min="20" max="500" step="10" value="100" data-snap /> <b data-snapval></b></label>
      <label>Connector speed (events per second) <input type="range" min="2000" max="100000" step="1000" value="20000" data-cap /> <b data-capval></b></label>
      <label>Consumers of the stream (sinks) <input type="range" min="1" max="6" value="3" data-sinks /> <b data-sinksval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: one event per changed row; an update event carries the row before and after plus about 300 bytes of envelope (position, table, time, schema version); the source writes about 2 x the row size plus 100 bytes of log per change (new image, old key and index records); a partition takes about 5 MB/s; the snapshot is read by a throttled, chunked reader and the log from the snapshot start must be kept until the stream takes over.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 11 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const dur = (s: number) => (s < 90 ? `${fmt(s)} seconds` : s < 5400 ? `${fmt(s / 60)} minutes` : s < 172800 ? `${(s / 3600).toFixed(1)} hours` : `${(s / 86400).toFixed(1)} days`);
    const gb = (bytes: number) => (bytes < 1e9 ? `${(bytes / 1e6).toFixed(0)} MB` : `${(bytes / 1e9).toFixed(1)} GB`);
    function draw() {
      const w = val('[data-w]'); const avgShare = val('[data-avg]') / 100; const row = val('[data-row]'); const down = val('[data-down]'); const disk = val('[data-disk]');
      const nrows = val('[data-rows]') * 1e6; const snapRate = val('[data-snap]') * 1e6; const cap = val('[data-cap]'); const sinks = val('[data-sinks]');
      ['w', 'avg', 'row', 'down', 'disk', 'rows', 'snap', 'cap', 'sinks'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const avg = w * avgShare; const evBytes = 2 * row + 300; const logPerChange = 2 * row + 100;
      const streamPeak = w * evBytes; const logRate = avg * logPerChange;
      const retained = logRate * down * 3600; const fillSecs = (disk * 1e9) / logRate;
      const backlog = avg * down * 3600; const catchUp = cap > avg ? backlog / (cap - avg) : Infinity;
      const snapSecs = (nrows * row) / snapRate; const snapLog = logRate * snapSecs;
      const data: [string, string][] = [
        ['Average changes per second', fmt(avg)],
        ['Event size with before and after images', `${fmt(evBytes)} bytes`],
        ['Stream throughput at the peak', `${(streamPeak / 1e6).toFixed(1)} MB/s, so at least ${Math.max(1, Math.ceil(streamPeak / 5e6))} partitions`],
        ['Read load on the stream from all sinks', `${((streamPeak * sinks) / 1e6).toFixed(1)} MB/s`],
        ['Source log written per hour at the average', gb(logRate * 3600)],
        [`Log the source must keep after ${down} hours of downtime`, gb(retained)],
        ['Share of the free disk that holds', `${Math.round((retained / (disk * 1e9)) * 100)}%`],
        ['Time until a dead connector fills the disk', dur(fillSecs)],
        ['Events waiting after the downtime', fmt(backlog)],
        ['Time to catch up once it is back', cap > avg ? dur(catchUp) : 'never, since the connector is slower than the average load'],
        ['Initial snapshot of the table', `${gb(nrows * row)} in ${dur(snapSecs)}, holding ${gb(snapLog)} of log meanwhile`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
