---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Throughput sets the number of tasks, state sets the size of each checkpoint, and the checkpoint interval sets how much is replayed after a failure.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Events per second (thousands) <input type="range" min="50" max="2000" step="50" value="500" data-r /> <b data-rval></b></label>
      <label>Event size (bytes) <input type="range" min="100" max="2000" step="100" value="300" data-sz /> <b data-szval></b></label>
      <label>Keys with state (millions) <input type="range" min="1" max="1000" value="100" data-k /> <b data-kval></b></label>
      <label>State per key (bytes) <input type="range" min="50" max="2000" step="50" value="200" data-sk /> <b data-skval></b></label>
      <label>Checkpoint interval (seconds) <input type="range" min="5" max="600" step="5" value="60" data-ci /> <b data-civval></b></label>
      <label>Keys changed per interval (%) <input type="range" min="1" max="100" value="5" data-ch /> <b data-chval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: one task handles about 50,000 events per second but is kept at 70% load (35,000) for headroom, state is held on local disks with a replication factor of 3 in snapshot storage, an incremental checkpoint uploads only the changed keys, a restart takes 30 seconds, and a worst-case failure happens just before a checkpoint completes.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const ROWS = 10; // one per output line
    const THOUSAND = 1000; const MILLION = 1e6; const BYTES_PER_MB = 1e6; const BYTES_PER_GB = 1e9; const MB_PER_GB = 1000;
    const TASK = { planned: 35000, max: 50000 }; // events per second per task: sized for, and the most it can do
    const COPIES = 3; const RESTART_S = 30;
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1 });
    function draw() {
      const rate = val('[data-r]') * THOUSAND; const size = val('[data-sz]'); const keys = val('[data-k]') * MILLION; const sk = val('[data-sk]'); const ci = val('[data-ci]'); const ch = val('[data-ch]') / 100;
      ['r', 'sz', 'k', 'sk', 'ch'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      q('[data-civval]').textContent = String(ci);
      const mbps = (rate * size) / BYTES_PER_MB; const tasks = Math.ceil(rate / TASK.planned); const capacity = tasks * TASK.max;
      const stateGb = (keys * sk) / BYTES_PER_GB; const perTaskGb = stateGb / tasks;
      const fullGb = stateGb; const incGb = stateGb * ch;
      const upload = (incGb * MB_PER_GB) / ci; // MB/s of snapshot traffic, before replication
      const backlog = rate * (ci + RESTART_S); const catchUp = backlog / (capacity - rate);
      const data: [string, string][] = [
        ['Ingest from the log', `${fmt1(mbps)} MB/s`],
        [`Tasks to run (at ${TASK.planned.toLocaleString('en-US')} events/s each)`, fmt(tasks)],
        ['Total state', `${fmt1(stateGb)} GB`],
        ['State per task', `${fmt1(perTaskGb)} GB`],
        ['Full checkpoint size', `${fmt1(fullGb)} GB`],
        ['Incremental checkpoint size', `${fmt1(incGb)} GB`],
        ['Snapshot upload with incremental checkpoints', `${fmt1(upload)} MB/s, ${fmt1(upload * COPIES)} MB/s stored with ${COPIES} copies`],
        ['Events replayed after a worst-case failure', fmt(rate * ci)],
        [`Events waiting when the job is back (interval + ${RESTART_S} s restart)`, fmt(backlog)],
        ['Time to catch up using the spare capacity', `${fmt(catchUp)} s`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
