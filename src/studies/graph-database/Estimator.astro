---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Storage sets how many shards you need. Query cost grows with the number of friends to the power of the depth, and one supernode costs more than a whole normal query.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Users (millions) <input type="range" min="10" max="2000" step="10" value="500" data-u /> <b data-uval></b></label>
      <label>Average friends per user <input type="range" min="10" max="1000" step="10" value="200" data-d /> <b data-dval></b></label>
      <label>Query depth (hops) <input type="range" min="1" max="4" value="2" data-h /> <b data-hval></b></label>
      <label>Followers of one supernode (millions) <input type="range" min="1" max="100" value="30" data-f /> <b data-fval></b></label>
      <label>Usable disk per shard (TB) <input type="range" min="1" max="8" value="1" data-tb /> <b data-tbval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: every friendship is stored on both ends, a node record with its properties takes about 264 bytes, an adjacency entry takes about 32 bytes, data is kept in 3 replicas, one thread reads about 5 million entries per second from memory or a warm cache, a hop costs about 1 ms of network time, and the paths of a walk do not overlap (a real graph has overlap, so the true count is lower).</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const ms = (s: number) => (s < 1 ? `${(s * 1000).toFixed(1)} ms` : `${s.toFixed(1)} s`);
    function draw() {
      const users = val('[data-u]') * 1e6; const d = val('[data-d]'); const hops = val('[data-h]'); const fol = val('[data-f]') * 1e6; const tb = val('[data-tb]');
      ['u', 'd', 'h', 'f', 'tb'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const entries = users * d; const bytes = users * 264 + entries * 32; const withReplicas = bytes * 3; const shards = Math.max(1, Math.ceil(withReplicas / (tb * 1e12)));
      const reads = Math.pow(d, hops); const par = Math.min(shards, Math.pow(d, hops - 1));
      const seconds = reads / (5e6 * par) + hops * 0.001;
      const supSeconds = fol / 5e6;
      const data: [string, string][] = [
        ['Adjacency entries stored (both ends of every edge)', fmt(entries)],
        ['Disk for the graph with 3 replicas', `${(withReplicas / 1e12).toFixed(1)} TB`],
        ['Shards needed for storage', fmt(shards)],
        [`Entries read by a ${hops}-hop query`, fmt(reads)],
        ['Time for that query, spread over the shards, with network', ms(seconds)],
        ['Time to read the whole list of the supernode in one thread', ms(supSeconds)],
        ['That is this many times a 2-hop query', fmt(fol / (d * d))],
        ['Time to read a 1,000-edge sample of the supernode', ms(1000 / 5e6)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
