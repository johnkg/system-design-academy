---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Statistics, not hope, set how fast a canary can move: a small regression needs thousands of requests in each group, and a quiet service takes a long time to produce them.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Services <input type="range" min="50" max="2000" step="50" value="400" data-sv /> <b data-svval></b></label>
      <label>Releases per service per week <input type="range" min="1" max="20" value="5" data-dp /> <b data-dpval></b></label>
      <label>Regions rolled out one after another <input type="range" min="1" max="12" value="6" data-rg /> <b data-rgval></b></label>
      <label>Stages per region (1%, 5%, 10%, 25%, 50%) <input type="range" min="1" max="5" value="4" data-st /> <b data-stval></b></label>
      <label>Bake time per stage (minutes) <input type="range" min="2" max="60" value="10" data-bk /> <b data-bkval></b></label>
      <label>Requests per second to the service in one region <input type="range" min="10" max="5000" step="10" value="200" data-rps /> <b data-rpsval></b></label>
      <label>Normal error rate (%) <input type="range" min="0.1" max="5" step="0.1" value="1" data-er /> <b data-erval></b></label>
      <label>Smallest rise in error rate to catch (percentage points) <input type="range" min="0.2" max="3" step="0.1" value="1" data-d /> <b data-dval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 5 working days a week and releases started over a 10-hour day, one-sided test with a 1% false-alarm rate (z = 2.326) and 80% power (z = 0.842), canary and baseline groups of equal size, 6 metrics per analysis, each read for both groups once a minute. Real traffic is not perfectly independent, so treat the request counts as a lower bound.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const N_ROWS = 8; // output lines below
    const WORK_DAYS = 5; const WORK_HOURS = 10; const MIN_PER_H = 60; const S_PER_MIN = 60; // deploys spread over a 5-day, 10-hour week
    const Z_ALPHA = 2.326; const Z_BETA = 0.842; // one-sided 1% false alarm, 80% power
    const METRICS = 6; const GROUPS = 2; const ANALYSIS_S = 60; // metrics queried for canary and baseline, once a minute
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const SHARES = [1, 5, 10, 25, 50];
    function draw() {
      const sv = val('[data-sv]'); const dp = val('[data-dp]'); const rg = val('[data-rg]'); const st = val('[data-st]'); const bk = val('[data-bk]');
      const rps = val('[data-rps]'); const p1 = val('[data-er]') / 100; const d = val('[data-d]') / 100; const p2 = p1 + d;
      ['sv', 'dp', 'rg', 'st', 'bk', 'rps', 'er', 'd'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const perDay = (sv * dp) / WORK_DAYS;
      const hours = (rg * st * bk) / MIN_PER_H;
      const inflight = (perDay / WORK_HOURS) * hours;
      const pbar = (p1 + p2) / 2;
      const n = Math.ceil(Math.pow(Z_ALPHA * Math.sqrt(2 * pbar * (1 - pbar)) + Z_BETA * Math.sqrt(p1 * (1 - p1) + p2 * (1 - p2)), 2) / (d * d));
      const minutesFirst = n / (rps * (SHARES[0] / 100) * S_PER_MIN);
      const used = SHARES.slice(0, st);
      const enough = used.find((s) => rps * (s / 100) * S_PER_MIN * bk >= n);
      const stageReqs = enough === undefined ? rps * (used[used.length - 1] / 100) * S_PER_MIN * bk : rps * (enough / 100) * S_PER_MIN * bk;
      const data: [string, string][] = [
        ['Rollouts started per day', fmt(perDay)],
        ['One rollout from first stage to last region (hours)', hours.toFixed(1)],
        ['Rollouts in progress at the same time', fmt(inflight)],
        ['Requests needed in each group to see the rise', fmt(n)],
        [`Minutes to collect them at the ${SHARES[0]}% stage`, minutesFirst >= 100 ? fmt(minutesFirst) : minutesFirst.toFixed(1)],
        ['First stage with enough requests within one bake', enough === undefined ? 'none: lengthen the bake or add a stage' : `${enough}%`],
        ['Extra failed requests before the stop (canary requests at that stage times the rise)', fmt(stageReqs * d)],
        ['Metric reads per second for analysis', (inflight * METRICS * GROUPS / ANALYSIS_S).toFixed(1)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
