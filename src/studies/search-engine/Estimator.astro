---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The index size sets the number of shards, every query visits every shard, and the more shards a query waits for, the more likely it meets a slow one.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Documents (millions)" name="d" min="10" max="5000" step="10" value="500" />
      <RangeField label="Average document size (KB)" name="kb" min="1" max="50" value="5" />
      <RangeField label="Peak queries per second" name="qps" min="100" max="20000" step="100" value="2000" />
      <RangeField label="New or changed documents per second" name="ing" min="100" max="20000" step="100" value="3000" />
      <RangeField label="Replicas of each shard" name="rep" min="0" max="3" value="1" />
      <RangeField label="Target shard size (GB)" name="sz" min="10" max="50" step="5" value="30" />
      <RangeField label="Chance that one shard is slow on a request (%)" name="slow" min="0.1" max="5" step="0.1" value="1" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the index (postings, positions and the stored copy of each document) takes about 80% of the raw text size. A node holds 2 TB of disk and is filled to 70%. One node answers about 2,000 shard requests per second (a request of about 5 ms on 10 cores), and indexes about 20 MB of text per second. Each document is indexed again on every replica, and segment merges rewrite the data about 5 times. Every query asks one copy of every primary shard.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 11; // lines in the result list
    const MILLION = 1e6, KB_PER_GB = 1e6, KB_PER_MB = 1000;
    const INDEX_RATIO = 0.8; // the index is 80% of the raw text
    const NODE = { diskGb: 1400, shardReqS: 2000, ingestMbS: 20 }; // what one node handles
    const MERGE_AMPLIFICATION = 5; // segment merges rewrite each byte about five times
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const docs = val('[data-d]') * MILLION; const kb = val('[data-kb]'); const qps = val('[data-qps]'); const ing = val('[data-ing]'); const rep = val('[data-rep]'); const sz = val('[data-sz]'); const slow = val('[data-slow]') / 100;
      ['d', 'kb', 'qps', 'ing', 'rep', 'sz', 'slow'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const rawGb = (docs * kb) / KB_PER_GB; const idxGb = rawGb * INDEX_RATIO;
      const primaries = Math.ceil(idxGb / sz); const copies = primaries * (1 + rep); const storeGb = idxGb * (1 + rep);
      const nodesDisk = Math.ceil(storeGb / NODE.diskGb);
      const shardReq = qps * primaries; const nodesQuery = Math.ceil(shardReq / NODE.shardReqS);
      const ingMb = (ing * kb * (1 + rep)) / KB_PER_MB; const nodesIng = Math.ceil(ingMb / NODE.ingestMbS);
      const nodes = Math.max(nodesDisk, nodesQuery, nodesIng);
      const hitSlow = (1 - Math.pow(1 - slow, primaries)) * 100;
      const data: [string, string][] = [
        ['Raw text', `${fmt(rawGb)} GB`],
        ['Index size (one copy)', `${fmt(idxGb)} GB`],
        ['Primary shards', `${fmt(primaries)} (${fmt(docs / primaries)} documents each)`],
        ['Shard copies with replicas', fmt(copies)],
        ['Disk in the cluster', `${fmt(storeGb)} GB`],
        ['Shard requests per second (each query visits every primary)', fmt(shardReq)],
        ['Nodes needed for disk', fmt(nodesDisk)],
        ['Nodes needed for queries', fmt(nodesQuery)],
        ['Nodes needed for indexing', `${fmt(nodesIng)} (${fmt(ingMb)} MB/s of text, ${fmt(ingMb * MERGE_AMPLIFICATION)} MB/s of disk writes with merges)`],
        ['Nodes to run', fmt(nodes)],
        ['Requests that wait for at least one slow shard', `${hitSlow.toFixed(0)}%`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
