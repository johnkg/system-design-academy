---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="A weekly meeting through a year of clock changes" hint="Alice in New York holds a meeting every Monday, starting on 5 January 2026, with one colleague in another city. Compare three ways of storing its time, week by week, with the clock rules of 2026.">
  <ol class="how">
    <li>With the defaults (colleague in <b>London</b>, <b>52 weeks</b>), <b>one UTC instant</b> keeps the meeting at 14:00 UTC, so Alice in New York finds it at <b>10:00 in 34 of the 52 weeks</b>, from 9 March to 26 October.</li>
    <li>Set <b>Weeks shown</b> to <b>9</b>: those weeks are all winter, so the UTC design looks right, which is why a test written in January passes.</li>
    <li>Back at 52 weeks, <b>wall time + zone</b> keeps New York at 09:00 every week. London sees it at <b>13:00 in 4 weeks</b> (9 to 23 March, and 26 October), because the UK changes its clocks on other dates. That is correct: the meeting follows New York.</li>
    <li>Pick <b>Sydney</b>: with wall time + zone it is <b>Tue 01:00 in 18 weeks</b>, Tue 00:00 in 8 and <b>Mon 23:00 in 26</b>, because Sydney's summer is the other half of the year. <b>Floating time</b> puts the two in the meeting at different instants in all 52 weeks.</li>
  </ol>
  <div class="pg calb" data-calb>
    <div class="pg-row">
      <label>Colleague's city <select class="pg-in" data-city><option value="london" selected>London</option><option value="tokyo">Tokyo</option><option value="sydney">Sydney</option></select></label>
      <label>Meeting hour in New York <input type="range" min="6" max="20" value="9" data-h /> <b data-hval></b></label>
      <label>Weeks shown <input type="range" min="1" max="52" value="52" data-w /> <b data-wval></b></label>
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>One UTC instant, every 7 days</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-s1></span><ul class="calb-list" data-l1></ul></div>
      <div class="pg-box" data-b2><h3>Wall time + America/New_York</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-s2></span><ul class="calb-list" data-l2></ul></div>
      <div class="pg-box" data-b3><h3>Floating time, no zone</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-s3></span><ul class="calb-list" data-l3></ul></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: the 2026 rules. New York is UTC-5 and UTC-4 from 8 March to 1 November. London is UTC+0 and UTC+1 from 29 March to 25 October. Tokyo is UTC+9 all year. Sydney is UTC+11 until 5 April and from 4 October, and UTC+10 in between. "One UTC instant" converts the first meeting to UTC and adds 7 days. "Wall time + zone" converts 09:00 New York time to UTC separately for each week. "Floating time" stores 09:00 with no zone, so each person reads it on their own clock. Each line lists a run of weeks (by Alice's Monday) in which the times stay the same.</p>
  </div>
</PlaygroundShell>
<style is:global>
  .calb-list { margin: 0; padding-left: 1.1rem; font-size: .85rem; display: grid; gap: 2px; }
  .calb-list li { overflow-wrap: anywhere; min-width: 0; }
  .calb .pg-row input, .calb .pg-row select { min-width: 0; max-width: 100%; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-calb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const DAY = 1440, HOUR = 60, WEEK = 7 * DAY;
    // Day numbers since 1970-01-01, so the result never depends on the viewer's own time zone.
    const dayOf = (y: number, m: number, d: number) => Math.floor(Date.UTC(y, m - 1, d) / 86400000);
    const weekday = (days: number) => (days + 4) % 7; // 0 = Sunday
    const nthSunday = (y: number, m: number, n: number) => { const f = dayOf(y, m, 1); return f + ((7 - weekday(f)) % 7) + 7 * (n - 1); };
    const lastSunday = (y: number, m: number) => { const l = dayOf(y, m + 1, 1) - 1; return l - weekday(l); };
    const yearOf = (utc: number) => new Date(Math.floor(utc / DAY) * 86400000).getUTCFullYear();
    type Zone = { name: string; offsets: number[]; at: (utc: number) => number };
    const ZONES: Record<string, Zone> = {
      newyork: { name: 'New York', offsets: [-4 * HOUR, -5 * HOUR], at: (u) => { const y = yearOf(u); return u >= nthSunday(y, 3, 2) * DAY + 7 * HOUR && u < nthSunday(y, 11, 1) * DAY + 6 * HOUR ? -4 * HOUR : -5 * HOUR; } },
      london: { name: 'London', offsets: [HOUR, 0], at: (u) => { const y = yearOf(u); return u >= lastSunday(y, 3) * DAY + HOUR && u < lastSunday(y, 10) * DAY + HOUR ? HOUR : 0; } },
      tokyo: { name: 'Tokyo', offsets: [9 * HOUR], at: () => 9 * HOUR },
      sydney: { name: 'Sydney', offsets: [11 * HOUR, 10 * HOUR], at: (u) => { const y = yearOf(u); return u >= nthSunday(y, 4, 1) * DAY - 8 * HOUR && u < nthSunday(y, 10, 1) * DAY - 8 * HOUR ? 10 * HOUR : 11 * HOUR; } },
    };
    // Wall time to UTC: the first matching offset (the earlier instant when a time happens twice); a skipped time uses the last offset.
    const toUtc = (z: Zone, local: number) => { for (const o of z.offsets) if (z.at(local - o) === o) return local - o; return local - z.offsets[z.offsets.length - 1]; };
    const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const pad = (n: number) => String(n).padStart(2, '0');
    // A local time as text, with its weekday because another zone can be on another day. New York's own time is always a Monday.
    const show = (local: number, day = true) => { const d = Math.floor(local / DAY), m = local - d * DAY; return `${day ? DAYS[weekday(d)] + ' ' : ''}${pad(Math.floor(m / HOUR))}:${pad(m % HOUR)}`; };
    const dateText = (day: number) => { const t = new Date(day * 86400000); return `${t.getUTCDate()} ${MONTHS[t.getUTCMonth()]}`; };
    const FIRST = dayOf(2026, 1, 5); // Monday 5 January 2026
    const ny = ZONES.newyork;
    type Week = { day: number; org: string; att: string; utc: string; same: boolean };
    function weeks(city: Zone, hour: number, n: number) {
      const utcFirst = toUtc(ny, FIRST * DAY + hour * HOUR);
      const designs: Week[][] = [[], [], []];
      for (let i = 0; i < n; i++) {
        const day = FIRST + 7 * i, local = day * DAY + hour * HOUR;
        const a = utcFirst + i * WEEK; // one UTC instant plus whole weeks
        designs[0].push({ day, org: show(a + ny.at(a), false), att: show(a + city.at(a)), utc: show(a), same: true });
        const b = toUtc(ny, local); // wall time in New York, converted per week
        designs[1].push({ day, org: show(b + ny.at(b), false), att: show(b + city.at(b)), utc: show(b), same: true });
        const c = toUtc(city, local); // floating: the colleague reads 09:00 on their own clock
        designs[2].push({ day, org: show(b + ny.at(b), false), att: `${show(local)} (${show(c + ny.at(c))} in New York)`, utc: show(b), same: b === c });
      }
      return designs;
    }
    const runs = (list: Week[], key: (w: Week) => string) => {
      const out: { from: number; to: number; count: number; w: Week }[] = [];
      for (const w of list) { const last = out[out.length - 1]; if (last && key(last.w) === key(w)) { last.to = w.day; last.count++; } else out.push({ from: w.day, to: w.day, count: 1, w }); }
      return out;
    };
    const tally = (list: Week[], key: (w: Week) => string) => { const m = new Map<string, number>(); list.forEach((w) => m.set(key(w), (m.get(key(w)) ?? 0) + 1)); return [...m.entries()]; };
    const weeksText = (n: number) => `${n} ${n === 1 ? 'week' : 'weeks'}`;
    function draw() {
      const city = ZONES[q<HTMLSelectElement>('[data-city]').value]; const hour = Number(q<HTMLInputElement>('[data-h]').value); const n = Number(q<HTMLInputElement>('[data-w]').value);
      q('[data-hval]').textContent = `${pad(hour)}:00`; q('[data-wval]').textContent = String(n);
      const want = `${pad(hour)}:00`;
      const d = weeks(city, hour, n);
      const moved = d[0].filter((w) => w.org !== want).length;
      const apart = d[2].filter((w) => !w.same).length;
      const attTally = tally(d[1], (w) => w.att);
      q('[data-o1]').textContent = moved > 0 ? `wrong: New York at ${d[0].find((w) => w.org !== want)!.org} in ${moved} of ${n} weeks` : `New York at ${want} in all ${weeksText(n)}`;
      q('[data-o2]').textContent = `New York at ${want} in all ${weeksText(n)}`;
      q('[data-o3]').textContent = apart > 0 ? `wrong: different instants in ${apart} of ${n} weeks` : `same instant in all ${weeksText(n)}`;
      q('[data-s1]').textContent = `${city.name} sees ${tally(d[0], (w) => w.att).map(([t, c]) => `${t} in ${weeksText(c)}`).join(', ')}`;
      q('[data-s2]').textContent = `${city.name} sees ${attTally.map(([t, c]) => `${t} in ${weeksText(c)}`).join(', ')}`;
      q('[data-s3]').textContent = `Each reads ${want} on their own clock, so ${city.name} joins at a different moment from New York.`;
      const fill = (sel: string, list: Week[], line: (w: Week) => string) => {
        const ul = q(sel); ul.replaceChildren();
        for (const r of runs(list, line)) {
          const li = document.createElement('li');
          const span = r.count === 1 ? dateText(r.from) : `${dateText(r.from)} to ${dateText(r.to)}`;
          li.textContent = `${span} (${weeksText(r.count)}): ${line(r.w)}`;
          ul.append(li);
        }
      };
      fill('[data-l1]', d[0], (w) => `New York ${w.org}, ${city.name} ${w.att}, UTC ${w.utc}`);
      fill('[data-l2]', d[1], (w) => `New York ${w.org}, ${city.name} ${w.att}, UTC ${w.utc}`);
      fill('[data-l3]', d[2], (w) => `New York ${w.org}, ${city.name} ${w.att}`);
      q<HTMLElement>('[data-b1]').style.setProperty('--c', moved > 0 ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', 'var(--good)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', apart > 0 ? 'var(--bad)' : 'var(--good)');
      const out = q('[data-verdict]'); out.classList.toggle('bad', moved > 0 || apart > 0);
      const first = moved > 0
        ? `Storing one UTC instant moved Alice's ${want} meeting in ${moved} of ${n} weeks, because New York's offset changed and the stored instant did not.`
        : `In these ${weeksText(n)} New York's offset never changed, so the UTC design looks correct. Show more weeks to see it fail.`;
      const second = attTally.length > 1
        ? ` Wall time + zone kept it at ${want} in New York every week; ${city.name} sees ${attTally.length} different local times, which is right, because its clocks change on other dates or not at all.`
        : ` Wall time + zone kept it at ${want} in New York every week, and ${city.name} sees one local time throughout.`;
      out.textContent = `${first}${second} Floating time put the two at different instants in ${apart} of ${n} weeks.`;
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
