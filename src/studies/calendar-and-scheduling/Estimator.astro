---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Storage is modest. The hard numbers are the fan-out of each new meeting, the reminders that all fall due in the same few minutes, and phones that ask for changes far more often than anything changes.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Users (millions) <input type="range" min="1" max="500" value="100" data-u /> <b data-uval></b></label>
      <label>Active on a given day (%) <input type="range" min="10" max="90" value="40" data-a /> <b data-aval></b></label>
      <label>Meetings created per active user per day <input type="range" min="0.5" max="10" step="0.5" value="2" data-m /> <b data-mval></b></label>
      <label>Attendees per meeting <input type="range" min="2" max="50" value="4" data-p /> <b data-pval></b></label>
      <label>Meetings on a user's calendar per day <input type="range" min="1" max="20" value="6" data-o /> <b data-oval></b></label>
      <label>Devices per user <input type="range" min="1" max="5" value="2" data-d /> <b data-dval></b></label>
      <label>Sync interval without push (minutes) <input type="range" min="1" max="60" value="15" data-i /> <b data-ival></b></label>
      <label>Peak is how many times the average <input type="range" min="1" max="10" value="3" data-k /> <b data-kval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each active user opens a calendar view 10 times a day; every new meeting runs one free/busy lookup per attendee and sends an invitation to everyone but the organiser; each meeting on a calendar has one reminder. Meetings start on the hour or half hour, so a day's reminders fall into about 60 busy minutes (20 slots in a working day, across 3 main time-zone bands). A user owns about 1,000 stored events of about 1 KB each with attendees and indexes (a series counts once), and a busy interval is about 64 bytes with its index, kept for 365 days ahead.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 10; // lines in the result list
    const MILLION = 1e6, DAY_S = 86400, MIN_S = 60, TB = 1e12;
    const VIEWS_PER_DAY = 10; // calendar views per active user
    const BUSY_MINUTES = 60; // minutes of the day in which almost all reminders fire
    const EVENTS_PER_USER = 1000, EVENT_BYTES = 1000; // stored events and their size
    const BUSY_BYTES = 64, HORIZON_DAYS = 365; // busy-interval rows
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n >= 100 ? Math.round(n) : Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const users = val('[data-u]') * MILLION; const active = val('[data-a]') / 100; const created = val('[data-m]'); const attendees = val('[data-p]');
      const onCal = val('[data-o]'); const devices = val('[data-d]'); const interval = val('[data-i]') * MIN_S; const peak = val('[data-k]');
      ['u', 'a', 'm', 'p', 'o', 'd', 'i', 'k'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const dau = users * active;
      const views = ((dau * VIEWS_PER_DAY) / DAY_S) * peak;
      const createdPeak = ((dau * created) / DAY_S) * peak;
      const invites = createdPeak * (attendees - 1);
      const lookups = createdPeak * attendees;
      const reminders = dau * onCal;
      const reminderAvg = reminders / DAY_S;
      const reminderBurst = reminders / BUSY_MINUTES / MIN_S;
      const syncs = (dau * devices) / interval;
      const eventsTb = (users * EVENTS_PER_USER * EVENT_BYTES) / TB;
      const busyTb = (users * onCal * HORIZON_DAYS * BUSY_BYTES) / TB;
      const data: [string, string][] = [
        ['Active users per day', fmt(dau)],
        ['Calendar views per second at the peak', fmt(views)],
        ['Meetings created per second at the peak', fmt(createdPeak)],
        ['Invitations per second at the peak', fmt(invites)],
        ['Free/busy calendar lookups per second at the peak', fmt(lookups)],
        ['Reminders per day', fmt(reminders)],
        ['Reminders per second: average, and in a busy minute', `${fmt(reminderAvg)} and ${fmt(reminderBurst)}`],
        ['Sync requests per second if devices poll', fmt(syncs)],
        ['Stored events', `${fmt(eventsTb)} TB`],
        [`Busy intervals for ${HORIZON_DAYS} days`, `${fmt(busyTb)} TB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
