---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="A mobile release is slow by nature: how many people see a bug depends on the stage you stop it at, and how many are locked out depends on a threshold you choose.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Monthly active users (millions)" name="m" min="5" max="100" step="5" value="30" />
      <RangeField label="First stage of the store rollout (%)" name="s" min="1" max="50" value="1" />
      <RangeField label="Users the bug hits (%)" name="b" min="1" max="20" value="3" />
      <RangeField label="App opens per user per day" name="o" min="1" max="10" value="4" />
      <RangeField label="Users on versions older than the newest two (%)" name="old" min="0" max="50" value="12" />
      <RangeField label="Users below the minimum version (%)" name="lo" min="0" max="60" value="18" />
      <RangeField label="Users who cannot or will not update (%)" name="st" min="0" max="30" value="13" />
      <RangeField label="Store review for a hotfix (days)" name="r" min="0" max="7" value="2" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 40% of monthly users are active on a given day. In its first week a release is installed by 60% of the users it is offered to, and 15% of them install it on the first day. An app open makes 10 API requests and one config fetch, and the busiest hour has 3 times the daily average. A fix takes a day to build and test. After a hotfix is out, a quarter of the users on the broken build update each day, so 90% have it after 9 more days.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatWholeNumber } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const MILLION = 1e6, DAY_S = 86400, PCT = 100;
    const DAILY_ACTIVE = 0.4;   // of monthly users, active on a given day
    const WEEK_INSTALL = 0.6;   // of the users a release is offered to, installed within a week
    const DAY_ONE_INSTALL = 0.15; // of the users a stage reaches, installing on its first day
    const REQ_PER_OPEN = 10;
    const PEAK = 3;             // busiest hour over the daily average
    const FIX_DAYS = 1;
    const FIX_UPTAKE = 0.25;    // of the users on the broken build, updating each day after the hotfix
    const FIX_SHARE = 0.9;      // the share that should have the fix
    const N_ROWS = 8;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const mau = val('[data-m]') * MILLION, stage = val('[data-s]') / PCT, bug = val('[data-b]') / PCT, opens = val('[data-o]');
      const old = val('[data-old]') / PCT, lo = val('[data-lo]') / PCT, st = val('[data-st]') / PCT, review = val('[data-r]');
      ['m', 's', 'b', 'o', 'old', 'lo', 'st', 'r'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const dau = mau * DAILY_ACTIVE;
      const reach = mau * stage;
      const everyone = mau * WEEK_INSTALL * bug;
      const staged = reach * DAY_ONE_INSTALL * bug;
      const perSecond = (perDay: number) => (perDay / DAY_S) * PEAK;
      const configRate = perSecond(dau * opens);
      const oldRate = perSecond(dau * opens * REQ_PER_OPEN * old);
      const locked = mau * lo * st;
      const fixDays = FIX_DAYS + review + Math.ceil(Math.log(1 - FIX_SHARE) / Math.log(1 - FIX_UPTAKE));
      const data: [string, string][] = [
        ['Users active on a given day', formatWholeNumber(dau)],
        ['Users the first stage can reach', formatWholeNumber(reach)],
        ['Users who hit the bug if the build goes to everyone at once', formatWholeNumber(everyone)],
        ['Users who hit it if the first stage is halted after one day', formatWholeNumber(staged)],
        ['Config requests per second in the busiest hour', formatWholeNumber(configRate)],
        ['API requests per second from the older versions, busiest hour', formatWholeNumber(oldRate)],
        ['Users locked out by raising the minimum version', formatWholeNumber(locked)],
        ['Days until 90% of the users on a broken build have a store fix', `${fixDays} days`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
