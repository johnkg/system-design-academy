---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="A few endpoints that hang do not make much traffic, but they hold connections for a long time. See how a small share of dead endpoints decides how many workers you run.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Events published per second at the peak" name="ev" min="100" max="20000" step="100" value="2000" />
      <RangeField label="Subscribed endpoints per event (average)" name="fan" min="1" max="50" value="5" />
      <RangeField label="Deliveries going to dead or hanging endpoints (%)" name="bad" min="0" max="20" value="2" />
      <RangeField label="Healthy endpoint response time (ms)" name="lat" min="50" max="2000" step="50" value="300" />
      <RangeField label="Request timeout (s)" name="to" min="1" max="30" value="10" />
      <RangeField label="Payload size (KB)" name="kb" min="1" max="50" value="2" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a delivery to a dead endpoint is attempted 7 times and every attempt hangs until the timeout, one worker process holds 200 requests in flight, the daily average is one third of the peak, a delivery-log row takes 600 bytes, and both logs are kept for 30 days. The number of requests in flight is rate times time (Little's law).</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 9; // output lines below
    const MS_PER_S = 1000; const BYTES_PER_KB = 1000; const BITS_PER_BYTE = 8; const BITS_PER_MBIT = 1e6; const GB = 1e9; const GB_PER_TB = 1000; const DAY_S = 86400;
    const DEAD_ATTEMPTS = 7; // attempts a delivery to a dead endpoint makes before giving up
    const CONNS_PER_WORKER = 200; // requests one worker keeps in flight
    const AVG_SHARE = 1 / 3; // the daily average is a third of the peak rate
    const LOG_ROW_BYTES = 600; const RETENTION_DAYS = 30;
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');
    function draw() {
      const ev = val('[data-ev]'); const fan = val('[data-fan]'); const bad = val('[data-bad]') / 100; const lat = val('[data-lat]') / MS_PER_S; const to = val('[data-to]'); const kb = val('[data-kb]');
      ['ev', 'fan', 'bad', 'lat', 'to', 'kb'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const deliveries = ev * fan; const goodAttempts = deliveries * (1 - bad); const badAttempts = deliveries * bad * DEAD_ATTEMPTS; const attempts = goodAttempts + badAttempts;
      const goodFlight = goodAttempts * lat; const badFlight = badAttempts * to; const flight = goodFlight + badFlight;
      const workers = Math.ceil(flight / CONNS_PER_WORKER); const workersClean = Math.ceil(goodFlight / CONNS_PER_WORKER);
      const mbit = (attempts * kb * BYTES_PER_KB * BITS_PER_BYTE) / BITS_PER_MBIT;
      const avg = AVG_SHARE; const logGb = (attempts * avg * DAY_S * LOG_ROW_BYTES) / GB; const evGb = (ev * avg * DAY_S * kb * BYTES_PER_KB) / GB;
      const data: [string, string][] = [
        ['Deliveries per second (first attempts)', fmt(deliveries)],
        ['Attempts per second, retries included', fmt(attempts)],
        ['Requests in flight', fmt(flight)],
        ['Share of those held by dead endpoints', `${fmt1(flight ? (badFlight / flight) * 100 : 0)}%`],
        ['Workers needed', `${fmt(workers)} (${fmt(workersClean)} if no endpoint were dead)`],
        ['Outbound bandwidth', `${fmt1(mbit)} Mbit/s`],
        ['Delivery log written per day', `${fmt1(logGb)} GB`],
        ['Event log written per day', `${fmt1(evGb)} GB`],
        [`Both logs kept for ${RETENTION_DAYS} days`, `${fmt1(((logGb + evGb) * RETENTION_DAYS) / GB_PER_TB)} TB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
