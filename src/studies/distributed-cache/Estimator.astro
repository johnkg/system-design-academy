---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Memory and throughput decide how many nodes you need, and the hit ratio decides how much the database must survive when a node is lost.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Peak reads per second (thousands) <input type="range" min="50" max="2000" step="50" value="500" data-r /> <b data-rval></b></label>
      <label>Hit ratio (%) <input type="range" min="50" max="99" value="95" data-h /> <b data-hval></b></label>
      <label>Cached keys (millions) <input type="range" min="10" max="2000" step="10" value="200" data-k /> <b data-kval></b></label>
      <label>Average value size (bytes) <input type="range" min="100" max="10000" step="100" value="1000" data-v /> <b data-vval></b></label>
      <label>Replicas per shard <input type="range" min="0" max="2" value="1" data-c /> <b data-cval></b></label>
      <label>RAM per node (GB) <input type="range" min="16" max="256" step="16" value="64" data-gb /> <b data-gbval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each entry costs its value plus about 100 bytes for the key and bookkeeping, allocator overhead and fragmentation add 25%, only 75% of a node's RAM is used for data (the rest is for buffers, replication and a snapshot), one node serves about 100,000 operations per second and is run at 70% of that, and keys are spread evenly. The lost-node line is an upper bound: it assumes that every request for the lost keys misses until they are cached again.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const N_ROWS = 11; // output lines below
    const THOUSAND = 1e3; const MILLION = 1e6; const GB = 1e9;
    const KEY_OVERHEAD = 100; // bytes per entry for the key and bookkeeping
    const MEM_OVERHEAD = 1.25; // allocator and fragmentation on top of the data
    const MEM_FILL = 0.75; // usable share of each node's memory
    const NODE_OPS = 100000; const OPS_FILL = 0.7; // reads per second one node serves; target utilisation
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const reads = val('[data-r]') * THOUSAND; const hit = val('[data-h]') / 100; const keys = val('[data-k]') * MILLION; const size = val('[data-v]'); const copies = val('[data-c]'); const gb = val('[data-gb]');
      ['r', 'h', 'k', 'v', 'c', 'gb'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const dataGb = (keys * (size + KEY_OVERHEAD)) / GB; const needGb = dataGb * MEM_OVERHEAD;
      const byMem = Math.ceil(needGb / (gb * MEM_FILL)); const byOps = Math.ceil(reads / (NODE_OPS * OPS_FILL)); const shards = Math.max(byMem, byOps);
      const total = shards * (1 + copies);
      const dbNow = reads * (1 - hit);
      const lostReads = (reads * hit) / shards;
      const moveRing = keys / (shards + 1); const moveMod = (keys * shards) / (shards + 1);
      const data: [string, string][] = [
        ['Data in the cache', `${fmt(dataGb)} GB`],
        ['Memory with overhead', `${fmt(needGb)} GB`],
        ['Shards needed for memory', fmt(byMem)],
        ['Shards needed for throughput', fmt(byOps)],
        ['Shards to run', `${fmt(shards)} (limited by ${byMem >= byOps ? 'memory' : 'throughput'})`],
        ['Nodes in total, with replicas', fmt(total)],
        ['Database reads per second at the normal hit ratio', fmt(dbNow)],
        ['Database reads per second with no cache at all', fmt(reads)],
        ['Extra database reads per second if a node is lost and has no replica (upper bound)', fmt(lostReads)],
        ['Keys that move when one node is added, with consistent hashing', `${fmt(moveRing / MILLION)} million`],
        ['Keys that move when one node is added, with hash mod N', `${fmt(moveMod / MILLION)} million`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
