---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Bandwidth usually decides the size of the fleet, while sessions and keepalives decide how much control work each gateway does.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Enrolled devices (thousands) <input type="range" min="10" max="5000" step="10" value="1000" data-p /> <b data-pval></b></label>
      <label>Connected at the peak (%) <input type="range" min="5" max="80" value="30" data-c /> <b data-cval></b></label>
      <label>Average traffic per connected device (Mbps) <input type="range" min="1" max="20" value="2" data-m /> <b data-mval></b></label>
      <label>Share of traffic through the tunnel (%) <input type="range" min="10" max="100" step="5" value="40" data-s /> <b data-sval></b></label>
      <label>Keepalive interval (seconds) <input type="range" min="10" max="60" step="5" value="25" data-k /> <b data-kval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: one gateway carries 5 Gbps of encrypted traffic and holds 25,000 sessions, we plan to use at most 60% of either, keys are renewed every 120 seconds, one spare gateway is added, and a drained gateway moves its devices over 5 minutes.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const devices = val('[data-p]') * 1000; const conc = val('[data-c]') / 100; const mbps = val('[data-m]'); const share = val('[data-s]') / 100; const k = val('[data-k]');
      ['p', 'c', 'm', 's', 'k'].forEach((x) => (q(`[data-${x}val]`).textContent = String(val(`[data-${x}]`))));
      const connected = devices * conc; const gbps = (connected * mbps * share) / 1000;
      const byBw = Math.ceil(gbps / (5 * 0.6)); const bySess = Math.ceil(connected / (25000 * 0.6)); const run = Math.max(byBw, bySess) + 1;
      const perGw = connected / run;
      const data: [string, string][] = [
        ['Connected devices at the peak', fmt(connected)],
        ['Traffic through the tunnels', `${fmt(gbps)} Gbps`],
        ['Gateways needed for bandwidth', fmt(byBw)],
        ['Gateways needed for sessions', fmt(bySess)],
        ['Gateways to run, with one spare', fmt(run)],
        ['Keepalive packets per second, whole fleet', fmt(connected / k)],
        ['Rekey handshakes per second, whole fleet', fmt(connected / 120)],
        ['Sessions on each gateway', fmt(perGw)],
        ['Reconnects per second while draining one gateway', (perGw / 300).toFixed(1)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
