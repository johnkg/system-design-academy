---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Roaming and NAT keepalives" hint="200 simulated devices each switch network a few times an hour. Change how the gateway identifies a tunnel, how often keepalives are sent and how strict the NAT is, and watch who is cut off.">
  <ol class="how">
    <li>The default identifies tunnels <b>by source address</b>, sends a keepalive every <b>45 s</b> and runs on <b>mobile carrier NAT</b>: <b>90 of 200 devices</b> cannot be reached, because their NAT forgets the mapping in 30 to 44 s, and each device loses about <b>538 s</b> an hour on its network switches.</li>
    <li>Identify the tunnel <b>by session id</b>: the downtime drops to <b>4 s</b> an hour, because a roam is one packet and not a new handshake. The 90 unreachable devices stay, because that is a NAT problem.</li>
    <li>On <b>mobile carrier NAT</b> (the default), set the keepalive to <b>25 s</b>: nobody is unreachable on mobile NAT, for <b>144</b> packets an hour each. On the strict corporate NAT (15 to 30 s) the same 25 s still leaves <b>118</b> unreachable, and only 15 s or less is safe.</li>
  </ol>
  <div class="pg vpb" data-vpb>
    <div class="pg-row">
      <label>The gateway finds a tunnel by <select class="pg-in" data-id>
        <option value="addr" selected>source address and port</option>
        <option value="session">session id and key</option>
      </select></label>
      <label>NAT in front of the devices <select class="pg-in" data-nat>
        <option value="mobile" selected>mobile carrier (30 to 60 s)</option>
        <option value="home">home router (120 to 300 s)</option>
        <option value="strict">strict corporate (15 to 30 s)</option>
      </select></label>
      <RangeField label="Keepalive every (seconds)" name="k" min="5" max="120" step="5" value="45" />
    </div>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Devices that cannot be reached</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>Downtime per device per hour</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Keepalive cost per device</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
      <div class="pg-box" data-b4><h3>Time to notice a dead peer</h3><span class="pg-mono" data-o4></span><span class="pg-note" data-n4></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: each device has its own NAT timeout, spread evenly over the range shown. If the keepalive interval is longer than that timeout, the NAT forgets the mapping while the tunnel is idle and the gateway cannot reach the device until the device sends something. Every device switches network 2 to 6 times an hour. With address-based tunnels a switch is only noticed after 3 missed keepalives, plus 2 s for a new handshake. With session ids the next packet carries on, which costs 1 s. A dead peer is declared after 3 missed keepalives.</p>
  </div>
</PlaygroundShell>
<script>
  import { query } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-vpb]').forEach((root) => {
    const q = query(root);
    const N = 200;
    const SEED = 11;
    const SWITCHES = { min: 2, span: 5 }; // network changes per client: 2..6
    const MISSES = 3; // a peer is declared dead after 3 missed keepalives
    const REKEY_S = 2; // an address-bound tunnel needs 2 s on top of detection to rebuild
    const HOUR_S = 3600;
    const GOAL = { downS: 30, perHour: 150, detectS: 90 };
    // linear congruential generator (Numerical Recipes constants)
    let seed = SEED; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
    const clients = Array.from({ length: N }, () => ({ u: rnd(), sw: SWITCHES.min + Math.floor(rnd() * SWITCHES.span) }));
    const range: Record<string, [number, number]> = { mobile: [30, 60], home: [120, 300], strict: [15, 30] };
    function simulate(id: string, k: number, nat: string) {
      const [lo, hi] = range[nat]; let broken = 0; let down = 0;
      for (const c of clients) {
        if (k > lo + Math.floor(c.u * (hi - lo + 1))) broken++;
        down += c.sw * (id === 'addr' ? MISSES * k + REKEY_S : 1);
      }
      return { broken, down: Math.round(down / N), perHour: Math.floor(HOUR_S / k), detect: MISSES * k };
    }
    function draw() {
      const id = q<HTMLSelectElement>('[data-id]').value; const nat = q<HTMLSelectElement>('[data-nat]').value; const k = Number(q<HTMLInputElement>('[data-k]').value);
      q('[data-kval]').textContent = `${k} s`;
      const r = simulate(id, k, nat);
      q('[data-o1]').textContent = `${r.broken} of ${N}`; q('[data-n1]').textContent = r.broken === 0 ? 'every NAT mapping is refreshed in time' : 'their NAT dropped the mapping while idle';
      q('[data-o2]').textContent = `${r.down} s`; q('[data-n2]').textContent = id === 'addr' ? 'each switch waits for 3 missed keepalives, then a new handshake' : 'each switch costs about 1 s: the next packet carries on';
      q('[data-o3]').textContent = `${r.perHour} packets/h`; q('[data-n3]').textContent = r.perHour > GOAL.perHour ? 'costly for a phone in the background' : 'light on the battery';
      q('[data-o4]').textContent = `${r.detect} s`; q('[data-n4]').textContent = r.detect > GOAL.detectS ? `slower than the goal of about a minute (over ${GOAL.detectS} s)` : 'within the goal of about a minute';
      q<HTMLElement>('[data-b1]').style.setProperty('--c', r.broken === 0 ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', r.down <= GOAL.downS ? 'var(--good)' : 'var(--bad)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', r.perHour > GOAL.perHour ? 'var(--bad)' : 'var(--accent)');
      q<HTMLElement>('[data-b4]').style.setProperty('--c', r.detect > GOAL.detectS ? 'var(--bad)' : 'var(--good)');
      const out = q('[data-verdict]'); const bad = r.broken > 0 || r.down > GOAL.downS || r.detect > GOAL.detectS; out.classList.toggle('bad', bad);
      const parts: string[] = [];
      if (r.broken > 0) parts.push(`${r.broken} devices are unreachable because the keepalive of ${k} s is longer than their NAT timeout. Send keepalives more often.`);
      if (id === 'addr') parts.push(`Identifying tunnels by address turns every network switch into ${3 * k + 2} s of downtime. Identify them by session id so that a roam is one packet.`);
      if (r.detect > GOAL.detectS && id !== 'addr') parts.push(`A dead peer takes ${r.detect} s to notice, which is slower than the goal of about a minute (over ${GOAL.detectS} s).`);
      out.textContent = parts.length ? parts.join(' ') : `Healthy: all ${N} devices stay reachable, a switch costs about 1 s, and ${r.perHour} keepalives an hour is affordable.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
