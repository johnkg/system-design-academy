---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The whole index of places is small enough for a few machines, so the number to watch is how many places each search has to look at in the densest part of a city.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Places (millions) <input type="range" min="10" max="1000" step="10" value="200" data-p /> <b data-pval></b></label>
      <label>Daily active users (millions) <input type="range" min="1" max="200" value="30" data-dau /> <b data-dauval></b></label>
      <label>Searches per user per day <input type="range" min="1" max="20" value="6" data-s /> <b data-sval></b></label>
      <label>Peak is how many times the average <input type="range" min="1" max="6" value="3" data-pk /> <b data-pkval></b></label>
      <label>Search radius (km) <input type="range" min="1" max="10" value="2" data-r /> <b data-rval></b></label>
      <label>Places per km&sup2; in the densest area <input type="range" min="50" max="3000" step="50" value="800" data-den /> <b data-denval></b></label>
      <label>Searches answered from the cache (%) <input type="range" min="0" max="90" step="5" value="60" data-hit /> <b data-hitval></b></label>
      <label>Memory per index machine (GB) <input type="range" min="16" max="256" step="16" value="64" data-gb /> <b data-gbval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: an index entry (id, position, category, rating, opening hours and a few ranking fields) takes about 200 bytes in memory, the full record in the database is about 2 KB without photos, and one machine can measure the distance to about 100 million places per second. The cells are as wide as the radius, so one search reads 9 cells of radius times radius, which is 9 r&sup2; km&sup2;. At least 3 replicas are kept for availability. The searches are modelled as all happening in the densest area, which is the worst case.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 11 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const keys = ['p', 'dau', 's', 'pk', 'r', 'den', 'hit', 'gb'];
      keys.forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const places = val('[data-p]') * 1e6; const perDay = val('[data-dau]') * 1e6 * val('[data-s]');
      const avg = perDay / 86400; const peak = avg * val('[data-pk]'); const reach = peak * (1 - val('[data-hit]') / 100);
      const r = val('[data-r]'); const den = val('[data-den]'); const gb = val('[data-gb]');
      const indexGb = (places * 200) / 1e9; const dbGb = (places * 2000) / 1e9;
      const cand = den * 9 * r * r; const perNode = 100e6 / cand;
      const memNodes = Math.ceil(indexGb / gb); const replicas = Math.max(3, Math.ceil(reach / (perNode * memNodes)));
      const data: [string, string][] = [
        ['Searches per day', fmt(perDay)],
        ['Average searches per second', fmt(avg)],
        ['Peak searches per second', fmt(peak)],
        ['Peak searches per second that reach the index', fmt(reach)],
        ['Memory for the index of places', `${fmt(indexGb)} GB`],
        ['Database size for full records', `${dbGb >= 1000 ? (dbGb / 1000).toFixed(1) + ' TB' : fmt(dbGb) + ' GB'}`],
        ['Places a full scan would measure per search', fmt(places)],
        ['Places measured per search with 9 cells in the densest area', fmt(cand)],
        ['Searches per second one machine can serve there', fmt(perNode)],
        ['Machines to hold the index (one copy)', fmt(memNodes)],
        ['Machines to run, with replicas', `${fmt(memNodes * replicas)} (${fmt(replicas)} copies of the index)`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
