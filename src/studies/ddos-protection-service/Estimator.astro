---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Capacity must beat the attack where the attack lands, and for a request flood even a 99% filter leaves a lot behind.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Attack size (Gbps)" name="atk" min="100" max="20000" step="100" value="2000" />
      <RangeField label="Points of presence" name="pops" min="20" max="400" step="10" value="250" />
      <RangeField label="Capacity per point of presence (Gbps)" name="cap" min="50" max="1000" step="50" value="300" />
      <RangeField label="Share of sites the attack reaches (%)" name="share" min="5" max="100" step="5" value="20" />
      <RangeField label="HTTP flood (million requests per second)" name="rps" min="1" max="200" value="50" />
      <RangeField label="Share of flood caught by bot scoring (%)" name="catch" min="90" max="99.99" step="0.01" value="99" />
      <RangeField label="Flood requests answered from the cache (%)" name="hit" min="0" max="99" value="95" />
      <RangeField label="Origin capacity (thousand requests per second)" name="orig" min="1" max="200" value="20" />
      <RangeField label="Real traffic (thousand requests per second)" name="real" min="1" max="200" value="20" />
      <RangeField label="Real requests blocked by mistake (%)" name="fp" min="0" max="5" step="0.05" value="0.5" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: an attack is concentrated near its bots, so only the chosen share of the sites faces it and shares the load evenly. Sites are equal in size. Bot scoring, the cache and the origin are applied to the flood in that order, and cache-busting would make the cache share 0%. The origin sees the flood on top of the real traffic that missed the cache, which is taken as 20% of real traffic. The 95% default for the cache assumes the flood asks for cacheable pages.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 10; // one per output line
    const MILLION = 1e6; const THOUSAND = 1000; const GBPS_PER_TBPS = 1000; const SEC_PER_H = 3600;
    const REAL_MISS_SHARE = 0.2; // share of real requests that miss the cache
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number, d = 0) => n.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
    function draw() {
      const atk = val('[data-atk]'); const pops = val('[data-pops]'); const cap = val('[data-cap]'); const share = val('[data-share]') / 100;
      const rps = val('[data-rps]') * MILLION; const caught = val('[data-catch]') / 100; const hit = val('[data-hit]') / 100;
      const orig = val('[data-orig]') * THOUSAND; const real = val('[data-real]') * THOUSAND; const fp = val('[data-fp]') / 100;
      q('[data-atkval]').textContent = fmt(atk); q('[data-popsval]').textContent = String(pops); q('[data-capval]').textContent = fmt(cap); q('[data-shareval]').textContent = String(Math.round(share * 100));
      q('[data-rpsval]').textContent = String(rps / MILLION); q('[data-catchval]').textContent = fmt(caught * 100, 2); q('[data-hitval]').textContent = String(Math.round(hit * 100));
      q('[data-origval]').textContent = String(orig / THOUSAND); q('[data-realval]').textContent = String(real / THOUSAND); q('[data-fpval]').textContent = fmt(fp * 100, 2);
      const exposed = pops * share;
      const edgeTbps = (exposed * cap) / GBPS_PER_TBPS;
      const perSite = atk / exposed;
      const left = rps * (1 - caught); const reach = left * (1 - hit); const total = reach + real * REAL_MISS_SHARE; const load = total / orig;
      const data: [string, string][] = [
        ['Sites the attack reaches', fmt(exposed, 1)],
        ['Edge capacity facing the attack', `${fmt(edgeTbps, 1)} Tbps`],
        ['Attack on each reached site', `${fmt(perSite, 1)} Gbps (${fmt((perSite / cap) * 100)}% of its capacity)`],
        ['Headroom over the attack', `${fmt((edgeTbps * GBPS_PER_TBPS) / atk, 1)} times`],
        ['HTTP flood on each reached site', `${fmt(rps / exposed / THOUSAND)} thousand requests/s`],
        ['Flood left after bot scoring', `${fmt(left / THOUSAND, 1)} thousand requests/s`],
        ['Flood reaching the origin after the cache', `${fmt(reach / THOUSAND, 1)} thousand requests/s`],
        ['Origin load (flood plus real cache misses)', `${fmt(load * 100)}% of capacity`],
        ['Real requests blocked by mistake', `${fmt(real * fp)} per second`],
        ['Real requests blocked by mistake per hour', fmt(real * fp * SEC_PER_H)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
