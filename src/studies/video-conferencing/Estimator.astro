---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Mesh multiplies the upload by the meeting size, an SFU multiplies the server's output, and an MCU multiplies its CPU. See where each limit lands.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Participants in a meeting <input type="range" min="2" max="100" value="12" data-n /> <b data-nval></b></label>
      <label>Tiles each viewer sees <input type="range" min="1" max="25" value="9" data-t /> <b data-tval></b></label>
      <label>Average bitrate per received tile (kbit/s) <input type="range" min="150" max="1500" step="50" value="500" data-k /> <b data-kval></b></label>
      <label>Concurrent participants (thousands) <input type="range" min="10" max="5000" step="10" value="1000" data-c /> <b data-cval></b></label>
      <label>Usable network per media server (Gbit/s) <input type="range" min="1" max="20" value="5" data-nic /> <b data-nicval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a full 720p stream is 1.5 Mbit/s, simulcast uploads three layers of 0.15, 0.5 and 1.5 Mbit/s (2.15 Mbit/s in all) and every sender uploads all three, a viewer shows the smaller of the tile limit and the other participants, an MCU needs about 0.1 core to decode a stream and 0.3 core to encode a mosaic for each participant, and a server of 10 Gbit/s is run at about half its capacity so that bursts and failover fit.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const one = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    function draw() {
      const n = val('[data-n]'); const t = val('[data-t]'); const k = val('[data-k]'); const people = val('[data-c]') * 1000; const nic = val('[data-nic]');
      ['n', 't', 'k', 'c', 'nic'].forEach((x) => (q(`[data-${x}val]`).textContent = String(val(`[data-${x}]`))));
      const tiles = Math.min(n - 1, t);
      const meshUp = ((n - 1) * 1.5); // Mbit/s
      const egressGbps = (people * tiles * k) / 1e6; // kbit/s to Gbit/s
      const servers = Math.ceil(egressGbps / nic);
      const data: [string, string][] = [
        ['Mesh: upload each client needs', `${one(meshUp)} Mbit/s`],
        ['Mesh: video encodes each client runs', fmt(n - 1)],
        ['SFU with simulcast: upload each client needs', '2.2 Mbit/s'],
        ['SFU: download each client needs', `${one((tiles * k) / 1000)} Mbit/s`],
        ['Concurrent meetings', fmt(people / n)],
        ['Server traffic received from clients', `${one((people * 2150) / 1e6)} Gbit/s`],
        ['Server traffic sent to clients', `${one(egressGbps)} Gbit/s`],
        ['Media servers needed for the traffic', fmt(servers)],
        ['CPU cores an MCU would need for the same people', fmt(people * 0.4)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
