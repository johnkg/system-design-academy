---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
const COUNT = 120;
---
<PlaygroundShell title="Tune an alert" hint="A server's CPU for 120 minutes: ordinary noise, a one-minute spike, a two-minute blip, a flapping stretch, and one real problem. Red bars are minutes when the alert is firing.">
  <ol class="how">
    <li>Start with the defaults (<b>threshold 75, no averaging, no waiting</b>): the alert fires on the <b>noise</b>, the spike and the blip. Nearly all of those pages are false.</li>
    <li>Make it <b>wait for 3 minutes</b>: the false alerts disappear, and the real problem is detected <b>3 minutes later</b> than before.</li>
    <li>Keep the 3-minute wait and raise the threshold to <b>90</b>: the real problem, which runs near 85, is <b>missed completely</b>. Tuning an alert trades quiet against speed and certainty.</li>
  </ol>
  <div class="pg mmb" data-mmb>
    <div class="pg-row">
      <label>Alert above <input type="range" min="55" max="95" value="75" data-t /> <b data-tval></b></label>
      <label>Average over the last <select class="pg-in" data-w>
        <option value="1">1 minute (raw)</option>
        <option value="3">3 minutes</option>
        <option value="5">5 minutes</option>
      </select></label>
      <label>Must hold for <select class="pg-in" data-f>
        <option value="0">no wait</option>
        <option value="1">1 minute</option>
        <option value="3">3 minutes</option>
        <option value="5">5 minutes</option>
      </select></label>
    </div>
    <div class="chart" aria-hidden="true" data-chart>
      {Array.from({ length: COUNT }, () => <span class="bar"></span>)}
      <div class="line" data-line></div>
    </div>
    <p class="axis" aria-hidden="true"><span>0 min</span><span>real problem: minutes 80 to 100</span><span>120 min</span></p>
    <div class="pg-grid">
      <div class="pg-box" data-b1><h3>Times the alert fired</h3><span class="pg-mono" data-o1></span><span class="pg-note" data-n1></span></div>
      <div class="pg-box" data-b2><h3>False alerts</h3><span class="pg-mono" data-o2></span><span class="pg-note" data-n2></span></div>
      <div class="pg-box" data-b3><h3>Real problem</h3><span class="pg-mono" data-o3></span><span class="pg-note" data-n3></span></div>
    </div>
    <p class="pg-out" data-verdict aria-live="polite"></p>
    <p class="pg-note">Model: one reading a minute, normal CPU about 50% with noise, a one-minute spike at minute 25, a two-minute blip at minutes 55 to 56, a stretch hovering around 75% from 105 to 114, and a real problem at about 85% from minute 80 to 100. A reading counts as bad when the average of the last few minutes is above the line, and the alert fires once it has been bad for the chosen time. A firing alert resolves as soon as a reading is fine.</p>
  </div>
</PlaygroundShell>
<style>
  .chart { position: relative; display: flex; align-items: flex-end; gap: 1px; height: 120px; padding: 6px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface-2); overflow: hidden; }
  .bar { flex: 1 1 0; min-width: 0; background: var(--muted); opacity: .55; border-radius: 1px 1px 0 0; }
  .bar.fire { background: var(--bad); opacity: 1; }
  .line { position: absolute; left: 0; right: 0; border-top: 2px dashed var(--accent); pointer-events: none; }
  .axis { display: flex; justify-content: space-between; margin: 4px 2px 10px; font-size: .78rem; color: var(--muted); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-mmb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const N = 120;
    const NOISE_SCALE = 12; const CPU = { min: 5, base: 50 }; // CPU % per minute: around 50, never below 5
    const SPIKES: [number, number][] = [[25, 96], [55, 92], [56, 90]]; // one- and two-minute blips
    const WOBBLE = { from: 105, to: 114, level: 75, noiseX: 0.7 }; // a busy but harmless stretch
    const INCIDENT = { from: 80, to: 100, level: 85, noiseX: 0.5 }; // the real problem
    const BAR_MIN_PCT = 2;
    // Numerical Recipes LCG
    let seed = 17; const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
    const noise = () => (rnd() + rnd() + rnd() + rnd() - 2) * NOISE_SCALE; // roughly bell-shaped, about +/- 10
    const v = Array.from({ length: N }, () => Math.max(CPU.min, Math.min(100, CPU.base + noise())));
    SPIKES.forEach(([i, x]) => { v[i] = x; });
    for (let i = WOBBLE.from; i <= WOBBLE.to; i++) v[i] = WOBBLE.level + noise() * WOBBLE.noiseX;
    for (let i = INCIDENT.from; i <= INCIDENT.to; i++) v[i] = INCIDENT.level + noise() * INCIDENT.noiseX;
    const bars = Array.from(root.querySelectorAll<HTMLElement>('.bar'));
    bars.forEach((b, i) => (b.style.height = `${Math.max(BAR_MIN_PCT, v[i])}%`));
    function draw() {
      const t = Number(q<HTMLInputElement>('[data-t]').value); const w = Number(q<HTMLSelectElement>('[data-w]').value); const f = Number(q<HTMLSelectElement>('[data-f]').value);
      q('[data-tval]').textContent = `${t}%`;
      q<HTMLElement>('[data-line]').style.bottom = `calc(${t}% * 0.88 + 6px)`;
      const firing: boolean[] = []; let run = 0;
      for (let i = 0; i < N; i++) {
        const from = Math.max(0, i - w + 1); let s = 0; for (let j = from; j <= i; j++) s += v[j];
        const bad = s / (i - from + 1) > t;
        run = bad ? run + 1 : 0;
        firing.push(run > 0 && run >= Math.max(1, f + 1)); // "must hold for f minutes" means f+1 bad readings in a row
      }
      bars.forEach((b, i) => b.classList.toggle('fire', firing[i]));
      const eps: { from: number; to: number }[] = [];
      firing.forEach((x, i) => { if (x && !firing[i - 1]) eps.push({ from: i, to: i }); if (x) eps[eps.length - 1].to = i; });
      const real = eps.filter((e) => e.to >= INCIDENT.from && e.from <= INCIDENT.to); const falseOnes = eps.filter((e) => !(e.to >= INCIDENT.from && e.from <= INCIDENT.to));
      const first = real.length ? Math.max(real[0].from, INCIDENT.from) - INCIDENT.from : -1;
      q('[data-o1]').textContent = `${eps.length}`; q('[data-n1]').textContent = eps.length === 1 ? 'page' : 'pages';
      q('[data-o2]').textContent = `${falseOnes.length}`; q('[data-n2]').textContent = falseOnes.length ? 'pages when nothing was wrong' : 'none, nobody woken for nothing';
      q('[data-o3]').textContent = first >= 0 ? `detected after ${first} min` : 'MISSED';
      q('[data-n3]').textContent = first >= 0 ? 'minutes after it began' : 'no alert fired during the real problem';
      q<HTMLElement>('[data-b1]').style.setProperty('--c', 'var(--accent)');
      q<HTMLElement>('[data-b2]').style.setProperty('--c', falseOnes.length ? 'var(--bad)' : 'var(--good)');
      q<HTMLElement>('[data-b3]').style.setProperty('--c', first >= 0 ? 'var(--good)' : 'var(--bad)');
      const out = q('[data-verdict]'); const bad = falseOnes.length > 0 || first < 0; out.classList.toggle('bad', bad);
      out.textContent = first < 0 ? 'The real problem was missed: the line is above the level it reached. A quiet alert that misses outages is worse than a noisy one.'
        : falseOnes.length > 2 ? `${falseOnes.length} of ${eps.length} pages were false. On-call engineers who get these learn to ignore pages. Try asking the condition to hold for a few minutes.`
        : falseOnes.length > 0 ? `${falseOnes.length} false page${falseOnes.length === 1 ? '' : 's'} left, and the real problem was found after ${first} minute${first === 1 ? '' : 's'}. Look at where the red bars are.`
        : `No false pages, and the real problem was found after ${first} minute${first === 1 ? '' : 's'}. Waiting is what bought the quiet.`;
    }
    root.addEventListener('input', draw); root.addEventListener('change', draw);
    draw();
  });
</script>
