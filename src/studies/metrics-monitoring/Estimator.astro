---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Watch what the number of different label values does to the number of series, and what compression and rollups save.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Servers" name="hosts" min="100" max="20000" step="100" value="5000" />
      <RangeField label="Metrics per server" name="mets" min="50" max="2000" step="50" value="500" />
      <RangeField label="Seconds between samples" name="gap" min="5" max="60" step="5" value="15" />
      <RangeField label="Values of an extra label, such as endpoint (1 = none)" name="lab" min="1" max="100" value="1" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: a raw sample takes 16 bytes in a plain table and about 1.5 bytes in a time-series database, raw data is kept for 15 days, minute rollups (3 values each) for 90 days and hour rollups for 2 years, and the extra label multiplies the series of 1 in 10 metrics.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 8; // lines in the result list
    const LABELLED_SHARE = 0.1; // share of metrics that carry the extra label (the rest have one series per host)
    const DAY_S = 86400, MIN_PER_DAY = 1440, H_PER_DAY = 24;
    const BYTES = { sql: 16, tsdb: 1.5 }; // bytes per sample: a SQL row vs a compressed time-series sample
    const RAW_DAYS = 15, MINUTE_DAYS = 90, HOUR_DAYS = 730; // retention of raw data, minute rollups and hour rollups (2 years)
    const ROLLUP_VALUES = 3; // a rollup keeps min, max and average
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const size = (bytes: number) => (bytes >= 1e15 ? `${(bytes / 1e15).toFixed(1)} PB` : bytes >= 1e12 ? `${(bytes / 1e12).toFixed(1)} TB` : `${(bytes / 1e9).toFixed(0)} GB`);
    function draw() {
      const hosts = val('[data-hosts]'); const mets = val('[data-mets]'); const gap = val('[data-gap]'); const lab = val('[data-lab]');
      ['hosts', 'mets', 'gap', 'lab'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const series = hosts * (mets * (1 - LABELLED_SHARE) + mets * LABELLED_SHARE * lab); const perSec = series / gap; const day = DAY_S / gap;
      const rawDay = series * day;
      const rawBytes = rawDay * RAW_DAYS * BYTES.tsdb;
      const minuteBytes = series * MIN_PER_DAY * MINUTE_DAYS * ROLLUP_VALUES * BYTES.tsdb;
      const hourBytes = series * H_PER_DAY * HOUR_DAYS * ROLLUP_VALUES * BYTES.tsdb;
      const total = rawBytes + minuteBytes + hourBytes;
      const data: [string, string][] = [
        ['Active time series', fmt(series)],
        ['Samples received per second', fmt(perSec)],
        [`One day as a plain SQL table (${BYTES.sql} bytes a sample)`, size(rawDay * BYTES.sql)],
        ['One day in a time-series database', size(rawDay * BYTES.tsdb)],
        [`Raw data kept for ${RAW_DAYS} days`, size(rawBytes)],
        [`Minute rollups for ${MINUTE_DAYS} days`, size(minuteBytes)],
        ['Hour rollups for 2 years', size(hourBytes)],
        ['Total with this retention', size(total)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
