---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Watch what the number of different label values does to the number of series, and what compression and rollups save.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Servers <input type="range" min="100" max="20000" step="100" value="5000" data-hosts /> <b data-hostsval></b></label>
      <label>Metrics per server <input type="range" min="50" max="2000" step="50" value="500" data-mets /> <b data-metsval></b></label>
      <label>Seconds between samples <input type="range" min="5" max="60" step="5" value="15" data-gap /> <b data-gapval></b></label>
      <label>Values of an extra label, such as endpoint (1 = none) <input type="range" min="1" max="100" value="1" data-lab /> <b data-labval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: a raw sample takes 16 bytes in a plain table and about 1.5 bytes in a time-series database, raw data is kept for 15 days, minute rollups (3 values each) for 90 days and hour rollups for 2 years, and the extra label multiplies the series of 1 in 10 metrics.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const size = (bytes: number) => (bytes >= 1e15 ? `${(bytes / 1e15).toFixed(1)} PB` : bytes >= 1e12 ? `${(bytes / 1e12).toFixed(1)} TB` : `${(bytes / 1e9).toFixed(0)} GB`);
    function draw() {
      const hosts = val('[data-hosts]'); const mets = val('[data-mets]'); const gap = val('[data-gap]'); const lab = val('[data-lab]');
      ['hosts', 'mets', 'gap', 'lab'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const series = hosts * (mets * 0.9 + mets * 0.1 * lab); const perSec = series / gap; const day = 86400 / gap;
      const rawDay = series * day;
      const total = (rawDay * 15 * 1.5) + (series * 1440 * 90 * 3 * 1.5) + (series * 24 * 730 * 3 * 1.5);
      const data: [string, string][] = [
        ['Active time series', fmt(series)],
        ['Samples received per second', fmt(perSec)],
        ['One day as a plain SQL table (16 bytes a sample)', size(rawDay * 16)],
        ['One day in a time-series database', size(rawDay * 1.5)],
        ['Raw data kept for 15 days', size(rawDay * 15 * 1.5)],
        ['Minute rollups for 90 days', size(series * 1440 * 90 * 3 * 1.5)],
        ['Hour rollups for 2 years', size(series * 24 * 730 * 3 * 1.5)],
        ['Total with this retention', size(total)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
