---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Inspection cost grows with the rule count and the size of what is scanned, and the fleet must survive losing a zone at the peak.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Peak requests per second (thousands) <input type="range" min="10" max="1000" step="10" value="200" data-rps /> <b data-rpsval></b></label>
      <label>Average inspected bytes per request (KB) <input type="range" min="1" max="32" value="4" data-kb /> <b data-kbval></b></label>
      <label>Active rules <input type="range" min="50" max="1000" step="50" value="300" data-rules /> <b data-rulesval></b></label>
      <label>Cores per WAF node <input type="range" min="4" max="64" step="4" value="16" data-cores /> <b data-coresval></b></label>
      <label>Requests logged as flagged (%) <input type="range" min="1" max="20" value="1" data-flag /> <b data-flagval></b></label>
    </div>
    <dl class="est-out" data-out></dl>
    <p class="pg-note">Assumptions: 30 microseconds of fixed work per request (parsing and normalising), plus 5 microseconds per KB scanned for every 100 rules in a single pass, a target of 50% CPU at the peak, spare capacity for losing one of three zones (50% extra), a network hop of 0.3 ms inside the added latency, and 1 KB per logged decision. TLS work is excluded because it is done at the edge anyway.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 9 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    function draw() {
      const rps = val('[data-rps]') * 1000; const kb = val('[data-kb]'); const rules = val('[data-rules]'); const cores = val('[data-cores]'); const flag = val('[data-flag]') / 100;
      ['rps', 'kb', 'rules', 'cores', 'flag'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const micros = 30 + 5 * kb * (rules / 100);
      const busy = (rps * micros) / 1e6; const needed = busy / 0.5;
      const nodes = Math.ceil(needed / cores); const withSpare = Math.ceil(nodes * 1.5);
      const gbps = (rps * kb * 1024 * 8) / 1e9;
      const latencyMs = 0.3 + micros / 1000;
      const events = rps * flag;
      const data: [string, string][] = [
        ['CPU per request', `${fmt(micros)} microseconds`],
        ['Cores busy at the peak', fmt(busy)],
        ['Cores to run at 50% CPU', fmt(needed)],
        ['WAF nodes for the peak', fmt(nodes)],
        ['Nodes with room to lose a zone', fmt(withSpare)],
        ['Inspected traffic', `${gbps.toFixed(1)} Gbit/s`],
        ['Added latency (typical)', `${latencyMs.toFixed(2)} ms`],
        ['Flagged events per second', fmt(events)],
        ['Event log volume', `${(events / 1000).toFixed(1)} MB/s`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
