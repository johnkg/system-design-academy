---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Inspection cost grows with the rule count and the size of what is scanned, and the fleet must survive losing a zone at the peak.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Peak requests per second (thousands)" name="rps" min="10" max="1000" step="10" value="200" />
      <RangeField label="Average inspected bytes per request (KB)" name="kb" min="1" max="32" value="4" />
      <RangeField label="Active rules" name="rules" min="50" max="1000" step="50" value="300" />
      <RangeField label="Cores per WAF node" name="cores" min="4" max="64" step="4" value="16" />
      <RangeField label="Requests logged as flagged (%)" name="flag" min="1" max="20" value="1" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: 30 microseconds of fixed work per request (parsing and normalising), plus 5 microseconds per KB scanned for every 100 rules in a single pass, a target of 50% CPU at the peak, spare capacity for losing one of three zones (50% extra), a network hop of 0.3 ms inside the added latency, and 1 KB per logged decision. TLS work is excluded because it is done at the edge anyway.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const THOUSAND = 1000, US_PER_S = 1e6, US_PER_MS = 1000;
    const CPU_US = { base: 30, perKbPer100Rules: 5 }; // parse cost, plus 5 microseconds per KB per 100 rules
    const TARGET_CPU = 0.5; // run cores at 50%
    const ZONE_SPARE = 1.5; // 50% extra so a zone can be lost
    const BYTES_PER_KB = 1024, BITS_PER_BYTE = 8, GBIT = 1e9;
    const NETWORK_MS = 0.3; // proxy hop on top of inspection time
    const EVENTS_PER_MB = 1000; // a flagged event logs about 1 KB
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      const rps = val('[data-rps]') * THOUSAND; const kb = val('[data-kb]'); const rules = val('[data-rules]'); const cores = val('[data-cores]'); const flag = val('[data-flag]') / 100;
      ['rps', 'kb', 'rules', 'cores', 'flag'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const micros = CPU_US.base + CPU_US.perKbPer100Rules * kb * (rules / 100);
      const busy = (rps * micros) / US_PER_S; const needed = busy / TARGET_CPU;
      const nodes = Math.ceil(needed / cores); const withSpare = Math.ceil(nodes * ZONE_SPARE);
      const gbps = (rps * kb * BYTES_PER_KB * BITS_PER_BYTE) / GBIT;
      const latencyMs = NETWORK_MS + micros / US_PER_MS;
      const events = rps * flag;
      const data: [string, string][] = [
        ['CPU per request', `${fmt(micros)} microseconds`],
        ['Cores busy at the peak', fmt(busy)],
        [`Cores to run at ${TARGET_CPU * 100}% CPU`, fmt(needed)],
        ['WAF nodes for the peak', fmt(nodes)],
        ['Nodes with room to lose a zone', fmt(withSpare)],
        ['Inspected traffic', `${gbps.toFixed(1)} Gbit/s`],
        ['Added latency (typical)', `${latencyMs.toFixed(2)} ms`],
        ['Flagged events per second', fmt(events)],
        ['Event log volume', `${(events / EVENTS_PER_MB).toFixed(1)} MB/s`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
