---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The commit interval and the number of writers decide how many small files you make and how often commits collide. The retention window decides the storage bill.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Events per second (thousands)" name="eps" min="10" max="1000" step="10" value="200" />
      <RangeField label="Compressed bytes per row" name="bytes" min="20" max="400" step="10" value="100" />
      <RangeField label="Seconds between commits" name="int" min="1" max="120" value="10" />
      <RangeField label="Parallel writers" name="w" min="1" max="32" value="8" />
      <RangeField label="Target file size (MB)" name="tgt" min="64" max="1024" step="64" value="256" />
      <RangeField label="Snapshot retention (days)" name="ret" min="1" max="30" value="7" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: every writer adds one file per commit, a commit takes about 0.3 seconds at the catalog, writers start their commits at random moments, compaction rewrites all data once and the small files stay until vacuum, and storage counts the small and the merged copies for the whole retention window (an upper bound, since vacuum removes them day by day once they leave it).</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 8; // one per output line
    const THOUSAND = 1000; const BYTES_PER_MB = 1e6; const MB_PER_GB = 1000; const GB_PER_TB = 1000; const DAY_S = 86400;
    const COMMIT_S = 0.3; // time a commit holds the table pointer
    const COPIES = 2; // stored size counted twice over the retention window
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt1 = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    function draw() {
      const eps = val('[data-eps]') * THOUSAND; const bytes = val('[data-bytes]'); const interval = val('[data-int]'); const w = val('[data-w]'); const tgt = val('[data-tgt]'); const ret = val('[data-ret]');
      ['eps', 'bytes', 'int', 'w', 'tgt', 'ret'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const mbPerSec = (eps * bytes) / BYTES_PER_MB;
      const gbPerDay = (mbPerSec * DAY_S) / MB_PER_GB;
      const commitsPerDay = DAY_S / interval;
      const fileMb = (mbPerSec * interval) / w;
      const smallPerDay = commitsPerDay * w;
      const mergedPerDay = (gbPerDay * MB_PER_GB) / tgt;
      const pRebase = (1 - Math.pow(1 - COMMIT_S / interval, w - 1)) * 100;
      const tb = (gbPerDay * ret * COPIES) / GB_PER_TB;
      const data: [string, string][] = [
        ['Compressed ingest', `${fmt1(mbPerSec)} MB/s`],
        ['New data per day', `${fmt(gbPerDay)} GB`],
        ['Commits per day', fmt(commitsPerDay)],
        ['Average file size before compaction', `${fmt1(fileMb)} MB`],
        ['Small files created per day', fmt(smallPerDay)],
        ['Files per day after compaction', fmt(mergedPerDay)],
        ['Commits that must rebase at least once', `${fmt1(pRebase)} %`],
        ['Storage for the retention window', `${fmt1(tb)} TB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
