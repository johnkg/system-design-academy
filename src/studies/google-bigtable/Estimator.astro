---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How many tablets and tablet servers a table needs, how far the three-level lookup reaches, how often a memtable flushes, and how Bloom filters and log replay change reads and recovery. A teaching model with round numbers, not Google's data.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Table size (TB)" name="b" min="1" max="5000" value="100" />
      <RangeField label="Tablet size (MB)" name="z" min="100" max="200" step="10" value="128" />
      <RangeField label="Tablets per tablet server" name="p" min="10" max="1000" step="10" value="100" />
      <RangeField label="Memtable size before a flush (MB)" name="m" min="8" max="256" step="8" value="64" />
      <RangeField label="Writes into one tablet (MB per second)" name="w" min="1" max="100" value="10" />
      <RangeField label="SSTables in a tablet" name="q" min="1" max="10" value="4" />
      <RangeField label="Bloom filter false positives (%)" name="f" min="1" max="20" value="1" />
      <RangeField label="Log replay speed (MB per second)" name="l" min="10" max="500" step="10" value="100" />
      <RangeField label="Bytes in a METADATA row" name="o" min="256" max="2048" step="256" value="1024" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Teaching model, not Google's system or data. From the Bigtable paper: tablets are about 100 to 200 MB by default, a tablet server holds typically ten to a thousand tablets, METADATA tablets are 128 MB, and the paper's example with 1 KB METADATA rows addresses 2^34 tablets. The memtable size, write rate, SSTable count, false positive rate and replay speed are my guesses that you can change. Assumptions: one terabyte is 1,000,000 MB, tablets are spread evenly, every tablet has a full memtable at the moment of a crash (the worst case), and a Bloom filter never misses a row that is there.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 10; // lines in the result list
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const f1 = formatOneDecimalBelow100;
    const pct = (n: number) => `${(Math.round(n * 1000) / 1000).toLocaleString('en-US')}%`;
    function draw() {
      ['b', 'z', 'p', 'm', 'w', 'q', 'f', 'l', 'o'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const tb = val('[data-b]'); const tabletMb = val('[data-z]'); const per = val('[data-p]'); const mem = val('[data-m]');
      const writeRate = val('[data-w]'); const sst = val('[data-q]'); const fp = val('[data-f]') / 100; const replay = val('[data-l]'); const rowBytes = val('[data-o]');
      const tablets = (tb * 1_000_000) / tabletMb; const servers = Math.ceil(tablets / per);
      const perMeta = (128 * 1024 * 1024) / rowBytes; const metaTablets = Math.ceil(tablets / perMeta);
      const logMb = mem * per;
      const data: [string, string][] = [
        ['Tablets in the table', f1(tablets)],
        ['Tablet servers needed', f1(servers)],
        ['METADATA tablets needed', f1(metaTablets)],
        ['Tablets the three-level lookup can address', f1(perMeta * perMeta)],
        ['Round trips to find a tablet with a cold client cache', '3 lookups, then the read'],
        ['Seconds between flushes if all writes go to one tablet', f1(mem / writeRate)],
        ['SSTables read for a row that does not exist, without Bloom filters', String(sst)],
        ['SSTables read for a row that does not exist, with Bloom filters', f1(sst * fp)],
        ['Most log data a crashed server may replay (MB)', f1(logMb)],
        ['Replay time at that speed (seconds)', f1(logMb / replay)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
