---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The working set in memory decides the number of shards more often than the disk does, and the oplog size decides how long a node can be away and still catch up.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Documents (millions) <input type="range" min="10" max="5000" step="10" value="500" data-d /> <b data-dval></b></label>
      <label>Average document size (KB) <input type="range" min="1" max="16" value="2" data-kb /> <b data-kbval></b></label>
      <label>Indexes per collection <input type="range" min="1" max="12" value="4" data-ix /> <b data-ixval></b></label>
      <label>Share of documents that are hot (%) <input type="range" min="1" max="100" value="20" data-hot /> <b data-hotval></b></label>
      <label>Writes per second, whole cluster <input type="range" min="1000" max="200000" step="1000" value="20000" data-w /> <b data-wval></b></label>
      <label>Memory per node (GB) <input type="range" min="16" max="256" step="16" value="64" data-gb /> <b data-gbval></b></label>
      <label>Oplog size per node (GB) <input type="range" min="5" max="200" step="5" value="50" data-op /> <b data-opval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: an index entry takes about 50 bytes, data compresses 2 to 1 on disk, the storage engine cache is half of the memory, one shard primary takes 10,000 writes per second, a shard should hold at most 2 TB on disk, each write adds about one document-size entry to the oplog, and every shard is a replica set of 3 nodes. The working set is all indexes plus the hot documents.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const N_ROWS = 10; // output lines below
    const MILLION = 1e6; const BYTES_PER_KB = 1000; const GB = 1e9; const HOUR_S = 3600;
    const INDEX_ENTRY_BYTES = 50; // one index entry
    const CACHE_SHARE = 0.5; // share of a node's RAM the storage engine uses as cache
    const COMPRESSION = 2; // on-disk compression of documents
    const DISK_PER_SHARD_GB = 2000; const WRITES_PER_SHARD = 10000; // what one shard primary holds and sustains
    const NODES_PER_SHARD = 3; // primary and two secondaries
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const one = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    function draw() {
      const docs = val('[data-d]') * MILLION; const kb = val('[data-kb]'); const ix = val('[data-ix]'); const hot = val('[data-hot]') / 100;
      const writes = val('[data-w]'); const gb = val('[data-gb]'); const op = val('[data-op]');
      ['d', 'kb', 'ix', 'hot', 'w', 'gb', 'op'].forEach((k) => (q(`[data-${k}val]`).textContent = k === 'w' ? fmt(val('[data-w]')) : String(val(`[data-${k}]`))));
      const dataGb = (docs * kb * BYTES_PER_KB) / GB; const indexGb = (docs * ix * INDEX_ENTRY_BYTES) / GB;
      const working = indexGb + dataGb * hot; const cache = gb * CACHE_SHARE;
      const diskGb = dataGb / COMPRESSION + indexGb;
      const shardsMem = Math.ceil(working / cache); const shardsDisk = Math.ceil(diskGb / DISK_PER_SHARD_GB); const shardsWrite = Math.ceil(writes / WRITES_PER_SHARD);
      const shards = Math.max(shardsMem, shardsDisk, shardsWrite);
      const perShardWrites = writes / shards;
      const windowH = (op * GB) / (perShardWrites * kb * BYTES_PER_KB) / HOUR_S;
      const binding = shards === shardsMem ? 'memory' : shards === shardsWrite ? 'writes' : 'disk';
      const data: [string, string][] = [
        ['Data size before compression', `${fmt(dataGb)} GB`],
        ['All indexes together', `${fmt(indexGb)} GB`],
        ['Working set (indexes + hot documents)', `${fmt(working)} GB`],
        ['Shards needed for memory', fmt(shardsMem)],
        ['Shards needed for disk', fmt(shardsDisk)],
        ['Shards needed for writes', fmt(shardsWrite)],
        ['Shards to run (and what sets it)', `${fmt(shards)} (${binding})`],
        [`Nodes in total, ${NODES_PER_SHARD} per shard`, fmt(shards * NODES_PER_SHARD)],
        ['Writes per second on each shard primary', fmt(perShardWrites)],
        ['Oplog window: how long a node can be away and still catch up', `${one(windowH)} hours`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
