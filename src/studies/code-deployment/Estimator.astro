---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Pulling the artifact from one place does not scale with the fleet. Caches and peers do, and the rollout itself is paced by waves and health gates, not by bandwidth.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Hosts (thousands)" name="h" min="1" max="100" value="20" />
      <RangeField label="Artifact size (MB)" name="sz" min="50" max="2000" step="50" value="500" />
      <RangeField label="Origin storage bandwidth (Gbit/s)" name="og" min="1" max="100" value="10" />
      <RangeField label="Regions with a cache tier" name="rg" min="1" max="10" value="4" />
      <RangeField label="Hosts replaced per wave (%)" name="bt" min="1" max="50" value="10" />
      <RangeField label="Canary bake time (minutes)" name="bk" min="0" max="30" value="5" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each region has a cache tier that can serve 40 Gbit/s, a host can download at 0.5 Gbit/s while it keeps serving traffic, the artifact is cut into 4 MB chunks for peer-to-peer, one wave takes 90 seconds (install, start and the health gate), and each host keeps the last 5 versions on disk so a rollback needs no download. Peer-to-peer time is the ideal swarm: a pipeline of chunks that needs about log2 of the host count extra chunk times to reach everyone.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const dur = (s: number) => (s < 90 ? `${s < 10 ? s.toFixed(1) : Math.round(s)} s` : s < 5400 ? `${(s / 60).toFixed(1)} min` : `${(s / 3600).toFixed(1)} hours`);
    const bytes = (mb: number) => (mb < 1000 ? `${fmt(mb)} MB` : mb < 1e6 ? `${(mb / 1000).toFixed(1)} GB` : `${(mb / 1e6).toFixed(1)} TB`);
    function draw() {
      const THOUSAND = 1000; const BITS_PER_BYTE = 8; const MBIT_PER_GBIT = 1000; const SEC_PER_MIN = 60;
      const hosts = val('[data-h]') * THOUSAND; const mb = val('[data-sz]'); const origin = val('[data-og]'); const regions = val('[data-rg]'); const batch = val('[data-bt]'); const bake = val('[data-bk]');
      ['h', 'sz', 'og', 'rg', 'bt', 'bk'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const HOST_GBPS = 0.5; const CACHE_GBPS = 40; const CHUNK_MB = 4; const WAVE_S = 90; const KEEP = 5;
      const gbit = (m: number) => (m * BITS_PER_BYTE) / MBIT_PER_GBIT; // megabytes to gigabits
      const perWave = Math.ceil((hosts * batch) / 100);
      const waves = Math.ceil(100 / batch);
      const rolloutS = bake * SEC_PER_MIN + WAVE_S + waves * WAVE_S; // canary wave, bake, then the batches
      const everyoneMb = hosts * mb;
      const originOnlyS = gbit(everyoneMb) / origin;
      const originCachedMb = regions * mb;
      const perRegion = hosts / regions;
      const regionS = Math.max(gbit(mb) / HOST_GBPS, gbit(perRegion * mb) / CACHE_GBPS);
      const chunks = Math.ceil(mb / CHUNK_MB);
      const p2pS = (chunks + Math.ceil(Math.log2(hosts))) * (gbit(CHUNK_MB) / HOST_GBPS);
      const data: [string, string][] = [
        ['Hosts replaced in each wave', fmt(perWave)],
        ['Time for the whole rollout (canary, bake, then waves)', dur(rolloutS)],
        ['Bytes leaving storage if every host pulls from it', bytes(everyoneMb)],
        ['Time for that through the origin link', dur(originOnlyS)],
        ['Bytes leaving storage with a cache tier per region', bytes(originCachedMb)],
        ['Time to feed every host in a region from its cache tier', dur(regionS)],
        ['Time to reach every host peer-to-peer', dur(p2pS)],
        [`Disk on each host for the last ${KEEP} versions`, bytes(mb * KEEP)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
