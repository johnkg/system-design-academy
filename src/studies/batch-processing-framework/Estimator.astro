---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Split size sets how many tasks there are, workers set the time, and the shuffle is the part that grows with the product of maps and reducers.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Input size (TB) <input type="range" min="1" max="500" value="100" data-tb /> <b data-tbval></b></label>
      <label>Split size (MB) <input type="range" min="32" max="512" step="32" value="128" data-sp /> <b data-spval></b></label>
      <label>Workers <input type="range" min="100" max="10000" step="100" value="2000" data-w /> <b data-wval></b></label>
      <label>Reduce tasks <input type="range" min="100" max="20000" step="100" value="5000" data-r /> <b data-rval></b></label>
      <label>Map output as a share of input (%) <input type="range" min="1" max="100" value="30" data-mo /> <b data-moval></b></label>
      <label>Share removed by a combiner (%) <input type="range" min="0" max="95" step="5" value="80" data-cb /> <b data-cbval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each worker reads its local disks at about 200 MB/s while mapping and has about 100 MB/s of network for the shuffle, the cluster network is not the limit, a machine fails about once in 1,000 days, and the reduce phase does no more work than the shuffle transfer. Real jobs differ, but the shape holds.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const MB_PER_TB = 1e6, KB_PER_MB = 1000, DAY_S = 86400; // decimal units throughout, as storage and network vendors quote them
    const MAP_MBPS = 200, SHUFFLE_MBPS = 100; // per worker
    const FAILURE_DAYS = 1000; // a machine fails about once in 1000 days
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const dur = (s: number) => (s < 120 ? `${Math.round(s)} s` : s < 7200 ? `${(s / 60).toFixed(1)} min` : `${(s / 3600).toFixed(1)} h`);
    function draw() {
      const tb = val('[data-tb]'); const sp = val('[data-sp]'); const w = val('[data-w]'); const r = val('[data-r]'); const mo = val('[data-mo]') / 100; const cb = val('[data-cb]') / 100;
      ['tb', 'sp', 'w', 'r', 'mo', 'cb'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const mb = tb * MB_PER_TB; const splits = Math.ceil(mb / sp);
      const mapSec = mb / (w * MAP_MBPS); const shufMb = mb * mo * (1 - cb); const shufSec = shufMb / (w * SHUFFLE_MBPS);
      const fetches = splits * r; const perFetchKb = (shufMb * KB_PER_MB) / fetches;
      const jobSec = mapSec + shufSec; const failures = (w * (jobSec / DAY_S)) / FAILURE_DAYS;
      const data: [string, string][] = [
        ['Map tasks (one per split)', fmt(splits)],
        ['Map phase time at full cluster speed', dur(mapSec)],
        ['Shuffle volume after the combiner', `${fmt(shufMb / MB_PER_TB)} TB`],
        ['Shuffle time', dur(shufSec)],
        ['Reduce fetches (maps times reducers)', fmt(fetches)],
        ['Average size of one fetch', perFetchKb < KB_PER_MB ? `${perFetchKb.toFixed(1)} KB` : `${(perFetchKb / KB_PER_MB).toFixed(1)} MB`],
        ['Job time, map plus shuffle', dur(jobSec)],
        ['Expected machine failures during the job', failures.toFixed(2)],
        ['Work to redo per failure, rerun by lineage', `about ${(100 / w).toFixed(2)}% of the job`],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
