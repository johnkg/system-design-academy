---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="How long a token bucket allows a burst, what a user can sustain after it empties, what a concurrency cap allows for a slow endpoint, and how many fleet slots non-critical traffic gets. A teaching model with round numbers, not Stripe's limits.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Bucket size (burst allowance, requests)" name="c" min="1" max="200" value="50" />
      <RangeField label="Refill rate (requests per second)" name="r" min="1" max="100" value="10" />
      <RangeField label="How fast the client tries to send (requests per second)" name="a" min="1" max="500" value="40" />
      <RangeField label="Concurrent requests allowed" name="k" min="1" max="50" value="20" />
      <RangeField label="Seconds one slow request takes" name="d" min="0.1" max="10" step="0.1" value="2" />
      <RangeField label="Fleet slots" name="s" min="10" max="1000" step="10" value="100" />
      <RangeField label="Share kept for critical requests (%)" name="x" min="0" max="50" step="5" value="20" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Teaching model. Stripe's post does not give its real rate, burst size or fleet size. It gives the example of 20 requests in progress at once and a 20% reservation for critical requests; everything else here is my guess that you can change. Assumptions: a steady stream of requests at the rate you set, a bucket that starts full, every request taking the same time, and fleet slots counted as requests in progress.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, formatOneDecimalBelow100 } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const OUT_ROWS = 9; // lines in the result list
    const rows = Array.from({ length: OUT_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const f1 = formatOneDecimalBelow100;
    const pct = (n: number) => `${(Math.round(n * 1000) / 1000).toLocaleString('en-US')}%`;
    function draw() {
      ['c', 'r', 'a', 'k', 'd', 's', 'x'].forEach((key) => (q(`[data-${key}val]`).textContent = String(val(`[data-${key}]`))));
      const cap = val('[data-c]'); const refill = val('[data-r]'); const attempt = val('[data-a]');
      const conc = val('[data-k]'); const secs = val('[data-d]'); const slots = val('[data-s]'); const reserved = val('[data-x]');
      const over = attempt > refill; const drain = over ? cap / (attempt - refill) : Infinity;
      const passed = Math.min(attempt, refill); const concRate = conc / secs;
      const data: [string, string][] = [
        ['Seconds until the bucket is empty', Number.isFinite(drain) ? f1(drain) : 'never, the refill keeps up'],
        ['Requests allowed in that time', Number.isFinite(drain) ? f1(attempt * drain) : 'all of them'],
        ['Requests per second allowed once it is empty', f1(passed)],
        ['Share of requests rejected (429) once it is empty', `${f1(over ? (100 * (attempt - refill)) / attempt : 0)}%`],
        ['Seconds of quiet to refill the bucket', f1(cap / refill)],
        ['Most requests per second the concurrency cap allows for this endpoint', f1(concRate)],
        ['Of the requests that pass the rate limit, share rejected by the cap', `${f1(passed > concRate ? (100 * (passed - concRate)) / passed : 0)}%`],
        ['Fleet slots open to non-critical requests', f1((slots * (100 - reserved)) / 100)],
        ['Fleet slots only critical requests can use', f1((slots * reserved) / 100)],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
