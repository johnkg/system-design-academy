---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The code (k data + m parity) sets the space cost, and the repair window sets the odds. Set k to 1 and m to 2 for three plain copies.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Data stored (PB)" name="pb" min="1" max="200" value="20" />
      <RangeField label="Average object size (MB)" name="os" min="1" max="1000" value="16" />
      <RangeField label="Data pieces k" name="k" min="1" max="20" value="6" />
      <RangeField label="Parity pieces m" name="m" min="1" max="8" value="3" />
      <RangeField label="Disk size (TB)" name="tb" min="4" max="24" step="2" value="16" />
      <RangeField label="Yearly disk failure rate (%)" name="afr" min="0.5" max="10" step="0.5" value="2" />
      <RangeField label="Hours to repair a failed disk" name="h" min="1" max="168" value="24" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: disks are 80% full, an object is lost when more than m of its k+m pieces sit on disks that fail inside the same repair window, disk failures are independent, and a metadata row takes about 300 bytes plus 12 bytes per piece location. Real systems are held back by failures that are not independent (a rack, a bad firmware, an operator mistake), so the published number is lower than this one.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const ROWS = 12; // one per output line
    const MB_PER_PB = 1e9; const TB_PER_PB = 1000; const GB_PER_TB = 1000; const BYTES_PER_TB = 1e12; const BITS_PER_BYTE = 8;
    const DISK_FILL = 0.8; // disks are filled to 80%
    const DAYS_PER_YEAR = 365; const HOURS_PER_YEAR = 8760; const SEC_PER_H = 3600;
    const ELEVEN_NINES = 11; // durability target, in nines
    const META_BYTES = { base: 300, perPiece: 12 }; // metadata per object
    const rows = Array.from({ length: ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const sig = (n: number) => (n >= 100 ? fmt(n) : n >= 10 ? n.toFixed(1) : n >= 1 ? n.toFixed(2) : n.toPrecision(2));
    // Chance that more than m of n pieces are lost when each is lost with probability p.
    function tail(n: number, m: number, p: number) {
      let total = 0; let c = 1;
      for (let i = 0; i <= n; i++) {
        if (i > 0) c = (c * (n - i + 1)) / i;
        if (i > m) total += c * Math.pow(p, i) * Math.pow(1 - p, n - i);
      }
      return total;
    }
    function draw() {
      const pb = val('[data-pb]'); const os = val('[data-os]'); const k = val('[data-k]'); const m = val('[data-m]'); const tb = val('[data-tb]'); const afr = val('[data-afr]') / 100; const h = val('[data-h]');
      ['pb', 'os', 'k', 'm', 'tb', 'h'].forEach((x) => (q(`[data-${x}val]`).textContent = String(val(`[data-${x}]`))));
      q('[data-afrval]').textContent = String(val('[data-afr]'));
      const n = k + m; const objects = (pb * MB_PER_PB) / os; const rawPb = (pb * n) / k;
      const disks = (rawPb * TB_PER_PB) / (tb * DISK_FILL); const perDay = (disks * afr) / DAYS_PER_YEAR;
      const p = (afr * h) / HOURS_PER_YEAR; const perWindow = tail(n, m, p); const perYear = Math.min(1, perWindow * (HOURS_PER_YEAR / h));
      const nines = perYear > 0 ? -Math.log10(perYear) : Infinity;
      const readTb = k * tb * DISK_FILL; const gbps = (readTb * BITS_PER_BYTE * GB_PER_TB) / (h * SEC_PER_H);
      const metaTb = (objects * (META_BYTES.base + META_BYTES.perPiece * n)) / BYTES_PER_TB;
      const data: [string, string][] = [
        ['Objects stored', `${sig(objects / 1e9)} billion`],
        ['Space cost (k+m) / k', `${(n / k).toFixed(2)}x, and it survives the loss of any ${m} pieces`],
        ['Raw capacity needed', `${fmt(rawPb)} PB`],
        ['Disks needed', fmt(disks)],
        ['Disk failures per day across the fleet', sig(perDay)],
        ['Chance one piece is lost during a repair window', p.toExponential(1)],
        ['Chance an object is lost per year', perYear > 0 ? perYear.toExponential(1) : '0'],
        ['Durability', Number.isFinite(nines) ? `${nines.toFixed(1)} nines${nines >= ELEVEN_NINES ? ', at or above the eleven nines S3 states' : ', below the eleven nines S3 states'}` : 'more than 15 nines'],
        ['Objects expected to be lost per year', sig(objects * perYear)],
        ['Data read to rebuild one failed disk', `${fmt(readTb)} TB (${k}x the ${(tb * DISK_FILL).toFixed(1)} TB on it)`],
        ['Repair bandwidth to finish in the window', `${sig(gbps)} Gbit/s for one disk, per failure`],
        ['Metadata for the whole store', `${sig(metaTb)} TB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
