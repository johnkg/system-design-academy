---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="The code (k data + m parity) sets the space cost, and the repair window sets the odds. Set k to 1 and m to 2 for three plain copies.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Data stored (PB) <input type="range" min="1" max="200" value="20" data-pb /> <b data-pbval></b></label>
      <label>Average object size (MB) <input type="range" min="1" max="1000" value="16" data-os /> <b data-osval></b></label>
      <label>Data pieces k <input type="range" min="1" max="20" value="6" data-k /> <b data-kval></b></label>
      <label>Parity pieces m <input type="range" min="1" max="8" value="3" data-m /> <b data-mval></b></label>
      <label>Disk size (TB) <input type="range" min="4" max="24" step="2" value="16" data-tb /> <b data-tbval></b></label>
      <label>Yearly disk failure rate (%) <input type="range" min="0.5" max="10" step="0.5" value="2" data-afr /> <b data-afrval></b></label>
      <label>Hours to repair a failed disk <input type="range" min="1" max="168" value="24" data-h /> <b data-hval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: disks are 80% full, an object is lost when more than m of its k+m pieces sit on disks that fail inside the same repair window, disk failures are independent, and a metadata row takes about 300 bytes plus 12 bytes per piece location. Real systems are held back by failures that are not independent (a rack, a bad firmware, an operator mistake), so the published number is lower than this one.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 12 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const sig = (n: number) => (n >= 100 ? fmt(n) : n >= 10 ? n.toFixed(1) : n >= 1 ? n.toFixed(2) : n.toPrecision(2));
    // Chance that more than m of n pieces are lost when each is lost with probability p.
    function tail(n: number, m: number, p: number) {
      let total = 0; let c = 1;
      for (let i = 0; i <= n; i++) {
        if (i > 0) c = (c * (n - i + 1)) / i;
        if (i > m) total += c * Math.pow(p, i) * Math.pow(1 - p, n - i);
      }
      return total;
    }
    function draw() {
      const pb = val('[data-pb]'); const os = val('[data-os]'); const k = val('[data-k]'); const m = val('[data-m]'); const tb = val('[data-tb]'); const afr = val('[data-afr]') / 100; const h = val('[data-h]');
      ['pb', 'os', 'k', 'm', 'tb', 'h'].forEach((x) => (q(`[data-${x}val]`).textContent = String(val(`[data-${x}]`))));
      q('[data-afrval]').textContent = String(val('[data-afr]'));
      const n = k + m; const objects = (pb * 1e9) / os; const rawPb = (pb * n) / k;
      const disks = (rawPb * 1000) / (tb * 0.8); const perDay = (disks * afr) / 365;
      const p = (afr * h) / 8760; const perWindow = tail(n, m, p); const perYear = Math.min(1, perWindow * (8760 / h));
      const nines = perYear > 0 ? -Math.log10(perYear) : Infinity;
      const readTb = k * tb * 0.8; const gbps = (readTb * 8 * 1000) / (h * 3600);
      const metaTb = (objects * (300 + 12 * n)) / 1e12;
      const data: [string, string][] = [
        ['Objects stored', `${sig(objects / 1e9)} billion`],
        ['Space cost (k+m) / k', `${(n / k).toFixed(2)}x, and it survives the loss of any ${m} pieces`],
        ['Raw capacity needed', `${fmt(rawPb)} PB`],
        ['Disks needed', fmt(disks)],
        ['Disk failures per day across the fleet', sig(perDay)],
        ['Chance one piece is lost during a repair window', p.toExponential(1)],
        ['Chance an object is lost per year', perYear > 0 ? perYear.toExponential(1) : '0'],
        ['Durability', Number.isFinite(nines) ? `${nines.toFixed(1)} nines${nines >= 11 ? ', at or above the eleven nines S3 states' : ', below the eleven nines S3 states'}` : 'more than 15 nines'],
        ['Objects expected to be lost per year', sig(objects * perYear)],
        ['Data read to rebuild one failed disk', `${fmt(readTb)} TB (${k}x the ${(tb * 0.8).toFixed(1)} TB on it)`],
        ['Repair bandwidth to finish in the window', `${sig(gbps)} Gbit/s for one disk, per failure`],
        ['Metadata for the whole store', `${sig(metaTb)} TB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
