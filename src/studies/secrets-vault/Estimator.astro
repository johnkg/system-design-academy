---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
import RangeField from '../../components/RangeField.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Reading a secret on every request would bury the vault. Caching on the client and long enough leases turn a flood into a trickle, but short leases create work of their own.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <RangeField label="Workload instances" name="w" min="100" max="20000" step="100" value="2000" />
      <RangeField label="Requests per second per instance" name="r" min="1" max="200" value="50" />
      <RangeField label="Client cache refresh for static secrets (seconds)" name="c" min="10" max="3600" step="10" value="300" />
      <RangeField label="Dynamic credentials per instance" name="d" min="1" max="5" value="2" />
      <RangeField label="Lease TTL (minutes)" name="t" min="5" max="1440" step="5" value="60" />
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each request reads one secret if there is no cache, each instance holds 10 static secrets, a cached client renews a lease at two thirds of its life, issuing and later revoking one dynamic credential costs about 3 writes to the Raft log (create, lease record, revoke), one vault node serves about 10,000 reads per second, and an audit line is about 500 bytes.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 8; // output lines below
    const S_PER_MIN = 60; const DAY_S = 86400; const GB = 1e9;
    const STATIC_SECRETS = 10; // static secrets each workload reads once per cache period
    const RENEW_AT = 2 / 3; // a lease is renewed two thirds of the way through its TTL
    const RAFT_WRITES = 3; // log writes per new credential
    const AUDIT_BYTES = 500; // one audit log entry
    const NODE_READS = 10000; // reads per second one vault node serves
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n < 10 ? n.toFixed(1) : Math.round(n).toLocaleString('en-US'));
    function draw() {
      const w = val('[data-w]'); const r = val('[data-r]'); const c = val('[data-c]'); const d = val('[data-d]'); const t = val('[data-t]');
      ['w', 'r', 'c', 'd', 't'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const readsNo = w * r;
      const staticReads = (w * STATIC_SECRETS) / c; const renewals = (w * d) / (t * S_PER_MIN * RENEW_AT); const readsCache = staticReads + renewals;
      const leases = w * d; const creations = leases / (t * S_PER_MIN); const raft = creations * RAFT_WRITES;
      const auditNo = (readsNo * DAY_S * AUDIT_BYTES) / GB; const auditCache = (readsCache * DAY_S * AUDIT_BYTES) / GB;
      const data: [string, string][] = [
        ['Vault reads per second if every request reads', fmt(readsNo)],
        ['Vault nodes needed to serve that', fmt(Math.ceil(readsNo / NODE_READS))],
        ['Vault reads per second with client caching and leases', fmt(readsCache)],
        ['Active leases to track', fmt(leases)],
        ['New dynamic credentials per second', fmt(creations)],
        ['Raft log writes per second from credentials', fmt(raft)],
        ['Audit log per day if every request reads (GB)', fmt(auditNo)],
        ['Audit log per day with caching (GB)', fmt(auditCache)],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
