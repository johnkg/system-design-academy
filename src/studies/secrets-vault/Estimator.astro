---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Reading a secret on every request would bury the vault. Caching on the client and long enough leases turn a flood into a trickle, but short leases create work of their own.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Workload instances <input type="range" min="100" max="20000" step="100" value="2000" data-w /> <b data-wval></b></label>
      <label>Requests per second per instance <input type="range" min="1" max="200" value="50" data-r /> <b data-rval></b></label>
      <label>Client cache refresh for static secrets (seconds) <input type="range" min="10" max="3600" step="10" value="300" data-c /> <b data-cval></b></label>
      <label>Dynamic credentials per instance <input type="range" min="1" max="5" value="2" data-d /> <b data-dval></b></label>
      <label>Lease TTL (minutes) <input type="range" min="5" max="1440" step="5" value="60" data-t /> <b data-tval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: each request reads one secret if there is no cache, each instance holds 10 static secrets, a cached client renews a lease at two thirds of its life, issuing and later revoking one dynamic credential costs about 3 writes to the Raft log (create, lease record, revoke), one vault node serves about 10,000 reads per second, and an audit line is about 500 bytes.</p>
  </div>
</PlaygroundShell>
<script>
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const val = (s: string) => Number(q<HTMLInputElement>(s).value);
    const rows = Array.from({ length: 8 }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    const fmt = (n: number) => (n < 10 ? n.toFixed(1) : Math.round(n).toLocaleString('en-US'));
    function draw() {
      const w = val('[data-w]'); const r = val('[data-r]'); const c = val('[data-c]'); const d = val('[data-d]'); const t = val('[data-t]');
      ['w', 'r', 'c', 'd', 't'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const readsNo = w * r;
      const staticReads = (w * 10) / c; const renewals = (w * d) / (t * 60 * (2 / 3)); const readsCache = staticReads + renewals;
      const leases = w * d; const creations = leases / (t * 60); const raft = creations * 3;
      const auditNo = (readsNo * 86400 * 500) / 1e9; const auditCache = (readsCache * 86400 * 500) / 1e9;
      const data: [string, string][] = [
        ['Vault reads per second if every request reads', fmt(readsNo)],
        ['Vault nodes needed to serve that', fmt(Math.ceil(readsNo / 10000))],
        ['Vault reads per second with client caching and leases', fmt(readsCache)],
        ['Active leases to track', fmt(leases)],
        ['New dynamic credentials per second', fmt(creations)],
        ['Raft log writes per second from credentials', fmt(raft)],
        ['Audit log per day if every request reads (GB)', fmt(auditNo)],
        ['Audit log per day with caching (GB)', fmt(auditCache)],
      ];
      rows.forEach((x, i) => { x.dt.textContent = data[i][0]; x.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
