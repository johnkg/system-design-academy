---
import PlaygroundShell from '../../components/PlaygroundShell.astro';
---
<PlaygroundShell title="Back-of-the-envelope numbers" hint="Sending is limited by how many warmed-up IPs you have, and receiving is limited by how many bytes of mail you keep for years.">
  <div class="pg est" data-est>
    <div class="pg-row">
      <label>Messages sent per day (millions) <input type="range" min="10" max="2000" step="10" value="300" data-s /> <b data-sval></b></label>
      <label>Daily volume one warmed-up IP can send (thousands) <input type="range" min="50" max="1000" step="50" value="500" data-ip /> <b data-ipval></b></label>
      <label>Mailbox users (millions) <input type="range" min="1" max="500" value="100" data-u /> <b data-uval></b></label>
      <label>Mail arriving per user per day, spam included <input type="range" min="10" max="200" step="10" value="60" data-r /> <b data-rval></b></label>
      <label>Share of arriving mail that is spam (%) <input type="range" min="30" max="95" value="70" data-sp /> <b data-spval></b></label>
      <label>Average size of a stored message (KB) <input type="range" min="10" max="300" step="10" value="60" data-kb /> <b data-kbval></b></label>
    </div>
    <dl class="est-out" data-out aria-live="polite"></dl>
    <p class="pg-note">Assumptions: the peak is 4 times the average because campaigns arrive in bursts, one outbound MTA node sends about 200 messages per second with TLS, one spam-filter node scores about 300 messages per second, a new IP starts at 1,000 messages per day and grows by 50% a day, spam is rejected before it is stored, stored bytes are erasure-coded at 1.5 times, and the search index is about 10% of the stored size.</p>
  </div>
</PlaygroundShell>
<script>
  import { query, numberValue, fmt } from '../../playground';
  document.querySelectorAll<HTMLElement>('[data-est]').forEach((root) => {
    const q = query(root);
    const val = numberValue(q);
    const N_ROWS = 11; // output lines below
    const THOUSAND = 1e3; const MILLION = 1e6; const DAY_S = 86400; const KB_PER_TB = 1e9; const TB_PER_PB = 1000; const DAYS_PER_YEAR = 365;
    const PEAK_FACTOR = 4; // peak send rate over the daily average
    const WARM_START = 1000; const WARM_GROWTH = 1.5; // a new IP starts at 1,000 messages a day and grows 50% a day
    const ERASURE_OVERHEAD = 1.5; const INDEX_SHARE = 0.1; // storage per stored byte; search index size per stored byte
    const MTA_RATE = 200; const SPAM_RATE = 300; // messages per second one outbound MTA, one spam-filter node handles
    const rows = Array.from({ length: N_ROWS }, () => { const dt = document.createElement('dt'); const dd = document.createElement('dd'); q('[data-out]').append(dt, dd); return { dt, dd }; });
    function draw() {
      ['s', 'ip', 'u', 'r', 'sp', 'kb'].forEach((k) => (q(`[data-${k}val]`).textContent = String(val(`[data-${k}]`))));
      const sent = val('[data-s]') * MILLION; const ipVol = val('[data-ip]') * THOUSAND; const users = val('[data-u]') * MILLION;
      const arriving = users * val('[data-r]'); const stored = arriving * (1 - val('[data-sp]') / 100); const kb = val('[data-kb]');
      const avgSend = sent / DAY_S; const peakSend = avgSend * PEAK_FACTOR;
      const ips = Math.ceil(sent / ipVol); const warmDays = Math.ceil(Math.log(ipVol / WARM_START) / Math.log(WARM_GROWTH));
      const tbDay = (stored * kb) / KB_PER_TB; const pbYear = (tbDay * DAYS_PER_YEAR * ERASURE_OVERHEAD) / TB_PER_PB;
      const data: [string, string][] = [
        ['Messages sent per second, average', fmt(avgSend)],
        ['Messages sent per second, at the peak', fmt(peakSend)],
        ['Outbound MTA nodes for the peak', fmt(Math.ceil(peakSend / MTA_RATE))],
        ['Warmed-up IPs needed for the daily volume', fmt(ips)],
        ['Days to warm up one new IP to its full volume', fmt(warmDays)],
        ['Messages arriving per second, spam included', fmt(arriving / DAY_S)],
        ['Spam-filter nodes for the arrival rate', fmt(Math.ceil(arriving / DAY_S / SPAM_RATE))],
        ['Messages stored per second', fmt(stored / DAY_S)],
        ['New mail stored per day', `${fmt(tbDay)} TB`],
        ['Mail storage added per year (erasure-coded)', `${pbYear.toFixed(1)} PB`],
        ['Search index added per year', `${fmt(tbDay * DAYS_PER_YEAR * INDEX_SHARE)} TB`],
      ];
      rows.forEach((r, i) => { r.dt.textContent = data[i][0]; r.dd.textContent = data[i][1]; });
    }
    root.addEventListener('input', draw);
    draw();
  });
</script>
